+//! Versioned ACK-gated Slash transaction for the v0.26 graph.
+//!
+//! A `SlashV2Tx` exists per ordered counterproof alternative.  It spends the
+//! authorization created by that alternative's confirmed ACK, the fresh
+//! contest Slash gate through its delayed path, and an exclusively reserved
+//! stake output.  The caller supplies the exact committed ordered payout
+//! roster and finalized fee; this constructor never derives beneficiaries or
+//! distributes a residual at runtime.
+//!
+//! The zero-value header is still encoded with the Bridge-v1
+//! [`SlashTxHeaderAux`] shape. That shape is not compatible with a frozen
+//! v0.26 parser/profile, so this module is activation-blocked even when every
+//! local transaction invariant succeeds.
+//! The research fee ceiling prevents unchecked donation only; activation must
+//! bind it and verify measured finalized vsize/feerate externally.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, ScriptBuf, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, XOnlyPublicKey};
+use strata_asm_proto_bridge_v1_txs::slash::SlashTxHeaderAux;
+use strata_bridge_connectors::{
+    prelude::{
+        ContestSlashGateSpendPathV2, ContestSlashGateV2, ContestSlashGateWitnessV2, NOfNConnector,
+        NOfNSpend, SlashAuthorizationConnectorV2, SlashAuthorizationSpendPathV2,
+        SlashAuthorizationWitnessV2,
+    },
+    Connector, SigningInfo,
+};
+use strata_l1_txfmt::{MagicBytes, ParseConfig};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+    PresignedTx,
+};
+
+/// One validated P2TR beneficiary and exact amount in Slash roster order.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct SlashPayoutV2 {
+    descriptor: Descriptor,
+    controller_key: XOnlyPublicKey,
+    value: Amount,
+}
+
+impl SlashPayoutV2 {
+    /// Constructs one spendable P2TR payout entry.
+    pub fn new(descriptor: Descriptor, value: Amount) -> Result<Self, SlashPayoutV2Error> {
+        if descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(SlashPayoutV2Error::InvalidDescriptorType {
+                actual: descriptor.type_tag(),
+            });
+        }
+        let controller_key = XOnlyPublicKey::from_slice(descriptor.payload())
+            .map_err(|_| SlashPayoutV2Error::InvalidDescriptorPayload)?;
+        if value > Amount::MAX_MONEY {
+            return Err(SlashPayoutV2Error::MoneyRange { value });
+        }
+        let minimum = descriptor.to_script().minimal_non_dust();
+        if value < minimum {
+            return Err(SlashPayoutV2Error::DustValue { value, minimum });
+        }
+        Ok(Self {
+            descriptor,
+            controller_key,
+            value,
+        })
+    }
+
+    /// Returns the exact committed beneficiary descriptor.
+    pub const fn descriptor(&self) -> &Descriptor {
+        &self.descriptor
+    }
+
+    /// Returns the descriptor's P2TR payload key.
+    pub const fn controller_key(&self) -> XOnlyPublicKey {
+        self.controller_key
+    }
+
+    /// Returns the exact committed payout amount.
+    pub const fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn tx_out(&self) -> TxOut {
+        TxOut {
+            value: self.value,
+            script_pubkey: self.descriptor.to_script(),
+        }
+    }
+}
+
+/// Invalid typed Slash beneficiary entry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SlashPayoutV2Error {
+    /// The strict payout profile accepts only P2TR descriptors.
+    InvalidDescriptorType {
+        /// Rejected descriptor type.
+        actual: DescriptorType,
+    },
+    /// A P2TR descriptor carried a malformed controller payload.
+    InvalidDescriptorPayload,
+    /// The payout exceeds Bitcoin's monetary range.
+    MoneyRange {
+        /// Rejected payout value.
+        value: Amount,
+    },
+    /// The payout is below its P2TR script's dust floor.
+    DustValue {
+        /// Rejected payout value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for SlashPayoutV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidDescriptorType { actual } => {
+                write!(f, "Slash payout descriptor must be P2TR, got {actual}")
+            }
+            Self::InvalidDescriptorPayload => {
+                f.write_str("Slash payout P2TR payload is not a valid x-only key")
+            }
+            Self::MoneyRange { value } => {
+                write!(f, "Slash payout value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "Slash payout value {value} is below its dust floor {minimum}"
+            ),
+        }
+    }
+}
+
+impl Error for SlashPayoutV2Error {}
+
+/// Exact parent outpoints and protocol-header context of one Slash alternative.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct SlashV2Data {
+    /// Slash authorization created by this alternative's ACK.
+    pub slash_authorization_outpoint: OutPoint,
+    /// Fresh contest Slash gate shared with timeout settlement.
+    pub contest_slash_outpoint: OutPoint,
+    /// Stake output exclusively reserved for this funding subject.
+    pub stake_outpoint: OutPoint,
+    /// Operator index encoded in the protocol header.
+    pub operator_idx: u32,
+    /// Bridge magic encoded in the protocol header.
+    pub magic_bytes: MagicBytes,
+}
+
+impl SlashV2Data {
+    fn header_script(&self) -> Result<ScriptBuf, SlashV2Error> {
+        let tag_data = SlashTxHeaderAux::new(self.operator_idx).build_tag_data();
+        ParseConfig::new(self.magic_bytes)
+            .encode_script_buf(&tag_data.as_ref())
+            .map_err(|error| SlashV2Error::HeaderEncoding(error.to_string()))
+    }
+}
+
+/// ACK-gated Slash parent with an exact setup-committed payout roster.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct SlashV2Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    slash_authorization_connector: SlashAuthorizationConnectorV2,
+    contest_slash_connector: ContestSlashGateV2,
+    stake_connector: NOfNConnector,
+    payout_count: usize,
+}
+
+impl SlashV2Tx {
+    /// Exact zero-value protocol header output index.
+    pub const HEADER_VOUT: u32 = 0;
+    /// First ordered penalty-payout output index.
+    pub const FIRST_PAYOUT_VOUT: u32 = 1;
+    /// Number of transaction inputs.
+    pub const N_INPUTS: usize = 3;
+
+    /// Constructs the exact per-alternative Slash parent.
+    pub fn new(
+        data: SlashV2Data,
+        slash_authorization_connector: SlashAuthorizationConnectorV2,
+        contest_slash_connector: ContestSlashGateV2,
+        stake_connector: NOfNConnector,
+        ordered_payouts: Vec<SlashPayoutV2>,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, SlashV2Error> {
+        let input_outpoints = [
+            data.slash_authorization_outpoint,
+            data.contest_slash_outpoint,
+            data.stake_outpoint,
+        ];
+        for index in 0..input_outpoints.len() {
+            if input_outpoints[..index].contains(&input_outpoints[index]) {
+                return Err(SlashV2Error::DuplicateInputOutpoint { index });
+            }
+        }
+
+        let network = slash_authorization_connector.network();
+        for (name, candidate) in [
+            ("contest Slash gate", contest_slash_connector.network()),
+            ("stake", stake_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(SlashV2Error::NetworkMismatch { connector: name });
+            }
+        }
+        if ordered_payouts.is_empty() {
+            return Err(SlashV2Error::EmptyPayoutRoster);
+        }
+        checked_payout_vout(ordered_payouts.len() - 1, ordered_payouts.len())?;
+
+        for (field, value) in [
+            (
+                "Slash authorization prevout",
+                slash_authorization_connector.value(),
+            ),
+            ("contest Slash prevout", contest_slash_connector.value()),
+            ("stake prevout", stake_connector.value()),
+            ("Slash fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::Slash, fee)
+            .map_err(SlashV2Error::FeeAllowance)?;
+
+        let input_controllers = [
+            (
+                "Slash authorization graph key",
+                slash_authorization_connector.graph_pubkey(),
+            ),
+            (
+                "contest Slash graph key",
+                contest_slash_connector.graph_pubkey(),
+            ),
+            ("stake N-of-N key", stake_connector.internal_key()),
+        ];
+        let known_nums_keys: Vec<_> = [
+            known_nums_keys("Slash authorization L", &slash_authorization_connector),
+            known_nums_keys("contest Slash S", &contest_slash_connector),
+        ]
+        .into_iter()
+        .flatten()
+        .collect();
+        let input_scripts = [
+            (
+                "Slash authorization prevout",
+                slash_authorization_connector.script_pubkey(),
+            ),
+            (
+                "contest Slash prevout",
+                contest_slash_connector.script_pubkey(),
+            ),
+            ("stake prevout", stake_connector.script_pubkey()),
+        ];
+
+        let mut payout_value = Amount::ZERO;
+        for (index, payout) in ordered_payouts.iter().enumerate() {
+            for nums in &known_nums_keys {
+                if payout.controller_key() == nums.key {
+                    return Err(SlashV2Error::PayoutNumsKeyAlias {
+                        index,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+            for (component, controller) in &input_controllers {
+                if payout.controller_key() == *controller {
+                    return Err(SlashV2Error::PayoutControlKeyAlias { index, component });
+                }
+            }
+            let payout_script = payout.descriptor().to_script();
+            for (component, input_script) in &input_scripts {
+                if payout_script == *input_script {
+                    return Err(SlashV2Error::PayoutScriptCollision { index, component });
+                }
+            }
+            if ordered_payouts[..index]
+                .iter()
+                .any(|earlier| earlier.descriptor().to_script() == payout_script)
+            {
+                return Err(SlashV2Error::DuplicatePayoutScript { index });
+            }
+            payout_value = payout_value
+                .checked_add(payout.value())
+                .ok_or(SlashV2Error::AmountOverflow)?;
+        }
+        ensure_money_range("Slash total output", payout_value)?;
+
+        let input_value = slash_authorization_connector
+            .value()
+            .checked_add(contest_slash_connector.value())
+            .and_then(|value| value.checked_add(stake_connector.value()))
+            .ok_or(SlashV2Error::AmountOverflow)?;
+        ensure_money_range("Slash total input", input_value)?;
+        let required_input = payout_value
+            .checked_add(fee)
+            .ok_or(SlashV2Error::AmountOverflow)?;
+        ensure_money_range("Slash total output plus fee", required_input)?;
+        if input_value != required_input {
+            return Err(SlashV2Error::ValueNotConserved {
+                input: input_value,
+                output: payout_value,
+                fee,
+            });
+        }
+
+        let prevouts = [
+            slash_authorization_connector.tx_out(),
+            contest_slash_connector.tx_out(),
+            stake_connector.tx_out(),
+        ];
+        let input = vec![
+            TxIn {
+                previous_output: data.slash_authorization_outpoint,
+                sequence: slash_authorization_connector.sequence(SlashAuthorizationSpendPathV2),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.contest_slash_outpoint,
+                sequence: contest_slash_connector.sequence(ContestSlashGateSpendPathV2::Slash),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.stake_outpoint,
+                sequence: stake_connector.sequence(NOfNSpend),
+                ..Default::default()
+            },
+        ];
+        let mut output = vec![TxOut {
+            value: Amount::ZERO,
+            script_pubkey: data.header_script()?,
+        }];
+        output.extend(ordered_payouts.iter().map(SlashPayoutV2::tx_out));
+
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(SlashV2Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts,
+            slash_authorization_connector,
+            contest_slash_connector,
+            stake_connector,
+            payout_count: ordered_payouts.len(),
+        })
+    }
+
+    /// Returns whether the current Bridge-v1 header is activation-compatible.
+    ///
+    /// This remains `false` until an authoritative v0.26 header/parser profile
+    /// replaces or explicitly adopts the current Bridge-v1 encoding.
+    pub const fn header_profile_compatible_for_activation() -> bool {
+        false
+    }
+
+    /// Returns one exact payout output after checked roster-index conversion.
+    pub fn payout_tx_out(&self, index: usize) -> Result<&TxOut, SlashV2Error> {
+        let vout = checked_payout_vout(index, self.payout_count)?;
+        self.psbt.unsigned_tx.output.get(vout as usize).ok_or(
+            SlashV2Error::PayoutIndexOutOfBounds {
+                index,
+                count: self.payout_count,
+            },
+        )
+    }
+
+    /// Returns one exact payout outpoint after checked roster-index conversion.
+    pub fn payout_outpoint(&self, index: usize) -> Result<OutPoint, SlashV2Error> {
+        let vout = checked_payout_vout(index, self.payout_count)?;
+        Ok(OutPoint::new(self.psbt.unsigned_tx.compute_txid(), vout))
+    }
+
+    /// Finalizes the exact Slash parent with all three graph signatures.
+    pub fn finalize(
+        self,
+        graph_signatures: [schnorr::Signature; Self::N_INPUTS],
+    ) -> Result<Transaction, SlashV2Error> {
+        let mut psbt = self.psbt;
+        self.slash_authorization_connector.finalize_input(
+            &mut psbt.inputs[0],
+            &SlashAuthorizationWitnessV2 {
+                graph_signature: graph_signatures[0],
+            },
+        );
+        self.contest_slash_connector.finalize_input(
+            &mut psbt.inputs[1],
+            &ContestSlashGateWitnessV2::Slash {
+                graph_signature: graph_signatures[1],
+            },
+        );
+        self.stake_connector
+            .finalize_input(&mut psbt.inputs[2], &graph_signatures[2]);
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn ensure_money_range(field: &'static str, value: Amount) -> Result<(), SlashV2Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(SlashV2Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn checked_payout_vout(index: usize, payout_count: usize) -> Result<u32, SlashV2Error> {
+    if index >= payout_count {
+        return Err(SlashV2Error::PayoutIndexOutOfBounds {
+            index,
+            count: payout_count,
+        });
+    }
+    let index = u32::try_from(index).map_err(|_| SlashV2Error::PayoutIndexOutOfBounds {
+        index,
+        count: payout_count,
+    })?;
+    SlashV2Tx::FIRST_PAYOUT_VOUT
+        .checked_add(index)
+        .ok_or(SlashV2Error::PayoutIndexOutOfBounds {
+            index: index as usize,
+            count: payout_count,
+        })
+}
+
+impl PresignedTx<{ Self::N_INPUTS }> for SlashV2Tx {
+    fn signing_info(&self) -> [SigningInfo; Self::N_INPUTS] {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        [
+            self.slash_authorization_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                SlashAuthorizationSpendPathV2,
+                0,
+            ),
+            self.contest_slash_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestSlashGateSpendPathV2::Slash,
+                1,
+            ),
+            self.stake_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                NOfNSpend,
+                2,
+            ),
+        ]
+    }
+}
+
+impl AsRef<Transaction> for SlashV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize an exact Slash parent.
+#[derive(Debug)]
+pub enum SlashV2Error {
+    /// Two transaction inputs name the same outpoint.
+    DuplicateInputOutpoint {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// Connector networks do not match.
+    NetworkMismatch {
+        /// Connector whose network differs from Slash authorization.
+        connector: &'static str,
+    },
+    /// At least one ordered penalty payout is required.
+    EmptyPayoutRoster,
+    /// Two payout entries use the same script.
+    DuplicatePayoutScript {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// A payout descriptor reuses a known L, S, or K controller.
+    PayoutControlKeyAlias {
+        /// Payout index within the ordered roster.
+        index: usize,
+        /// Protocol controller aliased by the payout.
+        component: &'static str,
+    },
+    /// A payout controller aliases an unspendable v2 NUMS key.
+    PayoutNumsKeyAlias {
+        /// Payout index within the ordered roster.
+        index: usize,
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// A payout script duplicates an exact L, S, or K input script.
+    PayoutScriptCollision {
+        /// Payout index within the ordered roster.
+        index: usize,
+        /// Input protocol script duplicated by the payout.
+        component: &'static str,
+    },
+    /// A payout roster index cannot identify an exact transaction output.
+    PayoutIndexOutOfBounds {
+        /// Rejected roster index.
+        index: usize,
+        /// Exact committed payout count.
+        count: usize,
+    },
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A prevout, output, fee, or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Out-of-range value.
+        value: Amount,
+    },
+    /// The fee exceeds or is not bound by the exact Slash allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// The exact Slash value equation does not hold.
+    ValueNotConserved {
+        /// Sum of L, S, and K.
+        input: Amount,
+        /// Sum of the exact ordered penalty outputs.
+        output: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// The exact protocol header could not be encoded.
+    HeaderEncoding(String),
+    /// The constructed unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for SlashV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::DuplicateInputOutpoint { index } => {
+                write!(
+                    f,
+                    "Slash input at index {index} duplicates an earlier outpoint"
+                )
+            }
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match Slash authorization")
+            }
+            Self::EmptyPayoutRoster => f.write_str("Slash payout roster must not be empty"),
+            Self::DuplicatePayoutScript { index } => {
+                write!(f, "Slash payout script at index {index} is duplicated")
+            }
+            Self::PayoutControlKeyAlias { index, component } => {
+                write!(f, "Slash payout key at index {index} aliases {component}")
+            }
+            Self::PayoutNumsKeyAlias {
+                index,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "Slash payout key at index {index} aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::PayoutScriptCollision { index, component } => {
+                write!(
+                    f,
+                    "Slash payout script at index {index} collides with {component}"
+                )
+            }
+            Self::PayoutIndexOutOfBounds { index, count } => write!(
+                f,
+                "Slash payout index {index} is outside committed roster length {count}"
+            ),
+            Self::AmountOverflow => f.write_str("Slash amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::FeeAllowance(error) => write!(f, "invalid Slash fee allowance: {error}"),
+            Self::ValueNotConserved { input, output, fee } => write!(
+                f,
+                "Slash value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::HeaderEncoding(error) => write!(f, "failed to encode Slash header: {error}"),
+            Self::Psbt(error) => write!(f, "failed to construct Slash PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for SlashV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
