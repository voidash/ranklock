index 00000000..a6a5ab63
--- /dev/null
+++ b/crates/tx-graph/src/transactions/counterproof_timeout_settlement_v2.rs
@@ -0,0 +1,858 @@
+//! Versioned neutral timeout settlement for a selected v0.26 counterproof.
+//!
+//! The timeout spends the same resolution output as `CounterproofAckV2Tx`
+//! and the same contest Slash gate as `SlashV2Tx`.  It never consumes the
+//! deposit or claim-payout output.  Its only non-CPFP output, when present, is
+//! deterministic change to the setup-committed recovery descriptor.
+//! Descriptor type, controller separation, and script separation do not prove
+//! recovery-key possession or the intended vault policy; activation must
+//! verify both against external setup evidence.
+//! The research fee ceiling prevents unchecked donation only; activation must
+//! bind it and verify measured finalized vsize/feerate externally.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, XOnlyPublicKey};
+use strata_bridge_connectors::{
+    prelude::{
+        ContestSlashGateSpendPathV2, ContestSlashGateV2, ContestSlashGateWitnessV2,
+        CounterproofResolutionConnectorV2, CounterproofResolutionSpendPathV2,
+        CounterproofResolutionWitnessV2, KeyedAnchor,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+    PresignedTx,
+};
+
+/// Exact parent outpoints consumed by timeout settlement.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofTimeoutSettlementV2Data {
+    /// Resolution output created by the selected counterproof.
+    pub resolution_outpoint: OutPoint,
+    /// Fresh contest Slash gate shared with the selected Slash parent.
+    pub contest_slash_outpoint: OutPoint,
+}
+
+/// CSV-delayed neutral settlement for a selected counterproof.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofTimeoutSettlementV2Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    resolution_connector: CounterproofResolutionConnectorV2,
+    contest_slash_connector: ContestSlashGateV2,
+    cpfp_connector: KeyedAnchor,
+}
+
+impl CounterproofTimeoutSettlementV2Tx {
+    /// Independently controlled timeout CPFP output index.
+    pub const CPFP_VOUT: u32 = 0;
+    /// Optional recovery change output index.
+    pub const RECOVERY_CHANGE_VOUT: u32 = 1;
+    /// Number of transaction inputs.
+    pub const N_INPUTS: usize = 2;
+
+    /// Constructs the exact neutral timeout parent.
+    ///
+    /// The output roster is either `[a_timeout]` or
+    /// `[a_timeout, recovery_change]`.  Any nonzero change below the recovery
+    /// script's dust floor is rejected instead of silently becoming miner fee.
+    pub fn new(
+        data: CounterproofTimeoutSettlementV2Data,
+        resolution_connector: CounterproofResolutionConnectorV2,
+        contest_slash_connector: ContestSlashGateV2,
+        cpfp_connector: KeyedAnchor,
+        recovery_descriptor: &Descriptor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofTimeoutSettlementV2Error> {
+        if data.resolution_outpoint == data.contest_slash_outpoint {
+            return Err(CounterproofTimeoutSettlementV2Error::DuplicateInputOutpoint);
+        }
+        let network = resolution_connector.network();
+        for (name, candidate) in [
+            ("contest Slash gate", contest_slash_connector.network()),
+            ("timeout CPFP", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(CounterproofTimeoutSettlementV2Error::NetworkMismatch {
+                    connector: name,
+                });
+            }
+        }
+        if recovery_descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(
+                CounterproofTimeoutSettlementV2Error::InvalidRecoveryDescriptorType {
+                    actual: recovery_descriptor.type_tag(),
+                },
+            );
+        }
+        let recovery_key = XOnlyPublicKey::from_slice(recovery_descriptor.payload())
+            .map_err(|_| CounterproofTimeoutSettlementV2Error::InvalidRecoveryDescriptorPayload)?;
+        let known_nums_keys: Vec<_> = [
+            known_nums_keys("counterproof resolution R", &resolution_connector),
+            known_nums_keys("contest Slash S", &contest_slash_connector),
+        ]
+        .into_iter()
+        .flatten()
+        .collect();
+        for (controlled_component, controlled_key) in [
+            ("timeout recovery", recovery_key),
+            ("timeout CPFP", cpfp_connector.internal_key()),
+        ] {
+            for nums in &known_nums_keys {
+                if controlled_key == nums.key {
+                    return Err(CounterproofTimeoutSettlementV2Error::NumsControlKeyAlias {
+                        controlled_component,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+        }
+        for (component, controller) in [
+            ("resolution graph key", resolution_connector.graph_pubkey()),
+            (
+                "contest Slash graph key",
+                contest_slash_connector.graph_pubkey(),
+            ),
+            ("timeout CPFP key", cpfp_connector.internal_key()),
+        ] {
+            if recovery_key == controller {
+                return Err(
+                    CounterproofTimeoutSettlementV2Error::RecoveryControlKeyAlias { component },
+                );
+            }
+        }
+        let recovery_script = recovery_descriptor.to_script();
+        for (component, script) in [
+            ("resolution prevout", resolution_connector.script_pubkey()),
+            (
+                "contest Slash prevout",
+                contest_slash_connector.script_pubkey(),
+            ),
+            ("timeout CPFP output", cpfp_connector.script_pubkey()),
+        ] {
+            if recovery_script == script {
+                return Err(
+                    CounterproofTimeoutSettlementV2Error::RecoveryScriptCollision { component },
+                );
+            }
+        }
+
+        for (field, value) in [
+            ("resolution prevout", resolution_connector.value()),
+            ("contest Slash prevout", contest_slash_connector.value()),
+            ("timeout CPFP output", cpfp_connector.value()),
+            ("timeout fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::CounterproofTimeoutSettlement, fee)
+            .map_err(CounterproofTimeoutSettlementV2Error::FeeAllowance)?;
+        let cpfp_minimum = cpfp_connector.script_pubkey().minimal_non_dust();
+        if cpfp_connector.value() < cpfp_minimum {
+            return Err(CounterproofTimeoutSettlementV2Error::InvalidCpfpValue {
+                value: cpfp_connector.value(),
+                minimum: cpfp_minimum,
+            });
+        }
+
+        let input_value = resolution_connector
+            .value()
+            .checked_add(contest_slash_connector.value())
+            .ok_or(CounterproofTimeoutSettlementV2Error::AmountOverflow)?;
+        ensure_money_range("timeout total input", input_value)?;
+        let fixed_output_and_fee = cpfp_connector
+            .value()
+            .checked_add(fee)
+            .ok_or(CounterproofTimeoutSettlementV2Error::AmountOverflow)?;
+        ensure_money_range("timeout fixed output plus fee", fixed_output_and_fee)?;
+        let recovery_change = input_value.checked_sub(fixed_output_and_fee).ok_or(
+            CounterproofTimeoutSettlementV2Error::InsufficientInput {
+                input: input_value,
+                fixed_output: cpfp_connector.value(),
+                fee,
+            },
+        )?;
+        let output_value = cpfp_connector
+            .value()
+            .checked_add(recovery_change)
+            .ok_or(CounterproofTimeoutSettlementV2Error::AmountOverflow)?;
+        ensure_money_range("timeout total output", output_value)?;
+
+        let mut output = vec![cpfp_connector.tx_out()];
+        if recovery_change != Amount::ZERO {
+            ensure_money_range("timeout recovery change output", recovery_change)?;
+            let minimum = recovery_script.minimal_non_dust();
+            if recovery_change < minimum {
+                return Err(CounterproofTimeoutSettlementV2Error::DustRecoveryChange {
+                    value: recovery_change,
+                    minimum,
+                });
+            }
+            output.push(TxOut {
+                value: recovery_change,
+                script_pubkey: recovery_script,
+            });
+        }
+
+        let prevouts = [
+            resolution_connector.tx_out(),
+            contest_slash_connector.tx_out(),
+        ];
+        let input = vec![
+            TxIn {
+                previous_output: data.resolution_outpoint,
+                sequence: resolution_connector.sequence(CounterproofResolutionSpendPathV2::Timeout),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.contest_slash_outpoint,
+                sequence: contest_slash_connector.sequence(ContestSlashGateSpendPathV2::Settlement),
+                ..Default::default()
+            },
+        ];
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt =
+            Psbt::from_unsigned_tx(tx).map_err(CounterproofTimeoutSettlementV2Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts,
+            resolution_connector,
+            contest_slash_connector,
+            cpfp_connector,
+        })
+    }
+
+    /// Returns recovery change when the exact transaction includes it.
+    pub fn recovery_change_tx_out(&self) -> Option<&TxOut> {
+        self.psbt
+            .unsigned_tx
+            .output
+            .get(Self::RECOVERY_CHANGE_VOUT as usize)
+    }
+
+    /// Finalizes the exact timeout parent with both graph signatures.
+    pub fn finalize(
+        self,
+        graph_signatures: [schnorr::Signature; Self::N_INPUTS],
+    ) -> Result<Transaction, CounterproofTimeoutSettlementV2Error> {
+        let mut psbt = self.psbt;
+        self.resolution_connector.finalize_input(
+            &mut psbt.inputs[0],
+            &CounterproofResolutionWitnessV2::Timeout {
+                graph_signature: graph_signatures[0],
+            },
+        );
+        self.contest_slash_connector.finalize_input(
+            &mut psbt.inputs[1],
+            &ContestSlashGateWitnessV2::Settlement {
+                graph_signature: graph_signatures[1],
+            },
+        );
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn ensure_money_range(
+    field: &'static str,
+    value: Amount,
+) -> Result<(), CounterproofTimeoutSettlementV2Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofTimeoutSettlementV2Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+impl ParentTx for CounterproofTimeoutSettlementV2Tx {
+    type CpfpConnector = KeyedAnchor;
+
+    fn cpfp_tx_out(&self) -> TxOut {
+        self.cpfp_connector.tx_out()
+    }
+
+    fn cpfp_outpoint(&self) -> OutPoint {
+        OutPoint::new(self.psbt.unsigned_tx.compute_txid(), Self::CPFP_VOUT)
+    }
+
+    fn cpfp_connector(&self) -> &Self::CpfpConnector {
+        &self.cpfp_connector
+    }
+}
+
+impl PresignedTx<{ Self::N_INPUTS }> for CounterproofTimeoutSettlementV2Tx {
+    fn signing_info(&self) -> [SigningInfo; Self::N_INPUTS] {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        [
+            self.resolution_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                CounterproofResolutionSpendPathV2::Timeout,
+                0,
+            ),
+            self.contest_slash_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestSlashGateSpendPathV2::Settlement,
+                1,
+            ),
+        ]
+    }
+}
+
+impl AsRef<Transaction> for CounterproofTimeoutSettlementV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize the exact neutral timeout parent.
+#[derive(Debug)]
+pub enum CounterproofTimeoutSettlementV2Error {
+    /// The resolution and contest-Slash inputs name the same outpoint.
+    DuplicateInputOutpoint,
+    /// Connector networks do not match.
+    NetworkMismatch {
+        /// Connector whose network differs from the resolution connector.
+        connector: &'static str,
+    },
+    /// Recovery is restricted to the setup policy's P2TR vault descriptor.
+    InvalidRecoveryDescriptorType {
+        /// Rejected BOSD descriptor type.
+        actual: DescriptorType,
+    },
+    /// A P2TR descriptor carried a malformed controller payload.
+    InvalidRecoveryDescriptorPayload,
+    /// Recovery reuses a known protocol controller even if its script differs.
+    RecoveryControlKeyAlias {
+        /// Protocol controller aliased by recovery.
+        component: &'static str,
+    },
+    /// A recovery or CPFP controller aliases an unspendable v2 NUMS key.
+    NumsControlKeyAlias {
+        /// Caller-controlled role that reused the key.
+        controlled_component: &'static str,
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// Recovery must have a separate script from every protocol control domain.
+    RecoveryScriptCollision {
+        /// Protocol component whose script collides with recovery.
+        component: &'static str,
+    },
+    /// The fee exceeds or is not bound by the exact timeout allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A prevout, output, fee, or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Out-of-range value.
+        value: Amount,
+    },
+    /// The timeout CPFP output is zero or below its script-dependent dust floor.
+    InvalidCpfpValue {
+        /// Supplied CPFP value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// The R+S inputs cannot fund the exact anchor and caller-supplied fee.
+    InsufficientInput {
+        /// Sum of R and S.
+        input: Amount,
+        /// Exact timeout CPFP output value.
+        fixed_output: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// A nonzero recovery change output would be dust.
+    DustRecoveryChange {
+        /// Computed recovery change.
+        value: Amount,
+        /// Recovery script's dust floor.
+        minimum: Amount,
+    },
+    /// The constructed unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofTimeoutSettlementV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::DuplicateInputOutpoint => {
+                f.write_str("timeout resolution and contest-Slash inputs must be distinct")
+            }
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match resolution")
+            }
+            Self::InvalidRecoveryDescriptorType { actual } => write!(
+                f,
+                "timeout recovery descriptor must be P2TR, got {actual}"
+            ),
+            Self::InvalidRecoveryDescriptorPayload => {
+                f.write_str("timeout recovery P2TR payload is not a valid x-only key")
+            }
+            Self::RecoveryControlKeyAlias { component } => {
+                write!(f, "timeout recovery key aliases {component}")
+            }
+            Self::NumsControlKeyAlias {
+                controlled_component,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "{controlled_component} key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::RecoveryScriptCollision { component } => {
+                write!(f, "timeout recovery script collides with {component}")
+            }
+            Self::FeeAllowance(error) => write!(f, "invalid timeout fee allowance: {error}"),
+            Self::AmountOverflow => f.write_str("timeout-settlement amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::InvalidCpfpValue { value, minimum } => write!(
+                f,
+                "timeout CPFP value {value} is below its dust floor {minimum}"
+            ),
+            Self::InsufficientInput {
+                input,
+                fixed_output,
+                fee,
+            } => write!(
+                f,
+                "timeout inputs cannot fund fixed output and fee: input={input}, fixed_output={fixed_output}, fee={fee}"
+            ),
+            Self::DustRecoveryChange { value, minimum } => write!(
+                f,
+                "timeout recovery change {value} is below its dust floor {minimum}"
+            ),
+            Self::Psbt(error) => write!(f, "failed to construct timeout PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofTimeoutSettlementV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use bitcoin::{relative, Network};
+    use secp256k1::{rand::thread_rng, Keypair, SECP256K1};
+    use strata_bridge_connectors::prelude::{ResearchV0NumsContext, ResearchV0NumsRole};
+
+    use super::*;
+
+    const SETUP_DIGEST: [u8; 32] = [0x55; 32];
+
+    fn signature() -> schnorr::Signature {
+        schnorr::Signature::from_slice(&[0xAA; 64]).expect("fixed-size Schnorr signature")
+    }
+
+    fn fee_allowance(fee: Amount) -> TemplateFeeAllowanceV2 {
+        TemplateFeeAllowanceV2::new(TemplateKindV2::CounterproofTimeoutSettlement, fee).unwrap()
+    }
+
+    fn connector_set(
+        resolution_value: Amount,
+        slash_value: Amount,
+        anchor_value: Amount,
+    ) -> (
+        CounterproofResolutionConnectorV2,
+        ContestSlashGateV2,
+        KeyedAnchor,
+        Descriptor,
+    ) {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let anchor_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let recovery_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let resolution = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            vec![[1u8; 32], [2u8; 32]],
+            relative::Height::from_height(12),
+            resolution_value,
+            ResearchV0NumsContext::new(SETUP_DIGEST, ResearchV0NumsRole::CounterproofResolution, 0),
+        )
+        .unwrap();
+        let slash = ContestSlashGateV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            relative::Height::from_height(24),
+            slash_value,
+            ResearchV0NumsContext::new(SETUP_DIGEST, ResearchV0NumsRole::ContestSlashGate, 0),
+        )
+        .unwrap();
+        let anchor = KeyedAnchor::new(
+            Network::Regtest,
+            anchor_keypair.x_only_public_key().0,
+            anchor_value,
+        );
+        let recovery =
+            Descriptor::new_p2tr(&recovery_keypair.x_only_public_key().0.serialize()).unwrap();
+        (resolution, slash, anchor, recovery)
+    }
+
+    fn input_outpoints() -> (OutPoint, OutPoint) {
+        let resolution = OutPoint::null();
+        let contest_slash = OutPoint::new(resolution.txid, 1);
+        (resolution, contest_slash)
+    }
+
+    #[test]
+    fn exact_timeout_layout_and_conservation() {
+        let fee = Amount::from_sat(500);
+        let (resolution, slash, anchor, recovery) = connector_set(
+            Amount::from_sat(2_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(330),
+        );
+        let timeout = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            anchor,
+            &recovery,
+            fee,
+            fee_allowance(fee),
+        )
+        .unwrap();
+        assert_eq!(timeout.as_ref().input.len(), 2);
+        assert_eq!(timeout.as_ref().output.len(), 2);
+        assert_eq!(timeout.as_ref().output[0].value, Amount::from_sat(330));
+        assert_eq!(
+            timeout.recovery_change_tx_out().unwrap().value,
+            Amount::from_sat(2_170)
+        );
+        assert_eq!(timeout.signing_info().len(), 2);
+
+        let signed = timeout.finalize([signature(), signature()]).unwrap();
+        assert_eq!(
+            signed
+                .output
+                .iter()
+                .map(|output| output.value)
+                .sum::<Amount>()
+                + fee,
+            Amount::from_sat(3_000)
+        );
+        assert!(signed.input.iter().all(|input| !input.witness.is_empty()));
+    }
+
+    #[test]
+    fn rejects_insufficient_value() {
+        let (resolution, slash, anchor, recovery) = connector_set(
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_500),
+        );
+        let result = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            anchor,
+            &recovery,
+            Amount::from_sat(501),
+            fee_allowance(Amount::from_sat(501)),
+        );
+        assert!(matches!(
+            result,
+            Err(CounterproofTimeoutSettlementV2Error::InsufficientInput { .. })
+        ));
+    }
+
+    #[test]
+    fn rejects_money_range_and_zero_anchor() {
+        let excessive = Amount::MAX_MONEY.checked_add(Amount::from_sat(1)).unwrap();
+        let (resolution, slash, anchor, recovery) =
+            connector_set(Amount::from_sat(1_000), Amount::from_sat(1_000), excessive);
+        let result = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            anchor,
+            &recovery,
+            Amount::ZERO,
+            fee_allowance(Amount::ZERO),
+        );
+        assert!(matches!(
+            result,
+            Err(CounterproofTimeoutSettlementV2Error::MoneyRange { .. })
+        ));
+
+        let (resolution, slash, _, recovery) = connector_set(
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(330),
+        );
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let result = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            KeyedAnchor::new(
+                Network::Regtest,
+                graph_keypair.x_only_public_key().0,
+                Amount::ZERO,
+            ),
+            &recovery,
+            Amount::from_sat(2_000),
+            fee_allowance(Amount::from_sat(2_000)),
+        );
+        assert!(matches!(
+            result,
+            Err(CounterproofTimeoutSettlementV2Error::InvalidCpfpValue { .. })
+        ));
+    }
+
+    #[test]
+    fn rejects_non_p2tr_recovery_descriptors() {
+        let descriptors = [
+            Descriptor::new_op_return(&[1u8; 32]).unwrap(),
+            Descriptor::new_p2a(&[]),
+        ];
+        for recovery in descriptors {
+            let (resolution, slash, anchor, _) = connector_set(
+                Amount::from_sat(2_000),
+                Amount::from_sat(1_000),
+                Amount::from_sat(330),
+            );
+            let result = CounterproofTimeoutSettlementV2Tx::new(
+                CounterproofTimeoutSettlementV2Data {
+                    resolution_outpoint: input_outpoints().0,
+                    contest_slash_outpoint: input_outpoints().1,
+                },
+                resolution,
+                slash,
+                anchor,
+                &recovery,
+                Amount::from_sat(500),
+                fee_allowance(Amount::from_sat(500)),
+            );
+            assert!(matches!(
+                result,
+                Err(CounterproofTimeoutSettlementV2Error::InvalidRecoveryDescriptorType { .. })
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_recovery_script_aliasing_cpfp() {
+        let (resolution, slash, anchor, _) = connector_set(
+            Amount::from_sat(2_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(330),
+        );
+        let recovery = Descriptor::try_from(
+            bitcoin::Address::from_script(&anchor.script_pubkey(), Network::Regtest)
+                .expect("anchor P2TR script has an address"),
+        )
+        .expect("P2TR address has a BOSD descriptor");
+        let result = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            anchor,
+            &recovery,
+            Amount::from_sat(500),
+            fee_allowance(Amount::from_sat(500)),
+        );
+        assert!(matches!(
+            result,
+            Err(
+                CounterproofTimeoutSettlementV2Error::RecoveryScriptCollision {
+                    component: "timeout CPFP output"
+                }
+            )
+        ));
+    }
+
+    #[test]
+    fn rejects_every_known_recovery_controller_alias() {
+        for controller_index in 0..3 {
+            let (resolution, slash, anchor, _) = connector_set(
+                Amount::from_sat(2_000),
+                Amount::from_sat(1_000),
+                Amount::from_sat(330),
+            );
+            let controller = match controller_index {
+                0 => resolution.graph_pubkey(),
+                1 => slash.graph_pubkey(),
+                _ => anchor.internal_key(),
+            };
+            let recovery = Descriptor::new_p2tr(&controller.serialize()).unwrap();
+            let result = CounterproofTimeoutSettlementV2Tx::new(
+                CounterproofTimeoutSettlementV2Data {
+                    resolution_outpoint: input_outpoints().0,
+                    contest_slash_outpoint: input_outpoints().1,
+                },
+                resolution,
+                slash,
+                anchor,
+                &recovery,
+                Amount::from_sat(500),
+                fee_allowance(Amount::from_sat(500)),
+            );
+            assert!(matches!(
+                result,
+                Err(CounterproofTimeoutSettlementV2Error::RecoveryControlKeyAlias { .. })
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_nums_internal_and_output_keys_for_recovery_and_cpfp() {
+        for nums_index in 0..4 {
+            let (resolution, slash, anchor, _) = connector_set(
+                Amount::from_sat(2_000),
+                Amount::from_sat(1_000),
+                Amount::from_sat(330),
+            );
+            let nums_keys: Vec<_> = [
+                known_nums_keys("R", &resolution),
+                known_nums_keys("S", &slash),
+            ]
+            .into_iter()
+            .flatten()
+            .collect();
+            let recovery = Descriptor::new_p2tr(&nums_keys[nums_index].key.serialize()).unwrap();
+            let result = CounterproofTimeoutSettlementV2Tx::new(
+                CounterproofTimeoutSettlementV2Data {
+                    resolution_outpoint: input_outpoints().0,
+                    contest_slash_outpoint: input_outpoints().1,
+                },
+                resolution,
+                slash,
+                anchor,
+                &recovery,
+                Amount::from_sat(500),
+                fee_allowance(Amount::from_sat(500)),
+            );
+            assert!(matches!(
+                result,
+                Err(CounterproofTimeoutSettlementV2Error::NumsControlKeyAlias {
+                    controlled_component: "timeout recovery",
+                    ..
+                })
+            ));
+
+            let (resolution, slash, _, recovery) = connector_set(
+                Amount::from_sat(2_000),
+                Amount::from_sat(1_000),
+                Amount::from_sat(330),
+            );
+            let nums_keys: Vec<_> = [
+                known_nums_keys("R", &resolution),
+                known_nums_keys("S", &slash),
+            ]
+            .into_iter()
+            .flatten()
+            .collect();
+            let alias_anchor = KeyedAnchor::new(
+                Network::Regtest,
+                nums_keys[nums_index].key,
+                Amount::from_sat(330),
+            );
+            let result = CounterproofTimeoutSettlementV2Tx::new(
+                CounterproofTimeoutSettlementV2Data {
+                    resolution_outpoint: input_outpoints().0,
+                    contest_slash_outpoint: input_outpoints().1,
+                },
+                resolution,
+                slash,
+                alias_anchor,
+                &recovery,
+                Amount::from_sat(500),
+                fee_allowance(Amount::from_sat(500)),
+            );
+            assert!(matches!(
+                result,
+                Err(CounterproofTimeoutSettlementV2Error::NumsControlKeyAlias {
+                    controlled_component: "timeout CPFP",
+                    ..
+                })
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_high_but_conserving_fee() {
+        let fee = Amount::from_sat(500);
+        let (resolution, slash, anchor, recovery) = connector_set(
+            Amount::from_sat(2_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(330),
+        );
+        let result = CounterproofTimeoutSettlementV2Tx::new(
+            CounterproofTimeoutSettlementV2Data {
+                resolution_outpoint: input_outpoints().0,
+                contest_slash_outpoint: input_outpoints().1,
+            },
+            resolution,
+            slash,
+            anchor,
+            &recovery,
+            fee,
+            TemplateFeeAllowanceV2::new(
+                TemplateKindV2::CounterproofTimeoutSettlement,
+                fee - Amount::ONE_SAT,
+            )
+            .unwrap(),
+        );
+        assert!(matches!(
+            result,
+            Err(CounterproofTimeoutSettlementV2Error::FeeAllowance(
+                TemplateFeeAllowanceV2Error::FeeAboveAllowance { .. }
+            ))
+        ));
+    }
+}
diff --git a/crates/tx-graph/src/transactions/counterproof_v2.rs b/crates/tx-graph/src/transactions/counterproof_v2.rs
new file mode 100644
index 00000000..6a352fdf
--- /dev/null
+++ b/crates/tx-graph/src/transactions/counterproof_v2.rs
@@ -0,0 +1,1388 @@
+//! Versioned selected-counterproof parent for the v0.26 research graph.
+//!
+//! The exact topology is
+//! `CounterproofV2_j{C_0..C_n-1,P,D} -> {D_recovery,R_j,a_CP,U_i(i!=j)}`.
+//! The current [`NOfNConnector`] is used for `D` only as a research placeholder:
+//! this module does not prove freshness, establish a conflict with
+//! `CooperativePayout`, or make this graph funding-eligible.
+//! P2TR type plus local controller/script separation also do not prove
+//! possession of the recovery key or that the descriptor implements the
+//! intended vault policy; activation must validate both against the setup
+//! commitment.
+//! The research fee ceiling prevents unchecked donation only; activation must
+//! bind it and verify measured finalized vsize/feerate externally.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Script, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, Message, XOnlyPublicKey};
+use strata_bridge_connectors::{
+    prelude::{
+        ContestCounterproofOutputV2, ContestCounterproofSpendV2, ContestCounterproofV2Error,
+        ContestPayoutGateSpendPathV2, ContestPayoutGateV2, ContestPayoutGateWitnessV2,
+        CounterproofResolutionConnectorV2, KeyedAnchor, NOfNConnector, NOfNSpend,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+};
+
+/// Canonical `D`/`P` parent pair shared by every selection outcome.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct SharedSelectionOutpointsV2 {
+    /// Fresh research-only `D` input reserved for this selection graph.
+    pub deposit_outpoint: OutPoint,
+    /// Shared `P` gate from `ContestV2`.
+    pub contest_payout_outpoint: OutPoint,
+}
+
+/// One canonically ordered `C_i` input and its exact reserve-return policy.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofReserveBindingV2 {
+    outpoint: OutPoint,
+    connector: ContestCounterproofOutputV2,
+    return_descriptor: Descriptor,
+}
+
+impl CounterproofReserveBindingV2 {
+    /// Binds one assembler-derived `C_i` outpoint to its connector and return descriptor.
+    pub const fn new(
+        outpoint: OutPoint,
+        connector: ContestCounterproofOutputV2,
+        return_descriptor: Descriptor,
+    ) -> Self {
+        Self {
+            outpoint,
+            connector,
+            return_descriptor,
+        }
+    }
+
+    /// Returns the exact `C_i` outpoint.
+    pub const fn outpoint(&self) -> OutPoint {
+        self.outpoint
+    }
+
+    /// Returns the exact `C_i` connector.
+    pub const fn connector(&self) -> ContestCounterproofOutputV2 {
+        self.connector
+    }
+
+    /// Returns the setup-bound reserve-return descriptor.
+    pub const fn return_descriptor(&self) -> &Descriptor {
+        &self.return_descriptor
+    }
+}
+
+/// Exact parent bindings consumed by one selected counterproof alternative.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofV2Data {
+    /// Every fresh `C_i`, in canonical alternative order.
+    pub counterproof_reserves: Vec<CounterproofReserveBindingV2>,
+    /// Alternative whose `C_j` uses the counterproof path.
+    pub selected_index: usize,
+    /// Canonical shared `D`/`P` pair used by every competing parent.
+    pub shared_selection: SharedSelectionOutpointsV2,
+}
+
+/// Typed dynamic signing information in exact input-role order.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofV2SigningInfo {
+    /// One entry per canonical `C_i`; selected uses Counterproof, siblings ReserveRecovery.
+    pub counterproof_reserves: Vec<SigningInfo>,
+    /// Shared `P` immediate-selection signature.
+    pub contest_payout: SigningInfo,
+    /// Research `D` N-of-N signature.
+    pub deposit: SigningInfo,
+}
+
+/// Typed dynamic signatures for exact counterproof finalization.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofV2Signatures {
+    /// One graph signature per canonical `C_i` input.
+    pub counterproof_reserves: Vec<schnorr::Signature>,
+    /// Shared `P` immediate-selection graph signature.
+    pub contest_payout: schnorr::Signature,
+    /// Research `D` N-of-N signature.
+    pub deposit: schnorr::Signature,
+}
+
+impl CounterproofV2Data {
+    /// Returns the canonical shared `D`/`P` binding for activation checks.
+    pub const fn shared_selection(&self) -> SharedSelectionOutpointsV2 {
+        self.shared_selection
+    }
+}
+
+/// Exact selected-counterproof parent.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofV2Tx {
+    psbt: Psbt,
+    prevouts: Box<[TxOut]>,
+    counterproof_reserves: Box<[CounterproofReserveBindingV2]>,
+    selected_index: usize,
+    contest_payout_connector: ContestPayoutGateV2,
+    deposit_connector: NOfNConnector,
+    resolution_connector: CounterproofResolutionConnectorV2,
+    cpfp_connector: KeyedAnchor,
+}
+
+impl CounterproofV2Tx {
+    /// Exact recovery-vault output index.
+    pub const DEPOSIT_RECOVERY_VOUT: u32 = 0;
+    /// Selected alternative's ACK/timeout resolution output index.
+    pub const RESOLUTION_VOUT: u32 = 1;
+    /// Independently controlled counterproof CPFP output index.
+    pub const CPFP_VOUT: u32 = 2;
+    /// First exact unselected-reserve return output index.
+    pub const RESERVE_RETURN_0_VOUT: u32 = 3;
+
+    /// Constructs one exact selected-counterproof parent.
+    ///
+    /// `D` is returned without deduction to the setup-committed recovery
+    /// descriptor. Consequently, the checked value equation after exact `D`
+    /// cancellation is `C + P = R + a_CP + fee_CP`.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        data: CounterproofV2Data,
+        contest_payout_connector: ContestPayoutGateV2,
+        deposit_connector: NOfNConnector,
+        recovery_descriptor: &Descriptor,
+        resolution_connector: CounterproofResolutionConnectorV2,
+        cpfp_connector: KeyedAnchor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofV2Error> {
+        if data.counterproof_reserves.is_empty() {
+            return Err(CounterproofV2Error::EmptyReserveRoster);
+        }
+        if data.selected_index >= data.counterproof_reserves.len() {
+            return Err(CounterproofV2Error::SelectedIndexOutOfRange {
+                selected: data.selected_index,
+                reserve_count: data.counterproof_reserves.len(),
+            });
+        }
+        let mut input_outpoints: Vec<_> = data
+            .counterproof_reserves
+            .iter()
+            .map(CounterproofReserveBindingV2::outpoint)
+            .collect();
+        input_outpoints.extend([
+            data.shared_selection.contest_payout_outpoint,
+            data.shared_selection.deposit_outpoint,
+        ]);
+        for index in 0..input_outpoints.len() {
+            if input_outpoints[..index].contains(&input_outpoints[index]) {
+                return Err(CounterproofV2Error::DuplicateInputOutpoint { index });
+            }
+        }
+
+        let network = data.counterproof_reserves[0].connector.network();
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            if reserve.connector.network() != network {
+                return Err(CounterproofV2Error::ReserveNetworkMismatch { index });
+            }
+        }
+        for (name, candidate) in [
+            ("contest payout gate", contest_payout_connector.network()),
+            ("research deposit", deposit_connector.network()),
+            ("counterproof resolution", resolution_connector.network()),
+            ("counterproof CPFP", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(CounterproofV2Error::NetworkMismatch { connector: name });
+            }
+        }
+        if recovery_descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(CounterproofV2Error::InvalidRecoveryDescriptorType {
+                actual: recovery_descriptor.type_tag(),
+            });
+        }
+        let recovery_key = XOnlyPublicKey::from_slice(recovery_descriptor.payload())
+            .map_err(|_| CounterproofV2Error::InvalidRecoveryDescriptorPayload)?;
+        let mut reserve_keys = Vec::with_capacity(data.counterproof_reserves.len());
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            if reserve.return_descriptor.type_tag() != DescriptorType::P2tr {
+                return Err(CounterproofV2Error::InvalidReserveDescriptorType {
+                    index,
+                    actual: reserve.return_descriptor.type_tag(),
+                });
+            }
+            let reserve_key = XOnlyPublicKey::from_slice(reserve.return_descriptor.payload())
+                .map_err(|_| CounterproofV2Error::InvalidReserveDescriptorPayload { index })?;
+            if reserve_keys.contains(&reserve_key) {
+                return Err(CounterproofV2Error::DuplicateReserveController { index });
+            }
+            reserve_keys.push(reserve_key);
+        }
+
+        let mut nums_keys: Vec<_> = data
+            .counterproof_reserves
+            .iter()
+            .flat_map(|reserve| known_nums_keys("contest counterproof C", &reserve.connector))
+            .collect();
+        nums_keys.extend(known_nums_keys(
+            "contest payout P",
+            &contest_payout_connector,
+        ));
+        nums_keys.extend(known_nums_keys(
+            "counterproof resolution R",
+            &resolution_connector,
+        ));
+        for (controlled_component, controlled_key) in [
+            ("deposit recovery", recovery_key),
+            ("counterproof CPFP", cpfp_connector.internal_key()),
+        ] {
+            for nums in &nums_keys {
+                if controlled_key == nums.key {
+                    return Err(CounterproofV2Error::NumsControlKeyAlias {
+                        controlled_component,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+        }
+        let mut protocol_controllers = vec![
+            (
+                "contest payout graph key",
+                contest_payout_connector.graph_pubkey(),
+            ),
+            (
+                "research deposit N-of-N internal key",
+                deposit_connector.internal_key(),
+            ),
+            (
+                "research deposit N-of-N output key",
+                deposit_connector
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+            (
+                "counterproof resolution graph key",
+                resolution_connector.graph_pubkey(),
+            ),
+            (
+                "counterproof CPFP internal key",
+                cpfp_connector.internal_key(),
+            ),
+            (
+                "counterproof CPFP output key",
+                cpfp_connector
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+        ];
+        for reserve in &data.counterproof_reserves {
+            protocol_controllers.extend([
+                (
+                    "contest counterproof graph key",
+                    reserve.connector.graph_pubkey(),
+                ),
+                (
+                    "contest counterproof operator key",
+                    reserve.connector.operator_pubkey(),
+                ),
+            ]);
+        }
+        for (component, controller) in &protocol_controllers {
+            if recovery_key == *controller {
+                return Err(CounterproofV2Error::RecoveryControlKeyAlias { component });
+            }
+        }
+        for (index, reserve_key) in reserve_keys.iter().copied().enumerate() {
+            if reserve_key == recovery_key {
+                return Err(CounterproofV2Error::ReserveControlKeyAlias {
+                    index,
+                    component: "deposit recovery",
+                });
+            }
+            for (component, controller) in &protocol_controllers {
+                if reserve_key == *controller {
+                    return Err(CounterproofV2Error::ReserveControlKeyAlias { index, component });
+                }
+            }
+            for nums in &nums_keys {
+                if reserve_key == nums.key {
+                    return Err(CounterproofV2Error::ReserveNumsKeyAlias {
+                        index,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+        }
+
+        let reserve_prevouts: Vec<_> = data
+            .counterproof_reserves
+            .iter()
+            .map(|reserve| reserve.connector.tx_out())
+            .collect();
+        let contest_payout_prevout = contest_payout_connector.tx_out();
+        let deposit_prevout = deposit_connector.tx_out();
+        let resolution_output = resolution_connector.tx_out();
+        let cpfp_output = cpfp_connector.tx_out();
+        let recovery_script = recovery_descriptor.to_script();
+        let deposit_recovery_output = TxOut {
+            value: deposit_connector.value(),
+            script_pubkey: recovery_script.clone(),
+        };
+
+        for prevout in &reserve_prevouts {
+            ensure_money_range("contest counterproof prevout", prevout.value)?;
+            ensure_non_dust(
+                "contest counterproof prevout",
+                prevout.value,
+                &prevout.script_pubkey,
+            )?;
+        }
+        for (field, value) in [
+            ("contest payout prevout", contest_payout_prevout.value),
+            ("research deposit prevout", deposit_prevout.value),
+            ("deposit recovery output", deposit_recovery_output.value),
+            ("counterproof resolution output", resolution_output.value),
+            ("counterproof CPFP output", cpfp_output.value),
+            ("counterproof fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::Counterproof, fee)
+            .map_err(CounterproofV2Error::FeeAllowance)?;
+        for (field, output) in [
+            ("contest payout prevout", &contest_payout_prevout),
+            ("research deposit prevout", &deposit_prevout),
+            ("deposit recovery output", &deposit_recovery_output),
+            ("counterproof resolution output", &resolution_output),
+            ("counterproof CPFP output", &cpfp_output),
+        ] {
+            ensure_non_dust(field, output.value, &output.script_pubkey)?;
+        }
+
+        let mut protocol_scripts = vec![
+            (
+                "contest payout prevout",
+                contest_payout_prevout.script_pubkey.clone(),
+            ),
+            (
+                "research deposit prevout",
+                deposit_prevout.script_pubkey.clone(),
+            ),
+            (
+                "counterproof resolution",
+                resolution_output.script_pubkey.clone(),
+            ),
+            ("counterproof CPFP", cpfp_output.script_pubkey.clone()),
+        ];
+        protocol_scripts.extend(reserve_prevouts.iter().map(|prevout| {
+            (
+                "contest counterproof prevout",
+                prevout.script_pubkey.clone(),
+            )
+        }));
+        for (component, script) in &protocol_scripts {
+            if recovery_script == *script {
+                return Err(CounterproofV2Error::RecoveryScriptCollision { component });
+            }
+        }
+
+        let mut reserve_return_scripts = Vec::with_capacity(data.counterproof_reserves.len());
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            let script = reserve.return_descriptor.to_script();
+            ensure_non_dust(
+                "counterproof reserve return",
+                reserve.connector.value(),
+                &script,
+            )?;
+            if script == recovery_script {
+                return Err(CounterproofV2Error::ReserveScriptCollision {
+                    index,
+                    component: "deposit recovery",
+                });
+            }
+            for (component, protocol_script) in &protocol_scripts {
+                if script == *protocol_script {
+                    return Err(CounterproofV2Error::ReserveScriptCollision { index, component });
+                }
+            }
+            if reserve_return_scripts.contains(&script) {
+                return Err(CounterproofV2Error::DuplicateReserveScript { index });
+            }
+            reserve_return_scripts.push(script);
+        }
+
+        let selected_reserve = &data.counterproof_reserves[data.selected_index];
+        let contest_input = selected_reserve
+            .connector
+            .value()
+            .checked_add(contest_payout_prevout.value)
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range("counterproof C plus P input", contest_input)?;
+        let selected_outputs = resolution_output
+            .value
+            .checked_add(cpfp_output.value)
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range("counterproof R plus CPFP output", selected_outputs)?;
+        let selected_outputs_and_fee = selected_outputs
+            .checked_add(fee)
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range(
+            "counterproof R plus CPFP output plus fee",
+            selected_outputs_and_fee,
+        )?;
+        if contest_input != selected_outputs_and_fee {
+            return Err(CounterproofV2Error::ValueNotConserved {
+                contest_input,
+                selected_outputs,
+                fee,
+            });
+        }
+
+        let reserve_input = reserve_prevouts
+            .iter()
+            .try_fold(Amount::ZERO, |sum, prevout| {
+                sum.checked_add(prevout.value)
+                    .ok_or(CounterproofV2Error::AmountOverflow)
+            })?;
+        let total_input = reserve_input
+            .checked_add(contest_payout_prevout.value)
+            .and_then(|value| value.checked_add(deposit_prevout.value))
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range("counterproof total input", total_input)?;
+        let reserve_returns = reserve_input
+            .checked_sub(selected_reserve.connector.value())
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        let total_output = deposit_recovery_output
+            .value
+            .checked_add(selected_outputs)
+            .and_then(|value| value.checked_add(reserve_returns))
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range("counterproof total output", total_output)?;
+        let total_output_and_fee = total_output
+            .checked_add(fee)
+            .ok_or(CounterproofV2Error::AmountOverflow)?;
+        ensure_money_range("counterproof total output plus fee", total_output_and_fee)?;
+        if total_input != total_output_and_fee {
+            return Err(CounterproofV2Error::TotalValueNotConserved {
+                input: total_input,
+                output: total_output,
+                fee,
+            });
+        }
+
+        let selected_index = data.selected_index;
+        let mut prevouts = reserve_prevouts;
+        prevouts.extend([contest_payout_prevout, deposit_prevout]);
+        let mut input: Vec<_> = data
+            .counterproof_reserves
+            .iter()
+            .enumerate()
+            .map(|(index, reserve)| {
+                let path = if index == selected_index {
+                    ContestCounterproofSpendV2::Counterproof
+                } else {
+                    ContestCounterproofSpendV2::ReserveRecovery
+                };
+                TxIn {
+                    previous_output: reserve.outpoint,
+                    sequence: reserve.connector.sequence(path),
+                    ..Default::default()
+                }
+            })
+            .collect();
+        input.extend([
+            TxIn {
+                previous_output: data.shared_selection.contest_payout_outpoint,
+                sequence: contest_payout_connector
+                    .sequence(ContestPayoutGateSpendPathV2::ImmediateSelection),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.shared_selection.deposit_outpoint,
+                sequence: deposit_connector.sequence(NOfNSpend),
+                ..Default::default()
+            },
+        ]);
+        let mut output = vec![deposit_recovery_output, resolution_output, cpfp_output];
+        output.extend(
+            data.counterproof_reserves
+                .iter()
+                .enumerate()
+                .filter(|(index, _reserve)| *index != selected_index)
+                .map(|(index, reserve)| TxOut {
+                    value: reserve.connector.value(),
+                    script_pubkey: reserve_return_scripts[index].clone(),
+                }),
+        );
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(CounterproofV2Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts: prevouts.into_boxed_slice(),
+            counterproof_reserves: data.counterproof_reserves.into_boxed_slice(),
+            selected_index,
+            contest_payout_connector,
+            deposit_connector,
+            resolution_connector,
+            cpfp_connector,
+        })
+    }
+
+    /// Returns the exact operator-key sighashes in natural datum order.
+    pub fn operator_sighashes(&self) -> Vec<Message> {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        self.counterproof_reserves[self.selected_index]
+            .connector
+            .get_sighashes_with_code_separator(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestCounterproofSpendV2::Counterproof,
+                self.selected_index,
+            )
+            .into_iter()
+            .collect()
+    }
+
+    /// Returns the selected ACK/timeout resolution connector.
+    pub const fn resolution_connector(&self) -> &CounterproofResolutionConnectorV2 {
+        &self.resolution_connector
+    }
+
+    /// Returns typed signing information for every exact dynamic input.
+    pub fn signing_info(&self) -> CounterproofV2SigningInfo {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        let reserve_count = self.counterproof_reserves.len();
+        let counterproof_reserves = self
+            .counterproof_reserves
+            .iter()
+            .enumerate()
+            .map(|(index, reserve)| {
+                let path = if index == self.selected_index {
+                    ContestCounterproofSpendV2::Counterproof
+                } else {
+                    ContestCounterproofSpendV2::ReserveRecovery
+                };
+                reserve.connector.get_signing_info(
+                    &mut cache,
+                    Prevouts::All(&self.prevouts),
+                    path,
+                    index,
+                )
+            })
+            .collect();
+        CounterproofV2SigningInfo {
+            counterproof_reserves,
+            contest_payout: self.contest_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestPayoutGateSpendPathV2::ImmediateSelection,
+                reserve_count,
+            ),
+            deposit: self.deposit_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                NOfNSpend,
+                reserve_count + 1,
+            ),
+        }
+    }
+
+    /// Returns the exact output index for an unselected reserve.
+    pub fn reserve_return_vout(&self, reserve_index: usize) -> Result<u32, CounterproofV2Error> {
+        if reserve_index >= self.counterproof_reserves.len() {
+            return Err(CounterproofV2Error::ReserveIndexOutOfRange {
+                index: reserve_index,
+                reserve_count: self.counterproof_reserves.len(),
+            });
+        }
+        if reserve_index == self.selected_index {
+            return Err(CounterproofV2Error::SelectedReserveHasNoReturn {
+                index: reserve_index,
+            });
+        }
+        let compact_index = if reserve_index < self.selected_index {
+            reserve_index
+        } else {
+            reserve_index - 1
+        };
+        Self::RESERVE_RETURN_0_VOUT
+            .checked_add(
+                u32::try_from(compact_index)
+                    .map_err(|_| CounterproofV2Error::ReserveVoutOverflow { reserve_index })?,
+            )
+            .ok_or(CounterproofV2Error::ReserveVoutOverflow { reserve_index })
+    }
+
+    /// Finalizes every exact dynamic input and rejects signature-roster drift.
+    pub fn finalize(
+        self,
+        operator_signatures: Vec<schnorr::Signature>,
+        input_signatures: CounterproofV2Signatures,
+    ) -> Result<Transaction, CounterproofV2Error> {
+        let expected_reserves = self.counterproof_reserves.len();
+        let actual_reserves = input_signatures.counterproof_reserves.len();
+        if actual_reserves != expected_reserves {
+            return Err(CounterproofV2Error::ReserveSignatureCount {
+                expected: expected_reserves,
+                actual: actual_reserves,
+            });
+        }
+        let selected_connector = self.counterproof_reserves[self.selected_index].connector;
+        let expected = selected_connector.n_data().get();
+        let actual = operator_signatures.len();
+        if actual != expected {
+            return Err(CounterproofV2Error::OperatorWitnessCount { expected, actual });
+        }
+        let selected_witness = selected_connector
+            .counterproof_witness(
+                input_signatures.counterproof_reserves[self.selected_index],
+                operator_signatures,
+            )
+            .map_err(CounterproofV2Error::ContestWitness)?;
+
+        let mut psbt = self.psbt;
+        for (index, reserve) in self.counterproof_reserves.iter().enumerate() {
+            let (path, witness) = if index == self.selected_index {
+                (
+                    ContestCounterproofSpendV2::Counterproof,
+                    selected_witness.clone(),
+                )
+            } else {
+                (
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    reserve
+                        .connector
+                        .reserve_recovery_witness(input_signatures.counterproof_reserves[index]),
+                )
+            };
+            reserve
+                .connector
+                .try_finalize_input(&mut psbt.inputs[index], path, &witness)
+                .map_err(CounterproofV2Error::ContestWitness)?;
+        }
+        let payout_index = self.counterproof_reserves.len();
+        self.contest_payout_connector.finalize_input(
+            &mut psbt.inputs[payout_index],
+            &ContestPayoutGateWitnessV2::ImmediateSelection {
+                graph_signature: input_signatures.contest_payout,
+            },
+        );
+        self.deposit_connector.finalize_input(
+            &mut psbt.inputs[payout_index + 1],
+            &input_signatures.deposit,
+        );
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn ensure_money_range(field: &'static str, value: Amount) -> Result<(), CounterproofV2Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofV2Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(
+    field: &'static str,
+    value: Amount,
+    script_pubkey: &Script,
+) -> Result<(), CounterproofV2Error> {
+    let minimum = script_pubkey.minimal_non_dust();
+    if value < minimum {
+        return Err(CounterproofV2Error::DustValue {
+            field,
+            value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+impl ParentTx for CounterproofV2Tx {
+    type CpfpConnector = KeyedAnchor;
+
+    fn cpfp_tx_out(&self) -> TxOut {
+        self.cpfp_connector.tx_out()
+    }
+
+    fn cpfp_outpoint(&self) -> OutPoint {
+        OutPoint::new(self.psbt.unsigned_tx.compute_txid(), Self::CPFP_VOUT)
+    }
+
+    fn cpfp_connector(&self) -> &Self::CpfpConnector {
+        &self.cpfp_connector
+    }
+}
+
+impl AsRef<Transaction> for CounterproofV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize an exact v2 counterproof parent.
+#[derive(Debug)]
+pub enum CounterproofV2Error {
+    /// No `C_i` reserve bindings were supplied.
+    EmptyReserveRoster,
+    /// Selected alternative is outside the canonical reserve roster.
+    SelectedIndexOutOfRange {
+        /// Rejected selected index.
+        selected: usize,
+        /// Canonical reserve count.
+        reserve_count: usize,
+    },
+    /// Two transaction inputs name the same outpoint.
+    DuplicateInputOutpoint {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// Connector networks do not match.
+    NetworkMismatch {
+        /// Connector whose network differs from `C_i`.
+        connector: &'static str,
+    },
+    /// One `C_i` connector is on a different network.
+    ReserveNetworkMismatch {
+        /// Mismatching reserve index.
+        index: usize,
+    },
+    /// Recovery is restricted to the setup policy's P2TR vault descriptor.
+    InvalidRecoveryDescriptorType {
+        /// Rejected BOSD descriptor type.
+        actual: DescriptorType,
+    },
+    /// A P2TR descriptor carried a malformed controller payload.
+    InvalidRecoveryDescriptorPayload,
+    /// A reserve return is not a canonical P2TR descriptor.
+    InvalidReserveDescriptorType {
+        /// Reserve index.
+        index: usize,
+        /// Rejected BOSD type.
+        actual: DescriptorType,
+    },
+    /// A reserve-return P2TR descriptor has a malformed key payload.
+    InvalidReserveDescriptorPayload {
+        /// Reserve index.
+        index: usize,
+    },
+    /// Two reserve returns reuse one controller.
+    DuplicateReserveController {
+        /// Later duplicate index.
+        index: usize,
+    },
+    /// Recovery reuses a known protocol controller even if its script differs.
+    RecoveryControlKeyAlias {
+        /// Protocol controller aliased by recovery.
+        component: &'static str,
+    },
+    /// A reserve-return controller aliases another protocol controller.
+    ReserveControlKeyAlias {
+        /// Reserve index.
+        index: usize,
+        /// Aliased component.
+        component: &'static str,
+    },
+    /// A recovery or CPFP controller aliases an unspendable v2 NUMS key.
+    NumsControlKeyAlias {
+        /// Caller-controlled role that reused the key.
+        controlled_component: &'static str,
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// A reserve-return controller aliases a known unspendable NUMS key.
+    ReserveNumsKeyAlias {
+        /// Reserve index.
+        index: usize,
+        /// NUMS-bearing component.
+        nums_component: &'static str,
+        /// Untweaked or tweaked key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A prevout, output, fee, or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Out-of-range value.
+        value: Amount,
+    },
+    /// A required spendable prevout or output is below its script dust floor.
+    DustValue {
+        /// Offending value role.
+        field: &'static str,
+        /// Supplied value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// The recovery script duplicates a protocol control domain.
+    RecoveryScriptCollision {
+        /// Protocol component whose script collides with recovery.
+        component: &'static str,
+    },
+    /// A reserve return duplicates a protocol script.
+    ReserveScriptCollision {
+        /// Reserve index.
+        index: usize,
+        /// Aliased component.
+        component: &'static str,
+    },
+    /// Two reserve returns reuse one script.
+    DuplicateReserveScript {
+        /// Later duplicate index.
+        index: usize,
+    },
+    /// The fee exceeds or is not bound by the exact counterproof allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// The exact value equation after `D` cancellation does not hold.
+    ValueNotConserved {
+        /// Sum of `C_i` and `P`.
+        contest_input: Amount,
+        /// Sum of `R_i` and `a_CP`.
+        selected_outputs: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// Full dynamic inputs, reserve returns, and fee do not conserve value.
+    TotalValueNotConserved {
+        /// Sum of every `C_i`, `P`, and `D`.
+        input: Amount,
+        /// Sum of recovery, selected, and reserve-return outputs.
+        output: Amount,
+        /// Exact fee.
+        fee: Amount,
+    },
+    /// The operator witness does not match the exact count committed by `C_i`.
+    OperatorWitnessCount {
+        /// Required number of operator signatures.
+        expected: usize,
+        /// Supplied number of operator signatures.
+        actual: usize,
+    },
+    /// Graph signatures do not match the canonical `C_i` roster.
+    ReserveSignatureCount {
+        /// Exact reserve count.
+        expected: usize,
+        /// Supplied signature count.
+        actual: usize,
+    },
+    /// A checked reserve output lookup is outside the roster.
+    ReserveIndexOutOfRange {
+        /// Rejected reserve index.
+        index: usize,
+        /// Exact reserve count.
+        reserve_count: usize,
+    },
+    /// Selected `C_j` funds the counterproof and therefore has no return output.
+    SelectedReserveHasNoReturn {
+        /// Selected reserve index.
+        index: usize,
+    },
+    /// A dynamic reserve-return output index cannot fit in `u32`.
+    ReserveVoutOverflow {
+        /// Reserve index whose vout cannot be represented.
+        reserve_index: usize,
+    },
+    /// The fresh `C_i` connector rejected witness construction or finalization.
+    ContestWitness(ContestCounterproofV2Error),
+    /// The constructed unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyReserveRoster => {
+                f.write_str("counterproof requires at least one C_i reserve binding")
+            }
+            Self::SelectedIndexOutOfRange {
+                selected,
+                reserve_count,
+            } => write!(
+                f,
+                "selected counterproof index {selected} is outside reserve roster of length {reserve_count}"
+            ),
+            Self::DuplicateInputOutpoint { index } => write!(
+                f,
+                "counterproof input at index {index} duplicates an earlier outpoint"
+            ),
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match contest counterproof")
+            }
+            Self::ReserveNetworkMismatch { index } => write!(
+                f,
+                "counterproof reserve at index {index} has a different network"
+            ),
+            Self::InvalidRecoveryDescriptorType { actual } => write!(
+                f,
+                "counterproof recovery descriptor must be P2TR, got {actual}"
+            ),
+            Self::InvalidRecoveryDescriptorPayload => {
+                f.write_str("counterproof recovery P2TR payload is not a valid x-only key")
+            }
+            Self::InvalidReserveDescriptorType { index, actual } => write!(
+                f,
+                "counterproof reserve return {index} must be P2TR, got {actual}"
+            ),
+            Self::InvalidReserveDescriptorPayload { index } => write!(
+                f,
+                "counterproof reserve return {index} P2TR payload is not a valid x-only key"
+            ),
+            Self::DuplicateReserveController { index } => write!(
+                f,
+                "counterproof reserve return {index} reuses an earlier controller"
+            ),
+            Self::RecoveryControlKeyAlias { component } => {
+                write!(f, "deposit recovery key aliases {component}")
+            }
+            Self::ReserveControlKeyAlias { index, component } => write!(
+                f,
+                "counterproof reserve return {index} key aliases {component}"
+            ),
+            Self::NumsControlKeyAlias {
+                controlled_component,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "{controlled_component} key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::ReserveNumsKeyAlias {
+                index,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "counterproof reserve return {index} key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::AmountOverflow => f.write_str("counterproof amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustValue {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below its dust floor {minimum}"),
+            Self::RecoveryScriptCollision { component } => {
+                write!(f, "deposit recovery script collides with {component}")
+            }
+            Self::ReserveScriptCollision { index, component } => write!(
+                f,
+                "counterproof reserve return {index} script collides with {component}"
+            ),
+            Self::DuplicateReserveScript { index } => write!(
+                f,
+                "counterproof reserve return {index} reuses an earlier script"
+            ),
+            Self::FeeAllowance(error) => {
+                write!(f, "invalid counterproof fee allowance: {error}")
+            }
+            Self::ValueNotConserved {
+                contest_input,
+                selected_outputs,
+                fee,
+            } => write!(
+                f,
+                "counterproof value after D cancellation is not conserved: C+P={contest_input}, R+a_CP={selected_outputs}, fee={fee}"
+            ),
+            Self::TotalValueNotConserved { input, output, fee } => write!(
+                f,
+                "counterproof total value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::OperatorWitnessCount { expected, actual } => write!(
+                f,
+                "counterproof requires exactly {expected} operator signatures, got {actual}"
+            ),
+            Self::ReserveSignatureCount { expected, actual } => write!(
+                f,
+                "counterproof requires exactly {expected} C_i graph signatures, got {actual}"
+            ),
+            Self::ReserveIndexOutOfRange {
+                index,
+                reserve_count,
+            } => write!(
+                f,
+                "counterproof reserve index {index} is outside roster of length {reserve_count}"
+            ),
+            Self::SelectedReserveHasNoReturn { index } => write!(
+                f,
+                "selected counterproof reserve {index} has no reserve-return output"
+            ),
+            Self::ReserveVoutOverflow { reserve_index } => write!(
+                f,
+                "counterproof reserve return vout for index {reserve_index} overflows u32"
+            ),
+            Self::ContestWitness(error) => {
+                write!(f, "contest-counterproof witness was rejected: {error}")
+            }
+            Self::Psbt(error) => write!(f, "failed to construct counterproof PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::ContestWitness(error) => Some(error),
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
