index 00000000..20cd2142
--- /dev/null
+++ b/crates/connectors/src/contest_payout_gate_v2.rs
@@ -0,0 +1,489 @@
+//! Draft v0.26 shared selection/owner-payout gate.
+//!
+//! The immediate leaf is shared by the exact CounterproofV2 and bridge-proof
+//! timeout parents.  The competing owner leaf is CSV-delayed.  Both are
+//! script-only graph-signature paths under a caller-bound research NUMS key.
+//! CHECKSIG is not a covenant: funding safety still requires complete exact
+//! presigning and verified one-honest graph-key erasure.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{opcodes, relative, script, Amount, Network, ScriptBuf, Sequence};
+use secp256k1::{schnorr, XOnlyPublicKey};
+
+use crate::{
+    ranklock_nums::{NumsDerivationError, ResearchV0NumsContext, ResearchV0NumsRole},
+    Connector, TaprootWitness,
+};
+
+/// Shared P output consumed by CP/BPT immediately or owner payout after CSV.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ContestPayoutGateV2 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    owner_delay: relative::Height,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl ContestPayoutGateV2 {
+    /// Constructs a research-profile payout gate and rejects malformed policy.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        owner_delay: relative::Height,
+        value: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, ContestPayoutGateErrorV2> {
+        if owner_delay.value() == 0 {
+            return Err(ContestPayoutGateErrorV2::ZeroOwnerDelay);
+        }
+        if value > Amount::MAX_MONEY {
+            return Err(ContestPayoutGateErrorV2::ValueAboveMaxMoney { value });
+        }
+        if nums_context.role() != ResearchV0NumsRole::ContestPayoutGate {
+            return Err(ContestPayoutGateErrorV2::WrongNumsRole);
+        }
+        let internal_key = nums_context
+            .derive_internal_key()
+            .map_err(ContestPayoutGateErrorV2::NumsDerivation)?;
+        let connector = Self {
+            network,
+            graph_pubkey,
+            owner_delay,
+            value,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if graph_pubkey == internal_key || graph_pubkey == output_key {
+            return Err(ContestPayoutGateErrorV2::GraphNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if value < minimum {
+            return Err(ContestPayoutGateErrorV2::DustValue { value, minimum });
+        }
+        Ok(connector)
+    }
+
+    /// Returns the graph key controlling both exact payout-gate script paths.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    /// CSV delay of the owner-payout branch.
+    pub const fn owner_delay(&self) -> relative::Height {
+        self.owner_delay
+    }
+
+    fn immediate_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+
+    fn owner_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_sequence(Sequence::from_height(self.owner_delay.value()))
+            .push_opcode(opcodes::all::OP_CSV)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
+
+impl Connector for ContestPayoutGateV2 {
+    type SpendPath = ContestPayoutGateSpendPathV2;
+    type Witness = ContestPayoutGateWitnessV2;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.immediate_script(), self.owner_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, spend_path: Self::SpendPath) -> Option<usize> {
+        Some(match spend_path {
+            ContestPayoutGateSpendPathV2::ImmediateSelection => 0,
+            ContestPayoutGateSpendPathV2::OwnerPayout => 1,
+        })
+    }
+
+    fn sequence(&self, spend_path: Self::SpendPath) -> Sequence {
+        match spend_path {
+            ContestPayoutGateSpendPathV2::ImmediateSelection => Sequence::MAX,
+            ContestPayoutGateSpendPathV2::OwnerPayout => {
+                Sequence::from_height(self.owner_delay.value())
+            }
+        }
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        let (leaf_index, graph_signature) = match witness {
+            ContestPayoutGateWitnessV2::ImmediateSelection { graph_signature } => {
+                (0, graph_signature)
+            }
+            ContestPayoutGateWitnessV2::OwnerPayout { graph_signature } => (1, graph_signature),
+        };
+        TaprootWitness::Script {
+            leaf_index,
+            script_inputs: vec![graph_signature.serialize().to_vec()],
+        }
+    }
+}
+
+/// Authorized leaves of [`ContestPayoutGateV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ContestPayoutGateSpendPathV2 {
+    /// Immediate shared selection path for exact CP/BPT parents.
+    ImmediateSelection,
+    /// CSV-delayed exact owner-payout parent.
+    OwnerPayout,
+}
+
+/// Witnesses for [`ContestPayoutGateV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ContestPayoutGateWitnessV2 {
+    /// Exact graph signature for an immediate CP/BPT parent.
+    ImmediateSelection {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+    /// Exact graph signature for the delayed owner-payout parent.
+    OwnerPayout {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+}
+
+/// Invalid v2 payout-gate policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ContestPayoutGateErrorV2 {
+    /// CSV must not be disabled.
+    ZeroOwnerDelay,
+    /// A different output role was supplied to the NUMS derivation.
+    WrongNumsRole,
+    /// The connector value exceeds Bitcoin's consensus money range.
+    ValueAboveMaxMoney {
+        /// Value supplied by the caller.
+        value: Amount,
+    },
+    /// The NUMS point could not be reconstructed.
+    NumsDerivation(NumsDerivationError),
+    /// Graph authorization aliases the connector's unspendable NUMS key domain.
+    GraphNumsKeyAlias,
+    /// The value is below the connector's actual script-dependent dust floor.
+    DustValue {
+        /// Value supplied by the caller.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for ContestPayoutGateErrorV2 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ZeroOwnerDelay => f.write_str("payout-gate owner delay must be positive"),
+            Self::WrongNumsRole => f.write_str("payout gate was given the wrong draft NUMS role"),
+            Self::ValueAboveMaxMoney { value } => {
+                write!(f, "payout-gate value {value} exceeds MAX_MONEY")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::GraphNumsKeyAlias => {
+                f.write_str("payout-gate graph key aliases its NUMS internal/output key")
+            }
+            Self::DustValue { value, minimum } => {
+                write!(
+                    f,
+                    "payout-gate value {value} is below its dust floor {minimum}"
+                )
+            }
+        }
+    }
+}
+
+impl Error for ContestPayoutGateErrorV2 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::NumsDerivation(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
