+#[cfg(test)]
+mod tests {
+    use bitcoin::{
+        Txid,
+        hashes::{Hash, sha256},
+    };
+    use strata_bridge_sm::v026_admission::{
+        V026_BLOCKERS_V1, V026BlockerCodeV1, V026LocalAlternativeTxidManifestV1,
+        V026LocalTxidManifestV1,
+    };
+
+    use super::*;
+
+    fn record() -> V026AdmissionBodyV1 {
+        let graph_idx = GraphIdx {
+            deposit: 17,
+            operator: 4,
+        };
+        let manifest = V026LocalTxidManifestV1 {
+            contest: Txid::from_byte_array([1; 32]),
+            owner_payout: Txid::from_byte_array([2; 32]),
+            alternatives: vec![V026LocalAlternativeTxidManifestV1 {
+                counterproof: Txid::from_byte_array([3; 32]),
+                ack: Txid::from_byte_array([4; 32]),
+                timeout: Txid::from_byte_array([5; 32]),
+                slash: Txid::from_byte_array([6; 32]),
+            }],
+        };
+        V026AdmissionBodyV1 {
+            graph_idx,
+            local_manifest: manifest,
+            blockers: V026_BLOCKERS_V1,
+        }
+    }
+
+    #[test]
+    fn versioned_envelope_roundtrips_exactly() {
+        let value = V026AdmissionValue(record());
+        let encoded = value.serialize().expect("V1 observation serializes");
+        assert_eq!(
+            value
+                .serialize()
+                .expect("V1 serialization is deterministic"),
+            encoded
+        );
+        assert_eq!(&encoded[..ENVELOPE_MAGIC.len()], ENVELOPE_MAGIC);
+        assert_eq!(
+            &encoded[ENVELOPE_MAGIC.len()..ENVELOPE_HEADER_LEN],
+            &ENVELOPE_VERSION_V1.to_le_bytes()
+        );
+        assert_eq!(
+            V026AdmissionValue::deserialize(&encoded).expect("V1 observation deserializes"),
+            value
+        );
+    }
+
+    #[test]
+    fn frozen_v1_envelope_matches_golden_bytes() {
+        let encoded = V026AdmissionValue(record())
+            .serialize()
+            .expect("V1 observation serializes");
+        assert_eq!(encoded.len(), 225);
+        assert_eq!(
+            sha256::Hash::hash(&encoded).to_byte_array(),
+            [
+                0xc9, 0x18, 0x53, 0xdf, 0xa7, 0x5d, 0xa2, 0x0f, 0x06, 0xc2, 0x97, 0xd3, 0x6c, 0xea,
+                0x3d, 0x6b, 0x65, 0x30, 0x25, 0x6c, 0xdc, 0x78, 0xda, 0x73, 0xb3, 0x65, 0x3e, 0x4f,
+                0xce, 0x1a, 0x77, 0x34,
+            ]
+        );
+    }
+
+    #[test]
+    fn malformed_versioned_envelopes_fail_closed() {
+        let value = V026AdmissionValue(record());
+        let encoded = value.serialize().expect("V1 observation serializes");
+
+        assert!(matches!(
+            V026AdmissionValue::deserialize(&encoded[..ENVELOPE_HEADER_LEN - 1]),
+            Err(V026AdmissionDeserializeError::UnexpectedEof { .. })
+        ));
+
+        let mut bad_magic = encoded.clone();
+        bad_magic[0] ^= 1;
+        assert!(matches!(
+            V026AdmissionValue::deserialize(&bad_magic),
+            Err(V026AdmissionDeserializeError::InvalidMagic)
+        ));
+
+        let mut unknown_version = encoded.clone();
+        unknown_version[ENVELOPE_MAGIC.len()..ENVELOPE_HEADER_LEN]
+            .copy_from_slice(&2_u16.to_le_bytes());
+        assert!(matches!(
+            V026AdmissionValue::deserialize(&unknown_version),
+            Err(V026AdmissionDeserializeError::UnsupportedVersion { version: 2 })
+        ));
+
+        let mut trailing = encoded;
+        trailing.push(0);
+        assert!(matches!(
+            V026AdmissionValue::deserialize(&trailing),
+            Err(V026AdmissionDeserializeError::TrailingBytes { count: 1 })
+        ));
+    }
+
+    #[test]
+    fn nonminimal_varints_fail_canonical_reencode() {
+        let canonical = V026AdmissionValue(record())
+            .serialize()
+            .expect("V1 observation serializes");
+        let body = &canonical[ENVELOPE_HEADER_LEN..];
+        let alternative_count_offset = 2 + 32 + 32;
+        let first_blocker_offset = body.len() - V026_BLOCKERS_V1.len();
+        for (label, body_offset, expected, postcard_accepts_nonminimal) in [
+            ("deposit index", 0, 17_u8, true),
+            ("alternative count", alternative_count_offset, 2_u8, false),
+            ("first blocker", first_blocker_offset, 1_u8, true),
+        ] {
+            assert_eq!(
+                body[body_offset], expected,
+                "unexpected {label} fixture byte"
+            );
+            let mut nonminimal = canonical.clone();
+            let offset = ENVELOPE_HEADER_LEN + body_offset;
+            nonminimal.splice(offset..=offset, [expected | 0x80, 0]);
+            let result = V026AdmissionValue::deserialize(&nonminimal);
+            if postcard_accepts_nonminimal {
+                assert!(
+                    matches!(result, Err(V026AdmissionDeserializeError::NonCanonicalBody)),
+                    "unexpected {label} decode result: {result:?}"
+                );
+            } else {
+                assert!(
+                    matches!(result, Err(V026AdmissionDeserializeError::Postcard(_))),
+                    "unexpected {label} decode result: {result:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn unknown_blocker_in_body_fails_closed() {
+        let mut encoded = V026AdmissionValue(record())
+            .serialize()
+            .expect("V1 observation serializes");
+        let final_blocker = encoded.last_mut().expect("encoded body is nonempty");
+        assert_eq!(
+            *final_blocker,
+            V026BlockerCodeV1::ValidityWithholdingEconomicsUnresolved as u8
+        );
+        *final_blocker = 16;
+        assert!(matches!(
+            V026AdmissionValue::deserialize(&encoded),
+            Err(V026AdmissionDeserializeError::Postcard(_))
+        ));
+    }
+
+    #[test]
+    fn serializer_rejects_noncanonical_blocker_array() {
+        let valid = record();
+        let mut blockers = V026_BLOCKERS_V1;
+        blockers[14] = blockers[13];
+        let invalid = V026AdmissionBodyV1 {
+            graph_idx: valid.graph_idx,
+            local_manifest: valid.local_manifest,
+            blockers,
+        };
+
+        assert!(matches!(
+            V026AdmissionValue(invalid).serialize(),
+            Err(V026AdmissionSerializeError::InvalidRecord(
+                V026PersistedObservationError::BlockerSetMismatch
+            ))
+        ));
+    }
+}
