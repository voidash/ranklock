+    fn funded_graph() -> (BitcoinNode, V026Graph, CoreKeys) {
+        let (mut plan, keys) = plan_with_keys();
+        let mut node = BitcoinNode::new();
+        let funding_fee = Amount::from_sat(2_000);
+        let protocol_value = checked_sum(
+            "test funding",
+            None,
+            [
+                plan.claim.connector.value(),
+                plan.deposit.connector.value(),
+                plan.claim_payout.connector.value(),
+                plan.stake.connector.value(),
+            ],
+        )
+        .expect("test protocol values fit");
+        let change = node
+            .coinbase_amount()
+            .checked_sub(protocol_value)
+            .and_then(|value| value.checked_sub(funding_fee))
+            .expect("coinbase funds the test graph");
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                plan.claim.connector.tx_out(),
+                plan.deposit.connector.tx_out(),
+                plan.claim_payout.connector.tx_out(),
+                plan.stake.connector.tx_out(),
+                TxOut {
+                    value: change,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = funding_tx.compute_txid();
+        plan.claim.outpoint = OutPoint::new(funding_txid, ClaimTx::CONTEST_VOUT);
+        plan.deposit.outpoint = OutPoint::new(funding_txid, 1);
+        plan.claim_payout.outpoint = OutPoint::new(funding_txid, 2);
+        plan.stake.outpoint = OutPoint::new(funding_txid, 3);
+        let graph = V026Graph::assemble(plan).expect("valid assembled Core graph");
+        graph.verify_structure().expect("exact graph re-verifies");
+        assert!(!graph.funding_eligible());
+        assert_eq!(graph.activation_blockers().len(), 16);
+
+        assert_eq!(node.sign_and_broadcast(&funding_tx), funding_txid);
+        node.mine_blocks(1);
+
+        (node, graph, keys)
+    }
+
+    fn finalized_contest(graph: &V026Graph, keys: &CoreKeys) -> Transaction {
+        let contest = graph.contest().clone();
+        let contest_signing = contest.signing_info(0).expect("valid alternative");
+        contest
+            .finalize(
+                contest_signing.sign(&keys.graph),
+                0,
+                contest_signing.sign(&keys.watchtowers[0]),
+            )
+            .expect("valid Contest witnesses")
+    }
+
+    fn confirmed_contest_graph() -> (BitcoinNode, V026Graph, CoreKeys) {
+        let (mut node, graph, keys) = funded_graph();
+        let contest_tx = finalized_contest(&graph, &keys);
+        node.client()
+            .send_raw_transaction(&contest_tx)
+            .expect("Core accepts Contest");
+        node.mine_blocks(1);
+        (node, graph, keys)
+    }
+
+    fn finalized_counterproof(
+        graph: &V026Graph,
+        keys: &CoreKeys,
+        alternative_index: usize,
+    ) -> Transaction {
+        let counterproof = graph.alternatives()[alternative_index]
+            .counterproof()
+            .clone();
+        let operator_signatures = counterproof
+            .operator_sighashes()
+            .into_iter()
+            .map(|message| keys.counterproof_operators[alternative_index].sign_schnorr(message))
+            .collect();
+        let signing = counterproof.signing_info();
+        counterproof
+            .finalize(
+                operator_signatures,
+                CounterproofV2Signatures {
+                    counterproof_reserves: signing
+                        .counterproof_reserves
+                        .iter()
+                        .map(|signing_info| signing_info.sign(&keys.graph))
+                        .collect(),
+                    contest_payout: signing.contest_payout.sign(&keys.graph),
+                    deposit: signing.deposit.sign(&keys.deposit),
+                },
+            )
+            .expect("valid counterproof witnesses")
+    }
+
+    fn finalized_owner_payout(graph: &V026Graph, keys: &CoreKeys) -> Transaction {
+        let owner = graph.owner_payout().clone();
+        let signing = owner.signing_info();
+        owner
+            .finalize(OwnerPayoutV2Signatures {
+                deposit: signing.deposit.sign(&keys.deposit),
+                claim_payout: signing.claim_payout.sign(&keys.claim_payout),
+                contest_payout: signing.contest_payout.sign(&keys.graph),
+                contest_slash: signing.contest_slash.sign(&keys.graph),
+                counterproof_reserves: signing
+                    .counterproof_reserves
+                    .iter()
+                    .map(|signing_info| signing_info.sign(&keys.graph))
+                    .collect(),
+            })
+            .expect("valid owner-payout witnesses")
+    }
+
+    fn confirmed_selected_graph(selected_index: usize) -> (BitcoinNode, V026Graph, CoreKeys) {
+        let (mut node, graph, keys) = confirmed_contest_graph();
+        let selected_tx = finalized_counterproof(&graph, &keys, selected_index);
+        node.client()
+            .send_raw_transaction(&selected_tx)
+            .expect("Core accepts selected counterproof");
+        node.mine_blocks(1);
+        (node, graph, keys)
+    }
+
+    fn confirmed_ack_graph() -> (BitcoinNode, V026Graph, CoreKeys, Txid) {
+        let (mut node, graph, keys) = confirmed_selected_graph(0);
+        let ack = graph.alternatives()[0].ack().clone();
+        let signing = ack.signing_info();
+        let tx = ack
+            .finalize(
+                keys.release_preimages.clone(),
+                [signing[0].sign(&keys.graph)],
+            )
+            .expect("valid ACK witnesses");
+        let txid = tx.compute_txid();
+        node.client()
+            .send_raw_transaction(&tx)
+            .expect("Core accepts ACK");
+        node.mine_blocks(1);
+        (node, graph, keys, txid)
+    }
