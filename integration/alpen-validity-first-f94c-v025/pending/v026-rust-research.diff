index 00000000..d5b41802
--- /dev/null
+++ b/crates/tx-graph/src/transactions/counterproof_ack_v2.rs
@@ -0,0 +1,731 @@
+//! Versioned ACK transaction for the v0.26 shared-selection graph.
+//!
+//! `CounterproofAckV2Tx` spends only the selected counterproof's resolution
+//! output.  A successful ACK creates the otherwise-unavailable authorization
+//! for the corresponding `SlashV2Tx`; its CPFP output is deliberately
+//! separate from that authorization.
+//! Its research fee ceiling prevents unchecked donation only; activation must
+//! bind that ceiling and verify measured finalized vsize/feerate externally.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Script, Transaction, TxIn, TxOut,
+};
+use secp256k1::schnorr;
+use strata_bridge_connectors::{
+    prelude::{
+        CounterproofResolutionConnectorV2, CounterproofResolutionSpendPathV2,
+        CounterproofResolutionWitnessV2, KeyedAnchor, SlashAuthorizationConnectorV2,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+    PresignedTx,
+};
+
+/// Exact parent outpoint selected by a confirmed `CounterproofV2Tx`.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofAckV2Data {
+    /// Resolution output created by the selected counterproof.
+    pub resolution_outpoint: OutPoint,
+}
+
+/// Immediate positive-lock ACK transaction.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofAckV2Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    resolution_connector: CounterproofResolutionConnectorV2,
+    slash_authorization_connector: SlashAuthorizationConnectorV2,
+    cpfp_connector: KeyedAnchor,
+}
+
+impl CounterproofAckV2Tx {
+    /// Slash authorization output index.
+    pub const SLASH_AUTHORIZATION_VOUT: u32 = 0;
+    /// ACK CPFP output index.
+    pub const CPFP_VOUT: u32 = 1;
+    /// Number of transaction inputs.
+    pub const N_INPUTS: usize = 1;
+
+    /// Constructs the exact ACK parent.
+    ///
+    /// The caller supplies the finalized fee and both exact output connectors.
+    /// Construction fails unless `R = L + a_ACK + fee_ACK`.
+    pub fn new(
+        data: CounterproofAckV2Data,
+        resolution_connector: CounterproofResolutionConnectorV2,
+        slash_authorization_connector: SlashAuthorizationConnectorV2,
+        cpfp_connector: KeyedAnchor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofAckV2Error> {
+        let network = resolution_connector.network();
+        for (name, candidate) in [
+            (
+                "slash authorization",
+                slash_authorization_connector.network(),
+            ),
+            ("ACK CPFP", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(CounterproofAckV2Error::NetworkMismatch { connector: name });
+            }
+        }
+
+        for (field, value) in [
+            ("resolution prevout", resolution_connector.value()),
+            (
+                "Slash authorization output",
+                slash_authorization_connector.value(),
+            ),
+            ("ACK CPFP output", cpfp_connector.value()),
+            ("ACK fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::CounterproofAck, fee)
+            .map_err(CounterproofAckV2Error::FeeAllowance)?;
+        let cpfp_minimum = cpfp_connector.script_pubkey().minimal_non_dust();
+        if cpfp_connector.value() < cpfp_minimum {
+            return Err(CounterproofAckV2Error::InvalidCpfpValue {
+                value: cpfp_connector.value(),
+                minimum: cpfp_minimum,
+            });
+        }
+        validate_ack_output_separation(
+            &slash_authorization_connector,
+            &cpfp_connector,
+            &resolution_connector,
+        )?;
+
+        let output_value = slash_authorization_connector
+            .value()
+            .checked_add(cpfp_connector.value())
+            .ok_or(CounterproofAckV2Error::AmountOverflow)?;
+        ensure_money_range("ACK total output", output_value)?;
+        let required_input = output_value
+            .checked_add(fee)
+            .ok_or(CounterproofAckV2Error::AmountOverflow)?;
+        ensure_money_range("ACK total input", required_input)?;
+        if resolution_connector.value() != required_input {
+            return Err(CounterproofAckV2Error::ValueNotConserved {
+                input: resolution_connector.value(),
+                output: output_value,
+                fee,
+            });
+        }
+
+        let prevouts = [resolution_connector.tx_out()];
+        let input = vec![TxIn {
+            previous_output: data.resolution_outpoint,
+            sequence: resolution_connector.sequence(CounterproofResolutionSpendPathV2::Ack),
+            ..Default::default()
+        }];
+        let output = vec![
+            slash_authorization_connector.tx_out(),
+            cpfp_connector.tx_out(),
+        ];
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(CounterproofAckV2Error::Psbt)?;
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+
+        Ok(Self {
+            psbt,
+            prevouts,
+            resolution_connector,
+            slash_authorization_connector,
+            cpfp_connector,
+        })
+    }
+
+    /// Ordered positive-lock commitments bound by the resolution connector.
+    pub fn ack_preimage_hashes(&self) -> &[[u8; 32]] {
+        self.resolution_connector.ack_preimage_hashes()
+    }
+
+    /// Validates the complete ordered release vector before witness creation.
+    pub fn accepts_ordered_preimages(&self, preimages: &[[u8; 32]]) -> bool {
+        self.resolution_connector
+            .accepts_ordered_preimages(preimages)
+    }
+
+    /// Finalizes the exact ACK with the complete ordered positive-lock vector.
+    pub fn finalize(
+        self,
+        ordered_preimages: Vec<[u8; 32]>,
+        graph_signatures: [schnorr::Signature; Self::N_INPUTS],
+    ) -> Result<Transaction, CounterproofAckV2Error> {
+        if !self
+            .resolution_connector
+            .accepts_ordered_preimages(&ordered_preimages)
+        {
+            return Err(CounterproofAckV2Error::InvalidOrderedPreimages {
+                expected: self.resolution_connector.ack_preimage_hashes().len(),
+                actual: ordered_preimages.len(),
+            });
+        }
+
+        let mut psbt = self.psbt;
+        self.resolution_connector.finalize_input(
+            &mut psbt.inputs[0],
+            &CounterproofResolutionWitnessV2::Ack {
+                graph_signature: graph_signatures[0],
+                ordered_preimages,
+            },
+        );
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+
+    /// Returns the ACK-created Slash authorization connector.
+    pub const fn slash_authorization_connector(&self) -> &SlashAuthorizationConnectorV2 {
+        &self.slash_authorization_connector
+    }
+}
+
+fn ensure_money_range(field: &'static str, value: Amount) -> Result<(), CounterproofAckV2Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofAckV2Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn validate_ack_output_separation(
+    slash_authorization_connector: &SlashAuthorizationConnectorV2,
+    cpfp_connector: &KeyedAnchor,
+    resolution_connector: &CounterproofResolutionConnectorV2,
+) -> Result<(), CounterproofAckV2Error> {
+    for nums in [
+        known_nums_keys("counterproof resolution R", resolution_connector),
+        known_nums_keys("Slash authorization L", slash_authorization_connector),
+    ]
+    .into_iter()
+    .flatten()
+    {
+        if cpfp_connector.internal_key() == nums.key {
+            return Err(CounterproofAckV2Error::CpfpNumsKeyAlias {
+                nums_component: nums.component,
+                key_kind: nums.kind,
+            });
+        }
+    }
+    if cpfp_connector.internal_key() == slash_authorization_connector.graph_pubkey() {
+        return Err(CounterproofAckV2Error::OutputControlKeyAlias);
+    }
+    validate_ack_output_scripts(
+        &slash_authorization_connector.script_pubkey(),
+        &cpfp_connector.script_pubkey(),
+    )
+}
+
+fn validate_ack_output_scripts(
+    slash_authorization_script: &Script,
+    cpfp_script: &Script,
+) -> Result<(), CounterproofAckV2Error> {
+    if slash_authorization_script == cpfp_script {
+        return Err(CounterproofAckV2Error::OutputScriptCollision);
+    }
+    Ok(())
+}
+
+impl ParentTx for CounterproofAckV2Tx {
+    type CpfpConnector = KeyedAnchor;
+
+    fn cpfp_tx_out(&self) -> TxOut {
+        self.cpfp_connector.tx_out()
+    }
+
+    fn cpfp_outpoint(&self) -> OutPoint {
+        OutPoint::new(self.psbt.unsigned_tx.compute_txid(), Self::CPFP_VOUT)
+    }
+
+    fn cpfp_connector(&self) -> &Self::CpfpConnector {
+        &self.cpfp_connector
+    }
+}
+
+impl PresignedTx<{ Self::N_INPUTS }> for CounterproofAckV2Tx {
+    fn signing_info(&self) -> [SigningInfo; Self::N_INPUTS] {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        [self.resolution_connector.get_signing_info(
+            &mut cache,
+            Prevouts::All(&self.prevouts),
+            CounterproofResolutionSpendPathV2::Ack,
+            0,
+        )]
+    }
+}
+
+impl AsRef<Transaction> for CounterproofAckV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize an exact ACK parent.
+#[derive(Debug)]
+pub enum CounterproofAckV2Error {
+    /// Connector networks do not match.
+    NetworkMismatch {
+        /// Connector whose network differs from the resolution connector.
+        connector: &'static str,
+    },
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A prevout, output, fee, or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Out-of-range value.
+        value: Amount,
+    },
+    /// The ACK CPFP output is zero or below its script-dependent dust floor.
+    InvalidCpfpValue {
+        /// Supplied CPFP value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// The ACK CPFP controller aliases an unspendable v2 NUMS key.
+    CpfpNumsKeyAlias {
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// The CPFP key aliases the graph key controlling Slash authorization.
+    OutputControlKeyAlias,
+    /// Slash authorization and CPFP resolve to the same exact script.
+    OutputScriptCollision,
+    /// The fee exceeds or is not bound by the exact ACK allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// The exact ACK value equation does not hold.
+    ValueNotConserved {
+        /// Resolution input value.
+        input: Amount,
+        /// Sum of Slash authorization and CPFP outputs.
+        output: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// The supplied positive-lock vector has the wrong length or contents.
+    InvalidOrderedPreimages {
+        /// Required number of preimages.
+        expected: usize,
+        /// Supplied number of preimages.
+        actual: usize,
+    },
+    /// The constructed unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofAckV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} connector network does not match resolution")
+            }
+            Self::AmountOverflow => f.write_str("ACK amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::InvalidCpfpValue { value, minimum } => write!(
+                f,
+                "ACK CPFP value {value} is below its dust floor {minimum}"
+            ),
+            Self::CpfpNumsKeyAlias {
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "ACK CPFP key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::OutputControlKeyAlias => {
+                f.write_str("ACK CPFP key aliases the Slash-authorization graph key")
+            }
+            Self::OutputScriptCollision => {
+                f.write_str("ACK CPFP output script collides with Slash authorization")
+            }
+            Self::FeeAllowance(error) => write!(f, "invalid ACK fee allowance: {error}"),
+            Self::ValueNotConserved { input, output, fee } => write!(
+                f,
+                "ACK value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::InvalidOrderedPreimages { expected, actual } => write!(
+                f,
+                "ACK positive-lock vector is invalid: expected {expected} entries, got {actual}"
+            ),
+            Self::Psbt(error) => write!(f, "failed to construct ACK PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofAckV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use bitcoin::{
+        hashes::{sha256, Hash},
+        Network,
+    };
+    use secp256k1::{rand::thread_rng, Keypair, SECP256K1};
+    use strata_bridge_connectors::prelude::{ResearchV0NumsContext, ResearchV0NumsRole};
+
+    use super::*;
+
+    fn signature() -> schnorr::Signature {
+        schnorr::Signature::from_slice(&[0xAA; 64]).expect("fixed-size Schnorr signature")
+    }
+
+    fn fee_allowance(fee: Amount) -> TemplateFeeAllowanceV2 {
+        TemplateFeeAllowanceV2::new(TemplateKindV2::CounterproofAck, fee).unwrap()
+    }
+
+    #[test]
+    fn exact_ack_layout_and_conservation() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let anchor_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let preimages = [[1u8; 32], [2u8; 32]];
+        let hashes = preimages
+            .iter()
+            .map(|preimage| sha256::Hash::hash(preimage).to_byte_array())
+            .collect();
+        let authorization = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new([3u8; 32], ResearchV0NumsRole::SlashAuthorization, 0),
+        )
+        .unwrap();
+        let anchor = KeyedAnchor::new(
+            Network::Regtest,
+            anchor_keypair.x_only_public_key().0,
+            Amount::from_sat(330),
+        );
+        let fee = Amount::from_sat(500);
+        let resolution = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            hashes,
+            bitcoin::relative::Height::from_height(12),
+            Amount::from_sat(1_830),
+            ResearchV0NumsContext::new([3u8; 32], ResearchV0NumsRole::CounterproofResolution, 0),
+        )
+        .unwrap();
+
+        let ack = CounterproofAckV2Tx::new(
+            CounterproofAckV2Data {
+                resolution_outpoint: OutPoint::null(),
+            },
+            resolution,
+            authorization,
+            anchor,
+            fee,
+            fee_allowance(fee),
+        )
+        .unwrap();
+        assert_eq!(ack.as_ref().input.len(), 1);
+        assert_eq!(ack.as_ref().output.len(), 2);
+        assert_eq!(ack.as_ref().output[0].value, Amount::from_sat(1_000));
+        assert_eq!(ack.as_ref().output[1].value, Amount::from_sat(330));
+        assert_eq!(ack.signing_info().len(), 1);
+
+        let invalid = ack
+            .clone()
+            .finalize(vec![[9u8; 32], [2u8; 32]], [signature()]);
+        assert!(matches!(
+            invalid,
+            Err(CounterproofAckV2Error::InvalidOrderedPreimages { .. })
+        ));
+
+        let signed = ack.finalize(preimages.to_vec(), [signature()]).unwrap();
+        assert_eq!(
+            signed
+                .output
+                .iter()
+                .map(|output| output.value)
+                .sum::<Amount>()
+                + fee,
+            Amount::from_sat(1_830)
+        );
+        assert!(!signed.input[0].witness.is_empty());
+    }
+
+    #[test]
+    fn rejects_nonconserving_value() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let anchor_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let preimages = [[1u8; 32], [2u8; 32]];
+        let hashes = preimages
+            .iter()
+            .map(|preimage| sha256::Hash::hash(preimage).to_byte_array())
+            .collect();
+        let resolution = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            hashes,
+            bitcoin::relative::Height::from_height(12),
+            Amount::from_sat(1_831),
+            ResearchV0NumsContext::new([4u8; 32], ResearchV0NumsRole::CounterproofResolution, 0),
+        )
+        .unwrap();
+        let authorization = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new([4u8; 32], ResearchV0NumsRole::SlashAuthorization, 0),
+        )
+        .unwrap();
+        let anchor = KeyedAnchor::new(
+            Network::Regtest,
+            anchor_keypair.x_only_public_key().0,
+            Amount::from_sat(330),
+        );
+        let result = CounterproofAckV2Tx::new(
+            CounterproofAckV2Data {
+                resolution_outpoint: OutPoint::null(),
+            },
+            resolution,
+            authorization,
+            anchor,
+            Amount::from_sat(500),
+            fee_allowance(Amount::from_sat(500)),
+        );
