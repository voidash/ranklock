+    fn consensus_maximum_complete_v2_witness_is_accepted_by_core() {
+        let mut node = BitcoinNode::new();
+        let graph_keypair = generate_keypair();
+        let operator_keypair = generate_keypair();
+        let connector = connector(
+            &graph_keypair,
+            &operator_keypair,
+            MAX_CONTEST_COUNTERPROOF_V2_DATA,
+        );
+
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+
+        let spending_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([
+                node.next_coinbase_outpoint(),
+                OutPoint {
+                    txid: funding_txid,
+                    vout: 0,
+                },
+            ]),
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+
+        let utxos = [node.coinbase_tx_out(), connector.tx_out()];
+        let mut cache = SighashCache::new(&spending_tx);
+        let sighashes: Vec<_> = connector
+            .get_sighashes_with_code_separator(
+                &mut cache,
+                Prevouts::All(&utxos),
+                ContestCounterproofSpendV2::Counterproof,
+                1,
+            )
+            .into_iter()
+            .collect();
+        assert_eq!(sighashes.len(), MAX_CONTEST_COUNTERPROOF_V2_DATA);
+        // The graph CHECKSIGVERIFY and first operator CHECKSIG share the
+        // default code-separator position. Every later operator check follows
+        // one explicit OP_CODESEPARATOR.
+        let graph_signature = graph_keypair.sign_schnorr(sighashes[0]);
+        let operator_signatures = sighashes
+            .into_iter()
+            .map(|sighash| operator_keypair.sign_schnorr(sighash))
+            .collect();
+        let witness = connector
+            .counterproof_witness(graph_signature, operator_signatures)
+            .unwrap();
+
+        let mut psbt = Psbt::from_unsigned_tx(spending_tx.clone()).unwrap();
+        psbt.inputs[0].witness_utxo = Some(node.coinbase_tx_out());
+        psbt.inputs[1].witness_utxo = Some(connector.tx_out());
+        connector
+            .try_finalize_input(
+                &mut psbt.inputs[1],
+                ContestCounterproofSpendV2::Counterproof,
+                &witness,
+            )
+            .unwrap();
+
+        let valid = node.sign(&psbt.extract_tx().unwrap());
+
+        let mut missing = valid.clone();
+        let mut missing_items = missing.input[1].witness.to_vec();
+        missing_items.remove(0);
+        missing.input[1].witness = Witness::from_slice(&missing_items);
+        assert!(node.client().send_raw_transaction(&missing).is_err());
+
+        let mut reordered = valid.clone();
+        let mut reordered_items = reordered.input[1].witness.to_vec();
+        reordered_items.swap(0, 1);
+        reordered.input[1].witness = Witness::from_slice(&reordered_items);
+        assert!(node.client().send_raw_transaction(&reordered).is_err());
+
+        let mut malformed = valid.clone();
+        let mut malformed_items = malformed.input[1].witness.to_vec();
+        malformed_items[0].pop();
+        malformed.input[1].witness = Witness::from_slice(&malformed_items);
+        assert!(node.client().send_raw_transaction(&malformed).is_err());
+
+        let mut key_spend_cache = SighashCache::new(&spending_tx);
+        let key_spend_message = create_key_spend_hash(
+            &mut key_spend_cache,
+            Prevouts::All(&utxos),
+            TapSighashType::Default,
+            1,
+        )
+        .unwrap();
+        for unauthorized_keypair in [&graph_keypair, &operator_keypair] {
+            let signature = unauthorized_keypair.sign_schnorr(key_spend_message);
+            let mut key_path_attempt = node.sign(&spending_tx);
+            key_path_attempt.input[1].witness = Witness::from_slice(&[signature.serialize()]);
+            assert!(node
+                .client()
+                .send_raw_transaction(&key_path_attempt)
+                .is_err());
+        }
+
+        assert!(node.client().send_raw_transaction(&valid).is_ok());
+    }
