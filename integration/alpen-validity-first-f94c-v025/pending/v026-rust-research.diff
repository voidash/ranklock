+
+    fn finalize_script_spend(
+        node: &BitcoinNode,
+        tx: Transaction,
+        prevouts: &[TxOut; 2],
+        connector: &ContestPayoutGateV2,
+        keypair: &Keypair,
+        path: ContestPayoutGateSpendPathV2,
+    ) -> Transaction {
+        let mut cache = SighashCache::new(&tx);
+        let signature = connector
+            .get_signing_info(&mut cache, Prevouts::All(prevouts), path, 0)
+            .sign(keypair);
+        let witness = match path {
+            ContestPayoutGateSpendPathV2::ImmediateSelection => {
+                ContestPayoutGateWitnessV2::ImmediateSelection {
+                    graph_signature: signature,
+                }
+            }
+            ContestPayoutGateSpendPathV2::OwnerPayout => ContestPayoutGateWitnessV2::OwnerPayout {
+                graph_signature: signature,
+            },
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+        connector.finalize_input(&mut psbt.inputs[0], &witness);
+        node.sign(&psbt.extract_tx().unwrap())
+    }
