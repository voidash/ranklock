@@ -0,0 +1,386 @@
+//! Draft v0.26 ACK-created authorization for the exact Slash parent.
+//!
+//! This connector has one script leaf and a caller-bound research NUMS key. The
+//! CHECKSIG leaf is not a covenant: safety additionally requires complete
+//! exact-parent presigning and verified destruction of the graph signing key.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{opcodes, script, Amount, Network, ScriptBuf};
+use secp256k1::{schnorr, XOnlyPublicKey};
+
+use crate::{
+    ranklock_nums::{NumsDerivationError, ResearchV0NumsContext, ResearchV0NumsRole},
+    Connector, TaprootWitness,
+};
+
+/// Script-only output created by `ACKV2` and consumed only by its Slash parent.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct SlashAuthorizationConnectorV2 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl SlashAuthorizationConnectorV2 {
+    /// Constructs a research-profile slash authorization connector.
+    ///
+    /// The connector rejects the resolution role and dust-valued outputs.  It
+    /// remains funding-ineligible while `ResearchV0NumsRole` is non-authoritative.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        value: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, SlashAuthorizationError> {
+        if value > Amount::MAX_MONEY {
+            return Err(SlashAuthorizationError::ValueAboveMaxMoney { value });
+        }
+        if nums_context.role() != ResearchV0NumsRole::SlashAuthorization {
+            return Err(SlashAuthorizationError::WrongNumsRole);
+        }
+        let internal_key = nums_context
+            .derive_internal_key()
+            .map_err(SlashAuthorizationError::NumsDerivation)?;
+        let connector = Self {
+            network,
+            graph_pubkey,
+            value,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if graph_pubkey == internal_key || graph_pubkey == output_key {
+            return Err(SlashAuthorizationError::GraphNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if value < minimum {
+            return Err(SlashAuthorizationError::DustValue { value, minimum });
+        }
+        Ok(connector)
+    }
+
+    /// Returns the graph key controlling the exact Slash authorization path.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    fn slash_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
+
+impl Connector for SlashAuthorizationConnectorV2 {
+    type SpendPath = SlashAuthorizationSpendPathV2;
+    type Witness = SlashAuthorizationWitnessV2;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.slash_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, _spend_path: Self::SpendPath) -> Option<usize> {
+        Some(0)
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        TaprootWitness::Script {
+            leaf_index: 0,
+            script_inputs: vec![witness.graph_signature.serialize().to_vec()],
+        }
+    }
+}
+
+/// The single declared script path of [`SlashAuthorizationConnectorV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct SlashAuthorizationSpendPathV2;
+
+/// Witness for the exact presigned Slash parent.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct SlashAuthorizationWitnessV2 {
+    /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+    pub graph_signature: schnorr::Signature,
+}
+
+/// Invalid slash-authorization connector policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SlashAuthorizationError {
+    /// A different output role was supplied to the NUMS derivation.
+    WrongNumsRole,
+    /// The connector value exceeds Bitcoin's consensus money range.
+    ValueAboveMaxMoney {
+        /// Value supplied by the caller.
+        value: Amount,
+    },
+    /// The NUMS point could not be reconstructed.
+    NumsDerivation(NumsDerivationError),
+    /// Graph authorization aliases the connector's unspendable NUMS key domain.
+    GraphNumsKeyAlias,
+    /// The value is below the connector's actual script-dependent dust floor.
+    DustValue {
+        /// Value supplied by the caller.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for SlashAuthorizationError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::WrongNumsRole => {
+                f.write_str("slash authorization was given the wrong draft NUMS role")
+            }
+            Self::ValueAboveMaxMoney { value } => {
+                write!(f, "slash authorization value {value} exceeds MAX_MONEY")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::GraphNumsKeyAlias => {
+                f.write_str("slash-authorization graph key aliases its NUMS internal/output key")
+            }
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "slash authorization value {value} is below its dust floor {minimum}"
+            ),
+        }
+    }
+}
+
+impl Error for SlashAuthorizationError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::NumsDerivation(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use bitcoin::{
+        absolute,
+        sighash::{Prevouts, SighashCache},
+        transaction, OutPoint, Sequence, TapSighashType, Transaction, TxOut, Witness,
+    };
+    use secp256k1::{rand::thread_rng, Keypair, SECP256K1};
+    use strata_bridge_primitives::scripts::prelude::{create_key_spend_hash, create_tx_ins};
+    use strata_bridge_test_utils::prelude::generate_keypair;
+
+    use super::*;
+    use crate::{
+        test_utils::{BitcoinNode, Signer},
+        SigningInfo,
+    };
+
+    const SETUP_INTENT_DIGEST: [u8; 32] = [0x35; 32];
+    const TEST_FEE: Amount = Amount::from_sat(1_000);
+
+    struct SlashAuthorizationSigner {
+        graph_keypair: Keypair,
+    }
+
+    impl Signer for SlashAuthorizationSigner {
+        type Connector = SlashAuthorizationConnectorV2;
+
+        fn generate() -> Self {
+            Self {
+                graph_keypair: generate_keypair(),
+            }
+        }
+
+        fn get_connector(&self) -> Self::Connector {
+            SlashAuthorizationConnectorV2::new(
+                Network::Regtest,
+                self.graph_keypair.x_only_public_key().0,
+                Amount::from_sat(1_000),
+                ResearchV0NumsContext::new(
+                    SETUP_INTENT_DIGEST,
+                    ResearchV0NumsRole::SlashAuthorization,
+                    3,
+                ),
+            )
+            .unwrap()
+        }
+
+        fn get_connector_name(&self) -> &'static str {
+            "slash-authorization-v2"
+        }
+
+        fn sign_leaf(
+            &self,
+            _spend_path: SlashAuthorizationSpendPathV2,
+            signing_info: SigningInfo,
+        ) -> SlashAuthorizationWitnessV2 {
+            SlashAuthorizationWitnessV2 {
+                graph_signature: signing_info.sign(&self.graph_keypair),
+            }
+        }
+    }
+
+    #[test]
+    fn slash_path_is_accepted_by_core() {
+        SlashAuthorizationSigner::assert_connector_is_spendable(SlashAuthorizationSpendPathV2);
+    }
+
+    #[test]
+    fn has_one_script_path_and_no_declared_key_path() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let connector = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::SlashAuthorization,
+                3,
+            ),
+        )
+        .unwrap();
+
+        assert_eq!(connector.leaf_scripts().len(), 1);
+        assert_eq!(
+            connector.to_leaf_index(SlashAuthorizationSpendPathV2),
+            Some(0)
+        );
+        assert_eq!(
+            connector.sequence(SlashAuthorizationSpendPathV2),
+            Sequence::MAX
+        );
+        assert_ne!(connector.internal_key(), graph_pubkey);
+    }
+
+    #[test]
+    fn rejects_graph_key_aliasing_its_nums_domain() {
+        let nums_context = ResearchV0NumsContext::new(
+            SETUP_INTENT_DIGEST,
+            ResearchV0NumsRole::SlashAuthorization,
+            33,
+        );
+        let nums_key = nums_context.derive_internal_key().unwrap();
+        assert!(matches!(
+            SlashAuthorizationConnectorV2::new(
+                Network::Regtest,
+                nums_key,
+                Amount::from_sat(1_000),
+                nums_context,
+            ),
+            Err(SlashAuthorizationError::GraphNumsKeyAlias)
+        ));
+    }
+
+    #[test]
+    fn graph_key_path_bypass_is_rejected_by_core() {
+        let mut node = BitcoinNode::new();
+        let signer = SlashAuthorizationSigner::generate();
+        let connector = signer.get_connector();
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - TEST_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+
+        let spending_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([
+                OutPoint::new(funding_txid, 0),
+                node.next_coinbase_outpoint(),
+            ]),
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - TEST_FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let prevouts = [connector.tx_out(), node.coinbase_tx_out()];
+        let mut cache = SighashCache::new(&spending_tx);
+        let key_spend_message = create_key_spend_hash(
+            &mut cache,
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .unwrap();
+        let graph_key_signature = signer.graph_keypair.sign_schnorr(key_spend_message);
+        let mut key_path_attempt = node.sign(&spending_tx);
+        key_path_attempt.input[0].witness = Witness::from_slice(&[graph_key_signature.serialize()]);
+
+        assert!(node
+            .client()
+            .send_raw_transaction(&key_path_attempt)
+            .is_err());
+    }
+
+    #[test]
+    fn rejects_wrong_role_and_dust() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let wrong_role = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::CounterproofResolution,
+                3,
+            ),
+        );
+        assert!(matches!(
+            wrong_role,
+            Err(SlashAuthorizationError::WrongNumsRole)
+        ));
+
+        let dust = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::ZERO,
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::SlashAuthorization,
+                3,
+            ),
+        );
+        assert!(matches!(
+            dust,
+            Err(SlashAuthorizationError::DustValue { .. })
+        ));
+
+        let above_max = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(Amount::MAX_MONEY.to_sat() + 1),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::SlashAuthorization,
+                3,
+            ),
+        );
+        assert!(matches!(
+            above_max,
+            Err(SlashAuthorizationError::ValueAboveMaxMoney { .. })
+        ));
+    }
+}
