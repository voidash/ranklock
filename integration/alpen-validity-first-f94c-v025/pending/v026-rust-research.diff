+    #[test]
+    fn assembles_only_parent_derived_edges_and_stays_nonfundable() {
+        let plan = plan();
+        let reserve_returns = plan
+            .alternatives
+            .iter()
+            .map(|alternative| TxOut {
+                value: alternative.counterproof_output.value(),
+                script_pubkey: alternative.counterproof_reserve_descriptor.to_script(),
+            })
+            .collect::<Vec<_>>();
+        let graph = V026Graph::assemble(plan).expect("valid structural graph");
+        graph
+            .verify_structure()
+            .expect("derived edges must reverify");
+        assert_eq!(graph.alternatives().len(), ALTERNATIVES);
+        assert_eq!(graph.spend_matrix().len(), 6 + 3 * ALTERNATIVES);
+        assert_eq!(
+            graph.spend_matrix()[0],
+            V026SpendMatrixEntry {
+                output: V026OutputRole::ClaimContest,
+                spenders: vec![V026SpenderRole::Contest],
+            }
+        );
+        assert!(!graph.funding_eligible());
+        assert_eq!(graph.activation_blockers(), &ACTIVATION_BLOCKERS);
+        assert!(graph
+            .activation_blockers()
+            .contains(&V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified));
+
+        let contest_txid = graph.contest().as_ref().compute_txid();
+        let shared_p = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+        let shared_s = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+        let counterproof_outpoints = (0..ALTERNATIVES)
+            .map(|index| {
+                OutPoint::new(
+                    contest_txid,
+                    graph
+                        .contest()
+                        .counterproof_vout(index)
+                        .expect("valid index"),
+                )
+            })
+            .collect::<Vec<_>>();
+        let owner = graph.owner_payout().as_ref();
+        assert_eq!(owner.input.len(), ALTERNATIVES + 4);
+        assert_eq!(owner.output.len(), ALTERNATIVES + 1);
+        for (index, expected) in counterproof_outpoints.iter().enumerate() {
+            assert_eq!(owner.input[index + 4].previous_output, *expected);
+            assert_eq!(owner.output[index + 1], reserve_returns[index]);
+            assert_eq!(
+                graph.spend_matrix()[6 + 3 * index],
+                V026SpendMatrixEntry {
+                    output: V026OutputRole::CounterproofFunding(index),
+                    spenders: vec![
+                        V026SpenderRole::OwnerPayout,
+                        V026SpenderRole::Counterproof(0),
+                        V026SpenderRole::Counterproof(1),
+                    ],
+                }
+            );
+        }
+        for (index, alternative) in graph.alternatives().iter().enumerate() {
+            let cp = alternative.counterproof().as_ref();
+            assert_eq!(cp.input.len(), ALTERNATIVES + 2);
+            assert_eq!(cp.output.len(), ALTERNATIVES + 2);
+            for (reserve_index, expected) in counterproof_outpoints.iter().enumerate() {
+                assert_eq!(cp.input[reserve_index].previous_output, *expected);
+            }
+            assert_eq!(cp.input[ALTERNATIVES].previous_output, shared_p);
+            assert_eq!(
+                cp.input[ALTERNATIVES + 1].previous_output,
+                graph.deposit_outpoint
+            );
+            let r = OutPoint::new(cp.compute_txid(), CounterproofV2Tx::RESOLUTION_VOUT);
+            assert_eq!(alternative.ack().as_ref().input[0].previous_output, r);
+            assert_eq!(alternative.timeout().as_ref().input[0].previous_output, r);
+            assert_eq!(
+                alternative.timeout().as_ref().input[1].previous_output,
+                shared_s
+            );
+            let l = OutPoint::new(
+                alternative.ack().as_ref().compute_txid(),
+                CounterproofAckV2Tx::SLASH_AUTHORIZATION_VOUT,
+            );
+            assert_eq!(alternative.slash().as_ref().input[0].previous_output, l);
+            assert_eq!(
+                alternative.slash().as_ref().input[1].previous_output,
+                shared_s
+            );
+            assert_eq!(
+                alternative.slash().as_ref().input[2].previous_output,
+                graph.stake_outpoint
+            );
+            for (reserve_index, expected) in reserve_returns.iter().enumerate() {
+                if reserve_index == index {
+                    assert!(alternative
+                        .counterproof()
+                        .reserve_return_vout(reserve_index)
+                        .is_err());
+                } else {
+                    let vout = alternative
+                        .counterproof()
+                        .reserve_return_vout(reserve_index)
+                        .expect("unselected reserve has an exact return");
+                    assert_eq!(cp.output[vout as usize], *expected);
+                }
+            }
+        }
+    }
