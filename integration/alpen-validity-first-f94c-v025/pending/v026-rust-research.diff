+        let (authorization, slash, stake) = connectors(
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(5_000),
+        );
+        let nums_keys: Vec<_> = [
+            known_nums_keys("L", &authorization),
+            known_nums_keys("S", &slash),
+        ]
+        .into_iter()
+        .flatten()
+        .collect();
+        let outpoints = input_outpoints();
+        let data = SlashV2Data {
+            slash_authorization_outpoint: outpoints[0],
+            contest_slash_outpoint: outpoints[1],
+            stake_outpoint: outpoints[2],
+            operator_idx: 7,
+            magic_bytes: (*b"ALPN").into(),
+        };
+        for nums in nums_keys {
+            let descriptor = Descriptor::new_p2tr(&nums.key.serialize()).unwrap();
+            let payout = SlashPayoutV2::new(descriptor, Amount::from_sat(6_500)).unwrap();
+            let result = SlashV2Tx::new(
+                data,
+                authorization,
+                slash,
+                stake,
+                vec![payout],
+                fee,
+                fee_allowance(fee),
+            );
+            assert!(matches!(
+                result,
+                Err(SlashV2Error::PayoutNumsKeyAlias { index: 0, .. })
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_high_but_conserving_fee() {
+        let fee = Amount::from_sat(500);
+        let (authorization, slash, stake) = connectors(
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(5_000),
+        );
+        let beneficiary = Keypair::new(SECP256K1, &mut thread_rng());
+        let outpoints = input_outpoints();
+        let result = SlashV2Tx::new(
+            SlashV2Data {
+                slash_authorization_outpoint: outpoints[0],
+                contest_slash_outpoint: outpoints[1],
+                stake_outpoint: outpoints[2],
+                operator_idx: 7,
+                magic_bytes: (*b"ALPN").into(),
+            },
+            authorization,
+            slash,
+            stake,
+            vec![payout(
+                beneficiary.x_only_public_key().0,
+                Amount::from_sat(6_500),
+            )],
+            fee,
+            TemplateFeeAllowanceV2::new(TemplateKindV2::Slash, Amount::from_sat(499)).unwrap(),
+        );
+        assert!(matches!(
+            result,
+            Err(SlashV2Error::FeeAllowance(
+                TemplateFeeAllowanceV2Error::FeeAboveAllowance { .. }
+            ))
+        ));
+    }
+}
diff --git a/crates/tx-graph/src/transactions/template_fee_v2.rs b/crates/tx-graph/src/transactions/template_fee_v2.rs
new file mode 100644
index 00000000..e887a979
--- /dev/null
+++ b/crates/tx-graph/src/transactions/template_fee_v2.rs
@@ -0,0 +1,159 @@
+//! Research-only fee ceilings for v0.26 transaction templates.
+//!
+//! A ceiling prevents a caller from constructing a value-conserving template
+//! that silently donates an unbounded amount to miners. It is not a reviewed
+//! fee policy. Activation must bind each allowance in the setup commitment and
+//! independently verify the finalized transaction's measured vsize and fee
+//! rate against the authoritative wire profile.
+
+use std::{error::Error, fmt};
+
+use bitcoin::Amount;
+
+/// Exact v0.26 transaction template to which a fee allowance is bound.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum TemplateKindV2 {
+    /// Fresh contest output roster.
+    Contest,
+    /// Selected counterproof parent.
+    Counterproof,
+    /// Positive-lock ACK parent.
+    CounterproofAck,
+    /// Neutral timeout settlement parent.
+    CounterproofTimeoutSettlement,
+    /// No-counterproof owner payout parent.
+    OwnerPayout,
+    /// ACK-gated Slash parent.
+    Slash,
+}
+
+/// Caller-supplied maximum miner fee for one exact v0.26 template kind.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct TemplateFeeAllowanceV2 {
+    template_kind: TemplateKindV2,
+    maximum_fee: Amount,
+}
+
+impl TemplateFeeAllowanceV2 {
+    /// Constructs a research allowance within Bitcoin's monetary range.
+    pub fn new(
+        template_kind: TemplateKindV2,
+        maximum_fee: Amount,
+    ) -> Result<Self, TemplateFeeAllowanceV2Error> {
+        if maximum_fee > Amount::MAX_MONEY {
+            return Err(TemplateFeeAllowanceV2Error::MaximumFeeAboveMaxMoney { maximum_fee });
+        }
+        Ok(Self {
+            template_kind,
+            maximum_fee,
+        })
+    }
+
+    /// Returns the exact template kind committed by this allowance.
+    pub const fn template_kind(&self) -> TemplateKindV2 {
+        self.template_kind
+    }
+
+    /// Returns the caller-pinned maximum miner fee.
+    pub const fn maximum_fee(&self) -> Amount {
+        self.maximum_fee
+    }
+
+    /// Rejects reuse for a different template or a fee above the ceiling.
+    pub fn validate(
+        &self,
+        expected_kind: TemplateKindV2,
+        fee: Amount,
+    ) -> Result<(), TemplateFeeAllowanceV2Error> {
+        if self.template_kind != expected_kind {
+            return Err(TemplateFeeAllowanceV2Error::TemplateKindMismatch {
+                expected: expected_kind,
+                actual: self.template_kind,
+            });
+        }
+        if fee > self.maximum_fee {
+            return Err(TemplateFeeAllowanceV2Error::FeeAboveAllowance {
+                fee,
+                maximum_fee: self.maximum_fee,
+            });
+        }
+        Ok(())
+    }
+}
+
+/// Invalid research fee allowance or attempted use.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum TemplateFeeAllowanceV2Error {
+    /// The ceiling itself exceeds Bitcoin's monetary range.
+    MaximumFeeAboveMaxMoney {
+        /// Rejected ceiling.
+        maximum_fee: Amount,
+    },
+    /// An allowance was presented to a different template kind.
+    TemplateKindMismatch {
+        /// Template being constructed.
+        expected: TemplateKindV2,
+        /// Template committed by the allowance.
+        actual: TemplateKindV2,
+    },
+    /// The exact miner fee exceeds the caller-pinned ceiling.
+    FeeAboveAllowance {
+        /// Exact template fee.
+        fee: Amount,
+        /// Caller-pinned ceiling.
+        maximum_fee: Amount,
+    },
+}
+
+impl fmt::Display for TemplateFeeAllowanceV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::MaximumFeeAboveMaxMoney { maximum_fee } => {
+                write!(f, "v0.26 maximum fee {maximum_fee} exceeds MAX_MONEY")
+            }
+            Self::TemplateKindMismatch { expected, actual } => write!(
+                f,
+                "v0.26 fee allowance is bound to {actual:?}, not {expected:?}"
+            ),
+            Self::FeeAboveAllowance { fee, maximum_fee } => write!(
+                f,
+                "v0.26 template fee {fee} exceeds its allowance {maximum_fee}"
+            ),
+        }
+    }
+}
+
+impl Error for TemplateFeeAllowanceV2Error {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn allowance_is_template_bound_and_capped() {
+        let allowance =
+            TemplateFeeAllowanceV2::new(TemplateKindV2::Counterproof, Amount::from_sat(500))
+                .unwrap();
+        assert_eq!(allowance.maximum_fee(), Amount::from_sat(500));
+        assert!(allowance
+            .validate(TemplateKindV2::Counterproof, Amount::from_sat(500))
+            .is_ok());
+        assert!(matches!(
+            allowance.validate(TemplateKindV2::Counterproof, Amount::from_sat(501)),
+            Err(TemplateFeeAllowanceV2Error::FeeAboveAllowance { .. })
+        ));
+        assert!(matches!(
+            allowance.validate(TemplateKindV2::Slash, Amount::ZERO),
+            Err(TemplateFeeAllowanceV2Error::TemplateKindMismatch { .. })
+        ));
+    }
+
+    #[test]
+    fn rejects_out_of_range_ceiling() {
+        let excessive = Amount::MAX_MONEY.checked_add(Amount::from_sat(1)).unwrap();
+        assert!(matches!(
+            TemplateFeeAllowanceV2::new(TemplateKindV2::Contest, excessive),
+            Err(TemplateFeeAllowanceV2Error::MaximumFeeAboveMaxMoney { .. })
+        ));
+    }
+}
diff --git a/crates/tx-graph/src/v026_graph.rs b/crates/tx-graph/src/v026_graph.rs
new file mode 100644
index 00000000..21378b65
--- /dev/null
+++ b/crates/tx-graph/src/v026_graph.rs
@@ -0,0 +1,3221 @@
+//! Canonical structural assembly for the research-only v0.26 graph.
+//!
+//! This module removes caller authority over the internal `C/P/S/R/L` edges:
+//! every such outpoint is derived from the actual unsigned parent transaction.
+//! External `Claim`, deposit (`D`), claim-payout (`Q`), and stake (`K`)
+//! outpoints remain explicit bindings and require separate activation evidence.
+//! Structural validity is deliberately not represented as funds safety.
+
+use std::{collections::HashSet, error::Error, fmt};
+
+use bitcoin::{
+    absolute, transaction::Version, Amount, OutPoint, Sequence, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::Descriptor;
+use secp256k1::XOnlyPublicKey;
+use strata_asm_proto_bridge_v1_txs::slash::SlashTxHeaderAux;
+use strata_bridge_connectors::{
+    prelude::{
+        ClaimContestConnector, ClaimContestSpendPath, ClaimPayoutConnector, ClaimPayoutSpendPath,
+        ContestCounterproofOutputV2, ContestCounterproofSpendV2, ContestPayoutGateSpendPathV2,
+        ContestPayoutGateV2, ContestProofConnector, ContestSlashGateSpendPathV2,
+        ContestSlashGateV2, CounterproofResolutionConnectorV2, CounterproofResolutionSpendPathV2,
+        KeyedAnchor, MultiAnchor, NOfNConnector, NOfNSpend, SlashAuthorizationConnectorV2,
+        SlashAuthorizationSpendPathV2,
+    },
+    Connector,
+};
+use strata_l1_txfmt::{MagicBytes, ParseConfig};
+
+use crate::transactions::{
+    counterproof_v2::CounterproofReserveBindingV2,
+    nums_safety_v2::known_nums_keys,
+    prelude::{
+        ClaimTx, ContestAlternativeV2, ContestV2Data, ContestV2Error, ContestV2OutputPlan,
+        ContestV2Tx, CounterproofAckV2Data, CounterproofAckV2Error, CounterproofAckV2Tx,
+        CounterproofTimeoutSettlementV2Data, CounterproofTimeoutSettlementV2Error,
+        CounterproofTimeoutSettlementV2Tx, CounterproofV2Data, CounterproofV2Error,
+        CounterproofV2Tx, OwnerPayoutV2Data, OwnerPayoutV2Error, OwnerPayoutV2Tx,
+        SharedSelectionOutpointsV2, SlashPayoutV2, SlashV2Data, SlashV2Error, SlashV2Tx,
+        TemplateFeeAllowanceV2,
+    },
+};
+
+/// An externally created output whose existence and provenance are not proven here.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026ExternalOutput<C> {
+    /// Exact externally supplied outpoint.
+    pub outpoint: OutPoint,
+    /// Connector whose value and script must match external evidence at activation.
+    pub connector: C,
+}
+
+/// Per-alternative inputs that do not name any internal graph outpoint.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026AlternativePlan {
+    /// Fresh `C_i` output paired inseparably with all descendants for this alternative.
+    pub counterproof_output: ContestCounterproofOutputV2,
+    /// Setup-bound principal that receives this exact `C_i` value when unselected.
+    pub counterproof_reserve_descriptor: Descriptor,
+    /// Contest CPFP controller paired with the same alternative.
+    pub contest_cpfp_pubkey: XOnlyPublicKey,
+    /// Exact `R_i` connector committed by `CounterproofV2_i`.
+    pub resolution_connector: CounterproofResolutionConnectorV2,
+    /// Exact `L_i` connector committed by `ACKV2_i`.
+    pub slash_authorization_connector: SlashAuthorizationConnectorV2,
+    /// Independently controlled CP counterproof anchor.
+    pub counterproof_cpfp_connector: KeyedAnchor,
+    /// Independently controlled ACK anchor.
+    pub ack_cpfp_connector: KeyedAnchor,
+    /// Independently controlled timeout anchor.
+    pub timeout_cpfp_connector: KeyedAnchor,
+    /// Exact ordered Slash beneficiary outputs.
+    pub slash_payouts: Vec<SlashPayoutV2>,
+    /// Exact counterproof fee.
+    pub counterproof_fee: Amount,
+    /// Counterproof fee ceiling.
+    pub counterproof_fee_allowance: TemplateFeeAllowanceV2,
+    /// Exact ACK fee.
+    pub ack_fee: Amount,
+    /// ACK fee ceiling.
+    pub ack_fee_allowance: TemplateFeeAllowanceV2,
+    /// Exact timeout fee.
+    pub timeout_fee: Amount,
+    /// Timeout fee ceiling.
+    pub timeout_fee_allowance: TemplateFeeAllowanceV2,
+    /// Exact Slash fee.
+    pub slash_fee: Amount,
+    /// Slash fee ceiling.
+    pub slash_fee_allowance: TemplateFeeAllowanceV2,
+}
+
+/// Shared Contest outputs and fee policy. Alternative-specific fields live in
+/// [`V026AlternativePlan`] so callers cannot permute parallel rosters.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026ContestPlan {
+    /// Existing proof output category retained by the v2 Contest.
+    pub proof_connector: ContestProofConnector,
+    /// Fresh script-only shared payout/selection gate `P`.
+    pub payout_gate: ContestPayoutGateV2,
+    /// Fresh script-only shared timeout/Slash gate `S`.
+    pub slash_gate: ContestSlashGateV2,
+    /// Exact nonzero Contest CPFP anchor value.
+    pub cpfp_anchor_value: Amount,
+    /// Exact Contest miner fee.
+    pub fee: Amount,
+    /// Contest fee ceiling.
+    pub fee_allowance: TemplateFeeAllowanceV2,
+}
+
+/// Complete structural plan. It cannot supply internal graph outpoints or child transactions.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026GraphPlan {
+    /// Existing Claim contest output. Its vout must be the canonical Claim vout.
+    pub claim: V026ExternalOutput<ClaimContestConnector>,
+    /// Existing deposit output `D`.
+    pub deposit: V026ExternalOutput<NOfNConnector>,
+    /// Existing claim-payout output `Q`.
+    pub claim_payout: V026ExternalOutput<ClaimPayoutConnector>,
+    /// Existing stake output `K`.
+    pub stake: V026ExternalOutput<NOfNConnector>,
+    /// Exact Contest output/fee plan.
+    pub contest: V026ContestPlan,
+    /// Setup-committed recovery descriptor.
+    pub recovery_descriptor: Descriptor,
+    /// Setup-committed owner descriptor.
+    pub owner_descriptor: Descriptor,
+    /// Exact no-counterproof owner fee.
+    pub owner_fee: Amount,
+    /// Owner fee ceiling.
+    pub owner_fee_allowance: TemplateFeeAllowanceV2,
+    /// Operator index encoded in every alternative's research Slash header.
+    pub operator_idx: u32,
+    /// Network magic encoded in every alternative's research Slash header.
+    pub magic_bytes: MagicBytes,
+    /// Ordered alternatives. Length and graph/release bindings must match Contest.
+    pub alternatives: Vec<V026AlternativePlan>,
+}
+
+/// One internally assembled alternative. Child transactions cannot be replaced by callers.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026AlternativeGraph {
+    counterproof: CounterproofV2Tx,
+    ack: CounterproofAckV2Tx,
+    timeout: CounterproofTimeoutSettlementV2Tx,
+    slash: SlashV2Tx,
+}
+
+impl V026AlternativeGraph {
+    /// Exact selected-counterproof parent.
+    pub const fn counterproof(&self) -> &CounterproofV2Tx {
+        &self.counterproof
+    }
+
+    /// Exact positive-lock ACK parent.
+    pub const fn ack(&self) -> &CounterproofAckV2Tx {
+        &self.ack
+    }
+
+    /// Exact CSV timeout settlement parent.
+    pub const fn timeout(&self) -> &CounterproofTimeoutSettlementV2Tx {
+        &self.timeout
+    }
+
+    /// Exact ACK-gated Slash parent.
+    pub const fn slash(&self) -> &SlashV2Tx {
+        &self.slash
+    }
+}
+
+/// Output roles in the exact research graph spender matrix.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum V026OutputRole {
+    /// External Claim contest output.
+    ClaimContest,
+    /// External deposit `D`.
+    Deposit,
+    /// External claim-payout output `Q`.
+    ClaimPayout,
+    /// Contest payout/selection gate `P`.
+    ContestPayout,
+    /// Contest timeout/Slash gate `S`.
+    ContestSlash,
+    /// Per-alternative counterproof funding output `C_i`.
+    CounterproofFunding(usize),
+    /// Per-alternative resolution output `R_i`.
+    Resolution(usize),
+    /// Per-alternative Slash authorization `L_i`.
+    SlashAuthorization(usize),
+    /// External stake `K`.
+    Stake,
+}
+
+/// Transaction roles allowed to consume one output in the assembled graph.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum V026SpenderRole {
+    /// Contest parent.
+    Contest,
+    /// No-counterproof owner payout.
+    OwnerPayout,
+    /// Selected counterproof parent.
+    Counterproof(usize),
+    /// Positive-lock ACK parent.
+    Ack(usize),
+    /// CSV timeout settlement parent.
+    Timeout(usize),
+    /// ACK-gated Slash parent.
+    Slash(usize),
+}
+
+/// One exact output-to-spender-set mapping.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026SpendMatrixEntry {
+    /// Output role.
+    pub output: V026OutputRole,
+    /// Complete allowed local spender set in canonical order.
+    pub spenders: Vec<V026SpenderRole>,
+}
+
+/// Funding blockers that structural assembly intentionally cannot discharge.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum V026ActivationBlocker {
+    /// NUMS role/index semantics are still a research profile.
+    ResearchNumsProfile,
+    /// Canonical graph/wire identity and encoding are not implemented.
+    CanonicalWireIdentityUnimplemented,
+    /// A qualified proof/PositiveLock/release backend and ceremony are absent.
+    ReleaseCryptographyEvidenceUnverified,
+    /// Descriptor possession and independent controller-domain evidence are absent.
+    ControllerDomainEvidenceUnverified,
+    /// Current local Slash header is not compatible with the pinned Bridge-v1 parser.
+    SlashHeaderProfileIncompatible,
+    /// External Claim/D/Q/K existence, value, and script provenance are unverified.
+    ExternalOutputEvidenceUnverified,
+    /// Fresh-D cutover and alternate-signature exclusion are unverified.
+    FreshDepositEvidenceUnverified,
+    /// Global K exclusivity and competing-spender exclusion are unverified.
+    StakeExclusivityEvidenceUnverified,
+    /// Complete presign transcript and one-honest key erasure are unverified.
+    PresignErasureEvidenceUnverified,
+    /// Legacy CP/ACK/NACK/Slash and off-transcript signature exclusion is unverified.
+    LegacyMaterialExclusionUnverified,
+    /// Exact locator, finalized vsize/rate, and aggregate fee policy are unverified.
+    FeePolicyEvidenceUnverified,
+    /// The joint finalized roster/weight bound and confirmed-Contest relay policy are unfrozen.
+    AtomicRosterWeightEvidenceUnverified,
+    /// The assembled conflict graph has not completed the required Core matrix.
+    BitcoinCoreExecutionEvidenceUnverified,
+    /// Versioned ASM recognition and coordinated activation are not installed.
+    AsmActivationEvidenceUnverified,
+    /// Runtime state, persistence, and admission do not consume this graph.
+    RuntimeAdmissionUnimplemented,
+    /// Validity with release withholding remains economically indistinguishable on chain.
+    ValidityWithholdingEconomicsUnresolved,
+}
+
+const ACTIVATION_BLOCKERS: [V026ActivationBlocker; 16] = [
+    V026ActivationBlocker::ResearchNumsProfile,
+    V026ActivationBlocker::CanonicalWireIdentityUnimplemented,
+    V026ActivationBlocker::ReleaseCryptographyEvidenceUnverified,
+    V026ActivationBlocker::ControllerDomainEvidenceUnverified,
+    V026ActivationBlocker::SlashHeaderProfileIncompatible,
+    V026ActivationBlocker::ExternalOutputEvidenceUnverified,
+    V026ActivationBlocker::FreshDepositEvidenceUnverified,
+    V026ActivationBlocker::StakeExclusivityEvidenceUnverified,
+    V026ActivationBlocker::PresignErasureEvidenceUnverified,
+    V026ActivationBlocker::LegacyMaterialExclusionUnverified,
+    V026ActivationBlocker::FeePolicyEvidenceUnverified,
+    V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified,
+    V026ActivationBlocker::BitcoinCoreExecutionEvidenceUnverified,
+    V026ActivationBlocker::AsmActivationEvidenceUnverified,
+    V026ActivationBlocker::RuntimeAdmissionUnimplemented,
+    V026ActivationBlocker::ValidityWithholdingEconomicsUnresolved,
+];
+
+/// Canonically assembled research graph with private child transactions.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct V026Graph {
+    claim_outpoint: OutPoint,
+    deposit_outpoint: OutPoint,
+    claim_payout_outpoint: OutPoint,
+    stake_outpoint: OutPoint,
+    contest: ContestV2Tx,
+    owner_payout: OwnerPayoutV2Tx,
+    alternatives: Box<[V026AlternativeGraph]>,
+    spend_matrix: Box<[V026SpendMatrixEntry]>,
+    expected_transactions: V026ExpectedTransactions,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+struct V026ExpectedAlternativeTransactions {
+    counterproof: Transaction,
+    ack: Transaction,
+    timeout: Transaction,
+    slash: Transaction,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+struct V026ExpectedTransactions {
+    contest: Transaction,
+    owner_payout: Transaction,
+    alternatives: Box<[V026ExpectedAlternativeTransactions]>,
+}
+
+impl V026Graph {
+    /// Constructs every internal edge from the actual unsigned parent txid and fixed vout.
+    pub fn assemble(plan: V026GraphPlan) -> Result<Self, V026GraphError> {
+        if plan.claim.outpoint.vout != ClaimTx::CONTEST_VOUT {
+            return Err(V026GraphError::InvalidClaimVout {
+                actual: plan.claim.outpoint.vout,
+                expected: ClaimTx::CONTEST_VOUT,
+            });
+        }
+        verify_external_outpoints([
+            ("Claim", plan.claim.outpoint),
+            ("deposit", plan.deposit.outpoint),
+            ("claim payout", plan.claim_payout.outpoint),
+            ("stake", plan.stake.outpoint),
+        ])?;
+        if plan.alternatives.is_empty() {
+            return Err(V026GraphError::EmptyAlternativeRoster);
+        }
+        verify_controller_separation(&plan)?;
+
+        let payout_gate = plan.contest.payout_gate;
+        let slash_gate = plan.contest.slash_gate;
+        let counterproof_outputs: Vec<_> = plan
+            .alternatives
+            .iter()
+            .map(|alternative| alternative.counterproof_output)
+            .collect();
+        let graph_pubkey = payout_gate.graph_pubkey();
+        if slash_gate.graph_pubkey() != graph_pubkey {
+            return Err(V026GraphError::GraphKeyMismatch {
+                index: None,
+                component: "contest Slash gate",
+            });
+        }
+        for (index, connector) in counterproof_outputs.iter().enumerate() {
+            if connector.graph_pubkey() != graph_pubkey {
+                return Err(V026GraphError::GraphKeyMismatch {
+                    index: Some(index),
+                    component: "contest counterproof output",
+                });
+            }
+        }
+        let expected_release_hashes = plan.alternatives[0]
+            .resolution_connector
+            .ack_preimage_hashes()
+            .to_vec();
+        let expected_resolution_value = plan.alternatives[0].resolution_connector.value();
+        let expected_timeout_delay = plan.alternatives[0].resolution_connector.timeout_delay();
+        for (index, alternative) in plan.alternatives.iter().enumerate() {
+            for (component, candidate) in [
+                (
+                    "counterproof resolution",
+                    alternative.resolution_connector.graph_pubkey(),
+                ),
+                (
+                    "Slash authorization",
+                    alternative.slash_authorization_connector.graph_pubkey(),
+                ),
+            ] {
+                if candidate != graph_pubkey {
+                    return Err(V026GraphError::GraphKeyMismatch {
+                        index: Some(index),
+                        component,
+                    });
+                }
+            }
+            if alternative.resolution_connector.ack_preimage_hashes()
+                != expected_release_hashes.as_slice()
+            {
+                return Err(V026GraphError::ReleaseRosterMismatch { index });
+            }
+            if alternative.resolution_connector.value() != expected_resolution_value
+                || alternative.resolution_connector.timeout_delay() != expected_timeout_delay
+            {
+                return Err(V026GraphError::ResolutionPolicyMismatch {
+                    index,
+                    expected_value: expected_resolution_value,
+                    actual_value: alternative.resolution_connector.value(),
+                    expected_timeout: expected_timeout_delay.value(),
+                    actual_timeout: alternative.resolution_connector.timeout_delay().value(),
+                });
+            }
+        }
+        let expected_transactions = build_expected_transactions(&plan)?;
+
+        let contest_alternatives = plan
+            .alternatives
+            .iter()
+            .map(|alternative| ContestAlternativeV2 {
+                counterproof_output: alternative.counterproof_output,
+                cpfp_pubkey: alternative.contest_cpfp_pubkey,
+            })
+            .collect();
+
+        let contest = ContestV2Tx::new(
+            ContestV2Data {
+                claim_txid: plan.claim.outpoint.txid,
+            },
+            plan.claim.connector,
+            ContestV2OutputPlan {
+                proof_connector: plan.contest.proof_connector,
+                payout_gate,
+                slash_gate,
+                alternatives: contest_alternatives,
+                cpfp_anchor_value: plan.contest.cpfp_anchor_value,
+                fee: plan.contest.fee,
+                fee_allowance: plan.contest.fee_allowance,
+            },
+        )
+        .map_err(V026GraphError::Contest)?;
+        let contest_txid = contest.as_ref().compute_txid();
+        let contest_payout_outpoint = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+        let contest_slash_outpoint = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+        let shared_selection = SharedSelectionOutpointsV2 {
+            deposit_outpoint: plan.deposit.outpoint,
+            contest_payout_outpoint,
+        };
+        let counterproof_reserves = plan
+            .alternatives
+            .iter()
+            .enumerate()
+            .map(|(index, alternative)| {
+                let counterproof_vout = contest
+                    .counterproof_vout(index)
+                    .map_err(V026GraphError::Contest)?;
+                Ok(CounterproofReserveBindingV2::new(
+                    OutPoint::new(contest_txid, counterproof_vout),
+                    alternative.counterproof_output,
+                    alternative.counterproof_reserve_descriptor.clone(),
+                ))
+            })
+            .collect::<Result<Vec<_>, V026GraphError>>()?;
+
+        let owner_payout = OwnerPayoutV2Tx::new(
+            OwnerPayoutV2Data {
+                shared_selection,
+                claim_payout_outpoint: plan.claim_payout.outpoint,
+                contest_slash_outpoint,
+                counterproof_reserves: counterproof_reserves.clone(),
+            },
+            plan.deposit.connector,
+            plan.claim_payout.connector,
+            payout_gate,
+            slash_gate,
+            &plan.owner_descriptor,
+            plan.owner_fee,
+            plan.owner_fee_allowance,
+        )
+        .map_err(V026GraphError::OwnerPayout)?;
+
+        let mut alternatives = Vec::with_capacity(plan.alternatives.len());
+        for (index, alternative) in plan.alternatives.into_iter().enumerate() {
+            let counterproof = CounterproofV2Tx::new(
+                CounterproofV2Data {
+                    counterproof_reserves: counterproof_reserves.clone(),
+                    selected_index: index,
+                    shared_selection,
+                },
+                payout_gate,
+                plan.deposit.connector,
+                &plan.recovery_descriptor,
+                alternative.resolution_connector.clone(),
+                alternative.counterproof_cpfp_connector,
+                alternative.counterproof_fee,
+                alternative.counterproof_fee_allowance,
+            )
+            .map_err(|source| V026GraphError::Counterproof { index, source })?;
+            let resolution_outpoint = OutPoint::new(
+                counterproof.as_ref().compute_txid(),
+                CounterproofV2Tx::RESOLUTION_VOUT,
+            );
+            let ack = CounterproofAckV2Tx::new(
+                CounterproofAckV2Data {
+                    resolution_outpoint,
+                },
+                alternative.resolution_connector.clone(),
+                alternative.slash_authorization_connector,
+                alternative.ack_cpfp_connector,
+                alternative.ack_fee,
+                alternative.ack_fee_allowance,
+            )
+            .map_err(|source| V026GraphError::Ack { index, source })?;
+            let timeout = CounterproofTimeoutSettlementV2Tx::new(
+                CounterproofTimeoutSettlementV2Data {
+                    resolution_outpoint,
+                    contest_slash_outpoint,
+                },
+                alternative.resolution_connector,
+                slash_gate,
+                alternative.timeout_cpfp_connector,
+                &plan.recovery_descriptor,
+                alternative.timeout_fee,
+                alternative.timeout_fee_allowance,
+            )
+            .map_err(|source| V026GraphError::Timeout { index, source })?;
+            let slash_authorization_outpoint = OutPoint::new(
+                ack.as_ref().compute_txid(),
+                CounterproofAckV2Tx::SLASH_AUTHORIZATION_VOUT,
+            );
+            let slash = SlashV2Tx::new(
+                SlashV2Data {
+                    slash_authorization_outpoint,
+                    contest_slash_outpoint,
+                    stake_outpoint: plan.stake.outpoint,
+                    operator_idx: plan.operator_idx,
+                    magic_bytes: plan.magic_bytes,
+                },
+                alternative.slash_authorization_connector,
+                slash_gate,
+                plan.stake.connector,
+                alternative.slash_payouts,
+                alternative.slash_fee,
+                alternative.slash_fee_allowance,
+            )
+            .map_err(|source| V026GraphError::Slash { index, source })?;
+            alternatives.push(V026AlternativeGraph {
+                counterproof,
+                ack,
+                timeout,
+                slash,
+            });
+        }
+
+        let spend_matrix = build_spend_matrix(alternatives.len()).into_boxed_slice();
+        let graph = Self {
+            claim_outpoint: plan.claim.outpoint,
+            deposit_outpoint: plan.deposit.outpoint,
+            claim_payout_outpoint: plan.claim_payout.outpoint,
+            stake_outpoint: plan.stake.outpoint,
+            contest,
+            owner_payout,
+            alternatives: alternatives.into_boxed_slice(),
+            spend_matrix,
+            expected_transactions,
+        };
+        graph.verify_structure()?;
+        Ok(graph)
+    }
+
+    /// Rechecks every serialized internal edge and exact input/output shape.
+    pub fn verify_structure(&self) -> Result<(), V026GraphError> {
+        verify_exact_transaction(
+            "Contest",
+            None,
+            self.contest.as_ref(),
+            &self.expected_transactions.contest,
+        )?;
+        verify_exact_transaction(
+            "OwnerPayout",
+            None,
+            self.owner_payout.as_ref(),
+            &self.expected_transactions.owner_payout,
+        )?;
+        if self.expected_transactions.alternatives.len() != self.alternatives.len() {
+            return Err(V026GraphError::ExpectedAlternativeCountMismatch {
+                expected: self.expected_transactions.alternatives.len(),
+                actual: self.alternatives.len(),
+            });
+        }
+        let recomputed_matrix = build_spend_matrix(self.alternatives.len());
+        if self.spend_matrix.as_ref() != recomputed_matrix.as_slice() {
+            return Err(V026GraphError::SpendMatrixMismatch);
+        }
+
+        let contest_tx = self.contest.as_ref();
+        verify_shape("Contest", None, contest_tx, 1, self.alternatives.len() + 4)?;
+        verify_input("Contest", None, contest_tx, 0, self.claim_outpoint)?;
+        let contest_txid = contest_tx.compute_txid();
+        let p = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+        let s = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+        let counterproof_outpoints = (0..self.alternatives.len())
+            .map(|index| {
+                self.contest
+                    .counterproof_vout(index)
+                    .map(|vout| OutPoint::new(contest_txid, vout))
+                    .map_err(V026GraphError::Contest)
+            })
+            .collect::<Result<Vec<_>, V026GraphError>>()?;
+
+        let owner = self.owner_payout.as_ref();
+        verify_shape(
+            "OwnerPayout",
+            None,
+            owner,
+            self.alternatives.len() + 4,
+            self.alternatives.len() + 1,
+        )?;
+        for (input, expected) in [self.deposit_outpoint, self.claim_payout_outpoint, p, s]
+            .into_iter()
+            .enumerate()
+        {
+            verify_input("OwnerPayout", None, owner, input, expected)?;
+        }
+        for (index, expected) in counterproof_outpoints.iter().copied().enumerate() {
+            verify_input("OwnerPayout", None, owner, index + 4, expected)?;
+        }
+
+        for (index, alternative) in self.alternatives.iter().enumerate() {
+            let expected = &self.expected_transactions.alternatives[index];
+            for (template, actual, expected) in [
+                (
+                    "Counterproof",
+                    alternative.counterproof.as_ref(),
+                    &expected.counterproof,
+                ),
+                ("ACK", alternative.ack.as_ref(), &expected.ack),
+                ("Timeout", alternative.timeout.as_ref(), &expected.timeout),
+                ("Slash", alternative.slash.as_ref(), &expected.slash),
+            ] {
+                verify_exact_transaction(template, Some(index), actual, expected)?;
+            }
+            let cp = alternative.counterproof.as_ref();
+            verify_shape(
+                "Counterproof",
+                Some(index),
+                cp,
+                self.alternatives.len() + 2,
+                self.alternatives.len() + 2,
+            )?;
+            for (input, expected) in counterproof_outpoints.iter().copied().enumerate() {
+                verify_input("Counterproof", Some(index), cp, input, expected)?;
+            }
+            verify_input("Counterproof", Some(index), cp, self.alternatives.len(), p)?;
+            verify_input(
+                "Counterproof",
+                Some(index),
+                cp,
+                self.alternatives.len() + 1,
+                self.deposit_outpoint,
+            )?;
+            let r = OutPoint::new(cp.compute_txid(), CounterproofV2Tx::RESOLUTION_VOUT);
+
+            let ack = alternative.ack.as_ref();
+            verify_shape("ACK", Some(index), ack, 1, 2)?;
+            verify_input("ACK", Some(index), ack, 0, r)?;
+            let l = OutPoint::new(
+                ack.compute_txid(),
+                CounterproofAckV2Tx::SLASH_AUTHORIZATION_VOUT,
+            );
+
+            let timeout = alternative.timeout.as_ref();
+            if timeout.output.len() != 1 && timeout.output.len() != 2 {
+                return Err(V026GraphError::TransactionShape {
+                    template: "Timeout",
+                    index: Some(index),
+                    expected_inputs: 2,
+                    actual_inputs: timeout.input.len(),
+                    expected_outputs: "one or two",
+                    actual_outputs: timeout.output.len(),
+                });
+            }
+            if timeout.input.len() != 2 {
+                return Err(V026GraphError::TransactionShape {
+                    template: "Timeout",
+                    index: Some(index),
+                    expected_inputs: 2,
+                    actual_inputs: timeout.input.len(),
+                    expected_outputs: "one or two",
+                    actual_outputs: timeout.output.len(),
+                });
+            }
+            verify_input("Timeout", Some(index), timeout, 0, r)?;
+            verify_input("Timeout", Some(index), timeout, 1, s)?;
+
+            let slash = alternative.slash.as_ref();
+            if slash.input.len() != 3 || slash.output.len() < 2 {
+                return Err(V026GraphError::TransactionShape {
+                    template: "Slash",
+                    index: Some(index),
+                    expected_inputs: 3,
+                    actual_inputs: slash.input.len(),
+                    expected_outputs: "at least two",
+                    actual_outputs: slash.output.len(),
+                });
+            }
+            verify_input("Slash", Some(index), slash, 0, l)?;
+            verify_input("Slash", Some(index), slash, 1, s)?;
+            verify_input("Slash", Some(index), slash, 2, self.stake_outpoint)?;
+        }
+        Ok(())
+    }
+
+    /// Returns the exact Contest parent.
+    pub const fn contest(&self) -> &ContestV2Tx {
+        &self.contest
+    }
+
+    /// Returns the exact no-counterproof owner parent.
+    pub const fn owner_payout(&self) -> &OwnerPayoutV2Tx {
+        &self.owner_payout
+    }
+
+    /// Returns alternatives in canonical order.
+    pub const fn alternatives(&self) -> &[V026AlternativeGraph] {
+        &self.alternatives
+    }
+
+    /// Returns the exact local output-to-spender mapping.
+    pub const fn spend_matrix(&self) -> &[V026SpendMatrixEntry] {
+        &self.spend_matrix
+    }
+
+    /// Returns the unconditional activation blockers for this research slice.
+    pub const fn activation_blockers(&self) -> &'static [V026ActivationBlocker] {
+        &ACTIVATION_BLOCKERS
+    }
+
+    /// This structural research graph is never funding eligible.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+fn build_spend_matrix(count: usize) -> Vec<V026SpendMatrixEntry> {
+    let mut owner_and_counterproofs = vec![V026SpenderRole::OwnerPayout];
+    owner_and_counterproofs.extend((0..count).map(V026SpenderRole::Counterproof));
+    let mut owner_timeouts_and_slashes = vec![V026SpenderRole::OwnerPayout];
+    owner_timeouts_and_slashes.extend((0..count).map(V026SpenderRole::Timeout));
+    owner_timeouts_and_slashes.extend((0..count).map(V026SpenderRole::Slash));
+    let mut slash_spenders = Vec::with_capacity(count);
+    slash_spenders.extend((0..count).map(V026SpenderRole::Slash));
+
+    let mut entries = vec![
+        V026SpendMatrixEntry {
+            output: V026OutputRole::ClaimContest,
+            spenders: vec![V026SpenderRole::Contest],
+        },
+        V026SpendMatrixEntry {
+            output: V026OutputRole::Deposit,
+            spenders: owner_and_counterproofs.clone(),
+        },
+        V026SpendMatrixEntry {
+            output: V026OutputRole::ClaimPayout,
+            spenders: vec![V026SpenderRole::OwnerPayout],
+        },
+        V026SpendMatrixEntry {
+            output: V026OutputRole::ContestPayout,
+            spenders: owner_and_counterproofs.clone(),
+        },
+        V026SpendMatrixEntry {
+            output: V026OutputRole::ContestSlash,
+            spenders: owner_timeouts_and_slashes,
+        },
+        V026SpendMatrixEntry {
+            output: V026OutputRole::Stake,
+            spenders: slash_spenders,
+        },
+    ];
+    for index in 0..count {
+        entries.extend([
+            V026SpendMatrixEntry {
+                output: V026OutputRole::CounterproofFunding(index),
+                spenders: owner_and_counterproofs.clone(),
+            },
+            V026SpendMatrixEntry {
+                output: V026OutputRole::Resolution(index),
+                spenders: vec![V026SpenderRole::Ack(index), V026SpenderRole::Timeout(index)],
+            },
+            V026SpendMatrixEntry {
+                output: V026OutputRole::SlashAuthorization(index),
+                spenders: vec![V026SpenderRole::Slash(index)],
+            },
+        ]);
+    }
+    entries
+}
+
+fn build_expected_transactions(
+    plan: &V026GraphPlan,
+) -> Result<V026ExpectedTransactions, V026GraphError> {
+    let contest_outputs = plan
+        .alternatives
+        .iter()
+        .map(|alternative| alternative.counterproof_output.tx_out());
+    let contest_cpfp = MultiAnchor::new(
+        plan.contest.payout_gate.network(),
+        plan.alternatives
+            .iter()
+            .map(|alternative| alternative.contest_cpfp_pubkey)
+            .collect(),
+        plan.contest.cpfp_anchor_value,
+    );
+    let mut outputs = vec![
+        plan.contest.proof_connector.tx_out(),
+        plan.contest.payout_gate.tx_out(),
+        plan.contest.slash_gate.tx_out(),
+    ];
+    outputs.extend(contest_outputs);
+    outputs.push(contest_cpfp.tx_out());
+    let contest = unsigned_transaction(
+        vec![(
+            plan.claim.outpoint,
+            plan.claim
+                .connector
+                .sequence(ClaimContestSpendPath::Contested {
+                    watchtower_index: 0,
+                }),
+        )],
+        outputs,
+    );
+    verify_declared_fee(
+        "Contest",
+        None,
+        plan.claim.connector.value(),
+        &contest.output,
+        plan.contest.fee,
+    )?;
+    let contest_txid = contest.compute_txid();
+    let payout_outpoint = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+    let slash_outpoint = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+    let counterproof_outpoints = (0..plan.alternatives.len())
+        .map(|index| {
+            let index_u32 = u32::try_from(index)
+                .map_err(|_| V026GraphError::ExpectedIndexOverflow { index })?;
+            let vout = ContestV2Tx::COUNTERPROOF_0_VOUT
+                .checked_add(index_u32)
+                .ok_or(V026GraphError::ExpectedIndexOverflow { index })?;
+            Ok(OutPoint::new(contest_txid, vout))
+        })
+        .collect::<Result<Vec<_>, V026GraphError>>()?;
+
+    let owner_fixed_input = checked_sum(
+        "OwnerPayout",
+        None,
+        [
+            plan.deposit.connector.value(),
+            plan.claim_payout.connector.value(),
+            plan.contest.payout_gate.value(),
+            plan.contest.slash_gate.value(),
+        ],
+    )?;
+    let owner_value = owner_fixed_input.checked_sub(plan.owner_fee).ok_or(
+        V026GraphError::ExpectedValueComputation {
+            template: "OwnerPayout",
+            index: None,
+        },
+    )?;
+    let mut owner_inputs = vec![
+        (
+            plan.deposit.outpoint,
+            plan.deposit.connector.sequence(NOfNSpend),
+        ),
+        (
+            plan.claim_payout.outpoint,
+            plan.claim_payout
+                .connector
+                .sequence(ClaimPayoutSpendPath::Payout),
+        ),
+        (
+            payout_outpoint,
+            plan.contest
+                .payout_gate
+                .sequence(ContestPayoutGateSpendPathV2::OwnerPayout),
+        ),
+        (
+            slash_outpoint,
+            plan.contest
+                .slash_gate
+                .sequence(ContestSlashGateSpendPathV2::Settlement),
+        ),
+    ];
+    owner_inputs.extend(
+        counterproof_outpoints
+            .iter()
+            .copied()
+            .zip(plan.alternatives.iter())
+            .map(|(outpoint, alternative)| {
+                (
+                    outpoint,
+                    alternative
+                        .counterproof_output
+                        .sequence(ContestCounterproofSpendV2::ReserveRecovery),
+                )
+            }),
+    );
+    let mut owner_outputs = vec![TxOut {
+        value: owner_value,
+        script_pubkey: plan.owner_descriptor.to_script(),
+    }];
+    owner_outputs.extend(plan.alternatives.iter().map(|alternative| TxOut {
+        value: alternative.counterproof_output.value(),
+        script_pubkey: alternative.counterproof_reserve_descriptor.to_script(),
+    }));
+    let owner_payout = unsigned_transaction(owner_inputs, owner_outputs);
+    let owner_input =
+        plan.alternatives
+            .iter()
+            .try_fold(owner_fixed_input, |sum, alternative| {
+                sum.checked_add(alternative.counterproof_output.value())
+                    .ok_or(V026GraphError::ExpectedValueComputation {
+                        template: "OwnerPayout",
+                        index: None,
+                    })
+            })?;
+    verify_declared_fee(
+        "OwnerPayout",
+        None,
+        owner_input,
+        &owner_payout.output,
+        plan.owner_fee,
+    )?;
+
+    let mut alternatives = Vec::with_capacity(plan.alternatives.len());
+    for (index, alternative) in plan.alternatives.iter().enumerate() {
+        let mut counterproof_inputs = counterproof_outpoints
+            .iter()
+            .copied()
+            .zip(plan.alternatives.iter())
+            .enumerate()
+            .map(|(reserve_index, (outpoint, reserve))| {
+                let path = if reserve_index == index {
+                    ContestCounterproofSpendV2::Counterproof
+                } else {
+                    ContestCounterproofSpendV2::ReserveRecovery
+                };
+                (outpoint, reserve.counterproof_output.sequence(path))
+            })
+            .collect::<Vec<_>>();
+        counterproof_inputs.extend([
+            (
+                payout_outpoint,
+                plan.contest
+                    .payout_gate
+                    .sequence(ContestPayoutGateSpendPathV2::ImmediateSelection),
+            ),
+            (
+                plan.deposit.outpoint,
+                plan.deposit.connector.sequence(NOfNSpend),
+            ),
+        ]);
+        let mut counterproof_outputs = vec![
+            TxOut {
+                value: plan.deposit.connector.value(),
+                script_pubkey: plan.recovery_descriptor.to_script(),
+            },
+            alternative.resolution_connector.tx_out(),
+            alternative.counterproof_cpfp_connector.tx_out(),
+        ];
+        counterproof_outputs.extend(
+            plan.alternatives
+                .iter()
+                .enumerate()
+                .filter(|(reserve_index, _reserve)| *reserve_index != index)
+                .map(|(_reserve_index, reserve)| TxOut {
+                    value: reserve.counterproof_output.value(),
+                    script_pubkey: reserve.counterproof_reserve_descriptor.to_script(),
+                }),
+        );
+        let counterproof = unsigned_transaction(counterproof_inputs, counterproof_outputs);
+        let counterproof_input =
+            plan.alternatives
+                .iter()
+                .try_fold(Amount::ZERO, |sum, reserve| {
+                    sum.checked_add(reserve.counterproof_output.value()).ok_or(
+                        V026GraphError::ExpectedValueComputation {
+                            template: "Counterproof",
+                            index: Some(index),
+                        },
+                    )
+                })?;
+        let counterproof_input = counterproof_input
+            .checked_add(plan.contest.payout_gate.value())
+            .and_then(|value| value.checked_add(plan.deposit.connector.value()))
+            .ok_or(V026GraphError::ExpectedValueComputation {
+                template: "Counterproof",
+                index: Some(index),
+            })?;
+        verify_declared_fee(
+            "Counterproof",
+            Some(index),
+            counterproof_input,
+            &counterproof.output,
+            alternative.counterproof_fee,
+        )?;
+        let resolution_outpoint = OutPoint::new(
+            counterproof.compute_txid(),
+            CounterproofV2Tx::RESOLUTION_VOUT,
+        );
+        let ack = unsigned_transaction(
+            vec![(
+                resolution_outpoint,
+                alternative
+                    .resolution_connector
+                    .sequence(CounterproofResolutionSpendPathV2::Ack),
+            )],
+            vec![
+                alternative.slash_authorization_connector.tx_out(),
+                alternative.ack_cpfp_connector.tx_out(),
+            ],
+        );
+        verify_declared_fee(
+            "ACK",
+            Some(index),
+            alternative.resolution_connector.value(),
+            &ack.output,
+            alternative.ack_fee,
+        )?;
+
+        let timeout_inputs = checked_sum(
+            "Timeout",
+            Some(index),
+            [
+                alternative.resolution_connector.value(),
+                plan.contest.slash_gate.value(),
+            ],
+        )?;
+        let timeout_fixed = checked_sum(
+            "Timeout",
+            Some(index),
+            [
+                alternative.timeout_cpfp_connector.value(),
+                alternative.timeout_fee,
+            ],
+        )?;
+        let timeout_change = timeout_inputs.checked_sub(timeout_fixed).ok_or(
+            V026GraphError::ExpectedValueComputation {
+                template: "Timeout",
+                index: Some(index),
+            },
+        )?;
+        let mut timeout_outputs = vec![alternative.timeout_cpfp_connector.tx_out()];
+        if timeout_change != Amount::ZERO {
+            timeout_outputs.push(TxOut {
+                value: timeout_change,
+                script_pubkey: plan.recovery_descriptor.to_script(),
+            });
+        }
+        let timeout = unsigned_transaction(
+            vec![
+                (
+                    resolution_outpoint,
+                    alternative
+                        .resolution_connector
+                        .sequence(CounterproofResolutionSpendPathV2::Timeout),
+                ),
+                (
+                    slash_outpoint,
+                    plan.contest
+                        .slash_gate
+                        .sequence(ContestSlashGateSpendPathV2::Settlement),
+                ),
+            ],
+            timeout_outputs,
+        );
+        verify_declared_fee(
+            "Timeout",
+            Some(index),
+            timeout_inputs,
+            &timeout.output,
+            alternative.timeout_fee,
+        )?;
+
+        let slash_authorization_outpoint = OutPoint::new(
+            ack.compute_txid(),
+            CounterproofAckV2Tx::SLASH_AUTHORIZATION_VOUT,
+        );
+        let tag_data = SlashTxHeaderAux::new(plan.operator_idx).build_tag_data();
+        let header_script = ParseConfig::new(plan.magic_bytes)
+            .encode_script_buf(&tag_data.as_ref())
+            .map_err(|error| V026GraphError::ExpectedHeaderEncoding(error.to_string()))?;
+        let mut slash_outputs = vec![TxOut {
+            value: Amount::ZERO,
+            script_pubkey: header_script,
+        }];
+        slash_outputs.extend(alternative.slash_payouts.iter().map(|payout| TxOut {
+            value: payout.value(),
+            script_pubkey: payout.descriptor().to_script(),
+        }));
+        let slash = unsigned_transaction(
+            vec![
+                (
+                    slash_authorization_outpoint,
+                    alternative
+                        .slash_authorization_connector
+                        .sequence(SlashAuthorizationSpendPathV2),
+                ),
+                (
+                    slash_outpoint,
+                    plan.contest
+                        .slash_gate
+                        .sequence(ContestSlashGateSpendPathV2::Slash),
+                ),
+                (
+                    plan.stake.outpoint,
+                    plan.stake.connector.sequence(NOfNSpend),
+                ),
+            ],
+            slash_outputs,
+        );
+        let slash_input = checked_sum(
+            "Slash",
+            Some(index),
+            [
+                alternative.slash_authorization_connector.value(),
+                plan.contest.slash_gate.value(),
+                plan.stake.connector.value(),
+            ],
+        )?;
+        verify_declared_fee(
+            "Slash",
+            Some(index),
+            slash_input,
+            &slash.output,
+            alternative.slash_fee,
+        )?;
+        alternatives.push(V026ExpectedAlternativeTransactions {
+            counterproof,
+            ack,
+            timeout,
+            slash,
+        });
+    }
+
+    Ok(V026ExpectedTransactions {
+        contest,
+        owner_payout,
+        alternatives: alternatives.into_boxed_slice(),
+    })
+}
+
+fn checked_sum<const N: usize>(
+    template: &'static str,
+    index: Option<usize>,
+    values: [Amount; N],
+) -> Result<Amount, V026GraphError> {
+    values.into_iter().try_fold(Amount::ZERO, |sum, value| {
+        sum.checked_add(value)
+            .ok_or(V026GraphError::ExpectedValueComputation { template, index })
+    })
+}
+
+fn verify_declared_fee(
+    template: &'static str,
+    index: Option<usize>,
+    input: Amount,
+    outputs: &[TxOut],
+    fee: Amount,
+) -> Result<(), V026GraphError> {
+    let output = outputs.iter().try_fold(Amount::ZERO, |sum, txout| {
+        sum.checked_add(txout.value)
+            .ok_or(V026GraphError::ExpectedValueComputation { template, index })
+    })?;
+    let output_and_fee = output
+        .checked_add(fee)
+        .ok_or(V026GraphError::ExpectedValueComputation { template, index })?;
+    if input != output_and_fee {
+        return Err(V026GraphError::ExpectedFeeMismatch {
+            template,
+            index,
+            input,
+            output,
+            fee,
+        });
+    }
+    Ok(())
+}
+
+fn unsigned_transaction(inputs: Vec<(OutPoint, Sequence)>, output: Vec<TxOut>) -> Transaction {
+    Transaction {
+        version: Version(3),
+        lock_time: absolute::LockTime::ZERO,
+        input: inputs
+            .into_iter()
+            .map(|(previous_output, sequence)| TxIn {
+                previous_output,
+                sequence,
+                ..Default::default()
+            })
+            .collect(),
+        output,
+    }
+}
+
+fn verify_external_outpoints(roles: [(&'static str, OutPoint); 4]) -> Result<(), V026GraphError> {
+    for (index, (first_role, first)) in roles.iter().copied().enumerate() {
+        for (second_role, second) in roles[index + 1..].iter().copied() {
+            if first == second {
+                return Err(V026GraphError::ExternalOutpointAlias {
+                    first_role,
+                    second_role,
+                    outpoint: first,
+                });
+            }
+        }
+    }
+    Ok(())
+}
+
+fn verify_controller_separation(plan: &V026GraphPlan) -> Result<(), V026GraphError> {
+    let recovery = plan.recovery_descriptor.payload();
+    let owner = plan.owner_descriptor.payload();
+    if recovery == owner {
+        return Err(V026GraphError::ControllerAlias {
+            protected_role: "recovery",
+            other_role: "owner",
+            alternative: None,
+        });
+    }
+
+    let mut forbidden_nums_keys = HashSet::new();
+    for nums in known_nums_keys("contest payout P", &plan.contest.payout_gate)
+        .into_iter()
+        .chain(known_nums_keys("contest Slash S", &plan.contest.slash_gate))
+    {
+        forbidden_nums_keys.insert(nums.key.serialize());
+    }
+    for alternative in &plan.alternatives {
+        for nums in known_nums_keys("contest counterproof C", &alternative.counterproof_output)
+            .into_iter()
+            .chain(known_nums_keys(
+                "counterproof resolution R",
+                &alternative.resolution_connector,
+            ))
+            .chain(known_nums_keys(
+                "Slash authorization L",
+                &alternative.slash_authorization_connector,
+            ))
+        {
+            forbidden_nums_keys.insert(nums.key.serialize());
+        }
+    }
+    let contest_cpfp = MultiAnchor::new(
+        plan.contest.payout_gate.network(),
+        plan.alternatives
+            .iter()
+            .map(|alternative| alternative.contest_cpfp_pubkey)
+            .collect(),
+        plan.contest.cpfp_anchor_value,
+    );
+    let contest_cpfp_internal_key = contest_cpfp.internal_key().serialize();
+    let contest_cpfp_output_key = contest_cpfp
+        .spend_info()
+        .output_key()
+        .to_x_only_public_key()
+        .serialize();
+    forbidden_nums_keys.insert(contest_cpfp_internal_key);
+    forbidden_nums_keys.insert(contest_cpfp_output_key);
+
+    let graph_key = plan.contest.payout_gate.graph_pubkey().serialize();
+    if forbidden_nums_keys.contains(&graph_key) {
+        return Err(V026GraphError::ControllerAlias {
+            protected_role: "graph authorization",
+            other_role: "v2 NUMS",
+            alternative: None,
+        });
+    }
+    let mut authorization_keys = vec![("graph authorization", graph_key, None)];
+    for (alternative_index, alternative) in plan.alternatives.iter().enumerate() {
+        let operator_key = alternative
+            .counterproof_output
+            .operator_pubkey()
+            .serialize();
+        if forbidden_nums_keys.contains(&operator_key) {
+            return Err(V026GraphError::ControllerAlias {
+                protected_role: "counterproof operator authorization",
+                other_role: "v2 NUMS",
+                alternative: Some(alternative_index),
+            });
+        }
+        authorization_keys.push((
+            "counterproof operator authorization",
+            operator_key,
+            Some(alternative_index),
+        ));
+    }
+
+    for (protected_role, protected) in [("recovery", recovery), ("owner", owner)] {
+        if forbidden_nums_keys.contains(protected) {
+            return Err(V026GraphError::ControllerAlias {
+                protected_role,
+                other_role: "v2 NUMS",
+                alternative: None,
+            });
+        }
+    }
+
+    let funding_controller_keys = [
+        ("deposit", plan.deposit.connector.internal_key().serialize()),
+        (
+            "deposit",
+            plan.deposit
+                .connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key()
+                .serialize(),
+        ),
+        (
+            "claim payout",
+            plan.claim_payout.connector.internal_key().serialize(),
+        ),
+        (
+            "claim payout",
+            plan.claim_payout
+                .connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key()
+                .serialize(),
+        ),
+        ("stake", plan.stake.connector.internal_key().serialize()),
+        (
+            "stake",
+            plan.stake
+                .connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key()
+                .serialize(),
+        ),
+    ];
+
+    let mut service_controller_keys =
+        HashSet::with_capacity(plan.alternatives.len().saturating_mul(7));
+    for alternative in &plan.alternatives {
+        service_controller_keys.insert(alternative.contest_cpfp_pubkey.serialize());
+        for connector in [
+            &alternative.counterproof_cpfp_connector,
+            &alternative.ack_cpfp_connector,
+            &alternative.timeout_cpfp_connector,
+        ] {
+            service_controller_keys.insert(connector.internal_key().serialize());
+            service_controller_keys.insert(
+                connector
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key()
+                    .serialize(),
+            );
+        }
+    }
+    if service_controller_keys
+        .iter()
+        .any(|service_key| forbidden_nums_keys.contains(service_key))
+    {
+        return Err(V026GraphError::ControllerAlias {
+            protected_role: "service CPFP",
+            other_role: "v2 NUMS",
+            alternative: None,
+        });
+    }
+
+    let mut service_domain_keys = service_controller_keys.clone();
+    service_domain_keys.insert(contest_cpfp_internal_key);
+    service_domain_keys.insert(contest_cpfp_output_key);
+    if let Some((other_role, _key, alternative)) = authorization_keys
+        .iter()
+        .find(|(_role, key, _alternative)| service_domain_keys.contains(key))
+    {
+        return Err(V026GraphError::ControllerAlias {
+            protected_role: "service CPFP",
+            other_role,
+            alternative: *alternative,
+        });
+    }
+    if let Some((other_role, _key)) = funding_controller_keys
+        .iter()
+        .find(|(_role, key)| service_domain_keys.contains(key))
+    {
+        return Err(V026GraphError::ControllerAlias {
+            protected_role: "service CPFP",
+            other_role,
+            alternative: None,
+        });
+    }
+
+    for (role, protected) in [("recovery", recovery), ("owner", owner)] {
+        let collision = funding_controller_keys
+            .iter()
+            .find(|(_role, key)| key.as_slice() == protected)
+            .map(|(other_role, _key)| *other_role)
+            .or_else(|| {
+                authorization_keys
+                    .iter()
+                    .find(|(_role, key, _alternative)| key.as_slice() == protected)
+                    .map(|(other_role, _key, _alternative)| *other_role)
+            })
+            .or_else(|| {
+                service_domain_keys
+                    .contains(protected)
+                    .then_some("service CPFP")
+            });
+        if let Some(other_role) = collision {
+            return Err(V026GraphError::ControllerAlias {
+                protected_role: role,
+                other_role,
+                alternative: None,
+            });
+        }
+    }
+
+    let mut reserve_keys = HashSet::with_capacity(plan.alternatives.len());
+    for (alternative_index, alternative) in plan.alternatives.iter().enumerate() {
+        let reserve = alternative.counterproof_reserve_descriptor.payload();
+        let collision = if forbidden_nums_keys.contains(reserve) {
+            Some("v2 NUMS")
+        } else if reserve == recovery {
+            Some("recovery")
+        } else if reserve == owner {
+            Some("owner")
+        } else if let Some((role, _key)) = funding_controller_keys
+            .iter()
+            .find(|(_role, key)| key.as_slice() == reserve)
+        {
+            Some(*role)
+        } else if let Some((role, _key, _alternative)) = authorization_keys
+            .iter()
+            .find(|(_role, key, _alternative)| key.as_slice() == reserve)
+        {
+            Some(*role)
+        } else if service_domain_keys.contains(reserve) {
+            Some("service CPFP")
+        } else if !reserve_keys.insert(reserve.to_vec()) {
+            Some("counterproof reserve recovery")
+        } else {
+            None
+        };
+        if let Some(other_role) = collision {
+            return Err(V026GraphError::ControllerAlias {
+                protected_role: "counterproof reserve recovery",
+                other_role,
+                alternative: Some(alternative_index),
+            });
+        }
+    }
+
+    for (alternative_index, alternative) in plan.alternatives.iter().enumerate() {
+        for payout in &alternative.slash_payouts {
+            let payout_key = payout.controller_key().serialize();
+            let collision = if forbidden_nums_keys.contains(&payout_key) {
+                Some("v2 NUMS")
+            } else if payout_key.as_slice() == recovery {
+                Some("recovery")
+            } else if payout_key.as_slice() == owner {
+                Some("owner")
+            } else if let Some((role, _key)) = funding_controller_keys
+                .iter()
+                .find(|(_role, key)| *key == payout_key)
+            {
+                Some(*role)
+            } else if let Some((role, _key, _alternative)) = authorization_keys
+                .iter()
+                .find(|(_role, key, _alternative)| *key == payout_key)
+            {
+                Some(*role)
+            } else if service_domain_keys.contains(&payout_key) {
+                Some("service CPFP")
+            } else if reserve_keys.contains(payout_key.as_slice()) {
+                Some("counterproof reserve recovery")
+            } else {
+                None
+            };
+            if let Some(other_role) = collision {
+                return Err(V026GraphError::ControllerAlias {
+                    protected_role: "Slash beneficiary",
+                    other_role,
+                    alternative: Some(alternative_index),
+                });
+            }
+        }
+    }
+    Ok(())
+}
+
+fn verify_exact_transaction(
+    template: &'static str,
+    index: Option<usize>,
+    actual: &Transaction,
+    expected: &Transaction,
+) -> Result<(), V026GraphError> {
+    if actual != expected {
+        return Err(V026GraphError::ExactTransactionMismatch { template, index });
+    }
+    Ok(())
+}
+
+const fn verify_shape(
+    template: &'static str,
+    index: Option<usize>,
+    tx: &Transaction,
+    expected_inputs: usize,
+    expected_outputs: usize,
+) -> Result<(), V026GraphError> {
+    if tx.input.len() != expected_inputs || tx.output.len() != expected_outputs {
+        return Err(V026GraphError::TransactionShape {
+            template,
+            index,
+            expected_inputs,
+            actual_inputs: tx.input.len(),
+            expected_outputs: match expected_outputs {
+                1 => "one",
+                2 => "two",
+                3 => "three",
+                _ => "fixed roster",
+            },
+            actual_outputs: tx.output.len(),
+        });
+    }
+    Ok(())
+}
+
+fn verify_input(
+    template: &'static str,
+    index: Option<usize>,
+    tx: &Transaction,
+    input: usize,
+    expected: OutPoint,
+) -> Result<(), V026GraphError> {
+    let actual = tx
+        .input
+        .get(input)
+        .ok_or(V026GraphError::MissingInput {
+            template,
+            index,
+            input,
+        })?
+        .previous_output;
+    if actual != expected {
+        return Err(V026GraphError::InternalEdgeMismatch {
+            template,
+            index,
+            input,
+            expected,
+            actual,
+        });
+    }
+    Ok(())
+}
+
+/// Structural assembly or verification failure.
+#[derive(Debug)]
+pub enum V026GraphError {
+    /// Claim outpoint is not the vout hardcoded by the existing Contest constructor.
+    InvalidClaimVout {
+        /// Supplied vout.
+        actual: u32,
+        /// Required vout.
+        expected: u32,
+    },
+    /// No counterproof alternative was supplied.
+    EmptyAlternativeRoster,
+    /// Two external roles name the same outpoint.
+    ExternalOutpointAlias {
+        /// First external role.
+        first_role: &'static str,
+        /// Second external role.
+        second_role: &'static str,
+        /// Aliased outpoint.
+        outpoint: OutPoint,
+    },
+    /// A protected controller aliases an incompatible graph role.
+    ControllerAlias {
+        /// Protected controller role.
+        protected_role: &'static str,
+        /// Incompatible role using the same key.
+        other_role: &'static str,
+        /// Alternative containing the alias where applicable.
+        alternative: Option<usize>,
+    },
+    /// A script leaf uses a different graph key.
+    GraphKeyMismatch {
+        /// Alternative index, or none for a shared connector.
+        index: Option<usize>,
+        /// Mismatching component.
+        component: &'static str,
+    },
+    /// An `R_i` commits a different ordered release vector.
+    ReleaseRosterMismatch {
+        /// Mismatching alternative.
+        index: usize,
+    },
+    /// An alternative changes the common resolution value or timeout policy.
+    ResolutionPolicyMismatch {
+        /// Mismatching alternative.
+        index: usize,
+        /// Required common resolution value.
+        expected_value: Amount,
+        /// Supplied resolution value.
+        actual_value: Amount,
+        /// Required common CSV delay.
+        expected_timeout: u16,
+        /// Supplied CSV delay.
+        actual_timeout: u16,
+    },
+    /// Contest construction failed.
+    Contest(ContestV2Error),
+    /// Owner construction failed.
+    OwnerPayout(OwnerPayoutV2Error),
+    /// Counterproof construction failed.
+    Counterproof {
+        /// Alternative index.
+        index: usize,
+        /// Underlying constructor failure.
+        source: CounterproofV2Error,
+    },
+    /// ACK construction failed.
+    Ack {
+        /// Alternative index.
+        index: usize,
+        /// Underlying constructor failure.
+        source: CounterproofAckV2Error,
+    },
+    /// Timeout construction failed.
+    Timeout {
+        /// Alternative index.
+        index: usize,
+        /// Underlying constructor failure.
+        source: CounterproofTimeoutSettlementV2Error,
+    },
+    /// Slash construction failed.
+    Slash {
+        /// Alternative index.
+        index: usize,
+        /// Underlying constructor failure.
+        source: SlashV2Error,
+    },
+    /// A serialized template has the wrong input/output shape.
+    TransactionShape {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+        /// Required input count.
+        expected_inputs: usize,
+        /// Actual input count.
+        actual_inputs: usize,
+        /// Human-readable required output shape.
+        expected_outputs: &'static str,
+        /// Actual output count.
+        actual_outputs: usize,
+    },
+    /// A required serialized input is absent.
+    MissingInput {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+        /// Missing input index.
+        input: usize,
+    },
+    /// A serialized child input does not reference its derived parent output.
+    InternalEdgeMismatch {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+        /// Input index.
+        input: usize,
+        /// Derived expected outpoint.
+        expected: OutPoint,
+        /// Serialized actual outpoint.
+        actual: OutPoint,
+    },
+    /// Stored exact transaction bytes differ from the assembled wrapper.
+    ExactTransactionMismatch {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+    },
+    /// Stored exact-transaction roster length differs from the graph roster.
+    ExpectedAlternativeCountMismatch {
+        /// Expected exact-transaction alternatives.
+        expected: usize,
+        /// Assembled alternatives.
+        actual: usize,
+    },
+    /// Stored spender matrix differs from the recomputed exact matrix.
+    SpendMatrixMismatch,
+    /// Independent expected-value computation overflowed or underflowed.
+    ExpectedValueComputation {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+    },
+    /// Independent fee conservation check failed.
+    ExpectedFeeMismatch {
+        /// Template role.
+        template: &'static str,
+        /// Alternative index where applicable.
+        index: Option<usize>,
+        /// Expected input value.
+        input: Amount,
+        /// Serialized output value.
+        output: Amount,
+        /// Declared fee.
+        fee: Amount,
+    },
+    /// Alternative index cannot be represented by the fixed vout encoding.
+    ExpectedIndexOverflow {
+        /// Unrepresentable alternative index.
+        index: usize,
+    },
+    /// Independent Slash-header encoding failed.
+    ExpectedHeaderEncoding(String),
+}
+
+impl fmt::Display for V026GraphError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidClaimVout { actual, expected } => {
+                write!(f, "v0.26 Claim vout is {actual}, expected {expected}")
+            }
+            Self::EmptyAlternativeRoster => f.write_str("v0.26 graph alternative roster is empty"),
+            Self::ExternalOutpointAlias {
+                first_role,
+                second_role,
+                outpoint,
+            } => write!(
+                f,
+                "v0.26 external roles {first_role} and {second_role} alias {outpoint}"
+            ),
+            Self::ControllerAlias {
+                protected_role,
+                other_role,
+                alternative,
+            } => write!(
+                f,
+                "v0.26 {protected_role} controller aliases {other_role} at alternative {alternative:?}"
+            ),
+            Self::GraphKeyMismatch { index, component } => {
+                write!(f, "v0.26 {component} graph key mismatch at {index:?}")
+            }
+            Self::ReleaseRosterMismatch { index } => {
+                write!(f, "v0.26 release roster differs at alternative {index}")
+            }
+            Self::ResolutionPolicyMismatch {
+                index,
+                expected_value,
+                actual_value,
+                expected_timeout,
+                actual_timeout,
+            } => write!(
+                f,
+                "v0.26 resolution policy differs at alternative {index}: value {actual_value}/{expected_value}, timeout {actual_timeout}/{expected_timeout}"
+            ),
+            Self::Contest(error) => write!(f, "v0.26 Contest construction failed: {error}"),
+            Self::OwnerPayout(error) => {
+                write!(f, "v0.26 owner-payout construction failed: {error}")
+            }
+            Self::Counterproof { index, source } => {
+                write!(f, "v0.26 counterproof {index} construction failed: {source}")
+            }
+            Self::Ack { index, source } => {
+                write!(f, "v0.26 ACK {index} construction failed: {source}")
+            }
+            Self::Timeout { index, source } => {
+                write!(f, "v0.26 timeout {index} construction failed: {source}")
+            }
+            Self::Slash { index, source } => {
+                write!(f, "v0.26 Slash {index} construction failed: {source}")
+            }
+            Self::TransactionShape {
+                template,
+                index,
+                expected_inputs,
+                actual_inputs,
+                expected_outputs,
+                actual_outputs,
+            } => write!(
+                f,
+                "v0.26 {template} {index:?} shape mismatch: inputs {actual_inputs}/{expected_inputs}, outputs {actual_outputs}/{expected_outputs}"
+            ),
+            Self::MissingInput {
+                template,
+                index,
+                input,
+            } => write!(f, "v0.26 {template} {index:?} is missing input {input}"),
+            Self::InternalEdgeMismatch {
+                template,
+                index,
+                input,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "v0.26 {template} {index:?} input {input} references {actual}, expected {expected}"
+            ),
+            Self::ExactTransactionMismatch { template, index } => write!(
+                f,
+                "v0.26 {template} {index:?} differs from its exact assembled transaction"
+            ),
+            Self::ExpectedAlternativeCountMismatch { expected, actual } => write!(
+                f,
+                "v0.26 exact transaction roster has {expected} alternatives, graph has {actual}"
+            ),
+            Self::SpendMatrixMismatch => {
+                f.write_str("v0.26 stored spender matrix differs from the recomputed matrix")
+            }
+            Self::ExpectedValueComputation { template, index } => write!(
+                f,
+                "v0.26 independent {template} {index:?} value computation failed"
+            ),
+            Self::ExpectedFeeMismatch {
+                template,
+                index,
+                input,
+                output,
+                fee,
+            } => write!(
+                f,
+                "v0.26 independent {template} {index:?} fee check failed: input {input}, output {output}, fee {fee}"
+            ),
+            Self::ExpectedIndexOverflow { index } => write!(
+                f,
+                "v0.26 alternative index {index} overflows the fixed vout encoding"
+            ),
+            Self::ExpectedHeaderEncoding(error) => {
+                write!(f, "v0.26 independent Slash header encoding failed: {error}")
+            }
+        }
+    }
+}
+
+impl Error for V026GraphError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Contest(error) => Some(error),
+            Self::OwnerPayout(error) => Some(error),
+            Self::Counterproof { source, .. } => Some(source),
+            Self::Ack { source, .. } => Some(source),
+            Self::Timeout { source, .. } => Some(source),
+            Self::Slash { source, .. } => Some(source),
+            _ => None,
+        }
+    }
+}
