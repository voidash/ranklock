+//! Durable, local-only observation state for the research v0.26 graph.
+//!
+//! This module does not admit a graph for funding. It records only that one
+//! in-process [`V026Graph`] passed its local structural verifier while retaining
+//! every unconditional activation blocker. The transaction-id manifest is a
+//! local conflict-detection aid, not a canonical graph identity: txids do not
+//! commit witnesses, external prevout contents, or activation evidence.
+
+use std::fmt;
+
+use bitcoin::Txid;
+use serde::{Deserialize, Deserializer, Serialize, Serializer, de::Error as _};
+use strata_bridge_primitives::types::GraphIdx;
+use strata_bridge_tx_graph::v026_graph::{V026ActivationBlocker, V026Graph, V026GraphError};
+use thiserror::Error;
+
+/// Number of unconditional blockers in the frozen local v0.26 observation profile.
+pub const V026_BLOCKER_COUNT_V1: usize = 15;
+
+/// Stable persisted codes for the frozen v0.26 blocker set.
+///
+/// These values are serialized explicitly as `u16`; declaration order is not
+/// part of the storage format.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+#[repr(u16)]
+pub enum V026BlockerCodeV1 {
+    /// NUMS role/index semantics are still a research profile.
+    ResearchNumsProfile = 1,
+    /// Canonical graph/wire identity and encoding are not implemented.
+    CanonicalWireIdentityUnimplemented = 2,
+    /// Qualified proof/release cryptography evidence is absent.
+    ReleaseCryptographyEvidenceUnverified = 3,
+    /// Controller possession and domain-separation evidence is absent.
+    ControllerDomainEvidenceUnverified = 4,
+    /// The local Slash header is incompatible with the pinned parser.
+    SlashHeaderProfileIncompatible = 5,
+    /// External Claim/D/Q/K prevout evidence is absent.
+    ExternalOutputEvidenceUnverified = 6,
+    /// Fresh-D cutover and alternate-signature exclusion are absent.
+    FreshDepositEvidenceUnverified = 7,
+    /// Global K exclusivity is absent.
+    StakeExclusivityEvidenceUnverified = 8,
+    /// Complete presign and erasure evidence is absent.
+    PresignErasureEvidenceUnverified = 9,
+    /// Legacy and off-transcript material exclusion is absent.
+    LegacyMaterialExclusionUnverified = 10,
+    /// Finalized fee-policy evidence is absent.
+    FeePolicyEvidenceUnverified = 11,
+    /// The required Bitcoin Core execution matrix is incomplete.
+    BitcoinCoreExecutionEvidenceUnverified = 12,
+    /// Versioned ASM activation is absent.
+    AsmActivationEvidenceUnverified = 13,
+    /// Runtime admission remains unimplemented.
+    RuntimeAdmissionUnimplemented = 14,
+    /// Validity withholding economics remain unresolved.
+    ValidityWithholdingEconomicsUnresolved = 15,
+}
+
+/// Exact canonical order of the frozen V1 blocker codes.
+pub const V026_BLOCKERS_V1: [V026BlockerCodeV1; V026_BLOCKER_COUNT_V1] = [
+    V026BlockerCodeV1::ResearchNumsProfile,
+    V026BlockerCodeV1::CanonicalWireIdentityUnimplemented,
+    V026BlockerCodeV1::ReleaseCryptographyEvidenceUnverified,
+    V026BlockerCodeV1::ControllerDomainEvidenceUnverified,
+    V026BlockerCodeV1::SlashHeaderProfileIncompatible,
+    V026BlockerCodeV1::ExternalOutputEvidenceUnverified,
+    V026BlockerCodeV1::FreshDepositEvidenceUnverified,
+    V026BlockerCodeV1::StakeExclusivityEvidenceUnverified,
+    V026BlockerCodeV1::PresignErasureEvidenceUnverified,
+    V026BlockerCodeV1::LegacyMaterialExclusionUnverified,
+    V026BlockerCodeV1::FeePolicyEvidenceUnverified,
+    V026BlockerCodeV1::BitcoinCoreExecutionEvidenceUnverified,
+    V026BlockerCodeV1::AsmActivationEvidenceUnverified,
+    V026BlockerCodeV1::RuntimeAdmissionUnimplemented,
+    V026BlockerCodeV1::ValidityWithholdingEconomicsUnresolved,
+];
+
+impl V026BlockerCodeV1 {
+    const fn seen_index(self) -> usize {
+        self as usize - 1
+    }
+}
+
+impl TryFrom<V026ActivationBlocker> for V026BlockerCodeV1 {
+    type Error = UnsupportedV026ActivationBlockerV1;
+
+    fn try_from(value: V026ActivationBlocker) -> Result<Self, Self::Error> {
+        let code = match value {
+            V026ActivationBlocker::ResearchNumsProfile => Self::ResearchNumsProfile,
+            V026ActivationBlocker::CanonicalWireIdentityUnimplemented => {
+                Self::CanonicalWireIdentityUnimplemented
+            }
+            V026ActivationBlocker::ReleaseCryptographyEvidenceUnverified => {
+                Self::ReleaseCryptographyEvidenceUnverified
+            }
+            V026ActivationBlocker::ControllerDomainEvidenceUnverified => {
+                Self::ControllerDomainEvidenceUnverified
+            }
+            V026ActivationBlocker::SlashHeaderProfileIncompatible => {
+                Self::SlashHeaderProfileIncompatible
+            }
+            V026ActivationBlocker::ExternalOutputEvidenceUnverified => {
+                Self::ExternalOutputEvidenceUnverified
+            }
+            V026ActivationBlocker::FreshDepositEvidenceUnverified => {
+                Self::FreshDepositEvidenceUnverified
+            }
+            V026ActivationBlocker::StakeExclusivityEvidenceUnverified => {
+                Self::StakeExclusivityEvidenceUnverified
+            }
+            V026ActivationBlocker::PresignErasureEvidenceUnverified => {
+                Self::PresignErasureEvidenceUnverified
+            }
+            V026ActivationBlocker::LegacyMaterialExclusionUnverified => {
+                Self::LegacyMaterialExclusionUnverified
+            }
+            V026ActivationBlocker::FeePolicyEvidenceUnverified => Self::FeePolicyEvidenceUnverified,
+            V026ActivationBlocker::BitcoinCoreExecutionEvidenceUnverified => {
+                Self::BitcoinCoreExecutionEvidenceUnverified
+            }
+            V026ActivationBlocker::AsmActivationEvidenceUnverified => {
+                Self::AsmActivationEvidenceUnverified
+            }
+            V026ActivationBlocker::RuntimeAdmissionUnimplemented => {
+                Self::RuntimeAdmissionUnimplemented
+            }
+            V026ActivationBlocker::ValidityWithholdingEconomicsUnresolved => {
+                Self::ValidityWithholdingEconomicsUnresolved
+            }
+            V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified => {
+                return Err(UnsupportedV026ActivationBlockerV1 { blocker: value });
+            }
+        };
+        Ok(code)
+    }
+}
+
+/// A current graph blocker cannot be represented by the frozen V1 registry.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Error)]
+#[error("v0.26 blocker {blocker:?} is not representable in the frozen V1 registry")]
+pub struct UnsupportedV026ActivationBlockerV1 {
+    /// Blocker rejected by the frozen V1 registry.
+    pub blocker: V026ActivationBlocker,
+}
+
+impl TryFrom<u16> for V026BlockerCodeV1 {
+    type Error = UnknownV026BlockerCodeV1;
+
+    fn try_from(value: u16) -> Result<Self, Self::Error> {
+        let code = match value {
+            1 => Self::ResearchNumsProfile,
+            2 => Self::CanonicalWireIdentityUnimplemented,
+            3 => Self::ReleaseCryptographyEvidenceUnverified,
+            4 => Self::ControllerDomainEvidenceUnverified,
+            5 => Self::SlashHeaderProfileIncompatible,
+            6 => Self::ExternalOutputEvidenceUnverified,
+            7 => Self::FreshDepositEvidenceUnverified,
+            8 => Self::StakeExclusivityEvidenceUnverified,
+            9 => Self::PresignErasureEvidenceUnverified,
+            10 => Self::LegacyMaterialExclusionUnverified,
+            11 => Self::FeePolicyEvidenceUnverified,
+            12 => Self::BitcoinCoreExecutionEvidenceUnverified,
+            13 => Self::AsmActivationEvidenceUnverified,
+            14 => Self::RuntimeAdmissionUnimplemented,
+            15 => Self::ValidityWithholdingEconomicsUnresolved,
+            unknown => return Err(UnknownV026BlockerCodeV1 { code: unknown }),
+        };
+        Ok(code)
+    }
+}
+
+impl Serialize for V026BlockerCodeV1 {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: Serializer,
+    {
+        serializer.serialize_u16(*self as u16)
+    }
+}
+
+impl<'de> Deserialize<'de> for V026BlockerCodeV1 {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        let code = u16::deserialize(deserializer)?;
+        Self::try_from(code).map_err(D::Error::custom)
+    }
+}
+
+/// A persisted blocker code is outside the frozen V1 registry.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Error)]
+#[error("unknown v0.26 V1 blocker code {code}")]
+pub struct UnknownV026BlockerCodeV1 {
+    /// Unknown numeric code.
+    pub code: u16,
+}
+
+/// Ordered transaction IDs for one local alternative.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct V026LocalAlternativeTxidManifestV1 {
+    /// Selected counterproof parent.
+    pub counterproof: Txid,
+    /// Immediate positive-lock resolution.
+    pub ack: Txid,
+    /// CSV timeout resolution.
+    pub timeout: Txid,
+    /// ACK-gated Slash parent.
+    pub slash: Txid,
+}
+
+/// Local transaction-id manifest used only to detect replacement at one [`GraphIdx`].
+///
+/// This is deliberately not named or treated as a canonical graph digest.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct V026LocalTxidManifestV1 {
+    /// Contest parent.
+    pub contest: Txid,
+    /// No-counterproof owner parent.
+    pub owner_payout: Txid,
+    /// Alternatives in the assembler's exact order.
+    pub alternatives: Vec<V026LocalAlternativeTxidManifestV1>,
+}
+
+impl V026LocalTxidManifestV1 {
+    fn from_graph(graph: &V026Graph) -> Self {
+        Self {
+            contest: graph.contest().as_ref().compute_txid(),
+            owner_payout: graph.owner_payout().as_ref().compute_txid(),
+            alternatives: graph
+                .alternatives()
+                .iter()
+                .map(|alternative| V026LocalAlternativeTxidManifestV1 {
+                    counterproof: alternative.counterproof().as_ref().compute_txid(),
+                    ack: alternative.ack().as_ref().compute_txid(),
+                    timeout: alternative.timeout().as_ref().compute_txid(),
+                    slash: alternative.slash().as_ref().compute_txid(),
+                })
+                .collect(),
+        }
+    }
+}
+
+/// Durable local record that can only represent a funding-blocked observation.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct StructurallyVerifiedFundingBlockedV1 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV1,
+    blockers: [V026BlockerCodeV1; V026_BLOCKER_COUNT_V1],
+}
+
+impl StructurallyVerifiedFundingBlockedV1 {
+    /// Verifies and snapshots one in-process graph without admitting it.
+    pub fn observe(graph_idx: GraphIdx, graph: &V026Graph) -> Result<Self, V026ObservationError> {
+        graph
+            .verify_structure()
+            .map_err(V026ObservationError::StructuralVerification)?;
+        if graph.funding_eligible() {
+            return Err(V026ObservationError::UnexpectedFundingEligibility);
+        }
+        validate_complete_blocker_set(graph.activation_blockers())?;
+
+        Ok(Self {
+            graph_idx,
+            local_manifest: V026LocalTxidManifestV1::from_graph(graph),
+            blockers: V026_BLOCKERS_V1,
+        })
+    }
+
+    /// Logical graph key under which this local observation is persisted.
+    pub const fn graph_idx(&self) -> GraphIdx {
+        self.graph_idx
+    }
+
+    /// Ordered local transaction-id manifest.
+    pub const fn local_manifest(&self) -> &V026LocalTxidManifestV1 {
+        &self.local_manifest
+    }
+
+    /// Exact frozen blocker set retained by this record.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV1; V026_BLOCKER_COUNT_V1] {
+        &self.blockers
+    }
+
+    /// A V1 observation is unconditionally ineligible for funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Converts this live, observer-produced capability into its inert persisted view.
+    pub fn to_persisted(&self) -> PersistedFundingBlockedObservationV1 {
+        PersistedFundingBlockedObservationV1 {
+            graph_idx: self.graph_idx,
+            local_manifest: self.local_manifest.clone(),
+            blockers: self.blockers,
+        }
+    }
+
+    /// Rechecks invariants that must hold after decoding the versioned local record.
+    ///
+    /// This does not upgrade the txid manifest into canonical graph evidence.
+    pub fn validate_persisted_shape(&self) -> Result<(), V026PersistedObservationError> {
+        validate_persisted_shape(&self.local_manifest, &self.blockers)
+    }
+}
+
+/// Validated, inert read model reconstructed from the frozen V1 storage envelope.
+///
+/// Unlike [`StructurallyVerifiedFundingBlockedV1`], this type is not accepted by
+/// the database write API and therefore cannot act as a live observation
+/// capability. It exposes the same durable data and remains unconditionally
+/// funding-ineligible.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct PersistedFundingBlockedObservationV1 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV1,
+    blockers: [V026BlockerCodeV1; V026_BLOCKER_COUNT_V1],
+}
+
+impl PersistedFundingBlockedObservationV1 {
+    /// Constructs an inert read model after checking every persisted invariant.
+    pub fn try_from_parts(
+        graph_idx: GraphIdx,
+        local_manifest: V026LocalTxidManifestV1,
+        blockers: [V026BlockerCodeV1; V026_BLOCKER_COUNT_V1],
+    ) -> Result<Self, V026PersistedObservationError> {
+        validate_persisted_shape(&local_manifest, &blockers)?;
+        Ok(Self {
+            graph_idx,
+            local_manifest,
+            blockers,
+        })
+    }
+
+    /// Logical graph key encoded in the persisted body.
+    pub const fn graph_idx(&self) -> GraphIdx {
+        self.graph_idx
+    }
+
+    /// Ordered local transaction-ID manifest.
+    pub const fn local_manifest(&self) -> &V026LocalTxidManifestV1 {
+        &self.local_manifest
+    }
+
+    /// Exact frozen V1 blocker set.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV1; V026_BLOCKER_COUNT_V1] {
+        &self.blockers
+    }
+
+    /// A persisted V1 observation is unconditionally ineligible for funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Rechecks every persisted V1 shape invariant.
+    pub fn validate_persisted_shape(&self) -> Result<(), V026PersistedObservationError> {
+        validate_persisted_shape(&self.local_manifest, &self.blockers)
+    }
+}
+
+fn validate_persisted_shape(
+    local_manifest: &V026LocalTxidManifestV1,
+    blockers: &[V026BlockerCodeV1; V026_BLOCKER_COUNT_V1],
+) -> Result<(), V026PersistedObservationError> {
+    if local_manifest.alternatives.is_empty() {
+        return Err(V026PersistedObservationError::EmptyAlternativeRoster);
+    }
+    if *blockers != V026_BLOCKERS_V1 {
+        return Err(V026PersistedObservationError::BlockerSetMismatch);
+    }
+    Ok(())
+}
+
+fn validate_complete_blocker_set(
+    blockers: &[V026ActivationBlocker],
+) -> Result<(), V026ObservationError> {
+    if blockers.len() != V026_BLOCKER_COUNT_V1 {
+        return Err(V026ObservationError::BlockerCount {
+            expected: V026_BLOCKER_COUNT_V1,
+            actual: blockers.len(),
+        });
+    }
+
+    let mut seen = [false; V026_BLOCKER_COUNT_V1];
+    for blocker in blockers.iter().copied() {
+        let code = V026BlockerCodeV1::try_from(blocker)
+            .map_err(V026ObservationError::UnsupportedBlocker)?;
+        let index = code.seen_index();
+        if seen[index] {
+            return Err(V026ObservationError::DuplicateBlocker { blocker: code });
+        }
+        seen[index] = true;
+    }
+    for (index, was_seen) in seen.into_iter().enumerate() {
+        if !was_seen {
+            return Err(V026ObservationError::MissingBlocker {
+                blocker: V026_BLOCKERS_V1[index],
+            });
+        }
+    }
+    Ok(())
+}
+
+/// Failure to create a fail-closed local observation.
+#[derive(Debug, Error)]
+pub enum V026ObservationError {
+    /// The assembler's exact structural verifier failed.
+    #[error("v0.26 structural verification failed: {0}")]
+    StructuralVerification(#[source] V026GraphError),
+    /// A graph unexpectedly claimed it was eligible for funding.
+    #[error("v0.26 graph unexpectedly reported funding eligibility")]
+    UnexpectedFundingEligibility,
+    /// A current activation blocker has no code in the frozen V1 registry.
+    #[error(transparent)]
+    UnsupportedBlocker(#[from] UnsupportedV026ActivationBlockerV1),
+    /// The graph did not retain exactly the frozen number of blockers.
+    #[error("v0.26 blocker count is {actual}, expected {expected}")]
+    BlockerCount {
+        /// Required count.
+        expected: usize,
+        /// Observed count.
+        actual: usize,
+    },
+    /// One blocker occurred more than once.
+    #[error("v0.26 blocker {blocker} occurred more than once")]
+    DuplicateBlocker {
+        /// Duplicate blocker.
+        blocker: V026BlockerCodeV1,
+    },
+    /// One frozen blocker was absent.
+    #[error("v0.26 blocker {blocker} is missing")]
+    MissingBlocker {
+        /// Missing blocker.
+        blocker: V026BlockerCodeV1,
+    },
+}
+
+/// Invalid decoded shape for a supposedly frozen V1 observation.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Error)]
+pub enum V026PersistedObservationError {
+    /// A valid assembled graph always has at least one alternative.
+    #[error("persisted v0.26 observation has an empty alternative roster")]
+    EmptyAlternativeRoster,
+    /// The record does not contain the exact frozen blocker array.
+    #[error("persisted v0.26 observation does not retain the exact V1 blocker set")]
+    BlockerSetMismatch,
+}
+
+impl fmt::Display for V026BlockerCodeV1 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{:?}({})", self, *self as u16)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn blocker_codes_have_stable_numeric_registry() {
+        for (index, blocker) in V026_BLOCKERS_V1.into_iter().enumerate() {
+            let expected = u16::try_from(index + 1).expect("V1 blocker index fits u16");
+            assert_eq!(blocker as u16, expected);
+            assert_eq!(V026BlockerCodeV1::try_from(expected), Ok(blocker));
+        }
+    }
+
+    #[test]
+    fn unknown_blocker_code_fails_closed() {
+        assert!(V026BlockerCodeV1::try_from(16_u16).is_err());
+    }
+
+    #[test]
+    fn current_sixteen_blocker_profile_cannot_encode_as_v1() {
+        assert!(matches!(
+            V026BlockerCodeV1::try_from(
+                V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified
+            ),
+            Err(UnsupportedV026ActivationBlockerV1 {
+                blocker: V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified
+            })
+        ));
+
+        let current = [
+            V026ActivationBlocker::ResearchNumsProfile,
+            V026ActivationBlocker::CanonicalWireIdentityUnimplemented,
+            V026ActivationBlocker::ReleaseCryptographyEvidenceUnverified,
+            V026ActivationBlocker::ControllerDomainEvidenceUnverified,
+            V026ActivationBlocker::SlashHeaderProfileIncompatible,
+            V026ActivationBlocker::ExternalOutputEvidenceUnverified,
+            V026ActivationBlocker::FreshDepositEvidenceUnverified,
+            V026ActivationBlocker::StakeExclusivityEvidenceUnverified,
+            V026ActivationBlocker::PresignErasureEvidenceUnverified,
+            V026ActivationBlocker::LegacyMaterialExclusionUnverified,
+            V026ActivationBlocker::FeePolicyEvidenceUnverified,
+            V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified,
+            V026ActivationBlocker::BitcoinCoreExecutionEvidenceUnverified,
+            V026ActivationBlocker::AsmActivationEvidenceUnverified,
+            V026ActivationBlocker::RuntimeAdmissionUnimplemented,
+            V026ActivationBlocker::ValidityWithholdingEconomicsUnresolved,
+        ];
+        assert!(matches!(
+            validate_complete_blocker_set(&current),
+            Err(V026ObservationError::BlockerCount {
+                expected: V026_BLOCKER_COUNT_V1,
+                actual: 16
+            })
+        ));
+    }
+
+    #[test]
+    fn exact_blocker_set_is_required() {
+        let exact: Vec<_> = [
+            V026ActivationBlocker::ResearchNumsProfile,
+            V026ActivationBlocker::CanonicalWireIdentityUnimplemented,
+            V026ActivationBlocker::ReleaseCryptographyEvidenceUnverified,
+            V026ActivationBlocker::ControllerDomainEvidenceUnverified,
+            V026ActivationBlocker::SlashHeaderProfileIncompatible,
+            V026ActivationBlocker::ExternalOutputEvidenceUnverified,
+            V026ActivationBlocker::FreshDepositEvidenceUnverified,
+            V026ActivationBlocker::StakeExclusivityEvidenceUnverified,
+            V026ActivationBlocker::PresignErasureEvidenceUnverified,
+            V026ActivationBlocker::LegacyMaterialExclusionUnverified,
+            V026ActivationBlocker::FeePolicyEvidenceUnverified,
+            V026ActivationBlocker::BitcoinCoreExecutionEvidenceUnverified,
+            V026ActivationBlocker::AsmActivationEvidenceUnverified,
+            V026ActivationBlocker::RuntimeAdmissionUnimplemented,
+            V026ActivationBlocker::ValidityWithholdingEconomicsUnresolved,
+        ]
+        .into_iter()
+        .collect();
+        validate_complete_blocker_set(&exact).expect("the frozen set is complete");
+
+        let mut duplicate = exact;
+        duplicate[14] = duplicate[13];
+        assert!(matches!(
+            validate_complete_blocker_set(&duplicate),
+            Err(V026ObservationError::DuplicateBlocker { .. })
+        ));
+    }
+}
diff --git a/crates/bridge-sm/src/v026_admission_v2.rs b/crates/bridge-sm/src/v026_admission_v2.rs
