+            validate_ack_output_scripts(&script, &script),
+            Err(CounterproofAckV2Error::OutputScriptCollision)
+        ));
+    }
+
+    #[test]
+    fn rejects_nums_internal_and_output_keys_for_ack_cpfp() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let resolution = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            vec![[1u8; 32], [2u8; 32]],
+            bitcoin::relative::Height::from_height(12),
+            Amount::from_sat(1_830),
+            ResearchV0NumsContext::new([9u8; 32], ResearchV0NumsRole::CounterproofResolution, 0),
+        )
+        .unwrap();
+        let authorization = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
