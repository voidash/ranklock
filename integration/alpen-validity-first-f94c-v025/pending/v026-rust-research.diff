+use super::kv::{KVRowSpec, PackableKey, SerializableValue};
+use crate::fdb::dirs::Directories;
+
+const ENVELOPE_MAGIC: &[u8; 7] = b"RL26ADM";
+const ENVELOPE_VERSION_V2: u16 = 2;
+const ENVELOPE_HEADER_LEN: usize = ENVELOPE_MAGIC.len() + size_of::<u16>();
+
+/// Key for one V2 local observation in its own FDB subspace.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionKeyV2(GraphIdx);
+
+/// A stored V2 observation body claims a different logical key than its row.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionKeyMismatchV2 {
+    /// Graph key used to read or atomically assign the row.
+    pub expected: GraphIdx,
+    /// Graph key encoded inside the stored observation.
+    pub actual: GraphIdx,
+}
+
+impl From<GraphIdx> for V026AdmissionKeyV2 {
+    fn from(graph_idx: GraphIdx) -> Self {
+        Self(graph_idx)
+    }
+}
+
+impl From<V026AdmissionKeyV2> for GraphIdx {
+    fn from(key: V026AdmissionKeyV2) -> Self {
+        key.0
+    }
+}
+
+impl PackableKey for V026AdmissionKeyV2 {
+    type PackingError = Infallible;
+    type UnpackingError = PackError;
+    type Packed = Vec<u8>;
+
+    fn pack(&self, dirs: &Directories) -> Result<Self::Packed, Self::PackingError> {
+        Ok(dirs
+            .v026_admissions_v2
+            .pack::<(u32, u32)>(&(self.0.deposit, self.0.operator)))
+    }
+
+    fn unpack(dirs: &Directories, bytes: &[u8]) -> Result<Self, Self::UnpackingError> {
+        let (deposit, operator) = dirs.v026_admissions_v2.unpack::<(u32, u32)>(bytes)?;
+        Ok(Self(GraphIdx { deposit, operator }))
+    }
+}
+
+/// Crate-private wire body. Field order is the canonical V2 postcard layout.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct V026AdmissionBodyV2 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV2,
+    blockers: [V026BlockerCodeV2; V026_BLOCKER_COUNT_V2],
+}
+
+impl V026AdmissionBodyV2 {
+    fn from_live(observation: &StructurallyVerifiedFundingBlockedV2) -> Self {
+        Self {
+            graph_idx: observation.graph_idx(),
+            local_manifest: observation.local_manifest().clone(),
+            blockers: *observation.blockers(),
+        }
+    }
+
+    fn validate(&self) -> Result<(), V026PersistedObservationErrorV2> {
+        PersistedFundingBlockedObservationV2::try_from_parts(
+            self.graph_idx,
+            self.local_manifest.clone(),
+            self.blockers,
+        )
+        .map(|_observation| ())
+    }
+
+    fn try_into_persisted(
+        self,
+    ) -> Result<PersistedFundingBlockedObservationV2, V026PersistedObservationErrorV2> {
+        PersistedFundingBlockedObservationV2::try_from_parts(
+            self.graph_idx,
+            self.local_manifest,
+            self.blockers,
+        )
+    }
+}
+
+/// V2 value wrapper with the shared magic and a distinct schema version.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionValueV2(V026AdmissionBodyV2);
+
+impl V026AdmissionValueV2 {
+    pub(crate) fn from_live(observation: &StructurallyVerifiedFundingBlockedV2) -> Self {
+        Self(V026AdmissionBodyV2::from_live(observation))
+    }
+
+    pub(crate) fn try_into_persisted(
+        self,
+    ) -> Result<PersistedFundingBlockedObservationV2, V026PersistedObservationErrorV2> {
+        self.0.try_into_persisted()
+    }
+}
+
+impl SerializableValue for V026AdmissionValueV2 {
+    type SerializeError = V026AdmissionSerializeErrorV2;
+    type DeserializeError = V026AdmissionDeserializeErrorV2;
+    type Serialized = Vec<u8>;
+
+    fn serialize(&self) -> Result<Self::Serialized, Self::SerializeError> {
+        self.0
+            .validate()
+            .map_err(V026AdmissionSerializeErrorV2::InvalidRecord)?;
+        let body =
+            postcard::to_allocvec(&self.0).map_err(V026AdmissionSerializeErrorV2::Postcard)?;
+        let mut encoded = Vec::with_capacity(ENVELOPE_HEADER_LEN + body.len());
+        encoded.extend_from_slice(ENVELOPE_MAGIC);
+        encoded.extend_from_slice(&ENVELOPE_VERSION_V2.to_le_bytes());
+        encoded.extend_from_slice(&body);
+        Ok(encoded)
+    }
+
+    fn deserialize(bytes: &[u8]) -> Result<Self, Self::DeserializeError> {
+        if bytes.len() < ENVELOPE_HEADER_LEN {
+            return Err(V026AdmissionDeserializeErrorV2::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            });
+        }
+        let (magic, version_and_body) = bytes.split_at(ENVELOPE_MAGIC.len());
+        if magic != ENVELOPE_MAGIC {
+            return Err(V026AdmissionDeserializeErrorV2::InvalidMagic);
+        }
+        let (version_bytes, body) = version_and_body.split_at(size_of::<u16>());
+        let version = u16::from_le_bytes(version_bytes.try_into().map_err(|_| {
+            V026AdmissionDeserializeErrorV2::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            }
+        })?);
+        if version != ENVELOPE_VERSION_V2 {
+            return Err(V026AdmissionDeserializeErrorV2::UnsupportedVersion { version });
+        }
+        let (record, trailing) = postcard::take_from_bytes::<V026AdmissionBodyV2>(body)
+            .map_err(V026AdmissionDeserializeErrorV2::Postcard)?;
+        if !trailing.is_empty() {
+            return Err(V026AdmissionDeserializeErrorV2::TrailingBytes {
+                count: trailing.len(),
+            });
+        }
+        record
+            .validate()
+            .map_err(V026AdmissionDeserializeErrorV2::InvalidRecord)?;
+        let canonical_body = postcard::to_allocvec(&record)
+            .map_err(V026AdmissionDeserializeErrorV2::CanonicalReencode)?;
+        if canonical_body != body {
+            return Err(V026AdmissionDeserializeErrorV2::NonCanonicalBody);
+        }
+        Ok(Self(record))
+    }
+}
+
+/// Serialization failure for a V2 local observation envelope.
+#[derive(Debug)]
+pub(crate) enum V026AdmissionSerializeErrorV2 {
+    /// The value does not satisfy the V2 blocked-record invariants.
+    InvalidRecord(V026PersistedObservationErrorV2),
+    /// The V2 body failed to serialize.
+    Postcard(postcard::Error),
+}
+
+impl fmt::Display for V026AdmissionSerializeErrorV2 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V2 record: {error}"),
+            Self::Postcard(error) => write!(f, "failed to serialize v0.26 V2 body: {error}"),
+        }
+    }
+}
+
+impl Error for V026AdmissionSerializeErrorV2 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::Postcard(error) => Some(error),
+        }
+    }
+}
+
+/// Strict decode failure for a V2 local observation envelope.
+#[derive(Debug)]
+pub(crate) enum V026AdmissionDeserializeErrorV2 {
+    /// The envelope ended before the complete fixed header.
+    UnexpectedEof {
+        /// Minimum required bytes.
+        expected_at_least: usize,
+        /// Available bytes.
+        actual: usize,
+    },
+    /// The row does not belong to the observation envelope family.
+    InvalidMagic,
+    /// This decoder only accepts V2 bodies.
+    UnsupportedVersion {
+        /// Rejected version.
+        version: u16,
+    },
+    /// The decoded value does not satisfy the V2 blocked-record invariants.
+    InvalidRecord(V026PersistedObservationErrorV2),
+    /// The V2 body failed to decode.
+    Postcard(postcard::Error),
+    /// A decoded body could not be canonically re-encoded.
+    CanonicalReencode(postcard::Error),
+    /// The body decoded but was not the one canonical postcard encoding.
+    NonCanonicalBody,
+    /// Bytes remained after the one exact V2 body.
+    TrailingBytes {
+        /// Number of unconsumed bytes.
+        count: usize,
+    },
+}
+
+impl fmt::Display for V026AdmissionDeserializeErrorV2 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnexpectedEof {
+                expected_at_least,
+                actual,
+            } => write!(
+                f,
+                "v0.26 V2 observation envelope has {actual} bytes, expected at least {expected_at_least}"
+            ),
+            Self::InvalidMagic => f.write_str("invalid v0.26 observation envelope magic"),
+            Self::UnsupportedVersion { version } => {
+                write!(
+                    f,
+                    "unsupported v0.26 V2 observation envelope version {version}"
+                )
+            }
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V2 record: {error}"),
+            Self::Postcard(error) => write!(f, "failed to decode v0.26 V2 body: {error}"),
+            Self::CanonicalReencode(error) => {
+                write!(f, "failed to re-encode canonical v0.26 V2 body: {error}")
+            }
+            Self::NonCanonicalBody => {
+                f.write_str("v0.26 V2 observation body is not canonically encoded")
+            }
+            Self::TrailingBytes { count } => {
+                write!(
+                    f,
+                    "v0.26 V2 observation envelope has {count} trailing bytes"
+                )
+            }
+        }
+    }
+}
+
+impl Error for V026AdmissionDeserializeErrorV2 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::Postcard(error) | Self::CanonicalReencode(error) => Some(error),
+            Self::UnexpectedEof { .. }
+            | Self::InvalidMagic
+            | Self::UnsupportedVersion { .. }
+            | Self::NonCanonicalBody
+            | Self::TrailingBytes { .. } => None,
+        }
+    }
+}
+
+/// ZST for the separate V2 observation row family.
+#[derive(Debug)]
+pub(crate) struct V026AdmissionRowSpecV2;
+
+impl KVRowSpec for V026AdmissionRowSpecV2 {
+    type Key = V026AdmissionKeyV2;
+    type Value = V026AdmissionValueV2;
+}
