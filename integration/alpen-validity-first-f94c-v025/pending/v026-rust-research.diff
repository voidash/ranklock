+            SLASH_DELAY,
+            large_value,
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::ContestSlashGate,
+                1,
+            ),
+        )
+        .unwrap();
+        let mut aggregate_plan = fixture.output_plan();
+        aggregate_plan.payout_gate = large_payout;
+        aggregate_plan.slash_gate = large_slash;
+        let oversized_aggregate =
+            ContestV2Tx::new(fixture.data, fixture.claim.clone(), aggregate_plan);
+        assert!(matches!(
+            oversized_aggregate,
+            Err(ContestV2Error::AggregateValueAboveMaxMoney {
+                aggregate: ValueAggregate::Outputs,
+                ..
+            })
+        ));
+
+        let oversized_claim = ClaimContestConnector::new(
+            Network::Regtest,
+            fixture.graph_keypair.x_only_public_key().0,
+            fixture.cpfp_keys.clone(),
+            OWNER_DELAY,
+            Amount::MAX_MONEY,
+        );
+        let oversized_prevout =
+            ContestV2Tx::new(fixture.data, oversized_claim, fixture.output_plan());
+        assert!(matches!(
+            oversized_prevout,
+            Err(ContestV2Error::ValueAboveMaxMoney { .. })
+        ));
+    }
+
+    #[test]
+    fn rejects_nums_internal_and_output_keys_for_multi_anchor() {
+        let fixture = Fixture::new();
+        let mut nums_keys = Vec::new();
+        nums_keys.extend(known_nums_keys("P", &fixture.payout));
+        nums_keys.extend(known_nums_keys("S", &fixture.slash));
+        for counterproof in &fixture.counterproofs {
+            nums_keys.extend(known_nums_keys("C", counterproof));
+        }
+        for nums in nums_keys {
+            let mut plan = fixture.output_plan();
+            plan.alternatives[0].cpfp_pubkey = nums.key;
+            let result = ContestV2Tx::new(fixture.data, fixture.claim.clone(), plan);
+            assert!(matches!(
+                result,
+                Err(ContestV2Error::CpfpNumsKeyAlias { index: 0, .. })
+            ));
+        }
+    }
+
+    #[test]
+    fn finalized_v2_contest_is_accepted_by_core() {
+        let mut fixture = Fixture::new();
+        let mut node = BitcoinNode::new();
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                fixture.claim.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - fixture.claim.value() - FUNDING_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        fixture.data.claim_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+
+        let contest = fixture.build().unwrap();
+        let signing_info = contest.signing_info(0).unwrap();
+        let graph_signature = signing_info.sign(&fixture.graph_keypair);
+        let watchtower_signature = signing_info.sign(&fixture.watchtower_keypairs[0]);
+        let tx = contest
+            .finalize(graph_signature, 0, watchtower_signature)
+            .unwrap();
+
+        node.client().send_raw_transaction(&tx).unwrap();
+    }
+}
diff --git a/crates/tx-graph/src/transactions/counterproof_ack_v2.rs b/crates/tx-graph/src/transactions/counterproof_ack_v2.rs
