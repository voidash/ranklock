+            .is_err());
+        timeout_node.mine_blocks(1);
+        timeout_node
+            .client()
+            .send_raw_transaction(&timeout_tx)
+            .expect("Core accepts timeout at the first valid CSV boundary");
+        timeout_node.mine_blocks(1);
+
+        let late_ack = timeout_graph.alternatives()[0].ack().clone();
+        let late_ack_signing = late_ack.signing_info();
+        let late_ack_tx = late_ack
+            .finalize(
+                timeout_keys.release_preimages,
+                [late_ack_signing[0].sign(&timeout_keys.graph)],
+            )
+            .expect("valid late ACK witness");
+        assert!(timeout_node
+            .client()
+            .send_raw_transaction(&late_ack_tx)
+            .is_err());
+
+        let (mut ack_node, ack_graph, ack_keys) = confirmed_selected_graph(0);
+        let ack = ack_graph.alternatives()[0].ack().clone();
+        let ack_signing = ack.signing_info();
+        let ack_tx = ack
+            .finalize(
+                ack_keys.release_preimages,
+                [ack_signing[0].sign(&ack_keys.graph)],
+            )
+            .expect("valid ACK witness");
+        ack_node
+            .client()
+            .send_raw_transaction(&ack_tx)
+            .expect("Core accepts immediate ACK");
+        ack_node.mine_blocks(1);
+
+        let ack_timeout_delay = usize::from(
+            ack_graph.alternatives()[0]
+                .counterproof()
+                .resolution_connector()
+                .timeout_delay()
+                .value(),
+        );
+        ack_node.mine_blocks(ack_timeout_delay);
+
+        let losing_timeout = ack_graph.alternatives()[0].timeout().clone();
+        let losing_timeout_signing = losing_timeout.signing_info();
+        let losing_timeout_tx = losing_timeout
+            .finalize([
+                losing_timeout_signing[0].sign(&ack_keys.graph),
+                losing_timeout_signing[1].sign(&ack_keys.graph),
+            ])
+            .expect("valid losing timeout witnesses");
+        assert!(ack_node
+            .client()
+            .send_raw_transaction(&losing_timeout_tx)
+            .is_err());
+    }
+
+    #[test]
+    fn core_slash_requires_ack_created_authorization_and_k_is_not_exclusive() {
+        let (mut slash_node, slash_graph, slash_keys, ack_txid) = confirmed_ack_graph();
+        let slash = slash_graph.alternatives()[0].slash().clone();
+        assert_eq!(
+            slash.as_ref().input[0].previous_output,
+            OutPoint::new(ack_txid, CounterproofAckV2Tx::SLASH_AUTHORIZATION_VOUT)
+        );
+        assert_eq!(
+            slash.as_ref().input[1].previous_output,
+            OutPoint::new(
+                slash_graph.contest().as_ref().compute_txid(),
+                ContestV2Tx::SLASH_GATE_VOUT
+            )
+        );
+        let slash_signing = slash.signing_info();
+        let slash_tx = slash
+            .finalize([
+                slash_signing[0].sign(&slash_keys.graph),
+                slash_signing[1].sign(&slash_keys.graph),
+                slash_signing[2].sign(&slash_keys.stake),
+            ])
+            .expect("valid Slash witnesses");
+        assert!(slash_node.client().send_raw_transaction(&slash_tx).is_err());
+        slash_node.mine_blocks(15);
+        slash_node
+            .client()
+            .send_raw_transaction(&slash_tx)
+            .expect("Core accepts ACK-descended Slash after S maturity");
+        slash_node.mine_blocks(1);
+
+        let (mut conflict_node, conflict_graph, conflict_keys, _) = confirmed_ack_graph();
+        conflict_node.mine_blocks(15);
+        let competing_fee = Amount::from_sat(500);
+        let mut competing_k = Transaction {
+            version: transaction::Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([conflict_graph.stake_outpoint]),
+            output: vec![TxOut {
+                value: conflict_keys
+                    .stake_connector
+                    .value()
+                    .checked_sub(competing_fee)
+                    .expect("stake funds competing spend"),
+                script_pubkey: conflict_node.wallet_address().script_pubkey(),
+            }],
+        };
+        competing_k.input[0].sequence = conflict_keys.stake_connector.sequence(NOfNSpend);
+        let prevouts = [conflict_keys.stake_connector.tx_out()];
+        let mut cache = SighashCache::new(&competing_k);
+        let signing = conflict_keys.stake_connector.get_signing_info(
+            &mut cache,
+            Prevouts::All(&prevouts),
+            NOfNSpend,
+            0,
+        );
+        let mut psbt = Psbt::from_unsigned_tx(competing_k).expect("valid competing K PSBT");
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        conflict_keys
+            .stake_connector
+            .finalize_input(&mut psbt.inputs[0], &signing.sign(&conflict_keys.stake));
+        let competing_k = psbt.extract_tx().expect("complete competing K transaction");
+        conflict_node
+            .client()
+            .send_raw_transaction(&competing_k)
+            .expect("Core accepts competing live-key K spend");
+        conflict_node.mine_blocks(1);
+
+        let losing_slash = conflict_graph.alternatives()[0].slash().clone();
+        let losing_signing = losing_slash.signing_info();
+        let losing_slash_tx = losing_slash
+            .finalize([
+                losing_signing[0].sign(&conflict_keys.graph),
+                losing_signing[1].sign(&conflict_keys.graph),
+                losing_signing[2].sign(&conflict_keys.stake),
+            ])
+            .expect("valid but K-conflicted Slash witnesses");
+        assert!(conflict_node
+            .client()
+            .send_raw_transaction(&losing_slash_tx)
+            .is_err());
+        assert!(conflict_graph
+            .activation_blockers()
+            .contains(&V026ActivationBlocker::StakeExclusivityEvidenceUnverified));
+    }
