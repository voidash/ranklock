+        let signer = PayoutGateSigner::generate();
+        let connector = signer.get_connector();
+        let outpoint = fund_connector(&mut node, &connector);
+        let (tx, prevouts) = spending_template(
+            &mut node,
+            &connector,
+            outpoint,
+            ContestPayoutGateSpendPathV2::OwnerPayout,
+        );
+
+        let mut key_cache = SighashCache::new(&tx);
+        let key_message = create_key_spend_hash(
+            &mut key_cache,
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .unwrap();
+        let graph_key_signature = signer.graph_keypair.sign_schnorr(key_message);
+        let mut key_path_attempt = node.sign(&tx);
+        key_path_attempt.input[0].witness = Witness::from_slice(&[graph_key_signature.serialize()]);
+        assert!(node
+            .client()
+            .send_raw_transaction(&key_path_attempt)
+            .is_err());
+
+        let delayed = finalize_script_spend(
+            &node,
+            tx,
+            &prevouts,
+            &connector,
+            &signer.graph_keypair,
+            ContestPayoutGateSpendPathV2::OwnerPayout,
+        );
+        assert!(node.client().send_raw_transaction(&delayed).is_err());
+        node.mine_blocks(OWNER_DELAY.value() as usize - 2);
+        assert!(node.client().send_raw_transaction(&delayed).is_err());
+        node.mine_blocks(1);
+        assert!(node.client().send_raw_transaction(&delayed).is_ok());
+    }
+}
diff --git a/crates/connectors/src/contest_slash_gate_v2.rs b/crates/connectors/src/contest_slash_gate_v2.rs
new file mode 100644
index 00000000..ca988ea5
--- /dev/null
+++ b/crates/connectors/src/contest_slash_gate_v2.rs
@@ -0,0 +1,481 @@
+//! Draft v0.26 shared timeout/Slash conflict gate.
+//!
+//! Timeout settlement and owner payout use the immediate settlement leaf.
+//! Slash uses the competing CSV-delayed leaf.  Both are script-only graph-
+//! signature paths under a caller-bound research NUMS key.  CHECKSIG is not a
+//! covenant, so complete exact presigning and one-honest key erasure remain
+//! mandatory before funding.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{opcodes, relative, script, Amount, Network, ScriptBuf, Sequence};
+use secp256k1::{schnorr, XOnlyPublicKey};
+
+use crate::{
+    ranklock_nums::{NumsDerivationError, ResearchV0NumsContext, ResearchV0NumsRole},
+    Connector, TaprootWitness,
+};
+
+/// Shared S output consumed immediately by settlement or after CSV by Slash.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ContestSlashGateV2 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    slash_delay: relative::Height,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl ContestSlashGateV2 {
+    /// Constructs a research-profile slash gate and rejects malformed policy.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        slash_delay: relative::Height,
+        value: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, ContestSlashGateErrorV2> {
+        if slash_delay.value() == 0 {
+            return Err(ContestSlashGateErrorV2::ZeroSlashDelay);
+        }
+        if value > Amount::MAX_MONEY {
+            return Err(ContestSlashGateErrorV2::ValueAboveMaxMoney { value });
+        }
+        if nums_context.role() != ResearchV0NumsRole::ContestSlashGate {
+            return Err(ContestSlashGateErrorV2::WrongNumsRole);
+        }
+        let internal_key = nums_context
+            .derive_internal_key()
+            .map_err(ContestSlashGateErrorV2::NumsDerivation)?;
+        let connector = Self {
+            network,
+            graph_pubkey,
+            slash_delay,
+            value,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if graph_pubkey == internal_key || graph_pubkey == output_key {
+            return Err(ContestSlashGateErrorV2::GraphNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if value < minimum {
+            return Err(ContestSlashGateErrorV2::DustValue { value, minimum });
+        }
+        Ok(connector)
+    }
+
+    /// CSV delay of the Slash branch.
+    pub const fn slash_delay(&self) -> relative::Height {
+        self.slash_delay
+    }
+
+    /// Returns the graph key controlling both exact Slash-gate script paths.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    fn settlement_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+
+    fn slash_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_sequence(Sequence::from_height(self.slash_delay.value()))
+            .push_opcode(opcodes::all::OP_CSV)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
+
+impl Connector for ContestSlashGateV2 {
+    type SpendPath = ContestSlashGateSpendPathV2;
+    type Witness = ContestSlashGateWitnessV2;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.settlement_script(), self.slash_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, spend_path: Self::SpendPath) -> Option<usize> {
+        Some(match spend_path {
+            ContestSlashGateSpendPathV2::Settlement => 0,
+            ContestSlashGateSpendPathV2::Slash => 1,
+        })
+    }
+
+    fn sequence(&self, spend_path: Self::SpendPath) -> Sequence {
+        match spend_path {
+            ContestSlashGateSpendPathV2::Settlement => Sequence::MAX,
+            ContestSlashGateSpendPathV2::Slash => Sequence::from_height(self.slash_delay.value()),
+        }
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        let (leaf_index, graph_signature) = match witness {
+            ContestSlashGateWitnessV2::Settlement { graph_signature } => (0, graph_signature),
+            ContestSlashGateWitnessV2::Slash { graph_signature } => (1, graph_signature),
+        };
+        TaprootWitness::Script {
+            leaf_index,
+            script_inputs: vec![graph_signature.serialize().to_vec()],
+        }
+    }
+}
+
+/// Authorized leaves of [`ContestSlashGateV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ContestSlashGateSpendPathV2 {
+    /// Immediate exact timeout-settlement or owner-payout parent.
+    Settlement,
+    /// CSV-delayed exact Slash parent.
+    Slash,
+}
+
+/// Witnesses for [`ContestSlashGateV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ContestSlashGateWitnessV2 {
+    /// Exact graph signature for an immediate settlement parent.
+    Settlement {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+    /// Exact graph signature for a delayed Slash parent.
+    Slash {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+}
+
+/// Invalid v2 slash-gate policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ContestSlashGateErrorV2 {
+    /// CSV must not be disabled.
+    ZeroSlashDelay,
+    /// A different output role was supplied to the NUMS derivation.
+    WrongNumsRole,
+    /// The connector value exceeds Bitcoin's consensus money range.
+    ValueAboveMaxMoney {
+        /// Value supplied by the caller.
+        value: Amount,
+    },
+    /// The NUMS point could not be reconstructed.
+    NumsDerivation(NumsDerivationError),
+    /// Graph authorization aliases the connector's unspendable NUMS key domain.
+    GraphNumsKeyAlias,
+    /// The value is below the connector's actual script-dependent dust floor.
+    DustValue {
+        /// Value supplied by the caller.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for ContestSlashGateErrorV2 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ZeroSlashDelay => f.write_str("slash-gate delay must be positive"),
+            Self::WrongNumsRole => f.write_str("slash gate was given the wrong draft NUMS role"),
+            Self::ValueAboveMaxMoney { value } => {
+                write!(f, "slash-gate value {value} exceeds MAX_MONEY")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::GraphNumsKeyAlias => {
+                f.write_str("slash-gate graph key aliases its NUMS internal/output key")
+            }
+            Self::DustValue { value, minimum } => {
+                write!(
+                    f,
+                    "slash-gate value {value} is below its dust floor {minimum}"
+                )
+            }
+        }
+    }
+}
+
+impl Error for ContestSlashGateErrorV2 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::NumsDerivation(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use bitcoin::{
+        absolute,
+        sighash::{Prevouts, SighashCache},
+        transaction, OutPoint, Psbt, TapSighashType, Transaction, TxIn, TxOut, Witness,
+    };
+    use secp256k1::{rand::thread_rng, Keypair, SECP256K1};
+    use strata_bridge_primitives::scripts::prelude::{create_key_spend_hash, create_tx_ins};
+    use strata_bridge_test_utils::prelude::generate_keypair;
+
+    use super::*;
+    use crate::{
+        test_utils::{BitcoinNode, Signer},
+        SigningInfo,
+    };
+
+    const SETUP_INTENT_DIGEST: [u8; 32] = [0x57; 32];
+    const SLASH_DELAY: relative::Height = relative::Height::from_height(5);
+    const CONNECTOR_VALUE: Amount = Amount::from_sat(100_000);
+    const TEST_FEE: Amount = Amount::from_sat(1_000);
+
+    struct SlashGateSigner {
+        graph_keypair: Keypair,
+    }
+
+    impl Signer for SlashGateSigner {
+        type Connector = ContestSlashGateV2;
+
+        fn generate() -> Self {
+            Self {
+                graph_keypair: generate_keypair(),
+            }
+        }
+
+        fn get_connector(&self) -> Self::Connector {
+            connector(self.graph_keypair.x_only_public_key().0).unwrap()
+        }
+
+        fn get_connector_name(&self) -> &'static str {
+            "contest-slash-gate-v2"
+        }
+
+        fn sign_leaf(
+            &self,
+            spend_path: ContestSlashGateSpendPathV2,
+            signing_info: SigningInfo,
+        ) -> ContestSlashGateWitnessV2 {
+            let graph_signature = signing_info.sign(&self.graph_keypair);
+            match spend_path {
+                ContestSlashGateSpendPathV2::Settlement => {
+                    ContestSlashGateWitnessV2::Settlement { graph_signature }
+                }
+                ContestSlashGateSpendPathV2::Slash => {
+                    ContestSlashGateWitnessV2::Slash { graph_signature }
+                }
+            }
+        }
+    }
+
+    fn connector(
+        graph_pubkey: XOnlyPublicKey,
+    ) -> Result<ContestSlashGateV2, ContestSlashGateErrorV2> {
+        ContestSlashGateV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            SLASH_DELAY,
+            CONNECTOR_VALUE,
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::ContestSlashGate,
+                2,
+            ),
+        )
+    }
+
+    fn fund_connector(node: &mut BitcoinNode, connector: &ContestSlashGateV2) -> OutPoint {
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - TEST_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+        OutPoint::new(txid, 0)
+    }
+
+    fn spending_template(
+        node: &mut BitcoinNode,
+        connector: &ContestSlashGateV2,
+        connector_outpoint: OutPoint,
+        path: ContestSlashGateSpendPathV2,
+    ) -> (Transaction, [TxOut; 2]) {
+        let tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![
+                TxIn {
+                    previous_output: connector_outpoint,
+                    sequence: connector.sequence(path),
+                    ..Default::default()
+                },
+                TxIn {
+                    previous_output: node.next_coinbase_outpoint(),
+                    ..Default::default()
+                },
+            ],
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - TEST_FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let prevouts = [connector.tx_out(), node.coinbase_tx_out()];
+        (tx, prevouts)
+    }
+
+    fn finalize_script_spend(
+        node: &BitcoinNode,
+        tx: Transaction,
+        prevouts: &[TxOut; 2],
+        connector: &ContestSlashGateV2,
+        keypair: &Keypair,
+        path: ContestSlashGateSpendPathV2,
+    ) -> Transaction {
+        let mut cache = SighashCache::new(&tx);
+        let signature = connector
+            .get_signing_info(&mut cache, Prevouts::All(prevouts), path, 0)
+            .sign(keypair);
+        let witness = match path {
+            ContestSlashGateSpendPathV2::Settlement => ContestSlashGateWitnessV2::Settlement {
+                graph_signature: signature,
+            },
+            ContestSlashGateSpendPathV2::Slash => ContestSlashGateWitnessV2::Slash {
+                graph_signature: signature,
+            },
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+        connector.finalize_input(&mut psbt.inputs[0], &witness);
+        node.sign(&psbt.extract_tx().unwrap())
+    }
+
+    #[test]
+    fn both_declared_leaves_are_accepted_by_core() {
+        SlashGateSigner::assert_connector_is_spendable(ContestSlashGateSpendPathV2::Settlement);
+        SlashGateSigner::assert_connector_is_spendable(ContestSlashGateSpendPathV2::Slash);
+    }
+
+    #[test]
+    fn rejects_zero_delay_wrong_role_and_dust() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let context = |role| ResearchV0NumsContext::new(SETUP_INTENT_DIGEST, role, 2);
+        assert!(matches!(
+            ContestSlashGateV2::new(
+                Network::Regtest,
+                graph_pubkey,
+                relative::Height::ZERO,
+                CONNECTOR_VALUE,
+                context(ResearchV0NumsRole::ContestSlashGate),
+            ),
+            Err(ContestSlashGateErrorV2::ZeroSlashDelay)
+        ));
+        assert!(matches!(
+            ContestSlashGateV2::new(
+                Network::Regtest,
+                graph_pubkey,
+                SLASH_DELAY,
+                CONNECTOR_VALUE,
+                context(ResearchV0NumsRole::ContestPayoutGate),
+            ),
+            Err(ContestSlashGateErrorV2::WrongNumsRole)
+        ));
+        assert!(matches!(
+            ContestSlashGateV2::new(
+                Network::Regtest,
+                graph_pubkey,
+                SLASH_DELAY,
+                Amount::ZERO,
+                context(ResearchV0NumsRole::ContestSlashGate),
+            ),
+            Err(ContestSlashGateErrorV2::DustValue { .. })
+        ));
+        assert!(matches!(
+            ContestSlashGateV2::new(
+                Network::Regtest,
+                graph_pubkey,
+                SLASH_DELAY,
+                Amount::from_sat(Amount::MAX_MONEY.to_sat() + 1),
+                context(ResearchV0NumsRole::ContestSlashGate),
+            ),
+            Err(ContestSlashGateErrorV2::ValueAboveMaxMoney { .. })
+        ));
+
+        let nums_context = context(ResearchV0NumsRole::ContestSlashGate);
+        let nums_key = nums_context.derive_internal_key().unwrap();
+        assert!(matches!(
+            ContestSlashGateV2::new(
+                Network::Regtest,
+                nums_key,
+                SLASH_DELAY,
+                CONNECTOR_VALUE,
+                nums_context,
+            ),
+            Err(ContestSlashGateErrorV2::GraphNumsKeyAlias)
+        ));
+    }
+
+    #[test]
+    fn slash_csv_boundary_and_graph_key_path_rejection_are_core_backed() {
+        let mut node = BitcoinNode::new();
+        let signer = SlashGateSigner::generate();
+        let connector = signer.get_connector();
+        let outpoint = fund_connector(&mut node, &connector);
+        let (tx, prevouts) = spending_template(
+            &mut node,
+            &connector,
+            outpoint,
+            ContestSlashGateSpendPathV2::Slash,
+        );
+
+        let mut key_cache = SighashCache::new(&tx);
+        let key_message = create_key_spend_hash(
+            &mut key_cache,
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .unwrap();
+        let graph_key_signature = signer.graph_keypair.sign_schnorr(key_message);
+        let mut key_path_attempt = node.sign(&tx);
+        key_path_attempt.input[0].witness = Witness::from_slice(&[graph_key_signature.serialize()]);
+        assert!(node
+            .client()
+            .send_raw_transaction(&key_path_attempt)
+            .is_err());
+
+        let delayed = finalize_script_spend(
+            &node,
+            tx,
+            &prevouts,
+            &connector,
+            &signer.graph_keypair,
+            ContestSlashGateSpendPathV2::Slash,
+        );
+        assert!(node.client().send_raw_transaction(&delayed).is_err());
+        node.mine_blocks(SLASH_DELAY.value() as usize - 2);
+        assert!(node.client().send_raw_transaction(&delayed).is_err());
+        node.mine_blocks(1);
+        assert!(node.client().send_raw_transaction(&delayed).is_ok());
+    }
+}
diff --git a/crates/connectors/src/counterproof_resolution_v2.rs b/crates/connectors/src/counterproof_resolution_v2.rs
new file mode 100644
index 00000000..963e6d42
--- /dev/null
+++ b/crates/connectors/src/counterproof_resolution_v2.rs
@@ -0,0 +1,653 @@
+//! Draft v0.26 connector for the ACK/timeout resolution race.
+//!
+//! The immediate leaf requires the exact ordered vector of 2..=64 distinct
+//! 32-byte preimages plus the exact-parent graph signature.  The competing
+//! leaf requires CSV maturity and its own exact-parent graph signature.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    hashes::{sha256, Hash},
+    opcodes, relative, script, Amount, Network, ScriptBuf, Sequence,
+};
+use secp256k1::{schnorr, XOnlyPublicKey};
+
+use crate::{
+    ranklock_nums::{NumsDerivationError, ResearchV0NumsContext, ResearchV0NumsRole},
+    Connector, TaprootWitness,
+};
+
+/// Minimum number of independent release participants in the v0.26 baseline.
+pub const MIN_ACK_PREIMAGES: usize = 2;
+/// Wire and standardness bound for the ordered release vector.
+pub const MAX_ACK_PREIMAGES: usize = 64;
+
+/// Script-only output shared by the immediate `ACKV2` and CSV timeout parents.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofResolutionConnectorV2 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    ack_preimage_hashes: Vec<[u8; 32]>,
+    timeout_delay: relative::Height,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl CounterproofResolutionConnectorV2 {
+    /// Constructs a research-profile connector and rejects malformed policy.
+    ///
+    /// The supplied NUMS context must carry the draft resolution role.  Its
+    /// role-byte registry is explicitly funding-ineligible until the v0.26
+    /// wire profile freezes authoritative values.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        ack_preimage_hashes: Vec<[u8; 32]>,
+        timeout_delay: relative::Height,
+        value: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, CounterproofResolutionError> {
+        if !(MIN_ACK_PREIMAGES..=MAX_ACK_PREIMAGES).contains(&ack_preimage_hashes.len()) {
+            return Err(CounterproofResolutionError::InvalidPreimageCount {
+                actual: ack_preimage_hashes.len(),
+            });
+        }
+        for (index, digest) in ack_preimage_hashes.iter().enumerate() {
+            if ack_preimage_hashes[..index].contains(digest) {
+                return Err(CounterproofResolutionError::DuplicatePreimageHash { index });
+            }
+        }
+        if timeout_delay.value() == 0 {
+            return Err(CounterproofResolutionError::ZeroTimeoutDelay);
+        }
+        if value > Amount::MAX_MONEY {
+            return Err(CounterproofResolutionError::ValueAboveMaxMoney { value });
+        }
+        if nums_context.role() != ResearchV0NumsRole::CounterproofResolution {
+            return Err(CounterproofResolutionError::WrongNumsRole);
+        }
+        let internal_key = nums_context
+            .derive_internal_key()
+            .map_err(CounterproofResolutionError::NumsDerivation)?;
+
+        let connector = Self {
+            network,
+            graph_pubkey,
+            ack_preimage_hashes,
+            timeout_delay,
+            value,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if graph_pubkey == internal_key || graph_pubkey == output_key {
+            return Err(CounterproofResolutionError::GraphNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if value < minimum {
+            return Err(CounterproofResolutionError::DustValue { value, minimum });
+        }
+        Ok(connector)
+    }
+
+    /// Ordered hashes committed by the immediate ACK leaf.
+    pub fn ack_preimage_hashes(&self) -> &[[u8; 32]] {
+        &self.ack_preimage_hashes
+    }
+
+    /// Returns the graph key controlling both exact resolution script paths.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    /// CSV delay of the timeout-settlement path.
+    pub const fn timeout_delay(&self) -> relative::Height {
+        self.timeout_delay
+    }
+
+    /// Checks the off-chain vector before constructing an ACK witness.
+    pub fn accepts_ordered_preimages(&self, preimages: &[[u8; 32]]) -> bool {
+        preimages.len() == self.ack_preimage_hashes.len()
+            && preimages
+                .iter()
+                .zip(&self.ack_preimage_hashes)
+                .all(|(preimage, expected)| {
+                    sha256::Hash::hash(preimage).to_byte_array() == *expected
+                })
+    }
+
+    fn ack_script(&self) -> ScriptBuf {
+        let mut builder = script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIGVERIFY);
+
+        // Witness stack: [k_0, ..., k_(n-1), signature].  CHECKSIGVERIFY
+        // consumes the signature.  The remaining top item is k_(n-1), so the
+        // commitments are checked in reverse while preserving vector order.
+        for (reverse_index, digest) in self.ack_preimage_hashes.iter().rev().enumerate() {
+            builder = builder
+                .push_opcode(opcodes::all::OP_SIZE)
+                .push_int(32)
+                .push_opcode(opcodes::all::OP_EQUALVERIFY)
+                .push_opcode(opcodes::all::OP_SHA256)
+                .push_slice(*digest)
+                .push_opcode(if reverse_index + 1 == self.ack_preimage_hashes.len() {
+                    opcodes::all::OP_EQUAL
+                } else {
+                    opcodes::all::OP_EQUALVERIFY
+                });
+        }
+        builder.into_script()
+    }
+
+    fn timeout_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_sequence(Sequence::from_height(self.timeout_delay.value()))
+            .push_opcode(opcodes::all::OP_CSV)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
+
+impl Connector for CounterproofResolutionConnectorV2 {
+    type SpendPath = CounterproofResolutionSpendPathV2;
+    type Witness = CounterproofResolutionWitnessV2;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.ack_script(), self.timeout_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, spend_path: Self::SpendPath) -> Option<usize> {
+        Some(match spend_path {
+            CounterproofResolutionSpendPathV2::Ack => 0,
+            CounterproofResolutionSpendPathV2::Timeout => 1,
+        })
+    }
+
+    fn sequence(&self, spend_path: Self::SpendPath) -> Sequence {
+        match spend_path {
+            CounterproofResolutionSpendPathV2::Ack => Sequence::MAX,
+            CounterproofResolutionSpendPathV2::Timeout => {
+                Sequence::from_height(self.timeout_delay.value())
+            }
+        }
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        match witness {
+            CounterproofResolutionWitnessV2::Ack {
+                graph_signature,
+                ordered_preimages,
+            } => TaprootWitness::Script {
+                leaf_index: 0,
+                script_inputs: ordered_preimages
+                    .iter()
+                    .map(|preimage| preimage.to_vec())
+                    .chain(std::iter::once(graph_signature.serialize().to_vec()))
+                    .collect(),
+            },
+            CounterproofResolutionWitnessV2::Timeout { graph_signature } => {
+                TaprootWitness::Script {
+                    leaf_index: 1,
+                    script_inputs: vec![graph_signature.serialize().to_vec()],
+                }
+            }
+        }
+    }
+}
+
+/// Authorized script paths of [`CounterproofResolutionConnectorV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum CounterproofResolutionSpendPathV2 {
+    /// Immediate exact-vector positive-lock release.
+    Ack,
+    /// CSV-delayed neutral timeout settlement.
+    Timeout,
+}
+
+/// Witness data for [`CounterproofResolutionConnectorV2`].
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub enum CounterproofResolutionWitnessV2 {
+    /// Witness for the exact presigned ACK parent.
+    Ack {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+        /// Natural participant order, `k_0` through `k_(n-1)`.
+        ordered_preimages: Vec<[u8; 32]>,
+    },
+    /// Witness for the exact presigned timeout-settlement parent.
+    Timeout {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+}
+
+/// Invalid resolution connector policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CounterproofResolutionError {
+    /// The ordered vector is outside the protocol bound.
+    InvalidPreimageCount {
+        /// Number of hashes supplied by the caller.
+        actual: usize,
+    },
+    /// A hash repeats an earlier participant's commitment.
+    DuplicatePreimageHash {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// CSV must not be disabled.
+    ZeroTimeoutDelay,
+    /// A different output role was supplied to the NUMS derivation.
+    WrongNumsRole,
+    /// The connector value exceeds Bitcoin's consensus money range.
+    ValueAboveMaxMoney {
+        /// Value supplied by the caller.
+        value: Amount,
+    },
+    /// The NUMS point could not be reconstructed.
+    NumsDerivation(NumsDerivationError),
+    /// Graph authorization aliases the connector's unspendable NUMS key domain.
+    GraphNumsKeyAlias,
+    /// The value is below the connector's actual script-dependent dust floor.
+    DustValue {
+        /// Value supplied by the caller.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for CounterproofResolutionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidPreimageCount { actual } => write!(
+                f,
+                "resolution connector requires {MIN_ACK_PREIMAGES}..={MAX_ACK_PREIMAGES} preimages, got {actual}"
+            ),
+            Self::DuplicatePreimageHash { index } => {
+                write!(f, "ACK preimage hash at index {index} is duplicated")
+            }
+            Self::ZeroTimeoutDelay => f.write_str("resolution timeout delay must be positive"),
+            Self::WrongNumsRole => {
+                f.write_str("resolution connector was given the wrong draft NUMS role")
+            }
+            Self::ValueAboveMaxMoney { value } => {
+                write!(f, "resolution value {value} exceeds MAX_MONEY")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::GraphNumsKeyAlias => f.write_str(
+                "resolution graph key aliases its NUMS internal/output key",
+            ),
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "resolution value {value} is below its dust floor {minimum}"
+            ),
+        }
+    }
+}
+
+impl Error for CounterproofResolutionError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::NumsDerivation(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use bitcoin::{
+        absolute,
+        script::Instruction,
+        sighash::{Prevouts, SighashCache},
+        transaction, OutPoint, Psbt, TapSighashType, Transaction, TxOut, Witness,
+    };
+    use secp256k1::{rand::thread_rng, schnorr, Keypair, SECP256K1};
+    use strata_bridge_primitives::scripts::prelude::{create_key_spend_hash, create_tx_ins};
+    use strata_bridge_test_utils::prelude::generate_keypair;
+
+    use super::*;
+    use crate::{
+        test_utils::{BitcoinNode, Signer},
+        SigningInfo,
+    };
+
+    const SETUP_INTENT_DIGEST: [u8; 32] = [0x24; 32];
+    const TIMEOUT: relative::Height = relative::Height::from_height(5);
+    const TEST_FEE: Amount = Amount::from_sat(1_000);
+
+    struct ResolutionSigner {
+        graph_keypair: Keypair,
+        preimages: Vec<[u8; 32]>,
+    }
+
+    impl Signer for ResolutionSigner {
+        type Connector = CounterproofResolutionConnectorV2;
+
+        fn generate() -> Self {
+            Self {
+                graph_keypair: generate_keypair(),
+                preimages: vec![[0x11; 32], [0x22; 32], [0x33; 32]],
+            }
+        }
+
+        fn get_connector(&self) -> Self::Connector {
+            connector(
+                self.graph_keypair.x_only_public_key().0,
+                self.preimages
+                    .iter()
+                    .map(|preimage| sha256::Hash::hash(preimage).to_byte_array())
+                    .collect(),
+            )
+            .unwrap()
+        }
+
+        fn get_connector_name(&self) -> &'static str {
+            "counterproof-resolution-v2"
+        }
+
+        fn sign_leaf(
+            &self,
+            spend_path: CounterproofResolutionSpendPathV2,
+            signing_info: SigningInfo,
+        ) -> CounterproofResolutionWitnessV2 {
+            let graph_signature = signing_info.sign(&self.graph_keypair);
+            match spend_path {
+                CounterproofResolutionSpendPathV2::Ack => CounterproofResolutionWitnessV2::Ack {
+                    graph_signature,
+                    ordered_preimages: self.preimages.clone(),
+                },
+                CounterproofResolutionSpendPathV2::Timeout => {
+                    CounterproofResolutionWitnessV2::Timeout { graph_signature }
+                }
+            }
+        }
+    }
+
+    fn connector(
+        graph_pubkey: XOnlyPublicKey,
+        hashes: Vec<[u8; 32]>,
+    ) -> Result<CounterproofResolutionConnectorV2, CounterproofResolutionError> {
+        CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            hashes,
+            TIMEOUT,
+            Amount::from_sat(100_000),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::CounterproofResolution,
+                7,
+            ),
+        )
+    }
+
+    fn fund_connector(
+        node: &mut BitcoinNode,
+        connector: &CounterproofResolutionConnectorV2,
+    ) -> OutPoint {
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - TEST_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+        OutPoint::new(txid, 0)
+    }
+
+    fn ack_template(
+        node: &mut BitcoinNode,
+        connector: &CounterproofResolutionConnectorV2,
+        connector_outpoint: OutPoint,
+    ) -> (Transaction, [TxOut; 2]) {
+        let mut tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([connector_outpoint, node.next_coinbase_outpoint()]),
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - TEST_FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        tx.input[0].sequence = connector.sequence(CounterproofResolutionSpendPathV2::Ack);
+        let prevouts = [connector.tx_out(), node.coinbase_tx_out()];
+        (tx, prevouts)
+    }
+
+    fn ack_signature(
+        tx: &Transaction,
+        prevouts: &[TxOut; 2],
+        connector: &CounterproofResolutionConnectorV2,
+        keypair: &Keypair,
+    ) -> schnorr::Signature {
+        let mut cache = SighashCache::new(tx);
+        connector
+            .get_signing_info(
+                &mut cache,
+                Prevouts::All(prevouts),
+                CounterproofResolutionSpendPathV2::Ack,
+                0,
+            )
+            .sign(keypair)
+    }
+
+    fn finalize_ack(
+        node: &BitcoinNode,
+        tx: Transaction,
+        prevouts: [TxOut; 2],
+        connector: &CounterproofResolutionConnectorV2,
+        signature: schnorr::Signature,
+        preimages: Vec<[u8; 32]>,
+    ) -> Transaction {
+        let mut psbt = Psbt::from_unsigned_tx(tx).expect("witness should be empty");
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+        connector.finalize_input(
+            &mut psbt.inputs[0],
+            &CounterproofResolutionWitnessV2::Ack {
+                graph_signature: signature,
+                ordered_preimages: preimages,
+            },
+        );
+        let partially_signed = psbt.extract_tx().expect("should extract transaction");
+        node.sign(&partially_signed)
+    }
+
+    #[test]
+    fn immediate_vector_ack_spend_is_accepted_by_core() {
+        ResolutionSigner::assert_connector_is_spendable(CounterproofResolutionSpendPathV2::Ack);
+    }
+
+    #[test]
+    fn timeout_spend_is_accepted_by_core() {
+        ResolutionSigner::assert_connector_is_spendable(CounterproofResolutionSpendPathV2::Timeout);
+    }
+
+    #[test]
+    fn rejects_bad_vector_policy() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let one = vec![[1u8; 32]];
+        assert!(matches!(
+            connector(graph_pubkey, one),
+            Err(CounterproofResolutionError::InvalidPreimageCount { actual: 1 })
+        ));
+
+        let too_many = (0..=MAX_ACK_PREIMAGES)
+            .map(|index| [index as u8; 32])
+            .collect();
+        assert!(matches!(
+            connector(graph_pubkey, too_many),
+            Err(CounterproofResolutionError::InvalidPreimageCount { actual: 65 })
+        ));
+
+        let duplicated = vec![[1u8; 32], [2u8; 32], [1u8; 32]];
+        assert!(matches!(
+            connector(graph_pubkey, duplicated),
+            Err(CounterproofResolutionError::DuplicatePreimageHash { index: 2 })
+        ));
+
+        let above_max = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            vec![[1u8; 32], [2u8; 32]],
+            TIMEOUT,
+            Amount::from_sat(Amount::MAX_MONEY.to_sat() + 1),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::CounterproofResolution,
+                7,
+            ),
+        );
+        assert!(matches!(
+            above_max,
+            Err(CounterproofResolutionError::ValueAboveMaxMoney { .. })
+        ));
+
+        let nums_context = ResearchV0NumsContext::new(
+            SETUP_INTENT_DIGEST,
+            ResearchV0NumsRole::CounterproofResolution,
+            70,
+        );
+        let nums_key = nums_context.derive_internal_key().unwrap();
+        assert!(matches!(
+            CounterproofResolutionConnectorV2::new(
+                Network::Regtest,
+                nums_key,
+                vec![[1u8; 32], [2u8; 32]],
+                TIMEOUT,
+                Amount::from_sat(100_000),
+                nums_context,
+            ),
+            Err(CounterproofResolutionError::GraphNumsKeyAlias)
+        ));
+    }
+
+    #[test]
+    fn ack_script_checks_size_and_hashes_in_reverse_order() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let preimages = [[0x11; 32], [0x22; 32], [0x33; 32]];
+        let hashes = preimages
+            .iter()
+            .map(|preimage| sha256::Hash::hash(preimage).to_byte_array())
+            .collect();
+        let connector = connector(graph_keypair.x_only_public_key().0, hashes).unwrap();
+        let script = connector.ack_script();
+        let opcodes: Vec<_> = script
+            .instructions()
+            .filter_map(|instruction| match instruction.unwrap() {
+                Instruction::Op(opcode) => Some(opcode),
+                Instruction::PushBytes(_) => None,
+            })
+            .collect();
+
+        assert_eq!(
+            opcodes
+                .iter()
+                .filter(|opcode| **opcode == opcodes::all::OP_SIZE)
+                .count(),
+            preimages.len()
+        );
+        assert_eq!(
+            opcodes
+                .iter()
+                .filter(|opcode| **opcode == opcodes::all::OP_SHA256)
+                .count(),
+            preimages.len()
+        );
+        assert!(connector.accepts_ordered_preimages(&preimages));
+        assert!(!connector.accepts_ordered_preimages(&[preimages[1], preimages[0], preimages[2]]));
+    }
+
+    #[test]
+    fn connector_exposes_no_declared_key_spend_path() {
+        let graph_keypair = Keypair::new(SECP256K1, &mut thread_rng());
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let connector = connector(graph_pubkey, vec![[1u8; 32], [2u8; 32]]).unwrap();
+
+        assert_eq!(
+            connector.to_leaf_index(CounterproofResolutionSpendPathV2::Ack),
+            Some(0)
+        );
+        assert_eq!(
+            connector.to_leaf_index(CounterproofResolutionSpendPathV2::Timeout),
+            Some(1)
+        );
+        assert_ne!(connector.internal_key(), graph_pubkey);
+        assert_eq!(connector.leaf_scripts().len(), 2);
+    }
+
+    #[test]
+    fn malformed_reordered_missing_and_key_path_witnesses_fail_in_core() {
+        let mut node = BitcoinNode::new();
+        let signer = ResolutionSigner::generate();
+        let connector = signer.get_connector();
+        let outpoint = fund_connector(&mut node, &connector);
+        let (tx, prevouts) = ack_template(&mut node, &connector, outpoint);
+        let signature = ack_signature(&tx, &prevouts, &connector, &signer.graph_keypair);
+        let valid = finalize_ack(
+            &node,
+            tx.clone(),
+            prevouts.clone(),
+            &connector,
+            signature,
+            signer.preimages.clone(),
+        );
+
+        let mut missing = valid.clone();
+        let mut missing_items = missing.input[0].witness.to_vec();
+        missing_items.remove(0);
+        missing.input[0].witness = Witness::from_slice(&missing_items);
+        assert!(node.client().send_raw_transaction(&missing).is_err());
+
+        let mut reordered = valid.clone();
+        let mut reordered_items = reordered.input[0].witness.to_vec();
+        reordered_items.swap(0, 1);
+        reordered.input[0].witness = Witness::from_slice(&reordered_items);
+        assert!(node.client().send_raw_transaction(&reordered).is_err());
+
+        let mut malformed = valid;
+        let mut malformed_items = malformed.input[0].witness.to_vec();
+        malformed_items[0].pop();
+        malformed.input[0].witness = Witness::from_slice(&malformed_items);
+        assert!(node.client().send_raw_transaction(&malformed).is_err());
+
+        let mut key_spend_cache = SighashCache::new(&tx);
+        let key_spend_message = create_key_spend_hash(
+            &mut key_spend_cache,
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .unwrap();
+        let graph_key_signature = signer.graph_keypair.sign_schnorr(key_spend_message);
+        let mut key_path_bypass = node.sign(&tx);
+        key_path_bypass.input[0].witness = Witness::from_slice(&[graph_key_signature.serialize()]);
+        assert!(node
+            .client()
+            .send_raw_transaction(&key_path_bypass)
+            .is_err());
+    }
+}
