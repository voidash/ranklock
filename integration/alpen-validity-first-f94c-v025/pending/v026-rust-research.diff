+//! Independently versioned rows for sixteen-blocker v0.26 observations.
+
+use std::{convert::Infallible, error::Error, fmt};
+
+use foundationdb::tuple::PackError;
+use serde::{Deserialize, Serialize};
+use strata_bridge_primitives::types::GraphIdx;
+use strata_bridge_sm::v026_admission_v2::{
+    PersistedFundingBlockedObservationV2, StructurallyVerifiedFundingBlockedV2,
+    V026_BLOCKER_COUNT_V2, V026BlockerCodeV2, V026LocalTxidManifestV2,
+    V026PersistedObservationErrorV2,
+};
