@@ -0,0 +1,45 @@
+//! Shared classification of locally known unspendable v0.26 Taproot keys.
+//!
+//! Fresh v2 script-only connectors use derived NUMS internal keys. Their
+//! tweaked Taproot output keys are equally unsuitable as caller-controlled
+//! descriptor or anchor keys because no participant is expected to know
+//! either discrete logarithm.
+
+use bitcoin::XOnlyPublicKey;
+use strata_bridge_connectors::Connector;
+
+/// Which unspendable key derived from a v2 NUMS connector was aliased.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum NumsKeyKindV2 {
+    /// The connector's untweaked NUMS internal key.
+    Internal,
+    /// The connector's derived Taproot output key.
+    Output,
+}
+
+/// One locally known unspendable key and its protocol source.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub(crate) struct KnownNumsKeyV2 {
+    pub(crate) component: &'static str,
+    pub(crate) kind: NumsKeyKindV2,
+    pub(crate) key: XOnlyPublicKey,
+}
+
+/// Derives both keys through the connector's authoritative Taproot APIs.
+pub(crate) fn known_nums_keys<C: Connector>(
+    component: &'static str,
+    connector: &C,
+) -> [KnownNumsKeyV2; 2] {
+    [
+        KnownNumsKeyV2 {
+            component,
+            kind: NumsKeyKindV2::Internal,
+            key: connector.internal_key(),
+        },
+        KnownNumsKeyV2 {
+            component,
+            kind: NumsKeyKindV2::Output,
+            key: connector.spend_info().output_key().to_x_only_public_key(),
+        },
+    ]
+}
