+    #[test]
+    fn exact_slash_layout_order_and_conservation() {
+        let fee = Amount::from_sat(500);
+        let (authorization, slash, stake) = connectors(
+            Amount::from_sat(1_000),
+            Amount::from_sat(1_000),
+            Amount::from_sat(5_000),
+        );
+        let first = Keypair::new(SECP256K1, &mut thread_rng());
+        let second = Keypair::new(SECP256K1, &mut thread_rng());
+        let payouts = vec![
+            payout(first.x_only_public_key().0, Amount::from_sat(3_250)),
+            payout(second.x_only_public_key().0, Amount::from_sat(3_250)),
+        ];
+        let outpoints = input_outpoints();
+        let slash_tx = SlashV2Tx::new(
+            SlashV2Data {
+                slash_authorization_outpoint: outpoints[0],
+                contest_slash_outpoint: outpoints[1],
+                stake_outpoint: outpoints[2],
+                operator_idx: 7,
+                magic_bytes: (*b"ALPN").into(),
+            },
+            authorization,
+            slash,
+            stake,
+            payouts.clone(),
+            fee,
+            fee_allowance(fee),
+        )
+        .unwrap();
+        assert_eq!(slash_tx.as_ref().input.len(), 3);
+        assert_eq!(slash_tx.as_ref().output.len(), 3);
+        assert_eq!(slash_tx.as_ref().output[0].value, Amount::ZERO);
+        assert!(slash_tx.as_ref().output[0].script_pubkey.is_op_return());
+        let expected_payouts: Vec<_> = payouts.iter().map(SlashPayoutV2::tx_out).collect();
+        assert_eq!(&slash_tx.as_ref().output[1..], expected_payouts.as_slice());
+        assert_eq!(slash_tx.signing_info().len(), 3);
+        assert_eq!(slash_tx.payout_tx_out(0).unwrap(), &expected_payouts[0]);
+        assert_eq!(slash_tx.payout_outpoint(1).unwrap().vout, 2);
+        assert!(matches!(
+            slash_tx.payout_tx_out(2),
+            Err(SlashV2Error::PayoutIndexOutOfBounds { .. })
+        ));
+        assert!(!SlashV2Tx::header_profile_compatible_for_activation());
+
+        let signed = slash_tx
