+    #[test]
+    fn selected_index_above_zero_returns_every_sibling_exactly() {
+        let fixture = Fixture::new();
+        let counterproof = fixture.construct(fixture.data()).unwrap();
+        let tx = counterproof.as_ref();
+        assert_eq!(tx.input.len(), RESERVE_COUNT + 2);
+        assert_eq!(tx.output.len(), RESERVE_COUNT + 2);
+        for (index, reserve) in fixture.reserves.iter().enumerate() {
+            assert_eq!(tx.input[index].previous_output, reserve.outpoint());
+            if index == SELECTED {
+                assert!(matches!(
+                    counterproof.reserve_return_vout(index),
+                    Err(CounterproofV2Error::SelectedReserveHasNoReturn { index: SELECTED })
+                ));
+            } else {
+                let vout = counterproof.reserve_return_vout(index).unwrap() as usize;
+                assert_eq!(tx.output[vout].value, reserve.connector().value());
+                assert_eq!(
