+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn current_blockers() -> Vec<V026ActivationBlocker> {
+        vec![
+            V026ActivationBlocker::ResearchNumsProfile,
+            V026ActivationBlocker::CanonicalWireIdentityUnimplemented,
+            V026ActivationBlocker::ReleaseCryptographyEvidenceUnverified,
+            V026ActivationBlocker::ControllerDomainEvidenceUnverified,
+            V026ActivationBlocker::SlashHeaderProfileIncompatible,
+            V026ActivationBlocker::ExternalOutputEvidenceUnverified,
+            V026ActivationBlocker::FreshDepositEvidenceUnverified,
+            V026ActivationBlocker::StakeExclusivityEvidenceUnverified,
+            V026ActivationBlocker::PresignErasureEvidenceUnverified,
+            V026ActivationBlocker::LegacyMaterialExclusionUnverified,
+            V026ActivationBlocker::FeePolicyEvidenceUnverified,
+            V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified,
+            V026ActivationBlocker::BitcoinCoreExecutionEvidenceUnverified,
+            V026ActivationBlocker::AsmActivationEvidenceUnverified,
+            V026ActivationBlocker::RuntimeAdmissionUnimplemented,
+            V026ActivationBlocker::ValidityWithholdingEconomicsUnresolved,
+        ]
+    }
+
+    #[test]
+    fn blocker_codes_are_append_only_one_through_sixteen() {
+        for (index, blocker) in V026_BLOCKERS_V2.into_iter().enumerate() {
+            let expected = u16::try_from(index + 1).expect("V2 blocker index fits u16");
+            assert_eq!(blocker as u16, expected);
+            assert_eq!(V026BlockerCodeV2::try_from(expected), Ok(blocker));
+        }
+        assert_eq!(
+            V026BlockerCodeV2::from(V026ActivationBlocker::AtomicRosterWeightEvidenceUnverified),
+            V026BlockerCodeV2::AtomicRosterWeightEvidenceUnverified
+        );
+    }
+
+    #[test]
+    fn unknown_seventeen_fails_closed() {
+        assert!(matches!(
+            V026BlockerCodeV2::try_from(17_u16),
+            Err(UnknownV026BlockerCodeV2 { code: 17 })
+        ));
+    }
+
+    #[test]
+    fn exact_set_is_required_independent_of_report_order() {
+        let exact = current_blockers();
+        validate_complete_blocker_set(&exact).expect("current sixteen-blocker set is complete");
+
+        let mut reordered = exact.clone();
+        reordered.reverse();
+        validate_complete_blocker_set(&reordered)
+            .expect("report order is not persisted canonical order");
+
+        let mut missing = exact.clone();
+        missing.pop();
+        assert!(matches!(
+            validate_complete_blocker_set(&missing),
+            Err(V026ObservationErrorV2::MissingBlocker {
+                blocker: V026BlockerCodeV2::ValidityWithholdingEconomicsUnresolved
+            })
+        ));
+
+        let mut duplicate = exact;
+        duplicate[15] = duplicate[14];
+        assert!(matches!(
+            validate_complete_blocker_set(&duplicate),
+            Err(V026ObservationErrorV2::DuplicateBlocker { .. })
+        ));
+    }
+}
