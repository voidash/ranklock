+/// Durable V2 local record that can only represent a funding-blocked observation.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct StructurallyVerifiedFundingBlockedV2 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV2,
+    blockers: [V026BlockerCodeV2; V026_BLOCKER_COUNT_V2],
+}
+
+impl StructurallyVerifiedFundingBlockedV2 {
+    /// Verifies and snapshots one in-process graph without admitting it.
+    pub fn observe(graph_idx: GraphIdx, graph: &V026Graph) -> Result<Self, V026ObservationErrorV2> {
+        graph
+            .verify_structure()
+            .map_err(V026ObservationErrorV2::StructuralVerification)?;
+        if graph.funding_eligible() {
+            return Err(V026ObservationErrorV2::UnexpectedFundingEligibility);
+        }
+        validate_complete_blocker_set(graph.activation_blockers())?;
+
+        Ok(Self {
+            graph_idx,
+            local_manifest: V026LocalTxidManifestV2::from_graph(graph),
+            blockers: V026_BLOCKERS_V2,
+        })
+    }
+
+    /// Logical graph key under which this local observation is persisted.
+    pub const fn graph_idx(&self) -> GraphIdx {
+        self.graph_idx
+    }
+
+    /// Ordered local transaction-ID manifest.
+    pub const fn local_manifest(&self) -> &V026LocalTxidManifestV2 {
+        &self.local_manifest
+    }
+
+    /// Exact V2 blocker set retained by this record.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV2; V026_BLOCKER_COUNT_V2] {
+        &self.blockers
+    }
+
+    /// A V2 observation is unconditionally ineligible for funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Converts this live, observer-produced capability into its inert persisted view.
+    pub fn to_persisted(&self) -> PersistedFundingBlockedObservationV2 {
+        PersistedFundingBlockedObservationV2 {
+            graph_idx: self.graph_idx,
+            local_manifest: self.local_manifest.clone(),
+            blockers: self.blockers,
+        }
+    }
+
+    /// Rechecks invariants after decoding the versioned local record.
+    pub fn validate_persisted_shape(&self) -> Result<(), V026PersistedObservationErrorV2> {
+        validate_persisted_shape(&self.local_manifest, &self.blockers)
+    }
+}
+
+/// Validated, inert read model reconstructed from the V2 storage envelope.
+///
+/// This type exposes the same durable observation data as the live capability,
+/// but the database write API does not accept it. Deserializing storage can
+/// therefore never mint a new live observation capability.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct PersistedFundingBlockedObservationV2 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV2,
+    blockers: [V026BlockerCodeV2; V026_BLOCKER_COUNT_V2],
+}
+
+impl PersistedFundingBlockedObservationV2 {
+    /// Constructs an inert read model after checking every persisted invariant.
+    pub fn try_from_parts(
+        graph_idx: GraphIdx,
+        local_manifest: V026LocalTxidManifestV2,
+        blockers: [V026BlockerCodeV2; V026_BLOCKER_COUNT_V2],
+    ) -> Result<Self, V026PersistedObservationErrorV2> {
+        validate_persisted_shape(&local_manifest, &blockers)?;
+        Ok(Self {
+            graph_idx,
+            local_manifest,
+            blockers,
+        })
+    }
+
+    /// Logical graph key encoded in the persisted body.
+    pub const fn graph_idx(&self) -> GraphIdx {
+        self.graph_idx
+    }
+
+    /// Ordered local transaction-ID manifest.
+    pub const fn local_manifest(&self) -> &V026LocalTxidManifestV2 {
+        &self.local_manifest
+    }
+
+    /// Exact canonical V2 blocker set.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV2; V026_BLOCKER_COUNT_V2] {
+        &self.blockers
+    }
+
+    /// A persisted V2 observation is unconditionally ineligible for funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Rechecks every persisted V2 shape invariant.
+    pub fn validate_persisted_shape(&self) -> Result<(), V026PersistedObservationErrorV2> {
+        validate_persisted_shape(&self.local_manifest, &self.blockers)
+    }
+}
+
+fn validate_persisted_shape(
+    local_manifest: &V026LocalTxidManifestV2,
+    blockers: &[V026BlockerCodeV2; V026_BLOCKER_COUNT_V2],
+) -> Result<(), V026PersistedObservationErrorV2> {
+    if local_manifest.alternatives.is_empty() {
+        return Err(V026PersistedObservationErrorV2::EmptyAlternativeRoster);
+    }
+    if *blockers != V026_BLOCKERS_V2 {
+        return Err(V026PersistedObservationErrorV2::BlockerSetMismatch);
+    }
+    Ok(())
+}
+
+fn validate_complete_blocker_set(
+    blockers: &[V026ActivationBlocker],
+) -> Result<(), V026ObservationErrorV2> {
+    let mut seen = [false; V026_BLOCKER_COUNT_V2];
+    for blocker in blockers.iter().copied() {
+        let code = V026BlockerCodeV2::from(blocker);
+        let index = code.seen_index();
+        if seen[index] {
+            return Err(V026ObservationErrorV2::DuplicateBlocker { blocker: code });
+        }
+        seen[index] = true;
+    }
+    for (index, was_seen) in seen.into_iter().enumerate() {
+        if !was_seen {
+            return Err(V026ObservationErrorV2::MissingBlocker {
+                blocker: V026_BLOCKERS_V2[index],
+            });
+        }
+    }
+    if blockers.len() != V026_BLOCKER_COUNT_V2 {
+        return Err(V026ObservationErrorV2::BlockerCount {
+            expected: V026_BLOCKER_COUNT_V2,
+            actual: blockers.len(),
+        });
+    }
+    Ok(())
+}
+
+/// Failure to create a fail-closed V2 local observation.
+#[derive(Debug, Error)]
+pub enum V026ObservationErrorV2 {
+    /// The assembler's exact structural verifier failed.
+    #[error("v0.26 structural verification failed: {0}")]
+    StructuralVerification(#[source] V026GraphError),
+    /// A graph unexpectedly claimed it was eligible for funding.
+    #[error("v0.26 graph unexpectedly reported funding eligibility")]
+    UnexpectedFundingEligibility,
+    /// The graph did not retain exactly the V2 number of blockers.
+    #[error("v0.26 V2 blocker count is {actual}, expected {expected}")]
+    BlockerCount {
+        /// Required count.
+        expected: usize,
+        /// Observed count.
+        actual: usize,
+    },
+    /// One blocker occurred more than once.
+    #[error("v0.26 V2 blocker {blocker} occurred more than once")]
+    DuplicateBlocker {
+        /// Duplicate blocker.
+        blocker: V026BlockerCodeV2,
+    },
+    /// One V2 blocker was absent.
+    #[error("v0.26 V2 blocker {blocker} is missing")]
+    MissingBlocker {
+        /// Missing blocker.
+        blocker: V026BlockerCodeV2,
+    },
+}
+
+/// Invalid decoded shape for a V2 observation.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Error)]
+pub enum V026PersistedObservationErrorV2 {
+    /// A valid assembled graph always has at least one alternative.
+    #[error("persisted v0.26 V2 observation has an empty alternative roster")]
+    EmptyAlternativeRoster,
+    /// The record does not contain the exact V2 blocker array.
+    #[error("persisted v0.26 observation does not retain the exact V2 blocker set")]
+    BlockerSetMismatch,
+}
+
+impl fmt::Display for V026BlockerCodeV2 {
