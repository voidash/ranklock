+    V026BlockerCodeV2::StakeExclusivityEvidenceUnverified,
+    V026BlockerCodeV2::PresignErasureEvidenceUnverified,
+    V026BlockerCodeV2::LegacyMaterialExclusionUnverified,
+    V026BlockerCodeV2::FeePolicyEvidenceUnverified,
+    V026BlockerCodeV2::BitcoinCoreExecutionEvidenceUnverified,
+    V026BlockerCodeV2::AsmActivationEvidenceUnverified,
+    V026BlockerCodeV2::RuntimeAdmissionUnimplemented,
+    V026BlockerCodeV2::ValidityWithholdingEconomicsUnresolved,
+    V026BlockerCodeV2::AtomicRosterWeightEvidenceUnverified,
+];
+
+impl V026BlockerCodeV2 {
+    const fn seen_index(self) -> usize {
