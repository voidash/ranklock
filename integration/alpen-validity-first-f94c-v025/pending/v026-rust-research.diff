@@ -0,0 +1,470 @@
+//! Versioned rows for local v0.26 funding-blocked observations.
+
+use std::{convert::Infallible, error::Error, fmt};
+
+use foundationdb::tuple::PackError;
+use serde::{Deserialize, Serialize};
+use strata_bridge_primitives::types::GraphIdx;
+use strata_bridge_sm::v026_admission::{
+    PersistedFundingBlockedObservationV1, StructurallyVerifiedFundingBlockedV1,
+    V026_BLOCKER_COUNT_V1, V026BlockerCodeV1, V026LocalTxidManifestV1,
+    V026PersistedObservationError,
+};
+
+use super::kv::{KVRowSpec, PackableKey, SerializableValue};
+use crate::fdb::dirs::Directories;
+
+const ENVELOPE_MAGIC: &[u8; 7] = b"RL26ADM";
+const ENVELOPE_VERSION_V1: u16 = 1;
+const ENVELOPE_HEADER_LEN: usize = ENVELOPE_MAGIC.len() + size_of::<u16>();
+
+/// Key for one local observation, isolated from the existing v1 graph-state rows.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionKey(GraphIdx);
+
+/// A stored observation body claims a different logical key than its FDB row.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionKeyMismatch {
+    /// Graph key used to read or atomically assign the row.
+    pub expected: GraphIdx,
+    /// Graph key encoded inside the stored observation.
+    pub actual: GraphIdx,
+}
+
+impl From<GraphIdx> for V026AdmissionKey {
+    fn from(graph_idx: GraphIdx) -> Self {
+        Self(graph_idx)
+    }
+}
+
+impl From<V026AdmissionKey> for GraphIdx {
+    fn from(key: V026AdmissionKey) -> Self {
+        key.0
+    }
+}
+
+impl PackableKey for V026AdmissionKey {
+    type PackingError = Infallible;
+    type UnpackingError = PackError;
+    type Packed = Vec<u8>;
+
+    fn pack(&self, dirs: &Directories) -> Result<Self::Packed, Self::PackingError> {
+        Ok(dirs
+            .v026_admissions_v1
+            .pack::<(u32, u32)>(&(self.0.deposit, self.0.operator)))
+    }
+
+    fn unpack(dirs: &Directories, bytes: &[u8]) -> Result<Self, Self::UnpackingError> {
+        let (deposit, operator) = dirs.v026_admissions_v1.unpack::<(u32, u32)>(bytes)?;
+        Ok(Self(GraphIdx { deposit, operator }))
+    }
+}
+
+/// Crate-private wire body. Field order is the frozen V1 postcard layout.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct V026AdmissionBodyV1 {
+    graph_idx: GraphIdx,
+    local_manifest: V026LocalTxidManifestV1,
+    blockers: [V026BlockerCodeV1; V026_BLOCKER_COUNT_V1],
+}
+
+impl V026AdmissionBodyV1 {
+    fn from_live(observation: &StructurallyVerifiedFundingBlockedV1) -> Self {
+        Self {
+            graph_idx: observation.graph_idx(),
+            local_manifest: observation.local_manifest().clone(),
+            blockers: *observation.blockers(),
+        }
+    }
+
+    fn validate(&self) -> Result<(), V026PersistedObservationError> {
+        PersistedFundingBlockedObservationV1::try_from_parts(
+            self.graph_idx,
+            self.local_manifest.clone(),
+            self.blockers,
+        )
+        .map(|_observation| ())
+    }
+
+    fn try_into_persisted(
+        self,
+    ) -> Result<PersistedFundingBlockedObservationV1, V026PersistedObservationError> {
+        PersistedFundingBlockedObservationV1::try_from_parts(
+            self.graph_idx,
+            self.local_manifest,
+            self.blockers,
+        )
+    }
+}
+
+/// Value wrapper whose encoding has an explicit magic and schema version.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct V026AdmissionValue(V026AdmissionBodyV1);
+
+impl V026AdmissionValue {
+    pub(crate) fn from_live(observation: &StructurallyVerifiedFundingBlockedV1) -> Self {
+        Self(V026AdmissionBodyV1::from_live(observation))
+    }
+
+    pub(crate) fn try_into_persisted(
+        self,
+    ) -> Result<PersistedFundingBlockedObservationV1, V026PersistedObservationError> {
+        self.0.try_into_persisted()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn from_persisted_for_test(
+        observation: &PersistedFundingBlockedObservationV1,
+    ) -> Self {
+        Self(V026AdmissionBodyV1 {
+            graph_idx: observation.graph_idx(),
+            local_manifest: observation.local_manifest().clone(),
+            blockers: *observation.blockers(),
+        })
+    }
+}
+
+impl SerializableValue for V026AdmissionValue {
+    type SerializeError = V026AdmissionSerializeError;
+    type DeserializeError = V026AdmissionDeserializeError;
+    type Serialized = Vec<u8>;
+
+    fn serialize(&self) -> Result<Self::Serialized, Self::SerializeError> {
+        self.0
+            .validate()
+            .map_err(V026AdmissionSerializeError::InvalidRecord)?;
+        let body = postcard::to_allocvec(&self.0).map_err(V026AdmissionSerializeError::Postcard)?;
+        let mut encoded = Vec::with_capacity(ENVELOPE_HEADER_LEN + body.len());
+        encoded.extend_from_slice(ENVELOPE_MAGIC);
+        encoded.extend_from_slice(&ENVELOPE_VERSION_V1.to_le_bytes());
+        encoded.extend_from_slice(&body);
+        Ok(encoded)
+    }
+
+    fn deserialize(bytes: &[u8]) -> Result<Self, Self::DeserializeError> {
+        if bytes.len() < ENVELOPE_HEADER_LEN {
+            return Err(V026AdmissionDeserializeError::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            });
+        }
+        let (magic, version_and_body) = bytes.split_at(ENVELOPE_MAGIC.len());
+        if magic != ENVELOPE_MAGIC {
+            return Err(V026AdmissionDeserializeError::InvalidMagic);
+        }
+        let (version_bytes, body) = version_and_body.split_at(size_of::<u16>());
+        let version = u16::from_le_bytes(version_bytes.try_into().map_err(|_| {
+            V026AdmissionDeserializeError::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            }
+        })?);
+        if version != ENVELOPE_VERSION_V1 {
+            return Err(V026AdmissionDeserializeError::UnsupportedVersion { version });
+        }
+        let (record, trailing) = postcard::take_from_bytes::<V026AdmissionBodyV1>(body)
+            .map_err(V026AdmissionDeserializeError::Postcard)?;
+        if !trailing.is_empty() {
+            return Err(V026AdmissionDeserializeError::TrailingBytes {
+                count: trailing.len(),
+            });
+        }
+        record
+            .validate()
+            .map_err(V026AdmissionDeserializeError::InvalidRecord)?;
+        let canonical_body = postcard::to_allocvec(&record)
+            .map_err(V026AdmissionDeserializeError::CanonicalReencode)?;
+        if canonical_body != body {
+            return Err(V026AdmissionDeserializeError::NonCanonicalBody);
+        }
+        Ok(Self(record))
+    }
+}
+
+/// Serialization failure for a local observation envelope.
+#[derive(Debug)]
+pub(crate) enum V026AdmissionSerializeError {
+    /// The value does not satisfy the frozen blocked-record invariants.
+    InvalidRecord(V026PersistedObservationError),
+    /// The frozen V1 body failed to serialize.
+    Postcard(postcard::Error),
+}
+
+impl fmt::Display for V026AdmissionSerializeError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V1 record: {error}"),
+            Self::Postcard(error) => write!(f, "failed to serialize v0.26 V1 body: {error}"),
+        }
+    }
+}
+
+impl Error for V026AdmissionSerializeError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::Postcard(error) => Some(error),
+        }
+    }
+}
+
+/// Strict decode failure for a local observation envelope.
+#[derive(Debug)]
+pub(crate) enum V026AdmissionDeserializeError {
+    /// The envelope ended before the complete fixed header.
+    UnexpectedEof {
+        /// Minimum required bytes.
+        expected_at_least: usize,
+        /// Available bytes.
+        actual: usize,
+    },
+    /// The row does not belong to this independently versioned record family.
+    InvalidMagic,
+    /// No decoder exists for the supplied version.
+    UnsupportedVersion {
+        /// Rejected version.
+        version: u16,
+    },
+    /// The decoded value does not satisfy the frozen blocked-record invariants.
+    InvalidRecord(V026PersistedObservationError),
+    /// The frozen V1 body failed to decode.
+    Postcard(postcard::Error),
+    /// A decoded body could not be canonically re-encoded.
+    CanonicalReencode(postcard::Error),
+    /// The body decoded but was not the one canonical postcard encoding.
+    NonCanonicalBody,
+    /// Bytes remained after the one exact V1 body.
+    TrailingBytes {
+        /// Number of unconsumed bytes.
+        count: usize,
+    },
+}
+
+impl fmt::Display for V026AdmissionDeserializeError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnexpectedEof {
+                expected_at_least,
+                actual,
+            } => write!(
+                f,
+                "v0.26 admission envelope has {actual} bytes, expected at least {expected_at_least}"
+            ),
+            Self::InvalidMagic => f.write_str("invalid v0.26 admission envelope magic"),
+            Self::UnsupportedVersion { version } => {
+                write!(f, "unsupported v0.26 admission envelope version {version}")
+            }
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V1 record: {error}"),
+            Self::Postcard(error) => write!(f, "failed to decode v0.26 V1 body: {error}"),
+            Self::CanonicalReencode(error) => {
+                write!(f, "failed to re-encode canonical v0.26 V1 body: {error}")
+            }
+            Self::NonCanonicalBody => {
+                f.write_str("v0.26 admission envelope body is not canonically encoded")
+            }
+            Self::TrailingBytes { count } => {
+                write!(f, "v0.26 admission envelope has {count} trailing bytes")
+            }
+        }
+    }
+}
+
+impl Error for V026AdmissionDeserializeError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::Postcard(error) | Self::CanonicalReencode(error) => Some(error),
+            Self::UnexpectedEof { .. }
+            | Self::InvalidMagic
+            | Self::UnsupportedVersion { .. }
+            | Self::NonCanonicalBody
+            | Self::TrailingBytes { .. } => None,
+        }
+    }
+}
