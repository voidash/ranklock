+//! Draft v0.26 caller-bound NUMS internal-key derivation.
+//!
+//! This module deliberately exposes only a research wire profile.  The v0.26
+//! protocol document has not yet assigned authoritative byte values to its
+//! `output_role` enum or defined whether `output_index` is a vout, role-local
+//! ordinal, or global graph ordinal.  These bytes MUST NOT authorize funding,
+//! and this module makes no canonical per-output uniqueness claim.
+
+use std::{error::Error, fmt};
+
+use bitcoin::hashes::Hash;
+use secp256k1::{Scalar, XOnlyPublicKey, SECP256K1};
+
+bitcoin::hashes::sha256t_hash_newtype! {
+    struct RanklockTaprootNumsTag = hash_str("RankLock/v026/TaprootNUMS");
+
+    struct RanklockTaprootNumsHash(_);
+}
+
+/// BIP341's example NUMS point, encoded as an x-only public key.
+pub const BIP341_NUMS_BASE_POINT: [u8; 32] = [
+    0x50, 0x92, 0x9b, 0x74, 0xc1, 0xa0, 0x49, 0x54, 0xb7, 0x8b, 0x4b, 0x60, 0x35, 0xe9, 0x7a, 0x5e,
+    0x07, 0x8a, 0x5a, 0x0f, 0x28, 0xec, 0x96, 0xd5, 0x47, 0xbf, 0xee, 0x9a, 0xce, 0x80, 0x3a, 0xc0,
+];
+
+const SECP256K1_ORDER: [u8; 32] = [
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
+    0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b, 0xbf, 0xd2, 0x5e, 0x8c, 0xd0, 0x36, 0x41, 0x41,
+];
+
+/// Non-authoritative role bytes for connector prototyping only.
+///
+/// A future funding-capable wire profile must replace this enum with its
+/// independently reviewed and frozen role registry.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+#[repr(u8)]
+pub enum ResearchV0NumsRole {
+    /// A `CounterproofResolutionConnectorV2` output.
+    CounterproofResolution = 0x01,
+    /// A `SlashAuthorizationConnectorV2` output.
+    SlashAuthorization = 0x02,
+    /// Reserved for the separately implemented v2 contest-counterproof output.
+    ContestCounterproof = 0x03,
+    /// A `ContestPayoutGateV2` output.
+    ContestPayoutGate = 0x04,
+    /// A `ContestSlashGateV2` output.
+    ContestSlashGate = 0x05,
+}
+
+impl ResearchV0NumsRole {
+    /// This research role registry is never sufficient to authorize funding.
+    pub const fn funding_eligible(self) -> bool {
+        false
+    }
+
+    const fn to_byte(self) -> u8 {
+        self as u8
+    }
+}
+
+/// Caller-supplied inputs to the non-authoritative draft NUMS derivation.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ResearchV0NumsContext {
+    setup_intent_digest: [u8; 32],
+    role: ResearchV0NumsRole,
+    output_index: u32,
+}
+
+impl ResearchV0NumsContext {
+    /// Creates a non-authoritative research derivation context.
+    pub const fn new(
+        setup_intent_digest: [u8; 32],
+        role: ResearchV0NumsRole,
+        output_index: u32,
+    ) -> Self {
+        Self {
+            setup_intent_digest,
+            role,
+            output_index,
+        }
+    }
+
+    /// Returns the draft role of this output.
+    pub const fn role(self) -> ResearchV0NumsRole {
+        self.role
+    }
+
+    /// Derives `H + r_i*G` using the v0.26 tag and network-byte-order index.
+    pub fn derive_internal_key(self) -> Result<XOnlyPublicKey, NumsDerivationError> {
+        let base = XOnlyPublicKey::from_slice(&BIP341_NUMS_BASE_POINT)
+            .map_err(|_| NumsDerivationError::InvalidPinnedBasePoint)?;
+
+        let mut message = [0u8; 37];
+        message[..32].copy_from_slice(&self.setup_intent_digest);
+        message[32] = self.role.to_byte();
+        message[33..].copy_from_slice(&self.output_index.to_be_bytes());
+
+        let digest = RanklockTaprootNumsHash::hash(&message).to_byte_array();
+        let scalar_bytes = reduce_mod_curve_order(digest);
+        let tweak = Scalar::from_be_bytes(scalar_bytes)
+            .map_err(|_| NumsDerivationError::ScalarReductionFailed)?;
+
+        base.add_tweak(SECP256K1, &tweak)
+            .map(|(key, _parity)| key)
+            .map_err(|_| NumsDerivationError::DerivedPointAtInfinity)
+    }
+}
+
+/// Failure to reconstruct the draft v0.26 NUMS internal key.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum NumsDerivationError {
+    /// The source-embedded BIP341 base point is not a valid x-only key.
+    InvalidPinnedBasePoint,
+    /// Reduction of a 256-bit digest modulo the secp256k1 order failed.
+    ScalarReductionFailed,
+    /// The public tweak canceled the base point.
+    DerivedPointAtInfinity,
+}
+
+impl fmt::Display for NumsDerivationError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidPinnedBasePoint => f.write_str("pinned BIP341 NUMS point is invalid"),
+            Self::ScalarReductionFailed => {
+                f.write_str("tagged hash could not be reduced to a secp256k1 scalar")
+            }
+            Self::DerivedPointAtInfinity => {
+                f.write_str("derived NUMS point is the point at infinity")
+            }
+        }
+    }
+}
+
+impl Error for NumsDerivationError {}
+
+fn reduce_mod_curve_order(mut value: [u8; 32]) -> [u8; 32] {
+    if value < SECP256K1_ORDER {
+        return value;
+    }
+
+    let mut borrow = 0u16;
+    for index in (0..value.len()).rev() {
+        let minuend = u16::from(value[index]);
+        let subtrahend = u16::from(SECP256K1_ORDER[index]) + borrow;
+        if minuend >= subtrahend {
+            value[index] = (minuend - subtrahend) as u8;
+            borrow = 0;
+        } else {
+            value[index] = (minuend + 256 - subtrahend) as u8;
+            borrow = 1;
+        }
+    }
+    debug_assert_eq!(borrow, 0);
+    value
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SETUP_INTENT_DIGEST: [u8; 32] = [0x42; 32];
+
+    #[test]
+    fn draft_profile_is_explicitly_funding_ineligible() {
+        let roles = [
+            ResearchV0NumsRole::CounterproofResolution,
+            ResearchV0NumsRole::SlashAuthorization,
+            ResearchV0NumsRole::ContestCounterproof,
+            ResearchV0NumsRole::ContestPayoutGate,
+            ResearchV0NumsRole::ContestSlashGate,
+        ];
+        assert!(roles.iter().all(|role| !role.funding_eligible()));
+        for (index, role) in roles.iter().enumerate() {
+            assert!(!roles[..index]
+                .iter()
+                .any(|earlier| earlier.to_byte() == role.to_byte()));
+        }
+    }
+
+    #[test]
+    fn derivation_binds_setup_role_and_big_endian_index() {
+        let resolution = ResearchV0NumsContext::new(
+            SETUP_INTENT_DIGEST,
+            ResearchV0NumsRole::CounterproofResolution,
+            7,
+        )
+        .derive_internal_key()
+        .unwrap();
+        let other_role = ResearchV0NumsContext::new(
+            SETUP_INTENT_DIGEST,
+            ResearchV0NumsRole::SlashAuthorization,
+            7,
+        )
+        .derive_internal_key()
+        .unwrap();
+        let other_index = ResearchV0NumsContext::new(
+            SETUP_INTENT_DIGEST,
+            ResearchV0NumsRole::CounterproofResolution,
+            8,
+        )
+        .derive_internal_key()
+        .unwrap();
+        let other_setup =
+            ResearchV0NumsContext::new([0x43; 32], ResearchV0NumsRole::CounterproofResolution, 7)
+                .derive_internal_key()
+                .unwrap();
+
+        assert_ne!(resolution, other_role);
+        assert_ne!(resolution, other_index);
+        assert_ne!(resolution, other_setup);
+        assert_eq!(
+            resolution.serialize(),
+            [
+                0x54, 0x0d, 0xb0, 0x14, 0xdc, 0xfd, 0x02, 0x07, 0x8e, 0x57, 0x28, 0x45, 0x7c, 0xaf,
+                0xb6, 0x31, 0x62, 0xe1, 0x2f, 0xad, 0xd5, 0x9a, 0x6c, 0xee, 0x34, 0x82, 0xbb, 0x82,
+                0x8f, 0x09, 0x6e, 0x46,
+            ]
+        );
+    }
+
+    #[test]
+    fn scalar_reduction_handles_the_full_digest_range() {
+        assert_eq!(
+            reduce_mod_curve_order([0xff; 32]),
+            [
+                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+                0x00, 0x01, 0x45, 0x51, 0x23, 0x19, 0x50, 0xb7, 0x5f, 0xc4, 0x40, 0x2d, 0xa1, 0x73,
+                0x2f, 0xc9, 0xbe, 0xbe,
+            ]
+        );
+        assert_eq!(reduce_mod_curve_order(SECP256K1_ORDER), [0u8; 32]);
+    }
+}
