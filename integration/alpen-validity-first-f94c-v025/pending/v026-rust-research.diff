+        let operator_keypair = generate_keypair();
+        let connector = connector(&graph_keypair, &operator_keypair, N_DATA);
+
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+
+        let spending_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([
+                OutPoint {
+                    txid: funding_txid,
+                    vout: 0,
+                },
+                node.next_coinbase_outpoint(),
+            ]),
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let utxos = [connector.tx_out(), node.coinbase_tx_out()];
+        let mut cache = SighashCache::new(&spending_tx);
+        let signing_info = connector.get_signing_info(
+            &mut cache,
+            Prevouts::All(&utxos),
+            ContestCounterproofSpendV2::ReserveRecovery,
+            0,
+        );
+        let graph_signature = graph_keypair.sign_schnorr(signing_info.sighash);
+        let witness = connector.reserve_recovery_witness(graph_signature);
+        let mut psbt = Psbt::from_unsigned_tx(spending_tx.clone()).unwrap();
+        psbt.inputs[0].witness_utxo = Some(connector.tx_out());
+        psbt.inputs[1].witness_utxo = Some(node.coinbase_tx_out());
+        connector
+            .try_finalize_input(
+                &mut psbt.inputs[0],
+                ContestCounterproofSpendV2::ReserveRecovery,
+                &witness,
+            )
+            .unwrap();
+        let valid = node.sign(&psbt.extract_tx().unwrap());
+
+        let wrong_key_signature = operator_keypair.sign_schnorr(signing_info.sighash);
+        let wrong_key_witness = connector.reserve_recovery_witness(wrong_key_signature);
+        let mut wrong_key_psbt = Psbt::from_unsigned_tx(spending_tx.clone()).unwrap();
+        wrong_key_psbt.inputs[0].witness_utxo = Some(connector.tx_out());
+        wrong_key_psbt.inputs[1].witness_utxo = Some(node.coinbase_tx_out());
+        connector
+            .try_finalize_input(
+                &mut wrong_key_psbt.inputs[0],
+                ContestCounterproofSpendV2::ReserveRecovery,
+                &wrong_key_witness,
+            )
+            .unwrap();
+        let wrong_key = node.sign(&wrong_key_psbt.extract_tx().unwrap());
+        assert!(node.client().send_raw_transaction(&wrong_key).is_err());
+
+        let wrong_leaf_witness = connector
+            .counterproof_witness(
+                graph_signature,
+                vec![wrong_key_signature; connector.n_data().get()],
+            )
+            .unwrap();
+        let mut wrong_leaf_psbt = Psbt::from_unsigned_tx(spending_tx.clone()).unwrap();
+        wrong_leaf_psbt.inputs[0].witness_utxo = Some(connector.tx_out());
+        wrong_leaf_psbt.inputs[1].witness_utxo = Some(node.coinbase_tx_out());
+        connector
+            .try_finalize_input(
+                &mut wrong_leaf_psbt.inputs[0],
+                ContestCounterproofSpendV2::Counterproof,
+                &wrong_leaf_witness,
+            )
+            .unwrap();
+        let wrong_leaf = node.sign(&wrong_leaf_psbt.extract_tx().unwrap());
+        assert!(node.client().send_raw_transaction(&wrong_leaf).is_err());
+
+        assert!(node.client().send_raw_transaction(&valid).is_ok());
+    }
+
+    #[test]
+    fn constructor_blocks_single_signature_graph_operator_alias_bypass() {
+        let mut node = BitcoinNode::new();
+        let shared_keypair = generate_keypair();
+        let shared_pubkey = shared_keypair.x_only_public_key().0;
+        let raw_aliased_script = script::Builder::new()
+            .push_slice(shared_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+            .push_slice(shared_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script();
+        let internal_key = nums_context(3).derive_internal_key().unwrap();
+        let raw_scripts = [raw_aliased_script.clone()];
+        let (raw_address, raw_spend_info) = create_taproot_addr(
+            &Network::Regtest,
+            SpendPath::Both {
+                internal_key,
+                scripts: &raw_scripts,
+            },
+        )
+        .unwrap();
+        let raw_output = TxOut {
+            value: Amount::from_sat(100_000),
+            script_pubkey: raw_address.script_pubkey(),
+        };
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                raw_output.clone(),
+                TxOut {
+                    value: node.coinbase_amount() - raw_output.value - FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+
+        let spending_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([
+                OutPoint::new(funding_txid, 0),
+                node.next_coinbase_outpoint(),
+            ]),
+            output: vec![TxOut {
+                value: node.coinbase_amount() + raw_output.value - FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let prevouts = [raw_output.clone(), node.coinbase_tx_out()];
+        let mut cache = SighashCache::new(&spending_tx);
+        let shared_message = create_script_spend_hash(
+            &mut cache,
+            &raw_aliased_script,
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .unwrap();
+        let shared_signature = shared_keypair.sign_schnorr(shared_message).serialize();
+        let script_version = (raw_aliased_script.clone(), LeafVersion::TapScript);
+        let control_block = raw_spend_info.control_block(&script_version).unwrap();
+        let mut psbt = Psbt::from_unsigned_tx(spending_tx).unwrap();
+        psbt.inputs[0].witness_utxo = Some(raw_output);
+        psbt.inputs[1].witness_utxo = Some(node.coinbase_tx_out());
+        finalize_psbt_input(
+            &mut psbt.inputs[0],
+            [
+                shared_signature.to_vec(),
+                shared_signature.to_vec(),
+                raw_aliased_script.to_bytes(),
+                control_block.serialize(),
+            ],
+        );
+        let bypass = node.sign(&psbt.extract_tx().unwrap());
+        assert!(node.client().send_raw_transaction(&bypass).is_ok());
+
+        let rejected = ContestCounterproofOutputV2::new(
+            Network::Regtest,
+            shared_pubkey,
+            shared_pubkey,
+            1,
+            Amount::ZERO,
+            nums_context(3),
+        );
+        assert!(matches!(
+            rejected,
+            Err(ContestCounterproofV2Error::GraphOperatorKeyAlias)
+        ));
+    }
+}
