index 00000000..3e7ba985
--- /dev/null
+++ b/crates/tx-graph/src/transactions/contest_v2.rs
@@ -0,0 +1,1146 @@
+//! Draft v0.26 contest transaction.
+//!
+//! This transaction creates only fresh v2 counterproof-funding outputs and
+//! fresh script-only payout/slash gates. It has no conversion from `ContestTx`
+//! and accepts no v1 counterproof, payout, or slash connector type.
+//! Its research fee ceiling prevents unchecked donation only; activation must
+//! bind that ceiling and verify measured finalized vsize/feerate externally.
+
+use std::{collections::HashSet, error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::{self, ExtractTxError, Psbt},
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, Network, OutPoint, ScriptBuf, Transaction, TxIn, TxOut, Txid, XOnlyPublicKey,
+};
+use secp256k1::schnorr;
+use strata_bridge_connectors::{
+    prelude::{
+        ClaimContestConnector, ClaimContestSpendPath, ClaimContestWitness,
+        ContestCounterproofOutputV2, ContestPayoutGateV2, ContestProofConnector,
+        ContestSlashGateV2, MultiAnchor,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    prelude::ClaimTx,
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+};
+
+/// Inputs that identify the exact v2 contest parent.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ContestV2Data {
+    /// Transaction id of the claim transaction.
+    pub claim_txid: Txid,
+}
+
+/// One locally inseparable C/CPFP-control pair in contest alternative order.
+///
+/// This pairing prevents two independent vectors from drifting inside one
+/// construction call. Binding this order to `ClaimContestConnector`,
+/// `SetupIntent`, and the canonical participant roster remains an external
+/// graph-construction obligation because the claim connector exposes only its
+/// roster length.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ContestAlternativeV2 {
+    /// Fresh counterproof-funding connector for this alternative.
+    pub counterproof_output: ContestCounterproofOutputV2,
+    /// CPFP control key for the same alternative.
+    pub cpfp_pubkey: XOnlyPublicKey,
+}
+
+/// Exact output and explicit fee plan for [`ContestV2Tx`].
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ContestV2OutputPlan {
+    /// Existing proof output category retained by the v2 contest.
+    pub proof_connector: ContestProofConnector,
+    /// Fresh script-only shared payout/selection gate.
+    pub payout_gate: ContestPayoutGateV2,
+    /// Fresh script-only shared timeout/slash gate.
+    pub slash_gate: ContestSlashGateV2,
+    /// Nonempty alternatives in externally verified canonical roster order.
+    pub alternatives: Vec<ContestAlternativeV2>,
+    /// Exact nonzero, dust-valid CPFP anchor value.
+    pub cpfp_anchor_value: Amount,
+    /// Exact miner fee committed by the transaction template.
+    pub fee: Amount,
+    /// Research ceiling bound specifically to the Contest template.
+    pub fee_allowance: TemplateFeeAllowanceV2,
+}
+
+/// Fresh v0.26 contest transaction.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ContestV2Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    claim_contest_connector: ClaimContestConnector,
+    proof_connector: ContestProofConnector,
+    payout_gate: ContestPayoutGateV2,
+    slash_gate: ContestSlashGateV2,
+    counterproof_outputs: Box<[ContestCounterproofOutputV2]>,
+    cpfp_connector: MultiAnchor,
+    cpfp_vout: u32,
+    fee: Amount,
+}
+
+impl ContestV2Tx {
+    /// Index of the proof output.
+    pub const PROOF_VOUT: u32 = 0;
+    /// Index of the fresh shared payout gate.
+    pub const PAYOUT_GATE_VOUT: u32 = 1;
+    /// Index of the fresh shared slash gate.
+    pub const SLASH_GATE_VOUT: u32 = 2;
+    /// Index of the first fresh counterproof-funding output.
+    pub const COUNTERPROOF_0_VOUT: u32 = 3;
+    /// Number of transaction inputs.
+    pub const N_INPUTS: usize = 1;
+
+    /// Constructs the exact v2 output roster with an explicit miner fee.
+    ///
+    /// The alternative vector must be nonempty and exactly match the claim
+    /// connector's committed roster length. The caller must separately verify
+    /// that this local order equals the canonical setup/claim roster order.
+    pub fn new(
+        data: ContestV2Data,
+        claim_contest_connector: ClaimContestConnector,
+        output_plan: ContestV2OutputPlan,
+    ) -> Result<Self, ContestV2Error> {
+        let ContestV2OutputPlan {
+            proof_connector,
+            payout_gate,
+            slash_gate,
+            alternatives,
+            cpfp_anchor_value,
+            fee,
+            fee_allowance,
+        } = output_plan;
+        let counterproof_outputs: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| alternative.counterproof_output)
+            .collect();
+        let cpfp_watchtower_pubkeys: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| alternative.cpfp_pubkey)
+            .collect();
+        let counterproof_count = counterproof_outputs.len();
+        if counterproof_count == 0 {
+            return Err(ContestV2Error::EmptyRoster);
+        }
+        let cpfp_vout = checked_cpfp_vout(counterproof_count)?;
+        let claim_count = claim_contest_connector.n_watchtowers() as usize;
+        if claim_count != counterproof_count {
+            return Err(ContestV2Error::ClaimRosterLengthMismatch {
+                claim_count,
+                contest_count: counterproof_count,
+            });
+        }
+
+        let network = claim_contest_connector.network();
+        validate_network(network, proof_connector.network(), "proof", None)?;
+        validate_network(network, payout_gate.network(), "payout gate", None)?;
+        validate_network(network, slash_gate.network(), "slash gate", None)?;
+        for (index, connector) in counterproof_outputs.iter().enumerate() {
+            validate_network(
+                network,
+                connector.network(),
+                "counterproof output",
+                Some(index),
+            )?;
+        }
+        let mut seen_counterproof_internal_keys = HashSet::with_capacity(counterproof_count);
+        for (index, connector) in counterproof_outputs.iter().enumerate() {
+            if !seen_counterproof_internal_keys.insert(connector.internal_key()) {
+                return Err(ContestV2Error::DuplicateCounterproofInternalKey { index });
+            }
+        }
+
+        let mut known_nums = Vec::with_capacity(4 + counterproof_count * 2);
+        known_nums.extend(known_nums_keys("contest payout P", &payout_gate));
+        known_nums.extend(known_nums_keys("contest Slash S", &slash_gate));
+        for connector in &counterproof_outputs {
+            known_nums.extend(known_nums_keys("contest counterproof C", connector));
+        }
+        for (index, key) in cpfp_watchtower_pubkeys.iter().copied().enumerate() {
+            for nums in &known_nums {
+                if key == nums.key {
+                    return Err(ContestV2Error::CpfpNumsKeyAlias {
+                        index,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+        }
+
+        let mut seen_cpfp_keys = HashSet::with_capacity(counterproof_count);
+        for (index, key) in cpfp_watchtower_pubkeys.iter().copied().enumerate() {
+            if !seen_cpfp_keys.insert(key) {
+                return Err(ContestV2Error::DuplicateCpfpKey { index });
+            }
+        }
+        if fee > Amount::MAX_MONEY {
+            return Err(ContestV2Error::FeeAboveMaxMoney { fee });
+        }
+        fee_allowance
+            .validate(TemplateKindV2::Contest, fee)
+            .map_err(ContestV2Error::FeeAllowance)?;
+
+        let cpfp_connector = MultiAnchor::new(network, cpfp_watchtower_pubkeys, cpfp_anchor_value);
+        let prevouts = [claim_contest_connector.tx_out()];
+        validate_value(&prevouts[0], "claim prevout", None)?;
+
+        let mut output = vec![
+            proof_connector.tx_out(),
+            payout_gate.tx_out(),
+            slash_gate.tx_out(),
+        ];
+        output.extend(counterproof_outputs.iter().map(Connector::tx_out));
+        output.push(cpfp_connector.tx_out());
+
+        for (index, tx_out) in output.iter().enumerate() {
+            validate_value(tx_out, output_label(index, counterproof_count), Some(index))?;
+        }
+        validate_unique_output_scripts(&output)?;
+
+        let value_in = checked_value_sum(prevouts.iter(), ValueAggregate::Inputs)?;
+        let value_out = checked_value_sum(output.iter(), ValueAggregate::Outputs)?;
+        let value_out_with_fee =
+            value_out
+                .checked_add(fee)
+                .ok_or(ContestV2Error::AggregateValueOverflow {
+                    aggregate: ValueAggregate::OutputsAndFee,
+                })?;
+        if value_out_with_fee > Amount::MAX_MONEY {
+            return Err(ContestV2Error::AggregateValueAboveMaxMoney {
+                aggregate: ValueAggregate::OutputsAndFee,
+                value: value_out_with_fee,
+            });
+        }
+        if value_in != value_out_with_fee {
+            return Err(ContestV2Error::ValueConservation {
+                value_in,
+                value_out,
+                fee,
+            });
+        }
+
+        let input = vec![TxIn {
+            previous_output: OutPoint {
+                txid: data.claim_txid,
+                vout: ClaimTx::CONTEST_VOUT,
+            },
+            sequence: claim_contest_connector.sequence(ClaimContestSpendPath::Contested {
+                watchtower_index: 0,
+            }),
+            ..Default::default()
+        }];
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(ContestV2Error::PsbtConstruction)?;
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+
+        Ok(Self {
+            psbt,
+            prevouts,
+            claim_contest_connector,
+            proof_connector,
+            payout_gate,
+            slash_gate,
+            counterproof_outputs: counterproof_outputs.into_boxed_slice(),
+            cpfp_connector,
+            cpfp_vout,
+            fee,
+        })
+    }
+
+    /// Returns the output index for an ordered watchtower alternative.
+    pub fn counterproof_vout(&self, watchtower_index: usize) -> Result<u32, ContestV2Error> {
+        if watchtower_index >= self.counterproof_outputs.len() {
+            return Err(ContestV2Error::WatchtowerIndexOutOfBounds {
+                index: watchtower_index,
+                count: self.counterproof_outputs.len(),
+            });
+        }
+        let index = u32::try_from(watchtower_index).map_err(|_| {
+            ContestV2Error::WatchtowerIndexOutOfBounds {
+                index: watchtower_index,
+                count: self.counterproof_outputs.len(),
+            }
+        })?;
+        Self::COUNTERPROOF_0_VOUT.checked_add(index).ok_or(
+            ContestV2Error::WatchtowerIndexOutOfBounds {
+                index: watchtower_index,
+                count: self.counterproof_outputs.len(),
+            },
+        )
+    }
+
+    /// Returns the CPFP output index.
+    pub const fn cpfp_vout(&self) -> u32 {
+        self.cpfp_vout
+    }
+
+    /// Returns the explicit fee committed by the exact transaction template.
+    pub const fn fee(&self) -> Amount {
+        self.fee
+    }
+
+    /// Returns the fresh counterproof-funding connectors in committed order.
+    pub fn counterproof_outputs(&self) -> &[ContestCounterproofOutputV2] {
+        &self.counterproof_outputs
+    }
+
+    /// Computes the exact contested-claim signing message.
+    pub fn signing_info(&self, watchtower_index: u32) -> Result<SigningInfo, ContestV2Error> {
+        if watchtower_index >= self.claim_contest_connector.n_watchtowers() {
+            return Err(ContestV2Error::WatchtowerIndexOutOfBounds {
+                index: watchtower_index as usize,
+                count: self.counterproof_outputs.len(),
+            });
+        }
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        Ok(self.claim_contest_connector.get_signing_info(
+            &mut cache,
+            Prevouts::All(&self.prevouts),
+            ClaimContestSpendPath::Contested { watchtower_index },
+            0,
+        ))
+    }
+
+    /// Finalizes the exact contested-claim input.
+    pub fn finalize(
+        self,
+        graph_signature: schnorr::Signature,
+        watchtower_index: u32,
+        watchtower_signature: schnorr::Signature,
+    ) -> Result<Transaction, ContestV2Error> {
+        if watchtower_index >= self.claim_contest_connector.n_watchtowers() {
+            return Err(ContestV2Error::WatchtowerIndexOutOfBounds {
+                index: watchtower_index as usize,
+                count: self.counterproof_outputs.len(),
+            });
+        }
+
+        let mut psbt = self.psbt;
+        let witness = ClaimContestWitness::Contested {
+            n_of_n_signature: graph_signature,
+            watchtower_index,
+            watchtower_signature,
+        };
+        self.claim_contest_connector
+            .finalize_input(&mut psbt.inputs[0], &witness);
+        psbt.extract_tx()
+            .map_err(|error| ContestV2Error::PsbtExtraction(Box::new(error)))
+    }
+}
+
+impl ParentTx for ContestV2Tx {
+    type CpfpConnector = MultiAnchor;
+
+    fn cpfp_tx_out(&self) -> TxOut {
+        self.cpfp_connector.tx_out()
+    }
+
+    fn cpfp_outpoint(&self) -> OutPoint {
+        OutPoint {
+            txid: self.psbt.unsigned_tx.compute_txid(),
+            vout: self.cpfp_vout(),
+        }
+    }
+
+    fn cpfp_connector(&self) -> &Self::CpfpConnector {
+        &self.cpfp_connector
+    }
+}
+
+impl AsRef<Transaction> for ContestV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+fn validate_network(
+    expected: Network,
+    actual: Network,
+    component: &'static str,
+    index: Option<usize>,
+) -> Result<(), ContestV2Error> {
+    if actual != expected {
+        return Err(ContestV2Error::NetworkMismatch {
+            component,
+            index,
+            expected,
+            actual,
+        });
+    }
+    Ok(())
+}
+
+fn validate_value(
+    tx_out: &TxOut,
+    component: &'static str,
+    index: Option<usize>,
+) -> Result<(), ContestV2Error> {
+    if tx_out.value > Amount::MAX_MONEY {
+        return Err(ContestV2Error::ValueAboveMaxMoney {
+            component,
+            index,
+            value: tx_out.value,
+        });
+    }
+    let minimum = tx_out.script_pubkey.minimal_non_dust();
+    if tx_out.value == Amount::ZERO || tx_out.value < minimum {
+        return Err(ContestV2Error::DustValue {
+            component,
+            index,
+            value: tx_out.value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+fn checked_value_sum<'a>(
+    tx_outs: impl IntoIterator<Item = &'a TxOut>,
+    aggregate: ValueAggregate,
+) -> Result<Amount, ContestV2Error> {
+    let mut total = Amount::ZERO;
+    for tx_out in tx_outs {
+        total = total
+            .checked_add(tx_out.value)
+            .ok_or(ContestV2Error::AggregateValueOverflow { aggregate })?;
+        if total > Amount::MAX_MONEY {
+            return Err(ContestV2Error::AggregateValueAboveMaxMoney {
+                aggregate,
+                value: total,
+            });
+        }
+    }
+    Ok(total)
+}
+
+fn validate_unique_output_scripts(output: &[TxOut]) -> Result<(), ContestV2Error> {
+    let mut seen = HashSet::<ScriptBuf>::with_capacity(output.len());
+    for (index, tx_out) in output.iter().enumerate() {
+        if !seen.insert(tx_out.script_pubkey.clone()) {
+            return Err(ContestV2Error::DuplicateOutputScript { index });
+        }
+    }
+    Ok(())
+}
+
+fn checked_cpfp_vout(counterproof_count: usize) -> Result<u32, ContestV2Error> {
+    let max = (u32::MAX - ContestV2Tx::COUNTERPROOF_0_VOUT) as usize;
+    if counterproof_count > max {
+        return Err(ContestV2Error::TooManyAlternatives {
+            count: counterproof_count,
+            max,
+        });
+    }
+    let count =
+        u32::try_from(counterproof_count).map_err(|_| ContestV2Error::TooManyAlternatives {
+            count: counterproof_count,
+            max,
+        })?;
+    ContestV2Tx::COUNTERPROOF_0_VOUT
+        .checked_add(count)
+        .ok_or(ContestV2Error::TooManyAlternatives {
+            count: counterproof_count,
+            max,
+        })
+}
+
+const fn output_label(index: usize, counterproof_count: usize) -> &'static str {
+    match index {
+        0 => "proof output",
+        1 => "payout gate",
+        2 => "slash gate",
+        index if index < 3 + counterproof_count => "counterproof output",
+        _ => "CPFP anchor",
+    }
+}
+
+/// Value aggregate that failed a checked monetary-range condition.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ValueAggregate {
+    /// Contest inputs.
+    Inputs,
+    /// Contest outputs.
+    Outputs,
+    /// Contest outputs plus the explicit miner fee.
+    OutputsAndFee,
+}
+
+impl fmt::Display for ValueAggregate {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Inputs => f.write_str("inputs"),
+            Self::Outputs => f.write_str("outputs"),
+            Self::OutputsAndFee => f.write_str("outputs plus fee"),
+        }
+    }
+}
+
+/// Rejected v2 contest topology, economics, or witness finalization.
+#[derive(Debug)]
+pub enum ContestV2Error {
+    /// Counterproof and CPFP rosters must be nonempty.
+    EmptyRoster,
+    /// The alternative roster cannot be represented by Bitcoin output indexes.
+    TooManyAlternatives {
+        /// Rejected number of alternatives.
+        count: usize,
+        /// Maximum representable number for this output prefix.
+        max: usize,
+    },
+    /// The runtime roster does not match the claim connector's fixed roster.
+    ClaimRosterLengthMismatch {
+        /// Number committed by the claim connector.
+        claim_count: usize,
+        /// Number supplied to this transaction.
+        contest_count: usize,
+    },
+    /// A connector is for a different Bitcoin network.
+    NetworkMismatch {
+        /// Semantic output category.
+        component: &'static str,
+        /// Ordered index for vector categories.
+        index: Option<usize>,
+        /// Claim connector network.
+        expected: Network,
+        /// Rejected connector network.
+        actual: Network,
+    },
+    /// A repeated CPFP key destroys the one-entry-per-alternative roster.
+    DuplicateCpfpKey {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// A caller reused one research NUMS context for multiple C outputs.
+    DuplicateCounterproofInternalKey {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// A MultiAnchor controller aliases an unspendable v2 NUMS key.
+    CpfpNumsKeyAlias {
+        /// Alternative whose CPFP controller reused the key.
+        index: usize,
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// The explicit fee exceeds Bitcoin's monetary range.
+    FeeAboveMaxMoney {
+        /// Rejected fee.
+        fee: Amount,
+    },
+    /// The fee exceeds or is not bound by the exact Contest allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// A prevout or output exceeds Bitcoin's monetary range.
+    ValueAboveMaxMoney {
+        /// Semantic value category.
+        component: &'static str,
+        /// Ordered index when applicable.
+        index: Option<usize>,
+        /// Rejected amount.
+        value: Amount,
+    },
+    /// A required spendable prevout or output is zero or dust.
+    DustValue {
+        /// Semantic value category.
+        component: &'static str,
+        /// Ordered index when applicable.
+        index: Option<usize>,
+        /// Rejected amount.
+        value: Amount,
+        /// Actual script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// Two semantic output categories resolve to the same scriptPubKey.
+    DuplicateOutputScript {
+        /// Index of the later duplicate output.
+        index: usize,
+    },
+    /// Checked summation overflowed the amount representation.
+    AggregateValueOverflow {
+        /// Aggregate being computed.
+        aggregate: ValueAggregate,
+    },
+    /// An aggregate exceeds Bitcoin Core's monetary range.
+    AggregateValueAboveMaxMoney {
+        /// Aggregate being computed.
+        aggregate: ValueAggregate,
+        /// Rejected aggregate value.
+        value: Amount,
+    },
+    /// Input value is not exactly outputs plus the explicit fee.
+    ValueConservation {
+        /// Exact input sum.
+        value_in: Amount,
+        /// Exact output sum.
+        value_out: Amount,
+        /// Explicit miner fee.
+        fee: Amount,
+    },
+    /// A caller selected an alternative outside the committed roster.
+    WatchtowerIndexOutOfBounds {
+        /// Rejected index.
+        index: usize,
+        /// Committed roster length.
+        count: usize,
+    },
+    /// The unsigned transaction could not be represented as a PSBT.
+    PsbtConstruction(psbt::Error),
+    /// The finalized transaction could not be extracted from its PSBT.
+    PsbtExtraction(Box<ExtractTxError>),
+}
+
+impl fmt::Display for ContestV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyRoster => f.write_str("v2 contest rosters must be nonempty"),
+            Self::TooManyAlternatives { count, max } => write!(
+                f,
+                "v2 contest has {count} alternatives, exceeding output-index maximum {max}"
+            ),
+            Self::ClaimRosterLengthMismatch {
+                claim_count,
+                contest_count,
+            } => write!(
+                f,
+                "claim commits {claim_count} watchtowers but v2 contest supplies {contest_count}"
+            ),
+            Self::NetworkMismatch {
+                component,
+                index,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "{component}{} uses {actual}, expected {expected}",
+                index.map_or_else(String::new, |index| format!("[{index}]"))
+            ),
+            Self::DuplicateCpfpKey { index } => {
+                write!(f, "CPFP key at index {index} duplicates an earlier key")
+            }
+            Self::DuplicateCounterproofInternalKey { index } => write!(
+                f,
+                "counterproof output at index {index} reuses an earlier research NUMS key"
+            ),
+            Self::CpfpNumsKeyAlias {
+                index,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "CPFP key at index {index} aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::FeeAboveMaxMoney { fee } => write!(f, "explicit fee {fee} exceeds MAX_MONEY"),
+            Self::FeeAllowance(error) => write!(f, "invalid Contest fee allowance: {error}"),
+            Self::ValueAboveMaxMoney {
+                component,
+                index,
+                value,
+            } => write!(
+                f,
+                "{component}{} value {value} exceeds MAX_MONEY",
+                index.map_or_else(String::new, |index| format!("[{index}]"))
+            ),
+            Self::DustValue {
+                component,
+                index,
+                value,
+                minimum,
+            } => write!(
+                f,
+                "{component}{} value {value} is below its dust floor {minimum}",
+                index.map_or_else(String::new, |index| format!("[{index}]"))
+            ),
+            Self::DuplicateOutputScript { index } => {
+                write!(
+                    f,
+                    "output script at index {index} duplicates an earlier output"
+                )
+            }
+            Self::AggregateValueOverflow { aggregate } => {
+                write!(f, "{aggregate} aggregate overflowed")
+            }
+            Self::AggregateValueAboveMaxMoney { aggregate, value } => {
+                write!(f, "{aggregate} aggregate {value} exceeds MAX_MONEY")
+            }
+            Self::ValueConservation {
+                value_in,
+                value_out,
+                fee,
+            } => write!(
+                f,
+                "value conservation failed: input {value_in}, output {value_out}, fee {fee}"
+            ),
+            Self::WatchtowerIndexOutOfBounds { index, count } => {
+                write!(
+                    f,
+                    "watchtower index {index} is outside roster length {count}"
+                )
+            }
+            Self::PsbtConstruction(error) => write!(f, "PSBT construction failed: {error}"),
+            Self::PsbtExtraction(error) => write!(f, "PSBT extraction failed: {error}"),
+        }
+    }
+}
+
+impl Error for ContestV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::PsbtConstruction(error) => Some(error),
+            Self::PsbtExtraction(error) => Some(error.as_ref()),
+            _ => None,
+        }
+    }
+}
