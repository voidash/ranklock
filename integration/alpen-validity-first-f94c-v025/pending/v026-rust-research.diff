+            &encoded[ENVELOPE_MAGIC.len()..ENVELOPE_HEADER_LEN],
+            &ENVELOPE_VERSION_V2.to_le_bytes()
+        );
+        assert_eq!(
+            V026AdmissionValueV2::deserialize(&encoded).expect("V2 observation deserializes"),
+            value
+        );
+    }
+
+    #[test]
+    fn malformed_version_two_envelopes_fail_closed() {
+        let value = V026AdmissionValueV2(record());
+        let encoded = value.serialize().expect("V2 observation serializes");
+
+        assert!(matches!(
+            V026AdmissionValueV2::deserialize(&encoded[..ENVELOPE_HEADER_LEN - 1]),
+            Err(V026AdmissionDeserializeErrorV2::UnexpectedEof { .. })
+        ));
+
+        let mut bad_magic = encoded.clone();
+        bad_magic[0] ^= 1;
+        assert!(matches!(
+            V026AdmissionValueV2::deserialize(&bad_magic),
+            Err(V026AdmissionDeserializeErrorV2::InvalidMagic)
+        ));
+
+        let mut v1 = encoded.clone();
+        v1[ENVELOPE_MAGIC.len()..ENVELOPE_HEADER_LEN].copy_from_slice(&1_u16.to_le_bytes());
+        assert!(matches!(
+            V026AdmissionValueV2::deserialize(&v1),
+            Err(V026AdmissionDeserializeErrorV2::UnsupportedVersion { version: 1 })
+        ));
+
+        let mut trailing = encoded;
+        trailing.push(0);
+        assert!(matches!(
+            V026AdmissionValueV2::deserialize(&trailing),
+            Err(V026AdmissionDeserializeErrorV2::TrailingBytes { count: 1 })
+        ));
+    }
+
+    #[test]
+    fn nonminimal_v2_fields_fail_canonical_reencode() {
+        let canonical = V026AdmissionValueV2(record())
+            .serialize()
+            .expect("V2 observation serializes");
+        let body = &canonical[ENVELOPE_HEADER_LEN..];
+        let alternative_count_offset = 2 + 32 + 32;
+        let first_blocker_offset = body.len() - V026_BLOCKERS_V2.len();
+        for (label, body_offset, expected, postcard_accepts_nonminimal) in [
+            ("deposit index", 0, 17_u8, true),
+            ("alternative count", alternative_count_offset, 2_u8, false),
+            ("first blocker", first_blocker_offset, 1_u8, true),
+        ] {
+            assert_eq!(
+                body[body_offset], expected,
+                "unexpected {label} fixture byte"
+            );
+            let mut nonminimal = canonical.clone();
+            let offset = ENVELOPE_HEADER_LEN + body_offset;
+            nonminimal.splice(offset..=offset, [expected | 0x80, 0]);
+            let result = V026AdmissionValueV2::deserialize(&nonminimal);
+            if postcard_accepts_nonminimal {
+                assert!(
+                    matches!(
+                        result,
+                        Err(V026AdmissionDeserializeErrorV2::NonCanonicalBody)
+                    ),
+                    "unexpected {label} decode result: {result:?}"
+                );
+            } else {
+                assert!(
+                    matches!(result, Err(V026AdmissionDeserializeErrorV2::Postcard(_))),
+                    "unexpected {label} decode result: {result:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn unknown_seventeen_and_noncanonical_blocker_array_fail_closed() {
+        let mut encoded = V026AdmissionValueV2(record())
+            .serialize()
+            .expect("V2 observation serializes");
+        let final_blocker = encoded.last_mut().expect("encoded body is nonempty");
+        assert_eq!(
+            *final_blocker,
+            V026BlockerCodeV2::AtomicRosterWeightEvidenceUnverified as u8
+        );
+        *final_blocker = 17;
+        assert!(matches!(
+            V026AdmissionValueV2::deserialize(&encoded),
+            Err(V026AdmissionDeserializeErrorV2::Postcard(_))
+        ));
+
+        let valid = record();
+        let mut blockers = V026_BLOCKERS_V2;
+        blockers[15] = blockers[14];
+        let invalid = V026AdmissionBodyV2 {
+            graph_idx: valid.graph_idx,
+            local_manifest: valid.local_manifest,
+            blockers,
+        };
+        assert!(matches!(
+            V026AdmissionValueV2(invalid).serialize(),
+            Err(V026AdmissionSerializeErrorV2::InvalidRecord(
+                V026PersistedObservationErrorV2::BlockerSetMismatch
+            ))
+        ));
+    }
+}
