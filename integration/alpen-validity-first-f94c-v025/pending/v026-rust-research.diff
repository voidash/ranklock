+//! Draft v0.26 counterproof-funding connector.
+//!
+//! This is a fresh connector type. It deliberately has no conversion from the
+//! v1 `ContestCounterproofOutput`, so v1 scripts, signatures, and adaptor
+//! material cannot be wrapped and relabeled as v2 protocol material.
+//!
+//! The reserve-recovery leaf is immediate and graph-signature-only. CHECKSIG
+//! is not a covenant: it is safe only when the graph-signing ceremony signs a
+//! complete allowlist of exact `SIGHASH_DEFAULT` transactions and then proves
+//! the required graph-key erasure before funding.
+
+use std::{error::Error, fmt, num::NonZero};
+
+use bitcoin::{opcodes, psbt::Input, script, Amount, Network, ScriptBuf};
+use secp256k1::{schnorr, XOnlyPublicKey};
+
+use crate::{
+    ranklock_nums::{NumsDerivationError, ResearchV0NumsContext, ResearchV0NumsRole},
+    Connector, TaprootWitness,
+};
+
+/// Minimum number of operator signatures in a v2 counterproof-funding spend.
+pub const MIN_CONTEST_COUNTERPROOF_V2_DATA: usize = 1;
+/// Maximum number of operator signatures in a v2 counterproof-funding spend.
+///
+/// Tapscript limits the combined main and alt stacks to 1,000 elements. The
+/// initial stack contains `n_data` operator signatures and one graph
+/// signature. The script then pushes the graph public key before consuming its
+/// signature, so the peak is `n_data + 2`. Therefore the consensus-derived
+/// upper bound is `n_data + 2 <= 1,000`.
+///
+/// This is not a funding profile. A reviewed WireProfile may select a tighter
+/// policy bound, but it must never exceed this consensus bound.
+pub const MAX_CONTEST_COUNTERPROOF_V2_DATA: usize = 998;
+
+/// Fresh v0.26 output between `ContestV2` and one `CounterproofV2_i`.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ContestCounterproofOutputV2 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    operator_pubkey: XOnlyPublicKey,
+    n_data: NonZero<usize>,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl ContestCounterproofOutputV2 {
+    /// Constructs a fresh, research-profile v2 counterproof-funding output.
+    ///
+    /// `n_data` counts operator signatures placed in the initial Tapscript
+    /// stack. The caller supplies a research NUMS context with the dedicated
+    /// v2 contest-counterproof role. Its caller-chosen index is only a fixture
+    /// discriminator until the WireProfile freezes index semantics. The
+    /// resulting connector remains
+    /// funding-ineligible until the WireProfile freezes authoritative role
+    /// bytes and a tighter operational resource limit, if required.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        operator_pubkey: XOnlyPublicKey,
+        n_data: usize,
+        surcharge: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, ContestCounterproofV2Error> {
+        if !(MIN_CONTEST_COUNTERPROOF_V2_DATA..=MAX_CONTEST_COUNTERPROOF_V2_DATA).contains(&n_data)
+        {
+            return Err(ContestCounterproofV2Error::InvalidDataCount { actual: n_data });
+        }
+        if graph_pubkey == operator_pubkey {
+            return Err(ContestCounterproofV2Error::GraphOperatorKeyAlias);
+        }
+        if nums_context.role() != ResearchV0NumsRole::ContestCounterproof {
+            return Err(ContestCounterproofV2Error::WrongNumsRole);
+        }
+
+        let internal_key = nums_context
+            .derive_internal_key()
+            .map_err(ContestCounterproofV2Error::NumsDerivation)?;
+        let n_data = NonZero::new(n_data)
+            .ok_or(ContestCounterproofV2Error::InvalidDataCount { actual: n_data })?;
+        let mut connector = Self {
+            network,
+            graph_pubkey,
+            operator_pubkey,
+            n_data,
+            value: Amount::ZERO,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if graph_pubkey == internal_key || graph_pubkey == output_key {
+            return Err(ContestCounterproofV2Error::GraphNumsKeyAlias);
+        }
+        if operator_pubkey == internal_key || operator_pubkey == output_key {
+            return Err(ContestCounterproofV2Error::OperatorNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        let value = minimum
+            .checked_add(surcharge)
+            .ok_or(ContestCounterproofV2Error::ValueOverflow { minimum, surcharge })?;
+        if value > Amount::MAX_MONEY {
+            return Err(ContestCounterproofV2Error::ValueExceedsMaxMoney { value });
+        }
+        connector.value = value;
+        Ok(connector)
+    }
+
+    /// Returns the exact nonzero number of required operator signatures.
+    pub const fn n_data(&self) -> NonZero<usize> {
+        self.n_data
+    }
+
+    /// Returns the graph key controlling the exact counterproof script path.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    /// Returns the operator key required once per committed datum.
+    pub const fn operator_pubkey(&self) -> XOnlyPublicKey {
+        self.operator_pubkey
+    }
+
+    /// Checks that a witness carries exactly one operator signature per datum.
+    pub const fn validate_operator_witness_count(
+        &self,
+        operator_signatures: &[schnorr::Signature],
+    ) -> Result<(), ContestCounterproofV2Error> {
+        let expected = self.n_data.get();
+        let actual = operator_signatures.len();
+        if actual != expected {
+            return Err(ContestCounterproofV2Error::OperatorWitnessCount { expected, actual });
+        }
+        Ok(())
+    }
+
+    /// Constructs a counterproof-path witness after validating its exact operator count.
+    pub fn counterproof_witness(
+        &self,
+        graph_signature: schnorr::Signature,
+        operator_signatures: Vec<schnorr::Signature>,
+    ) -> Result<ContestCounterproofWitnessV2, ContestCounterproofV2Error> {
+        self.validate_operator_witness_count(&operator_signatures)?;
+        Ok(ContestCounterproofWitnessV2::Counterproof {
+            graph_signature,
+            operator_signatures: operator_signatures.into_boxed_slice(),
+        })
+    }
+
+    /// Constructs an immediate reserve-recovery-path witness.
+    pub const fn reserve_recovery_witness(
+        &self,
+        graph_signature: schnorr::Signature,
+    ) -> ContestCounterproofWitnessV2 {
+        ContestCounterproofWitnessV2::ReserveRecovery { graph_signature }
+    }
+
+    /// Validates and finalizes a PSBT input through the expected v2 script path.
+    pub fn try_finalize_input(
+        &self,
+        input: &mut Input,
+        expected_path: ContestCounterproofSpendV2,
+        witness: &ContestCounterproofWitnessV2,
+    ) -> Result<(), ContestCounterproofV2Error> {
+        let actual_path = witness.spend_path();
+        if actual_path != expected_path {
+            return Err(ContestCounterproofV2Error::WitnessSpendPathMismatch {
+                expected: expected_path,
+                actual: actual_path,
+            });
+        }
+        if let ContestCounterproofWitnessV2::Counterproof {
+            operator_signatures,
+            ..
+        } = witness
+        {
+            self.validate_operator_witness_count(operator_signatures)?;
+        }
+        Connector::finalize_input(self, input, witness);
+        Ok(())
+    }
+
+    fn counterproof_script(&self) -> ScriptBuf {
+        let mut builder = script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+            .push_slice(self.operator_pubkey.serialize());
+
+        for _ in 0..self.n_data.get() - 1 {
+            builder = builder
+                .push_opcode(opcodes::all::OP_TUCK)
+                .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+                .push_opcode(opcodes::all::OP_CODESEPARATOR);
+        }
+
+        builder.push_opcode(opcodes::all::OP_CHECKSIG).into_script()
+    }
+
+    fn reserve_recovery_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
+
+impl Connector for ContestCounterproofOutputV2 {
+    type SpendPath = ContestCounterproofSpendV2;
+    type Witness = ContestCounterproofWitnessV2;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.counterproof_script(), self.reserve_recovery_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, spend_path: Self::SpendPath) -> Option<usize> {
+        Some(match spend_path {
+            ContestCounterproofSpendV2::Counterproof => 0,
+            ContestCounterproofSpendV2::ReserveRecovery => 1,
+        })
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        match witness {
+            ContestCounterproofWitnessV2::Counterproof {
+                graph_signature,
+                operator_signatures,
+            } => TaprootWitness::Script {
+                leaf_index: 0,
+                script_inputs: operator_signatures
+                    .iter()
+                    .rev()
+                    .map(|signature| signature.serialize().to_vec())
+                    .chain(std::iter::once(graph_signature.serialize().to_vec()))
+                    .collect(),
+            },
+            ContestCounterproofWitnessV2::ReserveRecovery { graph_signature } => {
+                TaprootWitness::Script {
+                    leaf_index: 1,
+                    script_inputs: vec![graph_signature.serialize().to_vec()],
+                }
+            }
+        }
+    }
+}
+
+/// Exact script paths of [`ContestCounterproofOutputV2`].
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ContestCounterproofSpendV2 {
+    /// Existing graph-and-operator counterproof authorization at leaf zero.
+    Counterproof,
+    /// Immediate graph-only reserve recovery at leaf one.
+    ReserveRecovery,
+}
+
+/// Validated witness for [`ContestCounterproofOutputV2`].
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub enum ContestCounterproofWitnessV2 {
+    /// Graph signature plus the exact committed number of operator signatures.
+    Counterproof {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+        /// Operator signatures in natural datum order.
+        operator_signatures: Box<[schnorr::Signature]>,
+    },
+    /// Graph-only authorization for an exact reserve-recovery parent.
+    ReserveRecovery {
+        /// Exact-parent graph signature using `SIGHASH_DEFAULT`.
+        graph_signature: schnorr::Signature,
+    },
+}
+
+impl ContestCounterproofWitnessV2 {
+    /// Returns the exact path selected by this typed witness.
+    pub const fn spend_path(&self) -> ContestCounterproofSpendV2 {
+        match self {
+            Self::Counterproof { .. } => ContestCounterproofSpendV2::Counterproof,
+            Self::ReserveRecovery { .. } => ContestCounterproofSpendV2::ReserveRecovery,
+        }
+    }
+
+    /// Returns the exact-parent graph signature.
+    pub const fn graph_signature(&self) -> schnorr::Signature {
+        match self {
+            Self::Counterproof {
+                graph_signature, ..
+            }
+            | Self::ReserveRecovery { graph_signature } => *graph_signature,
+        }
+    }
+
+    /// Returns operator signatures in natural datum order for the counterproof path.
+    pub fn operator_signatures(&self) -> Option<&[schnorr::Signature]> {
+        match self {
+            Self::Counterproof {
+                operator_signatures,
+                ..
+            } => Some(operator_signatures),
+            Self::ReserveRecovery { .. } => None,
+        }
+    }
+}
+
+/// Invalid v2 counterproof-funding connector policy or witness.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ContestCounterproofV2Error {
+    /// `n_data` is zero or exceeds the Tapscript initial-stack bound.
+    InvalidDataCount {
+        /// Rejected number of operator signatures.
+        actual: usize,
+    },
+    /// Graph and operator authorization must remain independent key domains.
+    GraphOperatorKeyAlias,
+    /// The graph authorization aliases the connector's unspendable NUMS key domain.
+    GraphNumsKeyAlias,
+    /// The operator authorization aliases the connector's unspendable NUMS key domain.
+    OperatorNumsKeyAlias,
+    /// A role other than the dedicated v2 contest-counterproof role was used.
+    WrongNumsRole,
+    /// The caller-bound research NUMS point could not be derived.
+    NumsDerivation(NumsDerivationError),
+    /// Adding the requested surcharge overflowed the amount representation.
+    ValueOverflow {
+        /// Script-dependent dust floor.
+        minimum: Amount,
+        /// Requested downstream-fee surcharge.
+        surcharge: Amount,
+    },
+    /// The output value exceeds Bitcoin Core's monetary range.
+    ValueExceedsMaxMoney {
+        /// Rejected connector value.
+        value: Amount,
+    },
+    /// The operator-signature witness vector has the wrong length.
+    OperatorWitnessCount {
+        /// Exact number committed by the connector.
+        expected: usize,
+        /// Number supplied by the witness.
+        actual: usize,
+    },
+    /// The witness variant does not match the caller's expected script path.
+    WitnessSpendPathMismatch {
+        /// Script path the caller intended to finalize.
+        expected: ContestCounterproofSpendV2,
+        /// Script path encoded by the typed witness.
+        actual: ContestCounterproofSpendV2,
+    },
+}
+
+impl fmt::Display for ContestCounterproofV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidDataCount { actual } => write!(
+                f,
+                "v2 contest counterproof requires {MIN_CONTEST_COUNTERPROOF_V2_DATA}..={MAX_CONTEST_COUNTERPROOF_V2_DATA} operator signatures, got {actual}"
+            ),
+            Self::GraphOperatorKeyAlias => {
+                f.write_str("v2 contest counterproof graph and operator keys must be distinct")
+            }
+            Self::GraphNumsKeyAlias => f.write_str(
+                "v2 contest counterproof graph key aliases its NUMS internal/output key",
+            ),
+            Self::OperatorNumsKeyAlias => f.write_str(
+                "v2 contest counterproof operator key aliases its NUMS internal/output key",
+            ),
+            Self::WrongNumsRole => {
+                f.write_str("v2 contest counterproof was given the wrong draft NUMS role")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::ValueOverflow { minimum, surcharge } => write!(
+                f,
+                "v2 contest counterproof value overflow: dust floor {minimum}, surcharge {surcharge}"
+            ),
+            Self::ValueExceedsMaxMoney { value } => {
+                write!(f, "v2 contest counterproof value {value} exceeds MAX_MONEY")
+            }
+            Self::OperatorWitnessCount { expected, actual } => write!(
+                f,
+                "v2 contest counterproof requires exactly {expected} operator signatures, got {actual}"
+            ),
+            Self::WitnessSpendPathMismatch { expected, actual } => write!(
+                f,
+                "v2 contest counterproof witness path {actual:?} does not match expected path {expected:?}"
+            ),
+        }
+    }
+}
+
+impl Error for ContestCounterproofV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::NumsDerivation(error) => Some(error),
+            _ => None,
+        }
+    }
+}
