+        assert!(matches!(
+            result,
+            Err(CounterproofAckV2Error::MoneyRange { .. })
+        ));
+
+        let resolution = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            vec![[1u8; 32], [2u8; 32]],
+            bitcoin::relative::Height::from_height(12),
+            Amount::from_sat(1_500),
+            ResearchV0NumsContext::new([6u8; 32], ResearchV0NumsRole::CounterproofResolution, 0),
+        )
+        .unwrap();
+        let authorization = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new([6u8; 32], ResearchV0NumsRole::SlashAuthorization, 0),
+        )
+        .unwrap();
+        let result = CounterproofAckV2Tx::new(
+            CounterproofAckV2Data {
+                resolution_outpoint: OutPoint::null(),
+            },
+            resolution,
+            authorization,
+            KeyedAnchor::new(
+                Network::Regtest,
+                anchor_keypair.x_only_public_key().0,
+                Amount::ZERO,
+            ),
