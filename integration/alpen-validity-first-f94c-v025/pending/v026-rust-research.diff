new file mode 100644
index 00000000..d3da4aeb
--- /dev/null
+++ b/crates/tx-graph/src/transactions/owner_payout_v2.rs
@@ -0,0 +1,1201 @@
+//! Versioned no-counterproof owner payout for the v0.26 research graph.
+//!
+//! The exact parent is `OwnerPayoutV2{D,Q,P,S,C_0..C_n-1} -> {owner,U_0..U_n-1}`.
+//! Every `C_i` takes its graph-only reserve-recovery leaf and is returned at its
+//! exact face value to a setup-bound descriptor. `D` and the legacy `Q`
+//! connector remain research placeholders, and the owner/return descriptors
+//! are caller-supplied setup commitments. This module neither proves hidden-
+//! signature exclusion nor establishes terminal economics or funding safety.
+//! P2TR type plus local controller/script separation do not prove owner-key
+//! possession; setup validation must establish the descriptor commitment and
+//! control evidence.
+//! The research fee ceiling prevents unchecked donation only; activation must
+//! bind it and verify measured finalized vsize/feerate externally.
+//!
+//! Activation must compare one canonical [`SharedSelectionOutpointsV2`]
+//! instance across this parent and every `CounterproofV2_i`; a standalone
+//! transaction constructor cannot prove roster-wide equality.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Script, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, XOnlyPublicKey};
+use strata_bridge_connectors::{
+    prelude::{
+        ClaimPayoutConnector, ClaimPayoutSpendPath, ClaimPayoutWitness, ContestCounterproofSpendV2,
+        ContestCounterproofV2Error, ContestPayoutGateSpendPathV2, ContestPayoutGateV2,
+        ContestPayoutGateWitnessV2, ContestSlashGateSpendPathV2, ContestSlashGateV2,
+        ContestSlashGateWitnessV2, NOfNConnector, NOfNSpend,
+    },
+    Connector, SigningInfo,
+};
+
+use crate::transactions::{
+    counterproof_v2::{CounterproofReserveBindingV2, SharedSelectionOutpointsV2},
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+};
+
+/// Exact outpoints consumed by the no-counterproof owner payout.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct OwnerPayoutV2Data {
+    /// Canonical `D`/`P` pair shared with every competing counterproof parent.
+    pub shared_selection: SharedSelectionOutpointsV2,
+    /// Research `Q` claim-payout output.
+    pub claim_payout_outpoint: OutPoint,
+    /// Fresh contest `S` gate used through its immediate settlement leaf.
+    pub contest_slash_outpoint: OutPoint,
+    /// Every fresh `C_i` and exact return policy in canonical alternative order.
+    pub counterproof_reserves: Vec<CounterproofReserveBindingV2>,
+}
+
+/// Typed dynamic signing information in exact input-role order.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct OwnerPayoutV2SigningInfo {
+    /// Research `D` N-of-N signature.
+    pub deposit: SigningInfo,
+    /// Research `Q` payout signature.
+    pub claim_payout: SigningInfo,
+    /// Shared `P` owner-payout graph signature.
+    pub contest_payout: SigningInfo,
+    /// Shared `S` settlement graph signature.
+    pub contest_slash: SigningInfo,
+    /// One reserve-recovery graph signature per canonical `C_i`.
+    pub counterproof_reserves: Vec<SigningInfo>,
+}
+
+/// Typed dynamic signatures for exact owner-payout finalization.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct OwnerPayoutV2Signatures {
+    /// Research `D` N-of-N signature.
+    pub deposit: schnorr::Signature,
+    /// Research `Q` payout signature.
+    pub claim_payout: schnorr::Signature,
+    /// Shared `P` owner-payout graph signature.
+    pub contest_payout: schnorr::Signature,
+    /// Shared `S` settlement graph signature.
+    pub contest_slash: schnorr::Signature,
+    /// One reserve-recovery graph signature per canonical `C_i`.
+    pub counterproof_reserves: Vec<schnorr::Signature>,
+}
+
+impl OwnerPayoutV2Data {
+    /// Returns the canonical shared `D`/`P` binding for activation checks.
+    pub const fn shared_selection(&self) -> SharedSelectionOutpointsV2 {
+        self.shared_selection
+    }
+}
+
+/// Exact no-counterproof owner-payout parent.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct OwnerPayoutV2Tx {
+    psbt: Psbt,
+    prevouts: Box<[TxOut]>,
+    deposit_connector: NOfNConnector,
+    claim_payout_connector: ClaimPayoutConnector,
+    contest_payout_connector: ContestPayoutGateV2,
+    contest_slash_connector: ContestSlashGateV2,
+    counterproof_reserves: Box<[CounterproofReserveBindingV2]>,
+}
+
+impl OwnerPayoutV2Tx {
+    /// Exact owner output index.
+    pub const OWNER_VOUT: u32 = 0;
+    /// First exact reserve-return output index.
+    pub const RESERVE_RETURN_0_VOUT: u32 = 1;
+
+    /// Constructs the exact owner payout with a caller-pinned fee.
+    ///
+    /// The owner descriptor is restricted to the existing operator payout
+    /// policy's P2TR form. Its script must be distinct from every protocol
+    /// input script so the output cannot silently remain under an input
+    /// connector's control domain.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        data: OwnerPayoutV2Data,
+        deposit_connector: NOfNConnector,
+        claim_payout_connector: ClaimPayoutConnector,
+        contest_payout_connector: ContestPayoutGateV2,
+        contest_slash_connector: ContestSlashGateV2,
+        owner_descriptor: &Descriptor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, OwnerPayoutV2Error> {
+        if data.counterproof_reserves.is_empty() {
+            return Err(OwnerPayoutV2Error::EmptyReserveRoster);
+        }
+        let mut input_outpoints = vec![
+            data.shared_selection.deposit_outpoint,
+            data.claim_payout_outpoint,
+            data.shared_selection.contest_payout_outpoint,
+            data.contest_slash_outpoint,
+        ];
+        input_outpoints.extend(
+            data.counterproof_reserves
+                .iter()
+                .map(CounterproofReserveBindingV2::outpoint),
+        );
+        for index in 0..input_outpoints.len() {
+            if input_outpoints[..index].contains(&input_outpoints[index]) {
+                return Err(OwnerPayoutV2Error::DuplicateInputOutpoint { index });
+            }
+        }
+
+        let network = deposit_connector.network();
+        for (name, candidate) in [
+            ("claim payout", claim_payout_connector.network()),
+            ("contest payout gate", contest_payout_connector.network()),
+            ("contest Slash gate", contest_slash_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(OwnerPayoutV2Error::NetworkMismatch { connector: name });
+            }
+        }
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            if reserve.connector().network() != network {
+                return Err(OwnerPayoutV2Error::ReserveNetworkMismatch { index });
+            }
+        }
+        if owner_descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(OwnerPayoutV2Error::InvalidOwnerDescriptorType {
+                actual: owner_descriptor.type_tag(),
+            });
+        }
+        let owner_key = XOnlyPublicKey::from_slice(owner_descriptor.payload())
+            .map_err(|_| OwnerPayoutV2Error::InvalidOwnerDescriptorPayload)?;
+        let mut reserve_keys = Vec::with_capacity(data.counterproof_reserves.len());
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            if reserve.return_descriptor().type_tag() != DescriptorType::P2tr {
+                return Err(OwnerPayoutV2Error::InvalidReserveDescriptorType {
+                    index,
+                    actual: reserve.return_descriptor().type_tag(),
+                });
+            }
+            let reserve_key = XOnlyPublicKey::from_slice(reserve.return_descriptor().payload())
+                .map_err(|_| OwnerPayoutV2Error::InvalidReserveDescriptorPayload { index })?;
+            if reserve_keys.contains(&reserve_key) {
+                return Err(OwnerPayoutV2Error::DuplicateReserveController { index });
+            }
+            reserve_keys.push(reserve_key);
+        }
+
+        let mut nums_keys = vec![
+            known_nums_keys("contest payout P", &contest_payout_connector),
+            known_nums_keys("contest Slash S", &contest_slash_connector),
+        ]
+        .into_iter()
+        .flatten()
+        .collect::<Vec<_>>();
+        nums_keys.extend(
+            data.counterproof_reserves.iter().flat_map(|reserve| {
+                known_nums_keys("contest counterproof C", &reserve.connector())
+            }),
+        );
+        for nums in &nums_keys {
+            if owner_key == nums.key {
+                return Err(OwnerPayoutV2Error::OwnerNumsKeyAlias {
+                    nums_component: nums.component,
+                    key_kind: nums.kind,
+                });
+            }
+        }
+        let mut protocol_controllers = vec![
+            (
+                "research deposit N-of-N internal key",
+                deposit_connector.internal_key(),
+            ),
+            (
+                "research deposit N-of-N output key",
+                deposit_connector
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+            (
+                "research claim-payout N-of-N internal key",
+                claim_payout_connector.internal_key(),
+            ),
+            (
+                "research claim-payout N-of-N output key",
+                claim_payout_connector
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+            (
+                "contest payout graph key",
+                contest_payout_connector.graph_pubkey(),
+            ),
+            (
+                "contest Slash graph key",
+                contest_slash_connector.graph_pubkey(),
+            ),
+        ];
+        for reserve in &data.counterproof_reserves {
+            protocol_controllers.extend([
+                (
+                    "contest counterproof graph key",
+                    reserve.connector().graph_pubkey(),
+                ),
+                (
+                    "contest counterproof operator key",
+                    reserve.connector().operator_pubkey(),
+                ),
+            ]);
+        }
+        for (component, controller) in &protocol_controllers {
+            if owner_key == *controller {
+                return Err(OwnerPayoutV2Error::OwnerControlKeyAlias { component });
+            }
+        }
+        for (index, reserve_key) in reserve_keys.iter().copied().enumerate() {
+            if reserve_key == owner_key {
+                return Err(OwnerPayoutV2Error::ReserveControlKeyAlias {
+                    index,
+                    component: "owner payout",
+                });
+            }
+            for (component, controller) in &protocol_controllers {
+                if reserve_key == *controller {
+                    return Err(OwnerPayoutV2Error::ReserveControlKeyAlias { index, component });
+                }
+            }
+            for nums in &nums_keys {
+                if reserve_key == nums.key {
+                    return Err(OwnerPayoutV2Error::ReserveNumsKeyAlias {
+                        index,
+                        nums_component: nums.component,
+                        key_kind: nums.kind,
+                    });
+                }
+            }
+        }
+
+        let mut prevouts = vec![
+            deposit_connector.tx_out(),
+            claim_payout_connector.tx_out(),
+            contest_payout_connector.tx_out(),
+            contest_slash_connector.tx_out(),
+        ];
+        prevouts.extend(
+            data.counterproof_reserves
+                .iter()
+                .map(|reserve| reserve.connector().tx_out()),
+        );
+        for (field, prevout) in [
+            ("research deposit prevout", &prevouts[0]),
+            ("research claim-payout prevout", &prevouts[1]),
+            ("contest payout prevout", &prevouts[2]),
+            ("contest Slash prevout", &prevouts[3]),
+        ] {
+            ensure_money_range(field, prevout.value)?;
+            ensure_non_dust(field, prevout.value, &prevout.script_pubkey)?;
+        }
+        for prevout in &prevouts[4..] {
+            ensure_money_range("contest counterproof prevout", prevout.value)?;
+            ensure_non_dust(
+                "contest counterproof prevout",
+                prevout.value,
+                &prevout.script_pubkey,
+            )?;
+        }
+        ensure_money_range("owner-payout fee", fee)?;
+        fee_allowance
+            .validate(TemplateKindV2::OwnerPayout, fee)
+            .map_err(OwnerPayoutV2Error::FeeAllowance)?;
+
+        let owner_script = owner_descriptor.to_script();
+        let mut protocol_scripts = vec![
+            ("research deposit prevout", &prevouts[0]),
+            ("research claim-payout prevout", &prevouts[1]),
+            ("contest payout prevout", &prevouts[2]),
+            ("contest Slash prevout", &prevouts[3]),
+        ];
+        protocol_scripts.extend(
+            prevouts[4..]
+                .iter()
+                .map(|prevout| ("contest counterproof prevout", prevout)),
+        );
+        for (component, prevout) in &protocol_scripts {
+            if owner_script == prevout.script_pubkey {
+                return Err(OwnerPayoutV2Error::OwnerScriptCollision { component });
+            }
+        }
+
+        let mut reserve_return_scripts = Vec::with_capacity(data.counterproof_reserves.len());
+        for (index, reserve) in data.counterproof_reserves.iter().enumerate() {
+            let script = reserve.return_descriptor().to_script();
+            ensure_non_dust("owner reserve return", reserve.connector().value(), &script)?;
+            if script == owner_script {
+                return Err(OwnerPayoutV2Error::ReserveScriptCollision {
+                    index,
+                    component: "owner payout",
+                });
+            }
+            for (component, prevout) in &protocol_scripts {
+                if script == prevout.script_pubkey {
+                    return Err(OwnerPayoutV2Error::ReserveScriptCollision { index, component });
+                }
+            }
+            if reserve_return_scripts.contains(&script) {
+                return Err(OwnerPayoutV2Error::DuplicateReserveScript { index });
+            }
+            reserve_return_scripts.push(script);
+        }
+
+        let mut fixed_input_value = Amount::ZERO;
+        for prevout in &prevouts[..4] {
+            fixed_input_value = fixed_input_value
+                .checked_add(prevout.value)
+                .ok_or(OwnerPayoutV2Error::AmountOverflow)?;
+            ensure_money_range("owner-payout fixed input", fixed_input_value)?;
+        }
+        let owner_value =
+            fixed_input_value
+                .checked_sub(fee)
+                .ok_or(OwnerPayoutV2Error::InsufficientInput {
+                    input: fixed_input_value,
+                    fee,
+                })?;
+        ensure_money_range("owner output", owner_value)?;
+        ensure_non_dust("owner output", owner_value, &owner_script)?;
+        let owner_and_fee = owner_value
+            .checked_add(fee)
+            .ok_or(OwnerPayoutV2Error::AmountOverflow)?;
+        ensure_money_range("owner output plus fee", owner_and_fee)?;
+        if fixed_input_value != owner_and_fee {
+            return Err(OwnerPayoutV2Error::ValueNotConserved {
+                input: fixed_input_value,
+                output: owner_value,
+                fee,
+            });
+        }
+
+        let total_input = prevouts.iter().try_fold(Amount::ZERO, |sum, prevout| {
+            sum.checked_add(prevout.value)
+                .ok_or(OwnerPayoutV2Error::AmountOverflow)
+        })?;
+        ensure_money_range("owner-payout total input", total_input)?;
+        let reserve_output_value =
+            data.counterproof_reserves
+                .iter()
+                .try_fold(Amount::ZERO, |sum, reserve| {
+                    sum.checked_add(reserve.connector().value())
+                        .ok_or(OwnerPayoutV2Error::AmountOverflow)
+                })?;
+        let total_output = owner_value
+            .checked_add(reserve_output_value)
+            .ok_or(OwnerPayoutV2Error::AmountOverflow)?;
+        ensure_money_range("owner-payout total output", total_output)?;
+        let total_output_and_fee = total_output
+            .checked_add(fee)
+            .ok_or(OwnerPayoutV2Error::AmountOverflow)?;
+        ensure_money_range("owner-payout total output plus fee", total_output_and_fee)?;
+        if total_input != total_output_and_fee {
+            return Err(OwnerPayoutV2Error::TotalValueNotConserved {
+                input: total_input,
+                output: total_output,
+                fee,
+            });
+        }
+
+        let mut input = vec![
+            TxIn {
+                previous_output: data.shared_selection.deposit_outpoint,
+                sequence: deposit_connector.sequence(NOfNSpend),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.claim_payout_outpoint,
+                sequence: claim_payout_connector.sequence(ClaimPayoutSpendPath::Payout),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.shared_selection.contest_payout_outpoint,
+                sequence: contest_payout_connector
+                    .sequence(ContestPayoutGateSpendPathV2::OwnerPayout),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.contest_slash_outpoint,
+                sequence: contest_slash_connector.sequence(ContestSlashGateSpendPathV2::Settlement),
+                ..Default::default()
+            },
+        ];
+        input.extend(data.counterproof_reserves.iter().map(|reserve| {
+            TxIn {
+                previous_output: reserve.outpoint(),
+                sequence: reserve
+                    .connector()
+                    .sequence(ContestCounterproofSpendV2::ReserveRecovery),
+                ..Default::default()
+            }
+        }));
+        let mut output = vec![TxOut {
+            value: owner_value,
+            script_pubkey: owner_script,
+        }];
+        output.extend(
+            data.counterproof_reserves
+                .iter()
+                .enumerate()
+                .map(|(index, reserve)| TxOut {
+                    value: reserve.connector().value(),
+                    script_pubkey: reserve_return_scripts[index].clone(),
+                }),
+        );
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(OwnerPayoutV2Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts: prevouts.into_boxed_slice(),
+            deposit_connector,
+            claim_payout_connector,
+            contest_payout_connector,
+            contest_slash_connector,
+            counterproof_reserves: data.counterproof_reserves.into_boxed_slice(),
+        })
+    }
+
+    /// Returns typed signing information for every exact dynamic input.
+    pub fn signing_info(&self) -> OwnerPayoutV2SigningInfo {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        let counterproof_reserves = self
+            .counterproof_reserves
+            .iter()
+            .enumerate()
+            .map(|(index, reserve)| {
+                reserve.connector().get_signing_info(
+                    &mut cache,
+                    Prevouts::All(&self.prevouts),
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    index + 4,
+                )
+            })
+            .collect();
+        OwnerPayoutV2SigningInfo {
+            deposit: self.deposit_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                NOfNSpend,
+                0,
+            ),
+            claim_payout: self.claim_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ClaimPayoutSpendPath::Payout,
+                1,
+            ),
+            contest_payout: self.contest_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestPayoutGateSpendPathV2::OwnerPayout,
+                2,
+            ),
+            contest_slash: self.contest_slash_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestSlashGateSpendPathV2::Settlement,
+                3,
+            ),
+            counterproof_reserves,
+        }
+    }
+
+    /// Returns the exact output index for a reserve return.
+    pub fn reserve_return_vout(&self, reserve_index: usize) -> Result<u32, OwnerPayoutV2Error> {
+        if reserve_index >= self.counterproof_reserves.len() {
+            return Err(OwnerPayoutV2Error::ReserveIndexOutOfRange {
+                index: reserve_index,
+                reserve_count: self.counterproof_reserves.len(),
+            });
+        }
+        Self::RESERVE_RETURN_0_VOUT
+            .checked_add(
+                u32::try_from(reserve_index)
+                    .map_err(|_| OwnerPayoutV2Error::ReserveVoutOverflow { reserve_index })?,
+            )
+            .ok_or(OwnerPayoutV2Error::ReserveVoutOverflow { reserve_index })
+    }
+
+    /// Finalizes exact named signatures plus one graph signature per `C_i`.
+    pub fn finalize(
+        self,
+        input_signatures: OwnerPayoutV2Signatures,
+    ) -> Result<Transaction, OwnerPayoutV2Error> {
+        let expected = self.counterproof_reserves.len();
+        let actual = input_signatures.counterproof_reserves.len();
+        if actual != expected {
+            return Err(OwnerPayoutV2Error::ReserveSignatureCount { expected, actual });
+        }
+        let mut psbt = self.psbt;
+        self.deposit_connector
+            .finalize_input(&mut psbt.inputs[0], &input_signatures.deposit);
+        self.claim_payout_connector.finalize_input(
+            &mut psbt.inputs[1],
+            &ClaimPayoutWitness::Payout {
+                output_key_signature: input_signatures.claim_payout,
+            },
+        );
+        self.contest_payout_connector.finalize_input(
+            &mut psbt.inputs[2],
+            &ContestPayoutGateWitnessV2::OwnerPayout {
+                graph_signature: input_signatures.contest_payout,
+            },
+        );
+        self.contest_slash_connector.finalize_input(
+            &mut psbt.inputs[3],
+            &ContestSlashGateWitnessV2::Settlement {
+                graph_signature: input_signatures.contest_slash,
+            },
+        );
+        for (index, reserve) in self.counterproof_reserves.iter().enumerate() {
+            let witness = reserve
+                .connector()
+                .reserve_recovery_witness(input_signatures.counterproof_reserves[index]);
+            reserve
+                .connector()
+                .try_finalize_input(
+                    &mut psbt.inputs[index + 4],
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    &witness,
+                )
+                .map_err(OwnerPayoutV2Error::ContestWitness)?;
+        }
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn ensure_money_range(field: &'static str, value: Amount) -> Result<(), OwnerPayoutV2Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(OwnerPayoutV2Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(
+    field: &'static str,
+    value: Amount,
+    script_pubkey: &Script,
+) -> Result<(), OwnerPayoutV2Error> {
+    let minimum = script_pubkey.minimal_non_dust();
+    if value < minimum {
+        return Err(OwnerPayoutV2Error::DustValue {
+            field,
+            value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+impl AsRef<Transaction> for OwnerPayoutV2Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize an exact research owner payout.
+#[derive(Debug)]
+pub enum OwnerPayoutV2Error {
+    /// No `C_i` reserve bindings were supplied.
+    EmptyReserveRoster,
+    /// Two transaction inputs name the same outpoint.
+    DuplicateInputOutpoint {
+        /// Index of the later duplicate.
+        index: usize,
+    },
+    /// Connector networks do not match.
+    NetworkMismatch {
+        /// Connector whose network differs from `D`.
+        connector: &'static str,
+    },
+    /// One `C_i` connector is on a different network.
+    ReserveNetworkMismatch {
+        /// Mismatching reserve index.
+        index: usize,
+    },
+    /// Owner payout is restricted to the setup policy's P2TR descriptor.
+    InvalidOwnerDescriptorType {
+        /// Rejected BOSD descriptor type.
+        actual: DescriptorType,
+    },
+    /// A P2TR descriptor carried a malformed controller payload.
+    InvalidOwnerDescriptorPayload,
+    /// A reserve return is not a canonical P2TR descriptor.
+    InvalidReserveDescriptorType {
+        /// Reserve index.
+        index: usize,
+        /// Rejected BOSD type.
+        actual: DescriptorType,
+    },
+    /// A reserve-return P2TR descriptor has a malformed key payload.
+    InvalidReserveDescriptorPayload {
+        /// Reserve index.
+        index: usize,
+    },
+    /// Two reserve returns reuse one controller.
+    DuplicateReserveController {
+        /// Later duplicate index.
+        index: usize,
+    },
+    /// Owner payout reuses a known protocol controller even if scripts differ.
+    OwnerControlKeyAlias {
+        /// Protocol controller aliased by the owner descriptor.
+        component: &'static str,
+    },
+    /// A reserve-return controller aliases another protocol controller.
+    ReserveControlKeyAlias {
+        /// Reserve index.
+        index: usize,
+        /// Aliased component.
+        component: &'static str,
+    },
+    /// Owner payout aliases an unspendable v2 NUMS key.
+    OwnerNumsKeyAlias {
+        /// V2 NUMS connector from which the key is derived.
+        nums_component: &'static str,
+        /// Untweaked internal key or tweaked output key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// A reserve-return controller aliases a known unspendable NUMS key.
+    ReserveNumsKeyAlias {
+        /// Reserve index.
+        index: usize,
+        /// NUMS-bearing component.
+        nums_component: &'static str,
+        /// Untweaked or tweaked key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// The owner script duplicates an input protocol control domain.
+    OwnerScriptCollision {
+        /// Input component whose script collides with the owner output.
+        component: &'static str,
+    },
+    /// A reserve return duplicates an owner or input protocol script.
+    ReserveScriptCollision {
+        /// Reserve index.
+        index: usize,
+        /// Aliased component.
+        component: &'static str,
+    },
+    /// Two reserve returns reuse one script.
+    DuplicateReserveScript {
+        /// Later duplicate index.
+        index: usize,
+    },
+    /// The fee exceeds or is not bound by the exact owner-payout allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A prevout, output, fee, or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Out-of-range value.
+        value: Amount,
+    },
+    /// A required spendable prevout or output is below its script dust floor.
+    DustValue {
+        /// Offending value role.
+        field: &'static str,
+        /// Supplied value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// The caller-pinned fee consumes more than all four inputs.
+    InsufficientInput {
+        /// Sum of `D`, `Q`, `P`, and `S`.
+        input: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// The exact owner-payout value equation does not hold.
+    ValueNotConserved {
+        /// Sum of `D`, `Q`, `P`, and `S`.
+        input: Amount,
+        /// Exact owner output value.
+        output: Amount,
+        /// Caller-supplied finalized fee.
+        fee: Amount,
+    },
+    /// Full dynamic inputs, reserve returns, and fee do not conserve value.
+    TotalValueNotConserved {
+        /// Sum of every input.
+        input: Amount,
+        /// Sum of owner and reserve-return outputs.
+        output: Amount,
+        /// Exact fee.
+        fee: Amount,
+    },
+    /// Graph signatures do not match the canonical `C_i` roster.
+    ReserveSignatureCount {
+        /// Exact reserve count.
+        expected: usize,
+        /// Supplied signature count.
+        actual: usize,
+    },
+    /// A checked reserve output lookup is outside the roster.
+    ReserveIndexOutOfRange {
+        /// Rejected reserve index.
+        index: usize,
+        /// Exact reserve count.
+        reserve_count: usize,
+    },
+    /// A dynamic reserve-return output index cannot fit in `u32`.
+    ReserveVoutOverflow {
+        /// Reserve index whose vout cannot be represented.
+        reserve_index: usize,
+    },
+    /// A fresh `C_i` connector rejected reserve-recovery finalization.
+    ContestWitness(ContestCounterproofV2Error),
+    /// The constructed unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for OwnerPayoutV2Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyReserveRoster => {
+                f.write_str("owner payout requires at least one C_i reserve binding")
+            }
+            Self::DuplicateInputOutpoint { index } => write!(
+                f,
+                "owner-payout input at index {index} duplicates an earlier outpoint"
+            ),
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match research deposit")
+            }
+            Self::ReserveNetworkMismatch { index } => write!(
+                f,
+                "owner-payout reserve at index {index} has a different network"
+            ),
+            Self::InvalidOwnerDescriptorType { actual } => {
+                write!(f, "owner-payout descriptor must be P2TR, got {actual}")
+            }
+            Self::InvalidOwnerDescriptorPayload => {
+                f.write_str("owner-payout P2TR payload is not a valid x-only key")
+            }
+            Self::InvalidReserveDescriptorType { index, actual } => write!(
+                f,
+                "owner reserve return {index} must be P2TR, got {actual}"
+            ),
+            Self::InvalidReserveDescriptorPayload { index } => write!(
+                f,
+                "owner reserve return {index} P2TR payload is not a valid x-only key"
+            ),
+            Self::DuplicateReserveController { index } => write!(
+                f,
+                "owner reserve return {index} reuses an earlier controller"
+            ),
+            Self::OwnerControlKeyAlias { component } => {
+                write!(f, "owner-payout key aliases {component}")
+            }
+            Self::ReserveControlKeyAlias { index, component } => write!(
+                f,
+                "owner reserve return {index} key aliases {component}"
+            ),
+            Self::OwnerNumsKeyAlias {
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "owner-payout key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::ReserveNumsKeyAlias {
+                index,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "owner reserve return {index} key aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::OwnerScriptCollision { component } => {
+                write!(f, "owner-payout script collides with {component}")
+            }
+            Self::ReserveScriptCollision { index, component } => write!(
+                f,
+                "owner reserve return {index} script collides with {component}"
+            ),
+            Self::DuplicateReserveScript { index } => write!(
+                f,
+                "owner reserve return {index} reuses an earlier script"
+            ),
+            Self::FeeAllowance(error) => {
+                write!(f, "invalid owner-payout fee allowance: {error}")
+            }
+            Self::AmountOverflow => f.write_str("owner-payout amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustValue {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below its dust floor {minimum}"),
+            Self::InsufficientInput { input, fee } => write!(
+                f,
+                "owner-payout inputs cannot fund fee: input={input}, fee={fee}"
+            ),
+            Self::ValueNotConserved { input, output, fee } => write!(
+                f,
+                "owner-payout value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::TotalValueNotConserved { input, output, fee } => write!(
+                f,
+                "owner-payout total value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::ReserveSignatureCount { expected, actual } => write!(
+                f,
+                "owner payout requires exactly {expected} C_i graph signatures, got {actual}"
+            ),
+            Self::ReserveIndexOutOfRange {
+                index,
+                reserve_count,
+            } => write!(
+                f,
+                "owner reserve index {index} is outside roster of length {reserve_count}"
+            ),
+            Self::ReserveVoutOverflow { reserve_index } => write!(
+                f,
+                "owner reserve return vout for index {reserve_index} overflows u32"
+            ),
+            Self::ContestWitness(error) => {
+                write!(f, "contest reserve-recovery witness was rejected: {error}")
+            }
+            Self::Psbt(error) => write!(f, "failed to construct owner-payout PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for OwnerPayoutV2Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::ContestWitness(error) => Some(error),
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
