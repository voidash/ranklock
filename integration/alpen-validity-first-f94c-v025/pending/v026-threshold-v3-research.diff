+        assert!(matches!(
+            PersistedFundingBlockedObservationV3::try_from_parts(dust, V026_BLOCKERS_V3,),
+            Err(V026PersistedObservationErrorV3::InvalidResolutionOutput { alternative: 0 })
+        ));
