+    #[test]
+    fn core_rejects_a_control_block_for_a_different_selected_commitment() {
+        let mut node = BitcoinNode::new();
+        let graph_keypair = deterministic_keypair(1);
+        let policy = bound_policy(
+            graph_keypair.x_only_public_key().0,
+            ThresholdReleaseFaultProfileV3::new(3, 2, 1).unwrap(),
+            100,
+            BOND_VALUE,
+        );
+        let first = bound_setup(Arc::clone(&policy), 1, 2).selected(0).unwrap();
+        let changed = bound_setup(policy, 9, 2).selected(0).unwrap();
+        let connector =
+            CounterproofResolutionThresholdConnectorV3::from_selected_binding(&first).unwrap();
+        let wrong_connector =
+            CounterproofResolutionThresholdConnectorV3::from_selected_binding(&changed).unwrap();
+        let outpoint = fund_connectors(&mut node, &connector, 1)[0];
+        let (tx, prevouts) = spending_template(
+            &mut node,
+            &connector,
+            outpoint,
+            CounterproofResolutionThresholdSpendPathV3::Timeout,
+        );
+
+        let wrong_signing = signing_info(
+            &tx,
+            &prevouts,
+            &wrong_connector,
+            CounterproofResolutionThresholdSpendPathV3::Timeout,
+        );
+        let wrong_witness = wrong_connector.timeout_witness(wrong_signing.sign(&graph_keypair));
+        let wrong = finalize(
+            &node,
+            tx.clone(),
+            &prevouts,
+            &wrong_connector,
+            &wrong_witness,
+        );
+        assert!(node.client().send_raw_transaction(&wrong).is_err());
+
+        let valid_signing = signing_info(
+            &tx,
+            &prevouts,
+            &connector,
+            CounterproofResolutionThresholdSpendPathV3::Timeout,
