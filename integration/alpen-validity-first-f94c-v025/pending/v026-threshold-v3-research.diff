+    #[test]
+    fn bond_graph_path_is_core_valid_and_bypasses_are_rejected() {
+        let mut node = BitcoinNode::new();
+        let graph_keypair = keypair(1);
+        let policy = policy(graph_keypair.x_only_public_key().0);
+        let connector = policy.bond_connector(0).expect("bond connector");
+        let funding_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                connector.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - connector.value() - TEST_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding_tx);
+        node.mine_blocks(1);
+        let spending_tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![
+                TxIn {
+                    previous_output: OutPoint::new(funding_txid, 0),
+                    ..Default::default()
+                },
+                TxIn {
+                    previous_output: node.next_coinbase_outpoint(),
+                    ..Default::default()
+                },
+            ],
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - TEST_FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let prevouts = [connector.tx_out(), node.coinbase_tx_out()];
+        let signing_info = connector.get_signing_info(
+            &mut SighashCache::new(&spending_tx),
+            Prevouts::All(&prevouts),
+            CounterproofBondSpendV3,
+            0,
+        );
+        let correct_signature = signing_info.sign(&graph_keypair);
+
+        let finalize = |witness: CounterproofBondWitnessV3| {
+            let mut psbt = Psbt::from_unsigned_tx(spending_tx.clone()).expect("unsigned tx");
+            psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+            psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+            connector.finalize_input(&mut psbt.inputs[0], &witness);
+            node.sign(&psbt.extract_tx().expect("extract finalized tx"))
+        };
+        let wrong_signature = signing_info.sign(&keypair(999));
+        assert!(node
+            .client()
+            .send_raw_transaction(&finalize(CounterproofBondConnectorV3::witness(
+                wrong_signature
+            )))
+            .is_err());
+
+        let key_path_message = create_key_spend_hash(
+            &mut SighashCache::new(&spending_tx),
+            Prevouts::All(&prevouts),
+            TapSighashType::Default,
+            0,
+        )
+        .expect("key-spend message");
+        let mut key_path_attempt = node.sign(&spending_tx);
+        key_path_attempt.input[0].witness =
+            Witness::from_slice(&[graph_keypair.sign_schnorr(key_path_message).serialize()]);
+        assert!(node
+            .client()
+            .send_raw_transaction(&key_path_attempt)
+            .is_err());
+
+        let sibling = policy.bond_connector(1).expect("sibling bond");
+        let sibling_signature = sibling
+            .get_signing_info(
+                &mut SighashCache::new(&spending_tx),
+                Prevouts::All(&prevouts),
+                CounterproofBondSpendV3,
+                0,
+            )
+            .sign(&graph_keypair);
+        let mut sibling_psbt = Psbt::from_unsigned_tx(spending_tx.clone()).expect("unsigned tx");
+        sibling_psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        sibling_psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+        sibling.finalize_input(
+            &mut sibling_psbt.inputs[0],
+            &CounterproofBondConnectorV3::witness(sibling_signature),
+        );
+        let sibling_attempt = node.sign(&sibling_psbt.extract_tx().expect("sibling tx"));
+        assert!(node
+            .client()
+            .send_raw_transaction(&sibling_attempt)
+            .is_err());
+
+        let valid = finalize(CounterproofBondConnectorV3::witness(correct_signature));
+        node.client()
+            .send_raw_transaction(&valid)
+            .expect("valid exact bond graph path");
+    }
+}
