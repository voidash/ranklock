+
+    #[test]
+    fn live_graph_observation_verifies_real_finalized_ack_and_rejects_relabel() {
+        let graph = V026ThresholdGraphV3::assemble(live_plan()).expect("live threshold graph");
+        let observation =
+            StructurallyVerifiedFundingBlockedV3::observe(&graph).expect("live observation");
+        assert_eq!(
+            observation.funded_setup_digest(),
+            graph.funded_setup().digest().to_byte_array()
+        );
+        assert!(!observation.funding_eligible());
+
+        let ack = graph.alternatives()[0].resolution_branches().ack().clone();
+        let signing = ack.signing_info()[0];
+        let candidates = [0_usize, 2]
+            .into_iter()
+            .map(|participant| {
+                let release_number = 100 + (participant * LIVE_ALTERNATIVES) as u32;
+                IndexedReleaseSignatureV3::new(
+                    participant,
+                    signing.sign(&live_keypair(release_number)),
+                )
+            })
+            .collect();
+        let finalized = ack
+            .finalize(candidates, signing.sign(&live_keypair(1)))
+            .expect("real finalized ACK");
+        let selection = observation
+            .verify_ack_witness_selection(&graph, 0, &finalized)
+            .expect("live ACK selection");
+        assert_eq!(
+            selection.selected_commitment(),
+            graph.alternatives()[0]
+                .selected()
+                .selected_commitment()
+                .to_byte_array()
+        );
+        assert!(!selection.funding_eligible());
+        assert!(matches!(
+            observation.verify_ack_witness_selection(&graph, 1, &finalized),
+            Err(V026AckWitnessSelectionErrorV3::PublicationIdentityMismatch)
+        ));
+    }
+
+    #[test]
+    fn persisted_ack_selection_validates_exact_transaction_and_witness() {
+        let selection =
+            PersistedThresholdAckWitnessSelectionV3::try_from_parts(valid_witness_parts())
+                .expect("valid exact ACK witness selection");
+        assert_eq!(selection.selected_commitment(), [31; 32]);
+        assert_eq!(selection.participant_bitmap(), 1);
+        assert!(!selection.funding_eligible());
