+/// Minimal content-derived subject actually authenticated by one threshold ACK.
+///
+/// Unrelated structural roles such as Q and K are deliberately absent: they are
+/// not committed by the selected R script or ACK sighash and therefore cannot
+/// be treated as witness-publication authority.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct V026ThresholdAckSubjectV3 {
+    /// Selected commitment embedded in the R tapscript.
+    pub selected_commitment: [u8; 32],
+    /// Exact graph authorization key.
+    pub graph_pubkey: [u8; 32],
+    /// Exact threshold participant count.
+    pub participant_count: u16,
+    /// Exact release threshold.
+    pub threshold: u16,
+    /// Alternative-scoped release roster in participant order.
+    pub release_pubkeys: Vec<[u8; 32]>,
+    /// Exact selected resolution outpoint.
+    pub resolution_outpoint: OutPoint,
+    /// Exact selected resolution output.
+    pub resolution_tx_out: TxOut,
+    /// Exact non-witness ACK transaction ID.
+    pub ack_txid: Txid,
+    /// Exact ACK Taproot script-path sighash.
+    pub ack_sighash: [u8; 32],
+}
+
+impl V026ThresholdAckSubjectV3 {
+    fn from_observation(
+        observation: &StructurallyVerifiedFundingBlockedV3,
+        alternative: usize,
+    ) -> Result<Self, V026AckWitnessSelectionErrorV3> {
+        let manifest = observation.manifest();
+        let selected = manifest.alternatives.get(alternative).ok_or(
+            V026AckWitnessSelectionErrorV3::UnknownAlternative {
+                alternative,
+                alternatives: manifest.alternatives.len(),
+            },
+        )?;
+        let subject = Self {
+            selected_commitment: selected.selected_commitment,
+            graph_pubkey: manifest.graph_pubkey,
+            participant_count: manifest.participant_count,
+            threshold: manifest.threshold,
+            release_pubkeys: selected.release_pubkeys.clone(),
+            resolution_outpoint: selected.resolution_outpoint,
+            resolution_tx_out: selected.resolution_tx_out.clone(),
+            ack_txid: selected.ack_txid,
+            ack_sighash: selected.ack_sighash,
+        };
+        validate_ack_subject(&subject)?;
+        Ok(subject)
+    }
+}
