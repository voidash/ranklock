+/// Number of unconditional blockers in the threshold-v3 observation profile.
+pub const V026_BLOCKER_COUNT_V3: usize = 17;
+
+/// Stable persisted blocker codes for threshold-v3 observations.
+///
+/// Codes 1 through 16 preserve the V2 meanings. Code 17 covers the remaining
+/// durable witness-adoption and runtime-publication work even after a local CAS
+/// implementation exists.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+#[repr(u16)]
+pub enum V026BlockerCodeV3 {
+    /// NUMS role/index semantics remain a research profile.
+    ResearchNumsProfile = 1,
+    /// Canonical graph identity and wire encoding are not implemented.
+    CanonicalWireIdentityUnimplemented = 2,
+    /// Qualified release-cryptography evidence is absent.
+    ReleaseCryptographyEvidenceUnverified = 3,
+    /// Controller possession/domain evidence is absent.
+    ControllerDomainEvidenceUnverified = 4,
+    /// Slash still uses an incompatible header profile.
+    SlashHeaderProfileIncompatible = 5,
+    /// External Claim/D/Q/K/B provenance is unverified.
+    ExternalOutputEvidenceUnverified = 6,
+    /// Fresh-D cutover evidence is absent.
+    FreshDepositEvidenceUnverified = 7,
+    /// Global stake exclusivity evidence is absent.
+    StakeExclusivityEvidenceUnverified = 8,
+    /// Presign transcript and erasure evidence are absent.
+    PresignErasureEvidenceUnverified = 9,
+    /// Legacy and off-transcript material exclusion is unverified.
+    LegacyMaterialExclusionUnverified = 10,
+    /// Finalized fee policy remains unqualified.
+    FeePolicyEvidenceUnverified = 11,
+    /// The required Bitcoin Core execution matrix is incomplete.
+    BitcoinCoreExecutionEvidenceUnverified = 12,
+    /// Versioned ASM activation is absent.
+    AsmActivationEvidenceUnverified = 13,
+    /// Runtime admission remains unimplemented.
+    RuntimeAdmissionUnimplemented = 14,
+    /// Terminal protected-value economics remain unproved.
+    ValidityWithholdingEconomicsUnresolved = 15,
+    /// Atomic roster weight and relay bounds remain unfrozen.
+    AtomicRosterWeightEvidenceUnverified = 16,
+    /// Durable witness adoption and runtime publication remain incomplete.
+    ThresholdAckWitnessAdoptionUnimplemented = 17,
+}
