+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+enum DestinationClassV3 {
+    Provider,
+    Operator,
+    Recovery,
+}
+
+fn validate_static_domains(
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    registry: &ThresholdV3KeyRegistry,
+    alternatives: &[ThresholdV3BondAlternativePolicy],
+) -> Result<(), ThresholdV3BondPolicyError> {
+    let mut counterproof_domains = Vec::with_capacity(alternatives.len());
+    let mut atomic_value = Amount::ZERO;
+    for (index, alternative) in alternatives.iter().enumerate() {
+        let connector = &alternative.counterproof_output;
+        if connector.network() != network {
+            return Err(ThresholdV3BondPolicyError::NetworkMismatch { index });
+        }
+        if connector.graph_pubkey() != graph_pubkey {
+            return Err(ThresholdV3BondPolicyError::GraphKeyMismatch { index });
+        }
+        let internal_key = connector.internal_key();
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        let tx_out = connector.tx_out();
+        if let Some((first_index, _, _, _, _)) = counterproof_domains.iter().find(
+            |(_, earlier_internal, earlier_output, earlier_script, _)| {
+                *earlier_internal == internal_key
+                    || *earlier_internal == output_key
+                    || *earlier_output == internal_key
+                    || *earlier_output == output_key
+                    || *earlier_script == tx_out.script_pubkey
+            },
+        ) {
+            return Err(ThresholdV3BondPolicyError::DuplicateCounterproofDomain {
+                first_index: *first_index,
+                duplicate_index: index,
+            });
+        }
+        counterproof_domains.push((
+            index,
+            internal_key,
+            output_key,
+            tx_out.script_pubkey,
+            connector.operator_pubkey(),
+        ));
+        atomic_value = atomic_value
+            .checked_add(connector.value())
+            .and_then(|value| value.checked_add(alternative.bond_value))
+            .ok_or(ThresholdV3BondPolicyError::AtomicRosterAmountOverflow)?;
+        if atomic_value > Amount::MAX_MONEY {
+            return Err(ThresholdV3BondPolicyError::AtomicRosterMoneyRange {
+                value: atomic_value,
+            });
+        }
+    }
+
+    let registry_keys: Vec<_> = registry
+        .participants()
+        .iter()
+        .flat_map(|participant| {
+            std::iter::once(participant.identity_pubkey())
+                .chain(participant.release_pubkeys().iter().copied())
+        })
+        .collect();
+    if registry_keys.contains(&graph_pubkey) {
+        let is_identity = registry
+            .participants()
+            .iter()
+            .any(|participant| participant.identity_pubkey() == graph_pubkey);
+        return Err(if is_identity {
+            ThresholdV3BondPolicyError::GraphIdentityKeyAlias
+        } else {
+            ThresholdV3BondPolicyError::GraphReleaseKeyAlias
+        });
+    }
+    for (index, internal_key, output_key, _, operator_key) in &counterproof_domains {
+        if registry_keys
+            .iter()
+            .any(|key| key == internal_key || key == output_key || key == operator_key)
+        {
+            return Err(
+                ThresholdV3BondPolicyError::RegistryCounterproofAuthorizationAlias {
+                    index: *index,
+                },
+            );
+        }
+        if let Some((nums_index, ..)) =
+            counterproof_domains
+                .iter()
+                .find(|(other_index, other_internal, other_output, _, _)| {
+                    other_index != index
+                        && (*operator_key == *other_internal || *operator_key == *other_output)
+                })
+        {
+            return Err(
+                ThresholdV3BondPolicyError::CounterproofAuthorizationNumsAlias {
+                    authorization_index: *index,
+                    nums_index: *nums_index,
+                },
+            );
+        }
+    }
+
+    let mut destinations = Vec::with_capacity(alternatives.len() * 4);
+    for (index, alternative) in alternatives.iter().enumerate() {
+        for (class, destination) in [
+            (
+                DestinationClassV3::Provider,
+                alternative.counterproof_return,
+            ),
+            (DestinationClassV3::Provider, alternative.bond_refund),
+            (
+                DestinationClassV3::Operator,
+                alternative.operator_compensation,
+            ),
+            (DestinationClassV3::Recovery, alternative.recovery),
+        ] {
+            if destination.output_key == graph_pubkey {
+                return Err(ThresholdV3BondPolicyError::GraphDestinationKeyAlias { index });
+            }
+            if registry_keys.contains(&destination.output_key) {
+                return Err(ThresholdV3BondPolicyError::RegistryDestinationKeyAlias { index });
+            }
+            if registry.participants().iter().any(|participant| {
+                participant.control_domain_digest() == destination.authority_digest
+            }) {
+                return Err(
+                    ThresholdV3BondPolicyError::RegistryDestinationAuthorityAlias { index },
+                );
+            }
+            if let Some((counterproof_index, ..)) = counterproof_domains.iter().find(
+                |(_, internal_key, output_key, _, operator_key)| {
+                    destination.output_key == *internal_key
+                        || destination.output_key == *output_key
+                        || destination.output_key == *operator_key
+                },
+            ) {
+                return Err(
+                    ThresholdV3BondPolicyError::CounterproofDestinationKeyAlias {
+                        destination_index: index,
+                        counterproof_index: *counterproof_index,
+                    },
+                );
+            }
+            if let Some((first_index, first_class, first_destination)) = destinations.iter().find(
+                |(_, first_class, first_destination): &&(
+                    usize,
+                    DestinationClassV3,
+                    ThresholdV3ControlledP2trDestination,
+                )| {
+                    (first_destination.output_key == destination.output_key
+                        && (first_destination.principal_id != destination.principal_id
+                            || first_destination.authority_digest != destination.authority_digest))
+                        || (first_destination.authority_digest == destination.authority_digest
+                            && first_destination.principal_id != destination.principal_id)
+                        || (*first_class != class
+                            && (first_destination.output_key == destination.output_key
+                                || first_destination.principal_id == destination.principal_id
+                                || first_destination.authority_digest
+                                    == destination.authority_digest))
+                },
+            ) {
+                let _ = first_class;
+                let _ = first_destination;
+                return Err(ThresholdV3BondPolicyError::DestinationControllerAlias {
+                    first_index: *first_index,
+                    duplicate_index: index,
+                });
+            }
+            destinations.push((index, class, destination));
+        }
+    }
+    Ok(())
+}
+
+fn validate_bond_nums_domains(
+    policy: &ThresholdV3BondPolicyP0,
+) -> Result<(), ThresholdV3BondPolicyError> {
+    let mut forbidden = vec![policy.graph_pubkey];
+    for participant in policy.registry.participants() {
+        forbidden.push(participant.identity_pubkey());
+        forbidden.extend_from_slice(participant.release_pubkeys());
+    }
+    for alternative in policy.alternatives.iter() {
+        let connector = &alternative.counterproof_output;
+        forbidden.extend([
+            connector.operator_pubkey(),
+            connector.internal_key(),
+            connector.spend_info().output_key().to_x_only_public_key(),
+            alternative.counterproof_return.output_key,
+            alternative.bond_refund.output_key,
+            alternative.operator_compensation.output_key,
+            alternative.recovery.output_key,
+        ]);
+    }
+    let mut bond_nums = Vec::with_capacity(policy.alternatives.len() * 2);
+    for index in 0..policy.alternatives.len() {
+        let connector = CounterproofBondConnectorV3::from_policy(policy, index)?;
+        let internal_key = connector.internal_key();
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if internal_key == output_key
+            || forbidden.contains(&internal_key)
+            || forbidden.contains(&output_key)
+            || bond_nums.contains(&internal_key)
+            || bond_nums.contains(&output_key)
+        {
+            return Err(ThresholdV3BondPolicyError::BondNumsDomainAlias { index });
+        }
+        bond_nums.extend([internal_key, output_key]);
+    }
+    Ok(())
+}
+
+fn encode_policy(
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    registry_digest: ThresholdV3RegistryDigest,
+    alternatives: &[ThresholdV3BondAlternativePolicy],
+) -> Result<Vec<u8>, ThresholdV3BondPolicyError> {
+    let mut body = Vec::new();
+    body.extend_from_slice(&network.magic().to_bytes());
+    body.extend_from_slice(&graph_pubkey.serialize());
+    body.extend_from_slice(&registry_digest.to_byte_array());
+    let count = u16::try_from(alternatives.len())
+        .map_err(|_| ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+    body.extend_from_slice(&count.to_be_bytes());
+    for (index, alternative) in alternatives.iter().enumerate() {
+        let index =
+            u32::try_from(index).map_err(|_| ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+        body.extend_from_slice(&index.to_be_bytes());
+        encode_tx_out(&mut body, &alternative.counterproof_output.tx_out())?;
+        encode_destination(&mut body, alternative.counterproof_return);
+        body.extend_from_slice(&alternative.bond_value.to_sat().to_be_bytes());
+        encode_destination(&mut body, alternative.bond_refund);
+        encode_destination(&mut body, alternative.operator_compensation);
+        encode_destination(&mut body, alternative.recovery);
+        body.extend_from_slice(&alternative.base_resolution_value.to_sat().to_be_bytes());
+        body.extend_from_slice(&alternative.timeout_delay.value().to_be_bytes());
+    }
+    let total_len = 8usize
+        .checked_add(2 + 2 + 4)
+        .and_then(|prefix| prefix.checked_add(body.len()))
+        .ok_or(ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+    let total_len =
+        u32::try_from(total_len).map_err(|_| ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+    let mut encoded = Vec::with_capacity(total_len as usize);
+    encoded.extend_from_slice(&POLICY_MAGIC);
+    encoded.extend_from_slice(&POLICY_SCHEMA_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&PROTOCOL_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&total_len.to_be_bytes());
+    encoded.extend_from_slice(&body);
+    Ok(encoded)
+}
+
+fn encode_funded_setup(
+    policy: &ThresholdV3BondPolicyP0,
+    counterproof_funding: &[ThresholdV3FundingOutput],
+    bond_funding: &[ThresholdV3FundingOutput],
+) -> Result<Vec<u8>, ThresholdV3FundedSetupError> {
+    let mut body = Vec::new();
+    body.extend_from_slice(&policy.digest.0);
+    let count = u16::try_from(counterproof_funding.len())
+        .map_err(|_| ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+    body.extend_from_slice(&count.to_be_bytes());
+    for index in 0..counterproof_funding.len() {
+        let index_u32 = u32::try_from(index)
+            .map_err(|_| ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+        body.extend_from_slice(&index_u32.to_be_bytes());
+        encode_funding_output(&mut body, &counterproof_funding[index])?;
+        encode_funding_output(&mut body, &bond_funding[index])?;
+    }
+    let total_len = 8usize
+        .checked_add(2 + 2 + 4)
+        .and_then(|prefix| prefix.checked_add(body.len()))
+        .ok_or(ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+    let total_len = u32::try_from(total_len)
+        .map_err(|_| ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+    let mut encoded = Vec::with_capacity(total_len as usize);
+    encoded.extend_from_slice(&FUNDED_MAGIC);
+    encoded.extend_from_slice(&FUNDED_SCHEMA_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&PROTOCOL_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&total_len.to_be_bytes());
+    encoded.extend_from_slice(&body);
+    Ok(encoded)
+}
+
+fn encode_destination(body: &mut Vec<u8>, destination: ThresholdV3ControlledP2trDestination) {
+    body.extend_from_slice(&destination.output_key.serialize());
+    body.extend_from_slice(&destination.principal_id);
+    body.extend_from_slice(&destination.authority_digest);
+}
+
+fn encode_tx_out(body: &mut Vec<u8>, tx_out: &TxOut) -> Result<(), ThresholdV3BondPolicyError> {
+    body.extend_from_slice(&tx_out.value.to_sat().to_be_bytes());
+    let script_len = u16::try_from(tx_out.script_pubkey.len())
+        .map_err(|_| ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+    body.extend_from_slice(&script_len.to_be_bytes());
+    body.extend_from_slice(tx_out.script_pubkey.as_bytes());
+    Ok(())
+}
+
+fn encode_funding_output(
+    body: &mut Vec<u8>,
+    output: &ThresholdV3FundingOutput,
+) -> Result<(), ThresholdV3FundedSetupError> {
+    body.extend_from_slice(output.outpoint.txid.as_raw_hash().as_byte_array());
+    body.extend_from_slice(&output.outpoint.vout.to_be_bytes());
+    body.extend_from_slice(&output.tx_out.value.to_sat().to_be_bytes());
+    let script_len = u16::try_from(output.tx_out.script_pubkey.len())
+        .map_err(|_| ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+    body.extend_from_slice(&script_len.to_be_bytes());
+    body.extend_from_slice(output.tx_out.script_pubkey.as_bytes());
+    Ok(())
+}
+
+fn derive_bond_nums(
+    commitment: ThresholdV3AlternativeCommitment,
+) -> Result<XOnlyPublicKey, CounterproofBondV3Error> {
+    let base = XOnlyPublicKey::from_slice(&BIP341_NUMS_BASE_POINT)
+        .map_err(|_| CounterproofBondV3Error::NumsDerivation)?;
+    let digest = ThresholdBondNumsV3Hash::hash(&commitment.0).to_byte_array();
+    let scalar = Scalar::from_be_bytes(reduce_mod_curve_order(digest))
+        .map_err(|_| CounterproofBondV3Error::NumsDerivation)?;
+    base.add_tweak(SECP256K1, &scalar)
+        .map(|(key, _)| key)
+        .map_err(|_| CounterproofBondV3Error::NumsDerivation)
+}
+
+fn reduce_mod_curve_order(mut value: [u8; 32]) -> [u8; 32] {
+    if value < SECP256K1_ORDER {
+        return value;
+    }
+    let mut borrow = 0u16;
+    for index in (0..value.len()).rev() {
+        let minuend = u16::from(value[index]);
+        let subtrahend = u16::from(SECP256K1_ORDER[index]) + borrow;
+        if minuend >= subtrahend {
+            value[index] = (minuend - subtrahend) as u8;
+            borrow = 0;
+        } else {
+            value[index] = (minuend + 256 - subtrahend) as u8;
+            borrow = 1;
+        }
+    }
+    debug_assert_eq!(borrow, 0);
+    value
+}
