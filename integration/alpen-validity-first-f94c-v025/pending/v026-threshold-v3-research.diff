+/// A key/control domain in the locally checkable ACK closure.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ThresholdAckKeyDomainV3 {
+    /// Exact-parent graph authorization key.
+    Graph,
+    /// Ordered participant release key.
+    Release {
+        /// Setup-committed participant index.
+        index: usize,
+    },
+    /// Resolution NUMS internal key.
+    ResolutionNumsInternal,
+    /// Resolution Taproot output key.
+    ResolutionNumsOutput,
+    /// Slash-authorization NUMS internal key.
+    SlashAuthorizationNumsInternal,
+    /// Slash-authorization Taproot output key.
+    SlashAuthorizationNumsOutput,
+    /// Selected-collateral refund controller/output key.
+    SelectedCollateralRefund,
+    /// Anchor internal/controller key.
+    CpfpInternal,
+    /// Anchor Taproot output key.
+    CpfpOutput,
+}
+
+/// Failure to construct or finalize a threshold ACK.
+#[derive(Debug)]
+pub enum CounterproofAckThresholdV3Error {
+    /// Caller data names a different alternative from the resolution connector.
+    AlternativeMismatch {
+        /// Alternative supplied with the outpoint.
+        data: ThresholdAckAlternativeV3,
+        /// Alternative bound by the connector.
+        connector: ThresholdAckAlternativeV3,
+    },
+    /// Connector networks differ.
+    NetworkMismatch {
+        /// Mismatching connector.
+        connector: &'static str,
+    },
+    /// `R` and `L` do not use the same exact graph key.
+    GraphKeyMismatch,
+    /// A checked amount operation overflowed.
+    AmountOverflow,
+    /// A value exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Rejected value.
+        value: Amount,
+    },
+    /// A required output is below its exact script's dust floor.
+    DustOutput {
+        /// Offending output role.
+        field: &'static str,
+        /// Rejected value.
+        value: Amount,
+        /// Required minimum.
+        minimum: Amount,
+    },
+    /// Two independently controlled/unspendable key domains alias.
+    KeyDomainAlias {
+        /// Earlier key domain.
+        first: ThresholdAckKeyDomainV3,
+        /// Later key domain.
+        second: ThresholdAckKeyDomainV3,
+    },
+    /// Two canonical outputs have the same exact script.
+    OutputScriptCollision {
+        /// Later colliding output index.
+        index: usize,
+    },
+    /// Fee is unbound or exceeds its exact allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// `R = B_refund + L + a_ACK + fee` does not hold.
+    ValueNotConserved {
+        /// Resolution input value.
+        input: Amount,
+        /// Sum of three canonical outputs.
+        output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// The graph signature does not verify for this exact ACK sighash.
+    InvalidGraphSignature,
+    /// A candidate names no key in the setup roster.
+    UnknownParticipantIndex {
+        /// Rejected index.
+        index: usize,
+        /// Roster length.
+        participants: usize,
+    },
+    /// More than one candidate names the same participant.
+    DuplicateParticipantIndex {
+        /// Duplicated index.
+        index: usize,
+    },
+    /// A candidate fails BIP340 verification against its indexed key and exact sighash.
+    InvalidReleaseSignature {
+        /// Failing participant index.
+        index: usize,
+    },
+    /// Fewer than `t` verified candidates were supplied.
+    InsufficientValidSignatures {
+        /// Required threshold.
+        required: usize,
+        /// Verified candidate count.
+        actual: usize,
+    },
+    /// Strict connector witness construction failed.
+    ConnectorWitness(strata_bridge_connectors::prelude::CounterproofResolutionThresholdV3Error),
+    /// PSBT construction failed.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofAckThresholdV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::AlternativeMismatch { data, connector } => write!(
+                f,
+                "threshold ACK data names alternative {} but connector names {}",
+                data.index(),
+                connector.index()
+            ),
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match threshold resolution")
+            }
+            Self::GraphKeyMismatch => {
+                f.write_str("resolution and Slash authorization graph keys differ")
+            }
+            Self::AmountOverflow => f.write_str("threshold ACK amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustOutput {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below its dust floor {minimum}"),
+            Self::KeyDomainAlias { first, second } => {
+                write!(
+                    f,
+                    "threshold ACK key domains {first:?} and {second:?} alias"
+                )
+            }
+            Self::OutputScriptCollision { index } => {
+                write!(
+                    f,
+                    "threshold ACK output {index} duplicates an earlier script"
+                )
+            }
+            Self::FeeAllowance(error) => write!(f, "invalid threshold ACK fee allowance: {error}"),
+            Self::ValueNotConserved { input, output, fee } => write!(
+                f,
+                "threshold ACK value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::InvalidGraphSignature => {
+                f.write_str("graph signature does not authorize this exact threshold ACK")
+            }
+            Self::UnknownParticipantIndex {
+                index,
+                participants,
+            } => write!(
+                f,
+                "release signature index {index} is outside the {participants}-participant roster"
+            ),
+            Self::DuplicateParticipantIndex { index } => {
+                write!(f, "release signature index {index} is duplicated")
+            }
+            Self::InvalidReleaseSignature { index } => write!(
+                f,
+                "release signature {index} does not verify for its exact ACK sighash"
+            ),
+            Self::InsufficientValidSignatures { required, actual } => write!(
+                f,
+                "threshold ACK needs {required} valid release signatures, got {actual}"
+            ),
+            Self::ConnectorWitness(error) => {
+                write!(f, "invalid strict threshold ACK witness: {error}")
+            }
+            Self::Psbt(error) => write!(f, "failed to construct threshold ACK PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofAckThresholdV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::ConnectorWitness(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
