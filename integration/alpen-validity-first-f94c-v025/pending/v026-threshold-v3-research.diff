+    #[test]
+    fn exact_layout_conservation_and_signature_validation() {
+        let fixture = Fixture::new();
+        let timeout = fixture.timeout(OutPoint::null(), OutPoint::new(OutPoint::null().txid, 1));
+        assert_eq!(timeout.as_ref().version, Version(3));
+        assert_eq!(timeout.as_ref().input.len(), 2);
+        assert_eq!(timeout.as_ref().output.len(), 3);
+        assert_eq!(timeout.as_ref().output[0].value, OPERATOR_VALUE);
+        assert_eq!(timeout.as_ref().output[1].value, ANCHOR_VALUE);
+        assert_eq!(
+            timeout.recovery_change_tx_out().unwrap().value,
+            Amount::from_sat(19_170)
+        );
+        assert_eq!(timeout.cpfp_outpoint().vout, 1);
+        assert_eq!(timeout.alternative(), ALTERNATIVE);
+        assert!(!timeout.funding_eligible());
+
+        let signing = timeout.signing_info();
+        let signatures = [
+            signing[0].sign(&fixture.graph),
+            signing[1].sign(&fixture.graph),
+        ];
+        let finalized = timeout.clone().finalize(signatures).unwrap();
+        assert_eq!(
+            finalized
+                .output
+                .iter()
+                .map(|output| output.value)
+                .sum::<Amount>()
+                + FEE,
+            R_VALUE + S_VALUE
+        );
+        assert!(finalized
+            .input
+            .iter()
+            .all(|input| !input.witness.is_empty()));
+
+        let wrong = fixture.graph.sign_schnorr(Message::from_digest([0x42; 32]));
+        assert!(matches!(
+            timeout.finalize([wrong, signatures[1]]),
+            Err(
+                CounterproofTimeoutSettlementThresholdV3Error::InvalidGraphSignature {
+                    input_index: 0
+                }
+            )
+        ));
+    }
