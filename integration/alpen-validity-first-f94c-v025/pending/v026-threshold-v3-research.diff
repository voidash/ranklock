+//! Research-only threshold-signature resolution connector.
+//!
+//! The immediate ACK leaf requires an exact-parent graph signature followed by
+//! exactly `t` valid BIP340 signatures from an ordered roster of `n`
+//! participant-and-alternative release keys. The competing timeout leaf keeps
+//! the v2 CSV-plus-graph-signature semantics. Release keys and signatures must
+//! be fresh for each participant and alternative: revealing one alternative's
+//! signature is irreversible and is not made reorg-safe by atomic selection.
+//!
+//! The side-by-side tx-graph prototype now defines a funding-ineligible terminal
+//! threshold timeout that returns the setup-committed operator compensation.
+//! This connector alone does not bind that parent or qualify its economics;
+//! canonical graph assembly and activation remain external blockers.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    hashes::{sha256t_hash_newtype, Hash},
+    opcodes, relative, script, Amount, Network, ScriptBuf, Sequence,
+};
+use secp256k1::{schnorr, Scalar, XOnlyPublicKey, SECP256K1};
+use strata_bridge_primitives::scripts::prelude::threshold_multisig_script;
+
+#[cfg(any(test, feature = "test_utils"))]
+use crate::ranklock_nums::{ResearchV0NumsContext, ResearchV0NumsRole};
+use crate::{
+    counterproof_bond_v3::ThresholdV3SelectedBinding,
+    ranklock_nums::{NumsDerivationError, BIP341_NUMS_BASE_POINT},
+    Connector, TaprootWitness,
+};
+
+sha256t_hash_newtype! {
+    struct ThresholdResolutionNumsV3Tag = hash_str("RankLock/v026/TaprootNUMS/v3/resolution");
+
+    struct ThresholdResolutionNumsV3Hash(_);
+}
+
+const SECP256K1_ORDER: [u8; 32] = [
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
+    0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b, 0xbf, 0xd2, 0x5e, 0x8c, 0xd0, 0x36, 0x41, 0x41,
+];
+
+/// Minimum ordered participant roster size in the threshold research profile.
+pub const MIN_THRESHOLD_ACK_PARTICIPANTS: usize = 2;
+/// Maximum ordered participant roster size in the threshold research profile.
+pub const MAX_THRESHOLD_ACK_PARTICIPANTS: usize = 64;
+
+/// Setup-committed identity of one counterproof alternative.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct ThresholdAckAlternativeV3(u32);
+
+impl ThresholdAckAlternativeV3 {
+    /// Constructs the caller-bound research alternative identity.
+    pub const fn new(index: u32) -> Self {
+        Self(index)
+    }
+
+    /// Returns the setup roster's alternative index.
+    pub const fn index(self) -> u32 {
+        self.0
+    }
+}
+
+/// Static fault bound for one threshold-release roster.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdReleaseFaultProfileV3 {
+    participant_count: usize,
+    threshold: usize,
+    max_corrupt: usize,
+}
+
+impl ThresholdReleaseFaultProfileV3 {
+    /// Validates `2 <= n <= 64` and the safety/liveness bounds `f < t <= n - f`.
+    pub fn new(
+        participant_count: usize,
+        threshold: usize,
+        max_corrupt: usize,
+    ) -> Result<Self, ThresholdReleaseFaultProfileV3Error> {
+        if !(MIN_THRESHOLD_ACK_PARTICIPANTS..=MAX_THRESHOLD_ACK_PARTICIPANTS)
+            .contains(&participant_count)
+        {
+            return Err(
+                ThresholdReleaseFaultProfileV3Error::InvalidParticipantCount {
+                    actual: participant_count,
+                },
+            );
+        }
+        if threshold == 0 || threshold > participant_count {
+            return Err(
+                ThresholdReleaseFaultProfileV3Error::ThresholdOutsideParticipantRoster {
+                    participant_count,
+                    threshold,
+                },
+            );
+        }
+        if max_corrupt >= participant_count {
+            return Err(
+                ThresholdReleaseFaultProfileV3Error::CorruptionOutsideParticipantRoster {
+                    participant_count,
+                    max_corrupt,
+                },
+            );
+        }
+        if max_corrupt >= threshold {
+            return Err(ThresholdReleaseFaultProfileV3Error::UnsafeThreshold {
+                threshold,
+                max_corrupt,
+            });
+        }
+        let available = participant_count.checked_sub(max_corrupt).ok_or(
+            ThresholdReleaseFaultProfileV3Error::CorruptionOutsideParticipantRoster {
+                participant_count,
+                max_corrupt,
+            },
+        )?;
+        if threshold > available {
+            return Err(ThresholdReleaseFaultProfileV3Error::UnavailableThreshold {
+                participant_count,
+                threshold,
+                max_corrupt,
+            });
+        }
+        Ok(Self {
+            participant_count,
+            threshold,
+            max_corrupt,
+        })
+    }
+
+    /// Returns the exact ordered roster size.
+    pub const fn participant_count(self) -> usize {
+        self.participant_count
+    }
+
+    /// Returns the exact number of required signatures.
+    pub const fn threshold(self) -> usize {
+        self.threshold
+    }
+
+    /// Returns the cumulative corruption bound assumed by this profile.
+    pub const fn max_corrupt(self) -> usize {
+        self.max_corrupt
+    }
+}
+
+/// Invalid threshold-release fault profile.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum ThresholdReleaseFaultProfileV3Error {
+    /// The ordered roster is outside the research bound.
+    InvalidParticipantCount {
+        /// Rejected participant count.
+        actual: usize,
+    },
+    /// The threshold is zero or exceeds the concrete participant roster.
+    ThresholdOutsideParticipantRoster {
+        /// Ordered roster size.
+        participant_count: usize,
+        /// Rejected signature threshold.
+        threshold: usize,
+    },
+    /// The corruption bound does not name a strict subset of the roster.
+    CorruptionOutsideParticipantRoster {
+        /// Ordered roster size.
+        participant_count: usize,
+        /// Rejected corruption bound.
+        max_corrupt: usize,
+    },
+    /// `f < t` is violated.
+    UnsafeThreshold {
+        /// Required signature count.
+        threshold: usize,
+        /// Assumed cumulative corruption bound.
+        max_corrupt: usize,
+    },
+    /// `t <= n - f` is violated.
+    UnavailableThreshold {
+        /// Ordered roster size.
+        participant_count: usize,
+        /// Required signature count.
+        threshold: usize,
+        /// Assumed cumulative corruption bound.
+        max_corrupt: usize,
+    },
+}
+
+impl fmt::Display for ThresholdReleaseFaultProfileV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidParticipantCount { actual } => write!(
+                f,
+                "threshold ACK participant count {actual} is outside {MIN_THRESHOLD_ACK_PARTICIPANTS}..={MAX_THRESHOLD_ACK_PARTICIPANTS}"
+            ),
+            Self::ThresholdOutsideParticipantRoster {
+                participant_count,
+                threshold,
+            } => write!(
+                f,
+                "threshold ACK requires 1 <= t <= n, got n={participant_count}, t={threshold}"
+            ),
+            Self::CorruptionOutsideParticipantRoster {
+                participant_count,
+                max_corrupt,
+            } => write!(
+                f,
+                "threshold ACK requires f < n, got n={participant_count}, f={max_corrupt}"
+            ),
+            Self::UnsafeThreshold {
+                threshold,
+                max_corrupt,
+            } => write!(
+                f,
+                "threshold ACK fault profile requires max_corrupt < threshold, got f={max_corrupt}, t={threshold}"
+            ),
+            Self::UnavailableThreshold {
+                participant_count,
+                threshold,
+                max_corrupt,
+            } => write!(
+                f,
+                "threshold ACK fault profile requires t <= n - f, got n={participant_count}, t={threshold}, f={max_corrupt}"
+            ),
+        }
+    }
+}
