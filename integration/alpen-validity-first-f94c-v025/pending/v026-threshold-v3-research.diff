+/// A decoded private DTO cannot reconstruct one valid inert selection.
+#[derive(Debug)]
+pub(crate) enum V026AckWitnessBodyErrorV3 {
+    /// A release signature is not exactly 64 bytes.
+    ReleaseSignatureLength {
+        /// Position in the selected-signature vector.
+        position: usize,
+        /// Rejected length.
+        actual: usize,
+    },
+    /// The graph signature is not exactly 64 bytes.
+    GraphSignatureLength {
+        /// Rejected length.
+        actual: usize,
+    },
+    /// The reconstructed inert selection failed full bridge-state validation.
+    InvalidRecord(V026PersistedAckWitnessErrorV3),
+}
+
+impl fmt::Display for V026AckWitnessBodyErrorV3 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ReleaseSignatureLength { position, actual } => write!(
+                f,
+                "v0.26 V3 ACK release signature at position {position} has {actual} bytes, expected 64"
+            ),
+            Self::GraphSignatureLength { actual } => write!(
+                f,
+                "v0.26 V3 ACK graph signature has {actual} bytes, expected 64"
+            ),
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V3 ACK witness row: {error}"),
+        }
+    }
+}
+
+impl Error for V026AckWitnessBodyErrorV3 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::ReleaseSignatureLength { .. } | Self::GraphSignatureLength { .. } => None,
+        }
+    }
+}
