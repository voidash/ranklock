+
+impl V026ThresholdGraphV3 {
+    /// Builds all internal edges and P1 from actual unsigned parent txids.
+    pub fn assemble(plan: V026ThresholdGraphV3Plan) -> Result<Self, V026ThresholdGraphV3Error> {
+        verify_external_outpoints(&plan)?;
+        if plan.claim.outpoint.vout != ClaimTx::CONTEST_VOUT {
+            return Err(V026ThresholdGraphV3Error::InvalidClaimVout {
+                actual: plan.claim.outpoint.vout,
+                expected: ClaimTx::CONTEST_VOUT,
+            });
+        }
+        plan.claim
+            .connector
+            .validate_authorization_domains()
+            .map_err(V026ThresholdGraphV3Error::ClaimAuthorization)?;
+        let count = plan.policy.alternatives().len();
+        if plan.alternatives.len() != count || plan.bond_funding.len() != count {
+            return Err(V026ThresholdGraphV3Error::RosterLengthMismatch {
+                policy: count,
+                alternatives: plan.alternatives.len(),
+                bonds: plan.bond_funding.len(),
+            });
+        }
+        verify_common_destinations(&plan.policy)?;
+        for (component, graph_pubkey) in [
+            (
+                "contest payout gate",
+                plan.contest.payout_gate.graph_pubkey(),
+            ),
+            ("contest Slash gate", plan.contest.slash_gate.graph_pubkey()),
+        ] {
+            if graph_pubkey != plan.policy.graph_pubkey() {
+                return Err(V026ThresholdGraphV3Error::GraphKeyMismatch { component });
+            }
+        }
+
+        let payout_gate = plan.contest.payout_gate;
+        let slash_gate = plan.contest.slash_gate;
+        let contest_alternatives = plan
+            .policy
+            .alternatives()
+            .iter()
+            .zip(&plan.alternatives)
+            .map(|(policy, service)| ContestAlternativeV2 {
+                counterproof_output: *policy.counterproof_output(),
+                cpfp_pubkey: service.contest_cpfp_pubkey,
+            })
+            .collect();
+        let contest = ContestV2Tx::new(
+            ContestV2Data {
+                claim_txid: plan.claim.outpoint.txid,
+            },
+            plan.claim.connector.clone(),
+            ContestV2OutputPlan {
+                proof_connector: plan.contest.proof_connector,
+                payout_gate,
+                slash_gate,
+                alternatives: contest_alternatives,
+                cpfp_anchor_value: plan.contest.cpfp_anchor_value,
+                fee: plan.contest.fee,
+                fee_allowance: plan.contest.fee_allowance,
+            },
+        )
+        .map_err(V026ThresholdGraphV3Error::Contest)?;
+        let contest_txid = contest.as_ref().compute_txid();
+        let contest_payout_outpoint = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+        let contest_slash_outpoint = contest.slash_gate_outpoint();
+        verify_derived_outpoints_do_not_alias_external(
+            &plan,
+            &contest,
+            contest_payout_outpoint,
+            contest_slash_outpoint,
+        )?;
+
+        let counterproof_funding = plan
+            .policy
+            .alternatives()
+            .iter()
+            .enumerate()
+            .map(|(index, alternative)| {
+                let vout = contest
+                    .counterproof_vout(index)
+                    .map_err(V026ThresholdGraphV3Error::Contest)?;
+                let outpoint = contest
+                    .counterproof_outpoint(index)
+                    .map_err(V026ThresholdGraphV3Error::Contest)?;
+                let serialized = contest.as_ref().output.get(vout as usize).ok_or(
+                    V026ThresholdGraphV3Error::ContestOutputMissing {
+                        role: "counterproof",
+                        index: Some(index),
+                        vout,
+                    },
+                )?;
+                if serialized != &alternative.counterproof_output().tx_out() {
+                    return Err(V026ThresholdGraphV3Error::ContestOutputMismatch {
+                        role: "counterproof",
+                        index: Some(index),
+                    });
+                }
+                ThresholdV3FundingOutput::new(outpoint, serialized.clone())
+                    .map_err(V026ThresholdGraphV3Error::FundedSetup)
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let funded_setup = ThresholdV3FundedSetupP1::new(
+            Arc::clone(&plan.policy),
+            counterproof_funding,
+            plan.bond_funding.clone(),
+        )
+        .map_err(V026ThresholdGraphV3Error::FundedSetup)?;
+        verify_locally_visible_controller_closure(&plan, &funded_setup, &contest)?;
+        let expected_transactions = build_expected_transactions(&plan, &funded_setup)?;
+        let shared_selection = ThresholdSharedSelectionOutpointsV3 {
+            deposit_outpoint: plan.deposit.outpoint,
+            contest_payout_outpoint,
+        };
+        let owner_payout = OwnerPayoutThresholdV3Tx::new(
+            OwnerPayoutThresholdV3Data {
+                funded_setup: Arc::clone(&funded_setup),
+                shared_selection,
+                claim_payout_outpoint: plan.claim_payout.outpoint,
+                contest_slash_outpoint,
+            },
+            plan.deposit.connector,
+            plan.claim_payout.connector,
+            payout_gate,
+            slash_gate,
+            plan.owner_fee,
+            plan.owner_fee_allowance,
+        )
+        .map_err(V026ThresholdGraphV3Error::OwnerPayout)?;
+
+        let mut alternatives = Vec::with_capacity(count);
+        for (index, service) in plan.alternatives.into_iter().enumerate() {
+            let selected = funded_setup
+                .selected(index)
+                .map_err(V026ThresholdGraphV3Error::FundedSetup)?;
+            let counterproof = CounterproofThresholdV3Tx::new(
+                CounterproofThresholdV3Data {
+                    selected: selected.clone(),
+                    shared_selection,
+                },
+                payout_gate,
+                plan.deposit.connector,
+                service.counterproof_cpfp_connector,
+                service.counterproof_fee,
+                service.counterproof_fee_allowance,
+            )
+            .map_err(|source| V026ThresholdGraphV3Error::Counterproof { index, source })?;
+            let branches = ThresholdResolutionBranchesV3::from_parents(
+                selected.clone(),
+                &counterproof,
+                &contest,
+                service.resolution_branches,
+            )
+            .map_err(|source| V026ThresholdGraphV3Error::ResolutionBranches { index, source })?;
+            let slash_authorization_outpoint = OutPoint::new(
+                branches.ack().as_ref().compute_txid(),
+                crate::transactions::prelude::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+            );
+            let slash = SlashV2Tx::new(
+                SlashV2Data {
+                    slash_authorization_outpoint,
+                    contest_slash_outpoint,
+                    stake_outpoint: plan.stake.outpoint,
+                    operator_idx: plan.operator_idx,
+                    magic_bytes: plan.magic_bytes,
+                },
+                *branches.slash_authorization_connector(),
+                slash_gate,
+                plan.stake.connector,
+                service.slash_payouts,
+                service.slash_fee,
+                service.slash_fee_allowance,
+            )
+            .map_err(|source| V026ThresholdGraphV3Error::Slash { index, source })?;
+            alternatives.push(V026ThresholdAlternativeGraphV3 {
+                selected,
+                counterproof,
+                branches,
+                slash,
+            });
+        }
+
+        let spend_matrix = build_spend_matrix(count).into_boxed_slice();
+        let role_outpoints = build_role_outpoints(
+            [
+                plan.claim.outpoint,
+                plan.deposit.outpoint,
+                plan.claim_payout.outpoint,
+                plan.stake.outpoint,
+            ],
+            &funded_setup,
+            &contest,
+            &alternatives,
+        )?
+        .into_boxed_slice();
+        let manifest = build_manifest(&contest, &owner_payout, &alternatives);
+        let graph = Self {
+            claim_outpoint: plan.claim.outpoint,
+            deposit_outpoint: plan.deposit.outpoint,
+            claim_payout_outpoint: plan.claim_payout.outpoint,
+            stake_outpoint: plan.stake.outpoint,
+            policy: plan.policy,
+            funded_setup,
+            contest,
+            owner_payout,
+            alternatives: alternatives.into_boxed_slice(),
+            spend_matrix,
+            role_outpoints,
+            expected_transactions,
+            manifest,
+        };
+        graph.verify_structure()?;
+        Ok(graph)
+    }
+
+    /// Rechecks exact serialized parent-child input relationships and matrix closure.
+    pub fn verify_structure(&self) -> Result<(), V026ThresholdGraphV3Error> {
+        let count = self.alternatives.len();
+        if self.policy.alternatives().len() != count
+            || self.funded_setup.counterproof_funding().len() != count
+            || self.funded_setup.bond_funding().len() != count
+        {
+            return Err(V026ThresholdGraphV3Error::StoredRosterMismatch);
+        }
+        if self.spend_matrix.as_ref() != build_spend_matrix(count).as_slice() {
+            return Err(V026ThresholdGraphV3Error::SpendMatrixMismatch);
+        }
+        let recomputed_role_outpoints = build_role_outpoints(
+            [
+                self.claim_outpoint,
+                self.deposit_outpoint,
+                self.claim_payout_outpoint,
+                self.stake_outpoint,
+            ],
+            &self.funded_setup,
+            &self.contest,
+            &self.alternatives,
+        )?;
+        if self.role_outpoints.as_ref() != recomputed_role_outpoints.as_slice() {
+            return Err(V026ThresholdGraphV3Error::RoleOutpointRegistryMismatch);
+        }
+        verify_matrix_against_serialized_inputs(
+            &self.role_outpoints,
+            &self.spend_matrix,
+            &self.contest,
+            &self.owner_payout,
+            &self.alternatives,
+        )?;
+        if self.manifest != build_manifest(&self.contest, &self.owner_payout, &self.alternatives) {
+            return Err(V026ThresholdGraphV3Error::ManifestMismatch);
+        }
+        verify_exact_transaction(
+            "Contest",
+            None,
+            self.contest.as_ref(),
+            &self.expected_transactions.contest,
+        )?;
+        verify_exact_transaction(
+            "OwnerPayout",
+            None,
+            self.owner_payout.as_ref(),
+            &self.expected_transactions.owner_payout,
+        )?;
+        if self.expected_transactions.alternatives.len() != count {
+            return Err(V026ThresholdGraphV3Error::StoredRosterMismatch);
+        }
+        let contest = self.contest.as_ref();
+        verify_input("Contest", None, contest, 0, self.claim_outpoint)?;
+        let contest_txid = contest.compute_txid();
+        let p = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+        let s = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+        let c = self
+            .funded_setup
+            .counterproof_funding()
+            .iter()
+            .map(ThresholdV3FundingOutput::outpoint)
+            .collect::<Vec<_>>();
+        let b = self
+            .funded_setup
+            .bond_funding()
+            .iter()
+            .map(ThresholdV3FundingOutput::outpoint)
+            .collect::<Vec<_>>();
+        verify_contest_outputs(&self.contest, &self.policy)?;
+
+        let owner = self.owner_payout.as_ref();
+        verify_inputs(
+            "OwnerPayout",
+            None,
+            owner,
+            [self.deposit_outpoint, self.claim_payout_outpoint, p, s]
+                .into_iter()
+                .chain(c.iter().copied())
+                .chain(b.iter().copied()),
+        )?;
+        for (index, alternative) in self.alternatives.iter().enumerate() {
+            let expected = &self.expected_transactions.alternatives[index];
+            for (template, actual, projection) in [
+                (
+                    "Counterproof",
+                    alternative.counterproof.as_ref(),
+                    &expected.counterproof,
+                ),
+                ("ACK", alternative.branches.ack().as_ref(), &expected.ack),
+                (
+                    "Timeout",
+                    alternative.branches.timeout().as_ref(),
+                    &expected.timeout,
+                ),
+                ("Slash", alternative.slash.as_ref(), &expected.slash),
+            ] {
+                verify_exact_transaction(template, Some(index), actual, projection)?;
+            }
+            if alternative.selected.index() != index
+                || alternative.counterproof.selected_binding() != &alternative.selected
+                || alternative.branches.selected_binding() != &alternative.selected
+            {
+                return Err(V026ThresholdGraphV3Error::SelectedBindingMismatch { index });
+            }
+            let cp = alternative.counterproof.as_ref();
+            verify_inputs(
+                "Counterproof",
+                Some(index),
+                cp,
+                c.iter()
+                    .copied()
+                    .chain(b.iter().copied())
+                    .chain([p, self.deposit_outpoint]),
+            )?;
+            let r = alternative.counterproof.resolution_outpoint();
+            verify_inputs("ACK", Some(index), alternative.branches.ack().as_ref(), [r])?;
+            verify_inputs(
+                "Timeout",
+                Some(index),
+                alternative.branches.timeout().as_ref(),
+                [r, s],
+            )?;
+            let l = OutPoint::new(
+                alternative.branches.ack().as_ref().compute_txid(),
+                crate::transactions::prelude::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+            );
+            verify_inputs(
+                "Slash",
+                Some(index),
+                alternative.slash.as_ref(),
+                [l, s, self.stake_outpoint],
+            )?;
+        }
+        Ok(())
+    }
+
+    /// Returns the exact Contest parent.
+    pub const fn contest(&self) -> &ContestV2Tx {
+        &self.contest
+    }
+
+    /// Returns the internally constructed funded P1.
+    pub const fn funded_setup(&self) -> &Arc<ThresholdV3FundedSetupP1> {
+        &self.funded_setup
+    }
+
+    /// Returns the exact atomic no-counterproof owner parent.
+    pub const fn owner_payout(&self) -> &OwnerPayoutThresholdV3Tx {
+        &self.owner_payout
+    }
+
+    /// Returns alternatives in P0 order.
+    pub const fn alternatives(&self) -> &[V026ThresholdAlternativeGraphV3] {
+        &self.alternatives
+    }
+
+    /// Returns the exact output-to-spender matrix.
+    pub const fn spend_matrix(&self) -> &[V026ThresholdSpendMatrixEntryV3] {
+        &self.spend_matrix
+    }
+
+    /// Returns the canonical unique role-to-outpoint registry.
+    pub const fn role_outpoints(&self) -> &[V026ThresholdRoleOutpointV3] {
+        &self.role_outpoints
+    }
+
+    /// Returns actual graph identities without claiming canonical wire status.
+    pub const fn structural_manifest(&self) -> &V026ThresholdGraphManifestV3 {
+        &self.manifest
+    }
+
+    /// Returns all immutable activation blockers.
+    pub const fn activation_blockers(&self) -> &'static [V026ThresholdActivationBlockerV3] {
+        &ACTIVATION_BLOCKERS
+    }
+
+    /// Structural assembly never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+fn verify_locally_visible_controller_closure(
+    plan: &V026ThresholdGraphV3Plan,
+    funded_setup: &Arc<ThresholdV3FundedSetupP1>,
+    contest: &ContestV2Tx,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let policy = &plan.policy;
+    if plan.claim.connector.n_of_n_pubkey() != policy.graph_pubkey() {
+        return Err(V026ThresholdGraphV3Error::GraphKeyMismatch {
+            component: "Claim contest N/N",
+        });
+    }
+    let mut keys = Vec::<(&'static str, XOnlyPublicKey)>::new();
+    let mut scripts = Vec::<(&'static str, ScriptBuf)>::new();
+    push_strict_key(&mut keys, "graph authorization", policy.graph_pubkey())?;
+    for participant in policy.registry().participants() {
+        push_strict_key(
+            &mut keys,
+            "registry identity",
+            participant.identity_pubkey(),
+        )?;
+        for release in participant.release_pubkeys() {
+            push_strict_key(&mut keys, "release authorization", *release)?;
+        }
+    }
+    for (index, alternative) in policy.alternatives().iter().enumerate() {
+        let counterproof = alternative.counterproof_output();
+        push_strict_key(&mut keys, "C operator", counterproof.operator_pubkey())?;
+        push_strict_key(&mut keys, "C NUMS internal", counterproof.internal_key())?;
+        push_strict_key(
+            &mut keys,
+            "C NUMS output",
+            counterproof
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        )?;
+        push_strict_script(&mut scripts, "C", counterproof.script_pubkey())?;
+        let bond = policy
+            .bond_connector(index)
+            .map_err(V026ThresholdGraphV3Error::Policy)?;
+        push_strict_key(&mut keys, "B NUMS internal", bond.internal_key())?;
+        push_strict_key(
+            &mut keys,
+            "B NUMS output",
+            bond.spend_info().output_key().to_x_only_public_key(),
+        )?;
+        push_strict_script(&mut scripts, "B", bond.script_pubkey())?;
+        for (role, destination) in [
+            ("C return", alternative.counterproof_return()),
+            ("B refund", alternative.bond_refund()),
+            ("operator/owner", alternative.operator_compensation()),
+            ("recovery", alternative.recovery()),
+        ] {
+            push_p0_destination_key(&mut keys, role, destination.output_key())?;
+            push_p0_destination_script(&mut scripts, role, destination.script_pubkey())?;
+        }
+    }
+
+    let proof = contest.proof_connector();
+    push_strict_key(&mut keys, "Contest proof internal", proof.internal_key())?;
+    push_strict_key(
+        &mut keys,
+        "Contest proof output",
+        proof.spend_info().output_key().to_x_only_public_key(),
+    )?;
+    if proof.timelocked_key() != policy.graph_pubkey() {
+        push_strict_key(
+            &mut keys,
+            "Contest proof delayed authorization",
+            proof.timelocked_key(),
+        )?;
+    }
+    push_strict_script(&mut scripts, "Contest proof", proof.script_pubkey())?;
+    for (role, connector) in [
+        (
+            "Contest P",
+            contest.payout_gate() as &dyn LocalConnectorView,
+        ),
+        ("Contest S", contest.slash_gate() as &dyn LocalConnectorView),
+    ] {
+        push_strict_key(&mut keys, role, connector.local_internal_key())?;
+        push_strict_key(&mut keys, role, connector.local_output_key())?;
+        push_strict_script(&mut scripts, role, connector.local_script_pubkey())?;
+    }
+    let multi_anchor = contest.cpfp_connector();
+    push_strict_key(
+        &mut keys,
+        "Contest MultiAnchor NUMS",
+        multi_anchor.internal_key(),
+    )?;
+    push_strict_key(
+        &mut keys,
+        "Contest MultiAnchor output",
+        multi_anchor
+            .spend_info()
+            .output_key()
+            .to_x_only_public_key(),
+    )?;
+    for watchtower in multi_anchor.watchtower_keys() {
+        push_strict_key(&mut keys, "Contest MultiAnchor controller", *watchtower)?;
+    }
+    if plan.claim.connector.watchtower_pubkeys() != multi_anchor.watchtower_keys() {
+        return Err(V026ThresholdGraphV3Error::ClaimServiceRosterMismatch);
+    }
+    push_strict_script(
+        &mut scripts,
+        "Contest MultiAnchor",
+        multi_anchor.script_pubkey(),
+    )?;
+    push_claim_nums_key(&mut keys, plan.claim.connector.internal_key())?;
+    push_strict_key(
+        &mut keys,
+        "opaque Claim output",
+        plan.claim
+            .connector
+            .spend_info()
+            .output_key()
+            .to_x_only_public_key(),
+    )?;
+    push_strict_script(
+        &mut scripts,
+        "opaque Claim",
+        plan.claim.connector.script_pubkey(),
+    )?;
+
+    for (role, connector) in [("D", &plan.deposit.connector), ("K", &plan.stake.connector)] {
+        push_strict_key(&mut keys, role, connector.internal_key())?;
+        push_strict_key(
+            &mut keys,
+            role,
+            connector.spend_info().output_key().to_x_only_public_key(),
+        )?;
+        push_strict_script(&mut scripts, role, connector.script_pubkey())?;
+    }
+    push_strict_key(
+        &mut keys,
+        "Q internal",
+        plan.claim_payout.connector.internal_key(),
+    )?;
+    push_strict_key(
+        &mut keys,
+        "Q output",
+        plan.claim_payout
+            .connector
+            .spend_info()
+            .output_key()
+            .to_x_only_public_key(),
+    )?;
+    for admin in plan.claim_payout.connector.admin_pubkeys() {
+        push_strict_key(&mut keys, "Q admin", *admin)?;
+    }
+    push_strict_script(
+        &mut scripts,
+        "Q",
+        plan.claim_payout.connector.script_pubkey(),
+    )?;
+
+    for (index, service) in plan.alternatives.iter().enumerate() {
+        for (role, anchor) in [
+            ("counterproof CPFP", &service.counterproof_cpfp_connector),
+            ("ACK CPFP", &service.resolution_branches.ack_cpfp_connector),
+            (
+                "timeout CPFP",
+                &service.resolution_branches.timeout_cpfp_connector,
+            ),
+        ] {
+            push_strict_key(&mut keys, role, anchor.internal_key())?;
+            push_strict_key(
+                &mut keys,
+                role,
+                anchor.spend_info().output_key().to_x_only_public_key(),
+            )?;
+            push_strict_script(&mut scripts, role, anchor.script_pubkey())?;
+        }
+        let selected = funded_setup
+            .selected(index)
+            .map_err(V026ThresholdGraphV3Error::FundedSetup)?;
+        let resolution = CounterproofResolutionThresholdConnectorV3::from_selected_binding(
+            &selected,
+        )
+        .map_err(|error| V026ThresholdGraphV3Error::ExpectedConstruction {
+            template: "controller closure R",
+            index: Some(index),
+            message: error.to_string(),
+        })?;
+        push_strict_key(&mut keys, "R NUMS internal", resolution.internal_key())?;
+        push_strict_key(
+            &mut keys,
+            "R NUMS output",
+            resolution.spend_info().output_key().to_x_only_public_key(),
+        )?;
+        push_strict_script(&mut scripts, "R", resolution.script_pubkey())?;
+        let l_value = selected
+            .policy()
+            .base_resolution_value()
+            .checked_sub(service.resolution_branches.ack_cpfp_connector.value())
+            .and_then(|value| value.checked_sub(service.resolution_branches.ack_fee))
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "controller closure L",
+                index: Some(index),
+            })?;
+        let slash_authorization = SlashAuthorizationConnectorV2::from_selected_binding(
+            &selected, l_value,
+        )
+        .map_err(|error| V026ThresholdGraphV3Error::ExpectedConstruction {
+            template: "controller closure L",
+            index: Some(index),
+            message: error.to_string(),
+        })?;
+        push_strict_key(
+            &mut keys,
+            "L NUMS internal",
+            slash_authorization.internal_key(),
+        )?;
+        push_strict_key(
+            &mut keys,
+            "L NUMS output",
+            slash_authorization
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        )?;
+        push_strict_script(&mut scripts, "L", slash_authorization.script_pubkey())?;
+    }
+
+    for service in &plan.alternatives {
+        for payout in &service.slash_payouts {
+            if let Some((first_role, _)) =
+                keys.iter().find(|(_, key)| *key == payout.controller_key())
+            {
+                return Err(V026ThresholdGraphV3Error::ControllerDomainAlias {
+                    first_role,
+                    second_role: "Slash payout",
+                });
+            }
+            let payout_script = payout.descriptor().to_script();
+            if let Some((first_role, _)) =
+                scripts.iter().find(|(_, script)| *script == payout_script)
+            {
+                return Err(V026ThresholdGraphV3Error::ScriptDomainAlias {
+                    first_role,
+                    second_role: "Slash payout",
+                });
+            }
+        }
+    }
+    Ok(())
+}
+
+trait LocalConnectorView {
+    fn local_internal_key(&self) -> XOnlyPublicKey;
+    fn local_output_key(&self) -> XOnlyPublicKey;
+    fn local_script_pubkey(&self) -> ScriptBuf;
+}
+
+impl LocalConnectorView for ContestPayoutGateV2 {
+    fn local_internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key()
+    }
+
+    fn local_output_key(&self) -> XOnlyPublicKey {
+        self.spend_info().output_key().to_x_only_public_key()
+    }
+
+    fn local_script_pubkey(&self) -> ScriptBuf {
+        self.script_pubkey()
+    }
+}
+
+impl LocalConnectorView for ContestSlashGateV2 {
+    fn local_internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key()
+    }
+
+    fn local_output_key(&self) -> XOnlyPublicKey {
+        self.spend_info().output_key().to_x_only_public_key()
+    }
+
+    fn local_script_pubkey(&self) -> ScriptBuf {
+        self.script_pubkey()
+    }
+}
