+//! Atomic selected-counterproof parent for the threshold-v3 research profile.
+//!
+//! For selected alternative `j`, the exact topology is
+//! `[C_0..C_n-1, B_0..B_n-1, P, D] ->
+//!  [D_recovery, R_j, a_CP, C_return_(i!=j), B_refund_(i!=j)]`.
+//! Every `C_i`, `B_i`, return destination, and `R_j` is derived from a validated
+//! [`ThresholdV3SelectedBinding`]; callers cannot provide parallel raw rosters
+//! or substitute an unbound resolution connector.
+//!
+//! This remains research-only. Exact graph presigning and key erasure, external
+//! `P`/`D` provenance, the CPFP controller/value policy, descriptor-control
+//! evidence, and a frozen v3 fee profile are activation blockers, so this type
+//! never authorizes funding.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Transaction, TxIn, TxOut,
+};
+use secp256k1::{schnorr, Message, XOnlyPublicKey, SECP256K1};
+use strata_bridge_connectors::{
+    prelude::{
+        ContestCounterproofOutputV2, ContestCounterproofSpendV2, ContestCounterproofV2Error,
+        ContestPayoutGateSpendPathV2, ContestPayoutGateV2, ContestPayoutGateWitnessV2,
+        CounterproofBondConnectorV3, CounterproofBondSpendV3,
+        CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdV3Error,
+        KeyedAnchor, NOfNConnector, NOfNSpend, ThresholdV3BondPolicyError,
+        ThresholdV3SelectedBinding,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::template_fee_v2::{
+    TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2,
+};
+
+/// Exact external `D`/`P` pair shared by every threshold-v3 selection parent.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdSharedSelectionOutpointsV3 {
+    /// Externally proven deposit output `D`.
+    pub deposit_outpoint: OutPoint,
+    /// Contest-created payout gate `P`.
+    pub contest_payout_outpoint: OutPoint,
+}
+
+/// Exact P1-selected data for one atomic threshold counterproof parent.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofThresholdV3Data {
+    /// Validated funded setup plus canonical selected alternative.
+    pub selected: ThresholdV3SelectedBinding,
+    /// External shared `D`/`P` outpoints.
+    pub shared_selection: ThresholdSharedSelectionOutpointsV3,
+}
+
+/// Dynamic signing information in exact transaction-input order.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofThresholdV3SigningInfo {
+    /// One graph sighash for each canonical `C_i` input.
+    pub counterproof_reserves: Vec<SigningInfo>,
+    /// One graph sighash for each canonical `B_i` input.
+    pub bonds: Vec<SigningInfo>,
+    /// Immediate-selection `P` graph sighash.
+    pub contest_payout: SigningInfo,
+    /// Key-path `D` sighash.
+    pub deposit: SigningInfo,
+}
+
+/// Exact dynamic signatures for one atomic threshold counterproof parent.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofThresholdV3Signatures {
+    /// One graph signature for each canonical `C_i` input.
+    pub counterproof_reserves: Vec<schnorr::Signature>,
+    /// One graph signature for each canonical `B_i` input.
+    pub bonds: Vec<schnorr::Signature>,
+    /// Immediate-selection `P` graph signature.
+    pub contest_payout: schnorr::Signature,
+    /// Tweaked key-path `D` signature.
+    pub deposit: schnorr::Signature,
+}
+
+/// Key/control domain checked by the atomic threshold counterproof constructor.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum CounterproofThresholdV3KeyDomain {
+    /// Exact-parent graph authorization.
+    Graph,
+    /// Participant identity key.
+    RegistryIdentity {
+        /// Participant position in the canonical registry.
+        participant: usize,
+    },
+    /// Participant-by-alternative release key.
+    Release {
+        /// Participant position in the canonical registry.
+        participant: usize,
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Counterproof operator authorization.
+    CounterproofOperator {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Counterproof NUMS internal key.
+    CounterproofNumsInternal {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Counterproof tweaked output key.
+    CounterproofNumsOutput {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Bond NUMS internal key.
+    BondNumsInternal {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Bond tweaked output key.
+    BondNumsOutput {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Setup-committed counterproof-return controller.
+    CounterproofReturn {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Setup-committed bond-refund controller.
+    BondRefund {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Setup-committed operator-compensation controller.
+    OperatorCompensation {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Setup-committed timeout-recovery controller.
+    TimeoutRecovery {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// `P` NUMS internal key.
+    ContestPayoutNumsInternal,
+    /// `P` tweaked output key.
+    ContestPayoutNumsOutput,
+    /// `D` internal signing key.
+    DepositInternal,
+    /// `D` tweaked output key.
+    DepositOutput,
+    /// `R_j` NUMS internal key.
+    ResolutionNumsInternal,
+    /// `R_j` tweaked output key.
+    ResolutionNumsOutput,
+    /// Counterproof anchor internal key.
+    CpfpInternal,
+    /// Counterproof anchor tweaked output key.
+    CpfpOutput,
+}
+
+/// Signature role reported by strict finalization errors.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum CounterproofThresholdV3SignatureRole {
+    /// Graph signature for `C_i`.
+    CounterproofGraph {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Operator signature at one code-separator position of selected `C_j`.
+    CounterproofOperator {
+        /// Code-separator datum position.
+        datum: usize,
+    },
+    /// Graph signature for `B_i`.
+    BondGraph {
+        /// Alternative position in the canonical policy.
+        alternative: usize,
+    },
+    /// Immediate-selection graph signature for `P`.
+    ContestPayout,
+    /// Tweaked key-path signature for `D`.
+    Deposit,
+}
+
+/// Exact atomic threshold-v3 selected-counterproof parent.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofThresholdV3Tx {
+    psbt: Psbt,
+    prevouts: Box<[TxOut]>,
+    selected: ThresholdV3SelectedBinding,
+    counterproof_connectors: Box<[ContestCounterproofOutputV2]>,
+    bond_connectors: Box<[CounterproofBondConnectorV3]>,
+    contest_payout_connector: ContestPayoutGateV2,
+    deposit_connector: NOfNConnector,
+    resolution_connector: CounterproofResolutionThresholdConnectorV3,
+    cpfp_connector: KeyedAnchor,
+    shared_selection: ThresholdSharedSelectionOutpointsV3,
+}
+
+impl CounterproofThresholdV3Tx {
+    /// Exact `D` recovery output index.
+    pub const DEPOSIT_RECOVERY_VOUT: u32 = 0;
+    /// Exact selected threshold-resolution output index.
+    pub const RESOLUTION_VOUT: u32 = 1;
+    /// Exact counterproof anchor output index.
+    pub const CPFP_VOUT: u32 = 2;
+    /// First compact unselected `C_i` return output index.
+    pub const COUNTERPROOF_RETURN_0_VOUT: u32 = 3;
+
+    /// Constructs the exact all-C/all-B selected parent.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        data: CounterproofThresholdV3Data,
+        contest_payout_connector: ContestPayoutGateV2,
+        deposit_connector: NOfNConnector,
+        cpfp_connector: KeyedAnchor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofThresholdV3Error> {
+        let setup = data.selected.setup();
+        let policy = setup.policy();
+        let alternatives = policy.alternatives();
+        let reserve_count = alternatives.len();
+        if reserve_count == 0 {
+            return Err(CounterproofThresholdV3Error::EmptyFundedRoster);
+        }
+        if setup.counterproof_funding().len() != reserve_count
+            || setup.bond_funding().len() != reserve_count
+        {
+            return Err(CounterproofThresholdV3Error::FundedRosterInvariant {
+                policies: reserve_count,
+                counterproof: setup.counterproof_funding().len(),
+                bonds: setup.bond_funding().len(),
+            });
+        }
+
+        let selected_index = data.selected.index();
+        let selected_policy = alternatives.get(selected_index).ok_or(
+            CounterproofThresholdV3Error::SelectedIndexInvariant {
+                selected: selected_index,
+                count: reserve_count,
+            },
+        )?;
+        let network = policy.network();
+        let graph_pubkey = policy.graph_pubkey();
+
+        for (component, candidate) in [
+            ("contest payout gate", contest_payout_connector.network()),
+            ("research deposit", deposit_connector.network()),
+            ("counterproof anchor", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(CounterproofThresholdV3Error::NetworkMismatch { component });
+            }
+        }
+        if contest_payout_connector.graph_pubkey() != graph_pubkey {
+            return Err(CounterproofThresholdV3Error::GraphKeyMismatch {
+                component: "contest payout gate",
+            });
+        }
+        let resolution_connector =
+            CounterproofResolutionThresholdConnectorV3::from_selected_binding(&data.selected)
+                .map_err(CounterproofThresholdV3Error::Resolution)?;
+        let counterproof_connectors: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| *alternative.counterproof_output())
+            .collect();
+        let mut bond_connectors = Vec::with_capacity(reserve_count);
+        for index in 0..reserve_count {
+            let connector = policy.bond_connector(index).map_err(|source| {
+                CounterproofThresholdV3Error::BondConnector {
+                    index,
+                    source: Box::new(source),
+                }
+            })?;
+            bond_connectors.push(connector);
+        }
+
+        validate_key_domains(
+            &data.selected,
+            &counterproof_connectors,
+            &bond_connectors,
+            &contest_payout_connector,
+            &deposit_connector,
+            &resolution_connector,
+            &cpfp_connector,
+        )?;
+
+        let mut input_outpoints = Vec::with_capacity(reserve_count * 2 + 2);
+        input_outpoints.extend(
+            setup
+                .counterproof_funding()
+                .iter()
+                .map(|funding| funding.outpoint()),
+        );
+        input_outpoints.extend(
+            setup
+                .bond_funding()
+                .iter()
+                .map(|funding| funding.outpoint()),
+        );
+        input_outpoints.extend([
+            data.shared_selection.contest_payout_outpoint,
+            data.shared_selection.deposit_outpoint,
+        ]);
+        validate_input_outpoints(&input_outpoints)?;
+
+        let mut prevouts = Vec::with_capacity(input_outpoints.len());
+        prevouts.extend(
+            setup
+                .counterproof_funding()
+                .iter()
+                .map(|funding| funding.tx_out().clone()),
+        );
+        prevouts.extend(
+            setup
+                .bond_funding()
+                .iter()
+                .map(|funding| funding.tx_out().clone()),
+        );
+        prevouts.extend([
+            contest_payout_connector.tx_out(),
+            deposit_connector.tx_out(),
+        ]);
+        for prevout in &prevouts {
+            ensure_money_range("threshold counterproof prevout", prevout.value)?;
+            ensure_non_dust("threshold counterproof prevout", prevout)?;
+        }
+        ensure_money_range("threshold counterproof fee", fee)?;
+        fee_allowance
+            .validate(TemplateKindV2::Counterproof, fee)
+            .map_err(CounterproofThresholdV3Error::FeeAllowance)?;
+
+        let deposit_recovery_output = TxOut {
+            value: deposit_connector.value(),
+            script_pubkey: selected_policy.recovery().script_pubkey(),
+        };
+        let resolution_output = resolution_connector.tx_out();
+        let cpfp_output = cpfp_connector.tx_out();
+        let mut counterproof_returns = Vec::with_capacity(reserve_count - 1);
+        let mut bond_refunds = Vec::with_capacity(reserve_count - 1);
+        for (index, alternative) in alternatives.iter().enumerate() {
+            if index != selected_index {
+                counterproof_returns.push(
+                    alternative
+                        .counterproof_return()
+                        .tx_out(alternative.counterproof_output().value()),
+                );
+                bond_refunds.push(alternative.bond_refund().tx_out(alternative.bond_value()));
+            }
+        }
+        for (field, output) in
+            std::iter::once(("deposit recovery output", &deposit_recovery_output))
+                .chain(std::iter::once((
+                    "threshold resolution output",
+                    &resolution_output,
+                )))
+                .chain(std::iter::once((
+                    "counterproof anchor output",
+                    &cpfp_output,
+                )))
+                .chain(
+                    counterproof_returns
+                        .iter()
+                        .map(|output| ("counterproof return output", output)),
+                )
+                .chain(
+                    bond_refunds
+                        .iter()
+                        .map(|output| ("bond refund output", output)),
+                )
+        {
+            ensure_money_range(field, output.value)?;
+            ensure_non_dust(field, output)?;
+        }
+
+        let selected_contest_input = selected_policy
+            .counterproof_output()
+            .value()
+            .checked_add(contest_payout_connector.value())
+            .ok_or(CounterproofThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("selected C plus P input", selected_contest_input)?;
+        let selected_base_outputs = selected_policy
+            .base_resolution_value()
+            .checked_add(cpfp_connector.value())
+            .ok_or(CounterproofThresholdV3Error::AmountOverflow)?;
+        let selected_required = selected_base_outputs
+            .checked_add(fee)
+            .ok_or(CounterproofThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("selected base outputs plus fee", selected_required)?;
+        if selected_contest_input != selected_required {
+            return Err(CounterproofThresholdV3Error::SelectedValueNotConserved {
+                input: selected_contest_input,
+                base_output: selected_base_outputs,
+                fee,
+            });
+        }
+
+        let total_input = checked_sum(
+            "threshold counterproof total input",
+            prevouts.iter().map(|prevout| prevout.value),
+        )?;
+        let total_output = checked_sum(
+            "threshold counterproof total output",
+            std::iter::once(deposit_recovery_output.value)
+                .chain(std::iter::once(resolution_output.value))
+                .chain(std::iter::once(cpfp_output.value))
+                .chain(counterproof_returns.iter().map(|output| output.value))
+                .chain(bond_refunds.iter().map(|output| output.value)),
+        )?;
+        let total_output_and_fee = total_output
+            .checked_add(fee)
+            .ok_or(CounterproofThresholdV3Error::AmountOverflow)?;
+        ensure_money_range(
+            "threshold counterproof total output plus fee",
+            total_output_and_fee,
+        )?;
+        if total_input != total_output_and_fee {
+            return Err(CounterproofThresholdV3Error::TotalValueNotConserved {
+                input: total_input,
+                output: total_output,
+                fee,
+            });
+        }
+
+        let mut input = Vec::with_capacity(input_outpoints.len());
+        input.extend(
+            counterproof_connectors
+                .iter()
+                .enumerate()
+                .map(|(index, connector)| {
+                    let path = if index == selected_index {
+                        ContestCounterproofSpendV2::Counterproof
+                    } else {
+                        ContestCounterproofSpendV2::ReserveRecovery
+                    };
+                    TxIn {
+                        previous_output: setup.counterproof_funding()[index].outpoint(),
+                        sequence: connector.sequence(path),
+                        ..Default::default()
+                    }
+                }),
+        );
+        input.extend(
+            bond_connectors
+                .iter()
+                .enumerate()
+                .map(|(index, connector)| TxIn {
+                    previous_output: setup.bond_funding()[index].outpoint(),
+                    sequence: connector.sequence(CounterproofBondSpendV3),
+                    ..Default::default()
+                }),
+        );
+        input.extend([
+            TxIn {
+                previous_output: data.shared_selection.contest_payout_outpoint,
+                sequence: contest_payout_connector
+                    .sequence(ContestPayoutGateSpendPathV2::ImmediateSelection),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.shared_selection.deposit_outpoint,
+                sequence: deposit_connector.sequence(NOfNSpend),
+                ..Default::default()
+            },
+        ]);
+        let mut output = vec![deposit_recovery_output, resolution_output, cpfp_output];
+        output.extend(counterproof_returns);
+        output.extend(bond_refunds);
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(CounterproofThresholdV3Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts: prevouts.into_boxed_slice(),
+            selected: data.selected,
+            counterproof_connectors: counterproof_connectors.into_boxed_slice(),
+            bond_connectors: bond_connectors.into_boxed_slice(),
+            contest_payout_connector,
+            deposit_connector,
+            resolution_connector,
+            cpfp_connector,
+            shared_selection: data.shared_selection,
+        })
+    }
+
+    /// This research transaction never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Returns the exact P1-bound threshold-resolution connector.
+    pub const fn resolution_connector(&self) -> &CounterproofResolutionThresholdConnectorV3 {
+        &self.resolution_connector
+    }
+
+    /// Returns the validated selected binding used by this parent.
+    pub const fn selected_binding(&self) -> &ThresholdV3SelectedBinding {
+        &self.selected
+    }
+
+    /// Returns the exact external `D` and Contest-derived `P` outpoints.
+    pub const fn shared_selection(&self) -> ThresholdSharedSelectionOutpointsV3 {
+        self.shared_selection
+    }
+
+    /// Returns the exact Contest payout connector spent by this parent.
+    pub const fn contest_payout_connector(&self) -> &ContestPayoutGateV2 {
+        &self.contest_payout_connector
+    }
+
+    /// Returns the exact research deposit connector spent by this parent.
+    pub const fn deposit_connector(&self) -> &NOfNConnector {
+        &self.deposit_connector
+    }
+
+    /// Returns the exact counterproof-only CPFP connector.
+    pub const fn cpfp_connector(&self) -> &KeyedAnchor {
+        &self.cpfp_connector
+    }
+
+    /// Returns the outpoint of the P1-bound threshold-resolution output.
+    pub fn resolution_outpoint(&self) -> OutPoint {
+        OutPoint::new(self.psbt.unsigned_tx.compute_txid(), Self::RESOLUTION_VOUT)
+    }
+
+    /// Returns selected-C operator sighashes in natural datum order.
+    pub fn operator_sighashes(&self) -> Result<Vec<Message>, CounterproofThresholdV3Error> {
+        let selected = self.selected.index();
+        let connector = self.counterproof_connectors.get(selected).ok_or(
+            CounterproofThresholdV3Error::SelectedIndexInvariant {
+                selected,
+                count: self.counterproof_connectors.len(),
+            },
+        )?;
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        Ok(connector
+            .get_sighashes_with_code_separator(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestCounterproofSpendV2::Counterproof,
+                selected,
+            )
+            .into_iter()
+            .collect())
+    }
+
+    /// Returns typed signing information in canonical input-role order.
+    pub fn signing_info(&self) -> CounterproofThresholdV3SigningInfo {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        let reserve_count = self.counterproof_connectors.len();
+        let counterproof_reserves = self
+            .counterproof_connectors
+            .iter()
+            .enumerate()
+            .map(|(index, connector)| {
+                let path = if index == self.selected.index() {
+                    ContestCounterproofSpendV2::Counterproof
+                } else {
+                    ContestCounterproofSpendV2::ReserveRecovery
+                };
+                connector.get_signing_info(&mut cache, Prevouts::All(&self.prevouts), path, index)
+            })
+            .collect();
+        let bonds = self
+            .bond_connectors
+            .iter()
+            .enumerate()
+            .map(|(index, connector)| {
+                connector.get_signing_info(
+                    &mut cache,
+                    Prevouts::All(&self.prevouts),
+                    CounterproofBondSpendV3,
+                    reserve_count + index,
+                )
+            })
+            .collect();
+        CounterproofThresholdV3SigningInfo {
+            counterproof_reserves,
+            bonds,
+            contest_payout: self.contest_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestPayoutGateSpendPathV2::ImmediateSelection,
+                reserve_count * 2,
+            ),
+            deposit: self.deposit_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                NOfNSpend,
+                reserve_count * 2 + 1,
+            ),
+        }
+    }
+
+    /// Returns the exact compact output index for an unselected `C_i` return.
+    pub fn counterproof_return_vout(
+        &self,
+        alternative: usize,
+    ) -> Result<u32, CounterproofThresholdV3Error> {
+        let compact = self.compact_unselected_index(alternative)?;
+        Self::COUNTERPROOF_RETURN_0_VOUT
+            .checked_add(
+                u32::try_from(compact).map_err(|_| {
+                    CounterproofThresholdV3Error::ReturnVoutOverflow { alternative }
+                })?,
+            )
+            .ok_or(CounterproofThresholdV3Error::ReturnVoutOverflow { alternative })
+    }
+
+    /// Returns the exact compact output index for an unselected `B_i` refund.
+    pub fn bond_refund_vout(
+        &self,
+        alternative: usize,
+    ) -> Result<u32, CounterproofThresholdV3Error> {
+        let compact = self.compact_unselected_index(alternative)?;
+        let counterproof_return_count = self
+            .counterproof_connectors
+            .len()
+            .checked_sub(1)
+            .ok_or(CounterproofThresholdV3Error::EmptyFundedRoster)?;
+        let base =
+            Self::COUNTERPROOF_RETURN_0_VOUT
+                .checked_add(u32::try_from(counterproof_return_count).map_err(|_| {
+                    CounterproofThresholdV3Error::ReturnVoutOverflow { alternative }
+                })?)
+                .ok_or(CounterproofThresholdV3Error::ReturnVoutOverflow { alternative })?;
+        base.checked_add(
+            u32::try_from(compact)
+                .map_err(|_| CounterproofThresholdV3Error::ReturnVoutOverflow { alternative })?,
+        )
+        .ok_or(CounterproofThresholdV3Error::ReturnVoutOverflow { alternative })
+    }
+
+    fn compact_unselected_index(
+        &self,
+        alternative: usize,
+    ) -> Result<usize, CounterproofThresholdV3Error> {
+        let count = self.counterproof_connectors.len();
+        if alternative >= count {
+            return Err(CounterproofThresholdV3Error::ReturnIndexOutOfRange { alternative, count });
+        }
+        let selected = self.selected.index();
+        if alternative == selected {
+            return Err(
+                CounterproofThresholdV3Error::SelectedAlternativeHasNoReturn { alternative },
+            );
+        }
+        Ok(if alternative < selected {
+            alternative
+        } else {
+            alternative - 1
+        })
+    }
+
+    /// Verifies every Schnorr signature, then installs every exact witness.
+    pub fn finalize(
+        self,
+        operator_signatures: Vec<schnorr::Signature>,
+        signatures: CounterproofThresholdV3Signatures,
+    ) -> Result<Transaction, CounterproofThresholdV3Error> {
+        let count = self.counterproof_connectors.len();
+        validate_signature_count(
+            "counterproof graph",
+            count,
+            signatures.counterproof_reserves.len(),
+        )?;
+        validate_signature_count("bond graph", count, signatures.bonds.len())?;
+        let selected_index = self.selected.index();
+        let selected_connector = *self.counterproof_connectors.get(selected_index).ok_or(
+            CounterproofThresholdV3Error::SelectedIndexInvariant {
+                selected: selected_index,
+                count,
+            },
+        )?;
+        let expected_operators = selected_connector.n_data().get();
+        if operator_signatures.len() != expected_operators {
+            return Err(CounterproofThresholdV3Error::OperatorSignatureCount {
+                expected: expected_operators,
+                actual: operator_signatures.len(),
+            });
+        }
+
+        let signing_info = self.signing_info();
+        let graph_pubkey = self.selected.setup().policy().graph_pubkey();
+        for (index, (signature, info)) in signatures
+            .counterproof_reserves
+            .iter()
+            .zip(signing_info.counterproof_reserves.iter())
+            .enumerate()
+        {
+            verify_signature(
+                *signature,
+                info.sighash,
+                graph_pubkey,
+                CounterproofThresholdV3SignatureRole::CounterproofGraph { alternative: index },
+            )?;
+        }
+        for (index, (signature, info)) in signatures
+            .bonds
+            .iter()
+            .zip(signing_info.bonds.iter())
+            .enumerate()
+        {
+            verify_signature(
+                *signature,
+                info.sighash,
+                graph_pubkey,
+                CounterproofThresholdV3SignatureRole::BondGraph { alternative: index },
+            )?;
+        }
+        verify_signature(
+            signatures.contest_payout,
+            signing_info.contest_payout.sighash,
+            graph_pubkey,
+            CounterproofThresholdV3SignatureRole::ContestPayout,
+        )?;
+        verify_signature(
+            signatures.deposit,
+            signing_info.deposit.sighash,
+            self.deposit_connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+            CounterproofThresholdV3SignatureRole::Deposit,
+        )?;
+        let operator_sighashes = self.operator_sighashes()?;
+        if operator_sighashes.len() != expected_operators {
+            return Err(CounterproofThresholdV3Error::OperatorSighashInvariant {
+                expected: expected_operators,
+                actual: operator_sighashes.len(),
+            });
+        }
+        for (datum, (signature, sighash)) in operator_signatures
+            .iter()
+            .zip(operator_sighashes.iter())
+            .enumerate()
+        {
+            verify_signature(
+                *signature,
+                *sighash,
+                selected_connector.operator_pubkey(),
+                CounterproofThresholdV3SignatureRole::CounterproofOperator { datum },
+            )?;
+        }
+
+        let selected_witness = selected_connector
+            .counterproof_witness(
+                signatures.counterproof_reserves[selected_index],
+                operator_signatures,
+            )
+            .map_err(CounterproofThresholdV3Error::ContestWitness)?;
+        let mut psbt = self.psbt;
+        for (index, connector) in self.counterproof_connectors.iter().enumerate() {
+            let (path, witness) = if index == selected_index {
+                (
+                    ContestCounterproofSpendV2::Counterproof,
+                    selected_witness.clone(),
+                )
+            } else {
+                (
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    connector.reserve_recovery_witness(signatures.counterproof_reserves[index]),
+                )
+            };
+            connector
+                .try_finalize_input(&mut psbt.inputs[index], path, &witness)
+                .map_err(CounterproofThresholdV3Error::ContestWitness)?;
+        }
+        for (index, connector) in self.bond_connectors.iter().enumerate() {
+            connector.finalize_input(
+                &mut psbt.inputs[count + index],
+                &CounterproofBondConnectorV3::witness(signatures.bonds[index]),
+            );
+        }
+        self.contest_payout_connector.finalize_input(
+            &mut psbt.inputs[count * 2],
+            &ContestPayoutGateWitnessV2::ImmediateSelection {
+                graph_signature: signatures.contest_payout,
+            },
+        );
+        self.deposit_connector
+            .finalize_input(&mut psbt.inputs[count * 2 + 1], &signatures.deposit);
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn validate_input_outpoints(outpoints: &[OutPoint]) -> Result<(), CounterproofThresholdV3Error> {
+    for (index, outpoint) in outpoints.iter().enumerate() {
+        if *outpoint == OutPoint::null() {
+            return Err(CounterproofThresholdV3Error::NullInputOutpoint { index });
+        }
+        if let Some(first_index) = outpoints[..index]
+            .iter()
+            .position(|earlier| earlier == outpoint)
+        {
+            return Err(CounterproofThresholdV3Error::DuplicateInputOutpoint {
+                first_index,
+                duplicate_index: index,
+            });
+        }
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn validate_key_domains(
+    selected: &ThresholdV3SelectedBinding,
+    counterproofs: &[ContestCounterproofOutputV2],
+    bonds: &[CounterproofBondConnectorV3],
+    payout: &ContestPayoutGateV2,
+    deposit: &NOfNConnector,
+    resolution: &CounterproofResolutionThresholdConnectorV3,
+    cpfp: &KeyedAnchor,
+) -> Result<(), CounterproofThresholdV3Error> {
+    let policy = selected.setup().policy();
+    let registry = policy.registry();
+    let mut committed = vec![(
+        CounterproofThresholdV3KeyDomain::Graph,
+        policy.graph_pubkey(),
+    )];
+    for (participant, identity) in registry.participants().iter().enumerate() {
+        committed.push((
+            CounterproofThresholdV3KeyDomain::RegistryIdentity { participant },
+            identity.identity_pubkey(),
+        ));
+        committed.extend(identity.release_pubkeys().iter().copied().enumerate().map(
+            |(alternative, key)| {
+                (
+                    CounterproofThresholdV3KeyDomain::Release {
+                        participant,
+                        alternative,
+                    },
+                    key,
+                )
+            },
+        ));
+    }
+    for (alternative, (counterproof, bond)) in counterproofs.iter().zip(bonds.iter()).enumerate() {
+        let static_policy = &policy.alternatives()[alternative];
+        committed.extend([
+            (
+                CounterproofThresholdV3KeyDomain::CounterproofOperator { alternative },
+                counterproof.operator_pubkey(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::CounterproofNumsInternal { alternative },
+                counterproof.internal_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::CounterproofNumsOutput { alternative },
+                counterproof
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::BondNumsInternal { alternative },
+                bond.internal_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::BondNumsOutput { alternative },
+                bond.spend_info().output_key().to_x_only_public_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::CounterproofReturn { alternative },
+                static_policy.counterproof_return().output_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::BondRefund { alternative },
+                static_policy.bond_refund().output_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::OperatorCompensation { alternative },
+                static_policy.operator_compensation().output_key(),
+            ),
+            (
+                CounterproofThresholdV3KeyDomain::TimeoutRecovery { alternative },
+                static_policy.recovery().output_key(),
+            ),
+        ]);
+    }
+
+    let dynamic = [
+        (
+            CounterproofThresholdV3KeyDomain::ContestPayoutNumsInternal,
+            payout.internal_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::ContestPayoutNumsOutput,
+            payout.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::DepositInternal,
+            deposit.internal_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::DepositOutput,
+            deposit.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::ResolutionNumsInternal,
+            resolution.internal_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::ResolutionNumsOutput,
+            resolution.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::CpfpInternal,
+            cpfp.internal_key(),
+        ),
+        (
+            CounterproofThresholdV3KeyDomain::CpfpOutput,
+            cpfp.spend_info().output_key().to_x_only_public_key(),
+        ),
+    ];
+    for (second, key) in dynamic {
+        if let Some((first, _)) = committed.iter().find(|(_, earlier)| *earlier == key) {
+            return Err(CounterproofThresholdV3Error::KeyDomainAlias {
+                first: *first,
+                second,
+            });
+        }
+        committed.push((second, key));
+    }
+    Ok(())
+}
+
+fn checked_sum(
+    field: &'static str,
+    values: impl IntoIterator<Item = Amount>,
+) -> Result<Amount, CounterproofThresholdV3Error> {
+    let mut total = Amount::ZERO;
+    for value in values {
+        ensure_money_range(field, value)?;
+        total = total
+            .checked_add(value)
+            .ok_or(CounterproofThresholdV3Error::AmountOverflow)?;
+        ensure_money_range(field, total)?;
+    }
+    Ok(total)
+}
+
+fn ensure_money_range(
+    field: &'static str,
+    value: Amount,
+) -> Result<(), CounterproofThresholdV3Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofThresholdV3Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(
+    field: &'static str,
+    output: &TxOut,
+) -> Result<(), CounterproofThresholdV3Error> {
+    let minimum = output.script_pubkey.minimal_non_dust();
+    if output.value < minimum {
+        return Err(CounterproofThresholdV3Error::DustValue {
+            field,
+            value: output.value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+const fn validate_signature_count(
+    role: &'static str,
+    expected: usize,
+    actual: usize,
+) -> Result<(), CounterproofThresholdV3Error> {
+    if actual != expected {
+        return Err(CounterproofThresholdV3Error::SignatureCount {
+            role,
+            expected,
+            actual,
+        });
+    }
+    Ok(())
+}
+
+fn verify_signature(
+    signature: schnorr::Signature,
+    sighash: Message,
+    pubkey: XOnlyPublicKey,
+    role: CounterproofThresholdV3SignatureRole,
+) -> Result<(), CounterproofThresholdV3Error> {
+    SECP256K1
+        .verify_schnorr(&signature, &sighash, &pubkey)
+        .map_err(|_| CounterproofThresholdV3Error::InvalidSignature { role })
+}
