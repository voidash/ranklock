@@ -0,0 +1,1147 @@
+//! Research-only threshold-profile timeout settlement.
+//!
+//! This side-by-side parent spends the selected threshold resolution `R` through
+//! its unchanged CSV timeout leaf and the selected contest Slash gate `S`
+//! through its immediate settlement leaf. Its canonical outputs are
+//! `[B_operator, a_timeout]` plus at most one computed recovery-change output.
+//! The v2 fee allowance is reused only as a local ceiling and is not a canonical
+//! v3 wire commitment. This type is unconditionally funding-ineligible.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Transaction, TxIn, TxOut,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, XOnlyPublicKey, SECP256K1};
+use strata_bridge_connectors::{
+    prelude::{
+        ContestSlashGateSpendPathV2, ContestSlashGateV2, ContestSlashGateWitnessV2,
+        CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdSpendPathV3,
+        KeyedAnchor, ThresholdAckAlternativeV3,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    nums_safety_v2::{known_nums_keys, NumsKeyKindV2},
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+    PresignedTx,
+};
+
+/// Exact selected timeout inputs and alternative identity.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofTimeoutSettlementThresholdV3Data {
+    /// Selected threshold-resolution output.
+    pub resolution_outpoint: OutPoint,
+    /// Contest Slash gate shared with the competing Slash parent.
+    pub contest_slash_outpoint: OutPoint,
+    /// Setup-committed selected alternative.
+    pub alternative: ThresholdAckAlternativeV3,
+}
+
+/// Setup-committed operator compensation paid from selected collateral.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct SelectedBondOperatorCompensationV3 {
+    descriptor: Descriptor,
+    controller_key: XOnlyPublicKey,
+    value: Amount,
+}
+
+impl SelectedBondOperatorCompensationV3 {
+    /// Constructs a non-dust P2TR operator-compensation output.
+    pub fn new(
+        descriptor: Descriptor,
+        value: Amount,
+    ) -> Result<Self, SelectedBondOperatorCompensationV3Error> {
+        if descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(
+                SelectedBondOperatorCompensationV3Error::InvalidDescriptorType {
+                    actual: descriptor.type_tag(),
+                },
+            );
+        }
+        let controller_key = XOnlyPublicKey::from_slice(descriptor.payload())
+            .map_err(|_| SelectedBondOperatorCompensationV3Error::InvalidDescriptorPayload)?;
+        if value > Amount::MAX_MONEY {
+            return Err(SelectedBondOperatorCompensationV3Error::MoneyRange { value });
+        }
+        let minimum = descriptor.to_script().minimal_non_dust();
+        if value < minimum {
+            return Err(SelectedBondOperatorCompensationV3Error::DustValue { value, minimum });
+        }
+        Ok(Self {
+            descriptor,
+            controller_key,
+            value,
+        })
+    }
+
+    /// Returns the exact setup-committed descriptor.
+    pub const fn descriptor(&self) -> &Descriptor {
+        &self.descriptor
+    }
+
+    /// Returns the P2TR controller/output key.
+    pub const fn controller_key(&self) -> XOnlyPublicKey {
+        self.controller_key
+    }
+
+    /// Returns the exact compensation amount.
+    pub const fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn tx_out(&self) -> TxOut {
+        TxOut {
+            value: self.value,
+            script_pubkey: self.descriptor.to_script(),
+        }
+    }
+}
+
+/// Invalid selected-bond operator compensation.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SelectedBondOperatorCompensationV3Error {
+    /// Only P2TR descriptors are accepted.
+    InvalidDescriptorType {
+        /// Rejected descriptor type.
+        actual: DescriptorType,
+    },
+    /// Descriptor payload is not an x-only key.
+    InvalidDescriptorPayload,
+    /// Compensation exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Rejected value.
+        value: Amount,
+    },
+    /// Compensation is below the exact script's dust floor.
+    DustValue {
+        /// Rejected value.
+        value: Amount,
+        /// Required minimum.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for SelectedBondOperatorCompensationV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidDescriptorType { actual } => {
+                write!(f, "operator compensation must be P2TR, got {actual}")
+            }
+            Self::InvalidDescriptorPayload => {
+                f.write_str("operator-compensation P2TR payload is not an x-only key")
+            }
+            Self::MoneyRange { value } => {
+                write!(f, "operator compensation {value} exceeds MoneyRange")
+            }
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "operator compensation {value} is below its dust floor {minimum}"
+            ),
+        }
+    }
+}
+
+impl Error for SelectedBondOperatorCompensationV3Error {}
+
+/// Exact CSV-delayed settlement for the threshold release profile.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofTimeoutSettlementThresholdV3Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    resolution_connector: CounterproofResolutionThresholdConnectorV3,
+    contest_slash_connector: ContestSlashGateV2,
+    operator_compensation: SelectedBondOperatorCompensationV3,
+    cpfp_connector: KeyedAnchor,
+}
+
+impl CounterproofTimeoutSettlementThresholdV3Tx {
+    /// Selected-bond operator-compensation output index.
+    pub const OPERATOR_COMPENSATION_VOUT: u32 = 0;
+    /// Dedicated timeout anchor output index.
+    pub const CPFP_VOUT: u32 = 1;
+    /// Optional recovery-change output index.
+    pub const RECOVERY_CHANGE_VOUT: u32 = 2;
+    /// Number of exact parent inputs.
+    pub const N_INPUTS: usize = 2;
+
+    /// Constructs canonical `[B_operator, a_timeout, recovery_change?]` outputs.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new(
+        data: CounterproofTimeoutSettlementThresholdV3Data,
+        resolution_connector: CounterproofResolutionThresholdConnectorV3,
+        contest_slash_connector: ContestSlashGateV2,
+        operator_compensation: SelectedBondOperatorCompensationV3,
+        cpfp_connector: KeyedAnchor,
+        recovery_descriptor: &Descriptor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofTimeoutSettlementThresholdV3Error> {
+        if data.resolution_outpoint == data.contest_slash_outpoint {
+            return Err(CounterproofTimeoutSettlementThresholdV3Error::DuplicateInputOutpoint);
+        }
+        if data.alternative != resolution_connector.alternative() {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::AlternativeMismatch {
+                    data: data.alternative,
+                    connector: resolution_connector.alternative(),
+                },
+            );
+        }
+        let network = resolution_connector.network();
+        for (connector, candidate) in [
+            ("contest Slash gate", contest_slash_connector.network()),
+            ("timeout anchor", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(
+                    CounterproofTimeoutSettlementThresholdV3Error::NetworkMismatch { connector },
+                );
+            }
+        }
+        if resolution_connector.graph_pubkey() != contest_slash_connector.graph_pubkey() {
+            return Err(CounterproofTimeoutSettlementThresholdV3Error::GraphKeyMismatch);
+        }
+        if recovery_descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::InvalidRecoveryDescriptorType {
+                    actual: recovery_descriptor.type_tag(),
+                },
+            );
+        }
+        let recovery_key =
+            XOnlyPublicKey::from_slice(recovery_descriptor.payload()).map_err(|_| {
+                CounterproofTimeoutSettlementThresholdV3Error::InvalidRecoveryDescriptorPayload
+            })?;
+
+        validate_key_domains(
+            &resolution_connector,
+            &contest_slash_connector,
+            &operator_compensation,
+            &cpfp_connector,
+            recovery_key,
+        )?;
+
+        for (field, value) in [
+            ("threshold resolution prevout", resolution_connector.value()),
+            ("contest Slash prevout", contest_slash_connector.value()),
+            ("operator compensation", operator_compensation.value()),
+            ("timeout anchor", cpfp_connector.value()),
+            ("timeout fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::CounterproofTimeoutSettlement, fee)
+            .map_err(CounterproofTimeoutSettlementThresholdV3Error::FeeAllowance)?;
+        ensure_non_dust("operator compensation", &operator_compensation.tx_out())?;
+        ensure_non_dust("timeout anchor", &cpfp_connector.tx_out())?;
+
+        let input_value = resolution_connector
+            .value()
+            .checked_add(contest_slash_connector.value())
+            .ok_or(CounterproofTimeoutSettlementThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("threshold timeout total input", input_value)?;
+        let fixed_output = operator_compensation
+            .value()
+            .checked_add(cpfp_connector.value())
+            .ok_or(CounterproofTimeoutSettlementThresholdV3Error::AmountOverflow)?;
+        let fixed_output_and_fee = fixed_output
+            .checked_add(fee)
+            .ok_or(CounterproofTimeoutSettlementThresholdV3Error::AmountOverflow)?;
+        let recovery_change = input_value.checked_sub(fixed_output_and_fee).ok_or(
+            CounterproofTimeoutSettlementThresholdV3Error::InsufficientInput {
+                input: input_value,
+                fixed_output,
+                fee,
+            },
+        )?;
+
+        let recovery_script = recovery_descriptor.to_script();
+        let mut output = vec![operator_compensation.tx_out(), cpfp_connector.tx_out()];
+        if recovery_change != Amount::ZERO {
+            let recovery_output = TxOut {
+                value: recovery_change,
+                script_pubkey: recovery_script.clone(),
+            };
+            ensure_money_range("threshold timeout recovery change", recovery_change)?;
+            ensure_non_dust("threshold timeout recovery change", &recovery_output)?;
+            output.push(recovery_output);
+        }
+        validate_script_domains(&resolution_connector, &contest_slash_connector, &output)?;
+        let output_value = output.iter().try_fold(Amount::ZERO, |sum, item| {
+            sum.checked_add(item.value)
+                .ok_or(CounterproofTimeoutSettlementThresholdV3Error::AmountOverflow)
+        })?;
+        if output_value.checked_add(fee) != Some(input_value) {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::ValueNotConserved {
+                    input: input_value,
+                    output: output_value,
+                    fee,
+                },
+            );
+        }
+
+        let prevouts = [
+            resolution_connector.tx_out(),
+            contest_slash_connector.tx_out(),
+        ];
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![
+                TxIn {
+                    previous_output: data.resolution_outpoint,
+                    sequence: resolution_connector
+                        .sequence(CounterproofResolutionThresholdSpendPathV3::Timeout),
+                    ..Default::default()
+                },
+                TxIn {
+                    previous_output: data.contest_slash_outpoint,
+                    sequence: contest_slash_connector
+                        .sequence(ContestSlashGateSpendPathV2::Settlement),
+                    ..Default::default()
+                },
+            ],
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx)
+            .map_err(CounterproofTimeoutSettlementThresholdV3Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+        Ok(Self {
+            psbt,
+            prevouts,
+            resolution_connector,
+            contest_slash_connector,
+            operator_compensation,
+            cpfp_connector,
+        })
+    }
+
+    /// This research template can never authorize funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Returns the selected alternative identity.
+    pub const fn alternative(&self) -> ThresholdAckAlternativeV3 {
+        self.resolution_connector.alternative()
+    }
+
+    /// Returns the exact operator-compensation policy.
+    pub const fn operator_compensation(&self) -> &SelectedBondOperatorCompensationV3 {
+        &self.operator_compensation
+    }
+
+    /// Returns the optional computed recovery-change output.
+    pub fn recovery_change_tx_out(&self) -> Option<&TxOut> {
+        self.psbt
+            .unsigned_tx
+            .output
+            .get(Self::RECOVERY_CHANGE_VOUT as usize)
+    }
+
+    /// Verifies and installs both exact graph signatures.
+    pub fn finalize(
+        self,
+        graph_signatures: [schnorr::Signature; Self::N_INPUTS],
+    ) -> Result<Transaction, CounterproofTimeoutSettlementThresholdV3Error> {
+        let signing_info = self.signing_info();
+        for (input_index, (signature, info)) in
+            graph_signatures.iter().zip(signing_info.iter()).enumerate()
+        {
+            SECP256K1
+                .verify_schnorr(
+                    signature,
+                    &info.sighash,
+                    &self.resolution_connector.graph_pubkey(),
+                )
+                .map_err(|_| {
+                    CounterproofTimeoutSettlementThresholdV3Error::InvalidGraphSignature {
+                        input_index,
+                    }
+                })?;
+        }
+        let mut psbt = self.psbt;
+        let resolution_witness = self
+            .resolution_connector
+            .timeout_witness(graph_signatures[0]);
+        self.resolution_connector
+            .finalize_input(&mut psbt.inputs[0], &resolution_witness);
+        self.contest_slash_connector.finalize_input(
+            &mut psbt.inputs[1],
+            &ContestSlashGateWitnessV2::Settlement {
+                graph_signature: graph_signatures[1],
+            },
+        );
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn validate_key_domains(
+    resolution: &CounterproofResolutionThresholdConnectorV3,
+    slash: &ContestSlashGateV2,
+    compensation: &SelectedBondOperatorCompensationV3,
+    cpfp: &KeyedAnchor,
+    recovery_key: XOnlyPublicKey,
+) -> Result<(), CounterproofTimeoutSettlementThresholdV3Error> {
+    let mut domains = vec![
+        (
+            ThresholdTimeoutKeyDomainV3::Graph,
+            resolution.graph_pubkey(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::ResolutionNumsInternal,
+            resolution.internal_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::ResolutionNumsOutput,
+            resolution.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::SlashNumsInternal,
+            slash.internal_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::SlashNumsOutput,
+            slash.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::OperatorCompensation,
+            compensation.controller_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::CpfpInternal,
+            cpfp.internal_key(),
+        ),
+        (
+            ThresholdTimeoutKeyDomainV3::CpfpOutput,
+            cpfp.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (ThresholdTimeoutKeyDomainV3::Recovery, recovery_key),
+    ];
+    domains.extend(
+        resolution
+            .release_pubkeys()
+            .iter()
+            .copied()
+            .enumerate()
+            .map(|(index, key)| (ThresholdTimeoutKeyDomainV3::Release { index }, key)),
+    );
+    for second in 0..domains.len() {
+        if let Some((first_domain, _)) = domains[..second]
+            .iter()
+            .find(|(_, key)| *key == domains[second].1)
+        {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::KeyDomainAlias {
+                    first: *first_domain,
+                    second: domains[second].0,
+                },
+            );
+        }
+    }
+
+    // Keep the shared v2 NUMS classifier in this v3 side-by-side template so a
+    // future connector implementation change cannot silently omit either key.
+    let nums = [
+        known_nums_keys("threshold resolution R", resolution),
+        known_nums_keys("contest Slash S", slash),
+    ]
+    .into_iter()
+    .flatten()
+    .collect::<Vec<_>>();
+    for (role, key) in [
+        ("operator compensation", compensation.controller_key()),
+        ("timeout anchor", cpfp.internal_key()),
+        ("recovery", recovery_key),
+    ] {
+        if let Some(nums_key) = nums.iter().find(|nums_key| nums_key.key == key) {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::NumsControlKeyAlias {
+                    controlled_component: role,
+                    nums_component: nums_key.component,
+                    key_kind: nums_key.kind,
+                },
+            );
+        }
+    }
+    Ok(())
+}
+
+fn validate_script_domains(
+    resolution: &CounterproofResolutionThresholdConnectorV3,
+    slash: &ContestSlashGateV2,
+    outputs: &[TxOut],
+) -> Result<(), CounterproofTimeoutSettlementThresholdV3Error> {
+    let input_scripts = [resolution.script_pubkey(), slash.script_pubkey()];
+    for (output_index, output) in outputs.iter().enumerate() {
+        if let Some(input_index) = input_scripts
+            .iter()
+            .position(|script| *script == output.script_pubkey)
+        {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::InputOutputScriptAlias {
+                    input_index,
+                    output_index,
+                },
+            );
+        }
+        if outputs[..output_index]
+            .iter()
+            .any(|earlier| earlier.script_pubkey == output.script_pubkey)
+        {
+            return Err(
+                CounterproofTimeoutSettlementThresholdV3Error::OutputScriptCollision {
+                    output_index,
+                },
+            );
+        }
+    }
+    Ok(())
+}
+
+fn ensure_money_range(
+    field: &'static str,
+    value: Amount,
+) -> Result<(), CounterproofTimeoutSettlementThresholdV3Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofTimeoutSettlementThresholdV3Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(
+    field: &'static str,
+    output: &TxOut,
+) -> Result<(), CounterproofTimeoutSettlementThresholdV3Error> {
+    let minimum = output.script_pubkey.minimal_non_dust();
+    if output.value < minimum {
+        return Err(CounterproofTimeoutSettlementThresholdV3Error::DustOutput {
+            field,
+            value: output.value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+impl ParentTx for CounterproofTimeoutSettlementThresholdV3Tx {
+    type CpfpConnector = KeyedAnchor;
+
+    fn cpfp_tx_out(&self) -> TxOut {
+        self.cpfp_connector.tx_out()
+    }
+
+    fn cpfp_outpoint(&self) -> OutPoint {
+        OutPoint::new(self.psbt.unsigned_tx.compute_txid(), Self::CPFP_VOUT)
+    }
+
+    fn cpfp_connector(&self) -> &Self::CpfpConnector {
+        &self.cpfp_connector
+    }
+}
+
+impl PresignedTx<{ Self::N_INPUTS }> for CounterproofTimeoutSettlementThresholdV3Tx {
+    fn signing_info(&self) -> [SigningInfo; Self::N_INPUTS] {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        [
+            self.resolution_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                CounterproofResolutionThresholdSpendPathV3::Timeout,
+                0,
+            ),
+            self.contest_slash_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestSlashGateSpendPathV2::Settlement,
+                1,
+            ),
+        ]
+    }
+}
+
+impl AsRef<Transaction> for CounterproofTimeoutSettlementThresholdV3Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
