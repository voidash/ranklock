+impl Connector for CounterproofResolutionThresholdConnectorV3 {
+    type SpendPath = CounterproofResolutionThresholdSpendPathV3;
+    type Witness = CounterproofResolutionThresholdWitnessV3;
+
+    fn network(&self) -> Network {
+        self.network
+    }
+
+    fn internal_key(&self) -> XOnlyPublicKey {
+        self.internal_key
+    }
+
+    fn leaf_scripts(&self) -> Vec<ScriptBuf> {
+        vec![self.ack_script(), self.timeout_script()]
+    }
+
+    fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn to_leaf_index(&self, spend_path: Self::SpendPath) -> Option<usize> {
+        Some(match spend_path {
+            CounterproofResolutionThresholdSpendPathV3::Ack => 0,
+            CounterproofResolutionThresholdSpendPathV3::Timeout => 1,
+        })
+    }
+
+    fn sequence(&self, spend_path: Self::SpendPath) -> Sequence {
+        match spend_path {
+            CounterproofResolutionThresholdSpendPathV3::Ack => Sequence::MAX,
+            CounterproofResolutionThresholdSpendPathV3::Timeout => {
+                Sequence::from_height(self.timeout_delay.value())
+            }
+        }
+    }
+
+    fn get_taproot_witness(&self, witness: &Self::Witness) -> TaprootWitness {
+        match &witness.kind {
+            CounterproofResolutionThresholdWitnessKindV3::Ack {
+                graph_signature,
+                ordered_release_signatures,
+            } => TaprootWitness::Script {
+                leaf_index: 0,
+                script_inputs: ordered_release_signatures
+                    .iter()
+                    .rev()
+                    .map(|signature| {
+                        signature
+                            .map(|signature| signature.serialize().to_vec())
+                            .unwrap_or_default()
+                    })
+                    .chain(std::iter::once(graph_signature.serialize().to_vec()))
+                    .collect(),
+            },
+            CounterproofResolutionThresholdWitnessKindV3::Timeout { graph_signature } => {
+                TaprootWitness::Script {
+                    leaf_index: 1,
+                    script_inputs: vec![graph_signature.serialize().to_vec()],
+                }
+            }
+        }
+    }
+}
