+/// Exact atomic threshold-v3 owner payout.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct OwnerPayoutThresholdV3Tx {
+    psbt: Psbt,
+    prevouts: Box<[TxOut]>,
+    funded_setup: Arc<ThresholdV3FundedSetupP1>,
+    deposit_connector: NOfNConnector,
+    claim_payout_connector: ClaimPayoutConnector,
+    contest_payout_connector: ContestPayoutGateV2,
+    contest_slash_connector: ContestSlashGateV2,
+    counterproof_connectors: Box<[ContestCounterproofOutputV2]>,
+    bond_connectors: Box<[CounterproofBondConnectorV3]>,
+}
+
+impl OwnerPayoutThresholdV3Tx {
+    /// Exact common operator/owner output index.
+    pub const OWNER_VOUT: u32 = 0;
+    /// First exact counterproof-return output index.
+    pub const COUNTERPROOF_RETURN_0_VOUT: u32 = 1;
+
+    /// Constructs the atomic all-C/all-B no-counterproof parent.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        data: OwnerPayoutThresholdV3Data,
+        deposit_connector: NOfNConnector,
+        claim_payout_connector: ClaimPayoutConnector,
+        contest_payout_connector: ContestPayoutGateV2,
+        contest_slash_connector: ContestSlashGateV2,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, OwnerPayoutThresholdV3Error> {
+        let policy = data.funded_setup.policy();
+        let alternatives = policy.alternatives();
+        let count = alternatives.len();
+        if count == 0 {
+            return Err(OwnerPayoutThresholdV3Error::EmptyFundedRoster);
+        }
+        if data.funded_setup.counterproof_funding().len() != count
+            || data.funded_setup.bond_funding().len() != count
+        {
+            return Err(OwnerPayoutThresholdV3Error::FundedRosterInvariant {
+                policies: count,
+                counterproof: data.funded_setup.counterproof_funding().len(),
+                bonds: data.funded_setup.bond_funding().len(),
+            });
+        }
+        let owner_destination = alternatives[0].operator_compensation();
+        for (index, alternative) in alternatives.iter().enumerate().skip(1) {
+            if alternative.operator_compensation() != owner_destination {
+                return Err(
+                    OwnerPayoutThresholdV3Error::OperatorCompensationDestinationMismatch {
+                        first_index: 0,
+                        mismatch_index: index,
+                    },
+                );
+            }
+        }
+
+        let network = policy.network();
+        for (component, candidate) in [
+            ("research deposit", deposit_connector.network()),
+            ("claim payout", claim_payout_connector.network()),
+            ("contest payout gate", contest_payout_connector.network()),
+            ("contest Slash gate", contest_slash_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(OwnerPayoutThresholdV3Error::NetworkMismatch { component });
+            }
+        }
+        for (component, candidate) in [
+            (
+                "contest payout gate",
+                contest_payout_connector.graph_pubkey(),
+            ),
+            ("contest Slash gate", contest_slash_connector.graph_pubkey()),
+        ] {
+            if candidate != policy.graph_pubkey() {
+                return Err(OwnerPayoutThresholdV3Error::GraphKeyMismatch { component });
+            }
+        }
+
+        let counterproof_connectors: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| *alternative.counterproof_output())
+            .collect();
+        let mut bond_connectors = Vec::with_capacity(count);
+        for index in 0..count {
+            bond_connectors.push(policy.bond_connector(index).map_err(|source| {
+                OwnerPayoutThresholdV3Error::BondConnector {
+                    index,
+                    source: Box::new(source),
+                }
+            })?);
+        }
+        validate_key_domains(
+            &data.funded_setup,
+            &counterproof_connectors,
+            &bond_connectors,
+            &deposit_connector,
+            &claim_payout_connector,
+            &contest_payout_connector,
+            &contest_slash_connector,
+        )?;
+
+        let mut input_outpoints = vec![
+            data.shared_selection.deposit_outpoint,
+            data.claim_payout_outpoint,
+            data.shared_selection.contest_payout_outpoint,
+            data.contest_slash_outpoint,
+        ];
+        input_outpoints.extend(
+            data.funded_setup
+                .counterproof_funding()
+                .iter()
+                .map(|funding| funding.outpoint()),
+        );
+        input_outpoints.extend(
+            data.funded_setup
+                .bond_funding()
+                .iter()
+                .map(|funding| funding.outpoint()),
+        );
+        validate_input_outpoints(&input_outpoints)?;
+
+        let mut prevouts = vec![
+            deposit_connector.tx_out(),
+            claim_payout_connector.tx_out(),
+            contest_payout_connector.tx_out(),
+            contest_slash_connector.tx_out(),
+        ];
+        prevouts.extend(
+            data.funded_setup
+                .counterproof_funding()
+                .iter()
+                .map(|funding| funding.tx_out().clone()),
+        );
+        prevouts.extend(
+            data.funded_setup
+                .bond_funding()
+                .iter()
+                .map(|funding| funding.tx_out().clone()),
+        );
+        for prevout in &prevouts {
+            ensure_money_range("threshold owner prevout", prevout.value)?;
+            ensure_non_dust("threshold owner prevout", prevout)?;
+        }
+        ensure_money_range("threshold owner fee", fee)?;
+        fee_allowance
+            .validate(TemplateKindV2::OwnerPayout, fee)
+            .map_err(OwnerPayoutThresholdV3Error::FeeAllowance)?;
+
+        let fixed_input = checked_sum(
+            "threshold owner fixed input",
+            prevouts[..4].iter().map(|prevout| prevout.value),
+        )?;
+        let owner_value =
+            fixed_input
+                .checked_sub(fee)
+                .ok_or(OwnerPayoutThresholdV3Error::InsufficientInput {
+                    input: fixed_input,
+                    fee,
+                })?;
+        let owner_output = owner_destination.tx_out(owner_value);
+        ensure_money_range("threshold owner output", owner_output.value)?;
+        ensure_non_dust("threshold owner output", &owner_output)?;
+
+        let counterproof_returns: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| {
+                alternative
+                    .counterproof_return()
+                    .tx_out(alternative.counterproof_output().value())
+            })
+            .collect();
+        let bond_refunds: Vec<_> = alternatives
+            .iter()
+            .map(|alternative| alternative.bond_refund().tx_out(alternative.bond_value()))
+            .collect();
+        for output in counterproof_returns.iter().chain(bond_refunds.iter()) {
+            ensure_money_range("threshold owner return output", output.value)?;
+            ensure_non_dust("threshold owner return output", output)?;
+        }
+
+        let total_input = checked_sum(
+            "threshold owner total input",
+            prevouts.iter().map(|prevout| prevout.value),
+        )?;
+        let total_output = checked_sum(
+            "threshold owner total output",
+            std::iter::once(owner_output.value)
+                .chain(counterproof_returns.iter().map(|output| output.value))
+                .chain(bond_refunds.iter().map(|output| output.value)),
+        )?;
+        let output_and_fee = total_output
+            .checked_add(fee)
+            .ok_or(OwnerPayoutThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("threshold owner output plus fee", output_and_fee)?;
+        if total_input != output_and_fee {
+            return Err(OwnerPayoutThresholdV3Error::TotalValueNotConserved {
+                input: total_input,
+                output: total_output,
+                fee,
+            });
+        }
+
+        let mut input = vec![
+            TxIn {
+                previous_output: data.shared_selection.deposit_outpoint,
+                sequence: deposit_connector.sequence(NOfNSpend),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.claim_payout_outpoint,
+                sequence: claim_payout_connector.sequence(ClaimPayoutSpendPath::Payout),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.shared_selection.contest_payout_outpoint,
+                sequence: contest_payout_connector
+                    .sequence(ContestPayoutGateSpendPathV2::OwnerPayout),
+                ..Default::default()
+            },
+            TxIn {
+                previous_output: data.contest_slash_outpoint,
+                sequence: contest_slash_connector.sequence(ContestSlashGateSpendPathV2::Settlement),
+                ..Default::default()
+            },
+        ];
+        input.extend(
+            counterproof_connectors
+                .iter()
+                .enumerate()
+                .map(|(index, connector)| TxIn {
+                    previous_output: data.funded_setup.counterproof_funding()[index].outpoint(),
+                    sequence: connector.sequence(ContestCounterproofSpendV2::ReserveRecovery),
+                    ..Default::default()
+                }),
+        );
+        input.extend(
+            bond_connectors
+                .iter()
+                .enumerate()
+                .map(|(index, connector)| TxIn {
+                    previous_output: data.funded_setup.bond_funding()[index].outpoint(),
+                    sequence: connector.sequence(CounterproofBondSpendV3),
+                    ..Default::default()
+                }),
+        );
+        let mut output = vec![owner_output];
+        output.extend(counterproof_returns);
+        output.extend(bond_refunds);
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input,
+            output,
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(OwnerPayoutThresholdV3Error::Psbt)?;
+        for (input, prevout) in psbt.inputs.iter_mut().zip(prevouts.iter().cloned()) {
+            input.witness_utxo = Some(prevout);
+        }
+
+        Ok(Self {
+            psbt,
+            prevouts: prevouts.into_boxed_slice(),
+            funded_setup: data.funded_setup,
+            deposit_connector,
+            claim_payout_connector,
+            contest_payout_connector,
+            contest_slash_connector,
+            counterproof_connectors: counterproof_connectors.into_boxed_slice(),
+            bond_connectors: bond_connectors.into_boxed_slice(),
+        })
+    }
+
+    /// This research transaction never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Returns the exact P1 used to derive every C/B input and return.
+    pub const fn funded_setup(&self) -> &Arc<ThresholdV3FundedSetupP1> {
+        &self.funded_setup
+    }
+
+    /// Returns dynamic signing information in exact input-role order.
+    pub fn signing_info(&self) -> OwnerPayoutThresholdV3SigningInfo {
+        let mut cache = SighashCache::new(&self.psbt.unsigned_tx);
+        let count = self.counterproof_connectors.len();
+        let counterproof_reserves = self
+            .counterproof_connectors
+            .iter()
+            .enumerate()
+            .map(|(index, connector)| {
+                connector.get_signing_info(
+                    &mut cache,
+                    Prevouts::All(&self.prevouts),
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    4 + index,
+                )
+            })
+            .collect();
+        let bonds = self
+            .bond_connectors
+            .iter()
+            .enumerate()
+            .map(|(index, connector)| {
+                connector.get_signing_info(
+                    &mut cache,
+                    Prevouts::All(&self.prevouts),
+                    CounterproofBondSpendV3,
+                    4 + count + index,
+                )
+            })
+            .collect();
+        OwnerPayoutThresholdV3SigningInfo {
+            deposit: self.deposit_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                NOfNSpend,
+                0,
+            ),
+            claim_payout: self.claim_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ClaimPayoutSpendPath::Payout,
+                1,
+            ),
+            contest_payout: self.contest_payout_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestPayoutGateSpendPathV2::OwnerPayout,
+                2,
+            ),
+            contest_slash: self.contest_slash_connector.get_signing_info(
+                &mut cache,
+                Prevouts::All(&self.prevouts),
+                ContestSlashGateSpendPathV2::Settlement,
+                3,
+            ),
+            counterproof_reserves,
+            bonds,
+        }
+    }
+
+    /// Returns the output position for exact `C_i` recovery.
+    pub fn counterproof_return_vout(
+        &self,
+        alternative: usize,
+    ) -> Result<u32, OwnerPayoutThresholdV3Error> {
+        if alternative >= self.counterproof_connectors.len() {
+            return Err(OwnerPayoutThresholdV3Error::ReturnIndexOutOfRange {
+                alternative,
+                count: self.counterproof_connectors.len(),
+            });
+        }
+        Self::COUNTERPROOF_RETURN_0_VOUT
+            .checked_add(
+                u32::try_from(alternative)
+                    .map_err(|_| OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })?,
+            )
+            .ok_or(OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })
+    }
+
+    /// Returns the output position for exact `B_i` refund.
+    pub fn bond_refund_vout(&self, alternative: usize) -> Result<u32, OwnerPayoutThresholdV3Error> {
+        if alternative >= self.bond_connectors.len() {
+            return Err(OwnerPayoutThresholdV3Error::ReturnIndexOutOfRange {
+                alternative,
+                count: self.bond_connectors.len(),
+            });
+        }
+        let base = Self::COUNTERPROOF_RETURN_0_VOUT
+            .checked_add(
+                u32::try_from(self.counterproof_connectors.len())
+                    .map_err(|_| OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })?,
+            )
+            .ok_or(OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })?;
+        base.checked_add(
+            u32::try_from(alternative)
+                .map_err(|_| OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })?,
+        )
+        .ok_or(OwnerPayoutThresholdV3Error::ReturnVoutOverflow { alternative })
+    }
+
+    /// Verifies every Schnorr signature before installing any witness.
+    pub fn finalize(
+        self,
+        signatures: OwnerPayoutThresholdV3Signatures,
+    ) -> Result<Transaction, OwnerPayoutThresholdV3Error> {
+        let count = self.counterproof_connectors.len();
+        validate_signature_count(
+            "counterproof graph",
+            count,
+            signatures.counterproof_reserves.len(),
+        )?;
+        validate_signature_count("bond graph", count, signatures.bonds.len())?;
+        let signing_info = self.signing_info();
+        let graph_pubkey = self.funded_setup.policy().graph_pubkey();
+        verify_signature(
+            signatures.deposit,
+            signing_info.deposit.sighash,
+            self.deposit_connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+            OwnerPayoutThresholdV3SignatureRole::Deposit,
+        )?;
+        verify_signature(
+            signatures.claim_payout,
+            signing_info.claim_payout.sighash,
+            self.claim_payout_connector
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+            OwnerPayoutThresholdV3SignatureRole::ClaimPayout,
+        )?;
+        verify_signature(
+            signatures.contest_payout,
+            signing_info.contest_payout.sighash,
+            graph_pubkey,
+            OwnerPayoutThresholdV3SignatureRole::ContestPayout,
+        )?;
+        verify_signature(
+            signatures.contest_slash,
+            signing_info.contest_slash.sighash,
+            graph_pubkey,
+            OwnerPayoutThresholdV3SignatureRole::ContestSlash,
+        )?;
+        for (index, (signature, info)) in signatures
+            .counterproof_reserves
+            .iter()
+            .zip(&signing_info.counterproof_reserves)
+            .enumerate()
+        {
+            verify_signature(
+                *signature,
+                info.sighash,
+                graph_pubkey,
+                OwnerPayoutThresholdV3SignatureRole::CounterproofGraph { alternative: index },
+            )?;
+        }
+        for (index, (signature, info)) in
+            signatures.bonds.iter().zip(&signing_info.bonds).enumerate()
+        {
+            verify_signature(
+                *signature,
+                info.sighash,
+                graph_pubkey,
+                OwnerPayoutThresholdV3SignatureRole::BondGraph { alternative: index },
+            )?;
+        }
+
+        let mut psbt = self.psbt;
+        self.deposit_connector
+            .finalize_input(&mut psbt.inputs[0], &signatures.deposit);
+        self.claim_payout_connector.finalize_input(
+            &mut psbt.inputs[1],
+            &ClaimPayoutWitness::Payout {
+                output_key_signature: signatures.claim_payout,
+            },
+        );
+        self.contest_payout_connector.finalize_input(
+            &mut psbt.inputs[2],
+            &ContestPayoutGateWitnessV2::OwnerPayout {
+                graph_signature: signatures.contest_payout,
+            },
+        );
+        self.contest_slash_connector.finalize_input(
+            &mut psbt.inputs[3],
+            &ContestSlashGateWitnessV2::Settlement {
+                graph_signature: signatures.contest_slash,
+            },
+        );
+        for (index, connector) in self.counterproof_connectors.iter().enumerate() {
+            let witness =
+                connector.reserve_recovery_witness(signatures.counterproof_reserves[index]);
+            connector
+                .try_finalize_input(
+                    &mut psbt.inputs[4 + index],
+                    ContestCounterproofSpendV2::ReserveRecovery,
+                    &witness,
+                )
+                .map_err(OwnerPayoutThresholdV3Error::ContestWitness)?;
+        }
+        for (index, connector) in self.bond_connectors.iter().enumerate() {
+            connector.finalize_input(
+                &mut psbt.inputs[4 + count + index],
+                &CounterproofBondConnectorV3::witness(signatures.bonds[index]),
+            );
+        }
+        Ok(psbt.extract_tx_unchecked_fee_rate())
+    }
+}
+
+fn validate_input_outpoints(outpoints: &[OutPoint]) -> Result<(), OwnerPayoutThresholdV3Error> {
+    for (index, outpoint) in outpoints.iter().enumerate() {
+        if *outpoint == OutPoint::null() {
+            return Err(OwnerPayoutThresholdV3Error::NullInputOutpoint { index });
+        }
+        if let Some(first_index) = outpoints[..index]
+            .iter()
+            .position(|earlier| earlier == outpoint)
+        {
+            return Err(OwnerPayoutThresholdV3Error::DuplicateInputOutpoint {
+                first_index,
+                duplicate_index: index,
+            });
+        }
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn validate_key_domains(
+    setup: &ThresholdV3FundedSetupP1,
+    counterproofs: &[ContestCounterproofOutputV2],
+    bonds: &[CounterproofBondConnectorV3],
+    deposit: &NOfNConnector,
+    claim: &ClaimPayoutConnector,
+    payout: &ContestPayoutGateV2,
+    slash: &ContestSlashGateV2,
+) -> Result<(), OwnerPayoutThresholdV3Error> {
+    let policy = setup.policy();
+    let mut committed = vec![(
+        OwnerPayoutThresholdV3KeyDomain::Graph,
+        policy.graph_pubkey(),
+    )];
+    for (participant, identity) in policy.registry().participants().iter().enumerate() {
+        committed.push((
+            OwnerPayoutThresholdV3KeyDomain::RegistryIdentity { participant },
+            identity.identity_pubkey(),
+        ));
+        committed.extend(identity.release_pubkeys().iter().copied().enumerate().map(
+            |(alternative, key)| {
+                (
+                    OwnerPayoutThresholdV3KeyDomain::Release {
+                        participant,
+                        alternative,
+                    },
+                    key,
+                )
+            },
+        ));
+    }
+    for (alternative, (counterproof, bond)) in counterproofs.iter().zip(bonds).enumerate() {
+        let static_policy = &policy.alternatives()[alternative];
+        committed.extend([
+            (
+                OwnerPayoutThresholdV3KeyDomain::CounterproofOperator { alternative },
+                counterproof.operator_pubkey(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::CounterproofNumsInternal { alternative },
+                counterproof.internal_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::CounterproofNumsOutput { alternative },
+                counterproof
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::BondNumsInternal { alternative },
+                bond.internal_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::BondNumsOutput { alternative },
+                bond.spend_info().output_key().to_x_only_public_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::CounterproofReturn { alternative },
+                static_policy.counterproof_return().output_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::BondRefund { alternative },
+                static_policy.bond_refund().output_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::OperatorCompensation { alternative },
+                static_policy.operator_compensation().output_key(),
+            ),
+            (
+                OwnerPayoutThresholdV3KeyDomain::TimeoutRecovery { alternative },
+                static_policy.recovery().output_key(),
+            ),
+        ]);
+    }
+    let dynamic = [
+        (
+            OwnerPayoutThresholdV3KeyDomain::DepositInternal,
+            deposit.internal_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::DepositOutput,
+            deposit.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ClaimPayoutInternal,
+            claim.internal_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ClaimPayoutOutput,
+            claim.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ContestPayoutNumsInternal,
+            payout.internal_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ContestPayoutNumsOutput,
+            payout.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ContestSlashNumsInternal,
+            slash.internal_key(),
+        ),
+        (
+            OwnerPayoutThresholdV3KeyDomain::ContestSlashNumsOutput,
+            slash.spend_info().output_key().to_x_only_public_key(),
+        ),
+    ];
+    for (second, key) in dynamic {
+        if let Some((first, _)) = committed.iter().find(|(_, earlier)| *earlier == key) {
+            return Err(OwnerPayoutThresholdV3Error::KeyDomainAlias {
+                first: *first,
+                second,
+            });
+        }
+        committed.push((second, key));
+    }
+    for (admin, key) in claim.admin_pubkeys().iter().copied().enumerate() {
+        let second = OwnerPayoutThresholdV3KeyDomain::ClaimPayoutAdmin { admin };
+        if let Some((first, _)) = committed.iter().find(|(_, earlier)| *earlier == key) {
+            return Err(OwnerPayoutThresholdV3Error::KeyDomainAlias {
+                first: *first,
+                second,
+            });
+        }
+        committed.push((second, key));
+    }
+    Ok(())
+}
+
+fn checked_sum(
+    field: &'static str,
+    values: impl IntoIterator<Item = Amount>,
+) -> Result<Amount, OwnerPayoutThresholdV3Error> {
+    let mut total = Amount::ZERO;
+    for value in values {
+        ensure_money_range(field, value)?;
+        total = total
+            .checked_add(value)
+            .ok_or(OwnerPayoutThresholdV3Error::AmountOverflow)?;
+        ensure_money_range(field, total)?;
+    }
+    Ok(total)
+}
+
+fn ensure_money_range(
+    field: &'static str,
+    value: Amount,
+) -> Result<(), OwnerPayoutThresholdV3Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(OwnerPayoutThresholdV3Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(field: &'static str, output: &TxOut) -> Result<(), OwnerPayoutThresholdV3Error> {
+    let minimum = output.script_pubkey.minimal_non_dust();
+    if output.value < minimum {
+        return Err(OwnerPayoutThresholdV3Error::DustValue {
+            field,
+            value: output.value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+const fn validate_signature_count(
+    role: &'static str,
+    expected: usize,
+    actual: usize,
+) -> Result<(), OwnerPayoutThresholdV3Error> {
+    if actual != expected {
+        return Err(OwnerPayoutThresholdV3Error::SignatureCount {
+            role,
+            expected,
+            actual,
+        });
+    }
+    Ok(())
+}
+
+fn verify_signature(
+    signature: schnorr::Signature,
+    sighash: Message,
+    pubkey: XOnlyPublicKey,
+    role: OwnerPayoutThresholdV3SignatureRole,
+) -> Result<(), OwnerPayoutThresholdV3Error> {
+    SECP256K1
+        .verify_schnorr(&signature, &sighash, &pubkey)
+        .map_err(|_| OwnerPayoutThresholdV3Error::InvalidSignature { role })
+}
+
+impl AsRef<Transaction> for OwnerPayoutThresholdV3Tx {
+    fn as_ref(&self) -> &Transaction {
+        &self.psbt.unsigned_tx
+    }
+}
+
+/// Failure to construct or finalize an atomic threshold-v3 owner payout.
+#[derive(Debug)]
+pub enum OwnerPayoutThresholdV3Error {
+    /// Validated P1 unexpectedly has no alternatives.
+    EmptyFundedRoster,
+    /// P1 private roster invariant failed.
+    FundedRosterInvariant {
+        /// Static policy alternative count.
+        policies: usize,
+        /// Exact C funding count.
+        counterproof: usize,
+        /// Exact B funding count.
+        bonds: usize,
+    },
+    /// Alternatives do not commit one exact owner/operator destination.
+    OperatorCompensationDestinationMismatch {
+        /// Canonical comparison alternative.
+        first_index: usize,
+        /// Alternative committing a different destination.
+        mismatch_index: usize,
+    },
+    /// Input uses the null outpoint sentinel.
+    NullInputOutpoint {
+        /// Flattened input position.
+        index: usize,
+    },
+    /// Two flattened transaction inputs alias.
+    DuplicateInputOutpoint {
+        /// Earlier flattened input position.
+        first_index: usize,
+        /// Later flattened input position.
+        duplicate_index: usize,
+    },
+    /// Connector uses another network.
+    NetworkMismatch {
+        /// Connector whose network differs.
+        component: &'static str,
+    },
+    /// Graph-authorized connector uses another graph key.
+    GraphKeyMismatch {
+        /// Connector whose graph key differs.
+        component: &'static str,
+    },
+    /// Protected key/control domains alias.
+    KeyDomainAlias {
+        /// Previously committed domain.
+        first: OwnerPayoutThresholdV3KeyDomain,
+        /// Newly checked aliased domain.
+        second: OwnerPayoutThresholdV3KeyDomain,
+    },
+    /// Checked amount arithmetic overflowed.
+    AmountOverflow,
+    /// Amount or aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Named amount role.
+        field: &'static str,
+        /// Rejected amount or aggregate.
+        value: Amount,
+    },
+    /// Spendable prevout or output is below its script dust floor.
+    DustValue {
+        /// Named output role.
+        field: &'static str,
+        /// Rejected value.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// Exact fee is not admitted by the research allowance.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// Fee exceeds `D+Q+P+S`.
+    InsufficientInput {
+        /// Exact `D+Q+P+S` value.
+        input: Amount,
+        /// Exact requested fee.
+        fee: Amount,
+    },
+    /// Full atomic transaction does not conserve value.
+    TotalValueNotConserved {
+        /// Sum of every transaction input.
+        input: Amount,
+        /// Sum of every transaction output.
+        output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// Dynamic signature vector length differs from P1.
+    SignatureCount {
+        /// Named signature-vector role.
+        role: &'static str,
+        /// Canonical roster count.
+        expected: usize,
+        /// Supplied signature count.
+        actual: usize,
+    },
+    /// Schnorr signature is invalid for its exact input.
+    InvalidSignature {
+        /// Exact input role rejected by BIP340 verification.
+        role: OwnerPayoutThresholdV3SignatureRole,
+    },
+    /// Return lookup exceeded the funded roster.
+    ReturnIndexOutOfRange {
+        /// Rejected alternative position.
+        alternative: usize,
+        /// Exact roster count.
+        count: usize,
+    },
+    /// Dynamic return vout could not be represented.
+    ReturnVoutOverflow {
+        /// Alternative whose vout could not be represented.
+        alternative: usize,
+    },
+    /// Exact bond connector derivation failed.
+    BondConnector {
+        /// Alternative whose connector failed derivation.
+        index: usize,
+        /// Exact P0 policy error.
+        source: Box<ThresholdV3BondPolicyError>,
+    },
+    /// C reserve witness construction failed.
+    ContestWitness(ContestCounterproofV2Error),
+    /// Unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for OwnerPayoutThresholdV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyFundedRoster => f.write_str("threshold owner P1 roster is empty"),
+            Self::FundedRosterInvariant {
+                policies,
+                counterproof,
+                bonds,
+            } => write!(
+                f,
+                "threshold P1 invariant failed: policies={policies}, C={counterproof}, B={bonds}"
+            ),
+            Self::OperatorCompensationDestinationMismatch {
+                first_index,
+                mismatch_index,
+            } => write!(
+                f,
+                "threshold owner requires one committed operator destination; alternative {mismatch_index} differs from {first_index}"
+            ),
+            Self::NullInputOutpoint { index } => {
+                write!(f, "threshold owner input {index} is the null outpoint")
+            }
+            Self::DuplicateInputOutpoint {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold owner input {duplicate_index} duplicates input {first_index}"
+            ),
+            Self::NetworkMismatch { component } => {
+                write!(f, "{component} network differs from threshold P1")
+            }
+            Self::GraphKeyMismatch { component } => {
+                write!(f, "{component} graph key differs from threshold P1")
+            }
+            Self::KeyDomainAlias { first, second } => write!(
+                f,
+                "threshold owner key domains {first:?} and {second:?} alias"
+            ),
+            Self::AmountOverflow => f.write_str("threshold owner amount overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustValue {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below dust floor {minimum}"),
+            Self::FeeAllowance(error) => write!(f, "threshold owner fee rejected: {error}"),
+            Self::InsufficientInput { input, fee } => {
+                write!(f, "threshold owner fixed input {input} is below fee {fee}")
+            }
+            Self::TotalValueNotConserved { input, output, fee } => write!(
+                f,
+                "threshold owner total is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::SignatureCount {
+                role,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "threshold owner requires {expected} {role} signatures, got {actual}"
+            ),
+            Self::InvalidSignature { role } => {
+                write!(f, "threshold owner signature for {role:?} is invalid")
+            }
+            Self::ReturnIndexOutOfRange { alternative, count } => write!(
+                f,
+                "threshold owner return alternative {alternative} is outside roster {count}"
+            ),
+            Self::ReturnVoutOverflow { alternative } => write!(
+                f,
+                "threshold owner return vout for alternative {alternative} overflowed"
+            ),
+            Self::BondConnector { index, source } => {
+                write!(f, "threshold bond {index} derivation failed: {source}")
+            }
+            Self::ContestWitness(error) => write!(f, "threshold C witness was rejected: {error}"),
+            Self::Psbt(error) => write!(f, "threshold owner PSBT failed: {error}"),
+        }
+    }
+}
+
+impl Error for OwnerPayoutThresholdV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::BondConnector { source, .. } => Some(source.as_ref()),
+            Self::ContestWitness(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
