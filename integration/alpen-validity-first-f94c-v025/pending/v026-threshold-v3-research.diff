+    #[test]
+    fn core_accepts_each_two_of_three_finalized_transaction_and_rejects_malformed_witness() {
+        let mut node = BitcoinNode::new();
+        let fixture = Fixture::new();
+        let outpoints = fund_resolution_outputs(&mut node, &fixture.resolution, 4);
+        let mut measured_weight = None;
+
+        for (case, missing) in [0usize, 1, 2].into_iter().enumerate() {
+            let ack = fixture.ack(outpoints[case]);
+            let (graph_signature, signatures) = fixture.signatures(&ack);
+            let candidates = signatures
+                .into_iter()
+                .filter(|signature| signature.participant_index() != missing)
+                .collect();
+            let finalized = ack.finalize(candidates, graph_signature).unwrap();
+            measured_weight = Some(finalized.transaction().weight().to_wu());
+            node.client()
+                .send_raw_transaction(finalized.transaction())
+                .unwrap();
+        }
+
+        let ack = fixture.ack(outpoints[3]);
+        let (graph_signature, signatures) = fixture.signatures(&ack);
+        let finalized = ack
+            .finalize(vec![signatures[0], signatures[1]], graph_signature)
+            .unwrap();
+        let mut malformed = finalized.transaction().clone();
+        let mut witness = malformed.input[0].witness.to_vec();
+        witness[1].pop();
+        malformed.input[0].witness = Witness::from_slice(&witness);
+        assert!(node.client().send_raw_transaction(&malformed).is_err());
+        assert_eq!(measured_weight, Some(1_158));
+    }
