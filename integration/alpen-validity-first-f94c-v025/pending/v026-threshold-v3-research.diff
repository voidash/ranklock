+    fn keypair(seed: u8) -> Keypair {
+        let mut bytes = [0_u8; 32];
+        bytes[31] = seed;
+        let secret = SecretKey::from_slice(&bytes).expect("nonzero fixture secret");
+        Keypair::from_secret_key(secp256k1::SECP256K1, &secret)
