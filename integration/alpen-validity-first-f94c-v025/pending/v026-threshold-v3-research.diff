+        ThresholdReleaseFaultProfileV3::new(3, 2, 1).expect("valid threshold profile")
+    }
+
+    fn registry() -> Arc<ThresholdV3KeyRegistry> {
+        let profile = fault_profile();
+        let participants = (0..3)
+            .map(|participant_index| {
+                let identity = keypair(10 + participant_index as u32);
+                let identity_pubkey = identity.x_only_public_key().0;
+                let control_domain_digest = [(20 + participant_index) as u8; 32];
+                let release_pubkeys: Vec<_> = (0..2)
+                    .map(|alternative| key(100 + (participant_index * 2 + alternative) as u32))
+                    .collect();
+                let digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                    SETUP_DIGEST,
+                    profile,
+                    2,
+                    participant_index,
+                    identity_pubkey,
+                    control_domain_digest,
+                    &release_pubkeys,
+                )
+                .expect("participant contribution digest");
+                ThresholdV3ParticipantIdentity::new(
+                    SETUP_DIGEST,
+                    profile,
+                    2,
+                    participant_index,
+                    identity_pubkey,
+                    control_domain_digest,
+                    release_pubkeys,
+                    identity.sign_schnorr(Message::from_digest(digest)),
+                )
+                .expect("signed participant")
+            })
+            .collect();
+        Arc::new(
+            ThresholdV3KeyRegistry::new(SETUP_DIGEST, profile, 2, participants)
+                .expect("valid registry"),
+        )
+    }
+
+    fn destination(
+        key_number: u32,
+        principal: u8,
+        authority: u8,
+    ) -> ThresholdV3ControlledP2trDestination {
+        ThresholdV3ControlledP2trDestination::new(key(key_number), [principal; 32], [authority; 32])
+            .expect("valid destination")
+    }
+
+    fn counterproof(
+        graph_pubkey: XOnlyPublicKey,
+        operator_pubkey: XOnlyPublicKey,
+        index: u32,
+        surcharge: Amount,
+    ) -> ContestCounterproofOutputV2 {
+        ContestCounterproofOutputV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            operator_pubkey,
+            3,
+            surcharge,
+            ResearchV0NumsContext::new(
+                SETUP_DIGEST,
+                ResearchV0NumsRole::ContestCounterproof,
+                index,
+            ),
+        )
+        .expect("valid C connector")
+    }
+
+    fn alternative(graph_pubkey: XOnlyPublicKey, index: usize) -> ThresholdV3BondAlternativePolicy {
+        let key_base = 300 + index as u32 * 10;
+        ThresholdV3BondAlternativePolicy::new(
+            counterproof(
+                graph_pubkey,
+                key(200 + index as u32),
+                index as u32,
+                Amount::from_sat(10_000),
+            ),
+            destination(key_base, 40 + index as u8, 50 + index as u8),
+            BOND_VALUE,
+            destination(key_base + 1, 40 + index as u8, 50 + index as u8),
+            destination(key_base + 2, 60 + index as u8, 70 + index as u8),
+            destination(key_base + 3, 80 + index as u8, 90 + index as u8),
+            BASE_RESOLUTION_VALUE,
+            relative::Height::from_height(8),
+        )
+        .expect("valid alternative")
+    }
+
+    fn policy(graph_pubkey: XOnlyPublicKey) -> Arc<ThresholdV3BondPolicyP0> {
+        ThresholdV3BondPolicyP0::new(
+            Network::Regtest,
+            graph_pubkey,
+            registry(),
+            vec![alternative(graph_pubkey, 0), alternative(graph_pubkey, 1)],
+        )
+        .expect("valid bond policy")
+    }
+
+    fn funding_output(seed: u8, vout: u32, tx_out: TxOut) -> ThresholdV3FundingOutput {
+        ThresholdV3FundingOutput::new(
+            OutPoint::new(Txid::from_byte_array([seed; 32]), vout),
+            tx_out,
+        )
+        .expect("valid funding output")
+    }
+
+    fn funded_setup(policy: Arc<ThresholdV3BondPolicyP0>) -> Arc<ThresholdV3FundedSetupP1> {
+        let counterproof_funding = policy
+            .alternatives()
+            .iter()
+            .enumerate()
+            .map(|(index, alternative)| {
+                funding_output(1, index as u32, alternative.counterproof_output().tx_out())
+            })
+            .collect();
+        let bond_funding = (0..policy.alternatives().len())
+            .map(|index| {
+                funding_output(
+                    2,
+                    index as u32,
+                    policy
+                        .bond_connector(index)
+                        .expect("bond connector")
+                        .tx_out(),
+                )
+            })
+            .collect();
+        ThresholdV3FundedSetupP1::new(policy, counterproof_funding, bond_funding)
+            .expect("valid funded setup")
+    }
