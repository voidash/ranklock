+impl PersistedFundingBlockedObservationV3 {
+    /// Constructs an inert read model after strict shape validation.
+    pub fn try_from_parts(
+        manifest: V026ThresholdObservationManifestV3,
+        blockers: [V026BlockerCodeV3; V026_BLOCKER_COUNT_V3],
+    ) -> Result<Self, V026PersistedObservationErrorV3> {
+        if blockers != V026_BLOCKERS_V3 {
+            return Err(V026PersistedObservationErrorV3::BlockerSetMismatch);
+        }
+        validate_manifest(&manifest)?;
+        Ok(Self { manifest, blockers })
+    }
+
+    /// Content-addressed funded-P1 identity.
+    pub const fn funded_setup_digest(&self) -> [u8; 32] {
+        self.manifest.funded_setup_digest
+    }
+
+    /// Exact validated manifest.
+    pub const fn manifest(&self) -> &V026ThresholdObservationManifestV3 {
+        &self.manifest
+    }
+
+    /// Exact blocker array.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV3; V026_BLOCKER_COUNT_V3] {
+        &self.blockers
+    }
+
+    /// Persisted observations remain funding-ineligible.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
