+/// Key domain checked for exact local separation.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ThresholdTimeoutKeyDomainV3 {
+    /// Shared exact-parent graph key.
+    Graph,
+    /// Ordered participant release key.
+    Release {
+        /// Setup-committed participant index.
+        index: usize,
+    },
+    /// Resolution NUMS internal key.
+    ResolutionNumsInternal,
+    /// Resolution Taproot output key.
+    ResolutionNumsOutput,
+    /// Slash-gate NUMS internal key.
+    SlashNumsInternal,
+    /// Slash-gate Taproot output key.
+    SlashNumsOutput,
+    /// Operator compensation controller.
+    OperatorCompensation,
+    /// Timeout-anchor internal key.
+    CpfpInternal,
+    /// Timeout-anchor output key.
+    CpfpOutput,
+    /// Recovery-change controller.
+    Recovery,
+}
+
+/// Failure to construct or finalize a threshold timeout settlement.
+#[derive(Debug)]
+pub enum CounterproofTimeoutSettlementThresholdV3Error {
+    /// Both inputs name the same outpoint.
+    DuplicateInputOutpoint,
+    /// Caller data and connector alternative identities differ.
+    AlternativeMismatch {
+        /// Alternative supplied with the input outpoint.
+        data: ThresholdAckAlternativeV3,
+        /// Alternative bound by the resolution connector.
+        connector: ThresholdAckAlternativeV3,
+    },
+    /// Connector networks differ.
+    NetworkMismatch {
+        /// Mismatching connector.
+        connector: &'static str,
+    },
+    /// Resolution and Slash gate use different graph keys.
+    GraphKeyMismatch,
+    /// Recovery must use a P2TR descriptor.
+    InvalidRecoveryDescriptorType {
+        /// Rejected descriptor type.
+        actual: DescriptorType,
+    },
+    /// Recovery descriptor payload is not an x-only key.
+    InvalidRecoveryDescriptorPayload,
+    /// Two controller, authorization, or NUMS domains alias.
+    KeyDomainAlias {
+        /// Earlier domain.
+        first: ThresholdTimeoutKeyDomainV3,
+        /// Later aliased domain.
+        second: ThresholdTimeoutKeyDomainV3,
+    },
+    /// A controlled key aliases a known v2/v3 NUMS key.
+    NumsControlKeyAlias {
+        /// Caller-controlled output role.
+        controlled_component: &'static str,
+        /// NUMS connector role.
+        nums_component: &'static str,
+        /// Internal or output NUMS key.
+        key_kind: NumsKeyKindV2,
+    },
+    /// An output script aliases an input script.
+    InputOutputScriptAlias {
+        /// Aliased input index.
+        input_index: usize,
+        /// Aliasing output index.
+        output_index: usize,
+    },
+    /// Two outputs have the same script.
+    OutputScriptCollision {
+        /// Later colliding output index.
+        output_index: usize,
+    },
+    /// Checked amount arithmetic overflowed.
+    AmountOverflow,
+    /// A value exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Offending value role.
+        field: &'static str,
+        /// Rejected value.
+        value: Amount,
+    },
+    /// A required output is dust.
+    DustOutput {
+        /// Offending output role.
+        field: &'static str,
+        /// Rejected value.
+        value: Amount,
+        /// Required minimum.
+        minimum: Amount,
+    },
+    /// Inputs cannot fund fixed outputs and fee.
+    InsufficientInput {
+        /// Total input value.
+        input: Amount,
+        /// Required fixed outputs.
+        fixed_output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// Exact value conservation failed.
+    ValueNotConserved {
+        /// Total input value.
+        input: Amount,
+        /// Total output value.
+        output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// Fee is unbound or above its local ceiling.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// One exact-parent graph signature is invalid.
+    InvalidGraphSignature {
+        /// Failing transaction input index.
+        input_index: usize,
+    },
+    /// PSBT construction failed.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofTimeoutSettlementThresholdV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::DuplicateInputOutpoint => f.write_str("threshold timeout inputs must differ"),
+            Self::AlternativeMismatch { data, connector } => write!(
+                f,
+                "threshold timeout data names alternative {} but connector names {}",
+                data.index(),
+                connector.index()
+            ),
+            Self::NetworkMismatch { connector } => {
+                write!(f, "{connector} network does not match threshold resolution")
+            }
+            Self::GraphKeyMismatch => {
+                f.write_str("threshold resolution and contest Slash graph keys differ")
+            }
+            Self::InvalidRecoveryDescriptorType { actual } => {
+                write!(f, "threshold timeout recovery must be P2TR, got {actual}")
+            }
+            Self::InvalidRecoveryDescriptorPayload => {
+                f.write_str("threshold timeout recovery payload is not an x-only key")
+            }
+            Self::KeyDomainAlias { first, second } => {
+                write!(
+                    f,
+                    "threshold timeout key domains {first:?} and {second:?} alias"
+                )
+            }
+            Self::NumsControlKeyAlias {
+                controlled_component,
+                nums_component,
+                key_kind,
+            } => write!(
+                f,
+                "{controlled_component} aliases {key_kind:?} key of {nums_component}"
+            ),
+            Self::InputOutputScriptAlias {
+                input_index,
+                output_index,
+            } => write!(
+                f,
+                "threshold timeout output {output_index} aliases input script {input_index}"
+            ),
+            Self::OutputScriptCollision { output_index } => {
+                write!(
+                    f,
+                    "threshold timeout output {output_index} duplicates an earlier script"
+                )
+            }
+            Self::AmountOverflow => f.write_str("threshold timeout amount arithmetic overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustOutput {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below its dust floor {minimum}"),
+            Self::InsufficientInput {
+                input,
+                fixed_output,
+                fee,
+            } => write!(
+                f,
+                "threshold timeout input {input} cannot fund fixed output {fixed_output} and fee {fee}"
+            ),
+            Self::ValueNotConserved { input, output, fee } => write!(
+                f,
+                "threshold timeout value is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::FeeAllowance(error) => write!(f, "invalid threshold timeout fee: {error}"),
+            Self::InvalidGraphSignature { input_index } => {
+                write!(
+                    f,
+                    "threshold timeout graph signature {input_index} is invalid"
+                )
+            }
+            Self::Psbt(error) => write!(f, "failed to construct threshold timeout PSBT: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofTimeoutSettlementThresholdV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
