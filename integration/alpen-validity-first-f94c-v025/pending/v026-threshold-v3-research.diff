+//! Atomic no-counterproof owner parent for the threshold-v3 research profile.
+//!
+//! The exact topology is
+//! `[D,Q,P,S,C_0..C_n-1,B_0..B_n-1] ->
+//!  [O,C_return_0..C_return_n-1,B_refund_0..B_refund_n-1]`.
+//! Every roster input and return is derived from one validated funded P1. The
+//! owner controller is not caller-supplied: every alternative must commit the
+//! same operator-compensation destination, which controls `O`.
+//!
+//! This research type is unconditionally funding-ineligible. External
+//! predecessor provenance, possession and control-domain evidence for `Q`'s
+//! unstaking preimage, exact presigning/key erasure, and a frozen v3 fee and
+//! relay profile remain activation blockers.
+
+use std::{error::Error, fmt, sync::Arc};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Transaction, TxIn, TxOut,
+};
