+/// Exact canonical blocker order for threshold-v3 persisted observations.
+pub const V026_BLOCKERS_V3: [V026BlockerCodeV3; V026_BLOCKER_COUNT_V3] = [
+    V026BlockerCodeV3::ResearchNumsProfile,
+    V026BlockerCodeV3::CanonicalWireIdentityUnimplemented,
+    V026BlockerCodeV3::ReleaseCryptographyEvidenceUnverified,
+    V026BlockerCodeV3::ControllerDomainEvidenceUnverified,
+    V026BlockerCodeV3::SlashHeaderProfileIncompatible,
+    V026BlockerCodeV3::ExternalOutputEvidenceUnverified,
+    V026BlockerCodeV3::FreshDepositEvidenceUnverified,
+    V026BlockerCodeV3::StakeExclusivityEvidenceUnverified,
+    V026BlockerCodeV3::PresignErasureEvidenceUnverified,
+    V026BlockerCodeV3::LegacyMaterialExclusionUnverified,
+    V026BlockerCodeV3::FeePolicyEvidenceUnverified,
+    V026BlockerCodeV3::BitcoinCoreExecutionEvidenceUnverified,
+    V026BlockerCodeV3::AsmActivationEvidenceUnverified,
+    V026BlockerCodeV3::RuntimeAdmissionUnimplemented,
+    V026BlockerCodeV3::ValidityWithholdingEconomicsUnresolved,
+    V026BlockerCodeV3::AtomicRosterWeightEvidenceUnverified,
+    V026BlockerCodeV3::ThresholdAckWitnessAdoptionUnimplemented,
+];
