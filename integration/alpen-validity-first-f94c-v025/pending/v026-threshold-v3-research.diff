+fn build_expected_transactions(
+    plan: &V026ThresholdGraphV3Plan,
+    funded_setup: &Arc<ThresholdV3FundedSetupP1>,
+) -> Result<V026ThresholdExpectedTransactionsV3, V026ThresholdGraphV3Error> {
+    let policy = &plan.policy;
+    let multi_anchor = MultiAnchor::new(
+        policy.network(),
+        plan.alternatives
+            .iter()
+            .map(|alternative| alternative.contest_cpfp_pubkey)
+            .collect(),
+        plan.contest.cpfp_anchor_value,
+    );
+    let mut contest_outputs = vec![
+        plan.contest.proof_connector.tx_out(),
+        plan.contest.payout_gate.tx_out(),
+        plan.contest.slash_gate.tx_out(),
+    ];
+    contest_outputs.extend(
+        policy
+            .alternatives()
+            .iter()
+            .map(|alternative| alternative.counterproof_output().tx_out()),
+    );
+    contest_outputs.push(multi_anchor.tx_out());
+    let contest = unsigned_transaction(
+        vec![(
+            plan.claim.outpoint,
+            plan.claim
+                .connector
+                .sequence(ClaimContestSpendPath::Contested {
+                    watchtower_index: 0,
+                }),
+        )],
+        contest_outputs,
+    );
+    verify_declared_fee(
+        "Contest",
+        None,
+        plan.claim.connector.value(),
+        &contest.output,
+        plan.contest.fee,
+    )?;
+    let contest_txid = contest.compute_txid();
+    let payout_outpoint = OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT);
+    let slash_outpoint = OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT);
+
+    let owner_fixed_input = checked_sum(
+        "OwnerPayout",
+        None,
+        [
+            plan.deposit.connector.value(),
+            plan.claim_payout.connector.value(),
+            plan.contest.payout_gate.value(),
+            plan.contest.slash_gate.value(),
+        ],
+    )?;
+    let owner_value = owner_fixed_input.checked_sub(plan.owner_fee).ok_or(
+        V026ThresholdGraphV3Error::ExpectedValueComputation {
+            template: "OwnerPayout",
+            index: None,
+        },
+    )?;
+    let mut owner_inputs = vec![
+        (
+            plan.deposit.outpoint,
+            plan.deposit.connector.sequence(NOfNSpend),
+        ),
+        (
+            plan.claim_payout.outpoint,
+            plan.claim_payout
+                .connector
+                .sequence(ClaimPayoutSpendPath::Payout),
+        ),
+        (
+            payout_outpoint,
+            plan.contest
+                .payout_gate
+                .sequence(ContestPayoutGateSpendPathV2::OwnerPayout),
+        ),
+        (
+            slash_outpoint,
+            plan.contest
+                .slash_gate
+                .sequence(ContestSlashGateSpendPathV2::Settlement),
+        ),
+    ];
+    owner_inputs.extend(
+        funded_setup
+            .counterproof_funding()
+            .iter()
+            .zip(policy.alternatives())
+            .map(|(funding, alternative)| {
+                (
+                    funding.outpoint(),
+                    alternative
+                        .counterproof_output()
+                        .sequence(ContestCounterproofSpendV2::ReserveRecovery),
+                )
+            }),
+    );
+    for (index, funding) in funded_setup.bond_funding().iter().enumerate() {
+        let bond = policy
+            .bond_connector(index)
+            .map_err(V026ThresholdGraphV3Error::Policy)?;
+        owner_inputs.push((funding.outpoint(), bond.sequence(CounterproofBondSpendV3)));
+    }
+    let mut owner_outputs = vec![policy.alternatives()[0]
+        .operator_compensation()
+        .tx_out(owner_value)];
+    owner_outputs.extend(policy.alternatives().iter().map(|alternative| {
+        alternative
+            .counterproof_return()
+            .tx_out(alternative.counterproof_output().value())
+    }));
+    owner_outputs.extend(
+        policy
+            .alternatives()
+            .iter()
+            .map(|alternative| alternative.bond_refund().tx_out(alternative.bond_value())),
+    );
+    let owner_payout = unsigned_transaction(owner_inputs, owner_outputs);
+    let owner_input = funded_setup
+        .counterproof_funding()
+        .iter()
+        .chain(funded_setup.bond_funding())
+        .try_fold(owner_fixed_input, |sum, funding| {
+            sum.checked_add(funding.tx_out().value).ok_or(
+                V026ThresholdGraphV3Error::ExpectedValueComputation {
+                    template: "OwnerPayout",
+                    index: None,
+                },
+            )
+        })?;
+    verify_declared_fee(
+        "OwnerPayout",
+        None,
+        owner_input,
+        &owner_payout.output,
+        plan.owner_fee,
+    )?;
+
+    let mut alternatives = Vec::with_capacity(policy.alternatives().len());
+    for (index, service) in plan.alternatives.iter().enumerate() {
+        let selected = funded_setup
+            .selected(index)
+            .map_err(V026ThresholdGraphV3Error::FundedSetup)?;
+        let mut counterproof_inputs = Vec::with_capacity(policy.alternatives().len() * 2 + 2);
+        counterproof_inputs.extend(
+            funded_setup
+                .counterproof_funding()
+                .iter()
+                .zip(policy.alternatives())
+                .enumerate()
+                .map(|(candidate, (funding, alternative))| {
+                    let path = if candidate == index {
+                        ContestCounterproofSpendV2::Counterproof
+                    } else {
+                        ContestCounterproofSpendV2::ReserveRecovery
+                    };
+                    (
+                        funding.outpoint(),
+                        alternative.counterproof_output().sequence(path),
+                    )
+                }),
+        );
+        for (candidate, funding) in funded_setup.bond_funding().iter().enumerate() {
+            let bond = policy
+                .bond_connector(candidate)
+                .map_err(V026ThresholdGraphV3Error::Policy)?;
+            counterproof_inputs.push((funding.outpoint(), bond.sequence(CounterproofBondSpendV3)));
+        }
+        counterproof_inputs.extend([
+            (
+                payout_outpoint,
+                plan.contest
+                    .payout_gate
+                    .sequence(ContestPayoutGateSpendPathV2::ImmediateSelection),
+            ),
+            (
+                plan.deposit.outpoint,
+                plan.deposit.connector.sequence(NOfNSpend),
+            ),
+        ]);
+        let selected_policy = selected.policy();
+        let resolution = CounterproofResolutionThresholdConnectorV3::from_selected_binding(
+            &selected,
+        )
+        .map_err(|error| V026ThresholdGraphV3Error::ExpectedConstruction {
+            template: "Counterproof",
+            index: Some(index),
+            message: error.to_string(),
+        })?;
+        let mut counterproof_outputs = vec![
+            selected_policy
+                .recovery()
+                .tx_out(plan.deposit.connector.value()),
+            resolution.tx_out(),
+            service.counterproof_cpfp_connector.tx_out(),
+        ];
+        counterproof_outputs.extend(
+            policy
+                .alternatives()
+                .iter()
+                .enumerate()
+                .filter(|(candidate, _)| *candidate != index)
+                .map(|(_, alternative)| {
+                    alternative
+                        .counterproof_return()
+                        .tx_out(alternative.counterproof_output().value())
+                }),
+        );
+        counterproof_outputs.extend(
+            policy
+                .alternatives()
+                .iter()
+                .enumerate()
+                .filter(|(candidate, _)| *candidate != index)
+                .map(|(_, alternative)| alternative.bond_refund().tx_out(alternative.bond_value())),
+        );
+        let counterproof = unsigned_transaction(counterproof_inputs, counterproof_outputs);
+        let counterproof_input = funded_setup
+            .counterproof_funding()
+            .iter()
+            .chain(funded_setup.bond_funding())
+            .try_fold(Amount::ZERO, |sum, funding| {
+                sum.checked_add(funding.tx_out().value).ok_or(
+                    V026ThresholdGraphV3Error::ExpectedValueComputation {
+                        template: "Counterproof",
+                        index: Some(index),
+                    },
+                )
+            })?
+            .checked_add(plan.contest.payout_gate.value())
+            .and_then(|value| value.checked_add(plan.deposit.connector.value()))
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "Counterproof",
+                index: Some(index),
+            })?;
+        verify_declared_fee(
+            "Counterproof",
+            Some(index),
+            counterproof_input,
+            &counterproof.output,
+            service.counterproof_fee,
+        )?;
+        let resolution_outpoint = OutPoint::new(
+            counterproof.compute_txid(),
+            CounterproofThresholdV3Tx::RESOLUTION_VOUT,
+        );
+
+        let l_value = selected_policy
+            .base_resolution_value()
+            .checked_sub(service.resolution_branches.ack_cpfp_connector.value())
+            .and_then(|value| value.checked_sub(service.resolution_branches.ack_fee))
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "ACK",
+                index: Some(index),
+            })?;
+        let slash_authorization = SlashAuthorizationConnectorV2::from_selected_binding(
+            &selected, l_value,
+        )
+        .map_err(|error| V026ThresholdGraphV3Error::ExpectedConstruction {
+            template: "ACK",
+            index: Some(index),
+            message: error.to_string(),
+        })?;
+        let ack = unsigned_transaction(
+            vec![(
+                resolution_outpoint,
+                resolution.sequence(CounterproofResolutionThresholdSpendPathV3::Ack),
+            )],
+            vec![
+                selected_policy
+                    .bond_refund()
+                    .tx_out(selected_policy.bond_value()),
+                slash_authorization.tx_out(),
+                service.resolution_branches.ack_cpfp_connector.tx_out(),
+            ],
+        );
+        verify_declared_fee(
+            "ACK",
+            Some(index),
+            resolution.value(),
+            &ack.output,
+            service.resolution_branches.ack_fee,
+        )?;
+
+        let timeout_input = resolution
+            .value()
+            .checked_add(plan.contest.slash_gate.value())
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "Timeout",
+                index: Some(index),
+            })?;
+        let timeout_fixed = selected_policy
+            .bond_value()
+            .checked_add(service.resolution_branches.timeout_cpfp_connector.value())
+            .and_then(|value| value.checked_add(service.resolution_branches.timeout_fee))
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "Timeout",
+                index: Some(index),
+            })?;
+        let timeout_change = timeout_input.checked_sub(timeout_fixed).ok_or(
+            V026ThresholdGraphV3Error::ExpectedValueComputation {
+                template: "Timeout",
+                index: Some(index),
+            },
+        )?;
+        let mut timeout_outputs = vec![
+            selected_policy
+                .operator_compensation()
+                .tx_out(selected_policy.bond_value()),
+            service.resolution_branches.timeout_cpfp_connector.tx_out(),
+        ];
+        if timeout_change != Amount::ZERO {
+            timeout_outputs.push(selected_policy.recovery().tx_out(timeout_change));
+        }
+        let timeout = unsigned_transaction(
+            vec![
+                (
+                    resolution_outpoint,
+                    resolution.sequence(CounterproofResolutionThresholdSpendPathV3::Timeout),
+                ),
+                (
+                    slash_outpoint,
+                    plan.contest
+                        .slash_gate
+                        .sequence(ContestSlashGateSpendPathV2::Settlement),
+                ),
+            ],
+            timeout_outputs,
+        );
+        verify_declared_fee(
+            "Timeout",
+            Some(index),
+            timeout_input,
+            &timeout.output,
+            service.resolution_branches.timeout_fee,
+        )?;
+
+        let slash_authorization_outpoint = OutPoint::new(
+            ack.compute_txid(),
+            crate::transactions::prelude::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+        );
+        let header = ParseConfig::new(plan.magic_bytes)
+            .encode_script_buf(
+                &SlashTxHeaderAux::new(plan.operator_idx)
+                    .build_tag_data()
+                    .as_ref(),
+            )
+            .map_err(|error| {
+                V026ThresholdGraphV3Error::ExpectedHeaderEncoding(error.to_string())
+            })?;
+        let mut slash_outputs = vec![TxOut {
+            value: Amount::ZERO,
+            script_pubkey: header,
+        }];
+        slash_outputs.extend(service.slash_payouts.iter().map(|payout| TxOut {
+            value: payout.value(),
+            script_pubkey: payout.descriptor().to_script(),
+        }));
+        let slash = unsigned_transaction(
+            vec![
+                (
+                    slash_authorization_outpoint,
+                    slash_authorization.sequence(SlashAuthorizationSpendPathV2),
+                ),
+                (
+                    slash_outpoint,
+                    plan.contest
+                        .slash_gate
+                        .sequence(ContestSlashGateSpendPathV2::Slash),
+                ),
+                (
+                    plan.stake.outpoint,
+                    plan.stake.connector.sequence(NOfNSpend),
+                ),
+            ],
+            slash_outputs,
+        );
+        let slash_input = checked_sum(
+            "Slash",
+            Some(index),
+            [
+                slash_authorization.value(),
+                plan.contest.slash_gate.value(),
+                plan.stake.connector.value(),
+            ],
+        )?;
+        verify_declared_fee(
+            "Slash",
+            Some(index),
+            slash_input,
+            &slash.output,
+            service.slash_fee,
+        )?;
+        alternatives.push(V026ThresholdExpectedAlternativeTransactionsV3 {
+            counterproof,
+            ack,
+            timeout,
+            slash,
+        });
+    }
+
+    Ok(V026ThresholdExpectedTransactionsV3 {
+        contest,
+        owner_payout,
+        alternatives: alternatives.into_boxed_slice(),
+    })
+}
+
+fn verify_contest_outputs(
+    contest: &ContestV2Tx,
+    policy: &ThresholdV3BondPolicyP0,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let tx = contest.as_ref();
+    for (role, index, vout, expected) in [
+        (
+            "proof",
+            None,
+            ContestV2Tx::PROOF_VOUT,
+            contest.proof_connector().tx_out(),
+        ),
+        (
+            "payout",
+            None,
+            ContestV2Tx::PAYOUT_GATE_VOUT,
+            contest.payout_gate().tx_out(),
+        ),
+        (
+            "Slash",
+            None,
+            ContestV2Tx::SLASH_GATE_VOUT,
+            contest.slash_gate().tx_out(),
+        ),
+        (
+            "MultiAnchor",
+            None,
+            contest.cpfp_vout(),
+            contest.cpfp_connector().tx_out(),
+        ),
+    ] {
+        let actual = tx
+            .output
+            .get(vout as usize)
+            .ok_or(V026ThresholdGraphV3Error::ContestOutputMissing { role, index, vout })?;
+        if actual != &expected {
+            return Err(V026ThresholdGraphV3Error::ContestOutputMismatch { role, index });
+        }
+    }
+    for (index, alternative) in policy.alternatives().iter().enumerate() {
+        let vout = contest
+            .counterproof_vout(index)
+            .map_err(V026ThresholdGraphV3Error::Contest)?;
+        let actual = tx.output.get(vout as usize).ok_or(
+            V026ThresholdGraphV3Error::ContestOutputMissing {
+                role: "counterproof",
+                index: Some(index),
+                vout,
+            },
+        )?;
+        if actual != &alternative.counterproof_output().tx_out() {
+            return Err(V026ThresholdGraphV3Error::ContestOutputMismatch {
+                role: "counterproof",
+                index: Some(index),
+            });
+        }
+    }
+    Ok(())
+}
+
+fn checked_sum<const N: usize>(
+    template: &'static str,
+    index: Option<usize>,
+    values: [Amount; N],
+) -> Result<Amount, V026ThresholdGraphV3Error> {
+    values.into_iter().try_fold(Amount::ZERO, |sum, value| {
+        sum.checked_add(value)
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation { template, index })
+    })
+}
+
+fn verify_declared_fee(
+    template: &'static str,
+    index: Option<usize>,
+    input: Amount,
+    outputs: &[TxOut],
+    fee: Amount,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let output = outputs.iter().try_fold(Amount::ZERO, |sum, txout| {
+        sum.checked_add(txout.value)
+            .ok_or(V026ThresholdGraphV3Error::ExpectedValueComputation { template, index })
+    })?;
+    if output.checked_add(fee) != Some(input) {
+        return Err(V026ThresholdGraphV3Error::ExpectedFeeMismatch {
+            template,
+            index,
+            input,
+            output,
+            fee,
+        });
+    }
+    Ok(())
+}
+
+fn unsigned_transaction(inputs: Vec<(OutPoint, Sequence)>, output: Vec<TxOut>) -> Transaction {
+    Transaction {
+        version: Version(3),
+        lock_time: absolute::LockTime::ZERO,
+        input: inputs
+            .into_iter()
+            .map(|(previous_output, sequence)| TxIn {
+                previous_output,
+                sequence,
+                ..Default::default()
+            })
+            .collect(),
+        output,
+    }
+}
+
+fn verify_exact_transaction(
+    template: &'static str,
+    index: Option<usize>,
+    actual: &Transaction,
+    expected: &Transaction,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if actual != expected {
+        return Err(V026ThresholdGraphV3Error::TransactionProjectionMismatch { template, index });
+    }
+    Ok(())
+}
+
+fn verify_common_destinations(
+    policy: &ThresholdV3BondPolicyP0,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let Some(first) = policy.alternatives().first() else {
+        return Err(V026ThresholdGraphV3Error::EmptyPolicyRoster);
+    };
+    for (index, alternative) in policy.alternatives().iter().enumerate().skip(1) {
+        if alternative.operator_compensation() != first.operator_compensation() {
+            return Err(V026ThresholdGraphV3Error::CommonOperatorMismatch { index });
+        }
+        if alternative.recovery() != first.recovery() {
+            return Err(V026ThresholdGraphV3Error::CommonRecoveryMismatch { index });
+        }
+    }
+    Ok(())
+}
+
+fn verify_external_outpoints(
+    plan: &V026ThresholdGraphV3Plan,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let mut roles = vec![
+        (
+            V026ThresholdOutputRoleV3::ClaimContest,
+            "Claim",
+            plan.claim.outpoint,
+        ),
+        (
+            V026ThresholdOutputRoleV3::Deposit,
+            "deposit",
+            plan.deposit.outpoint,
+        ),
+        (
+            V026ThresholdOutputRoleV3::ClaimPayout,
+            "claim payout",
+            plan.claim_payout.outpoint,
+        ),
+        (
+            V026ThresholdOutputRoleV3::Stake,
+            "stake",
+            plan.stake.outpoint,
+        ),
+    ];
+    roles.extend(
+        plan.bond_funding
+            .iter()
+            .enumerate()
+            .map(|(index, funding)| {
+                (
+                    V026ThresholdOutputRoleV3::BondFunding(index),
+                    if index == 0 { "bond[0]" } else { "bond" },
+                    funding.outpoint(),
+                )
+            }),
+    );
+    for (role, _, outpoint) in &roles {
+        if *outpoint == OutPoint::null() {
+            return Err(V026ThresholdGraphV3Error::NullRoleOutpoint { role: *role });
+        }
+    }
+    for second in 0..roles.len() {
+        if let Some((_, first_role, _)) = roles[..second]
+            .iter()
+            .find(|(_, _, outpoint)| *outpoint == roles[second].2)
+        {
+            return Err(V026ThresholdGraphV3Error::ExternalOutpointAlias {
+                first_role,
+                second_role: roles[second].1,
+                outpoint: roles[second].2,
+            });
+        }
+    }
+    Ok(())
+}
+
+fn verify_derived_outpoints_do_not_alias_external(
+    plan: &V026ThresholdGraphV3Plan,
+    contest: &ContestV2Tx,
+    payout: OutPoint,
+    slash: OutPoint,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let mut derived = vec![("contest payout", payout), ("contest Slash", slash)];
+    for index in 0..plan.policy.alternatives().len() {
+        derived.push((
+            "contest counterproof",
+            contest
+                .counterproof_outpoint(index)
+                .map_err(V026ThresholdGraphV3Error::Contest)?,
+        ));
+    }
+    let external = [
+        ("Claim", plan.claim.outpoint),
+        ("deposit", plan.deposit.outpoint),
+        ("claim payout", plan.claim_payout.outpoint),
+        ("stake", plan.stake.outpoint),
+    ];
+    for (derived_role, derived_outpoint) in derived {
+        for (external_role, external_outpoint) in external {
+            if derived_outpoint == external_outpoint {
+                return Err(V026ThresholdGraphV3Error::DerivedExternalOutpointAlias {
+                    derived_role,
+                    external_role,
+                    outpoint: derived_outpoint,
+                });
+            }
+        }
+        for funding in &plan.bond_funding {
+            if derived_outpoint == funding.outpoint() {
+                return Err(V026ThresholdGraphV3Error::DerivedExternalOutpointAlias {
+                    derived_role,
+                    external_role: "bond",
+                    outpoint: derived_outpoint,
+                });
+            }
+        }
+    }
+    Ok(())
+}
