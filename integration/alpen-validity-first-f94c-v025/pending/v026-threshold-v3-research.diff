+    #[test]
+    fn assembles_exact_atomic_graph_and_retains_all_blockers() {
+        let graph = V026ThresholdGraphV3::assemble(plan()).expect("threshold graph");
+        graph.verify_structure().expect("structure");
+        assert_eq!(graph.alternatives().len(), ALTERNATIVES);
+        assert_eq!(graph.spend_matrix().len(), 6 + 4 * ALTERNATIVES);
+        assert_eq!(graph.role_outpoints().len(), 6 + 4 * ALTERNATIVES);
+        assert_eq!(graph.activation_blockers().len(), 17);
+        assert!(!graph.funding_eligible());
+        assert_eq!(
+            graph.structural_manifest().contest_payout_outpoint,
+            graph.contest().payout_gate_outpoint()
+        );
+        for (index, alternative) in graph.alternatives().iter().enumerate() {
+            assert_eq!(alternative.selected().index(), index);
+            assert_eq!(
+                alternative
+                    .counterproof()
+                    .shared_selection()
+                    .contest_payout_outpoint,
+                graph.structural_manifest().contest_payout_outpoint
+            );
+            assert_eq!(
+                alternative.resolution_branches().resolution_outpoint(),
+                graph.structural_manifest().alternatives[index].resolution_outpoint
+            );
+        }
+    }
