+#[allow(clippy::too_many_arguments)]
+fn encode_participant_contribution(
+    setup_intent_digest: [u8; 32],
+    fault_profile: ThresholdReleaseFaultProfileV3,
+    alternative_count: usize,
+    participant_index: usize,
+    identity_pubkey: XOnlyPublicKey,
+    control_domain_digest: [u8; 32],
+    release_pubkeys: &[XOnlyPublicKey],
+) -> Result<Vec<u8>, ThresholdV3ParticipantIdentityError> {
+    let participant_count = u16::try_from(fault_profile.participant_count())
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let threshold = u16::try_from(fault_profile.threshold())
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let max_corrupt = u16::try_from(fault_profile.max_corrupt())
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let alternative_count = u16::try_from(alternative_count)
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let participant_index = u16::try_from(participant_index)
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let release_bytes = release_pubkeys
+        .len()
+        .checked_mul(32)
+        .ok_or(ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let total_len = 8usize
+        .checked_add(2 + 2 + 4 + 32 + 2 + 2 + 2 + 2 + 2 + 32 + 32)
+        .and_then(|prefix| prefix.checked_add(release_bytes))
+        .ok_or(ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let total_len_u32 = u32::try_from(total_len)
+        .map_err(|_| ThresholdV3ParticipantIdentityError::EncodingLengthOverflow)?;
+    let mut encoded = Vec::with_capacity(total_len);
+    encoded.extend_from_slice(&CONTRIBUTION_MAGIC);
+    encoded.extend_from_slice(&CONTRIBUTION_SCHEMA_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&PROTOCOL_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&total_len_u32.to_be_bytes());
+    encoded.extend_from_slice(&setup_intent_digest);
+    encoded.extend_from_slice(&participant_count.to_be_bytes());
+    encoded.extend_from_slice(&threshold.to_be_bytes());
+    encoded.extend_from_slice(&max_corrupt.to_be_bytes());
+    encoded.extend_from_slice(&alternative_count.to_be_bytes());
+    encoded.extend_from_slice(&participant_index.to_be_bytes());
+    encoded.extend_from_slice(&identity_pubkey.serialize());
+    encoded.extend_from_slice(&control_domain_digest);
+    for release_pubkey in release_pubkeys {
+        encoded.extend_from_slice(&release_pubkey.serialize());
+    }
+    debug_assert_eq!(encoded.len(), total_len);
+    Ok(encoded)
+}
+
+fn encode_registry(
+    setup_intent_digest: [u8; 32],
+    fault_profile: ThresholdReleaseFaultProfileV3,
+    alternative_count: usize,
+    participants: &[ThresholdV3ParticipantIdentity],
+) -> Result<Vec<u8>, ThresholdV3KeyRegistryError> {
+    let participant_count = u16::try_from(fault_profile.participant_count())
+        .map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let threshold = u16::try_from(fault_profile.threshold())
+        .map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let max_corrupt = u16::try_from(fault_profile.max_corrupt())
+        .map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let alternative_count = u16::try_from(alternative_count)
+        .map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+
+    let per_participant = 2usize
+        .checked_add(32 * 3)
+        .and_then(|prefix| prefix.checked_add(32 * usize::from(alternative_count)))
+        .ok_or(ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let participant_bytes = per_participant
+        .checked_mul(participants.len())
+        .ok_or(ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let total_len = 8usize
+        .checked_add(2 + 2 + 4 + 32 + 2 + 2 + 2 + 2)
+        .and_then(|prefix| prefix.checked_add(participant_bytes))
+        .ok_or(ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let total_len_u32 =
+        u32::try_from(total_len).map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+    let mut encoded = Vec::with_capacity(total_len);
+    encoded.extend_from_slice(&REGISTRY_MAGIC);
+    encoded.extend_from_slice(&REGISTRY_SCHEMA_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&PROTOCOL_VERSION.to_be_bytes());
+    encoded.extend_from_slice(&total_len_u32.to_be_bytes());
+    encoded.extend_from_slice(&setup_intent_digest);
+    encoded.extend_from_slice(&participant_count.to_be_bytes());
+    encoded.extend_from_slice(&threshold.to_be_bytes());
+    encoded.extend_from_slice(&max_corrupt.to_be_bytes());
+    encoded.extend_from_slice(&alternative_count.to_be_bytes());
+    for (participant_index, participant) in participants.iter().enumerate() {
+        let participant_index = u16::try_from(participant_index)
+            .map_err(|_| ThresholdV3KeyRegistryError::EncodedLengthOverflow)?;
+        encoded.extend_from_slice(&participant_index.to_be_bytes());
+        encoded.extend_from_slice(&participant.identity_pubkey.serialize());
+        encoded.extend_from_slice(&participant.control_domain_digest);
+        encoded.extend_from_slice(&participant.contribution_digest);
+        for release_pubkey in participant.release_pubkeys.iter() {
+            encoded.extend_from_slice(&release_pubkey.serialize());
+        }
+    }
+    debug_assert_eq!(encoded.len(), total_len);
+    Ok(encoded)
+}
