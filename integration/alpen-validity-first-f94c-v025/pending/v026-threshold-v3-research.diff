+    fn registry() -> Arc<ThresholdV3KeyRegistry> {
+        let fault_profile = ThresholdReleaseFaultProfileV3::new(3, 2, 1).expect("fault profile");
+        let participants = (0..3)
+            .map(|participant| {
+                let identity = keypair(10 + participant as u32);
+                let identity_pubkey = identity.x_only_public_key().0;
+                let control_domain_digest = [20 + participant as u8; 32];
+                let release_pubkeys: Vec<_> = (0..ALTERNATIVES)
+                    .map(|alternative| key(100 + (participant * ALTERNATIVES + alternative) as u32))
+                    .collect();
+                let digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                    SETUP_DIGEST,
+                    fault_profile,
+                    ALTERNATIVES,
+                    participant,
+                    identity_pubkey,
+                    control_domain_digest,
+                    &release_pubkeys,
+                )
+                .expect("contribution digest");
+                ThresholdV3ParticipantIdentity::new(
+                    SETUP_DIGEST,
+                    fault_profile,
+                    ALTERNATIVES,
+                    participant,
+                    identity_pubkey,
+                    control_domain_digest,
+                    release_pubkeys,
+                    identity.sign_schnorr(Message::from_digest(digest)),
+                )
+                .expect("signed contribution")
+            })
+            .collect();
+        Arc::new(
+            ThresholdV3KeyRegistry::new(SETUP_DIGEST, fault_profile, ALTERNATIVES, participants)
+                .expect("registry"),
+        )
+    }
