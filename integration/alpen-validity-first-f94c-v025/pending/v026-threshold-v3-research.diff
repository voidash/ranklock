+/// Live observer-produced funding-blocked capability.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct StructurallyVerifiedFundingBlockedV3 {
+    manifest: V026ThresholdObservationManifestV3,
+    blockers: [V026BlockerCodeV3; V026_BLOCKER_COUNT_V3],
+}
+
+impl StructurallyVerifiedFundingBlockedV3 {
+    /// Re-verifies and snapshots one in-process threshold-v3 graph.
+    pub fn observe(graph: &V026ThresholdGraphV3) -> Result<Self, V026ObservationErrorV3> {
+        graph
+            .verify_structure()
+            .map_err(V026ObservationErrorV3::StructuralVerification)?;
+        if graph.funding_eligible() {
+            return Err(V026ObservationErrorV3::UnexpectedFundingEligibility);
+        }
+        validate_live_blockers(graph.activation_blockers())?;
+        let manifest = V026ThresholdObservationManifestV3::from_graph(graph)?;
+        validate_manifest(&manifest).map_err(V026ObservationErrorV3::InvalidManifest)?;
+        Ok(Self {
+            manifest,
+            blockers: V026_BLOCKERS_V3,
+        })
+    }
+
+    /// Content-derived funded-P1 identity for inert local correlation.
+    pub const fn funded_setup_digest(&self) -> [u8; 32] {
+        self.manifest.funded_setup_digest
+    }
+
+    /// Exact local structural manifest.
+    pub const fn manifest(&self) -> &V026ThresholdObservationManifestV3 {
+        &self.manifest
+    }
+
+    /// Complete immutable activation-blocker set.
+    pub const fn blockers(&self) -> &[V026BlockerCodeV3; V026_BLOCKER_COUNT_V3] {
+        &self.blockers
+    }
+
+    /// This observation cannot authorize funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Produces the inert persisted read model.
+    pub fn to_persisted(&self) -> PersistedFundingBlockedObservationV3 {
+        PersistedFundingBlockedObservationV3 {
+            manifest: self.manifest.clone(),
+            blockers: self.blockers,
+        }
+    }
+
+    /// Verifies a finalized ACK against this exact graph and mints a live CAS capability.
+    pub fn verify_ack_witness_selection(
+        &self,
+        graph: &V026ThresholdGraphV3,
+        alternative: usize,
+        finalized: &FinalizedCounterproofAckThresholdV3,
+    ) -> Result<VerifiedThresholdAckWitnessSelectionV3, V026AckWitnessSelectionErrorV3> {
+        let recomputed =
+            Self::observe(graph).map_err(V026AckWitnessSelectionErrorV3::Observation)?;
+        if &recomputed != self {
+            return Err(V026AckWitnessSelectionErrorV3::ParentObservationMismatch);
+        }
+        let subject = V026ThresholdAckSubjectV3::from_observation(self, alternative)?;
+        let branch = graph.alternatives().get(alternative).ok_or(
+            V026AckWitnessSelectionErrorV3::UnknownAlternative {
+                alternative,
+                alternatives: graph.alternatives().len(),
+            },
+        )?;
+        let publication = finalized.publication();
+        if publication.resolution_outpoint() != subject.resolution_outpoint
+            || publication.txid() != subject.ack_txid
+            || publication.exact_sighash().as_ref() != &subject.ack_sighash
+        {
+            return Err(V026AckWitnessSelectionErrorV3::PublicationIdentityMismatch);
+        }
+        if finalized.transaction().compute_txid() != publication.txid()
+            || finalized.transaction().compute_wtxid() != publication.wtxid()
+            || finalized.transaction().input.len() != 1
+            || finalized.transaction().input[0].previous_output != subject.resolution_outpoint
+            || &finalized.transaction().input[0].witness != publication.witness()
+        {
+            return Err(V026AckWitnessSelectionErrorV3::FinalizedTransactionMismatch);
+        }
+        let candidates = publication
+            .selected_release_signatures()
+            .iter()
+            .map(|selected| {
+                IndexedReleaseSignatureV3::new(selected.participant_index(), selected.signature())
+            })
+            .collect();
+        let independently_finalized = branch
+            .resolution_branches()
+            .ack()
+            .clone()
+            .finalize(candidates, publication.graph_signature())
+            .map_err(V026AckWitnessSelectionErrorV3::AckFinalization)?;
+        if &independently_finalized != finalized {
+            return Err(V026AckWitnessSelectionErrorV3::IndependentFinalizationMismatch);
+        }
+        let persisted =
+            PersistedThresholdAckWitnessSelectionV3::from_finalized(subject, finalized)?;
+        Ok(VerifiedThresholdAckWitnessSelectionV3 { persisted })
+    }
+}
