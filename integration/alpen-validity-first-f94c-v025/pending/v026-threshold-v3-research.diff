+//! Canonical assembly for the funding-blocked threshold-v3 v0.26 graph.
+//!
+//! The assembler accepts only external Claim, `D`, `Q`, `K`, and ordered
+//! bond-funding bindings. Every `C`, `P`, `S`, `R`, and `L` outpoint is derived
+//! from the actual unsigned parent transaction. P1 is constructed internally
+//! from the static P0 policy and the Contest transaction. Structural success
+//! never authorizes funding.
+
+use std::{error::Error, fmt, sync::Arc};
+
+use bitcoin::{
+    absolute, transaction::Version, Amount, OutPoint, ScriptBuf, Sequence, Transaction, TxIn,
+    TxOut, Txid,
+};
+use secp256k1::XOnlyPublicKey;
+use strata_asm_proto_bridge_v1_txs::slash::SlashTxHeaderAux;
+use strata_bridge_connectors::{
+    prelude::{
+        ClaimContestConnector, ClaimContestConnectorError, ClaimContestSpendPath,
+        ClaimPayoutConnector, ClaimPayoutSpendPath, ContestCounterproofSpendV2,
+        ContestPayoutGateSpendPathV2, ContestPayoutGateV2, ContestProofConnector,
+        ContestSlashGateSpendPathV2, ContestSlashGateV2, CounterproofBondSpendV3,
+        CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdSpendPathV3,
+        KeyedAnchor, MultiAnchor, NOfNConnector, NOfNSpend, SlashAuthorizationConnectorV2,
+        SlashAuthorizationSpendPathV2, ThresholdV3BondPolicyError, ThresholdV3BondPolicyP0,
+        ThresholdV3FundedSetupError, ThresholdV3FundedSetupP1, ThresholdV3FundingOutput,
+        ThresholdV3SelectedBinding,
+    },
+    Connector,
+};
+use strata_l1_txfmt::{MagicBytes, ParseConfig};
+
+use crate::transactions::prelude::{
+    ClaimTx, ContestAlternativeV2, ContestV2Data, ContestV2Error, ContestV2OutputPlan, ContestV2Tx,
+    CounterproofThresholdV3Data, CounterproofThresholdV3Error, CounterproofThresholdV3Tx,
+    OwnerPayoutThresholdV3Data, OwnerPayoutThresholdV3Error, OwnerPayoutThresholdV3Tx,
+    SlashPayoutV2, SlashV2Data, SlashV2Error, SlashV2Tx, TemplateFeeAllowanceV2,
+    ThresholdResolutionBranchesV3, ThresholdResolutionBranchesV3Error,
