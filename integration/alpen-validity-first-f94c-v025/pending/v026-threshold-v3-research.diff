+    #[test]
+    fn core_enforces_exact_csv_boundary_and_ack_timeout_conflict() {
+        let mut node = BitcoinNode::new();
+        let fixture = Fixture::new();
+        let funding = Transaction {
+            version: Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output: vec![
+                fixture.resolution.tx_out(),
+                fixture.slash.tx_out(),
+                TxOut {
+                    value: node.coinbase_amount() - R_VALUE - S_VALUE - FUNDING_FEE,
+                    script_pubkey: node.wallet_address().script_pubkey(),
+                },
+            ],
+        };
+        let funding_txid = node.sign_and_broadcast(&funding);
+        node.mine_blocks(1);
+        let resolution_outpoint = OutPoint::new(funding_txid, 0);
+        let slash_outpoint = OutPoint::new(funding_txid, 1);
+
+        let timeout = fixture.timeout(resolution_outpoint, slash_outpoint);
+        let timeout_signing = timeout.signing_info();
+        let timeout_tx = timeout
+            .finalize([
+                timeout_signing[0].sign(&fixture.graph),
+                timeout_signing[1].sign(&fixture.graph),
+            ])
+            .unwrap();
+        assert_eq!(timeout_tx.weight().to_wu(), 1_257);
+        assert_eq!(timeout_tx.vsize(), 315);
+
+        let ack_refund_key = generate_keypair();
+        let ack_anchor_key = generate_keypair();
+        let slash_authorization = SlashAuthorizationConnectorV2::new(
+            Network::Regtest,
+            fixture.graph.x_only_public_key().0,
+            Amount::from_sat(1_000),
+            ResearchV0NumsContext::new(SETUP_DIGEST, ResearchV0NumsRole::SlashAuthorization, 0),
+        )
+        .unwrap();
+        let ack = CounterproofAckThresholdV3Tx::new(
+            CounterproofAckThresholdV3Data {
+                resolution_outpoint,
+                alternative: ALTERNATIVE,
+            },
+            fixture.resolution.clone(),
+            SelectedCollateralRefundV3::new(
+                Descriptor::new_p2tr(&ack_refund_key.x_only_public_key().0.serialize()).unwrap(),
+                Amount::from_sat(58_170),
+            )
+            .unwrap(),
+            slash_authorization,
+            KeyedAnchor::new(
+                Network::Regtest,
+                ack_anchor_key.x_only_public_key().0,
+                ANCHOR_VALUE,
+            ),
+            FEE,
+            TemplateFeeAllowanceV2::new(TemplateKindV2::CounterproofAck, FEE).unwrap(),
+        )
+        .unwrap();
+        let ack_signing = ack.signing_info()[0];
+        let ack_tx = ack
+            .finalize(
+                fixture
+                    .releases
+                    .iter()
+                    .take(2)
+                    .enumerate()
+                    .map(|(index, keypair)| {
+                        IndexedReleaseSignatureV3::new(index, ack_signing.sign(keypair))
+                    })
+                    .collect(),
+                ack_signing.sign(&fixture.graph),
+            )
+            .unwrap();
+
+        assert!(node.client().send_raw_transaction(&timeout_tx).is_err());
+        node.mine_blocks(usize::from(TIMEOUT.value()).saturating_sub(2));
+        assert!(node.client().send_raw_transaction(&timeout_tx).is_err());
+        node.mine_blocks(1);
+        node.client()
+            .send_raw_transaction(&timeout_tx)
+            .expect("Core accepts threshold timeout at first valid CSV boundary");
+        node.mine_blocks(1);
+        assert!(node
+            .client()
+            .send_raw_transaction(ack_tx.transaction())
+            .is_err());
+    }
