+/// Script-only output shared by threshold ACK and CSV timeout parents.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofResolutionThresholdConnectorV3 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    release_pubkeys: Vec<XOnlyPublicKey>,
+    alternative: ThresholdAckAlternativeV3,
+    fault_profile: ThresholdReleaseFaultProfileV3,
+    timeout_delay: relative::Height,
+    value: Amount,
+    selected_commitment: [u8; 32],
+    internal_key: XOnlyPublicKey,
+}
+
+impl CounterproofResolutionThresholdConnectorV3 {
+    /// Constructs the funding-ineligible connector from one exact P1 binding.
+    pub fn from_selected_binding(
+        binding: &ThresholdV3SelectedBinding,
+    ) -> Result<Self, CounterproofResolutionThresholdV3Error> {
+        let setup = binding.setup();
+        let policy = setup.policy();
+        let registry = policy.registry();
+        let selected_policy = binding.policy();
+        let alternative_index = u32::try_from(binding.index()).map_err(|_| {
+            CounterproofResolutionThresholdV3Error::AlternativeIndexOverflow {
+                index: binding.index(),
+            }
+        })?;
+        let value = selected_policy
+            .base_resolution_value()
+            .checked_add(selected_policy.bond_value())
+            .ok_or(CounterproofResolutionThresholdV3Error::AmountOverflow)?;
+        if value != selected_policy.bonded_resolution_value() {
+            return Err(
+                CounterproofResolutionThresholdV3Error::BondedResolutionValueMismatch {
+                    derived: value,
+                    committed: selected_policy.bonded_resolution_value(),
+                },
+            );
+        }
+        let selected_commitment = binding.selected_commitment().to_byte_array();
+        let internal_key = derive_resolution_nums(selected_commitment)
+            .map_err(CounterproofResolutionThresholdV3Error::NumsDerivation)?;
+
+        Self::from_bound_parts(
+            policy.network(),
+            policy.graph_pubkey(),
+            binding.release_pubkeys(),
+            ThresholdAckAlternativeV3::new(alternative_index),
+            registry.fault_profile(),
+            selected_policy.timeout_delay(),
+            value,
+            selected_commitment,
+            internal_key,
+        )
+    }
+
+    /// Constructs an unbound connector for tests that have not migrated to P1.
+    ///
+    /// This API exists only in crate tests or explicit `test_utils` builds. Its
+    /// fixture commitment is not a P1 selected commitment and cannot authorize
+    /// funding.
+    ///
+    /// Validation precedes the call to the legacy script helper, whose public
+    /// API panics for invalid roster/threshold pairs.
+    #[cfg(any(test, feature = "test_utils"))]
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        release_pubkeys: Vec<XOnlyPublicKey>,
+        alternative: ThresholdAckAlternativeV3,
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        timeout_delay: relative::Height,
+        value: Amount,
+        nums_context: ResearchV0NumsContext,
+    ) -> Result<Self, CounterproofResolutionThresholdV3Error> {
+        if release_pubkeys.len() != fault_profile.participant_count() {
+            return Err(
+                CounterproofResolutionThresholdV3Error::FaultProfileRosterMismatch {
+                    profile_participants: fault_profile.participant_count(),
+                    release_keys: release_pubkeys.len(),
+                },
+            );
+        }
+        for (index, release_pubkey) in release_pubkeys.iter().enumerate() {
+            if let Some(first_index) = release_pubkeys[..index]
+                .iter()
+                .position(|earlier| earlier == release_pubkey)
+            {
+                return Err(
+                    CounterproofResolutionThresholdV3Error::DuplicateReleaseKey {
+                        first_index,
+                        duplicate_index: index,
+                    },
+                );
+            }
+            if *release_pubkey == graph_pubkey {
+                return Err(CounterproofResolutionThresholdV3Error::GraphReleaseKeyAlias { index });
+            }
+        }
+        if timeout_delay.value() == 0 {
+            return Err(CounterproofResolutionThresholdV3Error::ZeroTimeoutDelay);
+        }
+        if value > Amount::MAX_MONEY {
+            return Err(CounterproofResolutionThresholdV3Error::ValueAboveMaxMoney { value });
+        }
+        if nums_context.role() != ResearchV0NumsRole::CounterproofResolutionThreshold {
+            return Err(CounterproofResolutionThresholdV3Error::WrongNumsRole);
+        }
+        let fixture_commitment = nums_context
+            .derive_internal_key()
+            .map_err(CounterproofResolutionThresholdV3Error::NumsDerivation)?
+            .serialize();
+        let internal_key = derive_resolution_nums(fixture_commitment)
+            .map_err(CounterproofResolutionThresholdV3Error::NumsDerivation)?;
+
+        Self::from_bound_parts(
+            network,
+            graph_pubkey,
+            release_pubkeys,
+            alternative,
+            fault_profile,
+            timeout_delay,
+            value,
+            fixture_commitment,
+            internal_key,
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn from_bound_parts(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        release_pubkeys: Vec<XOnlyPublicKey>,
+        alternative: ThresholdAckAlternativeV3,
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        timeout_delay: relative::Height,
+        value: Amount,
+        selected_commitment: [u8; 32],
+        internal_key: XOnlyPublicKey,
+    ) -> Result<Self, CounterproofResolutionThresholdV3Error> {
+        if release_pubkeys.len() != fault_profile.participant_count() {
+            return Err(
+                CounterproofResolutionThresholdV3Error::FaultProfileRosterMismatch {
+                    profile_participants: fault_profile.participant_count(),
+                    release_keys: release_pubkeys.len(),
+                },
+            );
+        }
+        for (index, release_pubkey) in release_pubkeys.iter().enumerate() {
+            if let Some(first_index) = release_pubkeys[..index]
+                .iter()
+                .position(|earlier| earlier == release_pubkey)
+            {
+                return Err(
+                    CounterproofResolutionThresholdV3Error::DuplicateReleaseKey {
+                        first_index,
+                        duplicate_index: index,
+                    },
+                );
+            }
+            if *release_pubkey == graph_pubkey {
+                return Err(CounterproofResolutionThresholdV3Error::GraphReleaseKeyAlias { index });
+            }
+        }
+        if timeout_delay.value() == 0 {
+            return Err(CounterproofResolutionThresholdV3Error::ZeroTimeoutDelay);
+        }
+        if value > Amount::MAX_MONEY {
+            return Err(CounterproofResolutionThresholdV3Error::ValueAboveMaxMoney { value });
+        }
+        let connector = Self {
+            network,
+            graph_pubkey,
+            release_pubkeys,
+            alternative,
+            fault_profile,
+            timeout_delay,
+            value,
+            selected_commitment,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        for (authorization, key) in std::iter::once((
+            ThresholdAckAuthorizationKeyV3::Graph,
+            connector.graph_pubkey,
+        ))
+        .chain(
+            connector
+                .release_pubkeys
+                .iter()
+                .copied()
+                .enumerate()
+                .map(|(index, key)| (ThresholdAckAuthorizationKeyV3::Release { index }, key)),
+        ) {
+            for (nums_key_kind, nums_key) in [
+                (ThresholdAckNumsKeyKindV3::Internal, connector.internal_key),
+                (ThresholdAckNumsKeyKindV3::Output, output_key),
+            ] {
+                if key == nums_key {
+                    return Err(
+                        CounterproofResolutionThresholdV3Error::AuthorizationNumsKeyAlias {
+                            authorization,
+                            nums_key_kind,
+                        },
+                    );
+                }
+            }
+        }
+
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if value < minimum {
+            return Err(CounterproofResolutionThresholdV3Error::DustValue { value, minimum });
+        }
+        Ok(connector)
+    }
+
+    /// Returns the graph key bound by both exact-parent leaves.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    /// Returns release keys in setup-committed participant order.
+    pub fn release_pubkeys(&self) -> &[XOnlyPublicKey] {
+        &self.release_pubkeys
+    }
+
+    /// Returns the exact counterproof alternative identity.
+    pub const fn alternative(&self) -> ThresholdAckAlternativeV3 {
+        self.alternative
+    }
+
+    /// Returns the setup-committed threshold fault profile.
+    pub const fn fault_profile(&self) -> ThresholdReleaseFaultProfileV3 {
+        self.fault_profile
+    }
+
+    /// Returns the exact number of nonempty participant signatures required.
+    pub const fn threshold(&self) -> usize {
+        self.fault_profile.threshold()
+    }
+
+    /// Returns the CSV delay of the timeout path.
+    pub const fn timeout_delay(&self) -> relative::Height {
+        self.timeout_delay
+    }
+
+    /// Returns the exact P1-selected commitment embedded in both leaves.
+    pub const fn selected_commitment(&self) -> [u8; 32] {
+        self.selected_commitment
+    }
+
+    /// This draft role, script, and wire profile cannot authorize funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Builds a strictly shaped ACK witness after checking every roster slot.
+    pub fn ack_witness(
+        &self,
+        graph_signature: schnorr::Signature,
+        ordered_release_signatures: Vec<Option<schnorr::Signature>>,
+    ) -> Result<CounterproofResolutionThresholdWitnessV3, CounterproofResolutionThresholdV3Error>
+    {
+        if ordered_release_signatures.len() != self.release_pubkeys.len() {
+            return Err(
+                CounterproofResolutionThresholdV3Error::InvalidAckSignatureSlotCount {
+                    expected: self.release_pubkeys.len(),
+                    actual: ordered_release_signatures.len(),
+                },
+            );
+        }
+        let actual = ordered_release_signatures
+            .iter()
+            .filter(|signature| signature.is_some())
+            .count();
+        if actual != self.threshold() {
+            return Err(
+                CounterproofResolutionThresholdV3Error::InvalidAckSignatureCount {
+                    expected: self.threshold(),
+                    actual,
+                },
+            );
+        }
+        Ok(CounterproofResolutionThresholdWitnessV3 {
+            kind: CounterproofResolutionThresholdWitnessKindV3::Ack {
+                graph_signature,
+                ordered_release_signatures,
+            },
+        })
+    }
+
+    /// Builds the CSV timeout witness.
+    pub const fn timeout_witness(
+        &self,
+        graph_signature: schnorr::Signature,
+    ) -> CounterproofResolutionThresholdWitnessV3 {
+        CounterproofResolutionThresholdWitnessV3 {
+            kind: CounterproofResolutionThresholdWitnessKindV3::Timeout { graph_signature },
+        }
+    }
+
+    fn ack_script(&self) -> ScriptBuf {
+        let mut script_bytes = script::Builder::new()
+            .push_slice(self.selected_commitment)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+            .into_script()
+            .into_bytes();
+        let threshold_script = threshold_multisig_script(&self.release_pubkeys, self.threshold());
+        script_bytes.extend_from_slice(threshold_script.as_bytes());
+        ScriptBuf::from_bytes(script_bytes)
+    }
+
+    fn timeout_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.selected_commitment)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_sequence(Sequence::from_height(self.timeout_delay.value()))
+            .push_opcode(opcodes::all::OP_CSV)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+}
