+fn push_strict_key(
+    keys: &mut Vec<(&'static str, XOnlyPublicKey)>,
+    role: &'static str,
+    key: XOnlyPublicKey,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if let Some((first_role, _)) = keys.iter().find(|(_, earlier)| *earlier == key) {
+        return Err(V026ThresholdGraphV3Error::ControllerDomainAlias {
+            first_role,
+            second_role: role,
+        });
+    }
+    keys.push((role, key));
+    Ok(())
+}
+
+fn push_p0_destination_key(
+    keys: &mut Vec<(&'static str, XOnlyPublicKey)>,
+    role: &'static str,
+    key: XOnlyPublicKey,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if let Some((first_role, _)) = keys.iter().find(|(_, earlier)| *earlier == key) {
+        if *first_role == role && matches!(role, "operator/owner" | "recovery") {
+            return Ok(());
+        }
+        return Err(V026ThresholdGraphV3Error::ControllerDomainAlias {
+            first_role,
+            second_role: role,
+        });
+    }
+    keys.push((role, key));
+    Ok(())
+}
+
+fn push_claim_nums_key(
+    keys: &mut Vec<(&'static str, XOnlyPublicKey)>,
+    key: XOnlyPublicKey,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if let Some((first_role, _)) = keys.iter().find(|(_, earlier)| *earlier == key) {
+        if *first_role == "Contest MultiAnchor NUMS" {
+            return Ok(());
+        }
+        return Err(V026ThresholdGraphV3Error::ControllerDomainAlias {
+            first_role,
+            second_role: "opaque Claim NUMS internal",
+        });
+    }
+    keys.push(("opaque Claim NUMS internal", key));
+    Ok(())
+}
+
+fn push_p0_destination_script(
+    scripts: &mut Vec<(&'static str, ScriptBuf)>,
+    role: &'static str,
+    script: ScriptBuf,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if let Some((first_role, _)) = scripts.iter().find(|(_, earlier)| *earlier == script) {
+        if *first_role == role && matches!(role, "operator/owner" | "recovery") {
+            return Ok(());
+        }
+        return Err(V026ThresholdGraphV3Error::ScriptDomainAlias {
+            first_role,
+            second_role: role,
+        });
+    }
+    scripts.push((role, script));
+    Ok(())
+}
+
+fn push_strict_script(
+    scripts: &mut Vec<(&'static str, ScriptBuf)>,
+    role: &'static str,
+    script: ScriptBuf,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    if let Some((first_role, _)) = scripts.iter().find(|(_, earlier)| *earlier == script) {
+        return Err(V026ThresholdGraphV3Error::ScriptDomainAlias {
+            first_role,
+            second_role: role,
+        });
+    }
+    scripts.push((role, script));
+    Ok(())
+}
