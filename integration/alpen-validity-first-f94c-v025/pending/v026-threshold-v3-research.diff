+//! Durable, funding-blocked observation and ACK-witness adoption capabilities
+//! for the threshold-v3 v0.26 research graph.
+//!
+//! Live capabilities in this module have private fields and deliberately do
+//! not implement Serde traits. Persisted values are inert read models: decoding
+//! one never recreates authority to write or publish. Structural verification,
+//! durable first-writer-wins storage, and runtime publication remain separate
+//! obligations. Nothing in this module authorizes funding.
+
+use std::collections::HashSet;
+
+use bitcoin::{
+    Amount, OutPoint, Transaction, TxOut, Txid, Wtxid, consensus,
+    hashes::Hash,
+    secp256k1::{self, Message, XOnlyPublicKey, schnorr},
+};
+use serde::{Deserialize, Deserializer, Serialize, Serializer, de::Error as _};
+use strata_bridge_primitives::scripts::prelude::threshold_multisig_script;
+use strata_bridge_tx_graph::{
+    transactions::{
+        PresignedTx,
+        contest_v2::ContestV2Tx,
+        counterproof_ack_threshold_v3::{
+            FinalizedCounterproofAckThresholdV3, IndexedReleaseSignatureV3,
+        },
+        counterproof_threshold_v3::CounterproofThresholdV3Tx,
+    },
+    v026_threshold_graph_v3::{
+        V026ThresholdActivationBlockerV3, V026ThresholdGraphV3, V026ThresholdGraphV3Error,
+        V026ThresholdOutputRoleV3,
+    },
+};
+use thiserror::Error;
