+            return Err(ThresholdV3BondAlternativePolicyError::MoneyRange {
+                field: "bonded resolution",
+                value: bonded_resolution_value,
+            });
+        }
+        for (field, output) in [
+            (
+                "counterproof return",
+                counterproof_return.tx_out(counterproof_output.value()),
+            ),
+            ("bond refund", bond_refund.tx_out(bond_value)),
+            (
+                "operator compensation",
+                operator_compensation.tx_out(bond_value),
+            ),
+            ("recovery", recovery.tx_out(bonded_resolution_value)),
+        ] {
+            let minimum = output.script_pubkey.minimal_non_dust();
+            if output.value < minimum {
+                return Err(ThresholdV3BondAlternativePolicyError::DustValue {
+                    field,
+                    value: output.value,
+                    minimum,
+                });
+            }
+        }
+        if counterproof_return.principal_id != bond_refund.principal_id
+            || counterproof_return.authority_digest != bond_refund.authority_digest
+        {
+            return Err(ThresholdV3BondAlternativePolicyError::ProviderIdentityMismatch);
+        }
+        if bond_refund.principal_id == operator_compensation.principal_id
+            || bond_refund.authority_digest == operator_compensation.authority_digest
+            || bond_refund.output_key == operator_compensation.output_key
+        {
+            return Err(ThresholdV3BondAlternativePolicyError::ProviderOperatorAlias);
+        }
+        if recovery.principal_id == operator_compensation.principal_id
+            || recovery.authority_digest == operator_compensation.authority_digest
+            || recovery.output_key == operator_compensation.output_key
+        {
+            return Err(ThresholdV3BondAlternativePolicyError::RecoveryOperatorAlias);
+        }
+        if recovery.principal_id == bond_refund.principal_id
+            || recovery.authority_digest == bond_refund.authority_digest
+            || recovery.output_key == bond_refund.output_key
+        {
+            return Err(ThresholdV3BondAlternativePolicyError::RecoveryProviderAlias);
+        }
+        Ok(Self {
+            counterproof_output,
+            counterproof_return,
+            bond_value,
+            bond_refund,
+            operator_compensation,
+            recovery,
+            base_resolution_value,
+            bonded_resolution_value,
+            timeout_delay,
+        })
+    }
