+/// Invalid funded C/B setup binding.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ThresholdV3FundedSetupError {
+    /// Null outpoints cannot identify funded predecessors.
+    NullOutpoint,
+    /// Previous output exceeds MoneyRange.
+    MoneyRange {
+        /// Rejected value.
+        value: Amount,
+    },
+    /// C and B rosters differ from P0.
+    RosterLengthMismatch {
+        /// Required alternative count.
+        expected: usize,
+        /// Supplied C count.
+        counterproof: usize,
+        /// Supplied B count.
+        bonds: usize,
+    },
+    /// One C previous output differs from P0.
+    CounterproofOutputMismatch {
+        /// Alternative position.
+        index: usize,
+    },
+    /// One B previous output differs from the derived connector.
+    BondOutputMismatch {
+        /// Alternative position.
+        index: usize,
+    },
+    /// One C/B outpoint is reused.
+    DuplicateOutpoint {
+        /// Position in flattened C/B encounter order.
+        first_index: usize,
+        /// Alternative position where duplicate was seen.
+        duplicate_index: usize,
+    },
+    /// Selected index exceeded the roster.
+    AlternativeIndexOutOfRange {
+        /// Rejected index.
+        index: usize,
+        /// Alternative count.
+        count: usize,
+    },
+    /// Canonical encoding cannot represent a script/length.
+    EncodingLengthOverflow,
+    /// Derived P0 connector failed validation.
+    Policy(ThresholdV3BondPolicyError),
+}
+
+impl fmt::Display for ThresholdV3FundedSetupError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NullOutpoint => f.write_str("threshold funded setup outpoint must be non-null"),
+            Self::MoneyRange { value } => {
+                write!(
+                    f,
+                    "threshold funded setup output {value} exceeds MoneyRange"
+                )
+            }
+            Self::RosterLengthMismatch {
+                expected,
+                counterproof,
+                bonds,
+            } => write!(
+                f,
+                "threshold funded setup expects {expected} C/B slots, got C={counterproof}, B={bonds}"
+            ),
+            Self::CounterproofOutputMismatch { index } => {
+                write!(f, "threshold C output {index} differs from P0")
+            }
+            Self::BondOutputMismatch { index } => {
+                write!(f, "threshold B output {index} differs from P0")
+            }
+            Self::DuplicateOutpoint {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold funded outpoint at alternative {duplicate_index} duplicates flattened position {first_index}"
+            ),
+            Self::AlternativeIndexOutOfRange { index, count } => write!(
+                f,
+                "threshold selected index {index} is outside setup count {count}"
+            ),
+            Self::EncodingLengthOverflow => {
+                f.write_str("threshold funded-setup encoding length overflowed")
+            }
+            Self::Policy(error) => write!(f, "threshold funded setup policy failed: {error}"),
+        }
+    }
+}
+
+impl Error for ThresholdV3FundedSetupError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Policy(error) => Some(error),
+            _ => None,
+        }
+    }
+}
