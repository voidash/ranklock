+/// Static, transaction-id-free threshold bond policy.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3BondPolicyP0 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    registry: Arc<ThresholdV3KeyRegistry>,
+    alternatives: Box<[ThresholdV3BondAlternativePolicy]>,
+    canonical_bytes: Box<[u8]>,
+    digest: ThresholdV3BondPolicyDigest,
+}
+
+impl ThresholdV3BondPolicyP0 {
+    /// Validates and canonically commits the static bond policy.
+    pub fn new(
+        network: Network,
+        graph_pubkey: XOnlyPublicKey,
+        registry: Arc<ThresholdV3KeyRegistry>,
+        alternatives: Vec<ThresholdV3BondAlternativePolicy>,
+    ) -> Result<Arc<Self>, ThresholdV3BondPolicyError> {
+        if alternatives.len() != registry.alternative_count() {
+            return Err(ThresholdV3BondPolicyError::AlternativeCountMismatch {
+                registry: registry.alternative_count(),
+                actual: alternatives.len(),
+            });
+        }
+        validate_static_domains(network, graph_pubkey, &registry, &alternatives)?;
+        let alternatives = alternatives.into_boxed_slice();
+        let canonical_bytes =
+            encode_policy(network, graph_pubkey, registry.digest(), &alternatives)?;
+        let digest = ThresholdV3BondPolicyDigest(
+            ThresholdBondPolicyV3Hash::hash(&canonical_bytes).to_byte_array(),
+        );
+        let policy = Self {
+            network,
+            graph_pubkey,
+            registry,
+            alternatives,
+            canonical_bytes: canonical_bytes.into_boxed_slice(),
+            digest,
+        };
+        validate_bond_nums_domains(&policy)?;
+        Ok(Arc::new(policy))
+    }
+
+    /// Returns the network bound by every connector.
+    pub const fn network(&self) -> Network {
+        self.network
+    }
+
+    /// Returns the exact graph authorization key.
+    pub const fn graph_pubkey(&self) -> XOnlyPublicKey {
+        self.graph_pubkey
+    }
+
+    /// Returns the complete threshold registry.
+    pub const fn registry(&self) -> &Arc<ThresholdV3KeyRegistry> {
+        &self.registry
+    }
+
+    /// Returns alternatives in canonical order.
+    pub fn alternatives(&self) -> &[ThresholdV3BondAlternativePolicy] {
+        &self.alternatives
+    }
+
+    /// Returns canonical P0 bytes.
+    pub fn canonical_bytes(&self) -> &[u8] {
+        &self.canonical_bytes
+    }
+
+    /// Returns the content-derived P0 digest.
+    pub const fn digest(&self) -> ThresholdV3BondPolicyDigest {
+        self.digest
+    }
+
+    /// Returns one exact static commitment for its predecessor bond leaf.
+    pub fn static_alternative_commitment(
+        &self,
+        index: usize,
+    ) -> Result<ThresholdV3AlternativeCommitment, ThresholdV3BondPolicyError> {
+        if index >= self.alternatives.len() {
+            return Err(ThresholdV3BondPolicyError::AlternativeIndexOutOfRange {
+                index,
+                count: self.alternatives.len(),
+            });
+        }
+        let index =
+            u32::try_from(index).map_err(|_| ThresholdV3BondPolicyError::EncodingLengthOverflow)?;
+        let mut input = [0u8; 36];
+        input[..32].copy_from_slice(&self.digest.0);
+        input[32..].copy_from_slice(&index.to_be_bytes());
+        Ok(ThresholdV3AlternativeCommitment(
+            ThresholdAlternativeV3Hash::hash(&input).to_byte_array(),
+        ))
+    }
+
+    /// Constructs the corresponding bond connector.
+    pub fn bond_connector(
+        &self,
+        index: usize,
+    ) -> Result<CounterproofBondConnectorV3, ThresholdV3BondPolicyError> {
+        Ok(CounterproofBondConnectorV3::from_policy(self, index)?)
+    }
+
+    /// This research policy never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
