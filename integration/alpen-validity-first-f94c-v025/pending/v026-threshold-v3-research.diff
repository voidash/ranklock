+fn build_spend_matrix(count: usize) -> Vec<V026ThresholdSpendMatrixEntryV3> {
+    let mut owner_and_counterproofs = vec![V026ThresholdSpenderRoleV3::OwnerPayout];
+    owner_and_counterproofs.extend((0..count).map(V026ThresholdSpenderRoleV3::Counterproof));
+    let mut owner_timeouts_slashes = vec![V026ThresholdSpenderRoleV3::OwnerPayout];
+    owner_timeouts_slashes.extend((0..count).map(V026ThresholdSpenderRoleV3::Timeout));
+    owner_timeouts_slashes.extend((0..count).map(V026ThresholdSpenderRoleV3::Slash));
+    let mut entries = vec![
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::ClaimContest,
+            spenders: vec![V026ThresholdSpenderRoleV3::Contest],
+        },
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::Deposit,
+            spenders: owner_and_counterproofs.clone(),
+        },
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::ClaimPayout,
+            spenders: vec![V026ThresholdSpenderRoleV3::OwnerPayout],
+        },
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::ContestPayout,
+            spenders: owner_and_counterproofs.clone(),
+        },
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::ContestSlash,
+            spenders: owner_timeouts_slashes,
+        },
+        V026ThresholdSpendMatrixEntryV3 {
+            output: V026ThresholdOutputRoleV3::Stake,
+            spenders: (0..count).map(V026ThresholdSpenderRoleV3::Slash).collect(),
+        },
+    ];
+    for index in 0..count {
+        entries.extend([
+            V026ThresholdSpendMatrixEntryV3 {
+                output: V026ThresholdOutputRoleV3::CounterproofFunding(index),
+                spenders: owner_and_counterproofs.clone(),
+            },
+            V026ThresholdSpendMatrixEntryV3 {
+                output: V026ThresholdOutputRoleV3::BondFunding(index),
+                spenders: owner_and_counterproofs.clone(),
+            },
+            V026ThresholdSpendMatrixEntryV3 {
+                output: V026ThresholdOutputRoleV3::Resolution(index),
+                spenders: vec![
+                    V026ThresholdSpenderRoleV3::Ack(index),
+                    V026ThresholdSpenderRoleV3::Timeout(index),
+                ],
+            },
+            V026ThresholdSpendMatrixEntryV3 {
+                output: V026ThresholdOutputRoleV3::SlashAuthorization(index),
+                spenders: vec![V026ThresholdSpenderRoleV3::Slash(index)],
+            },
+        ]);
+    }
+    entries
+}
+
+fn build_role_outpoints(
+    external: [OutPoint; 4],
+    funded_setup: &ThresholdV3FundedSetupP1,
+    contest: &ContestV2Tx,
+    alternatives: &[V026ThresholdAlternativeGraphV3],
+) -> Result<Vec<V026ThresholdRoleOutpointV3>, V026ThresholdGraphV3Error> {
+    let [claim, deposit, claim_payout, stake] = external;
+    let contest_txid = contest.as_ref().compute_txid();
+    let mut entries = vec![
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::ClaimContest,
+            outpoint: claim,
+        },
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::Deposit,
+            outpoint: deposit,
+        },
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::ClaimPayout,
+            outpoint: claim_payout,
+        },
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::Stake,
+            outpoint: stake,
+        },
+    ];
+    entries.extend(
+        funded_setup
+            .bond_funding()
+            .iter()
+            .enumerate()
+            .map(|(index, funding)| V026ThresholdRoleOutpointV3 {
+                role: V026ThresholdOutputRoleV3::BondFunding(index),
+                outpoint: funding.outpoint(),
+            }),
+    );
+    entries.extend([
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::ContestPayout,
+            outpoint: OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT),
+        },
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::ContestSlash,
+            outpoint: OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT),
+        },
+    ]);
+    entries.extend(funded_setup.counterproof_funding().iter().enumerate().map(
+        |(index, funding)| V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::CounterproofFunding(index),
+            outpoint: funding.outpoint(),
+        },
+    ));
+    entries.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::Resolution(index),
+            outpoint: alternative.counterproof.resolution_outpoint(),
+        }
+    }));
+    entries.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        V026ThresholdRoleOutpointV3 {
+            role: V026ThresholdOutputRoleV3::SlashAuthorization(index),
+            outpoint: OutPoint::new(
+                alternative.branches.ack().as_ref().compute_txid(),
+                crate::transactions::prelude::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+            ),
+        }
+    }));
+
+    for index in 0..entries.len() {
+        if entries[index].outpoint == OutPoint::null() {
+            return Err(V026ThresholdGraphV3Error::NullRoleOutpoint {
+                role: entries[index].role,
+            });
+        }
+        if let Some(first) = entries[..index]
+            .iter()
+            .find(|earlier| earlier.outpoint == entries[index].outpoint)
+        {
+            return Err(V026ThresholdGraphV3Error::RoleOutpointAlias {
+                first: first.role,
+                second: entries[index].role,
+                outpoint: entries[index].outpoint,
+            });
+        }
+    }
+    Ok(entries)
+}
+
+fn verify_matrix_against_serialized_inputs(
+    role_outpoints: &[V026ThresholdRoleOutpointV3],
+    matrix: &[V026ThresholdSpendMatrixEntryV3],
+    contest: &ContestV2Tx,
+    owner: &OwnerPayoutThresholdV3Tx,
+    alternatives: &[V026ThresholdAlternativeGraphV3],
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let mut transactions = vec![
+        (V026ThresholdSpenderRoleV3::Contest, contest.as_ref()),
+        (V026ThresholdSpenderRoleV3::OwnerPayout, owner.as_ref()),
+    ];
+    transactions.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        (
+            V026ThresholdSpenderRoleV3::Counterproof(index),
+            alternative.counterproof.as_ref(),
+        )
+    }));
+    transactions.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        (
+            V026ThresholdSpenderRoleV3::Ack(index),
+            alternative.branches.ack().as_ref(),
+        )
+    }));
+    transactions.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        (
+            V026ThresholdSpenderRoleV3::Timeout(index),
+            alternative.branches.timeout().as_ref(),
+        )
+    }));
+    transactions.extend(alternatives.iter().enumerate().map(|(index, alternative)| {
+        (
+            V026ThresholdSpenderRoleV3::Slash(index),
+            alternative.slash.as_ref(),
+        )
+    }));
+
+    for (spender, transaction) in &transactions {
+        for (input_index, input) in transaction.input.iter().enumerate() {
+            if !role_outpoints
+                .iter()
+                .any(|entry| entry.outpoint == input.previous_output)
+            {
+                return Err(V026ThresholdGraphV3Error::UnregisteredSerializedInput {
+                    spender: *spender,
+                    input_index,
+                    outpoint: input.previous_output,
+                });
+            }
+            if transaction
+                .input
+                .iter()
+                .filter(|candidate| candidate.previous_output == input.previous_output)
+                .count()
+                != 1
+            {
+                return Err(V026ThresholdGraphV3Error::DuplicateSerializedInput {
+                    spender: *spender,
+                    outpoint: input.previous_output,
+                });
+            }
+        }
+    }
+
+    if matrix.len() != role_outpoints.len() {
+        return Err(V026ThresholdGraphV3Error::SpendMatrixRoleCountMismatch {
+            registry: role_outpoints.len(),
+            matrix: matrix.len(),
+        });
+    }
+    for entry in role_outpoints {
+        let matching = matrix
+            .iter()
+            .filter(|candidate| candidate.output == entry.role)
+            .collect::<Vec<_>>();
+        if matching.len() != 1 {
+            return Err(V026ThresholdGraphV3Error::SpendMatrixRoleMultiplicity {
+                role: entry.role,
+                count: matching.len(),
+            });
+        }
+        let actual = transactions
+            .iter()
+            .filter(|(_, transaction)| {
+                transaction
+                    .input
+                    .iter()
+                    .any(|input| input.previous_output == entry.outpoint)
+            })
+            .map(|(spender, _)| *spender)
+            .collect::<Vec<_>>();
+        if matching[0].spenders.as_slice() != actual.as_slice() {
+            return Err(V026ThresholdGraphV3Error::SpendMatrixSerializedMismatch {
+                role: entry.role,
+                declared: matching[0].spenders.clone(),
+                actual,
+            });
+        }
+    }
+    Ok(())
+}
+
+fn build_manifest(
+    contest: &ContestV2Tx,
+    owner: &OwnerPayoutThresholdV3Tx,
+    alternatives: &[V026ThresholdAlternativeGraphV3],
+) -> V026ThresholdGraphManifestV3 {
+    let contest_txid = contest.as_ref().compute_txid();
+    let alternatives = alternatives
+        .iter()
+        .map(|alternative| {
+            let counterproof_txid = alternative.counterproof.as_ref().compute_txid();
+            let ack_txid = alternative.branches.ack().as_ref().compute_txid();
+            V026ThresholdAlternativeManifestV3 {
+                counterproof_txid,
+                resolution_outpoint: OutPoint::new(
+                    counterproof_txid,
+                    CounterproofThresholdV3Tx::RESOLUTION_VOUT,
+                ),
+                ack_txid,
+                timeout_txid: alternative.branches.timeout().as_ref().compute_txid(),
+                slash_authorization_outpoint: OutPoint::new(
+                    ack_txid,
+                    crate::transactions::prelude::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+                ),
+                slash_txid: alternative.slash.as_ref().compute_txid(),
+            }
+        })
+        .collect::<Vec<_>>()
+        .into_boxed_slice();
+    V026ThresholdGraphManifestV3 {
+        contest_txid,
+        contest_payout_outpoint: OutPoint::new(contest_txid, ContestV2Tx::PAYOUT_GATE_VOUT),
+        contest_slash_outpoint: OutPoint::new(contest_txid, ContestV2Tx::SLASH_GATE_VOUT),
+        owner_payout_txid: owner.as_ref().compute_txid(),
+        alternatives,
+    }
+}
+
+fn verify_inputs<I>(
+    template: &'static str,
+    index: Option<usize>,
+    transaction: &Transaction,
+    expected: I,
+) -> Result<(), V026ThresholdGraphV3Error>
+where
+    I: IntoIterator<Item = OutPoint>,
+{
+    let expected = expected.into_iter().collect::<Vec<_>>();
+    if transaction.input.len() != expected.len() {
+        return Err(V026ThresholdGraphV3Error::InputCountMismatch {
+            template,
+            index,
+            expected: expected.len(),
+            actual: transaction.input.len(),
+        });
+    }
+    for (input_index, outpoint) in expected.into_iter().enumerate() {
+        verify_input(template, index, transaction, input_index, outpoint)?;
+    }
+    Ok(())
+}
+
+fn verify_input(
+    template: &'static str,
+    index: Option<usize>,
+    transaction: &Transaction,
+    input: usize,
+    expected: OutPoint,
+) -> Result<(), V026ThresholdGraphV3Error> {
+    let actual = transaction
+        .input
+        .get(input)
+        .map(|txin| txin.previous_output);
+    if actual != Some(expected) {
+        return Err(V026ThresholdGraphV3Error::InputOutpointMismatch {
+            template,
+            index,
+            input,
+            expected,
+            actual,
+        });
+    }
+    Ok(())
+}
