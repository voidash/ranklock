+
+    fn valid_witness_parts() -> V026PersistedAckWitnessPartsV3 {
+        let manifest = valid_manifest();
+        let selected = &manifest.alternatives[0];
+        let mut subject = V026ThresholdAckSubjectV3 {
+            selected_commitment: selected.selected_commitment,
+            graph_pubkey: manifest.graph_pubkey,
+            participant_count: manifest.participant_count,
+            threshold: manifest.threshold,
+            release_pubkeys: selected.release_pubkeys.clone(),
+            resolution_outpoint: selected.resolution_outpoint,
+            resolution_tx_out: selected.resolution_tx_out.clone(),
+            ack_txid: selected.ack_txid,
+            ack_sighash: selected.ack_sighash,
+        };
+        let script = ack_script(&subject).expect("valid subject script");
+        let internal_key = XOnlyPublicKey::from_slice(&key(30)).expect("fixture internal key");
+        let spend_info = TaprootBuilder::new()
+            .add_leaf(0, script.clone())
+            .expect("one valid leaf")
+            .finalize(secp256k1::SECP256K1, internal_key)
+            .expect("complete fixture tree");
+        let control = spend_info
+            .control_block(&(script.clone(), LeafVersion::TapScript))
+            .expect("fixture leaf is in tree");
+        let resolution_tx_out = TxOut {
+            value: Amount::from_sat(10_000),
+            script_pubkey: ScriptBuf::new_p2tr_tweaked(spend_info.output_key()),
+        };
+        let mut transaction = Transaction {
+            version: Version::TWO,
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: subject.resolution_outpoint,
+                script_sig: ScriptBuf::new(),
+                sequence: Sequence::MAX,
+                witness: Witness::default(),
+            }],
+            output: vec![TxOut {
+                value: Amount::from_sat(9_000),
+                script_pubkey: ScriptBuf::new_p2tr(
+                    secp256k1::SECP256K1,
+                    XOnlyPublicKey::from_slice(&key(31)).expect("fixture output key"),
+                    None,
+                ),
+            }],
+        };
+        let sighash = SighashCache::new(&transaction)
+            .taproot_script_spend_signature_hash(
+                0,
+                &Prevouts::All(std::slice::from_ref(&resolution_tx_out)),
+                TapLeafHash::from_script(&script, control.leaf_version),
+                TapSighashType::Default,
+            )
+            .expect("fixture sighash");
+        let message = Message::from_digest(sighash.to_byte_array());
+        let release_signature = keypair(4).sign_schnorr(message);
+        let graph_signature = keypair(1).sign_schnorr(message);
+        let mut witness = Witness::new();
+        witness.push([]);
+        witness.push(release_signature.serialize());
+        witness.push(graph_signature.serialize());
+        witness.push(script.as_bytes());
+        witness.push(control.serialize());
+        transaction.input[0].witness = witness;
+
+        let ack_txid = transaction.compute_txid();
+        subject.resolution_tx_out = resolution_tx_out;
+        subject.ack_txid = ack_txid;
+        subject.ack_sighash = sighash.to_byte_array();
+        V026PersistedAckWitnessPartsV3 {
+            subject,
+            wtxid: transaction.compute_wtxid(),
+            participant_bitmap: 1,
+            selected_release_signatures: vec![V026IndexedReleaseSignatureBytesV3 {
+                participant_index: 0,
+                signature: release_signature.serialize(),
+            }],
+            graph_signature: graph_signature.serialize(),
+            finalized_ack: consensus::serialize(&transaction),
+        }
+    }
+
+    #[test]
+    fn blocker_codes_are_append_only_and_exact() {
+        assert_eq!(V026_BLOCKERS_V3.len(), 17);
+        for (index, blocker) in V026_BLOCKERS_V3.iter().copied().enumerate() {
+            assert_eq!(blocker as usize, index + 1);
+            assert_eq!(V026BlockerCodeV3::try_from((index + 1) as u16), Ok(blocker));
+        }
+        assert!(matches!(
+            V026BlockerCodeV3::try_from(18),
+            Err(UnknownV026BlockerCodeV3 { code: 18 })
+        ));
+        assert_eq!(
+            V026BlockerCodeV3::ThresholdAckWitnessAdoptionUnimplemented as u16,
+            17
+        );
+    }
+
+    #[test]
