+                baseline.deposit.internal_key(),
+                OwnerPayoutThresholdV3KeyDomain::DepositInternal,
+            ),
+            (
+                "deposit output",
+                baseline
+                    .deposit
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+                OwnerPayoutThresholdV3KeyDomain::DepositOutput,
+            ),
+            (
+                "claim payout internal",
+                baseline.claim.internal_key(),
+                OwnerPayoutThresholdV3KeyDomain::ClaimPayoutInternal,
+            ),
+            (
+                "contest payout internal",
+                baseline.payout.internal_key(),
+                OwnerPayoutThresholdV3KeyDomain::ContestPayoutNumsInternal,
+            ),
+            (
+                "contest payout output",
+                baseline
+                    .payout
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+                OwnerPayoutThresholdV3KeyDomain::ContestPayoutNumsOutput,
+            ),
+            (
+                "contest Slash internal",
+                baseline.slash.internal_key(),
+                OwnerPayoutThresholdV3KeyDomain::ContestSlashNumsInternal,
+            ),
+            (
+                "contest Slash output",
+                baseline
+                    .slash
+                    .spend_info()
+                    .output_key()
+                    .to_x_only_public_key(),
+                OwnerPayoutThresholdV3KeyDomain::ContestSlashNumsOutput,
+            ),
+        ];
+
+        for (label, admin_pubkey, expected_first) in cases {
+            let mut aliased = fixture(true);
+            aliased.claim = ClaimPayoutConnector::new(
+                bitcoin::Network::Regtest,
+                aliased.claim.internal_key(),
+                vec![admin_pubkey],
+                aliased.claim.admin_threshold(),
+                aliased.claim.unstaking_image(),
+            );
+            match transaction(&aliased) {
+                Err(OwnerPayoutThresholdV3Error::KeyDomainAlias { first, second }) => {
+                    assert_eq!(first, expected_first, "wrong first domain for {label}");
+                    assert_eq!(
+                        second,
+                        OwnerPayoutThresholdV3KeyDomain::ClaimPayoutAdmin { admin: 0 },
+                        "wrong admin domain for {label}"
+                    );
+                }
+                result => panic!("{label} admin alias did not fail closed: {result:?}"),
+            }
+        }
+    }
+}
