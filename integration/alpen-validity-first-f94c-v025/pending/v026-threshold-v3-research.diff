+        assert_eq!(ack.as_ref().output[0].value, REFUND_VALUE);
+        assert_eq!(ack.as_ref().output[1].value, AUTHORIZATION_VALUE);
+        assert_eq!(ack.as_ref().output[2].value, ANCHOR_VALUE);
+        assert_eq!(ack.cpfp_outpoint().vout, 2);
+        assert!(!ack.funding_eligible());
+
+        let (graph_signature, mut candidates) = fixture.signatures(&ack);
+        let expected_sighash = ack.signing_info()[0].sighash;
+        let expected_outpoint = ack.as_ref().input[0].previous_output;
+        candidates.reverse();
+        let finalized = ack.finalize(candidates, graph_signature).unwrap();
+        assert_eq!(
+            finalized.publication().participant_bitmap(),
+            &[true, true, false]
+        );
+        assert_eq!(
+            finalized
+                .publication()
+                .selected_release_signatures()
+                .iter()
+                .map(IndexedReleaseSignatureV3::participant_index)
+                .collect::<Vec<_>>(),
+            vec![0, 1]
+        );
+        assert_eq!(
+            finalized.publication().txid(),
+            finalized.transaction().compute_txid()
+        );
+        assert_eq!(
+            finalized.publication().wtxid(),
+            finalized.transaction().compute_wtxid()
+        );
+        assert_eq!(
+            finalized.publication().resolution_outpoint(),
+            expected_outpoint
+        );
+        assert_eq!(finalized.publication().alternative().index(), 0);
+        assert_eq!(
+            finalized.publication().fault_profile().participant_count(),
+            3
+        );
+        assert_eq!(finalized.publication().fault_profile().threshold(), 2);
+        assert_eq!(finalized.publication().fault_profile().max_corrupt(), 1);
+        assert_eq!(
+            finalized.publication().release_pubkeys(),
+            fixture.resolution.release_pubkeys()
+        );
+        assert_eq!(finalized.publication().exact_sighash(), expected_sighash);
+        assert_eq!(
+            finalized.publication().witness(),
+            &finalized.transaction().input[0].witness
+        );
+        assert_eq!(
+            finalized
+                .transaction()
+                .output
+                .iter()
+                .map(|output| output.value)
+                .sum::<Amount>()
+                + FEE,
+            RESOLUTION_VALUE
+        );
+        assert!(!finalized.transaction().input[0].witness.is_empty());
+    }
