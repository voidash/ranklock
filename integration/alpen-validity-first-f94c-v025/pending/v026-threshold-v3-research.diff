+/// Crate-private variable-length signature representation.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct V026IndexedReleaseSignatureBodyV3 {
+    participant_index: u16,
+    signature: Vec<u8>,
+}
+
+/// Canonical postcard body. Field order is the frozen V3 row layout.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct V026AckWitnessBodyV3 {
+    subject: V026AckSubjectBodyV3,
+    wtxid: Wtxid,
+    participant_bitmap: u64,
+    selected_release_signatures: Vec<V026IndexedReleaseSignatureBodyV3>,
+    graph_signature: Vec<u8>,
+    finalized_ack: Vec<u8>,
+}
+
+impl V026AckWitnessBodyV3 {
+    fn from_persisted(selection: &PersistedThresholdAckWitnessSelectionV3) -> Self {
+        Self {
+            subject: selection.subject().into(),
+            wtxid: selection.wtxid(),
+            participant_bitmap: selection.participant_bitmap(),
+            selected_release_signatures: selection
+                .selected_release_signatures()
+                .iter()
+                .map(|selected| V026IndexedReleaseSignatureBodyV3 {
+                    participant_index: selected.participant_index,
+                    signature: selected.signature.to_vec(),
+                })
+                .collect(),
+            graph_signature: selection.graph_signature().to_vec(),
+            finalized_ack: selection.finalized_ack().to_vec(),
+        }
+    }
+
+    fn try_into_persisted(
+        self,
+    ) -> Result<PersistedThresholdAckWitnessSelectionV3, V026AckWitnessBodyErrorV3> {
+        let selected_release_signatures = self
+            .selected_release_signatures
+            .into_iter()
+            .enumerate()
+            .map(|(position, selected)| {
+                let actual = selected.signature.len();
+                let signature = selected.signature.try_into().map_err(|_bytes| {
+                    V026AckWitnessBodyErrorV3::ReleaseSignatureLength { position, actual }
+                })?;
+                Ok(V026IndexedReleaseSignatureBytesV3 {
+                    participant_index: selected.participant_index,
+                    signature,
+                })
+            })
+            .collect::<Result<Vec<_>, V026AckWitnessBodyErrorV3>>()?;
+        let graph_signature_length = self.graph_signature.len();
+        let graph_signature = self.graph_signature.try_into().map_err(|_bytes| {
+            V026AckWitnessBodyErrorV3::GraphSignatureLength {
+                actual: graph_signature_length,
+            }
+        })?;
+        PersistedThresholdAckWitnessSelectionV3::try_from_parts(V026PersistedAckWitnessPartsV3 {
+            subject: self.subject.into(),
+            wtxid: self.wtxid,
+            participant_bitmap: self.participant_bitmap,
+            selected_release_signatures,
+            graph_signature,
+            finalized_ack: self.finalized_ack,
+        })
+        .map_err(V026AckWitnessBodyErrorV3::InvalidRecord)
+    }
+}
