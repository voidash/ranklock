+    #[test]
+    fn timeout_leaf_after_commitment_prefix_matches_v2_and_roster_order_is_bound() {
+        let signer = ThresholdSigner::generate();
+        let graph = signer.graph_keypair.x_only_public_key().0;
+        let releases: Vec<_> = signer
+            .release_keypairs
+            .iter()
+            .map(|keypair| keypair.x_only_public_key().0)
+            .collect();
+        let threshold = connector(graph, releases.clone(), 2, 0).unwrap();
+        let reordered =
+            connector(graph, vec![releases[1], releases[0], releases[2]], 2, 0).unwrap();
+        let legacy = CounterproofResolutionConnectorV2::new(
+            Network::Regtest,
+            graph,
+            vec![[1u8; 32], [2u8; 32]],
+            TIMEOUT,
+            CONNECTOR_VALUE,
