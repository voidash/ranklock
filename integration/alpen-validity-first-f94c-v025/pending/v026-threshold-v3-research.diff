+/// Complete local structural manifest bound into a V3 observation.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct V026ThresholdObservationManifestV3 {
+    /// Static P0 policy digest.
+    pub policy_digest: [u8; 32],
+    /// Exact funded P1 digest.
+    pub funded_setup_digest: [u8; 32],
+    /// Graph authorization key.
+    pub graph_pubkey: [u8; 32],
+    /// Participant identity keys in canonical registry order.
+    pub participant_identity_pubkeys: Vec<[u8; 32]>,
+    /// Exact threshold participant count.
+    pub participant_count: u16,
+    /// Exact release threshold.
+    pub threshold: u16,
+    /// Maximum corruption assumption.
+    pub max_corrupt: u16,
+    /// Complete role-to-outpoint registry in graph order.
+    pub role_outpoints: Vec<V026ThresholdRoleOutpointManifestV3>,
+    /// Exact Contest transaction ID.
+    pub contest_txid: Txid,
+    /// Exact atomic owner transaction ID.
+    pub owner_payout_txid: Txid,
+    /// Alternatives in exact P0 order.
+    pub alternatives: Vec<V026ThresholdAlternativeObservationV3>,
+}
+
+impl V026ThresholdObservationManifestV3 {
+    fn from_graph(graph: &V026ThresholdGraphV3) -> Result<Self, V026ObservationErrorV3> {
+        let policy = graph.funded_setup().policy();
+        let profile = policy.registry().fault_profile();
+        let participant_count = u16::try_from(profile.participant_count())
+            .map_err(|_| V026ObservationErrorV3::IntegerConversion("participant count"))?;
+        let threshold = u16::try_from(profile.threshold())
+            .map_err(|_| V026ObservationErrorV3::IntegerConversion("threshold"))?;
+        let max_corrupt = u16::try_from(profile.max_corrupt())
+            .map_err(|_| V026ObservationErrorV3::IntegerConversion("max corrupt"))?;
+        let role_outpoints = graph
+            .role_outpoints()
+            .iter()
+            .map(|entry| {
+                Ok(V026ThresholdRoleOutpointManifestV3 {
+                    role: role_code(entry.role)?,
+                    outpoint: entry.outpoint,
+                })
+            })
+            .collect::<Result<Vec<_>, V026ObservationErrorV3>>()?;
+        let alternatives = graph
+            .alternatives()
+            .iter()
+            .map(|alternative| {
+                let selected = alternative.selected();
+                let counterproof = alternative.counterproof();
+                let branches = alternative.resolution_branches();
+                let resolution_tx_out = counterproof
+                    .as_ref()
+                    .output
+                    .get(CounterproofThresholdV3Tx::RESOLUTION_VOUT as usize)
+                    .cloned()
+                    .ok_or(V026ObservationErrorV3::MissingResolutionOutput {
+                        alternative: selected.index(),
+                    })?;
+                let ack_signing = branches.ack().signing_info()[0];
+                Ok(V026ThresholdAlternativeObservationV3 {
+                    selected_commitment: selected.selected_commitment().to_byte_array(),
+                    counterproof_txid: counterproof.as_ref().compute_txid(),
+                    resolution_outpoint: branches.resolution_outpoint(),
+                    resolution_tx_out,
+                    ack_txid: branches.ack().as_ref().compute_txid(),
+                    ack_sighash: *ack_signing.sighash.as_ref(),
+                    timeout_txid: branches.timeout().as_ref().compute_txid(),
+                    slash_authorization_outpoint: OutPoint::new(
+                        branches.ack().as_ref().compute_txid(),
+                        strata_bridge_tx_graph::transactions::counterproof_ack_threshold_v3::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+                    ),
+                    slash_txid: alternative.slash().as_ref().compute_txid(),
+                    release_pubkeys: selected
+                        .release_pubkeys()
+                        .into_iter()
+                        .map(|key| key.serialize())
+                        .collect(),
+                })
+            })
+            .collect::<Result<Vec<_>, V026ObservationErrorV3>>()?;
+        Ok(Self {
+            policy_digest: policy.digest().to_byte_array(),
+            funded_setup_digest: graph.funded_setup().digest().to_byte_array(),
+            graph_pubkey: policy.graph_pubkey().serialize(),
+            participant_identity_pubkeys: policy
+                .registry()
+                .participants()
+                .iter()
+                .map(|participant| participant.identity_pubkey().serialize())
+                .collect(),
+            participant_count,
+            threshold,
+            max_corrupt,
+            role_outpoints,
+            contest_txid: graph.structural_manifest().contest_txid,
+            owner_payout_txid: graph.structural_manifest().owner_payout_txid,
+            alternatives,
+        })
+    }
+}
