diff --git a/crates/connectors/src/threshold_registry_v3.rs b/crates/connectors/src/threshold_registry_v3.rs
new file mode 100644
index 00000000..75ea5bf2
--- /dev/null
+++ b/crates/connectors/src/threshold_registry_v3.rs
@@ -0,0 +1,1374 @@
+//! Canonical participant and release-key registry for threshold research v3.
+//!
+//! This registry is predecessor-only input to transaction construction.  It
+//! binds one setup, one static `n/t/f` fault profile, and the complete ordered
+//! participant-by-alternative release-key matrix.  It deliberately does not
+//! contain transaction ids, sighashes, PositiveLocks, or descendant graph
+//! digests, so consuming the registry cannot introduce a transaction cycle.
+
+use std::{error::Error, fmt};
+
+use bitcoin::hashes::{sha256t_hash_newtype, Hash};
+use secp256k1::{schnorr, Message, XOnlyPublicKey, SECP256K1};
+
+use crate::counterproof_resolution_threshold_v3::ThresholdReleaseFaultProfileV3;
+
+sha256t_hash_newtype! {
+    struct ThresholdRegistryV3Tag = hash_str("RankLock/v026/threshold-v3/key-registry/v1");
+
+    struct ThresholdRegistryV3Hash(_);
+}
+
+sha256t_hash_newtype! {
+    struct ThresholdParticipantContributionV3Tag = hash_str("RankLock/v026/threshold-v3/participant-contribution/v1");
+
+    struct ThresholdParticipantContributionV3Hash(_);
+}
+
+const REGISTRY_MAGIC: [u8; 8] = *b"RL26TKR3";
+const REGISTRY_SCHEMA_VERSION: u16 = 1;
+const CONTRIBUTION_MAGIC: [u8; 8] = *b"RL26TPC3";
+const CONTRIBUTION_SCHEMA_VERSION: u16 = 1;
+const PROTOCOL_VERSION: u16 = 26;
+/// Minimum number of counterproof alternatives in the admitted threshold-v3 profile.
+pub const MIN_THRESHOLD_V3_ALTERNATIVES: usize = 2;
+/// Maximum number of counterproof alternatives in the admitted threshold-v3 profile.
+pub const MAX_THRESHOLD_V3_ALTERNATIVES: usize = 4;
+/// Maximum participant-by-alternative release-key cells admitted by threshold v3.
+///
+/// This is a measured SP1 resource bound, not merely a serialization bound.  The
+/// subject-bound guest verifies every cell and its worst admitted frontier must
+/// remain below the reserved-network cycle limit.
+pub const MAX_THRESHOLD_V3_RELEASE_CELLS: usize = 64;
+
+/// One setup participant and its independently generated per-alternative keys.
+#[derive(Debug, Clone)]
+pub struct ThresholdV3ParticipantIdentity {
+    participant_index: usize,
+    identity_pubkey: XOnlyPublicKey,
+    control_domain_digest: [u8; 32],
+    contribution_digest: [u8; 32],
+    contribution_signature: schnorr::Signature,
+    release_pubkeys: Box<[XOnlyPublicKey]>,
+}
+
+impl PartialEq for ThresholdV3ParticipantIdentity {
+    fn eq(&self, other: &Self) -> bool {
+        self.participant_index == other.participant_index
+            && self.identity_pubkey == other.identity_pubkey
+            && self.control_domain_digest == other.control_domain_digest
+            && self.contribution_digest == other.contribution_digest
+            && self.release_pubkeys == other.release_pubkeys
+    }
+}
+
+impl Eq for ThresholdV3ParticipantIdentity {}
+
+impl std::hash::Hash for ThresholdV3ParticipantIdentity {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        std::hash::Hash::hash(&self.participant_index, state);
+        std::hash::Hash::hash(&self.identity_pubkey, state);
+        std::hash::Hash::hash(&self.control_domain_digest, state);
+        std::hash::Hash::hash(&self.contribution_digest, state);
+        std::hash::Hash::hash(&self.release_pubkeys, state);
+    }
+}
+
+impl ThresholdV3ParticipantIdentity {
+    /// Constructs one immutable preliminary-contribution registry row.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        setup_intent_digest: [u8; 32],
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        alternative_count: usize,
+        participant_index: usize,
+        identity_pubkey: XOnlyPublicKey,
+        control_domain_digest: [u8; 32],
+        release_pubkeys: Vec<XOnlyPublicKey>,
+        contribution_signature: schnorr::Signature,
+    ) -> Result<Self, ThresholdV3ParticipantIdentityError> {
+        let contribution_digest = Self::contribution_digest_for(
+            setup_intent_digest,
+            fault_profile,
+            alternative_count,
+            participant_index,
+            identity_pubkey,
+            control_domain_digest,
+            &release_pubkeys,
+        )?;
+        let message = Message::from_digest(contribution_digest);
+        SECP256K1
+            .verify_schnorr(&contribution_signature, &message, &identity_pubkey)
+            .map_err(|_| ThresholdV3ParticipantIdentityError::InvalidContributionSignature)?;
+        Ok(Self {
+            participant_index,
+            identity_pubkey,
+            control_domain_digest,
+            contribution_digest,
+            contribution_signature,
+            release_pubkeys: release_pubkeys.into_boxed_slice(),
+        })
+    }
+
+    /// Derives the exact message digest that the participant identity signs.
+    #[allow(clippy::too_many_arguments)]
+    pub fn contribution_digest_for(
+        setup_intent_digest: [u8; 32],
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        alternative_count: usize,
+        participant_index: usize,
+        identity_pubkey: XOnlyPublicKey,
+        control_domain_digest: [u8; 32],
+        release_pubkeys: &[XOnlyPublicKey],
+    ) -> Result<[u8; 32], ThresholdV3ParticipantIdentityError> {
+        if setup_intent_digest == [0; 32] {
+            return Err(ThresholdV3ParticipantIdentityError::ZeroSetupIntentDigest);
+        }
+        if control_domain_digest == [0; 32] {
+            return Err(ThresholdV3ParticipantIdentityError::ZeroControlDomainDigest);
+        }
+        if !(MIN_THRESHOLD_V3_ALTERNATIVES..=MAX_THRESHOLD_V3_ALTERNATIVES)
+            .contains(&alternative_count)
+        {
+            return Err(
+                ThresholdV3ParticipantIdentityError::InvalidAlternativeCount {
+                    actual: alternative_count,
+                },
+            );
+        }
+        validate_release_matrix_dimensions(alternative_count, fault_profile.participant_count())
+            .map_err(
+                |_| ThresholdV3ParticipantIdentityError::ReleaseMatrixTooLarge {
+                    alternatives: alternative_count,
+                    participants: fault_profile.participant_count(),
+                    max_cells: MAX_THRESHOLD_V3_RELEASE_CELLS,
+                },
+            )?;
+        if participant_index >= fault_profile.participant_count() {
+            return Err(
+                ThresholdV3ParticipantIdentityError::ParticipantIndexOutOfRange {
+                    index: participant_index,
+                    count: fault_profile.participant_count(),
+                },
+            );
+        }
+        if release_pubkeys.len() != alternative_count {
+            return Err(
+                ThresholdV3ParticipantIdentityError::ReleaseKeyCountMismatch {
+                    expected: alternative_count,
+                    actual: release_pubkeys.len(),
+                },
+            );
+        }
+        let encoded = encode_participant_contribution(
+            setup_intent_digest,
+            fault_profile,
+            alternative_count,
+            participant_index,
+            identity_pubkey,
+            control_domain_digest,
+            release_pubkeys,
+        )?;
+        Ok(ThresholdParticipantContributionV3Hash::hash(&encoded).to_byte_array())
+    }
+
+    /// Returns the canonical participant position covered by the signature.
+    pub const fn participant_index(&self) -> usize {
+        self.participant_index
+    }
+
+    /// Returns the participant's setup identity key.
+    pub const fn identity_pubkey(&self) -> XOnlyPublicKey {
+        self.identity_pubkey
+    }
+
+    /// Returns the setup-committed control-domain identity.
+    pub const fn control_domain_digest(&self) -> [u8; 32] {
+        self.control_domain_digest
+    }
+
+    /// Returns the signed preliminary-contribution digest.
+    pub const fn contribution_digest(&self) -> [u8; 32] {
+        self.contribution_digest
+    }
+
+    /// Returns the BIP340 signature authenticating the complete contribution row.
+    pub const fn contribution_signature(&self) -> schnorr::Signature {
+        self.contribution_signature
+    }
+
+    /// Returns release keys in exact alternative order.
+    pub fn release_pubkeys(&self) -> &[XOnlyPublicKey] {
+        &self.release_pubkeys
+    }
+}
+
+/// Invalid participant registry row.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum ThresholdV3ParticipantIdentityError {
+    /// Setup intent must not use the zero sentinel.
+    ZeroSetupIntentDigest,
+    /// A zero digest does not identify an independent control domain.
+    ZeroControlDomainDigest,
+    /// Alternative count is outside the bounded wire profile.
+    InvalidAlternativeCount {
+        /// Rejected count.
+        actual: usize,
+    },
+    /// The joint participant-by-alternative matrix exceeds the measured SP1 bound.
+    ReleaseMatrixTooLarge {
+        /// Ordered alternative count.
+        alternatives: usize,
+        /// Ordered participant count.
+        participants: usize,
+        /// Maximum admitted matrix cells.
+        max_cells: usize,
+    },
+    /// Participant position is outside the fault profile.
+    ParticipantIndexOutOfRange {
+        /// Rejected position.
+        index: usize,
+        /// Participant count.
+        count: usize,
+    },
+    /// Contribution row has the wrong release-key width.
+    ReleaseKeyCountMismatch {
+        /// Required width.
+        expected: usize,
+        /// Supplied width.
+        actual: usize,
+    },
+    /// Participant identity did not authenticate the exact contribution row.
+    InvalidContributionSignature,
+    /// Canonical contribution encoding length cannot be represented.
+    EncodingLengthOverflow,
+}
+
+impl fmt::Display for ThresholdV3ParticipantIdentityError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ZeroSetupIntentDigest => {
+                f.write_str("threshold participant setup-intent digest must be nonzero")
+            }
+            Self::ZeroControlDomainDigest => {
+                f.write_str("threshold participant control-domain digest must be nonzero")
+            }
+            Self::InvalidAlternativeCount { actual } => write!(
+                f,
+                "threshold participant alternative count {actual} is outside {MIN_THRESHOLD_V3_ALTERNATIVES}..={MAX_THRESHOLD_V3_ALTERNATIVES}"
+            ),
+            Self::ReleaseMatrixTooLarge {
+                alternatives,
+                participants,
+                max_cells,
+            } => write!(
+                f,
+                "threshold participant release matrix {alternatives}x{participants} exceeds {max_cells} admitted cells"
+            ),
+            Self::ParticipantIndexOutOfRange { index, count } => write!(
+                f,
+                "threshold participant index {index} is outside profile count {count}"
+            ),
+            Self::ReleaseKeyCountMismatch { expected, actual } => write!(
+                f,
+                "threshold participant contribution has {actual} release keys, expected {expected}"
+            ),
+            Self::InvalidContributionSignature => {
+                f.write_str("threshold participant contribution signature is invalid")
+            }
+            Self::EncodingLengthOverflow => {
+                f.write_str("threshold participant contribution encoding length overflowed")
+            }
+        }
+    }
+}
+
+impl Error for ThresholdV3ParticipantIdentityError {}
+
+/// Content-derived digest of the canonical threshold registry bytes.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct ThresholdV3RegistryDigest([u8; 32]);
+
+impl ThresholdV3RegistryDigest {
+    /// Returns the tagged SHA-256 digest bytes.
+    pub const fn to_byte_array(self) -> [u8; 32] {
+        self.0
+    }
+}
+
+/// Canonical setup, fault profile, identities, and per-alternative release keys.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3KeyRegistry {
+    setup_intent_digest: [u8; 32],
+    fault_profile: ThresholdReleaseFaultProfileV3,
+    alternative_count: usize,
+    participants: Box<[ThresholdV3ParticipantIdentity]>,
+    canonical_bytes: Box<[u8]>,
+    digest: ThresholdV3RegistryDigest,
+}
+
+impl ThresholdV3KeyRegistry {
+    /// Validates and canonically commits the complete release-key matrix.
+    pub fn new(
+        setup_intent_digest: [u8; 32],
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        alternative_count: usize,
+        participants: Vec<ThresholdV3ParticipantIdentity>,
+    ) -> Result<Self, ThresholdV3KeyRegistryError> {
+        if setup_intent_digest == [0; 32] {
+            return Err(ThresholdV3KeyRegistryError::ZeroSetupIntentDigest);
+        }
+        if !(MIN_THRESHOLD_V3_ALTERNATIVES..=MAX_THRESHOLD_V3_ALTERNATIVES)
+            .contains(&alternative_count)
+        {
+            return Err(ThresholdV3KeyRegistryError::InvalidAlternativeCount {
+                actual: alternative_count,
+            });
+        }
+        validate_release_matrix_dimensions(alternative_count, fault_profile.participant_count())?;
+        if participants.len() != fault_profile.participant_count() {
+            return Err(ThresholdV3KeyRegistryError::ParticipantCountMismatch {
+                profile: fault_profile.participant_count(),
+                actual: participants.len(),
+            });
+        }
+
+        for (participant_index, participant) in participants.iter().enumerate() {
+            if participant.participant_index != participant_index {
+                return Err(ThresholdV3KeyRegistryError::ParticipantIndexMismatch {
+                    expected: participant_index,
+                    actual: participant.participant_index,
+                });
+            }
+            if participant.release_pubkeys.len() != alternative_count {
+                return Err(ThresholdV3KeyRegistryError::ReleaseKeyCountMismatch {
+                    participant_index,
+                    expected: alternative_count,
+                    actual: participant.release_pubkeys.len(),
+                });
+            }
+            let expected_digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                setup_intent_digest,
+                fault_profile,
+                alternative_count,
+                participant_index,
+                participant.identity_pubkey,
+                participant.control_domain_digest,
+                &participant.release_pubkeys,
+            )
+            .map_err(
+                |error| ThresholdV3KeyRegistryError::ParticipantContribution {
+                    participant_index,
+                    error,
+                },
+            )?;
+            if participant.contribution_digest != expected_digest
+                || SECP256K1
+                    .verify_schnorr(
+                        &participant.contribution_signature,
+                        &Message::from_digest(expected_digest),
+                        &participant.identity_pubkey,
+                    )
+                    .is_err()
+            {
+                return Err(ThresholdV3KeyRegistryError::InvalidContributionSignature {
+                    participant_index,
+                });
+            }
+            if let Some(first_index) = participants[..participant_index]
+                .iter()
+                .position(|earlier| earlier.identity_pubkey == participant.identity_pubkey)
+            {
+                return Err(ThresholdV3KeyRegistryError::DuplicateIdentityKey {
+                    first_index,
+                    duplicate_index: participant_index,
+                });
+            }
+            if let Some(first_index) =
+                participants[..participant_index]
+                    .iter()
+                    .position(|earlier| {
+                        earlier.control_domain_digest == participant.control_domain_digest
+                    })
+            {
+                return Err(ThresholdV3KeyRegistryError::DuplicateControlDomainDigest {
+                    first_index,
+                    duplicate_index: participant_index,
+                });
+            }
+            if let Some(first_index) = participants[..participant_index]
+                .iter()
+                .position(|earlier| earlier.contribution_digest == participant.contribution_digest)
+            {
+                return Err(ThresholdV3KeyRegistryError::DuplicateContributionDigest {
+                    first_index,
+                    duplicate_index: participant_index,
+                });
+            }
+        }
+
+        let mut release_keys = Vec::with_capacity(participants.len() * alternative_count);
+        for (participant_index, participant) in participants.iter().enumerate() {
+            for (alternative_index, release_key) in
+                participant.release_pubkeys.iter().copied().enumerate()
+            {
+                if let Some(identity_index) = participants
+                    .iter()
+                    .position(|candidate| candidate.identity_pubkey == release_key)
+                {
+                    return Err(ThresholdV3KeyRegistryError::ReleaseIdentityKeyAlias {
+                        participant_index,
+                        alternative_index,
+                        identity_index,
+                    });
+                }
+                if let Some((first_participant, first_alternative, _)) = release_keys
+                    .iter()
+                    .find(|(_, _, earlier)| *earlier == release_key)
+                {
+                    return Err(ThresholdV3KeyRegistryError::DuplicateReleaseKey {
+                        first_participant: *first_participant,
+                        first_alternative: *first_alternative,
+                        duplicate_participant: participant_index,
+                        duplicate_alternative: alternative_index,
+                    });
+                }
+                release_keys.push((participant_index, alternative_index, release_key));
+            }
+        }
+
+        let participants = participants.into_boxed_slice();
+        let canonical_bytes = encode_registry(
+            setup_intent_digest,
+            fault_profile,
+            alternative_count,
+            &participants,
+        )?;
+        let digest = ThresholdV3RegistryDigest(
+            ThresholdRegistryV3Hash::hash(&canonical_bytes).to_byte_array(),
+        );
+        Ok(Self {
+            setup_intent_digest,
+            fault_profile,
+            alternative_count,
+            participants,
+            canonical_bytes: canonical_bytes.into_boxed_slice(),
+            digest,
+        })
+    }
+
+    /// Returns the exact setup-intent digest.
+    pub const fn setup_intent_digest(&self) -> [u8; 32] {
+        self.setup_intent_digest
+    }
+
+    /// Returns the validated static fault profile.
+    pub const fn fault_profile(&self) -> ThresholdReleaseFaultProfileV3 {
+        self.fault_profile
+    }
+
+    /// Returns the exact ordered alternative count.
+    pub const fn alternative_count(&self) -> usize {
+        self.alternative_count
+    }
+
+    /// Returns participants in canonical setup order.
+    pub fn participants(&self) -> &[ThresholdV3ParticipantIdentity] {
+        &self.participants
+    }
+
+    /// Returns one alternative's release keys in participant order.
+    pub fn release_pubkeys(
+        &self,
+        alternative_index: usize,
+    ) -> Result<Vec<XOnlyPublicKey>, ThresholdV3KeyRegistryError> {
+        if alternative_index >= self.alternative_count {
+            return Err(ThresholdV3KeyRegistryError::AlternativeIndexOutOfRange {
+                index: alternative_index,
+                count: self.alternative_count,
+            });
+        }
+        Ok(self
+            .participants
+            .iter()
+            .map(|participant| participant.release_pubkeys[alternative_index])
+            .collect())
+    }
+
+    /// Returns the exact canonical fixed-width registry bytes.
+    pub fn canonical_bytes(&self) -> &[u8] {
+        &self.canonical_bytes
+    }
+
+    /// Returns the content-derived tagged digest.
+    pub const fn digest(&self) -> ThresholdV3RegistryDigest {
+        self.digest
+    }
+
+    /// A research registry never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+/// Invalid threshold-v3 key registry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ThresholdV3KeyRegistryError {
+    /// The setup intent digest was all zeroes.
+    ZeroSetupIntentDigest,
+    /// Alternative count is outside the bounded research profile.
+    InvalidAlternativeCount {
+        /// Rejected count.
+        actual: usize,
+    },
+    /// The joint participant-by-alternative matrix exceeds the measured SP1 bound.
+    ReleaseMatrixTooLarge {
+        /// Ordered alternative count.
+        alternatives: usize,
+        /// Ordered participant count.
+        participants: usize,
+        /// Maximum admitted matrix cells.
+        max_cells: usize,
+    },
+    /// Participant roster length differs from the fault profile.
+    ParticipantCountMismatch {
+        /// Count committed by the fault profile.
+        profile: usize,
+        /// Supplied participant rows.
+        actual: usize,
+    },
+    /// Signed participant position differs from canonical roster order.
+    ParticipantIndexMismatch {
+        /// Canonical roster position.
+        expected: usize,
+        /// Position signed by the participant.
+        actual: usize,
+    },
+    /// One participant row does not contain exactly one key per alternative.
+    ReleaseKeyCountMismatch {
+        /// Participant position.
+        participant_index: usize,
+        /// Required key count.
+        expected: usize,
+        /// Supplied key count.
+        actual: usize,
+    },
+    /// A participant contribution could not be canonically re-derived.
+    ParticipantContribution {
+        /// Participant position.
+        participant_index: usize,
+        /// Underlying contribution error.
+        error: ThresholdV3ParticipantIdentityError,
+    },
+    /// A participant signature does not authenticate its exact row and setup context.
+    InvalidContributionSignature {
+        /// Participant position.
+        participant_index: usize,
+    },
+    /// Two participants use the same identity key.
+    DuplicateIdentityKey {
+        /// First position.
+        first_index: usize,
+        /// Duplicate position.
+        duplicate_index: usize,
+    },
+    /// Two rows claim the same control domain, collapsing the fault bound.
+    DuplicateControlDomainDigest {
+        /// First position.
+        first_index: usize,
+        /// Duplicate position.
+        duplicate_index: usize,
+    },
+    /// Two identities claim the same signed preliminary contribution.
+    DuplicateContributionDigest {
+        /// First position.
+        first_index: usize,
+        /// Duplicate position.
+        duplicate_index: usize,
+    },
+    /// A release key aliases an identity key.
+    ReleaseIdentityKeyAlias {
+        /// Release-key participant position.
+        participant_index: usize,
+        /// Release-key alternative position.
+        alternative_index: usize,
+        /// Aliased identity position.
+        identity_index: usize,
+    },
+    /// A release key is reused in another participant/alternative cell.
+    DuplicateReleaseKey {
+        /// First participant position.
+        first_participant: usize,
+        /// First alternative position.
+        first_alternative: usize,
+        /// Duplicate participant position.
+        duplicate_participant: usize,
+        /// Duplicate alternative position.
+        duplicate_alternative: usize,
+    },
+    /// An alternative lookup exceeded the committed roster.
+    AlternativeIndexOutOfRange {
+        /// Rejected index.
+        index: usize,
+        /// Committed alternative count.
+        count: usize,
+    },
+    /// Canonical encoded length cannot be represented as `u32`.
+    EncodedLengthOverflow,
+}
+
+impl fmt::Display for ThresholdV3KeyRegistryError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ZeroSetupIntentDigest => {
+                f.write_str("threshold registry setup-intent digest must be nonzero")
+            }
+            Self::InvalidAlternativeCount { actual } => write!(
+                f,
+                "threshold registry alternative count {actual} is outside {MIN_THRESHOLD_V3_ALTERNATIVES}..={MAX_THRESHOLD_V3_ALTERNATIVES}"
+            ),
+            Self::ReleaseMatrixTooLarge {
+                alternatives,
+                participants,
+                max_cells,
+            } => write!(
+                f,
+                "threshold registry release matrix {alternatives}x{participants} exceeds {max_cells} admitted cells"
+            ),
+            Self::ParticipantCountMismatch { profile, actual } => write!(
+                f,
+                "threshold registry profile commits {profile} participants, got {actual} rows"
+            ),
+            Self::ParticipantIndexMismatch { expected, actual } => write!(
+                f,
+                "threshold participant signed index {actual}, expected canonical position {expected}"
+            ),
+            Self::ReleaseKeyCountMismatch {
+                participant_index,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "threshold participant {participant_index} has {actual} release keys, expected {expected}"
+            ),
+            Self::ParticipantContribution {
+                participant_index,
+                error,
+            } => write!(
+                f,
+                "threshold participant {participant_index} contribution is invalid: {error}"
+            ),
+            Self::InvalidContributionSignature { participant_index } => write!(
+                f,
+                "threshold participant {participant_index} contribution signature is invalid"
+            ),
+            Self::DuplicateIdentityKey {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold identity key at {duplicate_index} duplicates participant {first_index}"
+            ),
+            Self::DuplicateControlDomainDigest {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold control-domain digest at {duplicate_index} duplicates participant {first_index}"
+            ),
+            Self::DuplicateContributionDigest {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold contribution digest at {duplicate_index} duplicates participant {first_index}"
+            ),
+            Self::ReleaseIdentityKeyAlias {
+                participant_index,
+                alternative_index,
+                identity_index,
+            } => write!(
+                f,
+                "release key ({participant_index},{alternative_index}) aliases identity {identity_index}"
+            ),
+            Self::DuplicateReleaseKey {
+                first_participant,
+                first_alternative,
+                duplicate_participant,
+                duplicate_alternative,
+            } => write!(
+                f,
+                "release key ({duplicate_participant},{duplicate_alternative}) duplicates ({first_participant},{first_alternative})"
+            ),
+            Self::AlternativeIndexOutOfRange { index, count } => write!(
+                f,
+                "threshold alternative index {index} is outside committed count {count}"
+            ),
+            Self::EncodedLengthOverflow => {
+                f.write_str("threshold registry canonical encoding exceeds u32 length")
+            }
+        }
+    }
+}
+
+impl Error for ThresholdV3KeyRegistryError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::ParticipantContribution { error, .. } => Some(error),
+            _ => None,
+        }
+    }
+}
+
+fn validate_release_matrix_dimensions(
+    alternatives: usize,
+    participants: usize,
+) -> Result<(), ThresholdV3KeyRegistryError> {
+    let cells = alternatives.checked_mul(participants).ok_or(
+        ThresholdV3KeyRegistryError::ReleaseMatrixTooLarge {
+            alternatives,
+            participants,
+            max_cells: MAX_THRESHOLD_V3_RELEASE_CELLS,
+        },
+    )?;
+    if cells > MAX_THRESHOLD_V3_RELEASE_CELLS {
+        return Err(ThresholdV3KeyRegistryError::ReleaseMatrixTooLarge {
+            alternatives,
+            participants,
+            max_cells: MAX_THRESHOLD_V3_RELEASE_CELLS,
+        });
+    }
+    Ok(())
+}
