+/// Setup-committed P2TR output controller and economic identities.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3ControlledP2trDestination {
+    output_key: XOnlyPublicKey,
+    principal_id: [u8; 32],
+    authority_digest: [u8; 32],
+}
+
+impl ThresholdV3ControlledP2trDestination {
+    /// Constructs one already-tweaked P2TR output-key destination.
+    pub fn new(
+        output_key: XOnlyPublicKey,
+        principal_id: [u8; 32],
+        authority_digest: [u8; 32],
+    ) -> Result<Self, ThresholdV3DestinationError> {
+        if principal_id == [0; 32] {
+            return Err(ThresholdV3DestinationError::ZeroPrincipalId);
+        }
+        if authority_digest == [0; 32] {
+            return Err(ThresholdV3DestinationError::ZeroAuthorityDigest);
+        }
+        Ok(Self {
+            output_key,
+            principal_id,
+            authority_digest,
+        })
+    }
+
+    /// Returns the already-tweaked Taproot output key.
+    pub const fn output_key(self) -> XOnlyPublicKey {
+        self.output_key
+    }
+
+    /// Returns the economic principal identity.
+    pub const fn principal_id(self) -> [u8; 32] {
+        self.principal_id
+    }
+
+    /// Returns the controller-evidence authority identity.
+    pub const fn authority_digest(self) -> [u8; 32] {
+        self.authority_digest
+    }
+
+    /// Returns the exact P2TR scriptPubKey.
+    pub fn script_pubkey(self) -> ScriptBuf {
+        ScriptBuf::new_p2tr_tweaked(TweakedPublicKey::dangerous_assume_tweaked(self.output_key))
+    }
+
+    /// Builds an output at this destination.
+    pub fn tx_out(self, value: Amount) -> TxOut {
+        TxOut {
+            value,
+            script_pubkey: self.script_pubkey(),
+        }
+    }
+}
