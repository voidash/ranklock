+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::AlternativeIndexOverflow { index } => write!(
+                f,
+                "threshold resolution alternative index {index} exceeds the v3 wire range"
+            ),
+            Self::AmountOverflow => {
+                f.write_str("threshold resolution base value plus bond overflowed")
+            }
+            Self::BondedResolutionValueMismatch { derived, committed } => write!(
+                f,
+                "threshold resolution derived bonded value {derived} differs from committed value {committed}"
+            ),
+            Self::FaultProfileRosterMismatch {
+                profile_participants,
+                release_keys,
+            } => write!(
+                f,
+                "threshold resolution fault profile commits {profile_participants} participants but received {release_keys} release keys"
+            ),
+            Self::DuplicateReleaseKey {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "release key {duplicate_index} duplicates release key {first_index}"
+            ),
+            Self::GraphReleaseKeyAlias { index } => {
+                write!(f, "release key {index} aliases the graph key")
+            }
+            Self::ZeroTimeoutDelay => f.write_str("threshold resolution timeout must be positive"),
+            Self::WrongNumsRole => {
+                f.write_str("threshold resolution was given the wrong draft NUMS role")
+            }
+            Self::ValueAboveMaxMoney { value } => {
+                write!(f, "threshold resolution value {value} exceeds MAX_MONEY")
+            }
+            Self::NumsDerivation(error) => write!(f, "NUMS derivation failed: {error}"),
+            Self::AuthorizationNumsKeyAlias {
+                authorization,
+                nums_key_kind,
+            } => write!(
+                f,
+                "threshold ACK {authorization:?} key aliases its {nums_key_kind:?} NUMS key"
+            ),
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "threshold resolution value {value} is below its dust floor {minimum}"
+            ),
+            Self::InvalidAckSignatureSlotCount { expected, actual } => write!(
+                f,
+                "threshold ACK requires {expected} ordered signature slots, got {actual}"
+            ),
+            Self::InvalidAckSignatureCount { expected, actual } => write!(
+                f,
+                "threshold ACK requires exactly {expected} nonempty signatures, got {actual}"
+            ),
+        }
+    }
+}
