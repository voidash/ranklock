+            .expect("fixture sighash");
+        let message = Message::from_digest(sighash.to_byte_array());
+        let release_signature = secp256k1::SECP256K1
+            .sign_schnorr_no_aux_rand(&message, &release_keypairs[selected_participant]);
+        let graph_signature =
+            secp256k1::SECP256K1.sign_schnorr_no_aux_rand(&message, &graph_keypair);
+        let mut witness = Witness::new();
