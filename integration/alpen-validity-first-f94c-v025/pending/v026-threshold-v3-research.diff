@@ -0,0 +1,1759 @@
+//! Joint ACK/timeout construction for one threshold-v3 selected resolution.
+//!
+//! The two children are deliberately constructed together from an exact
+//! counterproof parent and Contest parent. Callers cannot provide an `R` or
+//! `S` outpoint, substitute a resolution connector, choose collateral
+//! destinations, or independently assemble only one side of the conflict.
+//! This remains a structural research type and never authorizes funding.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{Amount, OutPoint, ScriptBuf, Transaction};
+use bitcoin_bosd::{Descriptor, DescriptorError};
+use secp256k1::XOnlyPublicKey;
+use strata_bridge_connectors::{
+    prelude::{
+        CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdV3Error,
+        KeyedAnchor, SlashAuthorizationConnectorV2, SlashAuthorizationError,
+        ThresholdV3BondPolicyError, ThresholdV3ControlledP2trDestination,
+        ThresholdV3SelectedBinding,
+    },
+    Connector,
+};
+
+use crate::transactions::{
+    contest_v2::{ContestV2Error, ContestV2Tx},
+    counterproof_ack_threshold_v3::{
+        CounterproofAckThresholdV3Data, CounterproofAckThresholdV3Error,
+        CounterproofAckThresholdV3Tx, SelectedCollateralRefundV3, SelectedCollateralRefundV3Error,
+    },
+    counterproof_threshold_v3::CounterproofThresholdV3Tx,
+    counterproof_timeout_settlement_threshold_v3::{
+        CounterproofTimeoutSettlementThresholdV3Data,
+        CounterproofTimeoutSettlementThresholdV3Error, CounterproofTimeoutSettlementThresholdV3Tx,
+        SelectedBondOperatorCompensationV3, SelectedBondOperatorCompensationV3Error,
+    },
+    template_fee_v2::TemplateFeeAllowanceV2,
+};
+
+/// Caller-pinned fees and independently controlled CPFP outputs for both branches.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdResolutionBranchesV3Plan {
+    /// ACK-only CPFP connector.
+    pub ack_cpfp_connector: KeyedAnchor,
+    /// Timeout-only CPFP connector.
+    pub timeout_cpfp_connector: KeyedAnchor,
+    /// Exact ACK miner fee.
+    pub ack_fee: Amount,
+    /// ACK-local research fee ceiling.
+    pub ack_fee_allowance: TemplateFeeAllowanceV2,
+    /// Exact timeout miner fee.
+    pub timeout_fee: Amount,
+    /// Timeout-local research fee ceiling.
+    pub timeout_fee_allowance: TemplateFeeAllowanceV2,
+}
+
+/// Protected destination role already committed by threshold P0.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ThresholdBranchDestinationRoleV3 {
+    /// Unselected C return.
+    CounterproofReturn,
+    /// Selected or unselected B refund.
+    BondRefund,
+    /// Timeout compensation paid to the operator.
+    OperatorCompensation,
+    /// D/timeout recovery destination.
+    Recovery,
+}
+
+/// Key/control domain used by cross-branch alias errors.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ThresholdBranchKeyDomainV3 {
+    /// Shared exact-parent graph authorization.
+    GraphAuthorization,
+    /// Registry participant identity.
+    RegistryIdentity {
+        /// Canonical participant position.
+        participant: usize,
+    },
+    /// Participant-by-alternative release authorization.
+    ReleaseAuthorization {
+        /// Canonical participant position.
+        participant: usize,
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// Counterproof operator authorization.
+    CounterproofOperator {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// Counterproof connector NUMS internal key.
+    CounterproofNumsInternal {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// Counterproof connector tweaked output key.
+    CounterproofNumsOutput {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// Bond connector NUMS internal key.
+    BondNumsInternal {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// Bond connector tweaked output key.
+    BondNumsOutput {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// P0 protected output controller.
+    ProtectedDestination {
+        /// Canonical alternative position.
+        alternative: usize,
+        /// Economic destination role within that alternative.
+        role: ThresholdBranchDestinationRoleV3,
+    },
+    /// Selected resolution NUMS internal key.
+    ResolutionNumsInternal,
+    /// Selected resolution tweaked output key.
+    ResolutionNumsOutput,
+    /// Contest S NUMS internal key.
+    ContestSlashNumsInternal,
+    /// Contest S tweaked output key.
+    ContestSlashNumsOutput,
+    /// Selected L NUMS internal key.
+    SlashAuthorizationNumsInternal,
+    /// Selected L tweaked output key.
+    SlashAuthorizationNumsOutput,
+    /// ACK anchor signing/internal key.
+    AckAnchorInternal,
+    /// ACK anchor tweaked output key.
+    AckAnchorOutput,
+    /// Timeout anchor signing/internal key.
+    TimeoutAnchorInternal,
+    /// Timeout anchor tweaked output key.
+    TimeoutAnchorOutput,
+    /// Contest proof connector internal key.
+    ContestProofInternal,
+    /// Contest proof connector tweaked output key.
+    ContestProofOutput,
+    /// Contest proof connector delayed-leaf authorization key.
+    ContestProofTimelocked,
+    /// Shared Contest `P` NUMS internal key.
+    ContestPayoutNumsInternal,
+    /// Shared Contest `P` tweaked output key.
+    ContestPayoutNumsOutput,
+    /// Contest MultiAnchor NUMS internal key.
+    ContestMultiAnchorNumsInternal,
+    /// Contest MultiAnchor tweaked output key.
+    ContestMultiAnchorNumsOutput,
+    /// One Contest MultiAnchor watchtower controller.
+    ContestMultiAnchorWatchtower {
+        /// Watchtower position in exact script order.
+        watchtower: usize,
+    },
+    /// Counterproof `D` key-path internal key.
+    CounterproofDepositInternal,
+    /// Counterproof `D` tweaked output key.
+    CounterproofDepositOutput,
+    /// Counterproof CPFP internal key.
+    CounterproofAnchorInternal,
+    /// Counterproof CPFP tweaked output key.
+    CounterproofAnchorOutput,
+}
+
+/// Script domain used by cross-branch script collision errors.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub enum ThresholdBranchScriptDomainV3 {
+    /// One Contest-created C script.
+    Counterproof {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// One externally funded B script.
+    Bond {
+        /// Canonical alternative position.
+        alternative: usize,
+    },
+    /// One P0-committed protected P2TR destination.
+    ProtectedDestination {
+        /// Canonical alternative position.
+        alternative: usize,
+        /// Economic destination role within that alternative.
+        role: ThresholdBranchDestinationRoleV3,
+    },
+    /// Selected R connector script.
+    Resolution,
+    /// Contest-created shared S connector script.
+    ContestSlash,
+    /// Selected ACK-created L connector script.
+    SlashAuthorization,
+    /// ACK-only CPFP script.
+    AckAnchor,
+    /// Timeout-only CPFP script.
+    TimeoutAnchor,
+    /// Contest proof connector script.
+    ContestProof,
+    /// Shared Contest `P` script.
+    ContestPayout,
+    /// Contest MultiAnchor script.
+    ContestMultiAnchor,
+    /// Counterproof `D` script.
+    CounterproofDeposit,
+    /// Counterproof CPFP script.
+    CounterproofAnchor,
+}
+
+/// Jointly constructed competing children for one exact selected `R_j`.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdResolutionBranchesV3 {
+    selected: ThresholdV3SelectedBinding,
+    resolution_connector: CounterproofResolutionThresholdConnectorV3,
+    contest_slash_connector: strata_bridge_connectors::prelude::ContestSlashGateV2,
+    slash_authorization_connector: SlashAuthorizationConnectorV2,
+    resolution_outpoint: OutPoint,
+    contest_slash_outpoint: OutPoint,
+    ack: CounterproofAckThresholdV3Tx,
+    timeout: CounterproofTimeoutSettlementThresholdV3Tx,
+}
+
+impl ThresholdResolutionBranchesV3 {
+    /// Constructs ACK and timeout from byte-identical parent-derived `R` and `S`.
+    pub fn from_parents(
+        selected: ThresholdV3SelectedBinding,
+        counterproof: &CounterproofThresholdV3Tx,
+        contest: &ContestV2Tx,
+        plan: ThresholdResolutionBranchesV3Plan,
+    ) -> Result<Self, ThresholdResolutionBranchesV3Error> {
+        verify_selected_parent(&selected, counterproof)?;
+        verify_contest_funding_roster(&selected, contest)?;
+        verify_shared_contest_parent(counterproof, contest)?;
+
+        let expected_resolution =
+            CounterproofResolutionThresholdConnectorV3::from_selected_binding(&selected)
+                .map_err(ThresholdResolutionBranchesV3Error::ResolutionDerivation)?;
+        if counterproof.resolution_connector() != &expected_resolution {
+            return Err(ThresholdResolutionBranchesV3Error::ResolutionConnectorMismatch);
+        }
+        let resolution_outpoint = counterproof.resolution_outpoint();
+        let counterproof_tx: &Transaction = counterproof.as_ref();
+        if counterproof_tx
+            .output
+            .get(CounterproofThresholdV3Tx::RESOLUTION_VOUT as usize)
+            != Some(&expected_resolution.tx_out())
+        {
+            return Err(ThresholdResolutionBranchesV3Error::ResolutionOutputMismatch);
+        }
+
+        let contest_slash_connector = *contest.slash_gate();
+        let contest_slash_outpoint = contest.slash_gate_outpoint();
+        let contest_tx: &Transaction = contest.as_ref();
+        if contest_tx.output.get(ContestV2Tx::SLASH_GATE_VOUT as usize)
+            != Some(&contest_slash_connector.tx_out())
+        {
+            return Err(ThresholdResolutionBranchesV3Error::ContestSlashOutputMismatch);
+        }
+        if resolution_outpoint == contest_slash_outpoint {
+            return Err(ThresholdResolutionBranchesV3Error::ParentOutpointCollision);
+        }
+
+        let selected_policy = selected.policy();
+        let bond_value = selected_policy.bond_value();
+        let expected_resolution_value = selected_policy
+            .base_resolution_value()
+            .checked_add(bond_value)
+            .ok_or(ThresholdResolutionBranchesV3Error::AmountOverflow)?;
+        if expected_resolution_value != selected_policy.bonded_resolution_value()
+            || expected_resolution.value() != expected_resolution_value
+        {
+            return Err(
+                ThresholdResolutionBranchesV3Error::BondedResolutionValueMismatch {
+                    expected: expected_resolution_value,
+                    policy: selected_policy.bonded_resolution_value(),
+                    connector: expected_resolution.value(),
+                },
+            );
+        }
+
+        let selected_refund = SelectedCollateralRefundV3::new(
+            destination_descriptor(selected_policy.bond_refund())?,
+            bond_value,
+        )
+        .map_err(ThresholdResolutionBranchesV3Error::SelectedRefund)?;
+        let operator_compensation = SelectedBondOperatorCompensationV3::new(
+            destination_descriptor(selected_policy.operator_compensation())?,
+            bond_value,
+        )
+        .map_err(ThresholdResolutionBranchesV3Error::OperatorCompensation)?;
+        let recovery_descriptor = destination_descriptor(selected_policy.recovery())?;
+
+        let after_anchor = selected_policy
+            .base_resolution_value()
+            .checked_sub(plan.ack_cpfp_connector.value())
+            .ok_or(
+                ThresholdResolutionBranchesV3Error::SlashAuthorizationValueUnderflow {
+                    base_resolution: selected_policy.base_resolution_value(),
+                    ack_anchor: plan.ack_cpfp_connector.value(),
+                    ack_fee: plan.ack_fee,
+                },
+            )?;
+        let slash_authorization_value = after_anchor.checked_sub(plan.ack_fee).ok_or(
+            ThresholdResolutionBranchesV3Error::SlashAuthorizationValueUnderflow {
+                base_resolution: selected_policy.base_resolution_value(),
+                ack_anchor: plan.ack_cpfp_connector.value(),
+                ack_fee: plan.ack_fee,
+            },
+        )?;
+        let slash_authorization_connector = SlashAuthorizationConnectorV2::from_selected_binding(
+            &selected,
+            slash_authorization_value,
+        )
+        .map_err(ThresholdResolutionBranchesV3Error::SlashAuthorization)?;
+
+        verify_cross_branch_domains(
+            &selected,
+            &slash_authorization_connector,
+            &plan.ack_cpfp_connector,
+            &plan.timeout_cpfp_connector,
+            counterproof,
+            contest,
+        )?;
+
+        let alternative = expected_resolution.alternative();
+        let ack = CounterproofAckThresholdV3Tx::new(
+            CounterproofAckThresholdV3Data {
+                resolution_outpoint,
+                alternative,
+            },
+            expected_resolution.clone(),
+            selected_refund,
+            slash_authorization_connector,
+            plan.ack_cpfp_connector,
+            plan.ack_fee,
+            plan.ack_fee_allowance,
+        )
+        .map_err(ThresholdResolutionBranchesV3Error::Ack)?;
+        let timeout = CounterproofTimeoutSettlementThresholdV3Tx::new(
+            CounterproofTimeoutSettlementThresholdV3Data {
+                resolution_outpoint,
+                contest_slash_outpoint,
+                alternative,
+            },
+            expected_resolution.clone(),
+            contest_slash_connector,
+            operator_compensation,
+            plan.timeout_cpfp_connector,
+            &recovery_descriptor,
+            plan.timeout_fee,
+            plan.timeout_fee_allowance,
+        )
+        .map_err(ThresholdResolutionBranchesV3Error::Timeout)?;
+
+        verify_constructed_children(
+            &ack,
+            &timeout,
+            resolution_outpoint,
+            contest_slash_outpoint,
+            &expected_resolution,
+            &contest_slash_connector,
+            &slash_authorization_connector,
+            &plan,
+            selected_policy.bond_refund(),
+            selected_policy.operator_compensation(),
+            selected_policy.recovery(),
+            bond_value,
+        )?;
+
+        Ok(Self {
+            selected,
+            resolution_connector: expected_resolution,
+            contest_slash_connector,
+            slash_authorization_connector,
+            resolution_outpoint,
+            contest_slash_outpoint,
+            ack,
+            timeout,
+        })
+    }
+
+    /// Returns the exact P1-selected binding shared by R, ACK, timeout, and L.
+    pub const fn selected_binding(&self) -> &ThresholdV3SelectedBinding {
+        &self.selected
+    }
+
+    /// Returns the byte-identical CP-derived resolution connector used by both children.
+    pub const fn resolution_connector(&self) -> &CounterproofResolutionThresholdConnectorV3 {
+        &self.resolution_connector
+    }
+
+    /// Returns the byte-identical Contest-derived S connector used by timeout.
+    pub const fn contest_slash_connector(
+        &self,
+    ) -> &strata_bridge_connectors::prelude::ContestSlashGateV2 {
+        &self.contest_slash_connector
+    }
+
+    /// Returns L derived from the selected binding and ACK value equation.
+    pub const fn slash_authorization_connector(&self) -> &SlashAuthorizationConnectorV2 {
+        &self.slash_authorization_connector
+    }
+
+    /// Returns the exact CP-derived R outpoint consumed by ACK and timeout.
+    pub const fn resolution_outpoint(&self) -> OutPoint {
+        self.resolution_outpoint
+    }
+
+    /// Returns the exact Contest-derived S outpoint consumed by timeout.
+    pub const fn contest_slash_outpoint(&self) -> OutPoint {
+        self.contest_slash_outpoint
+    }
+
+    /// Returns the exact threshold ACK child.
+    pub const fn ack(&self) -> &CounterproofAckThresholdV3Tx {
+        &self.ack
+    }
+
+    /// Returns the exact competing CSV timeout child.
+    pub const fn timeout(&self) -> &CounterproofTimeoutSettlementThresholdV3Tx {
+        &self.timeout
+    }
+
+    /// Structural construction does not discharge any activation blocker.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+fn verify_selected_parent(
+    selected: &ThresholdV3SelectedBinding,
+    counterproof: &CounterproofThresholdV3Tx,
+) -> Result<(), ThresholdResolutionBranchesV3Error> {
+    if counterproof.selected_binding() != selected {
+        return Err(ThresholdResolutionBranchesV3Error::SelectedParentMismatch);
+    }
+    Ok(())
+}
+
+fn verify_contest_funding_roster(
+    selected: &ThresholdV3SelectedBinding,
+    contest: &ContestV2Tx,
+) -> Result<(), ThresholdResolutionBranchesV3Error> {
+    let setup = selected.setup();
+    let policy = setup.policy();
+    let contest_connectors = contest.counterproof_outputs();
+    let count = policy.alternatives().len();
+    if contest_connectors.len() != count
+        || setup.counterproof_funding().len() != count
+        || setup.bond_funding().len() != count
+    {
+        return Err(
+            ThresholdResolutionBranchesV3Error::ParentRosterLengthMismatch {
+                policy: count,
+                contest: contest_connectors.len(),
+                counterproof_funding: setup.counterproof_funding().len(),
+                bond_funding: setup.bond_funding().len(),
+            },
+        );
+    }
+
+    let contest_tx: &Transaction = contest.as_ref();
+    for (index, contest_connector) in contest_connectors.iter().enumerate() {
+        let policy_connector = policy.alternatives()[index].counterproof_output();
+        if contest_connector != policy_connector {
+            return Err(ThresholdResolutionBranchesV3Error::ContestConnectorMismatch { index });
+        }
+        let expected_outpoint = contest
+            .counterproof_outpoint(index)
+            .map_err(ThresholdResolutionBranchesV3Error::Contest)?;
+        let funding = &setup.counterproof_funding()[index];
+        if funding.outpoint() != expected_outpoint {
+            return Err(
+                ThresholdResolutionBranchesV3Error::ContestFundingOutpointMismatch { index },
+            );
+        }
+        let expected_tx_out = policy_connector.tx_out();
+        if funding.tx_out() != &expected_tx_out {
+            return Err(ThresholdResolutionBranchesV3Error::ContestFundingOutputMismatch { index });
+        }
+        let vout = contest
+            .counterproof_vout(index)
+            .map_err(ThresholdResolutionBranchesV3Error::Contest)?;
+        if contest_tx.output.get(vout as usize) != Some(&expected_tx_out) {
+            return Err(
+                ThresholdResolutionBranchesV3Error::ContestSerializedOutputMismatch { index },
+            );
+        }
+
+        let bond_connector = policy.bond_connector(index).map_err(|source| {
+            ThresholdResolutionBranchesV3Error::BondConnector {
+                index,
+                source: Box::new(source),
+            }
+        })?;
+        if setup.bond_funding()[index].tx_out() != &bond_connector.tx_out() {
+            return Err(ThresholdResolutionBranchesV3Error::BondFundingOutputMismatch { index });
+        }
+    }
+    Ok(())
+}
+
+fn verify_shared_contest_parent(
+    counterproof: &CounterproofThresholdV3Tx,
+    contest: &ContestV2Tx,
+) -> Result<(), ThresholdResolutionBranchesV3Error> {
+    if counterproof.shared_selection().contest_payout_outpoint != contest.payout_gate_outpoint() {
+        return Err(ThresholdResolutionBranchesV3Error::ContestPayoutOutpointMismatch);
+    }
+    if counterproof.contest_payout_connector() != contest.payout_gate() {
+        return Err(ThresholdResolutionBranchesV3Error::ContestPayoutConnectorMismatch);
+    }
+    let contest_tx: &Transaction = contest.as_ref();
+    if contest_tx
+        .output
+        .get(ContestV2Tx::PAYOUT_GATE_VOUT as usize)
+        != Some(&counterproof.contest_payout_connector().tx_out())
+    {
+        return Err(ThresholdResolutionBranchesV3Error::ContestPayoutOutputMismatch);
+    }
+    let payout_input = counterproof
+        .selected_binding()
+        .setup()
+        .counterproof_funding()
+        .len()
+        .checked_mul(2)
+        .ok_or(ThresholdResolutionBranchesV3Error::AmountOverflow)?;
+    let counterproof_tx: &Transaction = counterproof.as_ref();
+    if counterproof_tx
+        .input
+        .get(payout_input)
+        .map(|input| input.previous_output)
+        != Some(contest.payout_gate_outpoint())
+    {
+        return Err(ThresholdResolutionBranchesV3Error::CounterproofPayoutInputMismatch);
+    }
+    Ok(())
+}
+
+fn destination_descriptor(
+    destination: ThresholdV3ControlledP2trDestination,
+) -> Result<Descriptor, ThresholdResolutionBranchesV3Error> {
+    Descriptor::new_p2tr(&destination.output_key().serialize())
+        .map_err(ThresholdResolutionBranchesV3Error::Descriptor)
+}
+
+fn verify_cross_branch_domains(
+    selected: &ThresholdV3SelectedBinding,
+    slash_authorization: &SlashAuthorizationConnectorV2,
+    ack_anchor: &KeyedAnchor,
+    timeout_anchor: &KeyedAnchor,
+    counterproof_parent: &CounterproofThresholdV3Tx,
+    contest: &ContestV2Tx,
+) -> Result<(), ThresholdResolutionBranchesV3Error> {
+    let resolution = counterproof_parent.resolution_connector();
+    let contest_slash = contest.slash_gate();
+    let policy = selected.setup().policy();
+    let mut static_keys = Vec::<(ThresholdBranchKeyDomainV3, XOnlyPublicKey)>::new();
+    push_unique_key(
+        &mut static_keys,
+        ThresholdBranchKeyDomainV3::GraphAuthorization,
+        policy.graph_pubkey(),
+    );
+    for (participant, identity) in policy.registry().participants().iter().enumerate() {
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::RegistryIdentity { participant },
+            identity.identity_pubkey(),
+        );
+        for (alternative, release) in identity.release_pubkeys().iter().copied().enumerate() {
+            push_unique_key(
+                &mut static_keys,
+                ThresholdBranchKeyDomainV3::ReleaseAuthorization {
+                    participant,
+                    alternative,
+                },
+                release,
+            );
+        }
+    }
+
+    let mut static_scripts = Vec::<(ThresholdBranchScriptDomainV3, ScriptBuf)>::new();
+    for (alternative, alternative_policy) in policy.alternatives().iter().enumerate() {
+        let counterproof = alternative_policy.counterproof_output();
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::CounterproofOperator { alternative },
+            counterproof.operator_pubkey(),
+        );
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::CounterproofNumsInternal { alternative },
+            counterproof.internal_key(),
+        );
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::CounterproofNumsOutput { alternative },
+            counterproof
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        );
+        push_unique_script(
+            &mut static_scripts,
+            ThresholdBranchScriptDomainV3::Counterproof { alternative },
+            counterproof.script_pubkey(),
+        );
+
+        let bond = policy.bond_connector(alternative).map_err(|source| {
+            ThresholdResolutionBranchesV3Error::BondConnector {
+                index: alternative,
+                source: Box::new(source),
+            }
+        })?;
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::BondNumsInternal { alternative },
+            bond.internal_key(),
+        );
+        push_unique_key(
+            &mut static_keys,
+            ThresholdBranchKeyDomainV3::BondNumsOutput { alternative },
+            bond.spend_info().output_key().to_x_only_public_key(),
+        );
+        push_unique_script(
+            &mut static_scripts,
+            ThresholdBranchScriptDomainV3::Bond { alternative },
+            bond.script_pubkey(),
+        );
+
+        for (role, destination) in [
+            (
+                ThresholdBranchDestinationRoleV3::CounterproofReturn,
+                alternative_policy.counterproof_return(),
+            ),
+            (
+                ThresholdBranchDestinationRoleV3::BondRefund,
+                alternative_policy.bond_refund(),
+            ),
+            (
+                ThresholdBranchDestinationRoleV3::OperatorCompensation,
+                alternative_policy.operator_compensation(),
+            ),
+            (
+                ThresholdBranchDestinationRoleV3::Recovery,
+                alternative_policy.recovery(),
+            ),
+        ] {
+            push_unique_key(
+                &mut static_keys,
+                ThresholdBranchKeyDomainV3::ProtectedDestination { alternative, role },
+                destination.output_key(),
+            );
+            push_unique_script(
+                &mut static_scripts,
+                ThresholdBranchScriptDomainV3::ProtectedDestination { alternative, role },
+                destination.script_pubkey(),
+            );
+        }
+    }
+
+    let mut dynamic_keys = vec![
+        (
+            ThresholdBranchKeyDomainV3::ResolutionNumsInternal,
+            resolution.internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ResolutionNumsOutput,
+            resolution.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestSlashNumsInternal,
+            contest_slash.internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestSlashNumsOutput,
+            contest_slash
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::SlashAuthorizationNumsInternal,
+            slash_authorization.internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::SlashAuthorizationNumsOutput,
+            slash_authorization
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::AckAnchorInternal,
+            ack_anchor.internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::AckAnchorOutput,
+            ack_anchor.spend_info().output_key().to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::TimeoutAnchorInternal,
+            timeout_anchor.internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::TimeoutAnchorOutput,
+            timeout_anchor
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestProofInternal,
+            contest.proof_connector().internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestProofOutput,
+            contest
+                .proof_connector()
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestProofTimelocked,
+            contest.proof_connector().timelocked_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestPayoutNumsInternal,
+            contest.payout_gate().internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestPayoutNumsOutput,
+            contest
+                .payout_gate()
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestMultiAnchorNumsInternal,
+            contest.cpfp_connector().internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::ContestMultiAnchorNumsOutput,
+            contest
+                .cpfp_connector()
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::CounterproofDepositInternal,
+            counterproof_parent.deposit_connector().internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::CounterproofDepositOutput,
+            counterproof_parent
+                .deposit_connector()
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::CounterproofAnchorInternal,
+            counterproof_parent.cpfp_connector().internal_key(),
+        ),
+        (
+            ThresholdBranchKeyDomainV3::CounterproofAnchorOutput,
+            counterproof_parent
+                .cpfp_connector()
+                .spend_info()
+                .output_key()
+                .to_x_only_public_key(),
+        ),
+    ];
+    dynamic_keys.extend(
+        contest
+            .cpfp_connector()
+            .watchtower_keys()
+            .iter()
+            .copied()
+            .enumerate()
+            .map(|(watchtower, key)| {
+                (
+                    ThresholdBranchKeyDomainV3::ContestMultiAnchorWatchtower { watchtower },
+                    key,
+                )
+            }),
+    );
+    let mut accepted_dynamic = Vec::with_capacity(dynamic_keys.len());
+    for (domain, key) in dynamic_keys {
+        // Contest proof's delayed N/N authorization is the graph authorization
+        // in the current Contest profile. This one exact semantic equivalence
+        // is intentional; no other newly supplied parent/controller alias is.
+        if domain == ThresholdBranchKeyDomainV3::ContestProofTimelocked
+            && key == policy.graph_pubkey()
+        {
+            continue;
+        }
+        if let Some((first, _)) = static_keys.iter().find(|(_, earlier)| *earlier == key) {
+            return Err(ThresholdResolutionBranchesV3Error::KeyDomainAlias {
+                first: *first,
+                second: domain,
+            });
+        }
+        if let Some((first, _)) = accepted_dynamic
+            .iter()
+            .find(|(_, earlier): &&(ThresholdBranchKeyDomainV3, XOnlyPublicKey)| *earlier == key)
+        {
+            return Err(ThresholdResolutionBranchesV3Error::KeyDomainAlias {
+                first: *first,
+                second: domain,
+            });
+        }
+        accepted_dynamic.push((domain, key));
+    }
+
+    let dynamic_scripts = [
+        (
+            ThresholdBranchScriptDomainV3::Resolution,
+            resolution.script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::ContestSlash,
+            contest_slash.script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::SlashAuthorization,
+            slash_authorization.script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::AckAnchor,
+            ack_anchor.script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::TimeoutAnchor,
+            timeout_anchor.script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::ContestProof,
+            contest.proof_connector().script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::ContestPayout,
+            contest.payout_gate().script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::ContestMultiAnchor,
+            contest.cpfp_connector().script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::CounterproofDeposit,
+            counterproof_parent.deposit_connector().script_pubkey(),
+        ),
+        (
+            ThresholdBranchScriptDomainV3::CounterproofAnchor,
+            counterproof_parent.cpfp_connector().script_pubkey(),
+        ),
+    ];
+    let mut accepted_dynamic_scripts = Vec::with_capacity(dynamic_scripts.len());
+    for (domain, script) in dynamic_scripts {
+        if let Some((first, _)) = static_scripts
+            .iter()
+            .find(|(_, earlier)| *earlier == script)
+        {
+            return Err(ThresholdResolutionBranchesV3Error::ScriptDomainAlias {
+                first: *first,
+                second: domain,
+            });
+        }
+        if let Some((first, _)) = accepted_dynamic_scripts
+            .iter()
+            .find(|(_, earlier): &&(ThresholdBranchScriptDomainV3, ScriptBuf)| *earlier == script)
+        {
+            return Err(ThresholdResolutionBranchesV3Error::ScriptDomainAlias {
+                first: *first,
+                second: domain,
+            });
+        }
+        accepted_dynamic_scripts.push((domain, script));
+    }
+    Ok(())
+}
+
+fn push_unique_key(
+    domains: &mut Vec<(ThresholdBranchKeyDomainV3, XOnlyPublicKey)>,
+    domain: ThresholdBranchKeyDomainV3,
+    key: XOnlyPublicKey,
+) {
+    // P0 has already validated its complete static domain. Exact repetitions
+    // within one permitted economic role therefore need only one representative
+    // when checking newly derived R/S/L/anchor domains.
+    if !domains.iter().any(|(_, earlier)| *earlier == key) {
+        domains.push((domain, key));
+    }
+}
+
+fn push_unique_script(
+    domains: &mut Vec<(ThresholdBranchScriptDomainV3, ScriptBuf)>,
+    domain: ThresholdBranchScriptDomainV3,
+    script: ScriptBuf,
+) {
+    // As above, this only compacts already-validated static P0 equivalences;
+    // dynamic branch scripts are never deduplicated before collision checks.
+    if !domains.iter().any(|(_, earlier)| *earlier == script) {
+        domains.push((domain, script));
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn verify_constructed_children(
+    ack: &CounterproofAckThresholdV3Tx,
+    timeout: &CounterproofTimeoutSettlementThresholdV3Tx,
+    resolution_outpoint: OutPoint,
+    contest_slash_outpoint: OutPoint,
+    resolution: &CounterproofResolutionThresholdConnectorV3,
+    contest_slash: &strata_bridge_connectors::prelude::ContestSlashGateV2,
+    slash_authorization: &SlashAuthorizationConnectorV2,
+    plan: &ThresholdResolutionBranchesV3Plan,
+    refund_destination: ThresholdV3ControlledP2trDestination,
+    operator_destination: ThresholdV3ControlledP2trDestination,
+    recovery_destination: ThresholdV3ControlledP2trDestination,
+    bond_value: Amount,
+) -> Result<(), ThresholdResolutionBranchesV3Error> {
+    let ack_tx: &Transaction = ack.as_ref();
+    if ack_tx.input.len() != 1
+        || ack_tx.input[0].previous_output != resolution_outpoint
+        || ack_tx.output
+            != [
+                refund_destination.tx_out(bond_value),
+                slash_authorization.tx_out(),
+                plan.ack_cpfp_connector.tx_out(),
+            ]
+    {
+        return Err(ThresholdResolutionBranchesV3Error::ConstructedAckMismatch);
+    }
+
+    let timeout_tx: &Transaction = timeout.as_ref();
+    if timeout_tx.input.len() != 2
+        || timeout_tx.input[0].previous_output != resolution_outpoint
+        || timeout_tx.input[1].previous_output != contest_slash_outpoint
+    {
+        return Err(ThresholdResolutionBranchesV3Error::ConstructedTimeoutMismatch);
+    }
+    let input_value = resolution
+        .value()
+        .checked_add(contest_slash.value())
+        .ok_or(ThresholdResolutionBranchesV3Error::AmountOverflow)?;
+    let fixed = bond_value
+        .checked_add(plan.timeout_cpfp_connector.value())
+        .and_then(|value| value.checked_add(plan.timeout_fee))
+        .ok_or(ThresholdResolutionBranchesV3Error::AmountOverflow)?;
+    let recovery_value = input_value
+        .checked_sub(fixed)
+        .ok_or(ThresholdResolutionBranchesV3Error::ConstructedTimeoutMismatch)?;
+    let mut expected_timeout_outputs = vec![
+        operator_destination.tx_out(bond_value),
+        plan.timeout_cpfp_connector.tx_out(),
+    ];
+    if recovery_value != Amount::ZERO {
+        expected_timeout_outputs.push(recovery_destination.tx_out(recovery_value));
+    }
+    if timeout_tx.output != expected_timeout_outputs {
+        return Err(ThresholdResolutionBranchesV3Error::ConstructedTimeoutMismatch);
+    }
+    Ok(())
+}
+
+/// Failure to derive and jointly construct one exact threshold branch pair.
+#[derive(Debug)]
+pub enum ThresholdResolutionBranchesV3Error {
+    /// The supplied selected binding differs from the one embedded in CP.
+    SelectedParentMismatch,
+    /// P0, Contest, or either P1 funding roster has a different length.
+    ParentRosterLengthMismatch {
+        /// P0 alternative count.
+        policy: usize,
+        /// Contest C output count.
+        contest: usize,
+        /// P1 C funding count.
+        counterproof_funding: usize,
+        /// P1 B funding count.
+        bond_funding: usize,
+    },
+    /// Contest C at one position differs from P0.
+    ContestConnectorMismatch {
+        /// Canonical alternative position.
+        index: usize,
+    },
+    /// A P1 C outpoint was not derived from the supplied Contest.
+    ContestFundingOutpointMismatch {
+        /// Canonical alternative position.
+        index: usize,
+    },
+    /// A P1 C TxOut differs from its P0 connector.
+    ContestFundingOutputMismatch {
+        /// Canonical alternative position.
+        index: usize,
+    },
+    /// Serialized Contest bytes differ from the P0 C projection.
+    ContestSerializedOutputMismatch {
+        /// Canonical alternative position.
+        index: usize,
+    },
+    /// A P1 B TxOut differs from its P0 bond connector.
+    BondFundingOutputMismatch {
+        /// Canonical alternative position.
+        index: usize,
+    },
+    /// CP's shared `P` outpoint was not derived from the supplied Contest.
+    ContestPayoutOutpointMismatch,
+    /// CP retained a different `P` connector than the supplied Contest.
+    ContestPayoutConnectorMismatch,
+    /// Contest's serialized `P` output differs from CP's retained connector.
+    ContestPayoutOutputMismatch,
+    /// CP's serialized `P` input does not spend the supplied Contest.
+    CounterproofPayoutInputMismatch,
+    /// CP's retained R connector differs from a fresh selected-binding derivation.
+    ResolutionConnectorMismatch,
+    /// CP's serialized R output differs from the retained connector.
+    ResolutionOutputMismatch,
+    /// Contest's serialized S output differs from the retained connector.
+    ContestSlashOutputMismatch,
+    /// The independently derived R and S outpoints unexpectedly collide.
+    ParentOutpointCollision,
+    /// `base_R + B`, P0 bonded R, and the R connector disagree.
+    BondedResolutionValueMismatch {
+        /// Checked `base_R + B` value.
+        expected: Amount,
+        /// P0 committed bonded-resolution value.
+        policy: Amount,
+        /// Derived R connector value.
+        connector: Amount,
+    },
+    /// ACK anchor plus fee exceeds the P0 base-resolution value.
+    SlashAuthorizationValueUnderflow {
+        /// P0 base-resolution value before selected B.
+        base_resolution: Amount,
+        /// ACK CPFP value.
+        ack_anchor: Amount,
+        /// Exact ACK miner fee.
+        ack_fee: Amount,
+    },
+    /// A dynamic branch key aliases a protected static or sibling domain.
+    KeyDomainAlias {
+        /// Earlier protected domain.
+        first: ThresholdBranchKeyDomainV3,
+        /// Later aliased domain.
+        second: ThresholdBranchKeyDomainV3,
+    },
+    /// A dynamic branch script aliases a protected static or sibling domain.
+    ScriptDomainAlias {
+        /// Earlier protected script domain.
+        first: ThresholdBranchScriptDomainV3,
+        /// Later aliased script domain.
+        second: ThresholdBranchScriptDomainV3,
+    },
+    /// ACK bytes differ from the exact locally derived projection.
+    ConstructedAckMismatch,
+    /// Timeout bytes differ from the exact locally derived projection.
+    ConstructedTimeoutMismatch,
+    /// Checked amount arithmetic overflowed.
+    AmountOverflow,
+    /// A P0 output key could not be represented as a BOSD P2TR descriptor.
+    Descriptor(DescriptorError),
+    /// Contest outpoint derivation failed.
+    Contest(ContestV2Error),
+    /// A P0 bond connector could not be reconstructed.
+    BondConnector {
+        /// Canonical alternative position.
+        index: usize,
+        /// Exact P0 derivation error.
+        source: Box<ThresholdV3BondPolicyError>,
+    },
+    /// A selected-binding R connector could not be reconstructed.
+    ResolutionDerivation(CounterproofResolutionThresholdV3Error),
+    /// The P0-selected B refund could not be represented by ACK.
+    SelectedRefund(SelectedCollateralRefundV3Error),
+    /// The P0-selected operator compensation could not be represented by timeout.
+    OperatorCompensation(SelectedBondOperatorCompensationV3Error),
+    /// The checked ACK equation could not produce a valid selected L connector.
+    SlashAuthorization(SlashAuthorizationError),
+    /// Exact ACK construction rejected the derived inputs or policy.
+    Ack(CounterproofAckThresholdV3Error),
+    /// Exact timeout construction rejected the derived inputs or policy.
+    Timeout(CounterproofTimeoutSettlementThresholdV3Error),
+}
+
+impl fmt::Display for ThresholdResolutionBranchesV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::SelectedParentMismatch => {
+                f.write_str("counterproof parent does not use the supplied selected P1 binding")
+            }
+            Self::ParentRosterLengthMismatch {
+                policy,
+                contest,
+                counterproof_funding,
+                bond_funding,
+            } => write!(
+                f,
+                "threshold parent roster mismatch: P0={policy}, Contest={contest}, C={counterproof_funding}, B={bond_funding}"
+            ),
+            Self::ContestConnectorMismatch { index } => {
+                write!(f, "Contest C_{index} differs from threshold P0")
+            }
+            Self::ContestFundingOutpointMismatch { index } => {
+                write!(f, "P1 C_{index} outpoint was not derived from Contest")
+            }
+            Self::ContestFundingOutputMismatch { index } => {
+                write!(f, "P1 C_{index} TxOut differs from threshold P0")
+            }
+            Self::ContestSerializedOutputMismatch { index } => {
+                write!(f, "serialized Contest C_{index} output differs from P0")
+            }
+            Self::BondFundingOutputMismatch { index } => {
+                write!(f, "P1 B_{index} TxOut differs from threshold P0")
+            }
+            Self::ContestPayoutOutpointMismatch => {
+                f.write_str("counterproof P outpoint was not derived from the supplied Contest")
+            }
+            Self::ContestPayoutConnectorMismatch => {
+                f.write_str("counterproof P connector differs from the supplied Contest")
+            }
+            Self::ContestPayoutOutputMismatch => {
+                f.write_str("serialized Contest P output differs from counterproof P")
+            }
+            Self::CounterproofPayoutInputMismatch => {
+                f.write_str("serialized counterproof P input does not spend the supplied Contest")
+            }
+            Self::ResolutionConnectorMismatch => {
+                f.write_str("counterproof R differs from the supplied selected binding")
+            }
+            Self::ResolutionOutputMismatch => {
+                f.write_str("serialized counterproof R output differs from its connector")
+            }
+            Self::ContestSlashOutputMismatch => {
+                f.write_str("serialized Contest S output differs from its connector")
+            }
+            Self::ParentOutpointCollision => f.write_str("derived R and S outpoints collide"),
+            Self::BondedResolutionValueMismatch {
+                expected,
+                policy,
+                connector,
+            } => write!(
+                f,
+                "bonded R mismatch: base+B={expected}, P0={policy}, connector={connector}"
+            ),
+            Self::SlashAuthorizationValueUnderflow {
+                base_resolution,
+                ack_anchor,
+                ack_fee,
+            } => write!(
+                f,
+                "cannot derive L: base R {base_resolution} is below ACK anchor {ack_anchor} plus fee {ack_fee}"
+            ),
+            Self::KeyDomainAlias { first, second } => {
+                write!(
+                    f,
+                    "threshold branch key domains {first:?} and {second:?} alias"
+                )
+            }
+            Self::ScriptDomainAlias { first, second } => write!(
+                f,
+                "threshold branch script domains {first:?} and {second:?} alias"
+            ),
+            Self::ConstructedAckMismatch => {
+                f.write_str("constructed ACK differs from its exact derived projection")
+            }
+            Self::ConstructedTimeoutMismatch => {
+                f.write_str("constructed timeout differs from its exact derived projection")
+            }
+            Self::AmountOverflow => f.write_str("threshold branch amount arithmetic overflowed"),
+            Self::Descriptor(error) => write!(f, "failed to encode P0 P2TR destination: {error}"),
+            Self::Contest(error) => write!(f, "Contest parent verification failed: {error}"),
+            Self::BondConnector { index, source } => {
+                write!(f, "failed to derive P0 B_{index}: {source}")
+            }
+            Self::ResolutionDerivation(error) => {
+                write!(f, "failed to derive selected R: {error}")
+            }
+            Self::SelectedRefund(error) => write!(f, "selected B refund is invalid: {error}"),
+            Self::OperatorCompensation(error) => {
+                write!(f, "selected B operator compensation is invalid: {error}")
+            }
+            Self::SlashAuthorization(error) => write!(f, "selected L is invalid: {error}"),
+            Self::Ack(error) => write!(f, "threshold ACK construction failed: {error}"),
+            Self::Timeout(error) => write!(f, "threshold timeout construction failed: {error}"),
+        }
+    }
+}
+
+impl Error for ThresholdResolutionBranchesV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Descriptor(error) => Some(error),
+            Self::Contest(error) => Some(error),
+            Self::BondConnector { source, .. } => Some(source.as_ref()),
+            Self::ResolutionDerivation(error) => Some(error),
+            Self::SelectedRefund(error) => Some(error),
+            Self::OperatorCompensation(error) => Some(error),
+            Self::SlashAuthorization(error) => Some(error),
+            Self::Ack(error) => Some(error),
+            Self::Timeout(error) => Some(error),
+            _ => None,
+        }
+    }
+}
