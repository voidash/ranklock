+/// Static policy for one counterproof and selected bond.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3BondAlternativePolicy {
+    counterproof_output: ContestCounterproofOutputV2,
+    counterproof_return: ThresholdV3ControlledP2trDestination,
+    bond_value: Amount,
+    bond_refund: ThresholdV3ControlledP2trDestination,
+    operator_compensation: ThresholdV3ControlledP2trDestination,
+    recovery: ThresholdV3ControlledP2trDestination,
+    base_resolution_value: Amount,
+    bonded_resolution_value: Amount,
+    timeout_delay: relative::Height,
