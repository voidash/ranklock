+    #[test]
+    fn static_and_funded_commitments_are_canonical_and_distinct() {
+        let graph = key(1);
+        let policy = policy(graph);
+        assert!(!policy.funding_eligible());
+        assert_eq!(&policy.canonical_bytes()[..8], b"RL26TBP3");
+        assert_ne!(
