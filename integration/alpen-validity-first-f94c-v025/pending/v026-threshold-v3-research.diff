+            Err(CounterproofThresholdV3Error::KeyDomainAlias {
+                first: CounterproofThresholdV3KeyDomain::Graph,
+                second: CounterproofThresholdV3KeyDomain::DepositInternal,
+            })
+        ));
+
+        let mut excessive = fixture(true);
+        excessive.deposit = NOfNConnector::new(
+            Network::Regtest,
+            excessive.deposit_key.x_only_public_key().0,
+            Amount::MAX_MONEY
+                .checked_add(Amount::from_sat(1))
+                .expect("above max"),
+        );
+        assert!(matches!(
+            construct(&excessive),
+            Err(CounterproofThresholdV3Error::MoneyRange { .. })
+        ));
+
+        let fixture = fixture(true);
+        let dust_anchor = KeyedAnchor::new(
+            Network::Regtest,
+            fixture.cpfp.internal_key(),
+            Amount::from_sat(1),
+        );
+        assert!(matches!(
+            CounterproofThresholdV3Tx::new(
+                CounterproofThresholdV3Data {
+                    selected: fixture.setup.selected(1).expect("selected"),
+                    shared_selection: fixture.shared,
+                },
+                fixture.payout,
+                fixture.deposit,
+                dust_anchor,
+                FEE,
+                allowance(TemplateKindV2::Counterproof),
+            ),
+            Err(CounterproofThresholdV3Error::DustValue {
+                field: "counterproof anchor output",
+                ..
+            })
+        ));
+        assert!(matches!(
+            CounterproofThresholdV3Tx::new(
+                CounterproofThresholdV3Data {
+                    selected: fixture.setup.selected(1).expect("selected"),
+                    shared_selection: fixture.shared,
+                },
+                fixture.payout,
+                fixture.deposit,
+                fixture.cpfp,
+                FEE,
+                allowance(TemplateKindV2::OwnerPayout),
+            ),
+            Err(CounterproofThresholdV3Error::FeeAllowance(
+                TemplateFeeAllowanceV2Error::TemplateKindMismatch { .. }
+            ))
+        ));
+    }
+}
