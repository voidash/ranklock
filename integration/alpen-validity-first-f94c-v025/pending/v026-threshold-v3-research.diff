+/// Exact C/B predecessor roster bound after prospective funding txids exist.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3FundedSetupP1 {
+    policy: Arc<ThresholdV3BondPolicyP0>,
+    counterproof_funding: Box<[ThresholdV3FundingOutput]>,
+    bond_funding: Box<[ThresholdV3FundingOutput]>,
+    canonical_bytes: Box<[u8]>,
+    digest: ThresholdV3FundedSetupDigest,
+}
+
+impl ThresholdV3FundedSetupP1 {
+    /// Binds exact ordered C/B predecessor outputs to P0.
+    pub fn new(
+        policy: Arc<ThresholdV3BondPolicyP0>,
+        counterproof_funding: Vec<ThresholdV3FundingOutput>,
+        bond_funding: Vec<ThresholdV3FundingOutput>,
+    ) -> Result<Arc<Self>, ThresholdV3FundedSetupError> {
+        let count = policy.alternatives.len();
+        if counterproof_funding.len() != count || bond_funding.len() != count {
+            return Err(ThresholdV3FundedSetupError::RosterLengthMismatch {
+                expected: count,
+                counterproof: counterproof_funding.len(),
+                bonds: bond_funding.len(),
+            });
+        }
+        let mut outpoints = Vec::with_capacity(count * 2);
+        for index in 0..count {
+            let expected_c = policy.alternatives[index].counterproof_output.tx_out();
+            if counterproof_funding[index].tx_out != expected_c {
+                return Err(ThresholdV3FundedSetupError::CounterproofOutputMismatch { index });
+            }
+            let expected_b = policy
+                .bond_connector(index)
+                .map_err(ThresholdV3FundedSetupError::Policy)?
+                .tx_out();
+            if bond_funding[index].tx_out != expected_b {
+                return Err(ThresholdV3FundedSetupError::BondOutputMismatch { index });
+            }
+            for outpoint in [
+                counterproof_funding[index].outpoint,
+                bond_funding[index].outpoint,
+            ] {
+                if let Some(first_index) = outpoints.iter().position(|earlier| *earlier == outpoint)
+                {
+                    return Err(ThresholdV3FundedSetupError::DuplicateOutpoint {
+                        first_index,
+                        duplicate_index: index,
+                    });
+                }
+                outpoints.push(outpoint);
+            }
+        }
+        let counterproof_funding = counterproof_funding.into_boxed_slice();
+        let bond_funding = bond_funding.into_boxed_slice();
+        let canonical_bytes = encode_funded_setup(&policy, &counterproof_funding, &bond_funding)?;
+        let digest = ThresholdV3FundedSetupDigest(
+            ThresholdFundedSetupV3Hash::hash(&canonical_bytes).to_byte_array(),
+        );
+        Ok(Arc::new(Self {
+            policy,
+            counterproof_funding,
+            bond_funding,
+            canonical_bytes: canonical_bytes.into_boxed_slice(),
+            digest,
+        }))
+    }
+
+    /// Returns P0.
+    pub const fn policy(&self) -> &Arc<ThresholdV3BondPolicyP0> {
+        &self.policy
+    }
+
+    /// Returns exact C funding slots.
+    pub fn counterproof_funding(&self) -> &[ThresholdV3FundingOutput] {
+        &self.counterproof_funding
+    }
+
+    /// Returns exact B funding slots.
+    pub fn bond_funding(&self) -> &[ThresholdV3FundingOutput] {
+        &self.bond_funding
+    }
+
+    /// Returns canonical P1 bytes.
+    pub fn canonical_bytes(&self) -> &[u8] {
+        &self.canonical_bytes
+    }
+
+    /// Returns the content-derived P1 digest.
+    pub const fn digest(&self) -> ThresholdV3FundedSetupDigest {
+        self.digest
+    }
+
+    /// Selects one canonical alternative.
+    pub fn selected(
+        self: &Arc<Self>,
+        index: usize,
+    ) -> Result<ThresholdV3SelectedBinding, ThresholdV3FundedSetupError> {
+        if index >= self.policy.alternatives.len() {
+            return Err(ThresholdV3FundedSetupError::AlternativeIndexOutOfRange {
+                index,
+                count: self.policy.alternatives.len(),
+            });
+        }
+        let index_u32 = u32::try_from(index)
+            .map_err(|_| ThresholdV3FundedSetupError::EncodingLengthOverflow)?;
+        let mut commitment_input = [0u8; 36];
+        commitment_input[..32].copy_from_slice(&self.digest.0);
+        commitment_input[32..].copy_from_slice(&index_u32.to_be_bytes());
+        Ok(ThresholdV3SelectedBinding {
+            setup: Arc::clone(self),
+            index,
+            selected_commitment: ThresholdV3SelectedCommitment(
+                ThresholdSelectedAlternativeV3Hash::hash(&commitment_input).to_byte_array(),
+            ),
+        })
+    }
+
+    /// A funded research setup never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+/// Private-by-construction selected view shared by CP/R/ACK/Timeout builders.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdV3SelectedBinding {
