+
+    #[test]
+    fn persisted_manifest_mutations_fail_closed() {
+        let mut duplicate_release = valid_manifest();
+        duplicate_release.alternatives[1].release_pubkeys[0] =
+            duplicate_release.alternatives[0].release_pubkeys[0];
+        assert!(matches!(
+            PersistedFundingBlockedObservationV3::try_from_parts(
+                duplicate_release,
+                V026_BLOCKERS_V3,
+            ),
+            Err(V026PersistedObservationErrorV3::AuthorizationKeyAlias)
+        ));
+
+        let mut wrong_resolution = valid_manifest();
+        wrong_resolution.alternatives[0].resolution_outpoint.vout = 2;
+        assert!(matches!(
+            PersistedFundingBlockedObservationV3::try_from_parts(
+                wrong_resolution,
+                V026_BLOCKERS_V3,
+            ),
+            Err(V026PersistedObservationErrorV3::ResolutionOutpointMismatch { alternative: 0 })
+        ));
