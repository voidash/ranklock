+    #[test]
+    fn fault_profile_rejects_out_of_roster_and_extreme_values_without_panicking() {
+        let cases = [
+            (3, 5, 4),
+            (3, usize::MAX, usize::MAX - 1),
+            (3, 2, usize::MAX),
+            (usize::MAX, usize::MAX, usize::MAX),
+        ];
+
+        for (participant_count, threshold, max_corrupt) in cases {
+            let outcome = std::panic::catch_unwind(|| {
+                ThresholdReleaseFaultProfileV3::new(participant_count, threshold, max_corrupt)
+            });
+            assert!(
+                outcome.is_ok(),
+                "fault-profile validation panicked for n={participant_count}, t={threshold}, f={max_corrupt}"
+            );
+            assert!(
+                outcome.unwrap().is_err(),
+                "out-of-bounds fault profile was accepted for n={participant_count}, t={threshold}, f={max_corrupt}"
+            );
+        }
+
+        assert!(matches!(
+            ThresholdReleaseFaultProfileV3::new(3, 5, 4),
+            Err(
+                ThresholdReleaseFaultProfileV3Error::ThresholdOutsideParticipantRoster {
+                    participant_count: 3,
+                    threshold: 5,
+                }
+            )
+        ));
+        assert!(matches!(
+            ThresholdReleaseFaultProfileV3::new(3, 2, usize::MAX),
+            Err(
+                ThresholdReleaseFaultProfileV3Error::CorruptionOutsideParticipantRoster {
+                    participant_count: 3,
+                    max_corrupt: usize::MAX,
+                }
+            )
+        ));
+    }
