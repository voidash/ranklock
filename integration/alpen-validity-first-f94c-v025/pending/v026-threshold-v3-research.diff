+        assert!(!first.funding_eligible());
+        assert_eq!(&first.canonical_bytes()[..8], b"RL26TFS3");
+        let first_selected = first.selected(0).expect("selected 0");
+        assert!(!first_selected.funding_eligible());
+        let mut changed_c = first.counterproof_funding().to_vec();
+        changed_c[0] = funding_output(9, 0, changed_c[0].tx_out().clone());
+        let second = ThresholdV3FundedSetupP1::new(
+            Arc::clone(&policy),
