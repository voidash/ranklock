+/// Live, non-deserializable capability authorizing one attempted witness CAS write.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct VerifiedThresholdAckWitnessSelectionV3 {
+    persisted: PersistedThresholdAckWitnessSelectionV3,
+}
+
+impl VerifiedThresholdAckWitnessSelectionV3 {
+    /// Selected commitment used as the durable witness CAS key.
+    pub const fn selected_commitment(&self) -> [u8; 32] {
+        self.persisted.selected_commitment()
+    }
+
+    /// Minimal content-derived subject authenticated by this selection.
+    pub const fn subject(&self) -> &V026ThresholdAckSubjectV3 {
+        self.persisted.subject()
+    }
+
+    /// Converts to the inert validated value used for durable reads and outcomes.
+    pub fn to_persisted(&self) -> PersistedThresholdAckWitnessSelectionV3 {
+        self.persisted.clone()
+    }
+
+    /// This witness selection cannot authorize graph funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+/// Inert validated ACK witness selection reconstructed from storage.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct PersistedThresholdAckWitnessSelectionV3 {
+    subject: V026ThresholdAckSubjectV3,
+    wtxid: Wtxid,
+    participant_bitmap: u64,
+    selected_release_signatures: Vec<V026IndexedReleaseSignatureBytesV3>,
+    #[allow(clippy::large_stack_arrays)]
+    graph_signature: [u8; 64],
+    finalized_ack: Vec<u8>,
+}
+
+impl PersistedThresholdAckWitnessSelectionV3 {
+    fn from_finalized(
+        subject: V026ThresholdAckSubjectV3,
+        finalized: &FinalizedCounterproofAckThresholdV3,
+    ) -> Result<Self, V026AckWitnessSelectionErrorV3> {
+        let publication = finalized.publication();
+        let mut participant_bitmap = 0_u64;
+        for (index, selected) in publication.participant_bitmap().iter().copied().enumerate() {
+            if selected {
+                let shift = u32::try_from(index)
+                    .map_err(|_| V026AckWitnessSelectionErrorV3::ParticipantIndexOverflow)?;
+                let bit = 1_u64
+                    .checked_shl(shift)
+                    .ok_or(V026AckWitnessSelectionErrorV3::ParticipantIndexOverflow)?;
+                participant_bitmap |= bit;
+            }
+        }
+        let selected_release_signatures = publication
+            .selected_release_signatures()
+            .iter()
+            .map(|selected| {
+                Ok(V026IndexedReleaseSignatureBytesV3 {
+                    participant_index: u16::try_from(selected.participant_index())
+                        .map_err(|_| V026AckWitnessSelectionErrorV3::ParticipantIndexOverflow)?,
+                    signature: selected.signature().serialize(),
+                })
+            })
+            .collect::<Result<Vec<_>, V026AckWitnessSelectionErrorV3>>()?;
+        let candidate = Self {
+            subject,
+            wtxid: publication.wtxid(),
+            participant_bitmap,
+            selected_release_signatures,
+            graph_signature: publication.graph_signature().serialize(),
+            finalized_ack: consensus::serialize(finalized.transaction()),
+        };
+        candidate.validate_shape()?;
+        Ok(candidate)
+    }
+
+    /// Constructs an inert selection after validating parent identity, transaction,
+    /// witness, bitmap, and every BIP340 signature.
+    pub fn try_from_parts(
+        parts: V026PersistedAckWitnessPartsV3,
+    ) -> Result<Self, V026PersistedAckWitnessErrorV3> {
+        let candidate = Self {
+            subject: parts.subject,
+            wtxid: parts.wtxid,
+            participant_bitmap: parts.participant_bitmap,
+            selected_release_signatures: parts.selected_release_signatures,
+            graph_signature: parts.graph_signature,
+            finalized_ack: parts.finalized_ack,
+        };
+        candidate.validate_shape()?;
+        Ok(candidate)
+    }
+
+    /// Selected commitment used as the durable witness CAS key.
+    pub const fn selected_commitment(&self) -> [u8; 32] {
+        self.subject.selected_commitment
+    }
+
+    /// Minimal content-derived ACK authority subject.
+    pub const fn subject(&self) -> &V026ThresholdAckSubjectV3 {
+        &self.subject
+    }
+
+    /// Exact finalized witness transaction ID.
+    pub const fn wtxid(&self) -> Wtxid {
+        self.wtxid
+    }
+
+    /// Canonical participant bitmap; only the low `n` bits may be set.
+    pub const fn participant_bitmap(&self) -> u64 {
+        self.participant_bitmap
+    }
+
+    /// Exactly `t` signatures in strictly ascending participant order.
+    pub fn selected_release_signatures(&self) -> &[V026IndexedReleaseSignatureBytesV3] {
+        &self.selected_release_signatures
+    }
+
+    /// Raw graph BIP340 signature.
+    pub const fn graph_signature(&self) -> &[u8; 64] {
+        &self.graph_signature
+    }
+
+    /// Canonical consensus serialization of the exact finalized ACK.
+    pub fn finalized_ack(&self) -> &[u8] {
+        &self.finalized_ack
+    }
+
+    /// This inert selection never authorizes graph funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    fn validate_shape(&self) -> Result<(), V026PersistedAckWitnessErrorV3> {
+        validate_ack_subject(&self.subject)?;
+        let participants = usize::from(self.subject.participant_count);
+        let threshold = usize::from(self.subject.threshold);
+        let valid_bits = if participants == 64 {
+            u64::MAX
+        } else {
+            (1_u64 << participants) - 1
+        };
+        if self.participant_bitmap & !valid_bits != 0 {
+            return Err(V026PersistedAckWitnessErrorV3::BitmapUnusedBitsSet);
+        }
+        if self.participant_bitmap.count_ones() as usize != threshold {
+            return Err(V026PersistedAckWitnessErrorV3::BitmapPopcountMismatch {
+                expected: threshold,
+                actual: self.participant_bitmap.count_ones() as usize,
+            });
+        }
+        if self.selected_release_signatures.len() != threshold {
+            return Err(V026PersistedAckWitnessErrorV3::SignatureCountMismatch {
+                expected: threshold,
+                actual: self.selected_release_signatures.len(),
+            });
+        }
+        let message = Message::from_digest(self.subject.ack_sighash);
+        let mut previous = None;
+        for selected in &self.selected_release_signatures {
+            let index = usize::from(selected.participant_index);
+            if previous.is_some_and(|earlier| earlier >= index) {
+                return Err(V026PersistedAckWitnessErrorV3::SignatureOrder);
+            }
+            previous = Some(index);
+            if index >= participants || self.participant_bitmap & (1_u64 << index) == 0 {
+                return Err(V026PersistedAckWitnessErrorV3::SignatureBitmapMismatch { index });
+            }
+            let pubkey = XOnlyPublicKey::from_slice(&self.subject.release_pubkeys[index])
+                .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidReleasePubkey { index })?;
+            let signature = schnorr::Signature::from_slice(&selected.signature)
+                .map_err(|_| V026PersistedAckWitnessErrorV3::MalformedReleaseSignature { index })?;
+            secp256k1::SECP256K1
+                .verify_schnorr(&signature, &message, &pubkey)
+                .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidReleaseSignature { index })?;
+        }
+        let graph_pubkey = XOnlyPublicKey::from_slice(&self.subject.graph_pubkey)
+            .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidGraphPubkey)?;
+        let graph_signature = schnorr::Signature::from_slice(&self.graph_signature)
+            .map_err(|_| V026PersistedAckWitnessErrorV3::MalformedGraphSignature)?;
+        secp256k1::SECP256K1
+            .verify_schnorr(&graph_signature, &message, &graph_pubkey)
+            .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidGraphSignature)?;
+        validate_finalized_transaction(self, &self.subject, participants, graph_signature)
+    }
+}
+
+fn validate_finalized_transaction(
+    selection: &PersistedThresholdAckWitnessSelectionV3,
+    subject: &V026ThresholdAckSubjectV3,
+    participants: usize,
+    graph_signature: schnorr::Signature,
+) -> Result<(), V026PersistedAckWitnessErrorV3> {
+    use bitcoin::{
+        TapSighashType,
+        sighash::{Prevouts, SighashCache},
+        taproot::{ControlBlock, TapLeafHash},
+    };
+
+    let transaction: Transaction = consensus::deserialize(&selection.finalized_ack)
+        .map_err(V026PersistedAckWitnessErrorV3::TransactionDecode)?;
+    if consensus::serialize(&transaction) != selection.finalized_ack {
+        return Err(V026PersistedAckWitnessErrorV3::NonCanonicalTransaction);
+    }
+    if transaction.compute_txid() != subject.ack_txid {
+        return Err(V026PersistedAckWitnessErrorV3::AckTxidMismatch);
+    }
+    if transaction.compute_wtxid() != selection.wtxid {
+        return Err(V026PersistedAckWitnessErrorV3::AckWtxidMismatch);
+    }
+    if transaction.input.len() != 1
+        || transaction.input[0].previous_output != subject.resolution_outpoint
+    {
+        return Err(V026PersistedAckWitnessErrorV3::AckInputMismatch);
+    }
+    let witness = &transaction.input[0].witness;
+    if witness.len() != participants + 3 {
+        return Err(V026PersistedAckWitnessErrorV3::WitnessLengthMismatch {
+            expected: participants + 3,
+            actual: witness.len(),
+        });
+    }
+    for participant in 0..participants {
+        let stack_index = participants - 1 - participant;
+        let actual = witness.nth(stack_index).ok_or(
+            V026PersistedAckWitnessErrorV3::WitnessLengthMismatch {
+                expected: participants + 3,
+                actual: witness.len(),
+            },
+        )?;
+        let expected = selection
+            .selected_release_signatures
+            .iter()
+            .find(|selected| usize::from(selected.participant_index) == participant)
+            .map(|selected| selected.signature.as_slice())
+            .unwrap_or_default();
+        if actual != expected {
+            return Err(V026PersistedAckWitnessErrorV3::WitnessSignatureMismatch { participant });
+        }
+    }
+    if witness.nth(participants) != Some(graph_signature.as_ref()) {
+        return Err(V026PersistedAckWitnessErrorV3::WitnessGraphSignatureMismatch);
+    }
+    let script_bytes = witness
+        .nth(participants + 1)
+        .ok_or(V026PersistedAckWitnessErrorV3::MissingWitnessScript)?;
+    let control_bytes = witness
+        .nth(participants + 2)
+        .ok_or(V026PersistedAckWitnessErrorV3::MissingControlBlock)?;
+    let script = bitcoin::ScriptBuf::from_bytes(script_bytes.to_vec());
+    let control = ControlBlock::decode(control_bytes)
+        .map_err(V026PersistedAckWitnessErrorV3::ControlBlockDecode)?;
+    let expected_script = ack_script(subject)?;
+    if script != expected_script {
+        return Err(V026PersistedAckWitnessErrorV3::AckScriptMismatch);
+    }
+    let output_script = &subject.resolution_tx_out.script_pubkey;
+    if !output_script.is_p2tr() {
+        return Err(V026PersistedAckWitnessErrorV3::ResolutionOutputNotP2tr);
+    }
+    let output_key = XOnlyPublicKey::from_slice(&output_script.as_bytes()[2..34])
+        .map_err(|_| V026PersistedAckWitnessErrorV3::ResolutionOutputNotP2tr)?;
+    if !control.verify_taproot_commitment(secp256k1::SECP256K1, output_key, &script) {
+        return Err(V026PersistedAckWitnessErrorV3::InvalidControlBlockCommitment);
+    }
+    let sighash = SighashCache::new(&transaction)
+        .taproot_script_spend_signature_hash(
+            0,
+            &Prevouts::All(std::slice::from_ref(&subject.resolution_tx_out)),
+            TapLeafHash::from_script(&script, control.leaf_version),
+            TapSighashType::Default,
+        )
+        .map_err(V026PersistedAckWitnessErrorV3::Sighash)?;
+    if sighash.to_byte_array() != subject.ack_sighash {
+        return Err(V026PersistedAckWitnessErrorV3::AckSighashMismatch);
+    }
+    Ok(())
+}
+
+fn validate_ack_subject(
+    subject: &V026ThresholdAckSubjectV3,
+) -> Result<(), V026PersistedAckWitnessErrorV3> {
+    let participants = usize::from(subject.participant_count);
+    let threshold = usize::from(subject.threshold);
+    if !(2..=64).contains(&participants) {
+        return Err(V026PersistedAckWitnessErrorV3::SubjectParticipantCount {
+            count: participants,
+        });
+    }
+    if threshold == 0 || threshold > participants {
+        return Err(V026PersistedAckWitnessErrorV3::SubjectThreshold {
+            participants,
+            threshold,
+        });
+    }
+    if subject.release_pubkeys.len() != participants {
+        return Err(
+            V026PersistedAckWitnessErrorV3::SubjectReleaseRosterLengthMismatch {
+                expected: participants,
+                actual: subject.release_pubkeys.len(),
+            },
+        );
+    }
+    let graph = XOnlyPublicKey::from_slice(&subject.graph_pubkey)
+        .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidGraphPubkey)?;
+    let mut keys = HashSet::with_capacity(participants + 1);
+    keys.insert(graph.serialize());
+    for (index, release) in subject.release_pubkeys.iter().enumerate() {
+        XOnlyPublicKey::from_slice(release)
+            .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidReleasePubkey { index })?;
+        if !keys.insert(*release) {
+            return Err(V026PersistedAckWitnessErrorV3::SubjectAuthorizationKeyAlias { index });
+        }
+    }
+    if subject.resolution_outpoint == OutPoint::null()
+        || subject.resolution_tx_out.value == Amount::ZERO
+        || subject.resolution_tx_out.value > Amount::MAX_MONEY
+        || !subject.resolution_tx_out.script_pubkey.is_p2tr()
+        || subject.resolution_tx_out.value
+            < subject.resolution_tx_out.script_pubkey.minimal_non_dust()
+    {
+        return Err(V026PersistedAckWitnessErrorV3::InvalidSubjectResolution);
+    }
+    Ok(())
+}
+
+fn ack_script(
+    subject: &V026ThresholdAckSubjectV3,
+) -> Result<bitcoin::ScriptBuf, V026PersistedAckWitnessErrorV3> {
+    use bitcoin::{blockdata::script::Builder, opcodes};
+
+    let graph = XOnlyPublicKey::from_slice(&subject.graph_pubkey)
+        .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidGraphPubkey)?;
+    let release_pubkeys = subject
+        .release_pubkeys
+        .iter()
+        .enumerate()
+        .map(|(index, bytes)| {
+            XOnlyPublicKey::from_slice(bytes)
+                .map_err(|_| V026PersistedAckWitnessErrorV3::InvalidReleasePubkey { index })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut bytes = Builder::new()
+        .push_slice(subject.selected_commitment)
+        .push_opcode(opcodes::all::OP_DROP)
+        .push_slice(graph.serialize())
+        .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+        .into_script()
+        .into_bytes();
+    bytes.extend_from_slice(
+        threshold_multisig_script(&release_pubkeys, usize::from(subject.threshold)).as_bytes(),
+    );
+    Ok(bitcoin::ScriptBuf::from_bytes(bytes))
+}
+
+fn role_code(
+    role: V026ThresholdOutputRoleV3,
+) -> Result<V026ThresholdOutputRoleCodeV3, V026ObservationErrorV3> {
+    Ok(match role {
+        V026ThresholdOutputRoleV3::ClaimContest => V026ThresholdOutputRoleCodeV3::ClaimContest,
+        V026ThresholdOutputRoleV3::Deposit => V026ThresholdOutputRoleCodeV3::Deposit,
+        V026ThresholdOutputRoleV3::ClaimPayout => V026ThresholdOutputRoleCodeV3::ClaimPayout,
+        V026ThresholdOutputRoleV3::ContestPayout => V026ThresholdOutputRoleCodeV3::ContestPayout,
+        V026ThresholdOutputRoleV3::ContestSlash => V026ThresholdOutputRoleCodeV3::ContestSlash,
+        V026ThresholdOutputRoleV3::CounterproofFunding(index) => {
+            V026ThresholdOutputRoleCodeV3::CounterproofFunding(u32::try_from(index).map_err(
+                |_| V026ObservationErrorV3::IntegerConversion("counterproof role index"),
+            )?)
+        }
+        V026ThresholdOutputRoleV3::BondFunding(index) => {
+            V026ThresholdOutputRoleCodeV3::BondFunding(
+                u32::try_from(index)
+                    .map_err(|_| V026ObservationErrorV3::IntegerConversion("bond role index"))?,
+            )
+        }
+        V026ThresholdOutputRoleV3::Resolution(index) => V026ThresholdOutputRoleCodeV3::Resolution(
+            u32::try_from(index)
+                .map_err(|_| V026ObservationErrorV3::IntegerConversion("resolution role index"))?,
+        ),
+        V026ThresholdOutputRoleV3::SlashAuthorization(index) => {
+            V026ThresholdOutputRoleCodeV3::SlashAuthorization(u32::try_from(index).map_err(
+                |_| V026ObservationErrorV3::IntegerConversion("Slash authorization role index"),
+            )?)
+        }
+        V026ThresholdOutputRoleV3::Stake => V026ThresholdOutputRoleCodeV3::Stake,
+    })
+}
+
+fn validate_live_blockers(
+    blockers: &[V026ThresholdActivationBlockerV3],
+) -> Result<(), V026ObservationErrorV3> {
+    if blockers.len() != V026_BLOCKER_COUNT_V3 {
+        return Err(V026ObservationErrorV3::BlockerSetMismatch);
+    }
+    let mut converted = blockers
+        .iter()
+        .copied()
+        .map(V026BlockerCodeV3::from)
+        .collect::<Vec<_>>();
+    converted.sort_by_key(|blocker| *blocker as u16);
+    if converted.as_slice() != V026_BLOCKERS_V3 {
+        return Err(V026ObservationErrorV3::BlockerSetMismatch);
+    }
+    Ok(())
+}
+
+fn validate_manifest(
+    manifest: &V026ThresholdObservationManifestV3,
+) -> Result<(), V026PersistedObservationErrorV3> {
+    let participants = usize::from(manifest.participant_count);
+    let alternatives = manifest.alternatives.len();
+    if !(2..=64).contains(&participants) {
+        return Err(V026PersistedObservationErrorV3::ParticipantCount {
+            count: participants,
+        });
+    }
+    if !(2..=64).contains(&alternatives) {
+        return Err(V026PersistedObservationErrorV3::AlternativeCount {
+            count: alternatives,
+        });
+    }
+    let threshold = usize::from(manifest.threshold);
+    let max_corrupt = usize::from(manifest.max_corrupt);
+    let honest = participants.checked_sub(max_corrupt).ok_or(
+        V026PersistedObservationErrorV3::FaultProfile {
+            participants,
+            threshold,
+            max_corrupt,
+        },
+    )?;
+    if max_corrupt >= threshold || threshold > honest {
+        return Err(V026PersistedObservationErrorV3::FaultProfile {
+            participants,
+            threshold,
+            max_corrupt,
+        });
+    }
+    if manifest.participant_identity_pubkeys.len() != participants {
+        return Err(
+            V026PersistedObservationErrorV3::IdentityRosterLengthMismatch {
+                expected: participants,
+                actual: manifest.participant_identity_pubkeys.len(),
+            },
+        );
+    }
+    let graph_key = XOnlyPublicKey::from_slice(&manifest.graph_pubkey)
+        .map_err(|_| V026PersistedObservationErrorV3::InvalidGraphPubkey)?;
+    let mut all_keys = HashSet::with_capacity(1 + participants + participants * alternatives);
+    all_keys.insert(graph_key.serialize());
+    for (participant, identity) in manifest.participant_identity_pubkeys.iter().enumerate() {
+        XOnlyPublicKey::from_slice(identity)
+            .map_err(|_| V026PersistedObservationErrorV3::InvalidIdentityPubkey { participant })?;
+        if !all_keys.insert(*identity) {
+            return Err(V026PersistedObservationErrorV3::AuthorizationKeyAlias);
+        }
+    }
+    let mut selected_commitments = HashSet::with_capacity(alternatives);
+    let mut txids = HashSet::with_capacity(2 + 4 * alternatives);
+    txids.insert(manifest.contest_txid);
+    if !txids.insert(manifest.owner_payout_txid) {
+        return Err(V026PersistedObservationErrorV3::DuplicateTransactionId);
+    }
+    for (alternative, entry) in manifest.alternatives.iter().enumerate() {
+        if entry.release_pubkeys.len() != participants {
+            return Err(
+                V026PersistedObservationErrorV3::ReleaseRosterLengthMismatch {
+                    alternative,
+                    expected: participants,
+                    actual: entry.release_pubkeys.len(),
+                },
+            );
+        }
+        if !selected_commitments.insert(entry.selected_commitment) {
+            return Err(V026PersistedObservationErrorV3::DuplicateSelectedCommitment);
+        }
+        for (participant, release) in entry.release_pubkeys.iter().enumerate() {
+            XOnlyPublicKey::from_slice(release).map_err(|_| {
+                V026PersistedObservationErrorV3::InvalidReleasePubkey {
+                    participant,
+                    alternative,
+                }
+            })?;
+            if !all_keys.insert(*release) {
+                return Err(V026PersistedObservationErrorV3::AuthorizationKeyAlias);
+            }
+        }
+        if entry.resolution_outpoint
+            != OutPoint::new(
+                entry.counterproof_txid,
+                CounterproofThresholdV3Tx::RESOLUTION_VOUT,
+            )
+        {
+            return Err(
+                V026PersistedObservationErrorV3::ResolutionOutpointMismatch { alternative },
+            );
+        }
+        if entry.slash_authorization_outpoint
+            != OutPoint::new(
+                entry.ack_txid,
+                strata_bridge_tx_graph::transactions::counterproof_ack_threshold_v3::CounterproofAckThresholdV3Tx::SLASH_AUTHORIZATION_VOUT,
+            )
+        {
+            return Err(
+                V026PersistedObservationErrorV3::SlashAuthorizationOutpointMismatch {
+                    alternative,
+                },
+            );
+        }
+        if entry.resolution_tx_out.value == Amount::ZERO
+            || entry.resolution_tx_out.value > Amount::MAX_MONEY
+            || entry.resolution_tx_out.script_pubkey.is_empty()
+            || entry.resolution_tx_out.value
+                < entry.resolution_tx_out.script_pubkey.minimal_non_dust()
+        {
+            return Err(V026PersistedObservationErrorV3::InvalidResolutionOutput { alternative });
+        }
+        for txid in [
+            entry.counterproof_txid,
+            entry.ack_txid,
+            entry.timeout_txid,
+            entry.slash_txid,
+        ] {
+            if !txids.insert(txid) {
+                return Err(V026PersistedObservationErrorV3::DuplicateTransactionId);
+            }
+        }
+    }
+    validate_role_registry(manifest)
+}
+
+fn validate_role_registry(
+    manifest: &V026ThresholdObservationManifestV3,
+) -> Result<(), V026PersistedObservationErrorV3> {
+    let count = manifest.alternatives.len();
+    let mut expected = vec![
+        V026ThresholdOutputRoleCodeV3::ClaimContest,
+        V026ThresholdOutputRoleCodeV3::Deposit,
+        V026ThresholdOutputRoleCodeV3::ClaimPayout,
+        V026ThresholdOutputRoleCodeV3::Stake,
+    ];
+    expected.extend(
+        (0..count)
+            .map(|index| u32::try_from(index).map(V026ThresholdOutputRoleCodeV3::BondFunding))
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|_| V026PersistedObservationErrorV3::RoleIndexOverflow)?,
+    );
+    expected.extend([
+        V026ThresholdOutputRoleCodeV3::ContestPayout,
+        V026ThresholdOutputRoleCodeV3::ContestSlash,
+    ]);
+    for constructor in [
+        V026ThresholdOutputRoleCodeV3::CounterproofFunding,
+        V026ThresholdOutputRoleCodeV3::Resolution,
+        V026ThresholdOutputRoleCodeV3::SlashAuthorization,
+    ] {
+        expected.extend(
+            (0..count)
+                .map(|index| u32::try_from(index).map(constructor))
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|_| V026PersistedObservationErrorV3::RoleIndexOverflow)?,
+        );
+    }
+    let actual = manifest
+        .role_outpoints
+        .iter()
+        .map(|entry| entry.role)
+        .collect::<Vec<_>>();
+    if actual != expected {
+        return Err(V026PersistedObservationErrorV3::RoleRegistryMismatch);
+    }
+    require_contest_child(
+        manifest,
+        V026ThresholdOutputRoleCodeV3::ContestPayout,
+        ContestV2Tx::PAYOUT_GATE_VOUT,
+    )?;
+    require_contest_child(
+        manifest,
+        V026ThresholdOutputRoleCodeV3::ContestSlash,
+        ContestV2Tx::SLASH_GATE_VOUT,
+    )?;
+    for index in 0..count {
+        require_contest_child(
+            manifest,
+            V026ThresholdOutputRoleCodeV3::CounterproofFunding(
+                u32::try_from(index)
+                    .map_err(|_| V026PersistedObservationErrorV3::RoleIndexOverflow)?,
+            ),
+            contest_counterproof_vout(index)?,
+        )?;
+    }
+    let mut outpoints = HashSet::with_capacity(manifest.role_outpoints.len());
+    for entry in &manifest.role_outpoints {
+        if entry.outpoint == OutPoint::null() || !outpoints.insert(entry.outpoint) {
+            return Err(V026PersistedObservationErrorV3::RoleOutpointAlias);
+        }
+    }
+    for (index, alternative) in manifest.alternatives.iter().enumerate() {
+        let index =
+            u32::try_from(index).map_err(|_| V026PersistedObservationErrorV3::RoleIndexOverflow)?;
+        for (role, outpoint) in [
+            (
+                V026ThresholdOutputRoleCodeV3::Resolution(index),
+                alternative.resolution_outpoint,
+            ),
+            (
+                V026ThresholdOutputRoleCodeV3::SlashAuthorization(index),
+                alternative.slash_authorization_outpoint,
+            ),
+        ] {
+            if !manifest
+                .role_outpoints
+                .iter()
+                .any(|entry| entry.role == role && entry.outpoint == outpoint)
+            {
+                return Err(V026PersistedObservationErrorV3::RoleRegistryMismatch);
+            }
+        }
+    }
+    Ok(())
+}
+
+fn contest_counterproof_vout(alternative: usize) -> Result<u32, V026PersistedObservationErrorV3> {
+    let alternative_u32 = u32::try_from(alternative)
+        .map_err(|_| V026PersistedObservationErrorV3::ContestChildVoutOverflow { alternative })?;
+    ContestV2Tx::COUNTERPROOF_0_VOUT
+        .checked_add(alternative_u32)
+        .ok_or(V026PersistedObservationErrorV3::ContestChildVoutOverflow { alternative })
+}
+
+fn require_contest_child(
+    manifest: &V026ThresholdObservationManifestV3,
+    role: V026ThresholdOutputRoleCodeV3,
+    vout: u32,
+) -> Result<(), V026PersistedObservationErrorV3> {
+    let expected = OutPoint::new(manifest.contest_txid, vout);
+    let actual = manifest
+        .role_outpoints
+        .iter()
+        .find(|entry| entry.role == role)
+        .map(|entry| entry.outpoint)
+        .ok_or(V026PersistedObservationErrorV3::RoleRegistryMismatch)?;
+    if actual != expected {
+        return Err(
+            V026PersistedObservationErrorV3::ContestChildOutpointMismatch {
+                role,
+                expected,
+                actual,
+            },
+        );
+    }
+    Ok(())
+}
