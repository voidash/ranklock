+/// Invalid threshold connector or witness policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CounterproofResolutionThresholdV3Error {
+    /// The selected alternative cannot be represented on the research wire.
+    AlternativeIndexOverflow {
+        /// Rejected selected index.
+        index: usize,
+    },
+    /// Checked addition of base resolution and selected bond failed.
+    AmountOverflow,
+    /// The selected policy's cached bonded value disagrees with its components.
+    BondedResolutionValueMismatch {
+        /// Value derived as base resolution plus selected bond.
+        derived: Amount,
+        /// Value committed by P0.
+        committed: Amount,
+    },
+    /// The typed fault profile and concrete release-key roster disagree.
+    FaultProfileRosterMismatch {
+        /// Roster size committed by the profile.
+        profile_participants: usize,
+        /// Concrete release-key count.
+        release_keys: usize,
+    },
+    /// One release key repeats an earlier roster key.
+    DuplicateReleaseKey {
+        /// First occurrence.
+        first_index: usize,
+        /// Later duplicate occurrence.
+        duplicate_index: usize,
+    },
+    /// A release key aliases the graph key and could reuse its signature.
+    GraphReleaseKeyAlias {
+        /// Aliasing release-key index.
+        index: usize,
+    },
+    /// CSV must not be disabled.
+    ZeroTimeoutDelay,
+    /// A different draft role was supplied.
+    WrongNumsRole,
+    /// The value exceeds Bitcoin's monetary range.
+    ValueAboveMaxMoney {
+        /// Supplied value.
+        value: Amount,
+    },
+    /// NUMS derivation failed.
+    NumsDerivation(NumsDerivationError),
+    /// An authorization key aliases this output's NUMS internal/output key.
+    AuthorizationNumsKeyAlias {
+        /// Authorization role that aliases NUMS.
+        authorization: ThresholdAckAuthorizationKeyV3,
+        /// Aliased NUMS key kind.
+        nums_key_kind: ThresholdAckNumsKeyKindV3,
+    },
+    /// The value is below the actual script-dependent dust floor.
+    DustValue {
+        /// Supplied value.
+        value: Amount,
+        /// Required minimum.
+        minimum: Amount,
+    },
+    /// ACK witness slot count differs from the ordered roster length.
+    InvalidAckSignatureSlotCount {
+        /// Required slot count.
+        expected: usize,
+        /// Supplied slot count.
+        actual: usize,
+    },
+    /// ACK witness contains other than exactly `t` nonempty signatures.
+    InvalidAckSignatureCount {
+        /// Required nonempty count.
+        expected: usize,
+        /// Supplied nonempty count.
+        actual: usize,
+    },
+}
