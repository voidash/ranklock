+    contest_counterproof_v2::ContestCounterproofOutputV2,
+    ranklock_nums::BIP341_NUMS_BASE_POINT,
+    threshold_registry_v3::{ThresholdV3KeyRegistry, ThresholdV3RegistryDigest},
+    Connector, TaprootWitness,
+};
+
+sha256t_hash_newtype! {
+    struct ThresholdBondPolicyV3Tag = hash_str("RankLock/v026/threshold-v3/bond-policy/v1");
+
+    struct ThresholdBondPolicyV3Hash(_);
+}
+
+sha256t_hash_newtype! {
