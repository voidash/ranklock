+//! Research-only threshold ACK transaction for the selected-collateral profile.
+//!
+//! The exact output roster is `[B_refund, L, a_ACK]`. The constructor enforces
+//! `R = B_refund + L + a_ACK + fee_ACK`; this is intentionally not the older
+//! two-output ACK economics. Release keys and signatures are scoped to one
+//! participant and one alternative, and signatures for another alternative's
+//! exact ACK sighash are rejected.
+//!
+//! The high-level finalizer deterministically chooses the lowest `t` indices
+//! from the verified candidates supplied to that call. This is not global
+//! witness canonicality: collectors can observe different quorums and create
+//! the same txid with different wtxids. The returned publish intent exposes the
+//! selected bitmap and signatures so an external first-writer-wins store can
+//! durably adopt one exact witness before publication.
+//!
+//! This side-by-side prototype remains funding-ineligible. Its competing
+//! threshold timeout is constructed jointly by
+//! `ThresholdResolutionBranchesV3`, which returns the setup-committed operator
+//! compensation from selected collateral `B`.
+//! `TemplateFeeAllowanceV2::CounterproofAck` is reused only as a local ceiling;
+//! it is not a canonical v3 wire commitment and cannot qualify activation.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    absolute,
+    psbt::Error as PsbtError,
+    sighash::{Prevouts, SighashCache},
+    transaction::Version,
+    Amount, OutPoint, Psbt, Script, Transaction, TxIn, TxOut, Txid, Witness, Wtxid,
+};
+use bitcoin_bosd::{Descriptor, DescriptorType};
+use secp256k1::{schnorr, Message, XOnlyPublicKey, SECP256K1};
+use strata_bridge_connectors::{
+    prelude::{
+        CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdSpendPathV3,
+        KeyedAnchor, SlashAuthorizationConnectorV2, ThresholdAckAlternativeV3,
+        ThresholdReleaseFaultProfileV3,
+    },
+    Connector, ParentTx, SigningInfo,
+};
+
+use crate::transactions::{
+    template_fee_v2::{TemplateFeeAllowanceV2, TemplateFeeAllowanceV2Error, TemplateKindV2},
+    PresignedTx,
+};
+
+/// Exact selected resolution outpoint.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofAckThresholdV3Data {
+    /// Resolution output created by this exact selected alternative.
+    pub resolution_outpoint: OutPoint,
+    /// Setup-committed identity of the selected alternative.
+    pub alternative: ThresholdAckAlternativeV3,
+}
+
+/// Typed setup-committed return of selected collateral `B`.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct SelectedCollateralRefundV3 {
+    descriptor: Descriptor,
+    controller_key: XOnlyPublicKey,
+    value: Amount,
+}
+
+impl SelectedCollateralRefundV3 {
+    /// Constructs a non-dust P2TR selected-collateral refund.
+    pub fn new(
+        descriptor: Descriptor,
+        value: Amount,
+    ) -> Result<Self, SelectedCollateralRefundV3Error> {
+        if descriptor.type_tag() != DescriptorType::P2tr {
+            return Err(SelectedCollateralRefundV3Error::InvalidDescriptorType {
+                actual: descriptor.type_tag(),
+            });
+        }
+        let controller_key = XOnlyPublicKey::from_slice(descriptor.payload())
+            .map_err(|_| SelectedCollateralRefundV3Error::InvalidDescriptorPayload)?;
+        if value > Amount::MAX_MONEY {
+            return Err(SelectedCollateralRefundV3Error::MoneyRange { value });
+        }
+        let minimum = descriptor.to_script().minimal_non_dust();
+        if value < minimum {
+            return Err(SelectedCollateralRefundV3Error::DustValue { value, minimum });
+        }
+        Ok(Self {
+            descriptor,
+            controller_key,
+            value,
+        })
+    }
+
+    /// Returns the setup-committed P2TR descriptor.
+    pub const fn descriptor(&self) -> &Descriptor {
+        &self.descriptor
+    }
+
+    /// Returns the descriptor's P2TR output/controller key.
+    pub const fn controller_key(&self) -> XOnlyPublicKey {
+        self.controller_key
+    }
+
+    /// Returns the exact selected-collateral refund value.
+    pub const fn value(&self) -> Amount {
+        self.value
+    }
+
+    fn tx_out(&self) -> TxOut {
+        TxOut {
+            value: self.value,
+            script_pubkey: self.descriptor.to_script(),
+        }
+    }
+}
+
+/// Invalid selected-collateral refund policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SelectedCollateralRefundV3Error {
+    /// Only the setup profile's P2TR descriptor form is accepted.
+    InvalidDescriptorType {
+        /// Rejected descriptor type.
+        actual: DescriptorType,
+    },
+    /// A P2TR descriptor carried a malformed x-only key.
+    InvalidDescriptorPayload,
+    /// The refund value exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Rejected value.
+        value: Amount,
+    },
+    /// The refund value is below its exact script's dust floor.
+    DustValue {
+        /// Rejected value.
+        value: Amount,
+        /// Required minimum.
+        minimum: Amount,
+    },
+}
+
+impl fmt::Display for SelectedCollateralRefundV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidDescriptorType { actual } => {
+                write!(f, "selected-collateral refund must be P2TR, got {actual}")
+            }
+            Self::InvalidDescriptorPayload => {
+                f.write_str("selected-collateral P2TR payload is not a valid x-only key")
+            }
+            Self::MoneyRange { value } => {
+                write!(f, "selected-collateral refund {value} exceeds MoneyRange")
+            }
+            Self::DustValue { value, minimum } => write!(
+                f,
+                "selected-collateral refund {value} is below its dust floor {minimum}"
+            ),
+        }
+    }
+}
+
+impl Error for SelectedCollateralRefundV3Error {}
+
+/// One participant signature paired with its setup-committed roster index.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub struct IndexedReleaseSignatureV3 {
+    participant_index: usize,
+    signature: schnorr::Signature,
+}
+
+impl IndexedReleaseSignatureV3 {
+    /// Associates one typed BIP340 signature with its roster position.
+    pub const fn new(participant_index: usize, signature: schnorr::Signature) -> Self {
+        Self {
+            participant_index,
+            signature,
+        }
+    }
+
+    /// Returns the setup-committed participant index.
+    pub const fn participant_index(&self) -> usize {
+        self.participant_index
+    }
+
+    /// Returns the typed 64-byte BIP340 signature.
+    pub const fn signature(&self) -> schnorr::Signature {
+        self.signature
+    }
+}
+
+/// Exact finalized threshold ACK publication record.
+///
+/// Setup/locked-set capsule adoption remains an external durable CAS. This
+/// object binds only the concrete Bitcoin transaction and witness finalized by
+/// this local constructor.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct ThresholdAckPublicationV3 {
+    txid: Txid,
+    wtxid: Wtxid,
+    resolution_outpoint: OutPoint,
+    alternative: ThresholdAckAlternativeV3,
+    fault_profile: ThresholdReleaseFaultProfileV3,
+    release_pubkeys: Vec<XOnlyPublicKey>,
+    exact_sighash: Message,
+    participant_bitmap: Vec<bool>,
+    selected_release_signatures: Vec<IndexedReleaseSignatureV3>,
+    graph_signature: schnorr::Signature,
+    witness: Witness,
+}
+
+impl ThresholdAckPublicationV3 {
+    /// Returns the non-witness transaction identifier computed from finalized bytes.
+    pub const fn txid(&self) -> Txid {
+        self.txid
+    }
+
+    /// Returns the witness transaction identifier computed from finalized bytes.
+    pub const fn wtxid(&self) -> Wtxid {
+        self.wtxid
+    }
+
+    /// Returns the exact resolution output consumed by this ACK.
+    pub const fn resolution_outpoint(&self) -> OutPoint {
+        self.resolution_outpoint
+    }
+
+    /// Returns the setup-committed selected alternative.
+    pub const fn alternative(&self) -> ThresholdAckAlternativeV3 {
+        self.alternative
+    }
+
+    /// Returns the exact static fault profile.
+    pub const fn fault_profile(&self) -> ThresholdReleaseFaultProfileV3 {
+        self.fault_profile
+    }
+
+    /// Returns release keys in exact setup roster order.
+    pub fn release_pubkeys(&self) -> &[XOnlyPublicKey] {
+        &self.release_pubkeys
+    }
+
+    /// Returns the exact Taproot sighash signed by graph and release keys.
+    pub const fn exact_sighash(&self) -> Message {
+        self.exact_sighash
+    }
+
+    /// Returns one bit per release key in canonical roster order.
+    pub fn participant_bitmap(&self) -> &[bool] {
+        &self.participant_bitmap
+    }
+
+    /// Returns exactly `t` selected signatures in ascending index order.
+    pub fn selected_release_signatures(&self) -> &[IndexedReleaseSignatureV3] {
+        &self.selected_release_signatures
+    }
+
+    /// Returns the exact-parent graph signature in the adopted witness.
+    pub const fn graph_signature(&self) -> schnorr::Signature {
+        self.graph_signature
+    }
+
+    /// Returns the complete adopted script-path witness bytes.
+    pub const fn witness(&self) -> &Witness {
+        &self.witness
+    }
+}
+
+/// Final transaction plus the witness-selection intent that must be persisted.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct FinalizedCounterproofAckThresholdV3 {
+    transaction: Transaction,
+    publication: ThresholdAckPublicationV3,
+}
+
+impl FinalizedCounterproofAckThresholdV3 {
+    /// Returns the exact finalized Bitcoin transaction.
+    pub const fn transaction(&self) -> &Transaction {
+        &self.transaction
+    }
+
+    /// Returns the exact selected-quorum publication intent.
+    pub const fn publication(&self) -> &ThresholdAckPublicationV3 {
+        &self.publication
+    }
+
+    /// Consumes the capsule and returns the finalized transaction.
+    pub fn into_transaction(self) -> Transaction {
+        self.transaction
+    }
+}
+
+/// Threshold ACK parent with selected-collateral refund.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofAckThresholdV3Tx {
+    psbt: Psbt,
+    prevouts: [TxOut; Self::N_INPUTS],
+    resolution_connector: CounterproofResolutionThresholdConnectorV3,
+    selected_collateral_refund: SelectedCollateralRefundV3,
+    slash_authorization_connector: SlashAuthorizationConnectorV2,
+    cpfp_connector: KeyedAnchor,
+}
+
+impl CounterproofAckThresholdV3Tx {
+    /// Selected-collateral refund output index.
+    pub const SELECTED_COLLATERAL_REFUND_VOUT: u32 = 0;
+    /// ACK-created Slash authorization output index.
+    pub const SLASH_AUTHORIZATION_VOUT: u32 = 1;
+    /// Dedicated ACK anchor output index.
+    pub const CPFP_VOUT: u32 = 2;
+    /// Number of transaction inputs.
+    pub const N_INPUTS: usize = 1;
+
+    /// Constructs canonical `[B_refund, L, a_ACK]` outputs.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new(
+        data: CounterproofAckThresholdV3Data,
+        resolution_connector: CounterproofResolutionThresholdConnectorV3,
+        selected_collateral_refund: SelectedCollateralRefundV3,
+        slash_authorization_connector: SlashAuthorizationConnectorV2,
+        cpfp_connector: KeyedAnchor,
+        fee: Amount,
+        fee_allowance: TemplateFeeAllowanceV2,
+    ) -> Result<Self, CounterproofAckThresholdV3Error> {
+        if data.alternative != resolution_connector.alternative() {
+            return Err(CounterproofAckThresholdV3Error::AlternativeMismatch {
+                data: data.alternative,
+                connector: resolution_connector.alternative(),
+            });
+        }
+        let network = resolution_connector.network();
+        for (connector, candidate) in [
+            (
+                "slash authorization",
+                slash_authorization_connector.network(),
+            ),
+            ("threshold ACK anchor", cpfp_connector.network()),
+        ] {
+            if candidate != network {
+                return Err(CounterproofAckThresholdV3Error::NetworkMismatch { connector });
+            }
+        }
+        if slash_authorization_connector.graph_pubkey() != resolution_connector.graph_pubkey() {
+            return Err(CounterproofAckThresholdV3Error::GraphKeyMismatch);
+        }
+
+        let refund_output = selected_collateral_refund.tx_out();
+        let authorization_output = slash_authorization_connector.tx_out();
+        let cpfp_output = cpfp_connector.tx_out();
+        for (field, value) in [
+            ("threshold resolution prevout", resolution_connector.value()),
+            ("selected-collateral refund", refund_output.value),
+            ("Slash authorization output", authorization_output.value),
+            ("threshold ACK anchor", cpfp_output.value),
+            ("threshold ACK fee", fee),
+        ] {
+            ensure_money_range(field, value)?;
+        }
+        fee_allowance
+            .validate(TemplateKindV2::CounterproofAck, fee)
+            .map_err(CounterproofAckThresholdV3Error::FeeAllowance)?;
+        ensure_non_dust("selected-collateral refund", &refund_output)?;
+        ensure_non_dust("Slash authorization output", &authorization_output)?;
+        ensure_non_dust("threshold ACK anchor", &cpfp_output)?;
+        validate_key_domain_separation(
+            &resolution_connector,
+            &selected_collateral_refund,
+            &slash_authorization_connector,
+            &cpfp_connector,
+        )?;
+        validate_output_script_separation([
+            &refund_output.script_pubkey,
+            &authorization_output.script_pubkey,
+            &cpfp_output.script_pubkey,
+        ])?;
+
+        let output_value = refund_output
+            .value
+            .checked_add(authorization_output.value)
+            .and_then(|value| value.checked_add(cpfp_output.value))
+            .ok_or(CounterproofAckThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("threshold ACK total output", output_value)?;
+        let required_input = output_value
+            .checked_add(fee)
+            .ok_or(CounterproofAckThresholdV3Error::AmountOverflow)?;
+        ensure_money_range("threshold ACK total input", required_input)?;
+        if resolution_connector.value() != required_input {
+            return Err(CounterproofAckThresholdV3Error::ValueNotConserved {
+                input: resolution_connector.value(),
+                output: output_value,
+                fee,
+            });
+        }
+
+        let prevouts = [resolution_connector.tx_out()];
+        let tx = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: data.resolution_outpoint,
+                sequence: resolution_connector
+                    .sequence(CounterproofResolutionThresholdSpendPathV3::Ack),
+                ..Default::default()
+            }],
+            output: vec![refund_output, authorization_output, cpfp_output],
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(CounterproofAckThresholdV3Error::Psbt)?;
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+
+        Ok(Self {
+            psbt,
+            prevouts,
+            resolution_connector,
+            selected_collateral_refund,
+            slash_authorization_connector,
+            cpfp_connector,
+        })
+    }
+
+    /// This draft script/economics/wire profile cannot authorize funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+
+    /// Returns the exact selected-collateral refund commitment.
+    pub const fn selected_collateral_refund(&self) -> &SelectedCollateralRefundV3 {
+        &self.selected_collateral_refund
+    }
+
+    /// Returns the ACK-created Slash authorization connector.
+    pub const fn slash_authorization_connector(&self) -> &SlashAuthorizationConnectorV2 {
+        &self.slash_authorization_connector
+    }
+
+    /// Returns release keys in exact setup roster order.
+    pub fn release_pubkeys(&self) -> &[XOnlyPublicKey] {
+        self.resolution_connector.release_pubkeys()
+    }
+
+    /// Returns the exact threshold.
+    pub const fn threshold(&self) -> usize {
+        self.resolution_connector.threshold()
+    }
+
+    /// Verifies all supplied candidates and chooses the lowest `t` indices.
+    ///
+    /// Determinism is relative to this supplied candidate set. The returned
+    /// publish intent must be durably adopted by a higher-level first-writer-
+    /// wins state machine before exposing the witness.
+    pub fn finalize(
+        self,
+        candidate_release_signatures: Vec<IndexedReleaseSignatureV3>,
+        graph_signature: schnorr::Signature,
+    ) -> Result<FinalizedCounterproofAckThresholdV3, CounterproofAckThresholdV3Error> {
+        let signing_info = self.signing_info()[0];
+        SECP256K1
+            .verify_schnorr(
+                &graph_signature,
+                &signing_info.sighash,
+                &self.resolution_connector.graph_pubkey(),
+            )
+            .map_err(|_| CounterproofAckThresholdV3Error::InvalidGraphSignature)?;
+
+        let mut seen = vec![false; self.resolution_connector.release_pubkeys().len()];
+        let mut verified = Vec::with_capacity(candidate_release_signatures.len());
+        for candidate in candidate_release_signatures {
+            let index = candidate.participant_index;
+            let Some(release_pubkey) = self.resolution_connector.release_pubkeys().get(index)
+            else {
+                return Err(CounterproofAckThresholdV3Error::UnknownParticipantIndex {
+                    index,
+                    participants: self.resolution_connector.release_pubkeys().len(),
+                });
+            };
+            if seen[index] {
+                return Err(CounterproofAckThresholdV3Error::DuplicateParticipantIndex { index });
+            }
+            seen[index] = true;
+            SECP256K1
+                .verify_schnorr(&candidate.signature, &signing_info.sighash, release_pubkey)
+                .map_err(|_| CounterproofAckThresholdV3Error::InvalidReleaseSignature { index })?;
+            verified.push(candidate);
+        }
+        if verified.len() < self.resolution_connector.threshold() {
+            return Err(
+                CounterproofAckThresholdV3Error::InsufficientValidSignatures {
+                    required: self.resolution_connector.threshold(),
+                    actual: verified.len(),
+                },
+            );
+        }
+        verified.sort_by_key(IndexedReleaseSignatureV3::participant_index);
+        verified.truncate(self.resolution_connector.threshold());
+
+        let mut participant_bitmap = vec![false; self.resolution_connector.release_pubkeys().len()];
+        let mut ordered_release_signatures =
+            vec![None; self.resolution_connector.release_pubkeys().len()];
+        for selected in &verified {
+            participant_bitmap[selected.participant_index] = true;
+            ordered_release_signatures[selected.participant_index] = Some(selected.signature);
+        }
+        let witness = self
+            .resolution_connector
+            .ack_witness(graph_signature, ordered_release_signatures)
+            .map_err(CounterproofAckThresholdV3Error::ConnectorWitness)?;
+
+        let mut psbt = self.psbt;
+        self.resolution_connector
+            .finalize_input(&mut psbt.inputs[0], &witness);
+        let transaction = psbt.extract_tx_unchecked_fee_rate();
+        let finalized_witness = transaction.input[0].witness.clone();
+        Ok(FinalizedCounterproofAckThresholdV3 {
+            publication: ThresholdAckPublicationV3 {
+                txid: transaction.compute_txid(),
+                wtxid: transaction.compute_wtxid(),
+                resolution_outpoint: transaction.input[0].previous_output,
+                alternative: self.resolution_connector.alternative(),
+                fault_profile: self.resolution_connector.fault_profile(),
+                release_pubkeys: self.resolution_connector.release_pubkeys().to_vec(),
+                exact_sighash: signing_info.sighash,
+                participant_bitmap,
+                selected_release_signatures: verified,
+                graph_signature,
+                witness: finalized_witness,
+            },
+            transaction,
+        })
+    }
+}
+
+fn ensure_money_range(
+    field: &'static str,
+    value: Amount,
+) -> Result<(), CounterproofAckThresholdV3Error> {
+    if value > Amount::MAX_MONEY {
+        return Err(CounterproofAckThresholdV3Error::MoneyRange { field, value });
+    }
+    Ok(())
+}
+
+fn ensure_non_dust(
+    field: &'static str,
+    output: &TxOut,
+) -> Result<(), CounterproofAckThresholdV3Error> {
+    let minimum = output.script_pubkey.minimal_non_dust();
+    if output.value < minimum {
+        return Err(CounterproofAckThresholdV3Error::DustOutput {
+            field,
+            value: output.value,
+            minimum,
+        });
+    }
+    Ok(())
+}
+
+fn validate_key_domain_separation(
+    resolution: &CounterproofResolutionThresholdConnectorV3,
+    refund: &SelectedCollateralRefundV3,
+    authorization: &SlashAuthorizationConnectorV2,
+    cpfp: &KeyedAnchor,
+) -> Result<(), CounterproofAckThresholdV3Error> {
+    let resolution_output_key = resolution.spend_info().output_key().to_x_only_public_key();
+    let authorization_output_key = authorization
+        .spend_info()
+        .output_key()
+        .to_x_only_public_key();
+    let cpfp_output_key = cpfp.spend_info().output_key().to_x_only_public_key();
+    let mut domains = vec![
+        (ThresholdAckKeyDomainV3::Graph, resolution.graph_pubkey()),
+        (
+            ThresholdAckKeyDomainV3::ResolutionNumsInternal,
+            resolution.internal_key(),
+        ),
+        (
+            ThresholdAckKeyDomainV3::ResolutionNumsOutput,
+            resolution_output_key,
+        ),
+        (
+            ThresholdAckKeyDomainV3::SlashAuthorizationNumsInternal,
+            authorization.internal_key(),
+        ),
+        (
+            ThresholdAckKeyDomainV3::SlashAuthorizationNumsOutput,
+            authorization_output_key,
+        ),
+        (
+            ThresholdAckKeyDomainV3::SelectedCollateralRefund,
+            refund.controller_key(),
+        ),
+        (ThresholdAckKeyDomainV3::CpfpInternal, cpfp.internal_key()),
+        (ThresholdAckKeyDomainV3::CpfpOutput, cpfp_output_key),
+    ];
+    domains.extend(
+        resolution
+            .release_pubkeys()
+            .iter()
+            .copied()
+            .enumerate()
+            .map(|(index, key)| (ThresholdAckKeyDomainV3::Release { index }, key)),
+    );
+
+    for second_index in 0..domains.len() {
+        if let Some((first_domain, _)) = domains[..second_index]
+            .iter()
+            .find(|(_, key)| *key == domains[second_index].1)
+        {
+            return Err(CounterproofAckThresholdV3Error::KeyDomainAlias {
+                first: *first_domain,
+                second: domains[second_index].0,
+            });
+        }
+    }
+    Ok(())
+}
+
+fn validate_output_script_separation(
+    scripts: [&Script; 3],
+) -> Result<(), CounterproofAckThresholdV3Error> {
+    for second_index in 0..scripts.len() {
+        if scripts[..second_index].contains(&scripts[second_index]) {
+            return Err(CounterproofAckThresholdV3Error::OutputScriptCollision {
+                index: second_index,
+            });
+        }
+    }
+    Ok(())
+}
