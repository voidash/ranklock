+                .finalize(vec![signatures[0], signatures[0]], graph_signature),
+            Err(CounterproofAckThresholdV3Error::DuplicateParticipantIndex { index: 0 })
+        ));
+        let wrong_message = Message::from_digest([0x42; 32]);
