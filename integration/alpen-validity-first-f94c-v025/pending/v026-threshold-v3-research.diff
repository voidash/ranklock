+    fn registry() -> Arc<ThresholdV3KeyRegistry> {
+        let fault = ThresholdReleaseFaultProfileV3::new(3, 2, 1).expect("fault profile");
+        let participants = (0..3)
+            .map(|participant| {
+                let identity = keypair(10 + participant as u32);
+                let identity_pubkey = identity.x_only_public_key().0;
+                let control = [20 + participant as u8; 32];
+                let releases = (0..ALTERNATIVES)
+                    .map(|alternative| key(100 + (participant * ALTERNATIVES + alternative) as u32))
+                    .collect::<Vec<_>>();
+                let digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                    SETUP_DIGEST,
+                    fault,
+                    ALTERNATIVES,
+                    participant,
+                    identity_pubkey,
+                    control,
+                    &releases,
+                )
+                .expect("digest");
+                ThresholdV3ParticipantIdentity::new(
+                    SETUP_DIGEST,
+                    fault,
+                    ALTERNATIVES,
+                    participant,
+                    identity_pubkey,
+                    control,
+                    releases,
+                    identity.sign_schnorr(Message::from_digest(digest)),
+                )
+                .expect("participant")
+            })
+            .collect();
+        Arc::new(
+            ThresholdV3KeyRegistry::new(SETUP_DIGEST, fault, ALTERNATIVES, participants)
+                .expect("registry"),
+        )
+    }
+
+    fn destination(
+        number: u32,
+        principal: u8,
+        authority: u8,
+    ) -> ThresholdV3ControlledP2trDestination {
+        ThresholdV3ControlledP2trDestination::new(key(number), [principal; 32], [authority; 32])
+            .expect("destination")
+    }
+
+    fn descriptor(number: u32) -> Descriptor {
+        Descriptor::new_p2tr(&key(number).serialize()).expect("descriptor")
+    }
+
+    fn allowance(kind: TemplateKindV2, fee: Amount) -> TemplateFeeAllowanceV2 {
+        TemplateFeeAllowanceV2::new(kind, fee).expect("allowance")
+    }
+
+    fn nums(role: ResearchV0NumsRole, index: u32) -> ResearchV0NumsContext {
+        ResearchV0NumsContext::new(SETUP_DIGEST, role, index)
+    }
+
+    fn keypair(number: u32) -> Keypair {
+        let mut bytes = [0u8; 32];
+        bytes[28..].copy_from_slice(&number.to_be_bytes());
+        let secret = SecretKey::from_slice(&bytes).expect("valid secret");
+        Keypair::from_secret_key(SECP256K1, &secret)
+    }
+
+    fn key(number: u32) -> XOnlyPublicKey {
+        keypair(number).x_only_public_key().0
+    }
