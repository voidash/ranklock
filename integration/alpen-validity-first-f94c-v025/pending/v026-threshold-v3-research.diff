+    #[test]
+    fn derives_both_children_from_selected_cp_and_contest_parents() {
+        let fixture = Fixture::new();
+        let branches = ThresholdResolutionBranchesV3::from_parents(
+            fixture.selected.clone(),
+            &fixture.counterproof,
+            &fixture.contest,
+            fixture.plan(),
+        )
+        .expect("joint branches");
+
+        assert_eq!(branches.selected_binding().index(), 1);
+        assert_eq!(
+            branches.resolution_outpoint(),
+            fixture.counterproof.resolution_outpoint()
+        );
+        assert_eq!(
+            branches.contest_slash_outpoint(),
+            fixture.contest.slash_gate_outpoint()
+        );
+        assert_eq!(
+            branches.ack().as_ref().input[0].previous_output,
+            branches.timeout().as_ref().input[0].previous_output
+        );
+        assert_eq!(
+            branches.timeout().as_ref().input[1].previous_output,
+            fixture.contest.slash_gate_outpoint()
+        );
+        assert_eq!(
+            branches.ack().selected_collateral_refund().value(),
+            BOND_VALUE
+        );
+        assert_eq!(
+            branches.timeout().operator_compensation().value(),
+            BOND_VALUE
+        );
+        assert!(!branches.funding_eligible());
+    }
