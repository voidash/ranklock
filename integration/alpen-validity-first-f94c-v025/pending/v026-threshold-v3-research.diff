+            ThresholdV3KeyRegistry::new(TEST_SETUP, profile, 2, rows),
+            Err(ThresholdV3KeyRegistryError::InvalidContributionSignature {
+                participant_index: 1
+            })
+        ));
+
+        let mut rows: Vec<_> = (0..3).map(|index| participant(index, 2)).collect();
+        let mut releases = rows[1].release_pubkeys().to_vec();
+        releases[0] = rows[0].release_pubkeys[1];
+        rows[1] = participant_with(
+            TEST_SETUP,
+            profile,
+            2,
+            1,
+            &keypair(2),
+            rows[1].control_domain_digest(),
+            releases,
+        );
+        assert!(matches!(
+            ThresholdV3KeyRegistry::new(TEST_SETUP, profile, 2, rows),
+            Err(ThresholdV3KeyRegistryError::DuplicateReleaseKey { .. })
+        ));
+
+        let mut rows: Vec<_> = (0..3).map(|index| participant(index, 2)).collect();
+        let mut releases = rows[2].release_pubkeys().to_vec();
+        releases[1] = rows[0].identity_pubkey;
+        rows[2] = participant_with(
+            TEST_SETUP,
+            profile,
+            2,
+            2,
+            &keypair(3),
+            rows[2].control_domain_digest(),
+            releases,
+        );
+        assert!(matches!(
+            ThresholdV3KeyRegistry::new(TEST_SETUP, profile, 2, rows),
+            Err(ThresholdV3KeyRegistryError::ReleaseIdentityKeyAlias { .. })
+        ));
+    }
+
+    #[test]
+    fn invalid_dimensions_and_extremes_never_panic() {
+        let registry_attempt = catch_unwind(AssertUnwindSafe(|| {
+            ThresholdV3KeyRegistry::new(
+                [1; 32],
+                ThresholdReleaseFaultProfileV3::new(3, 2, 1).expect("profile"),
+                usize::MAX,
+                Vec::new(),
+            )
+        }));
+        let zero_control_attempt = catch_unwind(AssertUnwindSafe(|| {
+            ThresholdV3ParticipantIdentity::new(
+                TEST_SETUP,
+                test_profile(),
+                2,
+                0,
+                key(1),
+                [0; 32],
+                vec![key(50), key(51)],
+                keypair(1).sign_schnorr(Message::from_digest([1; 32])),
+            )
+        }));
+        let invalid_signature_attempt = catch_unwind(AssertUnwindSafe(|| {
+            ThresholdV3ParticipantIdentity::new(
+                TEST_SETUP,
+                test_profile(),
+                2,
+                0,
+                key(1),
+                [1; 32],
+                vec![key(50), key(51)],
+                keypair(2).sign_schnorr(Message::from_digest([1; 32])),
+            )
+        }));
+        assert!(registry_attempt.is_ok());
+        assert!(zero_control_attempt.is_ok());
+        assert!(invalid_signature_attempt.is_ok());
+        assert!(matches!(
+            registry_attempt.as_ref().expect("no panic"),
+            Err(ThresholdV3KeyRegistryError::InvalidAlternativeCount { actual: usize::MAX })
+        ));
+        assert!(matches!(
+            ThresholdV3KeyRegistry::new(
+                [1; 32],
+                ThresholdReleaseFaultProfileV3::new(3, 2, 1).expect("profile"),
+                5,
+                Vec::new(),
+            ),
+            Err(ThresholdV3KeyRegistryError::InvalidAlternativeCount { actual: 5 })
+        ));
+        assert!(matches!(
+            ThresholdV3KeyRegistry::new(
+                [1; 32],
+                ThresholdReleaseFaultProfileV3::new(64, 33, 31).expect("profile"),
+                2,
+                Vec::new(),
+            ),
+            Err(ThresholdV3KeyRegistryError::ReleaseMatrixTooLarge {
+                alternatives: 2,
+                participants: 64,
+                max_cells: 64,
+            })
+        ));
+        assert!(matches!(
+            ThresholdV3ParticipantIdentity::contribution_digest_for(
+                [1; 32],
+                ThresholdReleaseFaultProfileV3::new(17, 9, 8).expect("profile"),
+                4,
+                0,
+                key(1),
+                [2; 32],
+                &[key(2), key(3), key(4), key(5)],
+            ),
+            Err(ThresholdV3ParticipantIdentityError::ReleaseMatrixTooLarge {
+                alternatives: 4,
+                participants: 17,
+                max_cells: 64,
+            })
+        ));
+    }
+
+    #[test]
+    fn measured_joint_registry_boundary_is_accepted_and_bounded() {
+        let profile = ThresholdReleaseFaultProfileV3::new(16, 9, 7).expect("boundary profile");
+        let participants = (0..16)
+            .map(|participant_index| {
+                let mut control = [0u8; 32];
+                control[30..].copy_from_slice(&(participant_index as u16 + 1).to_be_bytes());
+                let identity = numbered_keypair(1 + participant_index as u32);
+                let identity_pubkey = identity.x_only_public_key().0;
+                let release_pubkeys: Vec<_> = (0..4)
+                    .map(|alternative| {
+                        numbered_key(1_000 + (participant_index * 4 + alternative) as u32)
+                    })
+                    .collect();
+                let digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                    [0x55; 32],
+                    profile,
+                    4,
+                    participant_index,
+                    identity_pubkey,
+                    control,
+                    &release_pubkeys,
+                )
+                .expect("maximum contribution digest");
+                ThresholdV3ParticipantIdentity::new(
+                    [0x55; 32],
+                    profile,
+                    4,
+                    participant_index,
+                    identity_pubkey,
+                    control,
+                    release_pubkeys,
+                    identity.sign_schnorr(Message::from_digest(digest)),
+                )
+                .expect("maximum participant row")
+            })
+            .collect();
+        let registry = ThresholdV3KeyRegistry::new([0x55; 32], profile, 4, participants)
+            .expect("4 by 16 registry");
+        assert_eq!(registry.canonical_bytes().len(), 3_672);
+        assert_eq!(
+            registry.release_pubkeys(3).expect("last alternative").len(),
+            16
+        );
+    }
+}
