+
+impl ThresholdV3BondAlternativePolicy {
+    /// Constructs one alternative's exact predecessor-only economic policy.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        counterproof_output: ContestCounterproofOutputV2,
+        counterproof_return: ThresholdV3ControlledP2trDestination,
+        bond_value: Amount,
+        bond_refund: ThresholdV3ControlledP2trDestination,
+        operator_compensation: ThresholdV3ControlledP2trDestination,
+        recovery: ThresholdV3ControlledP2trDestination,
+        base_resolution_value: Amount,
+        timeout_delay: relative::Height,
+    ) -> Result<Self, ThresholdV3BondAlternativePolicyError> {
+        for (field, value) in [
+            ("counterproof output", counterproof_output.value()),
+            ("bond", bond_value),
+            ("base resolution", base_resolution_value),
+        ] {
+            if value > Amount::MAX_MONEY {
+                return Err(ThresholdV3BondAlternativePolicyError::MoneyRange { field, value });
+            }
+        }
+        if timeout_delay.value() == 0 {
+            return Err(ThresholdV3BondAlternativePolicyError::ZeroTimeoutDelay);
+        }
+        let bonded_resolution_value = base_resolution_value
+            .checked_add(bond_value)
+            .ok_or(ThresholdV3BondAlternativePolicyError::AmountOverflow)?;
