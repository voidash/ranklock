+            ContestV2Data { claim_txid },
+            claim.clone(),
+            ContestV2OutputPlan {
+                proof_connector: proof,
+                payout_gate: payout,
+                slash_gate: slash,
+                alternatives: counterproofs
+                    .iter()
+                    .copied()
+                    .zip(cpfp_keys.iter().copied())
+                    .map(|(counterproof_output, cpfp_pubkey)| ContestAlternativeV2 {
+                        counterproof_output,
+                        cpfp_pubkey,
+                    })
+                    .collect(),
+                cpfp_anchor_value: CONTEST_ANCHOR_VALUE,
