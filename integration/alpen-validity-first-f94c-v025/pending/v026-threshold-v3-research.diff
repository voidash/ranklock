+/// Structural threshold-v3 assembly failure.
+#[derive(Debug)]
+pub enum V026ThresholdGraphV3Error {
+    /// Claim outpoint did not name the canonical Contest vout.
+    InvalidClaimVout {
+        /// Supplied vout.
+        actual: u32,
+        /// Canonical Claim Contest vout.
+        expected: u32,
+    },
+    /// Two external roles reused one outpoint.
+    ExternalOutpointAlias {
+        /// Earlier external role.
+        first_role: &'static str,
+        /// Conflicting external role.
+        second_role: &'static str,
+        /// Reused outpoint.
+        outpoint: OutPoint,
+    },
+    /// An external or derived role used Bitcoin's null outpoint sentinel.
+    NullRoleOutpoint {
+        /// Role carrying the null outpoint.
+        role: V026ThresholdOutputRoleV3,
+    },
+    /// Two roles in the complete graph reused one outpoint.
+    RoleOutpointAlias {
+        /// Earlier role in canonical registry order.
+        first: V026ThresholdOutputRoleV3,
+        /// Conflicting later role.
+        second: V026ThresholdOutputRoleV3,
+        /// Reused outpoint.
+        outpoint: OutPoint,
+    },
+    /// A Contest-derived output collided with an external binding.
+    DerivedExternalOutpointAlias {
+        /// Contest-derived role.
+        derived_role: &'static str,
+        /// Conflicting external role.
+        external_role: &'static str,
+        /// Reused outpoint.
+        outpoint: OutPoint,
+    },
+    /// P0, service, and bond rosters differ.
+    RosterLengthMismatch {
+        /// P0 alternatives.
+        policy: usize,
+        /// Service alternatives.
+        alternatives: usize,
+        /// External bond bindings.
+        bonds: usize,
+    },
+    /// P0 unexpectedly has no alternatives.
+    EmptyPolicyRoster,
+    /// A Contest shared parent uses another graph authorization key.
+    GraphKeyMismatch {
+        /// Mismatching connector role.
+        component: &'static str,
+    },
+    /// Claim's internal N/N/watchtower authorization roster is invalid.
+    ClaimAuthorization(ClaimContestConnectorError),
+    /// Claim watchtower order differs from the Contest MultiAnchor order.
+    ClaimServiceRosterMismatch,
+    /// Two locally visible controller/key domains alias.
+    ControllerDomainAlias {
+        /// Earlier controller role.
+        first_role: &'static str,
+        /// Conflicting controller role.
+        second_role: &'static str,
+    },
+    /// Two locally visible protocol script domains alias.
+    ScriptDomainAlias {
+        /// Earlier script role.
+        first_role: &'static str,
+        /// Conflicting script role.
+        second_role: &'static str,
+    },
+    /// Operator destination differs across alternatives.
+    CommonOperatorMismatch {
+        /// First mismatching alternative.
+        index: usize,
+    },
+    /// Recovery destination differs across alternatives.
+    CommonRecoveryMismatch {
+        /// First mismatching alternative.
+        index: usize,
+    },
+    /// Contest construction failed.
+    Contest(ContestV2Error),
+    /// A required serialized Contest output was absent.
+    ContestOutputMissing {
+        /// Output role.
+        role: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+        /// Required output position.
+        vout: u32,
+    },
+    /// A serialized Contest output differs from its connector projection.
+    ContestOutputMismatch {
+        /// Output role.
+        role: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+    },
+    /// Funded P1 construction failed.
+    FundedSetup(ThresholdV3FundedSetupError),
+    /// Selected counterproof construction failed.
+    Counterproof {
+        /// Selected alternative.
+        index: usize,
+        /// Constructor error.
+        source: CounterproofThresholdV3Error,
+    },
+    /// Atomic owner parent construction failed.
+    OwnerPayout(OwnerPayoutThresholdV3Error),
+    /// Joint ACK/timeout construction failed.
+    ResolutionBranches {
+        /// Selected alternative.
+        index: usize,
+        /// Joint branch constructor error.
+        source: ThresholdResolutionBranchesV3Error,
+    },
+    /// Slash construction failed.
+    Slash {
+        /// Selected alternative.
+        index: usize,
+        /// Slash constructor error.
+        source: SlashV2Error,
+    },
+    /// Stored P0/P1/alternative lengths drifted.
+    StoredRosterMismatch,
+    /// One descendant does not retain its exact P1-selected binding.
+    SelectedBindingMismatch {
+        /// Alternative whose binding drifted.
+        index: usize,
+    },
+    /// Stored spender matrix is not canonical.
+    SpendMatrixMismatch,
+    /// Stored role-to-outpoint registry differs from actual parent bytes.
+    RoleOutpointRegistryMismatch,
+    /// A serialized input spends an outpoint absent from the role registry.
+    UnregisteredSerializedInput {
+        /// Transaction carrying the input.
+        spender: V026ThresholdSpenderRoleV3,
+        /// Serialized input index.
+        input_index: usize,
+        /// Unregistered previous output.
+        outpoint: OutPoint,
+    },
+    /// One transaction serializes the same graph input more than once.
+    DuplicateSerializedInput {
+        /// Transaction carrying the duplicate.
+        spender: V026ThresholdSpenderRoleV3,
+        /// Repeated previous output.
+        outpoint: OutPoint,
+    },
+    /// Complete role registry and spender matrix have different lengths.
+    SpendMatrixRoleCountMismatch {
+        /// Number of unique registered output roles.
+        registry: usize,
+        /// Number of declared matrix entries.
+        matrix: usize,
+    },
+    /// One registered role is absent from, or repeated in, the spender matrix.
+    SpendMatrixRoleMultiplicity {
+        /// Registered output role.
+        role: V026ThresholdOutputRoleV3,
+        /// Number of matrix entries for that role.
+        count: usize,
+    },
+    /// Declared spenders differ from consumers found in serialized inputs.
+    SpendMatrixSerializedMismatch {
+        /// Registered output role.
+        role: V026ThresholdOutputRoleV3,
+        /// Declared canonical spenders.
+        declared: Vec<V026ThresholdSpenderRoleV3>,
+        /// Spenders observed in actual unsigned transactions.
+        actual: Vec<V026ThresholdSpenderRoleV3>,
+    },
+    /// Stored structural transaction identities drifted from actual bytes.
+    ManifestMismatch,
+    /// Serialized input count differs from the exact role projection.
+    InputCountMismatch {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+        /// Required input count.
+        expected: usize,
+        /// Serialized input count.
+        actual: usize,
+    },
+    /// Serialized input outpoint differs from its derived role.
+    InputOutpointMismatch {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+        /// Input position.
+        input: usize,
+        /// Required outpoint.
+        expected: OutPoint,
+        /// Serialized outpoint, if the input exists.
+        actual: Option<OutPoint>,
+    },
+    /// Static policy lookup failed.
+    Policy(ThresholdV3BondPolicyError),
+    /// Independent projection construction failed.
+    ExpectedConstruction {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+        /// Exact nested error text.
+        message: String,
+    },
+    /// Independent amount projection failed.
+    ExpectedValueComputation {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+    },
+    /// Independent projection does not conserve the declared fee.
+    ExpectedFeeMismatch {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+        /// Total input value.
+        input: Amount,
+        /// Total output value.
+        output: Amount,
+        /// Declared miner fee.
+        fee: Amount,
+    },
+    /// Slash header projection could not be encoded.
+    ExpectedHeaderEncoding(String),
+    /// Actual unsigned bytes differ from the independent role projection.
+    TransactionProjectionMismatch {
+        /// Transaction role.
+        template: &'static str,
+        /// Alternative, when applicable.
+        index: Option<usize>,
+    },
+}
+
+impl fmt::Display for V026ThresholdGraphV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidClaimVout { actual, expected } => {
+                write!(f, "Claim vout {actual} is not canonical vout {expected}")
+            }
+            Self::ExternalOutpointAlias {
+                first_role,
+                second_role,
+                outpoint,
+            } => write!(
+                f,
+                "external {first_role} and {second_role} alias {outpoint}"
+            ),
+            Self::NullRoleOutpoint { role } => {
+                write!(f, "graph role {role:?} uses the null outpoint sentinel")
+            }
+            Self::RoleOutpointAlias {
+                first,
+                second,
+                outpoint,
+            } => write!(
+                f,
+                "graph roles {first:?} and {second:?} alias {outpoint}"
+            ),
+            Self::DerivedExternalOutpointAlias {
+                derived_role,
+                external_role,
+                outpoint,
+            } => write!(
+                f,
+                "derived {derived_role} aliases external {external_role} at {outpoint}"
+            ),
+            Self::RosterLengthMismatch {
+                policy,
+                alternatives,
+                bonds,
+            } => write!(
+                f,
+                "threshold roster mismatch: P0={policy}, service={alternatives}, B={bonds}"
+            ),
+            Self::EmptyPolicyRoster => f.write_str("threshold P0 alternative roster is empty"),
+            Self::GraphKeyMismatch { component } => {
+                write!(f, "{component} uses another graph authorization key")
+            }
+            Self::ClaimAuthorization(error) => {
+                write!(f, "Claim authorization domains are invalid: {error}")
+            }
+            Self::ClaimServiceRosterMismatch => f.write_str(
+                "Claim watchtower roster differs from Contest MultiAnchor controller order",
+            ),
+            Self::ControllerDomainAlias {
+                first_role,
+                second_role,
+            } => write!(
+                f,
+                "locally visible controller domains {first_role} and {second_role} alias"
+            ),
+            Self::ScriptDomainAlias {
+                first_role,
+                second_role,
+            } => write!(
+                f,
+                "locally visible script domains {first_role} and {second_role} alias"
+            ),
+            Self::CommonOperatorMismatch { index } => write!(
+                f,
+                "alternative {index} has a different operator destination"
+            ),
+            Self::CommonRecoveryMismatch { index } => write!(
+                f,
+                "alternative {index} has a different recovery destination"
+            ),
+            Self::Contest(error) => write!(f, "Contest construction failed: {error}"),
+            Self::ContestOutputMissing { role, index, vout } => {
+                write!(f, "Contest {role} {index:?} output vout {vout} is absent")
+            }
+            Self::ContestOutputMismatch { role, index } => write!(
+                f,
+                "Contest {role} {index:?} output differs from its connector projection"
+            ),
+            Self::FundedSetup(error) => write!(f, "funded P1 construction failed: {error}"),
+            Self::Counterproof { index, source } => {
+                write!(f, "counterproof {index} construction failed: {source}")
+            }
+            Self::OwnerPayout(error) => write!(f, "owner parent construction failed: {error}"),
+            Self::ResolutionBranches { index, source } => write!(
+                f,
+                "resolution branches {index} construction failed: {source}"
+            ),
+            Self::Slash { index, source } => {
+                write!(f, "Slash {index} construction failed: {source}")
+            }
+            Self::StoredRosterMismatch => f.write_str("stored threshold graph rosters differ"),
+            Self::SelectedBindingMismatch { index } => write!(
+                f,
+                "alternative {index} does not retain its exact selected binding"
+            ),
+            Self::SpendMatrixMismatch => {
+                f.write_str("stored threshold spender matrix is non-canonical")
+            }
+            Self::RoleOutpointRegistryMismatch => f.write_str(
+                "stored threshold role-to-outpoint registry differs from actual parent bytes",
+            ),
+            Self::UnregisteredSerializedInput {
+                spender,
+                input_index,
+                outpoint,
+            } => write!(
+                f,
+                "{spender:?} input {input_index} spends unregistered outpoint {outpoint}"
+            ),
+            Self::DuplicateSerializedInput { spender, outpoint } => write!(
+                f,
+                "{spender:?} serializes graph outpoint {outpoint} more than once"
+            ),
+            Self::SpendMatrixRoleCountMismatch { registry, matrix } => write!(
+                f,
+                "role registry has {registry} entries but spender matrix has {matrix}"
+            ),
+            Self::SpendMatrixRoleMultiplicity { role, count } => write!(
+                f,
+                "registered role {role:?} has {count} spender-matrix entries"
+            ),
+            Self::SpendMatrixSerializedMismatch {
+                role,
+                declared,
+                actual,
+            } => write!(
+                f,
+                "registered role {role:?} declares spenders {declared:?}, actual serialized spenders are {actual:?}"
+            ),
+            Self::ManifestMismatch => f.write_str(
+                "stored threshold structural manifest differs from actual transaction bytes",
+            ),
+            Self::InputCountMismatch {
+                template,
+                index,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "{template} {index:?} has {actual} inputs, expected {expected}"
+            ),
+            Self::InputOutpointMismatch {
+                template,
+                index,
+                input,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "{template} {index:?} input {input} is {actual:?}, expected {expected}"
+            ),
+            Self::Policy(error) => write!(f, "threshold policy lookup failed: {error}"),
+            Self::ExpectedConstruction {
+                template,
+                index,
+                message,
+            } => write!(
+                f,
+                "cannot independently project {template} {index:?}: {message}"
+            ),
+            Self::ExpectedValueComputation { template, index } => write!(
+                f,
+                "cannot independently compute {template} {index:?} values"
+            ),
+            Self::ExpectedFeeMismatch {
+                template,
+                index,
+                input,
+                output,
+                fee,
+            } => write!(
+                f,
+                "independent {template} {index:?} projection does not conserve value: input={input}, output={output}, fee={fee}"
+            ),
+            Self::ExpectedHeaderEncoding(message) => {
+                write!(f, "cannot independently encode Slash header: {message}")
+            }
+            Self::TransactionProjectionMismatch { template, index } => write!(
+                f,
+                "{template} {index:?} bytes differ from the independent projection"
+            ),
+        }
+    }
+}
+
+impl Error for V026ThresholdGraphV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::ClaimAuthorization(error) => Some(error),
+            Self::Contest(error) => Some(error),
+            Self::FundedSetup(error) => Some(error),
+            Self::Counterproof { source, .. } => Some(source),
+            Self::OwnerPayout(error) => Some(error),
+            Self::ResolutionBranches { source, .. } => Some(source),
+            Self::Slash { source, .. } => Some(source),
+            Self::Policy(error) => Some(error),
+            _ => None,
+        }
+    }
+}
