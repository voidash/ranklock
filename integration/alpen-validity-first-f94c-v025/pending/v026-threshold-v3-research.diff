+/// Failure to construct or finalize an atomic threshold-v3 counterproof parent.
+#[derive(Debug)]
+pub enum CounterproofThresholdV3Error {
+    /// A validated P1 unexpectedly contained no alternatives.
+    EmptyFundedRoster,
+    /// P1's private parallel arrays disagree despite their constructor invariant.
+    FundedRosterInvariant {
+        /// Static policy alternatives.
+        policies: usize,
+        /// Exact C funding entries.
+        counterproof: usize,
+        /// Exact B funding entries.
+        bonds: usize,
+    },
+    /// Selected index escaped the validated P1 roster.
+    SelectedIndexInvariant {
+        /// Selected index.
+        selected: usize,
+        /// Roster length.
+        count: usize,
+    },
+    /// An input names Bitcoin's null outpoint sentinel.
+    NullInputOutpoint {
+        /// Flattened input position.
+        index: usize,
+    },
+    /// Two inputs name the same outpoint.
+    DuplicateInputOutpoint {
+        /// Earlier flattened input position.
+        first_index: usize,
+        /// Later flattened input position.
+        duplicate_index: usize,
+    },
+    /// One connector uses another network.
+    NetworkMismatch {
+        /// Connector whose network differs.
+        component: &'static str,
+    },
+    /// One graph-authorized connector uses another graph key.
+    GraphKeyMismatch {
+        /// Connector whose graph key differs.
+        component: &'static str,
+    },
+    /// Two protected key/control domains alias.
+    KeyDomainAlias {
+        /// Earlier domain.
+        first: CounterproofThresholdV3KeyDomain,
+        /// Later aliased domain.
+        second: CounterproofThresholdV3KeyDomain,
+    },
+    /// Checked amount arithmetic overflowed.
+    AmountOverflow,
+    /// A value or running aggregate exceeds Bitcoin MoneyRange.
+    MoneyRange {
+        /// Named amount role.
+        field: &'static str,
+        /// Rejected amount or aggregate.
+        value: Amount,
+    },
+    /// A required prevout or output is below its script dust floor.
+    DustValue {
+        /// Named output role.
+        field: &'static str,
+        /// Rejected amount.
+        value: Amount,
+        /// Script-dependent dust floor.
+        minimum: Amount,
+    },
+    /// Local research fee ceiling rejected the exact fee.
+    FeeAllowance(TemplateFeeAllowanceV2Error),
+    /// Selected economics do not conserve after exact D/sibling/B cancellation.
+    SelectedValueNotConserved {
+        /// Exact `C_j + P` input value.
+        input: Amount,
+        /// Exact `base_R_j + a_CP` output value.
+        base_output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// Full all-C/all-B transaction value does not conserve.
+    TotalValueNotConserved {
+        /// Sum of all transaction inputs.
+        input: Amount,
+        /// Sum of all transaction outputs.
+        output: Amount,
+        /// Exact miner fee.
+        fee: Amount,
+    },
+    /// A dynamic C/B signature vector has the wrong size.
+    SignatureCount {
+        /// Named signature-vector role.
+        role: &'static str,
+        /// Canonical roster length.
+        expected: usize,
+        /// Supplied vector length.
+        actual: usize,
+    },
+    /// Selected-C operator signature vector has the wrong size.
+    OperatorSignatureCount {
+        /// Selected connector's exact datum count.
+        expected: usize,
+        /// Supplied signature count.
+        actual: usize,
+    },
+    /// Selected-C code-separator sighash count violated connector invariants.
+    OperatorSighashInvariant {
+        /// Selected connector's exact datum count.
+        expected: usize,
+        /// Derived code-separator sighash count.
+        actual: usize,
+    },
+    /// A supplied Schnorr signature does not authorize its exact input.
+    InvalidSignature {
+        /// Exact input or datum role rejected by BIP340 verification.
+        role: CounterproofThresholdV3SignatureRole,
+    },
+    /// Return lookup exceeded the funded roster.
+    ReturnIndexOutOfRange {
+        /// Rejected alternative position.
+        alternative: usize,
+        /// Canonical roster length.
+        count: usize,
+    },
+    /// Selected C/B value is rolled into `R_j` and has no immediate return.
+    SelectedAlternativeHasNoReturn {
+        /// Selected alternative position.
+        alternative: usize,
+    },
+    /// Dynamic compact return vout could not be represented.
+    ReturnVoutOverflow {
+        /// Alternative whose compact vout could not be represented.
+        alternative: usize,
+    },
+    /// Exact P1-bound resolution derivation failed.
+    Resolution(CounterproofResolutionThresholdV3Error),
+    /// Exact bond connector derivation failed.
+    BondConnector {
+        /// Alternative position whose connector failed derivation.
+        index: usize,
+        /// Exact P0 policy error.
+        source: Box<ThresholdV3BondPolicyError>,
+    },
+    /// Selected/sibling C witness construction failed.
+    ContestWitness(ContestCounterproofV2Error),
+    /// Unsigned transaction could not be represented as a PSBT.
+    Psbt(PsbtError),
+}
+
+impl fmt::Display for CounterproofThresholdV3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyFundedRoster => f.write_str("threshold counterproof P1 roster is empty"),
+            Self::FundedRosterInvariant {
+                policies,
+                counterproof,
+                bonds,
+            } => write!(
+                f,
+                "threshold P1 invariant failed: policies={policies}, C={counterproof}, B={bonds}"
+            ),
+            Self::SelectedIndexInvariant { selected, count } => write!(
+                f,
+                "threshold selected index {selected} escaped roster length {count}"
+            ),
+            Self::NullInputOutpoint { index } => {
+                write!(
+                    f,
+                    "threshold counterproof input {index} is the null outpoint"
+                )
+            }
+            Self::DuplicateInputOutpoint {
+                first_index,
+                duplicate_index,
+            } => write!(
+                f,
+                "threshold counterproof input {duplicate_index} duplicates input {first_index}"
+            ),
+            Self::NetworkMismatch { component } => {
+                write!(f, "{component} network differs from threshold P1")
+            }
+            Self::GraphKeyMismatch { component } => {
+                write!(f, "{component} graph key differs from threshold P1")
+            }
+            Self::KeyDomainAlias { first, second } => write!(
+                f,
+                "threshold counterproof key domains {first:?} and {second:?} alias"
+            ),
+            Self::AmountOverflow => f.write_str("threshold counterproof amount overflowed"),
+            Self::MoneyRange { field, value } => {
+                write!(f, "{field} value {value} exceeds Bitcoin MoneyRange")
+            }
+            Self::DustValue {
+                field,
+                value,
+                minimum,
+            } => write!(f, "{field} value {value} is below dust floor {minimum}"),
+            Self::FeeAllowance(error) => write!(f, "threshold counterproof fee rejected: {error}"),
+            Self::SelectedValueNotConserved {
+                input,
+                base_output,
+                fee,
+            } => write!(
+                f,
+                "threshold selected value is not conserved: C_j+P={input}, base_R+a_CP={base_output}, fee={fee}"
+            ),
+            Self::TotalValueNotConserved { input, output, fee } => write!(
+                f,
+                "threshold counterproof total is not conserved: input={input}, output={output}, fee={fee}"
+            ),
+            Self::SignatureCount {
+                role,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "threshold counterproof requires {expected} {role} signatures, got {actual}"
+            ),
+            Self::OperatorSignatureCount { expected, actual } => write!(
+                f,
+                "threshold selected C requires {expected} operator signatures, got {actual}"
+            ),
+            Self::OperatorSighashInvariant { expected, actual } => write!(
+                f,
+                "threshold selected C exposes {actual} operator sighashes, expected {expected}"
+            ),
+            Self::InvalidSignature { role } => {
+                write!(
+                    f,
+                    "threshold counterproof signature for {role:?} is invalid"
+                )
+            }
+            Self::ReturnIndexOutOfRange { alternative, count } => write!(
+                f,
+                "threshold return alternative {alternative} is outside roster {count}"
+            ),
+            Self::SelectedAlternativeHasNoReturn { alternative } => write!(
+                f,
+                "selected threshold alternative {alternative} has no immediate C/B return"
+            ),
+            Self::ReturnVoutOverflow { alternative } => write!(
+                f,
+                "threshold return vout for alternative {alternative} overflowed"
+            ),
+            Self::Resolution(error) => {
+                write!(f, "threshold resolution derivation failed: {error}")
+            }
+            Self::BondConnector { index, source } => {
+                write!(f, "threshold bond {index} derivation failed: {source}")
+            }
+            Self::ContestWitness(error) => {
+                write!(f, "threshold C witness was rejected: {error}")
+            }
+            Self::Psbt(error) => write!(f, "threshold counterproof PSBT failed: {error}"),
+        }
+    }
+}
+
+impl Error for CounterproofThresholdV3Error {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::FeeAllowance(error) => Some(error),
+            Self::Resolution(error) => Some(error),
+            Self::BondConnector { source, .. } => Some(source.as_ref()),
+            Self::ContestWitness(error) => Some(error),
+            Self::Psbt(error) => Some(error),
+            _ => None,
+        }
+    }
+}
