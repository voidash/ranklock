+    /// Builds one independently valid inert selection for DB-layer tests.
+    pub(crate) fn persisted_selection(
+        selected_commitment: [u8; 32],
+        selected_participant: usize,
+    ) -> PersistedThresholdAckWitnessSelectionV3 {
+        let graph_keypair = keypair(1);
+        let graph_pubkey = graph_keypair.x_only_public_key().0;
+        let release_keypairs = [keypair(2), keypair(3)];
+        let release_pubkeys = release_keypairs
+            .iter()
+            .map(|keypair| keypair.x_only_public_key().0)
+            .collect::<Vec<_>>();
+        let script = ack_script(selected_commitment, graph_pubkey, &release_pubkeys);
+        let spend_info = TaprootBuilder::new()
+            .add_leaf(0, script.clone())
+            .expect("valid ACK leaf")
+            .finalize(secp256k1::SECP256K1, xonly(4))
+            .expect("complete fixture tree");
+        let control = spend_info
+            .control_block(&(script.clone(), LeafVersion::TapScript))
+            .expect("fixture leaf exists");
+        let resolution_outpoint = OutPoint::new(Txid::from_byte_array([5; 32]), 1);
+        let resolution_tx_out = TxOut {
+            value: Amount::from_sat(10_000),
+            script_pubkey: ScriptBuf::new_p2tr_tweaked(spend_info.output_key()),
+        };
+        let mut transaction = Transaction {
+            version: Version::TWO,
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: resolution_outpoint,
+                script_sig: ScriptBuf::new(),
+                sequence: Sequence::MAX,
+                witness: Witness::default(),
+            }],
+            output: vec![TxOut {
+                value: Amount::from_sat(9_000),
+                script_pubkey: ScriptBuf::new_p2tr(secp256k1::SECP256K1, xonly(6), None),
+            }],
+        };
+        let sighash = SighashCache::new(&transaction)
+            .taproot_script_spend_signature_hash(
