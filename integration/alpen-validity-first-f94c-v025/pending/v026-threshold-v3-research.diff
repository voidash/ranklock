+/// Private row value. It cannot be used as the live write capability.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct V026AckWitnessValueV3(V026AckWitnessBodyV3);
+
+impl V026AckWitnessValueV3 {
+    /// Converts the live capability into the private canonical DTO.
+    pub(crate) fn from_live(selection: &VerifiedThresholdAckWitnessSelectionV3) -> Self {
+        Self(V026AckWitnessBodyV3::from_persisted(
+            &selection.to_persisted(),
+        ))
+    }
+
+    /// Converts an inert value into the private canonical DTO.
+    #[cfg(test)]
+    fn from_persisted(selection: &PersistedThresholdAckWitnessSelectionV3) -> Self {
+        Self(V026AckWitnessBodyV3::from_persisted(selection))
+    }
+
+    /// Reconstructs and fully validates the inert public read model.
+    pub(crate) fn try_into_persisted(
+        self,
+    ) -> Result<PersistedThresholdAckWitnessSelectionV3, V026AckWitnessBodyErrorV3> {
+        self.0.try_into_persisted()
+    }
+}
+
+impl SerializableValue for V026AckWitnessValueV3 {
+    type SerializeError = V026AckWitnessSerializeErrorV3;
+    type DeserializeError = V026AckWitnessDeserializeErrorV3;
+    type Serialized = Vec<u8>;
+
+    fn serialize(&self) -> Result<Self::Serialized, Self::SerializeError> {
+        self.0
+            .clone()
+            .try_into_persisted()
+            .map_err(V026AckWitnessSerializeErrorV3::InvalidRecord)?;
+        let body =
+            postcard::to_allocvec(&self.0).map_err(V026AckWitnessSerializeErrorV3::Postcard)?;
+        let body_length = u32::try_from(body.len()).map_err(|_| {
+            V026AckWitnessSerializeErrorV3::BodyLengthOverflow { actual: body.len() }
+        })?;
+        let mut encoded = Vec::with_capacity(ENVELOPE_HEADER_LEN + body.len());
+        encoded.extend_from_slice(ENVELOPE_MAGIC);
+        encoded.extend_from_slice(&ENVELOPE_VERSION_V3.to_le_bytes());
+        encoded.extend_from_slice(&body_length.to_le_bytes());
+        encoded.extend_from_slice(&body);
+        Ok(encoded)
+    }
+
+    fn deserialize(bytes: &[u8]) -> Result<Self, Self::DeserializeError> {
+        if bytes.len() < ENVELOPE_HEADER_LEN {
+            return Err(V026AckWitnessDeserializeErrorV3::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            });
+        }
+        let (magic, version_length_and_body) = bytes.split_at(ENVELOPE_MAGIC.len());
+        if magic != ENVELOPE_MAGIC {
+            return Err(V026AckWitnessDeserializeErrorV3::InvalidMagic);
+        }
+        let (version_bytes, length_and_body) = version_length_and_body.split_at(size_of::<u16>());
+        let version = u16::from_le_bytes(version_bytes.try_into().map_err(|_| {
+            V026AckWitnessDeserializeErrorV3::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            }
+        })?);
+        if version != ENVELOPE_VERSION_V3 {
+            return Err(V026AckWitnessDeserializeErrorV3::UnsupportedVersion { version });
+        }
+        let (length_bytes, body) = length_and_body.split_at(BODY_LENGTH_LEN);
+        let declared_body_length = u32::from_le_bytes(length_bytes.try_into().map_err(|_| {
+            V026AckWitnessDeserializeErrorV3::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN,
+                actual: bytes.len(),
+            }
+        })?) as usize;
+        if body.len() < declared_body_length {
+            return Err(V026AckWitnessDeserializeErrorV3::UnexpectedEof {
+                expected_at_least: ENVELOPE_HEADER_LEN + declared_body_length,
+                actual: bytes.len(),
+            });
+        }
+        if body.len() > declared_body_length {
+            return Err(V026AckWitnessDeserializeErrorV3::TrailingBytes {
+                count: body.len() - declared_body_length,
+            });
+        }
+        let (record, trailing) = postcard::take_from_bytes::<V026AckWitnessBodyV3>(body)
+            .map_err(V026AckWitnessDeserializeErrorV3::Postcard)?;
+        if !trailing.is_empty() {
+            return Err(V026AckWitnessDeserializeErrorV3::TrailingBodyBytes {
+                count: trailing.len(),
+            });
+        }
+        record
+            .clone()
+            .try_into_persisted()
+            .map_err(V026AckWitnessDeserializeErrorV3::InvalidRecord)?;
+        let canonical_body = postcard::to_allocvec(&record)
+            .map_err(V026AckWitnessDeserializeErrorV3::CanonicalReencode)?;
+        if canonical_body != body {
+            return Err(V026AckWitnessDeserializeErrorV3::NonCanonicalBody);
+        }
+        Ok(Self(record))
+    }
+}
+
+/// Serialization failure for a V3 ACK witness envelope.
+#[derive(Debug)]
+pub(crate) enum V026AckWitnessSerializeErrorV3 {
+    /// The private DTO does not reconstruct one valid inert selection.
+    InvalidRecord(V026AckWitnessBodyErrorV3),
+    /// The canonical DTO failed to serialize.
+    Postcard(postcard::Error),
+    /// The serialized body length cannot fit the fixed header.
+    BodyLengthOverflow {
+        /// Rejected body length.
+        actual: usize,
+    },
+}
+
+impl fmt::Display for V026AckWitnessSerializeErrorV3 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidRecord(error) => write!(f, "invalid v0.26 V3 ACK witness row: {error}"),
+            Self::Postcard(error) => write!(f, "failed to serialize V3 ACK witness body: {error}"),
+            Self::BodyLengthOverflow { actual } => {
+                write!(f, "V3 ACK witness body length {actual} exceeds u32")
+            }
+        }
+    }
+}
+
+impl Error for V026AckWitnessSerializeErrorV3 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::InvalidRecord(error) => Some(error),
+            Self::Postcard(error) => Some(error),
+            Self::BodyLengthOverflow { .. } => None,
+        }
+    }
+}
+
+/// Strict decode failure for a V3 ACK witness envelope.
+#[derive(Debug)]
+pub(crate) enum V026AckWitnessDeserializeErrorV3 {
+    /// The envelope ended before its header or declared body length.
+    UnexpectedEof {
+        /// Minimum required bytes.
+        expected_at_least: usize,
+        /// Available bytes.
+        actual: usize,
+    },
+    /// The envelope magic does not identify this row family.
+    InvalidMagic,
+    /// This decoder accepts only the V3 schema.
+    UnsupportedVersion {
+        /// Rejected version.
+        version: u16,
+    },
+    /// The envelope contains bytes beyond its declared body length.
+    TrailingBytes {
+        /// Number of extra bytes.
+        count: usize,
+    },
+    /// Postcard left bytes inside the exact declared body.
+    TrailingBodyBytes {
+        /// Number of unconsumed body bytes.
+        count: usize,
+    },
+    /// The private DTO failed to decode.
+    Postcard(postcard::Error),
+    /// The decoded DTO does not reconstruct one valid inert selection.
+    InvalidRecord(V026AckWitnessBodyErrorV3),
+    /// The decoded DTO could not be canonically re-encoded.
+    CanonicalReencode(postcard::Error),
+    /// The DTO decoded but its bytes are not the canonical postcard encoding.
+    NonCanonicalBody,
+}
+
+impl fmt::Display for V026AckWitnessDeserializeErrorV3 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnexpectedEof {
+                expected_at_least,
+                actual,
+            } => write!(
+                f,
+                "V3 ACK witness envelope has {actual} bytes, expected at least {expected_at_least}"
+            ),
+            Self::InvalidMagic => f.write_str("invalid V3 ACK witness envelope magic"),
+            Self::UnsupportedVersion { version } => {
+                write!(f, "unsupported V3 ACK witness envelope version {version}")
+            }
+            Self::TrailingBytes { count } => {
+                write!(f, "V3 ACK witness envelope has {count} trailing bytes")
+            }
+            Self::TrailingBodyBytes { count } => {
+                write!(f, "V3 ACK witness postcard body has {count} trailing bytes")
+            }
+            Self::Postcard(error) => write!(f, "failed to decode V3 ACK witness body: {error}"),
+            Self::InvalidRecord(error) => write!(f, "invalid V3 ACK witness row: {error}"),
+            Self::CanonicalReencode(error) => {
+                write!(
+                    f,
+                    "failed to re-encode canonical V3 ACK witness body: {error}"
+                )
+            }
+            Self::NonCanonicalBody => f.write_str("V3 ACK witness body is not canonically encoded"),
+        }
+    }
+}
+
+impl Error for V026AckWitnessDeserializeErrorV3 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Postcard(error) | Self::CanonicalReencode(error) => Some(error),
+            Self::InvalidRecord(error) => Some(error),
+            Self::UnexpectedEof { .. }
+            | Self::InvalidMagic
+            | Self::UnsupportedVersion { .. }
+            | Self::TrailingBytes { .. }
+            | Self::TrailingBodyBytes { .. }
+            | Self::NonCanonicalBody => None,
+        }
+    }
+}
