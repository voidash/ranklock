+    fn from(value: V026ThresholdActivationBlockerV3) -> Self {
+        match value {
+            V026ThresholdActivationBlockerV3::ResearchNumsProfile => Self::ResearchNumsProfile,
+            V026ThresholdActivationBlockerV3::CanonicalWireIdentityUnimplemented => {
+                Self::CanonicalWireIdentityUnimplemented
+            }
+            V026ThresholdActivationBlockerV3::ReleaseCryptographyEvidenceUnverified => {
+                Self::ReleaseCryptographyEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::ControllerDomainEvidenceUnverified => {
+                Self::ControllerDomainEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::SlashHeaderProfileIncompatible => {
+                Self::SlashHeaderProfileIncompatible
+            }
+            V026ThresholdActivationBlockerV3::ExternalOutputEvidenceUnverified => {
+                Self::ExternalOutputEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::FreshDepositEvidenceUnverified => {
+                Self::FreshDepositEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::StakeExclusivityEvidenceUnverified => {
+                Self::StakeExclusivityEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::PresignErasureEvidenceUnverified => {
+                Self::PresignErasureEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::LegacyMaterialExclusionUnverified => {
+                Self::LegacyMaterialExclusionUnverified
+            }
+            V026ThresholdActivationBlockerV3::FeePolicyEvidenceUnverified => {
+                Self::FeePolicyEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::AtomicRosterWeightEvidenceUnverified => {
+                Self::AtomicRosterWeightEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::BitcoinCoreExecutionEvidenceUnverified => {
+                Self::BitcoinCoreExecutionEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::AsmActivationEvidenceUnverified => {
+                Self::AsmActivationEvidenceUnverified
+            }
+            V026ThresholdActivationBlockerV3::RuntimeAdmissionUnimplemented => {
+                Self::RuntimeAdmissionUnimplemented
+            }
+            V026ThresholdActivationBlockerV3::ValidityWithholdingEconomicsUnresolved => {
+                Self::ValidityWithholdingEconomicsUnresolved
+            }
+            V026ThresholdActivationBlockerV3::ThresholdAckWitnessAdoptionUnimplemented => {
+                Self::ThresholdAckWitnessAdoptionUnimplemented
+            }
+        }
+    }
+}
+
+impl TryFrom<u16> for V026BlockerCodeV3 {
+    type Error = UnknownV026BlockerCodeV3;
+
+    fn try_from(value: u16) -> Result<Self, Self::Error> {
+        V026_BLOCKERS_V3
+            .into_iter()
+            .find(|candidate| *candidate as u16 == value)
+            .ok_or(UnknownV026BlockerCodeV3 { code: value })
+    }
+}
+
+impl Serialize for V026BlockerCodeV3 {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: Serializer,
+    {
+        serializer.serialize_u16(*self as u16)
+    }
+}
+
+impl<'de> Deserialize<'de> for V026BlockerCodeV3 {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        Self::try_from(u16::deserialize(deserializer)?).map_err(D::Error::custom)
+    }
+}
