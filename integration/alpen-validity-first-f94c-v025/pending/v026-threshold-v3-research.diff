+        ));
+        let mut bad_version = encoded.clone();
+        bad_version[ENVELOPE_MAGIC.len()..ENVELOPE_MAGIC.len() + size_of::<u16>()]
+            .copy_from_slice(&2_u16.to_le_bytes());
+        assert!(matches!(
+            V026AckWitnessValueV3::deserialize(&bad_version),
+            Err(V026AckWitnessDeserializeErrorV3::UnsupportedVersion { version: 2 })
+        ));
+        let mut truncated = encoded.clone();
+        truncated.pop();
+        assert!(matches!(
+            V026AckWitnessValueV3::deserialize(&truncated),
+            Err(V026AckWitnessDeserializeErrorV3::UnexpectedEof { .. })
+        ));
+        let mut trailing = encoded;
+        trailing.push(0);
+        assert!(matches!(
+            V026AckWitnessValueV3::deserialize(&trailing),
+            Err(V026AckWitnessDeserializeErrorV3::TrailingBytes { count: 1 })
+        ));
+
+        let mut invalid_postcard = trailing;
+        invalid_postcard.truncate(ENVELOPE_HEADER_LEN + 1);
+        let body_length_offset = ENVELOPE_MAGIC.len() + size_of::<u16>();
+        invalid_postcard[body_length_offset..body_length_offset + BODY_LENGTH_LEN]
+            .copy_from_slice(&1_u32.to_le_bytes());
+        assert!(matches!(
+            V026AckWitnessValueV3::deserialize(&invalid_postcard),
+            Err(V026AckWitnessDeserializeErrorV3::Postcard(_))
+        ));
+    }
+
+    #[test]
+    fn nonminimal_postcard_integer_is_rejected() {
+        let value = V026AckWitnessValueV3::from_persisted(&persisted_selection([0x33; 32], 0));
+        let mut encoded = value.serialize().expect("valid selection serializes");
+        let participant_count_offset = ENVELOPE_HEADER_LEN + 64;
+        assert_eq!(encoded[participant_count_offset], 2);
+        encoded.splice(
+            participant_count_offset..=participant_count_offset,
+            [0x82, 0],
+        );
+        let body_length_offset = ENVELOPE_MAGIC.len() + size_of::<u16>();
+        let body_length = u32::try_from(encoded.len() - ENVELOPE_HEADER_LEN)
+            .expect("fixture body length fits u32");
+        encoded[body_length_offset..body_length_offset + BODY_LENGTH_LEN]
+            .copy_from_slice(&body_length.to_le_bytes());
+        assert!(matches!(
+            V026AckWitnessValueV3::deserialize(&encoded),
+            Err(V026AckWitnessDeserializeErrorV3::NonCanonicalBody)
+        ));
+    }
+
+    #[test]
+    fn private_dto_revalidates_lengths_and_exact_witness_bytes() {
+        let selection = persisted_selection([0x34; 32], 0);
+        let mut short_release = V026AckWitnessBodyV3::from_persisted(&selection);
+        short_release.selected_release_signatures[0].signature.pop();
+        assert!(matches!(
+            short_release.try_into_persisted(),
+            Err(V026AckWitnessBodyErrorV3::ReleaseSignatureLength {
+                position: 0,
+                actual: 63
+            })
+        ));
+
+        let mut short_graph = V026AckWitnessBodyV3::from_persisted(&selection);
+        short_graph.graph_signature.pop();
+        assert!(matches!(
+            short_graph.try_into_persisted(),
+            Err(V026AckWitnessBodyErrorV3::GraphSignatureLength { actual: 63 })
+        ));
+
+        let mut changed_tx = V026AckWitnessBodyV3::from_persisted(&selection);
+        let final_byte = changed_tx
+            .finalized_ack
+            .last_mut()
+            .expect("fixture transaction is nonempty");
+        *final_byte ^= 1;
+        assert!(matches!(
+            changed_tx.try_into_persisted(),
+            Err(V026AckWitnessBodyErrorV3::InvalidRecord(_))
+        ));
+    }
+
+    #[test]
+    fn distinct_valid_witnesses_for_one_commitment_remain_distinct() {
+        let commitment = [0x35; 32];
+        let first = persisted_selection(commitment, 0);
+        let second = persisted_selection(commitment, 1);
+        assert_eq!(first.selected_commitment(), second.selected_commitment());
+        assert_ne!(first, second);
+        assert_ne!(first.wtxid(), second.wtxid());
+        assert_ne!(
+            V026AckWitnessValueV3::from_persisted(&first)
+                .serialize()
+                .expect("first serializes"),
+            V026AckWitnessValueV3::from_persisted(&second)
+                .serialize()
+                .expect("second serializes")
+        );
+    }
+}
