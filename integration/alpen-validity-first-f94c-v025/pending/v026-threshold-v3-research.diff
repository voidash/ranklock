+fn ensure_v026_ack_witness_key_v3(
+    expected: [u8; 32],
+    selection: &PersistedThresholdAckWitnessSelectionV3,
+) -> Result<(), OneOf<(FdbBindingError, LayerError)>> {
+    let actual = selection.selected_commitment();
+    if actual != expected {
+        return Err(OneOf::new(LayerError::failed_to_deserialize_value(
+            V026AckWitnessKeyMismatchV3 { expected, actual },
+        )));
+    }
+    Ok(())
+}
+
+fn decode_v026_ack_witness_selection_v3(
+    value: V026AckWitnessValueV3,
+) -> Result<PersistedThresholdAckWitnessSelectionV3, OneOf<(FdbBindingError, LayerError)>> {
+    value
+        .try_into_persisted()
+        .map_err(LayerError::failed_to_deserialize_value)
+        .map_err(OneOf::new)
+}
+
+fn decode_v026_ack_witness_assignment_v3(
+    assignment: FundingAssignment<V026AckWitnessValueV3>,
+) -> Result<
+    FundingAssignment<PersistedThresholdAckWitnessSelectionV3>,
+    OneOf<(FdbBindingError, LayerError)>,
+> {
+    match assignment {
+        FundingAssignment::Created(value) => {
+            decode_v026_ack_witness_selection_v3(value).map(FundingAssignment::Created)
+        }
+        FundingAssignment::Existing(value) => {
+            decode_v026_ack_witness_selection_v3(value).map(FundingAssignment::Existing)
+        }
+    }
+}
+
+fn classify_v026_ack_witness_assignment_v3(
+    assignment: FundingAssignment<PersistedThresholdAckWitnessSelectionV3>,
+    proposed: PersistedThresholdAckWitnessSelectionV3,
+) -> V026AckWitnessWriteOutcomeV3 {
+    match assignment {
+        FundingAssignment::Created(value) => V026AckWitnessWriteOutcomeV3::Created(Box::new(value)),
+        FundingAssignment::Existing(value) if value == proposed => {
+            V026AckWitnessWriteOutcomeV3::ExactReplay(Box::new(value))
+        }
+        FundingAssignment::Existing(value) => V026AckWitnessWriteOutcomeV3::Conflict {
+            durable: Box::new(value),
+            proposed: Box::new(proposed),
+        },
+    }
+}
