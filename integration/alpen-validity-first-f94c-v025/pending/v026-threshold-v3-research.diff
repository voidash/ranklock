diff --git a/crates/db/src/fdb/row_spec/v026_ack_witnesses_v3.rs b/crates/db/src/fdb/row_spec/v026_ack_witnesses_v3.rs
new file mode 100644
index 00000000..1d71600d
--- /dev/null
+++ b/crates/db/src/fdb/row_spec/v026_ack_witnesses_v3.rs
@@ -0,0 +1,838 @@
+//! Immutable rows for threshold-v3 ACK witness selections.
+
+use std::{convert::Infallible, error::Error, fmt};
+
+use bitcoin::{OutPoint, TxOut, Txid, Wtxid};
+use foundationdb::tuple::PackError;
+use serde::{Deserialize, Serialize};
+use strata_bridge_sm::v026_admission_v3::{
+    PersistedThresholdAckWitnessSelectionV3, V026IndexedReleaseSignatureBytesV3,
+    V026PersistedAckWitnessErrorV3, V026PersistedAckWitnessPartsV3, V026ThresholdAckSubjectV3,
+    VerifiedThresholdAckWitnessSelectionV3,
+};
+
+use super::kv::{KVRowSpec, PackableKey, SerializableValue};
+use crate::fdb::dirs::Directories;
+
+const ENVELOPE_MAGIC: &[u8; 7] = b"RL26ACK";
+const ENVELOPE_VERSION_V3: u16 = 3;
+const BODY_LENGTH_LEN: usize = size_of::<u32>();
+const ENVELOPE_HEADER_LEN: usize = ENVELOPE_MAGIC.len() + size_of::<u16>() + BODY_LENGTH_LEN;
+
+/// Key for one immutable ACK witness selection.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AckWitnessKeyV3([u8; 32]);
+
+/// A decoded row body claims a different selected commitment than its key.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(crate) struct V026AckWitnessKeyMismatchV3 {
+    /// Selected commitment used to address the row.
+    pub expected: [u8; 32],
+    /// Selected commitment authenticated inside the stored selection.
+    pub actual: [u8; 32],
+}
+
+impl V026AckWitnessKeyV3 {
+    /// Returns the content-derived selected commitment.
+    #[cfg(test)]
+    pub(crate) const fn selected_commitment(self) -> [u8; 32] {
+        self.0
+    }
+}
+
+impl From<[u8; 32]> for V026AckWitnessKeyV3 {
+    fn from(selected_commitment: [u8; 32]) -> Self {
+        Self(selected_commitment)
+    }
+}
+
+impl PackableKey for V026AckWitnessKeyV3 {
+    type PackingError = Infallible;
+    type UnpackingError = V026AckWitnessKeyDecodeErrorV3;
+    type Packed = Vec<u8>;
+
+    fn pack(&self, dirs: &Directories) -> Result<Self::Packed, Self::PackingError> {
+        Ok(dirs
+            .v026_ack_witnesses_v3
+            .pack::<(Vec<u8>,)>(&(self.0.to_vec(),)))
+    }
+
+    fn unpack(dirs: &Directories, bytes: &[u8]) -> Result<Self, Self::UnpackingError> {
+        let (selected_commitment,) = dirs
+            .v026_ack_witnesses_v3
+            .unpack::<(Vec<u8>,)>(bytes)
+            .map_err(V026AckWitnessKeyDecodeErrorV3::Tuple)?;
+        let actual = selected_commitment.len();
+        let selected_commitment = selected_commitment.try_into().map_err(|_bytes| {
+            V026AckWitnessKeyDecodeErrorV3::SelectedCommitmentLength { actual }
+        })?;
+        Ok(Self(selected_commitment))
+    }
+}
+
+/// Strict key decoding failure for the ACK witness subspace.
+#[derive(Debug)]
+pub(crate) enum V026AckWitnessKeyDecodeErrorV3 {
+    /// The FDB tuple is malformed, outside the subspace, or has the wrong arity/type.
+    Tuple(PackError),
+    /// The sole tuple byte string is not one exact selected commitment.
+    SelectedCommitmentLength {
+        /// Rejected byte length.
+        actual: usize,
+    },
+}
+
+impl fmt::Display for V026AckWitnessKeyDecodeErrorV3 {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Tuple(error) => write!(f, "invalid v0.26 V3 ACK witness key tuple: {error}"),
+            Self::SelectedCommitmentLength { actual } => write!(
+                f,
+                "v0.26 V3 ACK witness key has {actual} selected-commitment bytes, expected 32"
+            ),
+        }
+    }
+}
+
+impl Error for V026AckWitnessKeyDecodeErrorV3 {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Tuple(error) => Some(error),
+            Self::SelectedCommitmentLength { .. } => None,
+        }
+    }
+}
+
+/// Crate-private wire representation of the exact ACK subject.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct V026AckSubjectBodyV3 {
+    selected_commitment: [u8; 32],
+    graph_pubkey: [u8; 32],
+    participant_count: u16,
+    threshold: u16,
+    release_pubkeys: Vec<[u8; 32]>,
+    resolution_outpoint: OutPoint,
+    resolution_tx_out: TxOut,
+    ack_txid: Txid,
+    ack_sighash: [u8; 32],
+}
+
+impl From<&V026ThresholdAckSubjectV3> for V026AckSubjectBodyV3 {
+    fn from(subject: &V026ThresholdAckSubjectV3) -> Self {
+        Self {
+            selected_commitment: subject.selected_commitment,
+            graph_pubkey: subject.graph_pubkey,
+            participant_count: subject.participant_count,
+            threshold: subject.threshold,
+            release_pubkeys: subject.release_pubkeys.clone(),
+            resolution_outpoint: subject.resolution_outpoint,
+            resolution_tx_out: subject.resolution_tx_out.clone(),
+            ack_txid: subject.ack_txid,
+            ack_sighash: subject.ack_sighash,
+        }
+    }
+}
+
+impl From<V026AckSubjectBodyV3> for V026ThresholdAckSubjectV3 {
+    fn from(subject: V026AckSubjectBodyV3) -> Self {
+        Self {
+            selected_commitment: subject.selected_commitment,
+            graph_pubkey: subject.graph_pubkey,
+            participant_count: subject.participant_count,
+            threshold: subject.threshold,
+            release_pubkeys: subject.release_pubkeys,
+            resolution_outpoint: subject.resolution_outpoint,
+            resolution_tx_out: subject.resolution_tx_out,
+            ack_txid: subject.ack_txid,
+            ack_sighash: subject.ack_sighash,
+        }
+    }
+}
