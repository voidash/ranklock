+            unsigned.input[5].previous_output,
+            fixture.shared.deposit_outpoint
+        );
+        assert_eq!(
+            tx.resolution_outpoint(),
+            OutPoint::new(unsigned.compute_txid(), 1)
+        );
+        assert_eq!(tx.counterproof_return_vout(0).expect("C return"), 3);
+        assert_eq!(tx.bond_refund_vout(0).expect("B refund"), 4);
+        assert!(matches!(
+            tx.counterproof_return_vout(1),
+            Err(CounterproofThresholdV3Error::SelectedAlternativeHasNoReturn { alternative: 1 })
+        ));
+        let (operators, signatures) = signatures(&tx, &fixture);
+        let finalized: Transaction = tx
+            .finalize(operators, signatures)
+            .expect("valid signatures");
+        assert_eq!(finalized.input[0].witness.len(), 3);
+        assert_eq!(
+            finalized.input[1].witness.len(),
+            fixture.setup.policy().alternatives()[1]
+                .counterproof_output()
+                .n_data()
+                .get()
+                + 3
+        );
+        assert_eq!(finalized.input[2].witness.len(), 3);
+        assert_eq!(finalized.input[3].witness.len(), 3);
+        assert_eq!(finalized.input[4].witness.len(), 3);
+        assert_eq!(finalized.input[5].witness.len(), 1);
+    }
+
+    #[test]
+    fn wrong_order_count_and_exact_input_signatures_fail_closed() {
+        let fixture = fixture(true);
+        let tx = transaction(&fixture);
+        let (mut operators, valid_signatures) = signatures(&tx, &fixture);
+        operators.swap(0, 1);
+        assert!(matches!(
+            tx.clone().finalize(operators, valid_signatures),
+            Err(CounterproofThresholdV3Error::InvalidSignature {
+                role: CounterproofThresholdV3SignatureRole::CounterproofOperator { .. }
+            })
+        ));
+
+        let (operators, mut short) = signatures(&tx, &fixture);
+        short.bonds.pop();
+        assert!(matches!(
+            tx.clone().finalize(operators, short),
+            Err(CounterproofThresholdV3Error::SignatureCount {
+                role: "bond graph",
+                expected: 2,
+                actual: 1
+            })
+        ));
+
+        let (operators, mut wrong_deposit) = signatures(&tx, &fixture);
+        wrong_deposit.deposit = fixture
+            .graph
+            .sign_schnorr(tx.signing_info().deposit.sighash);
+        assert!(matches!(
+            tx.finalize(operators, wrong_deposit),
+            Err(CounterproofThresholdV3Error::InvalidSignature {
+                role: CounterproofThresholdV3SignatureRole::Deposit
+            })
+        ));
+    }
+
+    #[test]
+    fn external_alias_money_range_dust_and_fee_kind_fail_closed() {
+        let mut aliased = fixture(true);
+        aliased.deposit = NOfNConnector::new(
+            Network::Regtest,
+            aliased.graph.x_only_public_key().0,
