+    #[test]
+    fn persisted_ack_selection_rejects_bitmap_signature_and_transaction_mutations() {
+        let mut high_bit = valid_witness_parts();
+        high_bit.participant_bitmap |= 1 << 63;
+        assert!(matches!(
+            PersistedThresholdAckWitnessSelectionV3::try_from_parts(high_bit),
+            Err(V026PersistedAckWitnessErrorV3::BitmapUnusedBitsSet)
+        ));
+
+        let mut signature = valid_witness_parts();
+        signature.selected_release_signatures[0].signature[0] ^= 1;
+        assert!(matches!(
+            PersistedThresholdAckWitnessSelectionV3::try_from_parts(signature),
+            Err(V026PersistedAckWitnessErrorV3::InvalidReleaseSignature { index: 0 })
+                | Err(V026PersistedAckWitnessErrorV3::MalformedReleaseSignature { index: 0 })
+        ));
+
+        let mut subject = valid_witness_parts();
+        subject.subject.selected_commitment[0] ^= 1;
+        assert!(matches!(
+            PersistedThresholdAckWitnessSelectionV3::try_from_parts(subject),
+            Err(V026PersistedAckWitnessErrorV3::AckScriptMismatch)
+        ));
+
+        let mut witness = valid_witness_parts();
+        let mut transaction: Transaction =
+            consensus::deserialize(&witness.finalized_ack).expect("fixture transaction decodes");
+        let mut changed = transaction.input[0].witness.to_vec();
+        changed[1].clear();
+        transaction.input[0].witness = Witness::from_slice(&changed);
+        witness.wtxid = transaction.compute_wtxid();
+        witness.finalized_ack = consensus::serialize(&transaction);
+        assert!(matches!(
+            PersistedThresholdAckWitnessSelectionV3::try_from_parts(witness),
+            Err(V026PersistedAckWitnessErrorV3::WitnessSignatureMismatch { participant: 0 })
+        ));
+    }
