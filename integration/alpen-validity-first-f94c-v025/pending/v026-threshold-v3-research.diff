+    #[test]
+    fn rejects_null_and_late_derived_outpoint_aliases() {
+        let mut null_stake = plan();
+        null_stake.stake.outpoint = OutPoint::null();
+        assert!(matches!(
+            V026ThresholdGraphV3::assemble(null_stake),
+            Err(V026ThresholdGraphV3Error::NullRoleOutpoint {
+                role: V026ThresholdOutputRoleV3::Stake
+            })
+        ));
+
+        let baseline = V026ThresholdGraphV3::assemble(plan()).expect("baseline graph");
+        let resolution = baseline
+            .role_outpoints()
+            .iter()
+            .find(|entry| entry.role == V026ThresholdOutputRoleV3::Resolution(0))
+            .expect("R_0 role")
+            .outpoint;
+
+        let mut stake_equals_resolution = plan();
+        stake_equals_resolution.stake.outpoint = resolution;
+        assert!(matches!(
+            V026ThresholdGraphV3::assemble(stake_equals_resolution),
+            Err(V026ThresholdGraphV3Error::RoleOutpointAlias {
+                first: V026ThresholdOutputRoleV3::Stake,
+                second: V026ThresholdOutputRoleV3::Resolution(0),
+                outpoint,
+            }) if outpoint == resolution
+        ));
+
+        let mut claim_payout_equals_resolution = plan();
+        claim_payout_equals_resolution.claim_payout.outpoint = resolution;
+        assert!(matches!(
+            V026ThresholdGraphV3::assemble(claim_payout_equals_resolution),
+            Err(V026ThresholdGraphV3Error::RoleOutpointAlias {
+                first: V026ThresholdOutputRoleV3::ClaimPayout,
+                second: V026ThresholdOutputRoleV3::Resolution(0),
+                outpoint,
+            }) if outpoint == resolution
+        ));
+
+        let payout = baseline.structural_manifest().contest_payout_outpoint;
+        let mut bond_equals_payout = plan();
+        let bond_txout = bond_equals_payout.bond_funding[0].tx_out().clone();
+        bond_equals_payout.bond_funding[0] =
+            ThresholdV3FundingOutput::new(payout, bond_txout).expect("non-null B alias");
+        assert!(matches!(
+            V026ThresholdGraphV3::assemble(bond_equals_payout),
+            Err(V026ThresholdGraphV3Error::DerivedExternalOutpointAlias {
+                derived_role: "contest payout",
+                external_role: "bond",
+                outpoint,
+            }) if outpoint == payout
+        ));
+    }
