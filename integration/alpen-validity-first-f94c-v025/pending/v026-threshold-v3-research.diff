+        fn sign_leaf(
+            &self,
+            spend_path: CounterproofResolutionThresholdSpendPathV3,
+            signing_info: SigningInfo,
+        ) -> CounterproofResolutionThresholdWitnessV3 {
+            let graph_signature = signing_info.sign(&self.graph_keypair);
+            match spend_path {
+                CounterproofResolutionThresholdSpendPathV3::Ack => {
+                    let mut slots = vec![None; self.release_keypairs.len()];
+                    for (index, keypair) in self.release_keypairs.iter().take(2).enumerate() {
+                        slots[index] = Some(signing_info.sign(keypair));
+                    }
+                    self.get_connector()
+                        .ack_witness(graph_signature, slots)
+                        .unwrap()
+                }
+                CounterproofResolutionThresholdSpendPathV3::Timeout => {
+                    self.get_connector().timeout_witness(graph_signature)
+                }
+            }
+        }
+    }
+
+    fn connector(
+        graph_pubkey: XOnlyPublicKey,
+        release_pubkeys: Vec<XOnlyPublicKey>,
+        threshold: usize,
+        output_index: u32,
+    ) -> Result<CounterproofResolutionThresholdConnectorV3, CounterproofResolutionThresholdV3Error>
+    {
+        let fault_profile =
+            ThresholdReleaseFaultProfileV3::new(release_pubkeys.len(), threshold, 0)
+                .expect("test helper requires a valid fault profile");
+        CounterproofResolutionThresholdConnectorV3::new(
+            Network::Regtest,
+            graph_pubkey,
+            release_pubkeys,
+            ThresholdAckAlternativeV3::new(output_index),
+            fault_profile,
+            TIMEOUT,
+            CONNECTOR_VALUE,
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::CounterproofResolutionThreshold,
+                output_index,
+            ),
+        )
+    }
+
+    fn deterministic_keypair(number: u32) -> Keypair {
+        let mut secret_bytes = [0u8; 32];
+        secret_bytes[28..].copy_from_slice(&number.to_be_bytes());
+        let secret = SecretKey::from_slice(&secret_bytes).expect("valid numbered key");
+        Keypair::from_secret_key(SECP256K1, &secret)
+    }
+
+    fn deterministic_key(number: u32) -> XOnlyPublicKey {
+        deterministic_keypair(number).x_only_public_key().0
+    }
+
+    fn bound_registry(
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        release_key_offset: u32,
+    ) -> Arc<ThresholdV3KeyRegistry> {
+        let participants = (0..fault_profile.participant_count())
+            .map(|participant_index| {
+                let identity = deterministic_keypair(10 + participant_index as u32);
+                let identity_pubkey = identity.x_only_public_key().0;
+                let control_domain_digest = [(20 + participant_index) as u8; 32];
+                let release_pubkeys: Vec<_> = (0..2)
+                    .map(|alternative| {
+                        deterministic_key(
+                            release_key_offset + (participant_index * 2 + alternative) as u32,
+                        )
+                    })
+                    .collect();
+                let digest = ThresholdV3ParticipantIdentity::contribution_digest_for(
+                    SETUP_INTENT_DIGEST,
+                    fault_profile,
+                    2,
+                    participant_index,
+                    identity_pubkey,
+                    control_domain_digest,
+                    &release_pubkeys,
+                )
+                .expect("participant contribution digest");
+                ThresholdV3ParticipantIdentity::new(
+                    SETUP_INTENT_DIGEST,
+                    fault_profile,
+                    2,
+                    participant_index,
+                    identity_pubkey,
+                    control_domain_digest,
+                    release_pubkeys,
+                    identity.sign_schnorr(Message::from_digest(digest)),
+                )
+                .expect("valid participant contribution")
+            })
+            .collect();
+        Arc::new(
+            ThresholdV3KeyRegistry::new(SETUP_INTENT_DIGEST, fault_profile, 2, participants)
+                .expect("valid bound registry"),
+        )
+    }
+
+    fn destination(
+        key_number: u32,
+        principal: u8,
+        authority: u8,
+    ) -> ThresholdV3ControlledP2trDestination {
+        ThresholdV3ControlledP2trDestination::new(
+            deterministic_key(key_number),
+            [principal; 32],
+            [authority; 32],
+        )
+        .expect("valid destination")
+    }
+
+    fn bound_alternative(
+        graph_pubkey: XOnlyPublicKey,
+        index: usize,
+        bond_value: Amount,
+    ) -> ThresholdV3BondAlternativePolicy {
+        let index_u32 = u32::try_from(index).expect("small test index");
+        let counterproof = ContestCounterproofOutputV2::new(
+            Network::Regtest,
+            graph_pubkey,
+            deterministic_key(200 + index_u32),
+            3,
+            Amount::from_sat(10_000),
+            ResearchV0NumsContext::new(
+                SETUP_INTENT_DIGEST,
+                ResearchV0NumsRole::ContestCounterproof,
+                index_u32,
+            ),
+        )
+        .expect("valid counterproof output");
+        let key_base = 300 + index_u32 * 10;
+        ThresholdV3BondAlternativePolicy::new(
+            counterproof,
+            destination(key_base, 40 + index as u8, 50 + index as u8),
+            bond_value,
+            destination(key_base + 1, 40 + index as u8, 50 + index as u8),
+            destination(key_base + 2, 60 + index as u8, 70 + index as u8),
+            destination(key_base + 3, 80 + index as u8, 90 + index as u8),
+            CONNECTOR_VALUE,
+            TIMEOUT,
+        )
+        .expect("valid bound alternative")
+    }
+
+    fn bound_policy(
+        graph_pubkey: XOnlyPublicKey,
+        fault_profile: ThresholdReleaseFaultProfileV3,
+        release_key_offset: u32,
+        bond_value: Amount,
+    ) -> Arc<ThresholdV3BondPolicyP0> {
+        ThresholdV3BondPolicyP0::new(
+            Network::Regtest,
+            graph_pubkey,
+            bound_registry(fault_profile, release_key_offset),
+            vec![
+                bound_alternative(graph_pubkey, 0, bond_value),
+                bound_alternative(graph_pubkey, 1, bond_value),
+            ],
+        )
+        .expect("valid bound policy")
+    }
+
+    fn funding_output(seed: u8, vout: u32, tx_out: TxOut) -> ThresholdV3FundingOutput {
+        ThresholdV3FundingOutput::new(
+            OutPoint::new(Txid::from_byte_array([seed; 32]), vout),
+            tx_out,
+        )
+        .expect("valid funding output")
+    }
+
+    fn bound_setup(
+        policy: Arc<ThresholdV3BondPolicyP0>,
+        counterproof_seed: u8,
+        bond_seed: u8,
+    ) -> Arc<ThresholdV3FundedSetupP1> {
+        let counterproof_funding = policy
+            .alternatives()
+            .iter()
+            .enumerate()
+            .map(|(index, alternative)| {
+                funding_output(
+                    counterproof_seed,
+                    u32::try_from(index).expect("small test index"),
+                    alternative.counterproof_output().tx_out(),
+                )
+            })
+            .collect();
+        let bond_funding = (0..policy.alternatives().len())
+            .map(|index| {
+                funding_output(
+                    bond_seed,
+                    u32::try_from(index).expect("small test index"),
+                    policy
+                        .bond_connector(index)
+                        .expect("bond connector")
+                        .tx_out(),
+                )
+            })
+            .collect();
+        ThresholdV3FundedSetupP1::new(policy, counterproof_funding, bond_funding)
+            .expect("valid funded setup")
+    }
+
+    fn fund_connectors(
+        node: &mut BitcoinNode,
+        connector: &CounterproofResolutionThresholdConnectorV3,
+        count: usize,
+    ) -> Vec<OutPoint> {
+        let total = Amount::from_sat(connector.value().to_sat() * count as u64);
+        let mut output = vec![connector.tx_out(); count];
+        output.push(TxOut {
+            value: node.coinbase_amount() - total - TEST_FEE,
+            script_pubkey: node.wallet_address().script_pubkey(),
+        });
+        let funding = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: create_tx_ins([node.next_coinbase_outpoint()]),
+            output,
+        };
+        let txid = node.sign_and_broadcast(&funding);
+        node.mine_blocks(1);
+        (0..count)
+            .map(|index| OutPoint::new(txid, u32::try_from(index).unwrap()))
+            .collect()
+    }
+
+    fn spending_template(
+        node: &mut BitcoinNode,
+        connector: &CounterproofResolutionThresholdConnectorV3,
+        outpoint: OutPoint,
+        path: CounterproofResolutionThresholdSpendPathV3,
+    ) -> (Transaction, [TxOut; 2]) {
+        let tx = Transaction {
+            version: transaction::Version(2),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![
+                TxIn {
+                    previous_output: outpoint,
+                    sequence: connector.sequence(path),
+                    ..Default::default()
+                },
+                node.next_coinbase_txin(),
+            ],
+            output: vec![TxOut {
+                value: node.coinbase_amount() + connector.value() - TEST_FEE,
+                script_pubkey: node.wallet_address().script_pubkey(),
+            }],
+        };
+        let prevouts = [connector.tx_out(), node.coinbase_tx_out()];
+        (tx, prevouts)
+    }
+
+    fn signing_info(
+        tx: &Transaction,
+        prevouts: &[TxOut; 2],
+        connector: &CounterproofResolutionThresholdConnectorV3,
+        path: CounterproofResolutionThresholdSpendPathV3,
+    ) -> SigningInfo {
+        connector.get_signing_info(&mut SighashCache::new(tx), Prevouts::All(prevouts), path, 0)
+    }
+
+    fn finalize(
+        node: &BitcoinNode,
+        tx: Transaction,
+        prevouts: &[TxOut; 2],
+        connector: &CounterproofResolutionThresholdConnectorV3,
+        witness: &CounterproofResolutionThresholdWitnessV3,
+    ) -> Transaction {
+        let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+        psbt.inputs[0].witness_utxo = Some(prevouts[0].clone());
+        psbt.inputs[1].witness_utxo = Some(prevouts[1].clone());
+        connector.finalize_input(&mut psbt.inputs[0], witness);
+        node.sign(&psbt.extract_tx().unwrap())
+    }
