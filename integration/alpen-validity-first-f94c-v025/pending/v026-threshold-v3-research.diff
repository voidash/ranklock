+/// Immediate exact-parent bond input used only by atomic Owner/CP parents.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CounterproofBondConnectorV3 {
+    network: Network,
+    graph_pubkey: XOnlyPublicKey,
+    alternative_index: usize,
+    commitment: ThresholdV3AlternativeCommitment,
+    value: Amount,
+    internal_key: XOnlyPublicKey,
+}
+
+impl CounterproofBondConnectorV3 {
+    fn from_policy(
+        policy: &ThresholdV3BondPolicyP0,
+        alternative_index: usize,
+    ) -> Result<Self, CounterproofBondV3Error> {
+        let alternative = policy.alternatives.get(alternative_index).ok_or(
+            CounterproofBondV3Error::AlternativeIndexOutOfRange {
+                index: alternative_index,
+                count: policy.alternatives.len(),
+            },
+        )?;
+        let commitment = policy
+            .static_alternative_commitment(alternative_index)
+            .map_err(|_| CounterproofBondV3Error::AlternativeIndexOutOfRange {
+                index: alternative_index,
+                count: policy.alternatives.len(),
+            })?;
+        let internal_key = derive_bond_nums(commitment)?;
+        let connector = Self {
+            network: policy.network,
+            graph_pubkey: policy.graph_pubkey,
+            alternative_index,
+            commitment,
+            value: alternative.bond_value,
+            internal_key,
+        };
+        let output_key = connector.spend_info().output_key().to_x_only_public_key();
+        if connector.graph_pubkey == connector.internal_key || connector.graph_pubkey == output_key
+        {
+            return Err(CounterproofBondV3Error::GraphNumsKeyAlias);
+        }
+        let minimum = connector.script_pubkey().minimal_non_dust();
+        if connector.value < minimum {
+            return Err(CounterproofBondV3Error::DustValue {
+                value: connector.value,
+                minimum,
+            });
+        }
+        Ok(connector)
+    }
+
+    /// Returns the canonical alternative position.
+    pub const fn alternative_index(&self) -> usize {
+        self.alternative_index
+    }
+
+    /// Returns the exact policy commitment embedded in the script.
+    pub const fn commitment(&self) -> ThresholdV3AlternativeCommitment {
+        self.commitment
+    }
+
+    /// Constructs the only typed bond witness.
+    pub const fn witness(graph_signature: schnorr::Signature) -> CounterproofBondWitnessV3 {
+        CounterproofBondWitnessV3 { graph_signature }
+    }
+
+    /// Finalizes through the sole atomic graph-signature path.
+    pub fn finalize_input(&self, input: &mut Input, witness: &CounterproofBondWitnessV3) {
+        Connector::finalize_input(self, input, witness);
+    }
+
+    fn atomic_selection_script(&self) -> ScriptBuf {
+        script::Builder::new()
+            .push_slice(self.commitment.0)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(self.graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+
+    /// A research bond connector never authorizes funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
