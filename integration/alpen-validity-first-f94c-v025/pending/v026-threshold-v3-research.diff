+
+    struct ThresholdFundedSetupV3Hash(_);
+}
+
+sha256t_hash_newtype! {
+    struct ThresholdAlternativeV3Tag = hash_str("RankLock/v026/threshold-v3/alternative-commitment/v1");
+
+    struct ThresholdAlternativeV3Hash(_);
+}
+
+sha256t_hash_newtype! {
+    struct ThresholdSelectedAlternativeV3Tag = hash_str("RankLock/v026/threshold-v3/selected-alternative/v1");
+
+    struct ThresholdSelectedAlternativeV3Hash(_);
+}
