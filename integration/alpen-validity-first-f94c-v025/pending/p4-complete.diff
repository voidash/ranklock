+///
+/// Validity-first makes the ACK immediate and unconditional on the NACK timelock: the duty
+/// carries the *unsigned* exact ACK template plus its N/N signatures, and the executor
+/// finalizes it only once the RankLock positive unlock resolves. Everything here is derived
+/// exactly as [`GraphSM::validity_first_ack_duty`] derives it -- same context, same config,
+/// same signature vector -- so nothing is hard-coded from observed output.
+pub(super) fn expected_validity_first_ack_duty(
+    cfg: &GraphSMCfg,
+    sm: &GraphSM,
+    signatures: &[Signature],
+    bridge_proof_txid: Txid,
+) -> GraphDuty {
+    let (game_graph, sigs, slot) = pov_watchtower_slot_data(cfg, sm, signatures);
+
+    GraphDuty::ResolveValidityFirstCounterProofAck {
+        bridge_proof_txid,
+        counterproof_txid: game_graph.counterproofs[slot]
+            .counterproof
+            .as_ref()
+            .compute_txid(),
+        counterproof_ack_tx: game_graph.counterproofs[slot].counterproof_ack.clone(),
+        n_of_n_signatures: sigs.watchtowers[slot].counterproof_ack,
+    }
+}
