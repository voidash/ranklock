+        .expect("signature layout matches watchtower count");
+    let slot = watchtower_slot_for_operator(sm.context().operator_idx(), counterprover_idx)
+        .expect("counterprover must have a watchtower slot");
+
+    GraphDuty::PublishValidityFirstCounterProofNack {
+        signed_counter_proof_nack_tx: game_graph.counterproofs[slot]
+            .counterproof_nack
+            .clone()
+            .finalize(sigs.watchtowers[slot].counterproof_nack[0]),
+    }
