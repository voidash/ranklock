+/// Generates the game graph, unpacks `signatures`, and resolves the watchtower slot that the
+/// POV operator occupies in the graph owned by `sm`'s operator.
+fn pov_watchtower_slot_data(
+    cfg: &GraphSMCfg,
+    sm: &GraphSM,
+    signatures: &[Signature],
+) -> (GameGraph, GameFunctor<Signature>, usize) {
+    let game_graph = machine::generate_game_graph(cfg, sm.context(), &test_deposit_params());
+    let sigs = GameFunctor::unpack(signatures.to_vec(), sm.context().watchtower_pubkeys().len())
+        .expect("signature layout matches watchtower count");
+    let slot = watchtower_slot_for_operator(
+        sm.context().operator_idx(),
+        sm.context().operator_table().pov_idx(),
+    )
+    .expect("non-pov operator must have a watchtower slot");
+
+    (game_graph, sigs, slot)
