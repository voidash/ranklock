 static TEST_ADAPTOR_PUBKEYS: OnceLock<Vec<bitcoin::XOnlyPublicKey>> = OnceLock::new();
 static TEST_FAULT_PUBKEYS: OnceLock<Vec<bitcoin::XOnlyPublicKey>> = OnceLock::new();
 
+/// The ACK preimage a test uses for watchtower slot `index`.
+///
+/// Rejection-sampled so `sha256(preimage)` is a valid x-only encoding, since
+/// the graph transports the ACK commitment in an `XOnlyPublicKey` field.
+/// Mirrors `derive_setup_payload` on the RankLock side.
+pub(super) fn test_ack_preimage(index: usize) -> [u8; 32] {
+    for counter in 0u32..10_000 {
+        let mut seed = Vec::with_capacity(40);
+        seed.extend_from_slice(b"ranklock-test-ack-preimage");
+        seed.extend_from_slice(&(index as u32).to_be_bytes());
+        seed.extend_from_slice(&counter.to_be_bytes());
+        let preimage = sha256::Hash::hash(&seed).to_byte_array();
+        let commitment = sha256::Hash::hash(&preimage).to_byte_array();
+        if bitcoin::XOnlyPublicKey::from_slice(&commitment).is_ok() {
+            return preimage;
+        }
+    }
+    panic!("failed to sample an x-only-compatible ACK commitment");
+}
+
+/// `sha256(test_ack_preimage(index))` as an x-only key.
+pub(super) fn test_ack_commitment(index: usize) -> bitcoin::XOnlyPublicKey {
+    let commitment = sha256::Hash::hash(&test_ack_preimage(index)).to_byte_array();
+    bitcoin::XOnlyPublicKey::from_slice(&commitment)
+        .expect("test_ack_preimage rejection-samples a valid x-only commitment")
+}
