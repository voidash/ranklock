+#[test]
+fn an_ack_txid_without_the_committed_preimage_is_rejected() {
+    // A txid does not commit to the witness under BIP141, so a transaction
+    // with the expected ACK txid that does not reveal the preimage did not
+    // execute the ACK leaf. Before this check it was accepted.
+    let mut tx = ack_spend_tx();
+    tx.input[0].witness = bitcoin::Witness::new();
+
+    test_graph_invalid_transition(GraphInvalidTransition {
+        from_state: counter_proof_posted_state(),
+        event: GraphEvent::CounterProofAckConfirmed(CounterProofAckConfirmedEvent {
+            counterproof_ack_txid: TEST_GRAPH_SUMMARY.counterproofs[0].counterproof_ack,
+            tx,
+            counterproof_ack_block_height: ACK_BLOCK_HEIGHT,
+            counterprover_idx: TEST_NONPOV_IDX,
+        }),
+        expected_error: |e| matches!(e, GSMError::Rejected { .. }),
     });
 }
