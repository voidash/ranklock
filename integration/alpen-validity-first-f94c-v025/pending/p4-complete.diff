+pub(super) fn test_ack_preimage(index: usize) -> [u8; 32] {
+    for counter in 0u32..10_000 {
+        let mut seed = Vec::with_capacity(40);
+        seed.extend_from_slice(b"ranklock-test-ack-preimage");
+        seed.extend_from_slice(&(index as u32).to_be_bytes());
+        seed.extend_from_slice(&counter.to_be_bytes());
+        let preimage = sha256::Hash::hash(&seed).to_byte_array();
+        let commitment = sha256::Hash::hash(&preimage).to_byte_array();
+        if bitcoin::XOnlyPublicKey::from_slice(&commitment).is_ok() {
+            return preimage;
+        }
+    }
+    panic!("failed to sample an x-only-compatible ACK commitment");
+}
