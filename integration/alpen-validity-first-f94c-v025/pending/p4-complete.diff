+/// A transaction whose witness reveals the committed ACK preimage.
+///
+/// The transition verifies the witness, not just the txid, because a txid does
+/// not commit to the witness under BIP141. A fixture attaching an arbitrary
+/// transaction would be asserting on a spend that could not have executed the
+/// ACK leaf.
+fn ack_spend_tx() -> bitcoin::Transaction {
+    let slot = crate::graph::watchtower::watchtower_slot_for_operator(
+        crate::graph::tests::TEST_POV_IDX,
+        crate::graph::tests::TEST_NONPOV_IDX,
+    )
+    .expect("counterprover has a watchtower slot");
+    let mut tx = strata_bridge_test_utils::bitcoin::generate_tx(1, 1);
+    let mut witness = bitcoin::Witness::new();
+    witness.push(crate::graph::tests::test_ack_preimage(slot));
+    tx.input[0].witness = witness;
+    tx
+}
