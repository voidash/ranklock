+
+/// Returns the fixed OP_RETURN payload committed at BridgeProof output 1.
+pub fn subject_binding_commitment_payload(manifest_digest: [u8; 32]) -> [u8; 40] {
+    let mut payload = [0u8; 40];
+    payload[..8].copy_from_slice(COMMITMENT_MAGIC);
+    payload[8..].copy_from_slice(&manifest_digest);
+    payload
+}
+
+/// Derives the exact selected commitment frozen by the threshold-v3 connector.
+pub fn selected_commitment(funded_setup_digest: [u8; 32], alternative_index: u32) -> [u8; 32] {
+    let tag_hash = sha256::Hash::hash(SELECTED_COMMITMENT_TAG).to_byte_array();
+    let mut engine = sha256::Hash::engine();
+    engine.input(&tag_hash);
+    engine.input(&tag_hash);
+    engine.input(&funded_setup_digest);
+    engine.input(&alternative_index.to_be_bytes());
+    sha256::Hash::from_engine(engine).to_byte_array()
+}
+
+fn resolution_scripts_and_output(
+    subject: &SubjectBoundAckSubjectV1,
+) -> Result<(ScriptBuf, ScriptBuf), SubjectBindingError> {
+    resolution_scripts_and_output_parts(
+        subject.selected_commitment,
+        subject.graph_pubkey.to_xonly_public_key(),
+        &subject
+            .release_pubkeys
+            .iter()
+            .map(BitcoinXOnlyPublicKey::to_xonly_public_key)
+            .collect::<Vec<_>>(),
+        usize::from(subject.threshold),
+        subject.timeout_delay,
+    )
+}
+
+fn resolution_scripts_and_output_parts(
+    selected_commitment: [u8; 32],
+    graph: XOnlyPublicKey,
+    release_pubkeys: &[XOnlyPublicKey],
+    threshold: usize,
+    timeout_delay: u16,
+) -> Result<(ScriptBuf, ScriptBuf), SubjectBindingError> {
+    if !(MIN_THRESHOLD_ACK_PARTICIPANTS..=MAX_THRESHOLD_ACK_PARTICIPANTS)
+        .contains(&release_pubkeys.len())
+    {
+        return Err(SubjectBindingError::ParticipantCount {
+            actual: release_pubkeys.len(),
+        });
+    }
+    if threshold == 0 || threshold > release_pubkeys.len() {
+        return Err(SubjectBindingError::Threshold {
+            threshold,
+            participants: release_pubkeys.len(),
+        });
+    }
+    if timeout_delay == 0 {
+        return Err(SubjectBindingError::ZeroTimeoutDelay);
+    }
+    let ack_script = threshold_ack_script(selected_commitment, graph, release_pubkeys, threshold);
+    let timeout_script = Builder::new()
+        .push_slice(selected_commitment)
+        .push_opcode(opcodes::all::OP_DROP)
+        .push_sequence(Sequence::from_height(timeout_delay))
+        .push_opcode(opcodes::all::OP_CSV)
+        .push_opcode(opcodes::all::OP_DROP)
+        .push_slice(graph.serialize())
+        .push_opcode(opcodes::all::OP_CHECKSIG)
+        .into_script();
+    let internal_key = derive_resolution_nums(selected_commitment)?;
+    let spend_info = TaprootBuilder::new()
+        .add_leaf(1, ack_script.clone())
+        .map_err(|_| SubjectBindingError::ResolutionTaprootConstruction)?
+        .add_leaf(1, timeout_script)
+        .map_err(|_| SubjectBindingError::ResolutionTaprootConstruction)?
+        .finalize(SECP256K1, internal_key)
+        .map_err(|_| SubjectBindingError::ResolutionTaprootConstruction)?;
+    Ok((
+        ack_script,
+        ScriptBuf::new_p2tr_tweaked(spend_info.output_key()),
+    ))
+}
+
+fn threshold_ack_script(
+    selected: [u8; 32],
+    graph: XOnlyPublicKey,
+    release_pubkeys: &[XOnlyPublicKey],
+    threshold: usize,
+) -> ScriptBuf {
+    let mut bytes = Builder::new()
+        .push_slice(selected)
+        .push_opcode(opcodes::all::OP_DROP)
+        .push_slice(graph.serialize())
+        .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+        .push_slice(release_pubkeys[0].serialize())
+        .push_opcode(opcodes::all::OP_CHECKSIG)
+        .into_script()
+        .into_bytes();
+    for release in &release_pubkeys[1..] {
+        bytes.extend_from_slice(
+            Builder::new()
+                .push_slice(release.serialize())
+                .push_opcode(opcodes::all::OP_CHECKSIGADD)
+                .into_script()
+                .as_bytes(),
+        );
+    }
+    bytes.extend_from_slice(
+        Builder::new()
+            .push_int(i64::try_from(threshold).expect("participant count is at most 64"))
+            .push_opcode(opcodes::all::OP_EQUAL)
+            .into_script()
+            .as_bytes(),
+    );
+    ScriptBuf::from_bytes(bytes)
+}
+
+fn derive_resolution_nums(selected: [u8; 32]) -> Result<XOnlyPublicKey, SubjectBindingError> {
+    let base = XOnlyPublicKey::from_slice(&BIP341_NUMS_BASE_POINT)
+        .map_err(|_| SubjectBindingError::ResolutionNumsDerivation)?;
+    let digest = ThresholdResolutionNumsV3Hash::hash(&selected).to_byte_array();
+    let scalar = Scalar::from_be_bytes(reduce_mod_curve_order(digest))
+        .map_err(|_| SubjectBindingError::ResolutionNumsDerivation)?;
+    base.add_tweak(SECP256K1, &scalar)
+        .map(|(key, _)| key)
+        .map_err(|_| SubjectBindingError::ResolutionNumsDerivation)
+}
+
+fn reduce_mod_curve_order(mut value: [u8; 32]) -> [u8; 32] {
+    if value < SECP256K1_ORDER {
+        return value;
+    }
+    let mut borrow = 0u16;
+    for index in (0..value.len()).rev() {
+        let minuend = u16::from(value[index]);
+        let subtrahend = u16::from(SECP256K1_ORDER[index]) + borrow;
+        if minuend >= subtrahend {
+            value[index] = (minuend - subtrahend) as u8;
+            borrow = 0;
+        } else {
+            value[index] = (minuend + 256 - subtrahend) as u8;
+            borrow = 1;
+        }
+    }
+    debug_assert_eq!(borrow, 0);
+    value
+}
+
+fn length_prefixed_hash(domain: &[u8], encoded: &[u8]) -> [u8; 32] {
+    let mut engine = sha256::Hash::engine();
+    engine.input(domain);
+    engine.input(&(encoded.len() as u64).to_be_bytes());
+    engine.input(encoded);
+    sha256::Hash::from_engine(engine).to_byte_array()
+}
+
+fn extract_op_return_payload(script: &Script) -> Option<&[u8]> {
+    let mut instructions = script.instructions();
+    let first = instructions.next()?.ok()?;
+    let second = instructions.next()?.ok()?;
+    if !matches!(first, Instruction::Op(op) if op == opcodes::all::OP_RETURN) {
+        return None;
+    }
+    let Instruction::PushBytes(bytes) = second else {
+        return None;
+    };
+    if instructions.next().is_some() {
+        return None;
+    }
+    Some(bytes.as_bytes())
+}
+
+/// Invalid subject-bound counterproof manifest or signed commitment.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SubjectBindingError {
+    /// A required digest is zero.
+    ZeroDigest(&'static str),
+    /// Participant count is outside the threshold connector's admitted range.
+    ParticipantCount {
+        /// Rejected roster length.
+        actual: usize,
+    },
+    /// Threshold is zero or exceeds the participant count.
+    Threshold {
+        /// Rejected threshold.
+        threshold: usize,
+        /// Available participant count.
+        participants: usize,
+    },
+    /// Graph and release authorization domains alias.
+    ControllerAlias {
+        /// First controller role.
+        first: &'static str,
+        /// Aliased release-key position.
+        second_index: usize,
+    },
+    /// Release key repeats within one alternative.
+    DuplicateReleaseKey {
+        /// Repeated release-key position.
+        index: usize,
+    },
+    /// Required outpoint is null.
+    NullOutpoint(&'static str),
+    /// Resolution value is zero or outside MoneyRange.
+    ResolutionValue {
+        /// Rejected satoshi value.
+        value_sat: u64,
+    },
+    /// Exact resolution output cannot be represented by the bounded SSZ type.
+    ResolutionEncoding,
+    /// Timeout CSV delay is zero.
+    ZeroTimeoutDelay,
+    /// Exact two-leaf threshold-v3 Taproot output could not be reconstructed.
+    ResolutionTaprootConstruction,
+    /// Threshold-v3 NUMS internal key could not be derived.
+    ResolutionNumsDerivation,
+    /// Resolution script does not equal the reconstructed threshold-v3 output.
+    ResolutionScriptMismatch,
+    /// Resolution output controller aliases graph or release control.
+    ResolutionControllerAlias,
+    /// Canonical ACK template length is empty or above the v3 relay bound.
+    AckTemplateLength {
+        /// Rejected consensus byte length.
+        actual: usize,
+    },
+    /// ACK template is not a decodable Bitcoin transaction.
+    AckTransactionDecode,
+    /// ACK bytes are not canonical consensus serialization.
+    NonCanonicalAckTransaction,
+    /// ACK is not a witness-free version-3 one-input spend of exact R.
+    AckTransactionShape,
+    /// ACK transaction ID disagrees with its canonical transaction bytes.
+    AckTxidMismatch,
+    /// ACK Taproot sighash could not be computed.
+    AckSighashComputation,
+    /// ACK sighash disagrees with exact transaction, R output, and ACK leaf.
+    AckSighashMismatch,
+    /// Game index is zero.
+    ZeroGameIndex,
+    /// Alternative roster is outside the measured threshold-v3 profile.
+    AlternativeCount {
+        /// Rejected alternative count.
+        actual: usize,
+    },
+    /// The joint participant-by-alternative matrix exceeds the measured SP1 bound.
+    ReleaseMatrixTooLarge {
+        /// Ordered alternative count.
+        alternatives: usize,
+        /// Ordered participant count.
+        participants: usize,
+        /// Maximum admitted matrix cells.
+        max_cells: usize,
+    },
+    /// Alternative indices are not contiguous and ordered.
+    AlternativeOrder {
+        /// Required contiguous position.
+        expected: u32,
+        /// Encoded row position.
+        actual: u32,
+    },
+    /// Common graph/threshold/participant profile differs across rows.
+    ProfileMismatch {
+        /// Mismatching alternative position.
+        index: usize,
+    },
+    /// Row commitment is not H(P1, alternative).
+    SelectedCommitmentMismatch {
+        /// Mismatching alternative position.
+        index: usize,
+    },
+    /// Operator/game mapping repeats.
+    DuplicateOperatorGame {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// Selected commitment repeats.
+    DuplicateSelectedCommitment {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// Complete ACK subject repeats.
+    DuplicateSubject {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// Resolution outpoint repeats.
+    DuplicateResolutionOutpoint {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// ACK txid repeats.
+    DuplicateAckTxid {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// ACK sighash repeats.
+    DuplicateAckSighash {
+        /// Repeating alternative position.
+        index: usize,
+    },
+    /// Release key is reused across alternatives.
+    CrossAlternativeReleaseKeyReuse {
+        /// Alternative containing the reused key.
+        index: usize,
+    },
+    /// Canonical length cannot be represented.
+    EncodingLengthOverflow,
+    /// Counterproof input index is absent.
+    InputIndexOutOfRange,
+    /// Signed transaction spends another Contest proof outpoint.
+    ContestOutpointMismatch,
+    /// Fixed commitment output 1 is absent.
+    CommitmentOutputMissing,
+    /// Commitment output carries nonzero value.
+    CommitmentOutputValue,
+    /// Commitment output is not exact OP_RETURN PUSH40.
+    CommitmentOutputScript,
+    /// Signed commitment payload differs from the manifest digest.
+    CommitmentDigestMismatch,
+    /// Requested alternative is outside the manifest.
+    AlternativeIndexOutOfRange,
+    /// Selected row does not match the verified counterproof operator/game.
+    CounterproofIdentityMismatch,
+}
+
+impl fmt::Display for SubjectBindingError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "invalid subject-bound counterproof: {self:?}")
+    }
+}
+
+impl std::error::Error for SubjectBindingError {}
