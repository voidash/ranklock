+/// Exact threshold-v3 ACK subject emitted by the new counterproof guest.
+#[derive(Debug, Clone, PartialEq, Eq, Encode, Decode)]
+pub struct SubjectBoundAckSubjectV1 {
+    /// P1-selected commitment embedded in both resolution leaves.
+    pub selected_commitment: [u8; 32],
+    /// Graph authorization key.
+    pub graph_pubkey: BitcoinXOnlyPublicKey,
+    /// Exact release threshold.
+    pub threshold: u16,
+    /// Alternative-scoped release keys in participant order.
+    pub release_pubkeys: Vec<BitcoinXOnlyPublicKey>,
+    /// Counterproof-created resolution outpoint.
+    pub resolution_outpoint: BitcoinOutPoint,
+    /// Exact resolution amount and P2TR scriptPubKey.
+    pub resolution_tx_out: BitcoinTxOut,
+    /// Positive CSV delay committed by the competing timeout leaf.
+    pub timeout_delay: u16,
+    /// Canonical witness-free ACK transaction template.
+    pub ack_transaction: RawBitcoinTx,
+    /// Exact non-witness ACK transaction ID.
+    pub ack_txid: BitcoinTxid,
+    /// Exact ACK Taproot sighash signed by graph and release keys.
+    pub ack_sighash: [u8; 32],
+}
+
+impl SubjectBoundAckSubjectV1 {
+    /// Constructs and validates an exact subject from a canonical witness-free
+    /// ACK template, deriving the R script, ACK txid, and BIP341 sighash rather
+    /// than accepting those identities as caller assertions.
+    #[allow(clippy::too_many_arguments)]
+    pub fn from_ack_template(
+        selected_commitment: [u8; 32],
+        graph_pubkey: BitcoinXOnlyPublicKey,
+        threshold: u16,
+        release_pubkeys: Vec<BitcoinXOnlyPublicKey>,
+        resolution_outpoint: BitcoinOutPoint,
+        resolution_value: Amount,
+        timeout_delay: u16,
+        ack_transaction: Transaction,
+    ) -> Result<Self, SubjectBindingError> {
+        let (ack_script, resolution_script) = resolution_scripts_and_output_parts(
+            selected_commitment,
+            graph_pubkey.to_xonly_public_key(),
+            &release_pubkeys
+                .iter()
+                .map(BitcoinXOnlyPublicKey::to_xonly_public_key)
+                .collect::<Vec<_>>(),
+            usize::from(threshold),
+            timeout_delay,
+        )?;
+        let resolution_tx_out = TxOut {
+            value: resolution_value,
+            script_pubkey: resolution_script,
+        };
+        let ack_sighash = SighashCache::new(&ack_transaction)
+            .taproot_script_spend_signature_hash(
+                0,
+                &Prevouts::All(std::slice::from_ref(&resolution_tx_out)),
+                TapLeafHash::from_script(&ack_script, bitcoin::taproot::LeafVersion::TapScript),
+                TapSighashType::Default,
+            )
+            .map_err(|_| SubjectBindingError::AckSighashComputation)?
+            .to_byte_array();
+        let candidate = Self {
+            selected_commitment,
+            graph_pubkey,
+            threshold,
+            release_pubkeys,
+            resolution_outpoint,
+            resolution_tx_out: BitcoinTxOut::try_from(resolution_tx_out)
+                .map_err(|_| SubjectBindingError::ResolutionEncoding)?,
+            timeout_delay,
+            ack_txid: BitcoinTxid::new(&ack_transaction.compute_txid()),
+            ack_sighash,
+            ack_transaction: RawBitcoinTx::from(ack_transaction),
+        };
+        candidate.validate()?;
+        Ok(candidate)
+    }
+
+    fn validate(&self) -> Result<(), SubjectBindingError> {
+        if self.selected_commitment == [0; 32] {
+            return Err(SubjectBindingError::ZeroDigest("selected commitment"));
+        }
+        let participant_count = self.release_pubkeys.len();
+        if !(MIN_THRESHOLD_ACK_PARTICIPANTS..=MAX_THRESHOLD_ACK_PARTICIPANTS)
+            .contains(&participant_count)
+        {
+            return Err(SubjectBindingError::ParticipantCount {
+                actual: participant_count,
+            });
+        }
+        let threshold = usize::from(self.threshold);
+        if threshold == 0 || threshold > participant_count {
+            return Err(SubjectBindingError::Threshold {
+                threshold,
+                participants: participant_count,
+            });
+        }
+        let graph = self.graph_pubkey.to_xonly_public_key().serialize();
+        let mut release_keys = BTreeSet::new();
+        for (index, key) in self.release_pubkeys.iter().enumerate() {
+            let serialized = key.to_xonly_public_key().serialize();
+            if serialized == graph {
+                return Err(SubjectBindingError::ControllerAlias {
+                    first: "graph",
+                    second_index: index,
+                });
+            }
+            if !release_keys.insert(serialized) {
+                return Err(SubjectBindingError::DuplicateReleaseKey { index });
+            }
+        }
+        if self.resolution_outpoint.outpoint().is_null() {
+            return Err(SubjectBindingError::NullOutpoint("resolution"));
+        }
+        let resolution: TxOut = self.resolution_tx_out.clone().into();
+        if resolution.value == Amount::ZERO || resolution.value > Amount::MAX_MONEY {
+            return Err(SubjectBindingError::ResolutionValue {
+                value_sat: resolution.value.to_sat(),
+            });
+        }
+        if self.timeout_delay == 0 {
+            return Err(SubjectBindingError::ZeroTimeoutDelay);
+        }
+        let (ack_script, expected_resolution_script) = resolution_scripts_and_output(self)?;
+        if resolution.script_pubkey != expected_resolution_script {
+            return Err(SubjectBindingError::ResolutionScriptMismatch);
+        }
+        let output_key: [u8; 32] = resolution.script_pubkey.as_bytes()[2..]
+            .try_into()
+            .map_err(|_| SubjectBindingError::ResolutionScriptMismatch)?;
+        if output_key == graph || release_keys.contains(&output_key) {
+            return Err(SubjectBindingError::ResolutionControllerAlias);
+        }
+        let ack_bytes = self.ack_transaction.as_raw_bytes();
+        if ack_bytes.is_empty() || ack_bytes.len() > MAX_ACK_TEMPLATE_BYTES {
+            return Err(SubjectBindingError::AckTemplateLength {
+                actual: ack_bytes.len(),
+            });
+        }
+        let ack: Transaction = (&self.ack_transaction)
+            .try_into()
+            .map_err(|_| SubjectBindingError::AckTransactionDecode)?;
+        if consensus::serialize(&ack) != ack_bytes {
+            return Err(SubjectBindingError::NonCanonicalAckTransaction);
+        }
+        if ack.version != Version(3)
+            || ack.input.len() != 1
+            || ack.input[0].previous_output != *self.resolution_outpoint.outpoint()
+            || !ack.input[0].witness.is_empty()
+        {
+            return Err(SubjectBindingError::AckTransactionShape);
+        }
+        if ack.compute_txid() != self.ack_txid.inner() {
+            return Err(SubjectBindingError::AckTxidMismatch);
+        }
+        let sighash = SighashCache::new(&ack)
+            .taproot_script_spend_signature_hash(
+                0,
+                &Prevouts::All(std::slice::from_ref(&resolution)),
+                TapLeafHash::from_script(&ack_script, bitcoin::taproot::LeafVersion::TapScript),
+                TapSighashType::Default,
+            )
+            .map_err(|_| SubjectBindingError::AckSighashComputation)?;
+        if sighash.to_byte_array() != self.ack_sighash {
+            return Err(SubjectBindingError::AckSighashMismatch);
+        }
+        if self.ack_txid.inner() == bitcoin::Txid::all_zeros() {
+            return Err(SubjectBindingError::ZeroDigest("ACK txid"));
+        }
+        if self.ack_sighash == [0; 32] {
+            return Err(SubjectBindingError::ZeroDigest("ACK sighash"));
+        }
+        Ok(())
+    }
+
+    fn canonical_bytes(&self) -> Result<Vec<u8>, SubjectBindingError> {
+        self.validate()?;
+        let resolution: TxOut = self.resolution_tx_out.clone().into();
+        let participant_count = u16::try_from(self.release_pubkeys.len())
+            .map_err(|_| SubjectBindingError::EncodingLengthOverflow)?;
+        let mut encoded = Vec::with_capacity(314);
+        encoded.extend_from_slice(SUBJECT_MAGIC);
+        encoded.extend_from_slice(&self.selected_commitment);
+        encoded.extend_from_slice(&self.graph_pubkey.to_xonly_public_key().serialize());
+        encoded.extend_from_slice(&participant_count.to_be_bytes());
+        encoded.extend_from_slice(&self.threshold.to_be_bytes());
+        for key in &self.release_pubkeys {
+            encoded.extend_from_slice(&key.to_xonly_public_key().serialize());
+        }
+        encoded.extend_from_slice(&consensus::serialize(self.resolution_outpoint.outpoint()));
+        encoded.extend_from_slice(&resolution.value.to_sat().to_be_bytes());
+        encoded.extend_from_slice(resolution.script_pubkey.as_bytes());
+        encoded.extend_from_slice(&self.timeout_delay.to_be_bytes());
+        let ack_bytes = self.ack_transaction.as_raw_bytes();
+        let ack_len = u32::try_from(ack_bytes.len())
+            .map_err(|_| SubjectBindingError::EncodingLengthOverflow)?;
+        encoded.extend_from_slice(&ack_len.to_be_bytes());
+        encoded.extend_from_slice(ack_bytes);
+        encoded.extend_from_slice(&consensus::serialize(&self.ack_txid.inner()));
+        encoded.extend_from_slice(&self.ack_sighash);
+        Ok(encoded)
+    }
+
+    /// Returns the canonical subject digest committed by one manifest row.
+    pub fn digest(&self) -> Result<[u8; 32], SubjectBindingError> {
+        Ok(length_prefixed_hash(
+            SUBJECT_DOMAIN,
+            &self.canonical_bytes()?,
+        ))
+    }
+}
+
+/// One operator/game mapping in the signed subject manifest.
+#[derive(Debug, Clone, PartialEq, Eq, Encode, Decode)]
+pub struct SubjectBindingRowV1 {
+    /// Contiguous alternative index.
+    pub alternative_index: u32,
+    /// Operator master x-only key from the counterproof statement.
+    pub operator_pubkey: BitcoinXOnlyPublicKey,
+    /// Nonzero game index from the counterproof statement.
+    pub game_idx: u32,
+    /// Exact selected ACK subject.
+    pub ack_subject: SubjectBoundAckSubjectV1,
+}
+
+impl SubjectBindingRowV1 {
+    fn canonical_bytes(&self) -> Result<Vec<u8>, SubjectBindingError> {
+        if self.game_idx == 0 {
+            return Err(SubjectBindingError::ZeroGameIndex);
+        }
+        let mut encoded = Vec::new();
+        encoded.extend_from_slice(&self.alternative_index.to_be_bytes());
+        encoded.extend_from_slice(&self.operator_pubkey.to_xonly_public_key().serialize());
+        encoded.extend_from_slice(&self.game_idx.to_le_bytes());
+        encoded.extend_from_slice(&self.ack_subject.canonical_bytes()?);
+        Ok(encoded)
+    }
+}
+
+/// Complete P1/ACK roster committed by the signed BridgeProof transaction.
+#[derive(Debug, Clone, PartialEq, Eq, Encode, Decode)]
+pub struct SubjectBindingManifestV1 {
+    /// Exact Contest proof outpoint spent by the signed BridgeProof transaction.
+    pub contest_proof_outpoint: BitcoinOutPoint,
+    /// Content-derived funded threshold-v3 P1 digest.
+    pub funded_setup_digest: [u8; 32],
+    /// Complete ordered alternative roster.
+    pub rows: Vec<SubjectBindingRowV1>,
+}
+
+impl SubjectBindingManifestV1 {
+    /// Validates the complete manifest and every cross-row uniqueness rule.
+    pub fn validate(&self) -> Result<(), SubjectBindingError> {
+        if self.contest_proof_outpoint.outpoint().is_null() {
+            return Err(SubjectBindingError::NullOutpoint("contest proof"));
+        }
+        if self.funded_setup_digest == [0; 32] {
+            return Err(SubjectBindingError::ZeroDigest("funded setup"));
+        }
+        if !(MIN_THRESHOLD_V3_ALTERNATIVES..=MAX_THRESHOLD_V3_ALTERNATIVES)
+            .contains(&self.rows.len())
+        {
+            return Err(SubjectBindingError::AlternativeCount {
+                actual: self.rows.len(),
+            });
+        }
+        let first = &self.rows[0].ack_subject;
+        first.validate()?;
+        let expected_graph = first.graph_pubkey.to_xonly_public_key().serialize();
+        let expected_threshold = first.threshold;
+        let expected_participants = first.release_pubkeys.len();
+        let release_cells = self.rows.len().checked_mul(expected_participants).ok_or(
+            SubjectBindingError::ReleaseMatrixTooLarge {
+                alternatives: self.rows.len(),
+                participants: expected_participants,
+                max_cells: MAX_THRESHOLD_V3_RELEASE_CELLS,
+            },
+        )?;
+        if release_cells > MAX_THRESHOLD_V3_RELEASE_CELLS {
+            return Err(SubjectBindingError::ReleaseMatrixTooLarge {
+                alternatives: self.rows.len(),
+                participants: expected_participants,
+                max_cells: MAX_THRESHOLD_V3_RELEASE_CELLS,
+            });
+        }
+        let mut operator_games = BTreeSet::new();
+        let mut selected_commitments = BTreeSet::new();
+        let mut subject_digests = BTreeSet::new();
+        let mut resolution_outpoints = BTreeSet::new();
+        let mut ack_txids = BTreeSet::new();
+        let mut ack_sighashes = BTreeSet::new();
+        let mut global_release_keys = BTreeSet::new();
+        for (index, row) in self.rows.iter().enumerate() {
+            let expected_index =
+                u32::try_from(index).map_err(|_| SubjectBindingError::EncodingLengthOverflow)?;
+            if row.alternative_index != expected_index {
+                return Err(SubjectBindingError::AlternativeOrder {
+                    expected: expected_index,
+                    actual: row.alternative_index,
+                });
+            }
+            row.ack_subject.validate()?;
+            if row.game_idx == 0 {
+                return Err(SubjectBindingError::ZeroGameIndex);
+            }
+            if row
+                .ack_subject
+                .graph_pubkey
+                .to_xonly_public_key()
+                .serialize()
+                != expected_graph
+                || row.ack_subject.threshold != expected_threshold
+                || row.ack_subject.release_pubkeys.len() != expected_participants
+            {
+                return Err(SubjectBindingError::ProfileMismatch { index });
+            }
+            let expected_selected =
+                selected_commitment(self.funded_setup_digest, row.alternative_index);
+            if row.ack_subject.selected_commitment != expected_selected {
+                return Err(SubjectBindingError::SelectedCommitmentMismatch { index });
+            }
+            let operator_game = (
+                row.operator_pubkey.to_xonly_public_key().serialize(),
+                row.game_idx,
+            );
+            if !operator_games.insert(operator_game) {
+                return Err(SubjectBindingError::DuplicateOperatorGame { index });
+            }
+            if !selected_commitments.insert(row.ack_subject.selected_commitment) {
+                return Err(SubjectBindingError::DuplicateSelectedCommitment { index });
+            }
+            if !subject_digests.insert(row.ack_subject.digest()?) {
+                return Err(SubjectBindingError::DuplicateSubject { index });
+            }
+            if !resolution_outpoints.insert(*row.ack_subject.resolution_outpoint.outpoint()) {
+                return Err(SubjectBindingError::DuplicateResolutionOutpoint { index });
+            }
+            if !ack_txids.insert(row.ack_subject.ack_txid.inner()) {
+                return Err(SubjectBindingError::DuplicateAckTxid { index });
+            }
+            if !ack_sighashes.insert(row.ack_subject.ack_sighash) {
+                return Err(SubjectBindingError::DuplicateAckSighash { index });
+            }
+            for key in &row.ack_subject.release_pubkeys {
+                let serialized = key.to_xonly_public_key().serialize();
+                if !global_release_keys.insert(serialized) {
+                    return Err(SubjectBindingError::CrossAlternativeReleaseKeyReuse { index });
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Returns the canonical manifest bytes committed by the signed transaction.
+    pub fn canonical_bytes(&self) -> Result<Vec<u8>, SubjectBindingError> {
+        self.validate()?;
+        let count = u16::try_from(self.rows.len())
+            .map_err(|_| SubjectBindingError::EncodingLengthOverflow)?;
+        let mut encoded = Vec::new();
+        encoded.extend_from_slice(MANIFEST_MAGIC);
+        encoded.extend_from_slice(&consensus::serialize(
+            self.contest_proof_outpoint.outpoint(),
+        ));
+        encoded.extend_from_slice(&self.funded_setup_digest);
+        encoded.extend_from_slice(&count.to_be_bytes());
+        for row in &self.rows {
+            encoded.extend_from_slice(&row.canonical_bytes()?);
+        }
+        Ok(encoded)
+    }
+
+    /// Returns the exact digest placed in the signed commitment output.
+    pub fn digest(&self) -> Result<[u8; 32], SubjectBindingError> {
+        Ok(length_prefixed_hash(
+            MANIFEST_DOMAIN,
+            &self.canonical_bytes()?,
+        ))
+    }
+
+    /// Authenticates and selects one row from an operator-signed transaction.
+    pub fn select_from_signed_transaction(
+        &self,
+        transaction: &Transaction,
+        counterproof_input_index: u32,
+        alternative_index: u32,
+        operator_pubkey: &BitcoinXOnlyPublicKey,
+        game_idx: u32,
+    ) -> Result<SubjectBoundAckSubjectV1, SubjectBindingError> {
+        self.validate()?;
+        let input_index = usize::try_from(counterproof_input_index)
+            .map_err(|_| SubjectBindingError::InputIndexOutOfRange)?;
+        let input = transaction
+            .input
+            .get(input_index)
+            .ok_or(SubjectBindingError::InputIndexOutOfRange)?;
+        if &input.previous_output != self.contest_proof_outpoint.outpoint() {
+            return Err(SubjectBindingError::ContestOutpointMismatch);
+        }
+        let commitment_output = transaction
+            .output
+            .get(SUBJECT_COMMITMENT_VOUT)
+            .ok_or(SubjectBindingError::CommitmentOutputMissing)?;
+        if commitment_output.value != Amount::ZERO {
+            return Err(SubjectBindingError::CommitmentOutputValue);
+        }
+        let payload = extract_op_return_payload(&commitment_output.script_pubkey)
+            .ok_or(SubjectBindingError::CommitmentOutputScript)?;
+        let expected_payload = subject_binding_commitment_payload(self.digest()?);
+        if payload != expected_payload {
+            return Err(SubjectBindingError::CommitmentDigestMismatch);
+        }
+        let selected_index = usize::try_from(alternative_index)
+            .map_err(|_| SubjectBindingError::AlternativeIndexOutOfRange)?;
+        let row = self
+            .rows
+            .get(selected_index)
+            .ok_or(SubjectBindingError::AlternativeIndexOutOfRange)?;
+        if row.alternative_index != alternative_index
+            || &row.operator_pubkey != operator_pubkey
+            || row.game_idx != game_idx
+        {
+            return Err(SubjectBindingError::CounterproofIdentityMismatch);
+        }
+        Ok(row.ack_subject.clone())
+    }
+}
+
