+//! Reorg-aware Bitcoin confirmation for a verified subject-bound counterproof.
+//!
+//! This module composes two independently checked facts:
+//! - [`TxidBoundSubjectCounterproofV1`] authenticates the exact non-witness BridgeProof transaction
+//!   identity and threshold ACK subject under the pinned SP1 Groth16 verifier; and
+//! - Bitcoin Core reports the exact supplied transaction in a valid block at an active-chain height
+//!   with the required confirmation count.
+//!
+//! The resulting capabilities are deliberately live and non-serializable.
+//! Chain membership is reorg-sensitive, so a caller must create a fresh
+//! capability immediately before every irreversible action. A second helper
+//! binds the authenticated subject to an independently verified threshold-v3
+//! ACK witness, checks Bitcoin before and after immutable first-writer witness
+//! adoption, and treats every conflict as an error. The durable row remains an
+//! inert witness record: this module does not persist admission, release new
+//! threshold signatures, publish an ACK, or make funding eligible.
+
+use std::{fmt::Debug, num::NonZeroU64};
+
+use bitcoin::{
+    BlockHash, Transaction, TxOut, Txid,
+    consensus::{self, encode::Error as ConsensusEncodingError},
+    transaction::Version,
+};
+use bitcoind_async_client::{Client as BitcoinClient, error::ClientError, traits::Reader};
+use strata_bridge_counterproof::{SubjectBoundAckSubjectV1, TxidBoundSubjectCounterproofV1};
+use strata_bridge_db::{traits::BridgeDb, types::V026AckWitnessWriteOutcomeV3};
+use strata_bridge_sm::v026_admission_v3::{
+    PersistedThresholdAckWitnessSelectionV3, VerifiedThresholdAckWitnessSelectionV3,
+};
+use thiserror::Error;
+
+/// A live subject-bound receipt capability observed on Bitcoin Core's active chain.
+///
+/// This type has no serialization implementation and can only be constructed by
+/// [`confirm_subject_bound_counterproof`]. It is a point-in-time observation,
+/// not a durable finality certificate or funding authority.
+#[derive(Debug, PartialEq, Eq)]
+pub struct CanonicallyConfirmedSubjectCounterproofV1 {
+    bound_counterproof: TxidBoundSubjectCounterproofV1,
+    transaction: Transaction,
+    block_hash: BlockHash,
+    block_height: u64,
+    minimum_confirmations: NonZeroU64,
+    confirmations: NonZeroU64,
+}
+
+impl CanonicallyConfirmedSubjectCounterproofV1 {
+    /// Receipt capability bound to the exact BridgeProof and ACK identities.
+    pub const fn bound_counterproof(&self) -> &TxidBoundSubjectCounterproofV1 {
+        &self.bound_counterproof
+    }
+
+    /// Exact transaction returned by Bitcoin Core and found in the active-chain block.
+    pub const fn transaction(&self) -> &Transaction {
+        &self.transaction
+    }
+
+    /// Active-chain block containing the exact transaction at verification time.
+    pub const fn block_hash(&self) -> BlockHash {
+        self.block_hash
+    }
+
+    /// Active-chain height containing the exact transaction at verification time.
+    pub const fn block_height(&self) -> u64 {
+        self.block_height
+    }
+
+    /// Policy floor used when this live capability was created.
+    pub const fn minimum_confirmations(&self) -> NonZeroU64 {
+        self.minimum_confirmations
+    }
+
+    /// Confirmation count from the final Bitcoin Core read.
+    pub const fn confirmations(&self) -> NonZeroU64 {
+        self.confirmations
+    }
+
+    /// Confirmation does not qualify the protocol for funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+/// Confirms a receipt-bound BridgeProof transaction against Bitcoin Core.
+///
+/// The verifier requires exact full transaction equality, not merely txid
+/// equality. It independently checks the containing block's Merkle root and
+/// active-chain height mapping, then repeats both the transaction lookup and
+/// active-chain lookup before returning. A reorganization after this function
+/// returns can still invalidate the observation, so consumers must not persist
+/// or reuse this capability across an irreversible action boundary.
+pub async fn confirm_subject_bound_counterproof(
+    bitcoin_client: &BitcoinClient,
+    bound_counterproof: TxidBoundSubjectCounterproofV1,
+    expected_transaction: &Transaction,
+    minimum_confirmations: NonZeroU64,
+) -> Result<CanonicallyConfirmedSubjectCounterproofV1, SubjectBoundConfirmationError> {
+    let expected_txid = expected_transaction.compute_txid();
+    if bound_counterproof.bridge_proof_txid().inner() != expected_txid {
+        return Err(SubjectBoundConfirmationError::ReceiptTransactionMismatch {
+            authenticated: bound_counterproof.bridge_proof_txid().inner(),
+            supplied: expected_txid,
+        });
+    }
+
+    let observation =
+        confirm_exact_transaction(bitcoin_client, expected_transaction, minimum_confirmations)
+            .await?;
+
+    Ok(CanonicallyConfirmedSubjectCounterproofV1 {
+        bound_counterproof,
+        transaction: expected_transaction.clone(),
+        block_hash: observation.block_hash,
+        block_height: observation.block_height,
+        minimum_confirmations,
+        confirmations: observation.confirmations,
+    })
+}
+
+/// A fresh receipt/ACK binding after immutable witness adoption.
+///
+/// This value is deliberately non-serializable and non-cloneable. The durable
+/// witness row remains inert; only this live result proves that the exact
+/// receipt subject matched the adopted witness and that Bitcoin confirmation
+/// was rechecked after the database action. A later reorganization can still
+/// invalidate the observation.
+#[derive(Debug, PartialEq, Eq)]
+pub struct CanonicallyConfirmedThresholdAckAdoptionV1 {
+    confirmation: CanonicallyConfirmedSubjectCounterproofV1,
+    witness_selection: PersistedThresholdAckWitnessSelectionV3,
+}
+
+impl CanonicallyConfirmedThresholdAckAdoptionV1 {
+    /// Fresh canonical-chain confirmation observed after witness adoption.
+    pub const fn confirmation(&self) -> &CanonicallyConfirmedSubjectCounterproofV1 {
+        &self.confirmation
+    }
+
+    /// Exact immutable witness selected by the database first writer.
+    pub const fn witness_selection(&self) -> &PersistedThresholdAckWitnessSelectionV3 {
+        &self.witness_selection
+    }
+
+    /// This runtime boundary cannot authorize graph funding.
+    pub const fn funding_eligible(&self) -> bool {
+        false
+    }
+}
+
+/// Reconfirms a receipt, binds it to one exact threshold-v3 ACK witness, and
+/// atomically adopts that witness under its selected commitment.
+///
+/// Bitcoin is checked before the database action and again after it. A created
+/// or exact-replay row is accepted only when the database returns the exact
+/// proposed inert value. A conflicting first writer is a hard error. Neither
+/// the durable row nor the returned live capability broadcasts the ACK,
+/// releases signatures, admits a graph, or enables funding.
+pub async fn reconfirm_and_adopt_threshold_ack_witness_selection_v3<Database>(
+    bitcoin_client: &BitcoinClient,
+    database: &Database,
+    prior_confirmation: CanonicallyConfirmedSubjectCounterproofV1,
+    witness_selection: VerifiedThresholdAckWitnessSelectionV3,
+) -> Result<CanonicallyConfirmedThresholdAckAdoptionV1, SubjectBoundAckAdoptionError<Database::Error>>
+where
+    Database: BridgeDb,
+{
+    let before = reconfirm_subject_bound_counterproof(bitcoin_client, prior_confirmation)
+        .await
+        .map_err(SubjectBoundAckAdoptionError::PreAdoptionConfirmation)?;
+    let proposed = witness_selection.to_persisted();
+    verify_ack_subject_matches_selection(before.bound_counterproof().ack_subject(), &proposed)
+        .map_err(SubjectBoundAckAdoptionError::SubjectBinding)?;
+
+    let outcome = database
+        .get_or_set_v026_ack_witness_selection_v3(witness_selection)
+        .await
+        .map_err(SubjectBoundAckAdoptionError::Database)?;
+    let durable = require_exact_adoption(outcome, &proposed)
+        .map_err(SubjectBoundAckAdoptionError::Adoption)?;
+
+    let after = reconfirm_subject_bound_counterproof(bitcoin_client, before)
+        .await
+        .map_err(SubjectBoundAckAdoptionError::PostAdoptionConfirmation)?;
+    verify_ack_subject_matches_selection(after.bound_counterproof().ack_subject(), &durable)
+        .map_err(SubjectBoundAckAdoptionError::SubjectBinding)?;
+
+    Ok(CanonicallyConfirmedThresholdAckAdoptionV1 {
+        confirmation: after,
+        witness_selection: durable,
+    })
+}
+
+async fn reconfirm_subject_bound_counterproof(
+    bitcoin_client: &BitcoinClient,
+    prior: CanonicallyConfirmedSubjectCounterproofV1,
+) -> Result<CanonicallyConfirmedSubjectCounterproofV1, SubjectBoundConfirmationError> {
+    let CanonicallyConfirmedSubjectCounterproofV1 {
+        bound_counterproof,
+        transaction,
+        minimum_confirmations,
+        ..
+    } = prior;
+    confirm_subject_bound_counterproof(
+        bitcoin_client,
+        bound_counterproof,
+        &transaction,
+        minimum_confirmations,
+    )
+    .await
+}
+
+fn verify_ack_subject_matches_selection(
+    receipt_subject: &SubjectBoundAckSubjectV1,
+    selection: &PersistedThresholdAckWitnessSelectionV3,
+) -> Result<(), SubjectBoundAckSelectionBindingError> {
+    let selected = selection.subject();
+    if receipt_subject.selected_commitment != selected.selected_commitment {
+        return Err(SubjectBoundAckSelectionBindingError::SelectedCommitment);
+    }
+    if receipt_subject
+        .graph_pubkey
+        .to_xonly_public_key()
+        .serialize()
+        != selected.graph_pubkey
+    {
+        return Err(SubjectBoundAckSelectionBindingError::GraphPubkey);
+    }
+    let receipt_participant_count = u16::try_from(receipt_subject.release_pubkeys.len())
+        .map_err(|_| SubjectBoundAckSelectionBindingError::ParticipantCount)?;
+    if receipt_participant_count != selected.participant_count {
+        return Err(SubjectBoundAckSelectionBindingError::ParticipantCount);
+    }
+    if receipt_subject.threshold != selected.threshold {
+        return Err(SubjectBoundAckSelectionBindingError::Threshold);
+    }
+    for (index, (receipt, adopted)) in receipt_subject
+        .release_pubkeys
+        .iter()
+        .zip(&selected.release_pubkeys)
+        .enumerate()
+    {
+        if receipt.to_xonly_public_key().serialize() != *adopted {
+            return Err(SubjectBoundAckSelectionBindingError::ReleasePubkey { index });
+        }
+    }
+    if receipt_subject.resolution_outpoint.outpoint() != &selected.resolution_outpoint {
+        return Err(SubjectBoundAckSelectionBindingError::ResolutionOutpoint);
+    }
+    let receipt_resolution: TxOut = receipt_subject.resolution_tx_out.clone().into();
+    if receipt_resolution != selected.resolution_tx_out {
+        return Err(SubjectBoundAckSelectionBindingError::ResolutionTxOut);
+    }
+    if receipt_subject.ack_txid.inner() != selected.ack_txid {
+        return Err(SubjectBoundAckSelectionBindingError::AckTxid);
+    }
+    if receipt_subject.ack_sighash != selected.ack_sighash {
+        return Err(SubjectBoundAckSelectionBindingError::AckSighash);
+    }
+
+    let mut finalized: Transaction = consensus::deserialize(selection.finalized_ack())
+        .map_err(SubjectBoundAckSelectionBindingError::FinalizedAckDecode)?;
+    for input in &mut finalized.input {
+        input.witness.clear();
+    }
+    if finalized.version != Version(3)
+        || consensus::serialize(&finalized) != receipt_subject.ack_transaction.as_raw_bytes()
+    {
+        return Err(SubjectBoundAckSelectionBindingError::AckTemplate);
+    }
+    Ok(())
+}
+
+fn require_exact_adoption(
+    outcome: V026AckWitnessWriteOutcomeV3,
+    proposed: &PersistedThresholdAckWitnessSelectionV3,
+) -> Result<PersistedThresholdAckWitnessSelectionV3, SubjectBoundAckAdoptionOutcomeError> {
+    match outcome {
+        V026AckWitnessWriteOutcomeV3::Created(durable)
+        | V026AckWitnessWriteOutcomeV3::ExactReplay(durable) => {
+            if durable.as_ref() != proposed {
+                return Err(SubjectBoundAckAdoptionOutcomeError::DatabaseOutcomeMismatch);
+            }
+            Ok(*durable)
+        }
+        V026AckWitnessWriteOutcomeV3::Conflict {
+            durable,
+            proposed: rejected,
+        } => {
+            if rejected.as_ref() != proposed {
+                return Err(SubjectBoundAckAdoptionOutcomeError::DatabaseOutcomeMismatch);
+            }
+            Err(SubjectBoundAckAdoptionOutcomeError::WitnessConflict {
+                durable,
+                proposed: rejected,
+            })
+        }
+    }
+}
+
+/// Exact receipt-subject mismatch against one verified threshold-v3 witness.
+#[derive(Debug, Error)]
+pub enum SubjectBoundAckSelectionBindingError {
+    /// P1-selected commitment differs.
+    #[error("receipt and adopted witness use different selected commitments")]
+    SelectedCommitment,
+    /// Graph authorization key differs.
+    #[error("receipt and adopted witness use different graph authorization keys")]
+    GraphPubkey,
+    /// Participant count differs or cannot be represented by the fixed profile.
+    #[error("receipt and adopted witness use different participant counts")]
+    ParticipantCount,
+    /// Release threshold differs.
+    #[error("receipt and adopted witness use different release thresholds")]
+    Threshold,
+    /// One alternative-scoped release key differs.
+    #[error("receipt and adopted witness differ at release key index {index}")]
+    ReleasePubkey {
+        /// Canonical participant index.
+        index: usize,
+    },
+    /// Selected resolution outpoint differs.
+    #[error("receipt and adopted witness spend different resolution outpoints")]
+    ResolutionOutpoint,
+    /// Selected resolution value or script differs.
+    #[error("receipt and adopted witness bind different resolution outputs")]
+    ResolutionTxOut,
+    /// Non-witness ACK transaction ID differs.
+    #[error("receipt and adopted witness bind different ACK transaction ids")]
+    AckTxid,
+    /// Exact BIP341 ACK sighash differs.
+    #[error("receipt and adopted witness bind different ACK sighashes")]
+    AckSighash,
+    /// Durable finalized ACK bytes failed consensus decoding.
+    #[error("durable finalized ACK failed consensus decoding: {0}")]
+    FinalizedAckDecode(ConsensusEncodingError),
+    /// Witness-stripped finalized ACK differs from the receipt-authenticated template.
+    #[error("durable finalized ACK does not match the receipt-authenticated template")]
+    AckTemplate,
+}
+
+/// Fail-closed interpretation of the database first-writer result.
+#[derive(Debug, Error)]
+pub enum SubjectBoundAckAdoptionOutcomeError {
+    /// A database implementation returned a value inconsistent with the input.
+    #[error("database ACK adoption outcome does not contain the exact proposed witness")]
+    DatabaseOutcomeMismatch,
+    /// Another valid witness already owns this selected commitment.
+    #[error("another ACK witness already owns the selected commitment")]
+    WitnessConflict {
+        /// Durable first-writer selection.
+        durable: Box<PersistedThresholdAckWitnessSelectionV3>,
+        /// Rejected alternate valid selection.
+        proposed: Box<PersistedThresholdAckWitnessSelectionV3>,
+    },
+}
+
+/// Exact failure while binding, reconfirming, and adopting one ACK witness.
+#[derive(Debug, Error)]
+pub enum SubjectBoundAckAdoptionError<DatabaseError>
+where
+    DatabaseError: Debug,
+{
+    /// The receipt-authenticated subject differs from the proposed witness.
+    #[error("receipt/ACK witness binding failed: {0}")]
+    SubjectBinding(SubjectBoundAckSelectionBindingError),
+    /// Bitcoin was no longer confirmed immediately before the database action.
+    #[error("pre-adoption Bitcoin confirmation failed: {0}")]
+    PreAdoptionConfirmation(SubjectBoundConfirmationError),
+    /// Database access failed and was propagated without classification.
+    #[error("ACK witness database operation failed: {0:?}")]
+    Database(DatabaseError),
+    /// First-writer outcome was conflicting or inconsistent.
+    #[error("ACK witness adoption failed: {0}")]
+    Adoption(SubjectBoundAckAdoptionOutcomeError),
+    /// Bitcoin was no longer confirmed immediately after the database action.
+    #[error("post-adoption Bitcoin confirmation failed: {0}")]
+    PostAdoptionConfirmation(SubjectBoundConfirmationError),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct CanonicalTransactionObservation {
+    block_hash: BlockHash,
+    block_height: u64,
+    confirmations: NonZeroU64,
+}
+
+async fn confirm_exact_transaction(
+    bitcoin_client: &BitcoinClient,
+    expected_transaction: &Transaction,
+    minimum_confirmations: NonZeroU64,
+) -> Result<CanonicalTransactionObservation, SubjectBoundConfirmationError> {
+    let txid = expected_transaction.compute_txid();
+    let first = bitcoin_client
+        .get_raw_transaction_verbosity_one(&txid)
+        .await
+        .map_err(SubjectBoundConfirmationError::BitcoinRpc)?;
+    verify_node_transaction(&first.transaction, expected_transaction)?;
+    let first_block_hash = first
+        .block_hash
+        .ok_or(SubjectBoundConfirmationError::TransactionUnconfirmed { txid })?;
+    verify_confirmation_count(txid, first.confirmations, minimum_confirmations)?;
+
+    let block_height = bitcoin_client
+        .get_block_height(&first_block_hash)
+        .await
+        .map_err(SubjectBoundConfirmationError::BitcoinRpc)?;
+    verify_active_block_at_height(bitcoin_client, block_height, first_block_hash).await?;
+
+    let block = bitcoin_client
+        .get_block(&first_block_hash)
+        .await
+        .map_err(SubjectBoundConfirmationError::BitcoinRpc)?;
+    if block.block_hash() != first_block_hash {
+        return Err(SubjectBoundConfirmationError::BlockHashMismatch {
+            reported: first_block_hash,
+            computed: block.block_hash(),
+        });
+    }
+    if !block.check_merkle_root() {
+        return Err(SubjectBoundConfirmationError::InvalidBlockMerkleRoot {
+            block_hash: first_block_hash,
+        });
+    }
+    let exact_matches = block
+        .txdata
+        .iter()
+        .filter(|transaction| *transaction == expected_transaction)
+        .count();
+    if exact_matches != 1 {
+        return Err(
+            SubjectBoundConfirmationError::ExactTransactionMultiplicity {
+                block_hash: first_block_hash,
+                expected: 1,
+                actual: exact_matches,
+            },
+        );
+    }
+
+    let second = bitcoin_client
+        .get_raw_transaction_verbosity_one(&txid)
+        .await
+        .map_err(SubjectBoundConfirmationError::BitcoinRpc)?;
+    verify_node_transaction(&second.transaction, expected_transaction)?;
+    let second_block_hash = second
+        .block_hash
+        .ok_or(SubjectBoundConfirmationError::ReorganizedDuringVerification { txid })?;
+    if second_block_hash != first_block_hash {
+        return Err(SubjectBoundConfirmationError::ReorganizedDuringVerification { txid });
+    }
+    let confirmations =
+        verify_confirmation_count(txid, second.confirmations, minimum_confirmations)?;
+    verify_active_block_at_height(bitcoin_client, block_height, first_block_hash).await?;
+
+    Ok(CanonicalTransactionObservation {
+        block_hash: first_block_hash,
+        block_height,
+        confirmations,
+    })
+}
+
+fn verify_node_transaction(
+    node_transaction: &Transaction,
+    expected_transaction: &Transaction,
+) -> Result<(), SubjectBoundConfirmationError> {
+    if node_transaction != expected_transaction {
+        return Err(SubjectBoundConfirmationError::ExactTransactionMismatch {
+            txid: expected_transaction.compute_txid(),
+        });
+    }
+    Ok(())
+}
+
+fn verify_confirmation_count(
+    txid: Txid,
+    confirmations: Option<u64>,
+    minimum_confirmations: NonZeroU64,
+) -> Result<NonZeroU64, SubjectBoundConfirmationError> {
+    let Some(confirmations) = confirmations else {
+        return Err(SubjectBoundConfirmationError::TransactionUnconfirmed { txid });
+    };
+    let confirmations = NonZeroU64::new(confirmations)
+        .ok_or(SubjectBoundConfirmationError::TransactionUnconfirmed { txid })?;
+    if confirmations < minimum_confirmations {
+        return Err(SubjectBoundConfirmationError::InsufficientConfirmations {
+            txid,
+            required: minimum_confirmations,
+            actual: confirmations,
+        });
+    }
+    Ok(confirmations)
+}
+
+async fn verify_active_block_at_height(
+    bitcoin_client: &BitcoinClient,
+    block_height: u64,
+    reported_block_hash: BlockHash,
+) -> Result<(), SubjectBoundConfirmationError> {
+    let active_block_hash = bitcoin_client
+        .get_block_hash(block_height)
+        .await
+        .map_err(SubjectBoundConfirmationError::BitcoinRpc)?;
+    if active_block_hash != reported_block_hash {
+        return Err(SubjectBoundConfirmationError::BlockNotActive {
+            block_height,
+            reported: reported_block_hash,
+            active: active_block_hash,
+        });
+    }
+    Ok(())
+}
+
+/// Exact failure while composing proof identity with active-chain observation.
+#[derive(Debug, Error)]
+pub enum SubjectBoundConfirmationError {
+    /// The receipt capability authenticates another non-witness transaction.
+    #[error(
+        "receipt authenticates BridgeProof transaction {authenticated}, but caller supplied {supplied}"
+    )]
+    ReceiptTransactionMismatch {
+        /// Transaction authenticated by the verified receipt.
+        authenticated: Txid,
+        /// Transaction supplied for chain confirmation.
+        supplied: Txid,
+    },
+    /// Bitcoin Core returned transaction bytes different from the supplied transaction.
+    #[error("Bitcoin Core returned different full transaction bytes for {txid}")]
+    ExactTransactionMismatch {
+        /// Shared non-witness transaction ID.
+        txid: Txid,
+    },
+    /// The transaction is absent from a mined block.
+    #[error("transaction {txid} is not confirmed in a block")]
+    TransactionUnconfirmed {
+        /// Unconfirmed transaction ID.
+        txid: Txid,
+    },
+    /// The transaction has fewer confirmations than required.
+    #[error("transaction {txid} has {actual} confirmations, fewer than the required {required}")]
+    InsufficientConfirmations {
+        /// Transaction ID.
+        txid: Txid,
+        /// Required confirmation count.
+        required: NonZeroU64,
+        /// Observed confirmation count.
+        actual: NonZeroU64,
+    },
+    /// Bitcoin Core returned a block whose header hashes to another value.
+    #[error("reported block hash {reported} differs from computed block hash {computed}")]
+    BlockHashMismatch {
+        /// Block hash reported for the transaction.
+        reported: BlockHash,
+        /// Hash computed from the returned block header.
+        computed: BlockHash,
+    },
+    /// Returned block transactions do not match the header Merkle root.
+    #[error("block {block_hash} has an invalid transaction Merkle root")]
+    InvalidBlockMerkleRoot {
+        /// Rejected block.
+        block_hash: BlockHash,
+    },
+    /// The exact full transaction was absent or duplicated in the reported block.
+    #[error(
+        "block {block_hash} contains {actual} exact copies of the transaction; expected {expected}"
+    )]
+    ExactTransactionMultiplicity {
+        /// Rejected block.
+        block_hash: BlockHash,
+        /// Required exact occurrence count.
+        expected: usize,
+        /// Observed exact occurrence count.
+        actual: usize,
+    },
+    /// The block reported for the transaction is not active at its reported height.
+    #[error("block {reported} is not active at height {block_height}; active block is {active}")]
+    BlockNotActive {
+        /// Height queried from Bitcoin Core.
+        block_height: u64,
+        /// Block reported for the transaction.
+        reported: BlockHash,
+        /// Active block at that height.
+        active: BlockHash,
+    },
+    /// Chain identity changed between the verifier's two reads.
+    #[error("transaction {txid} was reorganized while confirmation was being verified")]
+    ReorganizedDuringVerification {
+        /// Transaction whose block changed or disappeared.
+        txid: Txid,
+    },
+    /// Bitcoin Core RPC transport, server, or decode failure.
+    #[error("Bitcoin Core RPC failed during subject-bound confirmation: {0:?}")]
+    BitcoinRpc(ClientError),
+}
+
+#[cfg(test)]
+mod tests {
+    use std::num::NonZeroU64;
+
+    use bitcoin::{
+        Amount, OutPoint, ScriptBuf, Sequence, TapSighashType, Transaction, TxIn, TxOut, Txid,
+        Witness, absolute,
+        blockdata::script::Builder,
+        consensus::{self, encode::deserialize_hex},
+        hashes::{Hash, HashEngine, sha256},
+        opcodes,
+        secp256k1::{Keypair, Message, Scalar, SecretKey, XOnlyPublicKey, schnorr},
+        sighash::{Prevouts, SighashCache},
+        taproot::{LeafVersion, TapLeafHash, TaprootBuilder},
+        transaction::Version,
+    };
+    use bitcoind_async_client::{Auth, Client as BitcoinClient};
+    use corepc_node::{Conf, Input, Node, Output};
+    use strata_bridge_connectors::ranklock_nums::BIP341_NUMS_BASE_POINT;
+    use strata_bridge_counterproof::SubjectBoundAckSubjectV1;
+    use strata_bridge_db::types::V026AckWitnessWriteOutcomeV3;
+    use strata_bridge_primitives::scripts::prelude::threshold_multisig_script;
+    use strata_bridge_sm::v026_admission_v3::{
+        PersistedThresholdAckWitnessSelectionV3, V026IndexedReleaseSignatureBytesV3,
+        V026PersistedAckWitnessPartsV3, V026ThresholdAckSubjectV3,
+    };
+
+    use super::{
+        SubjectBoundAckAdoptionOutcomeError, SubjectBoundAckSelectionBindingError,
+        SubjectBoundConfirmationError, confirm_exact_transaction, require_exact_adoption,
+        verify_ack_subject_matches_selection,
+    };
+
+    const SECP256K1_ORDER: [u8; 32] = [
+        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+        0xfe, 0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b, 0xbf, 0xd2, 0x5e, 0x8c, 0xd0, 0x36,
+        0x41, 0x41,
+    ];
+
+    fn keypair(seed: u8) -> Keypair {
+        let secret = SecretKey::from_slice(&[seed; 32]).expect("nonzero fixture scalar");
+        Keypair::from_secret_key(bitcoin::secp256k1::SECP256K1, &secret)
+    }
+
+    fn reduce_mod_curve_order(mut value: [u8; 32]) -> [u8; 32] {
+        if value < SECP256K1_ORDER {
+            return value;
+        }
+        let mut borrow = 0_u16;
+        for index in (0..value.len()).rev() {
+            let minuend = u16::from(value[index]);
+            let subtrahend = u16::from(SECP256K1_ORDER[index]) + borrow;
+            if minuend >= subtrahend {
+                value[index] = (minuend - subtrahend) as u8;
+                borrow = 0;
+            } else {
+                value[index] = (minuend + 256 - subtrahend) as u8;
+                borrow = 1;
+            }
+        }
+        assert_eq!(borrow, 0, "curve-order subtraction must not underflow");
+        value
+    }
+
+    fn resolution_internal_key(selected_commitment: [u8; 32]) -> XOnlyPublicKey {
+        let tag = sha256::Hash::hash(b"RankLock/v026/TaprootNUMS/v3/resolution").to_byte_array();
+        let mut engine = sha256::Hash::engine();
+        engine.input(&tag);
+        engine.input(&tag);
+        engine.input(&selected_commitment);
+        let digest = sha256::Hash::from_engine(engine).to_byte_array();
+        let scalar = Scalar::from_be_bytes(reduce_mod_curve_order(digest))
+            .expect("reduced fixture scalar must be valid");
+        let base = XOnlyPublicKey::from_slice(&BIP341_NUMS_BASE_POINT)
+            .expect("pinned NUMS base point must parse");
+        base.add_tweak(bitcoin::secp256k1::SECP256K1, &scalar)
+            .expect("fixture NUMS derivation must not reach infinity")
+            .0
+    }
+
+    fn ack_script(
+        selected_commitment: [u8; 32],
+        graph_pubkey: XOnlyPublicKey,
+        release_pubkeys: &[XOnlyPublicKey],
+    ) -> ScriptBuf {
+        let mut bytes = Builder::new()
+            .push_slice(selected_commitment)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIGVERIFY)
+            .into_script()
+            .into_bytes();
+        bytes.extend_from_slice(threshold_multisig_script(release_pubkeys, 1).as_bytes());
+        ScriptBuf::from_bytes(bytes)
+    }
+
+    fn timeout_script(
+        selected_commitment: [u8; 32],
+        graph_pubkey: XOnlyPublicKey,
+        timeout_delay: u16,
+    ) -> ScriptBuf {
+        Builder::new()
+            .push_slice(selected_commitment)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_sequence(Sequence::from_height(timeout_delay))
+            .push_opcode(opcodes::all::OP_CSV)
+            .push_opcode(opcodes::all::OP_DROP)
+            .push_slice(graph_pubkey.serialize())
+            .push_opcode(opcodes::all::OP_CHECKSIG)
+            .into_script()
+    }
+
+    fn subject_and_selection(
+        selected_byte: u8,
+        parent_byte: u8,
+        graph_seed: u8,
+        release_seed: u8,
+    ) -> (
+        SubjectBoundAckSubjectV1,
+        PersistedThresholdAckWitnessSelectionV3,
+    ) {
+        let selected_commitment = [selected_byte; 32];
+        let graph = keypair(graph_seed).x_only_public_key().0;
+        let releases = [
+            keypair(release_seed).x_only_public_key().0,
+            keypair(release_seed + 1).x_only_public_key().0,
+        ];
+        let resolution_outpoint = OutPoint::new(Txid::from_byte_array([parent_byte; 32]), 1);
+        let timeout_delay = 8_u16;
+        let mut transaction = Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output: resolution_outpoint,
+                script_sig: ScriptBuf::new(),
+                sequence: Sequence::MAX,
+                witness: Witness::new(),
+            }],
+            output: vec![TxOut {
+                value: Amount::from_sat(9_000),
+                script_pubkey: ScriptBuf::new_p2tr(
+                    bitcoin::secp256k1::SECP256K1,
+                    keypair(release_seed + 2).x_only_public_key().0,
+                    None,
+                ),
+            }],
+        };
+        let receipt_subject = SubjectBoundAckSubjectV1::from_ack_template(
+            selected_commitment,
+            graph.into(),
+            1,
+            releases.iter().copied().map(Into::into).collect(),
+            resolution_outpoint.into(),
+            Amount::from_sat(10_000),
+            timeout_delay,
+            transaction.clone(),
+        )
+        .expect("fixture subject must validate");
+
+        let ack_script = ack_script(selected_commitment, graph, &releases);
+        let timeout_script = timeout_script(selected_commitment, graph, timeout_delay);
+        let spend_info = TaprootBuilder::new()
+            .add_leaf(1, ack_script.clone())
+            .expect("ACK leaf must be valid")
+            .add_leaf(1, timeout_script)
+            .expect("timeout leaf must be valid")
+            .finalize(
+                bitcoin::secp256k1::SECP256K1,
+                resolution_internal_key(selected_commitment),
+            )
+            .expect("two-leaf fixture tree must finalize");
+        let control = spend_info
+            .control_block(&(ack_script.clone(), LeafVersion::TapScript))
+            .expect("ACK control block must exist");
+        let resolution_tx_out: TxOut = receipt_subject.resolution_tx_out.clone().into();
+        assert_eq!(
+            resolution_tx_out.script_pubkey,
+            ScriptBuf::new_p2tr_tweaked(spend_info.output_key())
+        );
+        let sighash = SighashCache::new(&transaction)
+            .taproot_script_spend_signature_hash(
+                0,
+                &Prevouts::All(std::slice::from_ref(&resolution_tx_out)),
+                TapLeafHash::from_script(&ack_script, LeafVersion::TapScript),
+                TapSighashType::Default,
+            )
+            .expect("fixture sighash must compute");
+        assert_eq!(sighash.to_byte_array(), receipt_subject.ack_sighash);
+        let message = Message::from_digest(sighash.to_byte_array());
+        let release_signature: schnorr::Signature = keypair(release_seed).sign_schnorr(message);
+        let graph_signature: schnorr::Signature = keypair(graph_seed).sign_schnorr(message);
+        transaction.input[0].witness = Witness::from_slice(&[
+            Vec::new(),
+            release_signature.serialize().to_vec(),
+            graph_signature.serialize().to_vec(),
+            ack_script.into_bytes(),
+            control.serialize(),
+        ]);
+
+        let subject = V026ThresholdAckSubjectV3 {
+            selected_commitment,
+            graph_pubkey: graph.serialize(),
+            participant_count: 2,
+            threshold: 1,
+            release_pubkeys: releases.iter().map(XOnlyPublicKey::serialize).collect(),
+            resolution_outpoint,
+            resolution_tx_out,
+            ack_txid: receipt_subject.ack_txid.inner(),
+            ack_sighash: receipt_subject.ack_sighash,
+        };
+        let selection = PersistedThresholdAckWitnessSelectionV3::try_from_parts(
+            V026PersistedAckWitnessPartsV3 {
+                subject,
+                wtxid: transaction.compute_wtxid(),
+                participant_bitmap: 1,
+                selected_release_signatures: vec![V026IndexedReleaseSignatureBytesV3 {
+                    participant_index: 0,
+                    signature: release_signature.serialize(),
+                }],
+                graph_signature: graph_signature.serialize(),
+                finalized_ack: consensus::serialize(&transaction),
+            },
+        )
+        .expect("fixture witness selection must validate");
+        (receipt_subject, selection)
+    }
+
+    fn setup_btc_client(bitcoind: &Node) -> BitcoinClient {
+        let cookie = bitcoind
+            .params
+            .get_cookie_values()
+            .expect("cookie file should be readable")
+            .expect("cookie file should contain credentials");
+        let auth = Auth::UserPass(cookie.user, cookie.password);
+
+        BitcoinClient::new(bitcoind.rpc_url(), auth, None, None, None)
+            .expect("async bitcoin rpc client should initialize")
+    }
+
+    fn funded_transaction(bitcoind: &Node) -> Transaction {
+        let source_address = bitcoind
+            .client
+            .new_address()
+            .expect("source address should be generated");
+        let mined_blocks = bitcoind
+            .client
+            .generate_to_address(101, &source_address)
+            .expect("coinbase outputs should mature")
+            .into_model()
+            .expect("generated block hashes should decode");
+
+        let first_block = bitcoind
+            .client
+            .get_block(
+                *mined_blocks
+                    .0
+                    .first()
+                    .expect("at least one block should be generated"),
+            )
+            .expect("first block should load");
+        let source = first_block
+            .txdata
+            .first()
+            .expect("block should contain coinbase")
+            .compute_txid();
+        let recipient = bitcoind
+            .client
+            .new_address()
+            .expect("recipient address should be generated");
+        let unsigned = bitcoind
+            .client
+            .create_raw_transaction(
+                &[Input {
+                    txid: source,
+                    vout: 0,
+                    sequence: None,
+                }],
+                &[Output::new(recipient, Amount::from_sat(4_999_990_000))],
+            )
+            .expect("transaction should be created")
+            .transaction()
+            .expect("unsigned transaction should decode");
+        let signed = bitcoind
+            .client
+            .sign_raw_transaction_with_wallet(&unsigned)
+            .expect("wallet should sign transaction");
+        assert!(signed.complete, "wallet signature should be complete");
+        deserialize_hex(&signed.hex).expect("signed transaction should decode")
+    }
+
+    #[tokio::test]
+    async fn exact_active_chain_confirmation_is_reorg_sensitive() {
+        let mut conf = Conf::default();
+        conf.args.push("-txindex=1");
+        let bitcoind = Node::with_conf("bitcoind", &conf).expect("bitcoind should start");
+        let transaction = funded_transaction(&bitcoind);
+        let txid = transaction.compute_txid();
+        let bitcoin_client = setup_btc_client(&bitcoind);
+
+        bitcoind
+            .client
+            .send_raw_transaction(&transaction)
+            .expect("transaction should enter mempool");
+        assert!(matches!(
+            confirm_exact_transaction(
+                &bitcoin_client,
+                &transaction,
+                NonZeroU64::new(1).expect("one is nonzero"),
+            )
+            .await,
+            Err(SubjectBoundConfirmationError::TransactionUnconfirmed { txid: actual })
+                if actual == txid
+        ));
+
+        let mining_address = bitcoind
+            .client
+            .new_address()
+            .expect("mining address should be generated");
+        let mined_blocks = bitcoind
+            .client
+            .generate_to_address(1, &mining_address)
+            .expect("transaction should be mined")
+            .into_model()
+            .expect("generated block hash should decode");
+        let block_hash = *mined_blocks
+            .0
+            .first()
+            .expect("one block should be generated");
+        let observation = confirm_exact_transaction(
+            &bitcoin_client,
+            &transaction,
+            NonZeroU64::new(1).expect("one is nonzero"),
+        )
+        .await
+        .expect("mined exact transaction should be confirmed");
+        assert_eq!(observation.block_hash, block_hash);
+        assert_eq!(observation.confirmations.get(), 1);
+
+        assert!(matches!(
+            confirm_exact_transaction(
+                &bitcoin_client,
+                &transaction,
+                NonZeroU64::new(2).expect("two is nonzero"),
+            )
+            .await,
+            Err(SubjectBoundConfirmationError::InsufficientConfirmations {
+                txid: actual,
+                required,
+                actual: confirmations,
+            }) if actual == txid && required.get() == 2 && confirmations.get() == 1
+        ));
+
+        bitcoind
+            .client
+            .call::<()>("invalidateblock", &[block_hash.to_string().into()])
+            .expect("block should invalidate");
+        assert!(matches!(
+            confirm_exact_transaction(
+                &bitcoin_client,
+                &transaction,
+                NonZeroU64::new(1).expect("one is nonzero"),
+            )
+            .await,
+            Err(SubjectBoundConfirmationError::TransactionUnconfirmed { txid: actual })
+                if actual == txid
+        ));
+    }
+
+    #[tokio::test]
+    async fn same_txid_with_different_witness_is_rejected() {
+        let mut conf = Conf::default();
+        conf.args.push("-txindex=1");
+        let bitcoind = Node::with_conf("bitcoind", &conf).expect("bitcoind should start");
+        let transaction = funded_transaction(&bitcoind);
+        bitcoind
+            .client
+            .send_raw_transaction(&transaction)
+            .expect("transaction should enter mempool");
+        let mining_address = bitcoind
+            .client
+            .new_address()
+            .expect("mining address should be generated");
+        bitcoind
+            .client
+            .generate_to_address(1, &mining_address)
+            .expect("transaction should be mined");
+
+        let mut witness_variant = transaction.clone();
+        witness_variant.input[0].witness = Witness::from_slice(&[b"not-the-mined-witness"]);
+        assert_eq!(witness_variant.compute_txid(), transaction.compute_txid());
+        assert_ne!(witness_variant.compute_wtxid(), transaction.compute_wtxid());
+
+        let bitcoin_client = setup_btc_client(&bitcoind);
+        assert!(matches!(
+            confirm_exact_transaction(
+                &bitcoin_client,
+                &witness_variant,
+                NonZeroU64::new(1).expect("one is nonzero"),
+            )
+            .await,
+            Err(SubjectBoundConfirmationError::ExactTransactionMismatch { txid })
+                if txid == transaction.compute_txid()
+        ));
+    }
+
+    #[test]
+    fn receipt_subject_must_match_every_adopted_ack_identity() {
+        let (receipt, selection) = subject_and_selection(31, 20, 1, 4);
+        verify_ack_subject_matches_selection(&receipt, &selection)
+            .expect("exact receipt and witness subject must match");
+
+        let mut changed = receipt.clone();
+        changed.selected_commitment[0] ^= 1;
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::SelectedCommitment)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.graph_pubkey = keypair(9).x_only_public_key().0.into();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::GraphPubkey)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.release_pubkeys.pop();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::ParticipantCount)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.threshold = 2;
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::Threshold)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.release_pubkeys[0] = keypair(9).x_only_public_key().0.into();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::ReleasePubkey { index: 0 })
+        ));
+
+        let mut changed = receipt.clone();
+        changed.resolution_outpoint = OutPoint::new(Txid::from_byte_array([99; 32]), 1).into();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::ResolutionOutpoint)
+        ));
+
+        let mut changed = receipt.clone();
+        let mut resolution: TxOut = changed.resolution_tx_out.clone().into();
+        resolution.value += Amount::from_sat(1);
+        changed.resolution_tx_out = resolution
+            .try_into()
+            .expect("mutated fixture output must remain encodable");
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::ResolutionTxOut)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.ack_txid = Txid::from_byte_array([98; 32]).into();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::AckTxid)
+        ));
+
+        let mut changed = receipt.clone();
+        changed.ack_sighash[0] ^= 1;
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::AckSighash)
+        ));
+
+        let mut changed = receipt;
+        let mut template: Transaction = (&changed.ack_transaction)
+            .try_into()
+            .expect("fixture ACK template must decode");
+        template.output[0].value += Amount::from_sat(1);
+        changed.ack_transaction = template.into();
+        assert!(matches!(
+            verify_ack_subject_matches_selection(&changed, &selection),
+            Err(SubjectBoundAckSelectionBindingError::AckTemplate)
+        ));
+    }
+
+    #[test]
+    fn adoption_accepts_only_exact_create_or_replay_and_rejects_conflict() {
+        let (_, proposed) = subject_and_selection(31, 20, 1, 4);
+        let created = require_exact_adoption(
+            V026AckWitnessWriteOutcomeV3::Created(Box::new(proposed.clone())),
+            &proposed,
+        )
+        .expect("exact created value must be accepted");
+        assert_eq!(created, proposed);
+
+        let replay = require_exact_adoption(
+            V026AckWitnessWriteOutcomeV3::ExactReplay(Box::new(proposed.clone())),
+            &proposed,
+        )
+        .expect("exact replay value must be accepted");
+        assert_eq!(replay, proposed);
+
+        let (_, other) = subject_and_selection(32, 21, 2, 6);
+        assert!(matches!(
+            require_exact_adoption(
+                V026AckWitnessWriteOutcomeV3::Created(Box::new(other.clone())),
+                &proposed,
+            ),
+            Err(SubjectBoundAckAdoptionOutcomeError::DatabaseOutcomeMismatch)
+        ));
+        assert!(matches!(
+            require_exact_adoption(
+                V026AckWitnessWriteOutcomeV3::Conflict {
+                    durable: Box::new(other),
+                    proposed: Box::new(proposed.clone()),
+                },
+                &proposed,
+            ),
+            Err(SubjectBoundAckAdoptionOutcomeError::WitnessConflict { .. })
+        ));
+    }
+}
