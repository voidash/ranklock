+//! Subject binding for the versioned threshold-v3 counterproof guest.
+//!
+//! The legacy counterproof output contains only `(operator_pubkey, game_idx)`.
+//! Those fields do not identify one funded threshold-v3 ACK subject across
+//! setup replacement or reorg.  This module defines a side-by-side manifest
+//! whose digest must appear in output 1 of the operator-signed BridgeProof
+//! transaction.  The subject-bound guest validates that signed commitment and
+//! emits only the selected, manifest-authenticated row.
+//!
+//! The manifest deliberately excludes the subject-bound guest's own program
+//! verifying key.  Including that key would create a build-time hash cycle.
+//! The program key is pinned by the proof verifier outside this relation.
+
+use std::{collections::BTreeSet, fmt};
+
+use bitcoin::{
+    Amount, Script, ScriptBuf, Sequence, TapSighashType, Transaction, TxOut, consensus,
+    hashes::{Hash, HashEngine, sha256, sha256t_hash_newtype},
+    opcodes,
+    script::{Builder, Instruction},
+    sighash::{Prevouts, SighashCache},
+    taproot::{TapLeafHash, TaprootBuilder},
+    transaction::Version,
+};
+use secp256k1::{SECP256K1, Scalar, XOnlyPublicKey};
+use ssz_derive::{Decode, Encode};
+use strata_bridge_connectors::{
+    counterproof_resolution_threshold_v3::{
+        MAX_THRESHOLD_ACK_PARTICIPANTS, MIN_THRESHOLD_ACK_PARTICIPANTS,
+    },
+    ranklock_nums::BIP341_NUMS_BASE_POINT,
+    threshold_registry_v3::{
+        MAX_THRESHOLD_V3_ALTERNATIVES, MAX_THRESHOLD_V3_RELEASE_CELLS,
+        MIN_THRESHOLD_V3_ALTERNATIVES,
+    },
+};
+use strata_btc_types::{
+    BitcoinOutPoint, BitcoinTxOut, BitcoinTxid, BitcoinXOnlyPublicKey, RawBitcoinTx,
+};
+
+const MAX_ACK_TEMPLATE_BYTES: usize = 10_000;
+const SUBJECT_COMMITMENT_VOUT: usize = 1;
+const SUBJECT_MAGIC: &[u8; 8] = b"RL26SBS1";
+const MANIFEST_MAGIC: &[u8; 8] = b"RL26SBM1";
+const COMMITMENT_MAGIC: &[u8; 8] = b"RL26SBG1";
+const SUBJECT_DOMAIN: &[u8] = b"ranklock/v026/subject-bound-ack/v1\0";
+const MANIFEST_DOMAIN: &[u8] = b"ranklock/v026/subject-bound-manifest/v1\0";
+const SELECTED_COMMITMENT_TAG: &[u8] = b"RankLock/v026/threshold-v3/selected-alternative/v1";
+
+sha256t_hash_newtype! {
+    struct ThresholdResolutionNumsV3Tag = hash_str("RankLock/v026/TaprootNUMS/v3/resolution");
+
+    struct ThresholdResolutionNumsV3Hash(_);
+}
+
+const SECP256K1_ORDER: [u8; 32] = [
+    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
+    0xba, 0xae, 0xdc, 0xe6, 0xaf, 0x48, 0xa0, 0x3b, 0xbf, 0xd2, 0x5e, 0x8c, 0xd0, 0x36, 0x41, 0x41,
+];
