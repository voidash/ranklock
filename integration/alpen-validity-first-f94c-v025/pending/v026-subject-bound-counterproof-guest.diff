+//! Pinned SP1 Groth16 verification and exact BridgeProof transaction binding.
+//!
+//! This module turns a metadata-bearing receipt into a live, non-serializable
+//! capability only after algebraic verification under the exact subject-bound
+//! program identity. A second step binds the verified output to an exact
+//! BridgeProof transaction and graph-derived ACK subject. That second step is
+//! a transaction-identity check only: it does not prove Bitcoin confirmation,
+//! canonical-chain membership, setup authority, or funding eligibility.
+
+use std::{error::Error, fmt};
+
+use bitcoin::{
+    Transaction,
+    hashes::{Hash, sha256},
+};
+use sp1_verifier::{GROTH16_VK_BYTES, VK_ROOT_BYTES};
+use ssz::Decode;
+use strata_btc_types::{BitcoinTxid, BitcoinXOnlyPublicKey};
+use zkaleido::{ProofReceiptWithMetadata, ProofType, ZkVm};
+use zkaleido_sp1_groth16_verifier::SP1Groth16Verifier;
+
+use crate::{SubjectBoundAckSubjectV1, SubjectBoundCounterproofOutputV1};
+
+/// Exact raw SP1 verifying-key digest of the rebuilt subject-bound guest.
+pub const SUBJECT_BOUND_SP1_PROGRAM_ID_V1: [u8; 32] = [
+    0x00, 0x01, 0x28, 0x05, 0xc2, 0x7a, 0x29, 0xa2, 0xa1, 0x63, 0x57, 0x60, 0x6a, 0x84, 0x3d, 0x0b,
+    0x1f, 0x2a, 0x0c, 0xde, 0x5d, 0x41, 0x2e, 0x71, 0xc6, 0x59, 0xbc, 0x80, 0xd1, 0x62, 0x2c, 0xb0,
+];
+
+/// Exact SP1 circuit version accepted by the V1 subject receipt verifier.
+pub const SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1: &str = "v6.2.4";
+
+/// A verifier pinned to the exact subject guest and SP1 Groth16 material.
+pub struct SubjectBoundSp1Groth16VerifierV1 {
+    verifier: SP1Groth16Verifier,
+}
+
+impl fmt::Debug for SubjectBoundSp1Groth16VerifierV1 {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("SubjectBoundSp1Groth16VerifierV1")
+            .field("program_id", &SUBJECT_BOUND_SP1_PROGRAM_ID_V1)
+            .field("circuit_version", &SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1)
+            .finish_non_exhaustive()
+    }
+}
+
+impl SubjectBoundSp1Groth16VerifierV1 {
+    /// Loads the pinned verifier once for repeated receipt verification.
+    pub fn new() -> Result<Self, SubjectBoundReceiptVerificationError> {
+        let verifier = SP1Groth16Verifier::load(
+            &GROTH16_VK_BYTES,
+            SUBJECT_BOUND_SP1_PROGRAM_ID_V1,
+            *VK_ROOT_BYTES,
+            true,
+        )
+        .map_err(|error| SubjectBoundReceiptVerificationError::VerifierLoad(error.to_string()))?;
+        Ok(Self { verifier })
+    }
+
+    /// Verifies exact metadata, the Groth16 proof, and the typed public output.
+    pub fn verify(
+        &self,
+        receipt: &ProofReceiptWithMetadata,
+    ) -> Result<VerifiedSubjectBoundCounterproofV1, SubjectBoundReceiptVerificationError> {
+        let metadata = receipt.metadata();
+        if *metadata.zkvm() != ZkVm::SP1 {
+            return Err(SubjectBoundReceiptVerificationError::WrongZkVm {
+                actual: *metadata.zkvm(),
+            });
+        }
+        if metadata.program_id().0 != SUBJECT_BOUND_SP1_PROGRAM_ID_V1 {
+            return Err(SubjectBoundReceiptVerificationError::WrongProgramId {
+                actual: metadata.program_id().0,
+            });
+        }
+        if metadata.version() != SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1 {
+            return Err(SubjectBoundReceiptVerificationError::WrongCircuitVersion {
+                actual: metadata.version().to_owned(),
+            });
+        }
+        if metadata.proof_type() != ProofType::Groth16 {
+            return Err(SubjectBoundReceiptVerificationError::WrongProofType {
+                actual: metadata.proof_type(),
+            });
+        }
+        self.verifier
+            .verify(
+                receipt.receipt().proof().as_bytes(),
+                receipt.receipt().public_values().as_bytes(),
+            )
+            .map_err(|error| {
+                SubjectBoundReceiptVerificationError::AlgebraicVerification(error.to_string())
+            })?;
+        let output = SubjectBoundCounterproofOutputV1::from_ssz_bytes(
+            receipt.receipt().public_values().as_bytes(),
+        )
+        .map_err(|error| {
+            SubjectBoundReceiptVerificationError::PublicOutputDecode(error.to_string())
+        })?;
+        if output.game_idx == 0 {
+            return Err(SubjectBoundReceiptVerificationError::ZeroGameIndex);
+        }
+        if output.bridge_proof_txid.inner() == bitcoin::Txid::all_zeros() {
+            return Err(SubjectBoundReceiptVerificationError::ZeroBridgeProofTxid);
+        }
+        output.ack_subject.digest().map_err(|error| {
+            SubjectBoundReceiptVerificationError::InvalidAckSubject(error.to_string())
+        })?;
+        let receipt_sha256 = sha256::Hash::hash(&receipt.encode()).to_byte_array();
+        Ok(VerifiedSubjectBoundCounterproofV1 {
+            receipt_sha256,
+            output,
+        })
+    }
+}
+
+/// Live capability minted only after exact SP1 Groth16 receipt verification.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VerifiedSubjectBoundCounterproofV1 {
+    receipt_sha256: [u8; 32],
+    output: SubjectBoundCounterproofOutputV1,
+}
+
+impl VerifiedSubjectBoundCounterproofV1 {
+    /// Canonical digest of the complete metadata-bearing receipt encoding.
+    pub const fn receipt_sha256(&self) -> [u8; 32] {
+        self.receipt_sha256
+    }
+
+    /// Typed public output authenticated by the pinned receipt verifier.
+    pub const fn output(&self) -> &SubjectBoundCounterproofOutputV1 {
+        &self.output
+    }
+
+    /// Binds the authenticated output to exact transaction and graph identities.
+    ///
+    /// The caller must separately establish that `bridge_proof_transaction`
+    /// was observed on the canonical Bitcoin chain. This method deliberately
+    /// does not convert transaction equality into a confirmation claim.
+    pub fn bind_transaction_identity(
+        &self,
+        bridge_proof_transaction: &Transaction,
+        expected_operator_pubkey: &BitcoinXOnlyPublicKey,
+        expected_game_idx: u32,
+        expected_ack_subject: &SubjectBoundAckSubjectV1,
+    ) -> Result<TxidBoundSubjectCounterproofV1, SubjectBoundReceiptVerificationError> {
+        let actual_txid = bridge_proof_transaction.compute_txid();
+        if self.output.bridge_proof_txid.inner() != actual_txid {
+            return Err(SubjectBoundReceiptVerificationError::BridgeProofTransactionMismatch);
+        }
+        if &self.output.operator_pubkey != expected_operator_pubkey {
+            return Err(SubjectBoundReceiptVerificationError::OperatorMismatch);
+        }
+        if self.output.game_idx != expected_game_idx || expected_game_idx == 0 {
+            return Err(SubjectBoundReceiptVerificationError::GameIndexMismatch);
+        }
+        expected_ack_subject.digest().map_err(|error| {
+            SubjectBoundReceiptVerificationError::InvalidAckSubject(error.to_string())
+        })?;
+        if &self.output.ack_subject != expected_ack_subject {
+            return Err(SubjectBoundReceiptVerificationError::AckSubjectMismatch);
+        }
+        Ok(TxidBoundSubjectCounterproofV1 {
+            receipt_sha256: self.receipt_sha256,
+            bridge_proof_txid: self.output.bridge_proof_txid,
+            operator_pubkey: self.output.operator_pubkey,
+            game_idx: self.output.game_idx,
+            ack_subject: self.output.ack_subject.clone(),
+        })
+    }
+}
+
+/// Live receipt capability bound to exact non-witness transaction and ACK identities.
+///
+/// This value is intentionally not serializable and is not evidence of chain
+/// confirmation or runtime admission.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TxidBoundSubjectCounterproofV1 {
+    receipt_sha256: [u8; 32],
+    bridge_proof_txid: BitcoinTxid,
+    operator_pubkey: BitcoinXOnlyPublicKey,
+    game_idx: u32,
+    ack_subject: SubjectBoundAckSubjectV1,
+}
+
+impl TxidBoundSubjectCounterproofV1 {
+    /// Canonical digest of the verified metadata-bearing receipt.
+    pub const fn receipt_sha256(&self) -> [u8; 32] {
+        self.receipt_sha256
+    }
+
+    /// Exact BridgeProof non-witness transaction ID.
+    pub const fn bridge_proof_txid(&self) -> &BitcoinTxid {
+        &self.bridge_proof_txid
+    }
+
+    /// Exact operator key authenticated by the receipt.
+    pub const fn operator_pubkey(&self) -> &BitcoinXOnlyPublicKey {
+        &self.operator_pubkey
+    }
+
+    /// Exact nonzero game index authenticated by the receipt.
+    pub const fn game_idx(&self) -> u32 {
+        self.game_idx
+    }
+
+    /// Exact graph-derived ACK subject authenticated by the receipt.
+    pub const fn ack_subject(&self) -> &SubjectBoundAckSubjectV1 {
+        &self.ack_subject
+    }
+}
+
+/// Exact failure from receipt verification or transaction-identity binding.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SubjectBoundReceiptVerificationError {
+    /// Pinned SP1 Groth16 verifier material could not be loaded.
+    VerifierLoad(String),
+    /// Receipt metadata identifies another zkVM.
+    WrongZkVm {
+        /// Rejected zkVM.
+        actual: ZkVm,
+    },
+    /// Receipt metadata identifies another program.
+    WrongProgramId {
+        /// Rejected program identifier.
+        actual: [u8; 32],
+    },
+    /// Receipt metadata identifies another SP1 circuit version.
+    WrongCircuitVersion {
+        /// Rejected version string.
+        actual: String,
+    },
+    /// Receipt metadata is not Groth16.
+    WrongProofType {
+        /// Rejected proof type.
+        actual: ProofType,
+    },
+    /// Algebraic proof verification failed.
+    AlgebraicVerification(String),
+    /// Authenticated public values do not decode as the V1 subject output.
+    PublicOutputDecode(String),
+    /// Authenticated game index is zero.
+    ZeroGameIndex,
+    /// Authenticated BridgeProof txid is zero.
+    ZeroBridgeProofTxid,
+    /// Authenticated or expected ACK subject is structurally invalid.
+    InvalidAckSubject(String),
+    /// Supplied BridgeProof transaction has another txid.
+    BridgeProofTransactionMismatch,
+    /// Expected operator differs from the authenticated output.
+    OperatorMismatch,
+    /// Expected game index differs from the authenticated output.
+    GameIndexMismatch,
+    /// Graph-derived ACK subject differs from the authenticated output.
+    AckSubjectMismatch,
+}
+
+impl fmt::Display for SubjectBoundReceiptVerificationError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "subject-bound receipt verification failed: {self:?}"
+        )
+    }
+}
+
+impl Error for SubjectBoundReceiptVerificationError {}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+
+    use bitcoin::{
+        Amount, OutPoint, ScriptBuf, Sequence, TxIn, TxOut, Txid, absolute, hashes::Hash as _,
+        transaction::Version,
+    };
+    use secp256k1::{Keypair, SECP256K1, SecretKey};
+    use ssz::Encode;
+    use strata_btc_types::BitcoinXOnlyPublicKey;
+    use zkaleido::{
+        ProgramId, Proof, ProofMetadata, ProofReceipt, ProofReceiptWithMetadata, PublicValues,
+    };
+
+    use super::*;
+    use crate::selected_commitment;
+
+    fn key(seed: u8) -> BitcoinXOnlyPublicKey {
+        let secret = SecretKey::from_slice(&[seed; 32]).expect("nonzero fixture scalar");
+        Keypair::from_secret_key(SECP256K1, &secret)
+            .x_only_public_key()
+            .0
+            .into()
+    }
+
+    fn txid(seed: u8) -> Txid {
+        Txid::from_byte_array([seed; 32])
+    }
+
+    fn transaction(previous_output: OutPoint, value: u64, key_seed: u8) -> Transaction {
+        Transaction {
+            version: Version(3),
+            lock_time: absolute::LockTime::ZERO,
+            input: vec![TxIn {
+                previous_output,
+                sequence: Sequence::MAX,
+                ..Default::default()
+            }],
+            output: vec![TxOut {
+                value: Amount::from_sat(value),
+                script_pubkey: ScriptBuf::new_p2tr(
+                    SECP256K1,
+                    key(key_seed).to_xonly_public_key(),
+                    None,
+                ),
+            }],
+        }
+    }
+
+    fn ack_subject(selected: [u8; 32], outpoint_seed: u8) -> SubjectBoundAckSubjectV1 {
+        let resolution = OutPoint::new(txid(outpoint_seed), 1);
+        SubjectBoundAckSubjectV1::from_ack_template(
+            selected,
+            key(1),
+            2,
+            vec![key(2), key(3), key(4)],
+            resolution.into(),
+            Amount::from_sat(120_000),
+            8,
+            transaction(resolution, 119_000, 5),
+        )
+        .expect("valid exact ACK subject")
+    }
+
+    fn metadata(
+        zkvm: ZkVm,
+        program_id: [u8; 32],
+        version: &str,
+        proof_type: ProofType,
+    ) -> ProofMetadata {
+        ProofMetadata::new(zkvm, ProgramId(program_id), version, proof_type)
+    }
+
+    fn receipt(metadata: ProofMetadata, public_values: Vec<u8>) -> ProofReceiptWithMetadata {
+        ProofReceiptWithMetadata::new(
+            ProofReceipt::new(Proof::new(vec![1]), PublicValues::new(public_values)),
+            metadata,
+        )
+    }
+
+    #[test]
+    fn pinned_subject_verifier_loads_and_rejects_wrong_metadata() {
+        let artifact_program_id: [u8; 32] = fs::read(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/../../../guest-builder/sp1/elfs/counterproof-subject-v1-vkey.bin"
+        ))
+        .expect("rebuilt subject-bound program vkey must exist")
+        .try_into()
+        .expect("subject-bound program vkey must contain exactly 32 bytes");
+        assert_eq!(artifact_program_id, SUBJECT_BOUND_SP1_PROGRAM_ID_V1);
+        let verifier =
+            SubjectBoundSp1Groth16VerifierV1::new().expect("pinned SP1 Groth16 material must load");
+        let cases = [
+            (
+                metadata(
+                    ZkVm::Native,
+                    SUBJECT_BOUND_SP1_PROGRAM_ID_V1,
+                    SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1,
+                    ProofType::Groth16,
+                ),
+                "WrongZkVm",
+            ),
+            (
+                metadata(
+                    ZkVm::SP1,
+                    [9; 32],
+                    SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1,
+                    ProofType::Groth16,
+                ),
+                "WrongProgramId",
+            ),
+            (
+                metadata(
+                    ZkVm::SP1,
+                    SUBJECT_BOUND_SP1_PROGRAM_ID_V1,
+                    "v6.2.3",
+                    ProofType::Groth16,
+                ),
+                "WrongCircuitVersion",
+            ),
+            (
+                metadata(
+                    ZkVm::SP1,
+                    SUBJECT_BOUND_SP1_PROGRAM_ID_V1,
+                    SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1,
+                    ProofType::Core,
+                ),
+                "WrongProofType",
+            ),
+        ];
+        for (metadata, expected) in cases {
+            let error = verifier
+                .verify(&receipt(metadata, Vec::new()))
+                .expect_err("wrong metadata must be rejected before proof parsing");
+            assert!(format!("{error:?}").contains(expected));
+        }
+    }
+
+    #[test]
+    fn pinned_subject_verifier_rejects_malformed_algebraic_proof() {
+        let verifier =
+            SubjectBoundSp1Groth16VerifierV1::new().expect("pinned SP1 Groth16 material must load");
+        let receipt = receipt(
+            metadata(
+                ZkVm::SP1,
+                SUBJECT_BOUND_SP1_PROGRAM_ID_V1,
+                SUBJECT_BOUND_SP1_CIRCUIT_VERSION_V1,
+                ProofType::Groth16,
+            ),
+            Vec::new(),
+        );
+        assert!(matches!(
+            verifier.verify(&receipt),
+            Err(SubjectBoundReceiptVerificationError::AlgebraicVerification(
+                _
+            ))
+        ));
+    }
+
+    #[test]
+    fn verified_output_binds_exact_transaction_and_ack_subject() {
+        let bridge_proof = transaction(OutPoint::new(txid(20), 0), 50_000, 7);
+        let subject = ack_subject(selected_commitment([11; 32], 0), 30);
+        let output = SubjectBoundCounterproofOutputV1 {
+            operator_pubkey: key(8),
+            game_idx: 9,
+            bridge_proof_txid: BitcoinTxid::new(&bridge_proof.compute_txid()),
+            ack_subject: subject.clone(),
+        };
+        let verified = VerifiedSubjectBoundCounterproofV1 {
+            receipt_sha256: [12; 32],
+            output,
+        };
+        let bound = verified
+            .bind_transaction_identity(&bridge_proof, &key(8), 9, &subject)
+            .expect("exact identities must bind");
+        assert_eq!(bound.receipt_sha256(), [12; 32]);
+        assert_eq!(
+            bound.bridge_proof_txid().inner(),
+            bridge_proof.compute_txid()
+        );
+        assert_eq!(bound.operator_pubkey(), &key(8));
+        assert_eq!(bound.game_idx(), 9);
+        assert_eq!(bound.ack_subject(), &subject);
+
+        let wrong_transaction = transaction(OutPoint::new(txid(21), 0), 50_000, 7);
+        assert!(matches!(
+            verified.bind_transaction_identity(&wrong_transaction, &key(8), 9, &subject),
+            Err(SubjectBoundReceiptVerificationError::BridgeProofTransactionMismatch)
+        ));
+        assert!(matches!(
+            verified.bind_transaction_identity(&bridge_proof, &key(9), 9, &subject),
+            Err(SubjectBoundReceiptVerificationError::OperatorMismatch)
+        ));
+        assert!(matches!(
+            verified.bind_transaction_identity(&bridge_proof, &key(8), 10, &subject),
+            Err(SubjectBoundReceiptVerificationError::GameIndexMismatch)
+        ));
+        let wrong_subject = ack_subject(selected_commitment([11; 32], 1), 31);
+        assert!(matches!(
+            verified.bind_transaction_identity(&bridge_proof, &key(8), 9, &wrong_subject),
+            Err(SubjectBoundReceiptVerificationError::AckSubjectMismatch)
+        ));
+    }
+
+    #[test]
+    fn verified_capability_exposes_only_read_identity_accessors() {
+        let subject = ack_subject(selected_commitment([13; 32], 0), 40);
+        let output = SubjectBoundCounterproofOutputV1 {
+            operator_pubkey: key(8),
+            game_idx: 9,
+            bridge_proof_txid: BitcoinTxid::new(&txid(41)),
+            ack_subject: subject,
+        };
+        let encoded = output.as_ssz_bytes();
+        assert!(!encoded.is_empty());
+        let verified = VerifiedSubjectBoundCounterproofV1 {
+            receipt_sha256: [14; 32],
+            output,
+        };
+        assert_eq!(verified.output().game_idx, 9);
+        assert_eq!(verified.receipt_sha256(), [14; 32]);
+    }
+}
