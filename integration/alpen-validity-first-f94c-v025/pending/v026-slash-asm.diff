+impl SlashV2TxHeaderAux {
+    /// Creates a SlashV2 header for `operator_idx`.
+    pub fn new(operator_idx: OperatorIdx) -> Self {
+        Self { operator_idx }
+    }
+
+    /// Returns the operator being slashed.
+    pub fn operator_idx(&self) -> OperatorIdx {
+        self.operator_idx
+    }
+
+    /// Builds the distinct type-6 SPS-50 tag without panicking.
+    pub fn build_tag_data(&self) -> Result<TagData, TagDataError> {
+        let aux_data = encode_to_vec(self)?;
+        TagData::new(
+            BRIDGE_V1_SUBPROTOCOL_ID,
+            BridgeTxType::SlashV2 as u8,
+            aux_data,
+        )
+        .map_err(TagDataError::from)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use proptest::prelude::*;
+
+    use super::*;
+
+    proptest! {
+        #[test]
+        fn tag_data_is_fallible_and_uses_distinct_v2_type(
+            operator_idx in any::<OperatorIdx>(),
+        ) {
+            let aux = SlashV2TxHeaderAux::new(operator_idx);
+            let tag = aux.build_tag_data().expect("fixed-size SlashV2 tag must fit");
+
+            prop_assert_eq!(tag.subproto_id(), BRIDGE_V1_SUBPROTOCOL_ID);
+            prop_assert_eq!(tag.tx_type(), BridgeTxType::SlashV2 as u8);
+            prop_assert_ne!(tag.tx_type(), BridgeTxType::Slash as u8);
+            prop_assert_eq!(tag.as_ref().aux_data().len(), 4);
+        }
+    }
+}
