+use arbitrary::Arbitrary;
+use strata_btc_types::BitcoinOutPoint;
+
+use crate::slash_v2::SlashV2TxHeaderAux;
+
+/// Information extracted from a versioned SlashV2 transaction.
+#[derive(Debug, Clone, PartialEq, Eq, Arbitrary)]
+pub struct SlashV2Info {
+    header_aux: SlashV2TxHeaderAux,
+    slash_authorization_inpoint: BitcoinOutPoint,
+    contest_slash_inpoint: BitcoinOutPoint,
+    stake_inpoint: BitcoinOutPoint,
+}
+
+impl SlashV2Info {
+    /// Creates parsed SlashV2 information in exact `[L, S, K]` order.
+    pub fn new(
+        header_aux: SlashV2TxHeaderAux,
+        slash_authorization_inpoint: BitcoinOutPoint,
+        contest_slash_inpoint: BitcoinOutPoint,
+        stake_inpoint: BitcoinOutPoint,
+    ) -> Self {
+        Self {
+            header_aux,
+            slash_authorization_inpoint,
+            contest_slash_inpoint,
+            stake_inpoint,
+        }
+    }
+
+    /// Returns the versioned SPS-50 auxiliary data.
+    pub fn header_aux(&self) -> &SlashV2TxHeaderAux {
+        &self.header_aux
+    }
+
+    /// Returns the ACK-created `L` input outpoint at index 0.
+    pub fn slash_authorization_inpoint(&self) -> &BitcoinOutPoint {
+        &self.slash_authorization_inpoint
+    }
+
+    /// Returns the contest `S` input outpoint at index 1.
+    pub fn contest_slash_inpoint(&self) -> &BitcoinOutPoint {
+        &self.contest_slash_inpoint
+    }
+
+    /// Returns the stake `K` input outpoint at index 2.
+    pub fn stake_inpoint(&self) -> &BitcoinOutPoint {
+        &self.stake_inpoint
+    }
+}
diff --git a/crates/subprotocols/bridge-v1/txs/src/slash_v2/parse.rs b/crates/subprotocols/bridge-v1/txs/src/slash_v2/parse.rs
new file mode 100644
index 0000000..132b1ef
--- /dev/null
+++ b/crates/subprotocols/bridge-v1/txs/src/slash_v2/parse.rs
@@ -0,0 +1,153 @@
+use strata_asm_common::TxInputRef;
+use strata_codec::decode_buf_exact;
+
+use crate::{
+    constants::BridgeTxType,
+    errors::TxStructureError,
+    slash_v2::{SlashV2Info, SlashV2TxHeaderAux},
+};
+
+/// Exact number of SlashV2 transaction inputs.
+pub const N_INPUTS: usize = 3;
+/// ACK-created slash authorization input index (`L`).
+pub const SLASH_AUTHORIZATION_INPUT_INDEX: usize = 0;
+/// Contest slash gate input index (`S`).
+pub const CONTEST_SLASH_INPUT_INDEX: usize = 1;
+/// Stake input index (`K`).
+pub const STAKE_INPUT_INDEX: usize = 2;
+
+/// Parses the distinct type-6 SlashV2 transaction layout.
+pub fn parse_slash_v2_tx(tx: &TxInputRef<'_>) -> Result<SlashV2Info, TxStructureError> {
+    let actual_inputs = tx.tx().input.len();
+    if actual_inputs != N_INPUTS {
+        return Err(TxStructureError::unexpected_input_count(
+            BridgeTxType::SlashV2,
+            N_INPUTS,
+            actual_inputs,
+            "SlashV2 exact [L, S, K] inputs",
+        ));
+    }
+
+    let header_aux: SlashV2TxHeaderAux = decode_buf_exact(tx.tag().aux_data())
+        .map_err(|error| TxStructureError::invalid_auxiliary_data(BridgeTxType::SlashV2, error))?;
+
+    let slash_authorization_inpoint = tx.tx().input[SLASH_AUTHORIZATION_INPUT_INDEX]
+        .previous_output
+        .into();
+    let contest_slash_inpoint = tx.tx().input[CONTEST_SLASH_INPUT_INDEX]
+        .previous_output
+        .into();
+    let stake_inpoint = tx.tx().input[STAKE_INPUT_INDEX].previous_output.into();
+
+    Ok(SlashV2Info::new(
+        header_aux,
+        slash_authorization_inpoint,
+        contest_slash_inpoint,
+        stake_inpoint,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use std::mem;
+
+    use bitcoin::{Transaction, TxIn};
+    use strata_l1_txfmt::ParseConfig;
+    use strata_test_utils_arb::ArbitraryGenerator;
+
+    use super::*;
+    use crate::{
+        BRIDGE_V1_SUBPROTOCOL_ID,
+        errors::TxStructureErrorKind,
+        test_utils::{TEST_MAGIC_BYTES, create_dummy_tx, overwrite_aux_data, parse_sps50_tx},
+    };
+
+    const AUX_LEN: usize = mem::size_of::<SlashV2TxHeaderAux>();
+
+    fn create_test_slash_v2_tx(info: &SlashV2Info) -> Transaction {
+        let mut tx = create_dummy_tx(N_INPUTS, 2);
+        let tag_data = info
+            .header_aux()
+            .build_tag_data()
+            .expect("fixed-size SlashV2 tag must fit");
+        tx.output[0].script_pubkey = ParseConfig::new(TEST_MAGIC_BYTES)
+            .encode_script_buf(&tag_data.as_ref())
+            .expect("SlashV2 SPS-50 script must encode");
+        tx.input[SLASH_AUTHORIZATION_INPUT_INDEX].previous_output =
+            info.slash_authorization_inpoint().0;
+        tx.input[CONTEST_SLASH_INPUT_INDEX].previous_output = info.contest_slash_inpoint().0;
+        tx.input[STAKE_INPUT_INDEX].previous_output = info.stake_inpoint().0;
+        tx
+    }
+
+    #[test]
+    fn parses_exact_l_s_k_order() {
+        let info: SlashV2Info = ArbitraryGenerator::new().generate();
+        let tx = create_test_slash_v2_tx(&info);
+        let input = parse_sps50_tx(&tx);
+
+        let parsed = parse_slash_v2_tx(&input).expect("exact SlashV2 must parse");
+
+        assert_eq!(parsed, info);
+        assert_eq!(
+            parsed.slash_authorization_inpoint().0,
+            tx.input[0].previous_output
+        );
+        assert_eq!(
+            parsed.contest_slash_inpoint().0,
+            tx.input[1].previous_output
+        );
+        assert_eq!(parsed.stake_inpoint().0, tx.input[2].previous_output);
+    }
+
+    #[test]
+    fn rejects_missing_or_extra_inputs() {
+        let info: SlashV2Info = ArbitraryGenerator::new().generate();
+        let mut missing = create_test_slash_v2_tx(&info);
+        missing.input.pop();
+        let missing_input = parse_sps50_tx(&missing);
+        let missing_error = parse_slash_v2_tx(&missing_input).unwrap_err();
+        assert_eq!(missing_error.tx_type(), BridgeTxType::SlashV2);
+        assert!(matches!(
+            missing_error.kind(),
+            TxStructureErrorKind::UnexpectedInputCount {
+                expected: N_INPUTS,
+                actual: 2,
+            }
+        ));
+
+        let mut extra = create_test_slash_v2_tx(&info);
+        extra.input.push(TxIn::default());
+        let extra_input = parse_sps50_tx(&extra);
+        let extra_error = parse_slash_v2_tx(&extra_input).unwrap_err();
+        assert_eq!(extra_error.tx_type(), BridgeTxType::SlashV2);
+        assert!(matches!(
+            extra_error.kind(),
+            TxStructureErrorKind::UnexpectedInputCount {
+                expected: N_INPUTS,
+                actual: 4,
+            }
+        ));
+    }
+
+    #[test]
+    fn rejects_non_exact_auxiliary_data() {
+        let info: SlashV2Info = ArbitraryGenerator::new().generate();
+        for invalid_aux in [vec![0; AUX_LEN - 1], vec![0; AUX_LEN + 1]] {
+            let mut tx = create_test_slash_v2_tx(&info);
+            overwrite_aux_data(
+                &mut tx,
+                BRIDGE_V1_SUBPROTOCOL_ID,
+                BridgeTxType::SlashV2 as u8,
+                invalid_aux,
+            );
+            let input = parse_sps50_tx(&tx);
+            let error = parse_slash_v2_tx(&input).unwrap_err();
+            assert_eq!(error.tx_type(), BridgeTxType::SlashV2);
+            assert!(matches!(
+                error.kind(),
+                TxStructureErrorKind::InvalidAuxiliaryData(_)
+            ));
+        }
+    }
+}
