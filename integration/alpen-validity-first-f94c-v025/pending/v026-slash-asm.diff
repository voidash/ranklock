+//! Versioned SlashV2 transaction parser.
+//!
+//! SlashV2 has the exact input order `[L, S, K]`:
+//!
+//! 1. ACK-created slash authorization (`L`),
+//! 2. contest slash gate (`S`), and
+//! 3. operator stake (`K`).
+//!
+//! The distinct [`crate::constants::BridgeTxType::SlashV2`] wire type is
+//! intentional. Legacy type-4 Slash bytes continue to use the legacy parser,
+//! whose stake input is index 1; input counts are never used to reinterpret
+//! one version as the other.
+
+mod aux;
+mod info;
+mod parse;
+
+pub use aux::SlashV2TxHeaderAux;
+pub use info::SlashV2Info;
+pub use parse::{
+    CONTEST_SLASH_INPUT_INDEX, N_INPUTS, SLASH_AUTHORIZATION_INPUT_INDEX, STAKE_INPUT_INDEX,
+    parse_slash_v2_tx,
+};
