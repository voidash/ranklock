+/// Builds, submits, and mines a valid type-6 SlashV2 transaction with exact
+/// input order `[L, S, K]`.
+///
+/// `L` and `S` are independently funded OP_TRUE tapscript leaves. `K` is a
+/// key-path-only P2TR output controlled by the bridge's current N/N operator
+/// set, matching the historical script that the ASM handler validates.
+pub async fn submit_slash_v2_tx(
+    harness: &AsmTestHarness,
+    ctx: &BridgeContext,
+    operator_idx: OperatorIdx,
+) -> anyhow::Result<BlockHash> {
+    let input_amount = Amount::from_sat(10_000);
+    let (l_txid, l_vout, l_script_pubkey, l_spend_info) =
+        harness.create_trivial_funding_utxo(input_amount).await?;
+    let (s_txid, s_vout, s_script_pubkey, s_spend_info) =
+        harness.create_trivial_funding_utxo(input_amount).await?;
+
+    let (stake_address, _) = derive_musig2_p2tr_address(ctx.operator_privkeys())?;
+    let (k_txid, k_vout) = harness
+        .create_funding_utxo(&stake_address, input_amount)
+        .await?;
+
+    // Confirm every parent so ASM's auxiliary-data fetch can resolve K.
+    harness.mine_block(None).await?;
+
+    let tag = SlashV2TxHeaderAux::new(operator_idx).build_tag_data()?;
+    let header_script =
+        ParseConfig::new(harness.asm_params.magic).encode_script_buf(&tag.as_ref())?;
+    let payout_address = harness.client.get_new_address().await?;
+    let fee = AsmTestHarness::DEFAULT_FEE;
+    let payout_value = input_amount * 3 - fee;
+
+    let prevouts = [
+        TxOut {
+            value: input_amount,
+            script_pubkey: l_script_pubkey,
+        },
+        TxOut {
+            value: input_amount,
+            script_pubkey: s_script_pubkey,
+        },
+        TxOut {
+            value: input_amount,
+            script_pubkey: stake_address.script_pubkey(),
+        },
+    ];
+    let mut slash_v2 = Transaction {
+        version: Version::TWO,
+        lock_time: LockTime::ZERO,
+        input: vec![
+            TxIn {
+                previous_output: OutPoint::new(l_txid, l_vout),
+                script_sig: ScriptBuf::new(),
+                sequence: Sequence::ENABLE_RBF_NO_LOCKTIME,
+                witness: Witness::new(),
+            },
+            TxIn {
+                previous_output: OutPoint::new(s_txid, s_vout),
+                script_sig: ScriptBuf::new(),
+                sequence: Sequence::ENABLE_RBF_NO_LOCKTIME,
+                witness: Witness::new(),
+            },
+            TxIn {
+                previous_output: OutPoint::new(k_txid, k_vout),
