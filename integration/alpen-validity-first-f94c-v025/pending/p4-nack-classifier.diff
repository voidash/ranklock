+/// A validity-first NACK is an exact finalized pre-signed transaction. The
+/// comparison includes witness data; a matching witness-excluding txid alone
+/// is insufficient.
 pub fn nack_counterprover_idx(
     game: &GameGraph,
+    signatures: &GameFunctor<Signature>,
     graph_owner_idx: OperatorIdx,
     tx: &Transaction,
 ) -> Option<OperatorIdx> {
-    let txid = tx.compute_txid();
     game.counterproofs
         .iter()
+        .zip(&signatures.watchtowers)
         .enumerate()
-        .find_map(|(watchtower_slot, subgraph)| {
-            (subgraph.counterproof_nack.as_ref().compute_txid() == txid)
+        .find_map(|(watchtower_slot, (subgraph, watchtower_signatures))| {
+            let expected_tx = subgraph
+                .counterproof_nack
+                .clone()
+                .finalize(watchtower_signatures.counterproof_nack[0]);
+            (expected_tx == *tx)
                 .then(|| watchtower_slot_to_operator_idx(watchtower_slot, graph_owner_idx))
         })
 }
