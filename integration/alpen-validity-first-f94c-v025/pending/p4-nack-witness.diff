+#[test]
+fn event_rejected_same_txid_with_modified_witness() {
+    let slot = watchtower_slot_for_operator(TEST_POV_IDX, TEST_NONPOV_IDX)
+        .expect("non-pov idx must have a watchtower slot");
+    let mut tx = nack_tx_for_slot(slot);
+    let expected_txid = tx.compute_txid();
+    let expected_wtxid = tx.compute_wtxid();
+    let mut witness = tx.input[0].witness.to_vec();
+    witness[0][0] ^= 1;
+    tx.input[0].witness = Witness::from_slice(&witness);
+
+    assert_eq!(tx.compute_txid(), expected_txid);
+    assert_ne!(tx.compute_wtxid(), expected_wtxid);
+
+    test_graph_invalid_transition(GraphInvalidTransition {
+        from_state: counter_proof_posted_state_with_nacks(&[]),
+        event: GraphEvent::CounterProofNackConfirmed(CounterProofNackConfirmedEvent {
+            tx,
+            counterprover_idx: TEST_NONPOV_IDX,
+        }),
         expected_error: |e| matches!(e, GSMError::Rejected { .. }),
     });
 }
